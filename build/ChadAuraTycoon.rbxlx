-- Theme id of every stage's bridge room and safe zone; STAGE_THEMES[0] is the lobby.
CardioLayout.STAGE_THEMES = {
	[0] = "candy",
	[1] = "candy",
	[2] = "choco",
	[3] = "mint",
	[4] = "cotton",
	[5] = "caramel",
	[6] = "berry",
	[7] = "cherry",
	[8] = "grape",
	[9] = "midnight",
	[10] = "rainbow",
} :: { [number]: string }

function CardioLayout.themeOf(stage: number): Theme
	return CardioLayout.THEMES[CardioLayout.STAGE_THEMES[stage] or "candy"]
end

-- Key palettes, PALETTES[stage + 1][tint] (stage 0 = lobby), from the themes.
CardioLayout.PALETTES = {} :: { { RGB } }
for stage = 0, Rules.STAGE_COUNT do
	CardioLayout.PALETTES[stage + 1] = CardioLayout.themeOf(stage).keys
end

local ROWS = { "QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM" }

export type Key = {
	x: number,
	y: number,
	z: number,
	sx: number,
	sz: number,
	-- "A".."Z".
	letter: string,
	stage: number,
	-- "deck" (lobby / safe zones) | "key" (run / key / end / sill platforms) | "blink" |
	-- "mover" | "block" (decor islands).
	kind: string,
	-- Platform id = index into Layout.platforms (keys of one platform blink / slide together);
	-- 0 for decks and blocks.
	group: number,
	-- Colour: index 1..3 into PALETTES[stage + 1] (see CardioLayout.tintOf).
	tint: number,
	-- Index into Layout.blocks for kind "block".
	block: number?,
	blinkOn: number?,
	blinkPeriod: number?,
	phase: number?,
	axis: string?,
	travel: number?,
	period: number?,
}

export type Point = { x: number, y: number, z: number }
export type Pad = { x: number, z: number, size: number }
export type Treadmill = { x: number, y: number, z: number, yaw: number }

export type Zone = {
	stage: number,
	x0: number,
	x1: number,
	z0: number,
	z1: number,
	top: number,
	-- A key centre near the zone's entrance, on the centre line (the lobby's is where every
	-- run starts and where a fall, a catch and a WIN pad claim put you).
	spawn: Point,
	treadmills: { Treadmill },
	upgradePad: Pad?,
	-- Safe zones 1..10: the square WIN pad (cash out here; Modes.Cardio).
	winPad: Pad?,
}

export type Platform = {
	id: number,
	stage: number,
	-- 0 for the run-up pieces and the west sill, k = the platform after jump k, #jumps for
	-- the end platform and the east sill.
	index: number,
	x0: number,
	x1: number,
	z0: number,
	z1: number,
	top: number,
	-- "sill" | "run" | "key" | "blink" | "mover" | "end".
	kind: string,
	-- For sills: index into Layout.doors.
	door: number?,
	blinkOn: number?,
	blinkPeriod: number?,
	phase: number?,
	travel: number?,
	period: number?,
}

-- Stage banner: (x, y, z) is its centre, inside bridge room n just past the west doorway;
-- the doorway frame around the entrance is archSpan wide (outer) and archHeight tall above
-- the deck (ORIGIN.y).
export type Sign = {
	stage: number,
	need: number,
	name: string,
	x: number,
	y: number,
	z: number,
	archSpan: number,
	archHeight: number,
}

-- Box by centre and size. side = "north" (+Z) | "south" (-Z) side walls, "west" | "east"
-- end walls (bridge room doors, lobby / finish caps). part = "full" | "left" | "right" |
-- "lintel" | "under" (end wall pieces around a doorway). gap = true where the wall runs
-- along hazard (bridge rooms).
export type Wall = {
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	stage: number,
	room: number,
	side: string,
	part: string,
	gap: boolean,
}
-- Slab under a static carpet: group = platform id (0 for decks / blocks); block = block id
-- for a block's pillar (reaches the hazard floor).
export type Base = {
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	stage: number,
	group: number,
	block: number?,
}
export type Bounds = { x0: number, x1: number, z0: number, z1: number }

export type Room = {
	id: number,
	-- "lobby" | "bridge" | "zone".
	kind: string,
	stage: number,
	theme: string,
	x0: number,
	x1: number,
	z0: number,
	z1: number,
	-- Hazard floor top (bridge rooms; under the deck elsewhere).
	floorY: number,
	-- Feet below this inside the room = fall.
	killY: number,
	wallTop: number,
}

export type Door = {
	x: number,
	y: number,
	z: number,
	width: number,
	height: number,
	stage: number,
	side: string,
	timed: boolean,
	open: number,
	period: number,
	phase: number,
}

export type Beam = { a: Point, b: Point, thick: number, stage: number, wall: string }

export type Prop = {
	kind: string,
	x: number,
	y: number,
	z: number,
	yaw: number,
	scale: number,
	stage: number,
	wall: boolean,
	normal: Point?,
	float: boolean,
}

export type Block = { id: number, stage: number, x0: number, x1: number, z0: number, z1: number, top: number }

export type Layout = {
	keys: { Key },
	zones: { Zone },
	-- Every walkable bridge surface in course order; platforms[id].id == id.
	platforms: { Platform },
	signs: { Sign },
	walls: { Wall },
	bases: { Base },
	rooms: { Room },
	doors: { Door },
	trusses: { Beam },
	props: { Prop },
	blocks: { Block },
	finish: Point,
	bounds: Bounds,
}

-- Park-Miller LCG: exact in doubles, values in [0, 1).
local function lcg(seed: number): () -> number
	local state = seed
	return function()
		state = (state * 16807) % 2147483647
		return state / 2147483647
	end
end

local function round1(v: number): number
	return math.floor(v * 10 + 0.5) / 10
end

type Rect = { x0: number, x1: number, z0: number, z1: number }
type Surface = { x0: number, x1: number, z0: number, z1: number, top: number, stage: number }

-- Horizontal distance between two rectangles (0 when they touch or overlap).
local function rectDist(a: Rect, b: Rect): number
	local dx = math.max(0, a.x0 - b.x1, b.x0 - a.x1)
	local dz = math.max(0, a.z0 - b.z1, b.z0 - a.z1)
	return math.sqrt(dx * dx + dz * dz)
end
CardioLayout.rectDist = rectDist

-- The path's footprint in one bridge room: every surface (sliding ones over their sweep)
-- plus the air box over every gap (spanning both sides across Z).
function CardioLayout.footprint(platforms: { Platform }, stage: number): { Rect }
	local out: { Rect } = {}
	local prev: Rect? = nil
	for _, p in platforms do
		if p.stage == stage then
			local t = p.travel or 0
			local r = { x0 = p.x0, x1 = p.x1, z0 = p.z0 - t, z1 = p.z1 + t }
			table.insert(out, r)
			if prev and r.x0 > prev.x1 + 1e-6 then
				table.insert(out, { x0 = prev.x1, x1 = r.x0, z0 = math.min(prev.z0, r.z0), z1 = math.max(prev.z1, r.z1) })
			end
			prev = r
		end
	end
	return out
end

function CardioLayout.generate(): Layout
	local rand = lcg(20261007)
	local K = CardioLayout.KEY.size
	local O = CardioLayout.ORIGIN
	local HALF = CardioLayout.CORRIDOR.width / 2
	local R = CardioLayout.ROOM
	local RHALF = R.width / 2
	local DW = CardioLayout.DOOR_WALL
	local W = CardioLayout.WALL
	local floorY = O.y - R.floorDrop
	local keys: { Key } = {}
	local zones: { Zone } = {}
	local platforms: { Platform } = {}
	local signs: { Sign } = {}
	local walls: { Wall } = {}
	local bases: { Base } = {}
	local rooms: { Room } = {}
	local doors: { Door } = {}
	local trusses: { Beam } = {}
	local props: { Prop } = {}
	local blocks: { Block } = {}
	-- Global key column counter (letters shift one key per column).
	local column = 0

	local function pickTint(left: number?, back: number?): number
		local strict = rand() < CardioLayout.TINT_SPREAD
		local options = {}
		for t = 1, 3 do
			if not strict or (t ~= left and t ~= back) then
				table.insert(options, t)
			end
		end
		return options[math.floor(rand() * #options) + 1]
	end

	local function letterAt(z: number): string
		local row = ROWS[column % 3 + 1]
		local lane = math.floor((z - (O.z - HALF)) / K + 1e-6)
		local c = (lane + column) % #row + 1
		return string.sub(row, c, c)
	end

	-- Lays a carpet of `lanes` keys across from z0, `cols` keys along X from x0.
	local function carpet(
		stage: number,
		x0: number,
		cols: number,
		z0: number,
		lanes: number,
		top: number,
		kind: string,
		group: number,
		p: Platform?,
		block: number?
	)
		local back: { number } = {}
		for i = 0, cols - 1 do
			local left: number? = nil
			local row: { number } = {}
			for l = 0, lanes - 1 do
				local tint = pickTint(left, back[l])
				local z = z0 + K / 2 + l * K
				local key: Key = {
					x = x0 + i * K + K / 2,
					y = top,
					z = z,
					sx = K,
					sz = K,
					letter = letterAt(z),
					stage = stage,
					kind = kind,
					group = group,
					tint = tint,
					block = block,
				}
				if p and (p.kind == "blink" or p.kind == "mover") then
					key.blinkOn = p.blinkOn
					key.blinkPeriod = p.blinkPeriod
					key.phase = p.phase
					key.axis = if p.kind == "mover" then "z" else nil
					key.travel = p.travel
					key.period = p.period
				end
				table.insert(keys, key)
				row[l] = tint
				left = tint
			end
			back = row
			column += 1
		end
	end

	local function addBase(box: Surface, group: number)
		local B = CardioLayout.BASE
		table.insert(bases, {
			x = (box.x0 + box.x1) / 2,
			y = box.top - CardioLayout.KEY.height - B.drop - B.depth / 2,
			z = (box.z0 + box.z1) / 2,
			sx = box.x1 - box.x0,
			sy = B.depth,
			sz = box.z1 - box.z0,
			stage = box.stage,
			group = group,
		})
	end

	-- Snap a spawn to a key centre: a respawn on a key seam drops the Humanoid's floor ray
	-- between the caps, so the character sinks into the keys.
	local function spawnOn(box: Surface, x: number, y: number, z: number): Point
		return {
			x = box.x0 + (math.floor((x - box.x0) / K) + 0.5) * K,
			y = y,
			z = box.z0 + (math.floor((z - box.z0) / K) + 0.5) * K,
		}
	end

	local function addWall(
		x0: number,
		x1: number,
		y0: number,
		y1: number,
		z0: number,
		z1: number,
		stage: number,
		room: number,
		side: string,
		part: string,
		gap: boolean
	)
		if x1 - x0 < 1e-6 or y1 - y0 < 1e-6 or z1 - z0 < 1e-6 then
			return
		end
		table.insert(walls, {
			x = (x0 + x1) / 2,
			y = (y0 + y1) / 2,
			z = (z0 + z1) / 2,
			sx = x1 - x0,
			sy = y1 - y0,
			sz = z1 - z0,
			stage = stage,
			room = room,
			side = side,
			part = part,
			gap = gap,
		})
	end

	local function addRoom(kind: string, stage: number, x0: number, x1: number, half: number, wallTop: number): Room
		local room: Room = {
			id = #rooms + 1,
			kind = kind,
			stage = stage,
			theme = CardioLayout.STAGE_THEMES[stage],
			x0 = x0,
			x1 = x1,
			z0 = O.z - half,
			z1 = O.z + half,
			floorY = floorY,
			killY = floorY + CardioLayout.KILL_ABOVE,
			wallTop = wallTop,
		}
		table.insert(rooms, room)
		-- Side walls.
		for _, side in { "south", "north" } do
			local zIn = if side == "north" then room.z1 else room.z0 - W.thick
			addWall(x0, x1, W.bottom, wallTop, zIn, zIn + W.thick, stage, room.id, side, "full", kind == "bridge")
		end
		return room
	end

	local function deck(stage: number, x0: number, long: number, wide: number): Zone
		local z0 = O.z - wide * K / 2
		carpet(stage, x0, long, z0, wide, O.y, "deck", 0, nil)
		local zone: Zone = {
			stage = stage,
			x0 = x0,
			x1 = x0 + long * K,
			z0 = z0,
			z1 = z0 + wide * K,
			top = O.y,
			spawn = { x = x0 + 6, y = O.y + 3, z = O.z },
			treadmills = {},
			upgradePad = nil,
			winPad = nil,
		}
		table.insert(zones, zone)
		local box = { x0 = zone.x0, x1 = zone.x1, z0 = zone.z0, z1 = zone.z1, top = O.y, stage = stage }
		addBase(box, 0)
		zone.spawn = spawnOn(box, zone.spawn.x, zone.spawn.y, zone.spawn.z)
		addRoom(if stage == 0 then "lobby" else "zone", stage, zone.x0, zone.x1, wide * K / 2, O.y + CardioLayout.ZONE_WALL_HEIGHT)
		return zone
	end

	local function platform(p: Platform): Surface
		table.insert(platforms, p)
		local box = { x0 = p.x0, x1 = p.x1, z0 = p.z0, z1 = p.z1, top = p.top, stage = p.stage }
		local kind = if p.kind == "blink" or p.kind == "mover" then p.kind else "key"
		local cols = math.floor((p.x1 - p.x0) / K + 0.5)
		local lanes = math.floor((p.z1 - p.z0) / K + 0.5)
		carpet(p.stage, p.x0, cols, p.z0, lanes, p.top, kind, p.id, p)
		if kind == "key" then
			addBase(box, p.id)
		end
		return box
	end

	-- An end wall (one key thick, x0..x0+DW) across a bridge room with a doorway; the sill
	-- platform fills the doorway's floor.
	local function endWall(
		x0: number,
		room: Room,
		side: string,
		zc: number,
		width: number,
		stage: number,
		timing: { open: number, period: number }?
	)
		local B = CardioLayout.BASE
		local zA, zB = O.z - RHALF - W.thick, O.z + RHALF + W.thick
		local dz0, dz1 = zc - width / 2, zc + width / 2
		local under = O.y - CardioLayout.KEY.height - B.drop - B.depth
		local doorTop = O.y + CardioLayout.DOOR.height
		addWall(x0, x0 + DW, W.bottom, room.wallTop, zA, dz0, stage, room.id, side, "left", false)
		addWall(x0, x0 + DW, W.bottom, room.wallTop, dz1, zB, stage, room.id, side, "right", false)
		addWall(x0, x0 + DW, doorTop, room.wallTop, dz0, dz1, stage, room.id, side, "lintel", false)
		addWall(x0, x0 + DW, W.bottom, under, dz0, dz1, stage, room.id, side, "under", false)
		table.insert(doors, {
			x = x0 + DW / 2,
			y = O.y,
			z = zc,
			width = width,
			height = CardioLayout.DOOR.height,
			stage = stage,
			side = side,
			timed = timing ~= nil,
			open = if timing then timing.open else 1,
			period = if timing then timing.period else 1,
			phase = if timing then round1(rand() * timing.period) else 0,
		})
		local sill: Platform = {
			id = #platforms + 1,
			stage = stage,
			index = 0,
			x0 = x0,
			x1 = x0 + DW,
			z0 = dz0,
			z1 = dz1,
			top = O.y,
			kind = "sill",
			door = #doors,
		}
		return sill
	end

	-- X-truss frame on a wall face: u runs along the wall (X for side walls, Z for end walls),
	-- `at(u, y)` maps to world; bays between u0..u1 and y0..y1 (two tiers when tall).
	local function frame(
		u0: number,
		u1: number,
		y0: number,
		y1: number,
		stage: number,
		wall: string,
		at: (number, number) -> Point,
		skip: ((number, number) -> boolean)?
	)
		local T = CardioLayout.TRUSS
		local bays = math.max(1, math.floor((u1 - u0) / T.bay + 0.5))
		local tiers = if y1 - y0 > 40 then 2 else 1
		local bw, th = (u1 - u0) / bays, (y1 - y0) / tiers
		local function beam(ua: number, ya: number, ub: number, yb: number)
			table.insert(trusses, { a = at(ua, ya), b = at(ub, yb), thick = T.thick, stage = stage, wall = wall })
		end
		for t = 0, tiers - 1 do
			local ya, yb = y0 + t * th, y0 + (t + 1) * th
			for b = 0, bays - 1 do
				local ua, ub = u0 + b * bw, u0 + (b + 1) * bw
				if not (skip and skip(ua, ub)) then
					beam(ua, ya, ub, yb)
					beam(ua, yb, ub, ya)
					beam(ua, yb, ub, yb)
					if t == 0 then
						beam(ua, ya, ub, ya)
					end
					beam(ua, ya, ua, yb)
					if b == bays - 1 or (skip and skip(ub, ub + bw)) then
						beam(ub, ya, ub, yb)
					end
				end
			end
		end
	end

	-- Run-up length: what is left of ORIGIN.x..X_END, shared evenly, in whole keys.
	local fixed = (CardioLayout.LOBBY_KEYS.long + CardioLayout.ZONE_KEYS.long * (Rules.STAGE_COUNT - 1) + CardioLayout.FINISH_KEYS.long) * K
	for _, s in Rules.STAGES do
		fixed += s.length + 2 * DW + CardioLayout.END_KEYS.long * K
	end
	local runCols = math.floor((CardioLayout.X_END - O.x - fixed) / Rules.STAGE_COUNT / K)
	if runCols * K < CardioLayout.RUNUP_MIN then
		error(`CardioLayout: run-ups would be {runCols * K} studs (< {CardioLayout.RUNUP_MIN})`)
	end

	local belt = O.y + CardioLayout.TREADMILL.height
	local face = -math.pi / 2

	-- Warm-Up lobby.
	local lobby = deck(0, O.x, CardioLayout.LOBBY_KEYS.long, CardioLayout.LOBBY_KEYS.wide)
	-- Two neat rows of four treadmills along the side walls, the lane between them free.
	for _, dz in { -28, 28 } do
		for _, dx in { 9, 20, 31, 42 } do
			table.insert(lobby.treadmills, { x = lobby.x0 + dx, y = belt, z = O.z + dz, yaw = face })
		end
	end
	lobby.upgradePad = { x = lobby.x0 + 46, z = O.z - 20, size = CardioLayout.UPGRADE_PAD }
	addWall(O.x - W.thick, O.x, W.bottom, rooms[1].wallTop, O.z - HALF - W.thick, O.z + HALF + W.thick, 0, 1, "west", "full", false)

	local function gridLat(v: number): number
		return math.floor(v / K + 0.5) * K
	end

	local prevZone = lobby
	for n = 1, Rules.STAGE_COUNT do
		local s = Rules.STAGES[n]
		local w = s.width
		local wCols = math.floor(w / K + 0.5)
		local look = CardioLayout.themeOf(n)
		local room: Room = {
			id = #rooms + 1,
			kind = "bridge",
			stage = n,
			theme = look.id,
			x0 = prevZone.x1,
			x1 = prevZone.x1,
			z0 = O.z - RHALF,
			z1 = O.z + RHALF,
			floorY = floorY,
			killY = floorY + CardioLayout.KILL_ABOVE,
			wallTop = O.y + R.height,
		}
		table.insert(rooms, room)
		local reach = math.floor((RHALF - R.margin - w / 2) / K) * K
		local doorMax = CardioLayout.DOOR_REACH
		local doorWide = CardioLayout.DOOR.keys * K
		local first = #platforms + 1

		-- West doorway and run-up: a straight run, a sideways leg, a second run.
		local latA = gridLat((rand() * 2 - 1) * math.min(doorMax, reach))
		local cur = room.x0
		platform(endWall(cur, room, "west", O.z + latA, math.max(w, doorWide), n, nil))
		local sillIn = doors[#doors]
		cur += DW
		local shift = (2 + math.floor(rand() * 5)) * K
		local latC = if latA + shift <= reach and (latA - shift < -reach or rand() < 0.5) then latA + shift else latA - shift
		latC = math.clamp(latC, -reach, reach)
		local legCols = wCols
		local aCols = math.floor((runCols - legCols) / 2)
		local cCols = runCols - legCols - aCols
		local function run(x0: number, cols: number, z0: number, z1: number): Surface
			return platform({
				id = #platforms + 1,
				stage = n,
				index = 0,
				x0 = x0,
				x1 = x0 + cols * K,
				z0 = z0,
				z1 = z1,
				top = O.y,
				kind = "run",
			})
		end
		run(cur, aCols, O.z + latA - w / 2, O.z + latA + w / 2)
		cur += aCols * K
		run(cur, legCols, O.z + math.min(latA, latC) - w / 2, O.z + math.max(latA, latC) + w / 2)
		cur += legCols * K
		run(cur, cCols, O.z + latC - w / 2, O.z + latC + w / 2)
		cur += cCols * K
		table.insert(signs, {
			stage = n,
			need = s.need,
			name = s.name,
			x = room.x0 + DW + 1,
			y = O.y + CardioLayout.SIGN_HEIGHT,
			z = sillIn.z,
			archSpan = sillIn.width + 2 * CardioLayout.ARCH.frame,
			archHeight = sillIn.height + CardioLayout.ARCH.frame,
		})

		-- Jump platforms.
		local jumps = Rules.jumps(n)
		local top = O.y
		local prevLat, prevW = latC, w
		local endHalf = CardioLayout.END_KEYS.wide * K / 2
		for k = 1, #jumps - 1 do
			local j = jumps[k]
			cur += j.gap
			top += j.rise
			-- From stage 4 every odd platform is special (its neighbours are solid): blinking,
			-- or sliding from stage 6 (alternating, starting with a slider on even stages).
			local kind = "key"
			if k % 2 == 1 and s.blinkOn then
				kind = if s.movers and (n + (k + 1) / 2) % 2 == 1 then "mover" else "blink"
			end
			-- Sideways shift on the key grid; consecutive surfaces share >= 2 keys of width;
			-- the last platform stays within reach of the end platform.
			local lat = prevLat
			if kind ~= "mover" then
				local options = {}
				for l = -reach, reach, K do
					local ok = math.abs(l - prevLat) <= (w + prevW) / 2 - 2 * K
					if k == #jumps - 1 then
						ok = ok and math.abs(l - math.clamp(l, -doorMax, doorMax)) <= endHalf + w / 2 - 2 * K
					end
					if ok then
						table.insert(options, l)
					end
				end
				lat = options[math.floor(rand() * #options) + 1]
			end
			local zc = O.z + lat
			local p: Platform = {
				id = #platforms + 1,
				stage = n,
				index = k,
				x0 = cur,
				x1 = cur + s.plat,
				z0 = zc - w / 2,
				z1 = zc + w / 2,
				top = top,
				kind = kind,
			}
			if kind == "blink" then
				p.blinkOn = s.blinkOn
				p.blinkPeriod = s.blinkPeriod
				p.phase = round1(rand() * (s.blinkPeriod :: number))
			elseif kind == "mover" then
				local m = s.movers :: Rules.Movers
				p.travel = m.travel
				p.period = m.period
				p.phase = round1(rand() * m.period)
			end
			platform(p)
			prevLat, prevW = lat, w
			cur += s.plat
		end

		-- End platform and the east doorway.
		cur += jumps[#jumps].gap
		local latE = math.clamp(prevLat, -doorMax, doorMax)
		platform({
			id = #platforms + 1,
			stage = n,
			index = #jumps,
			x0 = cur,
			x1 = cur + CardioLayout.END_KEYS.long * K,
			z0 = O.z + latE - endHalf,
			z1 = O.z + latE + endHalf,
			top = O.y,
			kind = "end",
		})
		cur += CardioLayout.END_KEYS.long * K
		local sillOut = endWall(cur, room, "east", O.z + latE, doorWide, n, CardioLayout.DOOR_TIMES[n])
		sillOut.index = #jumps
		platform(sillOut)
		cur += DW
		room.x1 = cur
		for _, side in { "south", "north" } do
			local zIn = if side == "north" then room.z1 else room.z0 - W.thick
			addWall(room.x0, room.x1, W.bottom, room.wallTop, zIn, zIn + W.thick, n, room.id, side, "full", true)
		end

		-- The path's footprint (with the gaps' air) keeps decor clear of every run and jump.
		local roomPlats = {}
		for id = first, #platforms do
			table.insert(roomPlats, platforms[id])
		end
		local foot = CardioLayout.footprint(roomPlats, n)
		local ix0, ix1 = room.x0 + DW, room.x1 - DW
		local function clearOf(r: Rect, d: number): boolean
			for _, f in foot do
				if rectDist(r, f) < d then
					return false
				end
			end
			return true
		end

		-- Trusses: side walls full height; end walls above the doorways' head room, and full
		-- height only away from the path. The top chord sits a beam below the wall top so
		-- every beam has wall behind it.
		local tk = CardioLayout.TRUSS.thick
		frame(ix0, ix1, floorY, room.wallTop - tk, n, "south", function(u, y)
			return { x = u, y = y, z = room.z0 + tk / 2 }
		end)
		frame(ix0, ix1, floorY, room.wallTop - tk, n, "north", function(u, y)
			return { x = u, y = y, z = room.z1 - tk / 2 }
		end)
		local band = O.y + CardioLayout.DOOR.height + 4
		for _, e in { { side = "west", x = ix0 + tk / 2 }, { side = "east", x = ix1 - tk / 2 } } do
			local function at(u: number, y: number): Point
				return { x = e.x, y = y, z = u }
			end
			frame(room.z0, room.z1, band, room.wallTop - tk, n, e.side, at)
			frame(room.z0, room.z1, floorY, band, n, e.side, at, function(u0: number, u1: number)
				return not clearOf({ x0 = e.x - tk, x1 = e.x + tk, z0 = u0, z1 = u1 }, CardioLayout.PROP_CLEAR)
			end)
		end

		-- Raised neon-edged key blocks beside the path.
		local roomBlocks: { Rect } = {}
		for _ = 1, 80 do
			if #roomBlocks >= CardioLayout.PROPS.blocks then
				break
			end
			local cols = 3 + math.floor(rand() * 2)
			local lanes = 3 + math.floor(rand() * 2)
			local bx = ix0 + 8 + rand() * (ix1 - ix0 - 16 - cols * K)
			local bz = room.z0 + 8 + rand() * (R.width - 16 - lanes * K)
			local r = { x0 = bx, x1 = bx + cols * K, z0 = bz, z1 = bz + lanes * K }
			local ok = clearOf(r, 2 * CardioLayout.PROP_CLEAR)
			for _, o in roomBlocks do
				ok = ok and rectDist(r, o) >= 8
			end
			if ok then
				table.insert(roomBlocks, r)
				local btop = O.y + math.floor(rand() * 7) / 2
				local id = #blocks + 1
				table.insert(blocks, { id = id, stage = n, x0 = r.x0, x1 = r.x1, z0 = r.z0, z1 = r.z1, top = btop })
				carpet(n, r.x0, cols, r.z0, lanes, btop, "block", 0, nil, id)
				local pillarTop = btop - CardioLayout.KEY.height - CardioLayout.BASE.drop
				table.insert(bases, {
					x = (r.x0 + r.x1) / 2,
					y = (pillarTop + floorY) / 2,
					z = (r.z0 + r.z1) / 2,
					sx = r.x1 - r.x0,
					sy = pillarTop - floorY,
					sz = r.z1 - r.z0,
					stage = n,
					group = 0,
					block = id,
				})
			end
		end

		-- Candy props on the hazard floor (sunk into liquids) and stuck on the side walls.
		local placed: { { x: number, z: number, r: number } } = {}
		local floorCount = 0
		for _ = 1, 400 do
			if floorCount >= CardioLayout.PROPS.floor then
				break
			end
			local scale = round1(6 + rand() * 10)
			local r = scale / 2
			local x = ix0 + r + 2 + rand() * (ix1 - ix0 - 2 * r - 4)
			local z = room.z0 + r + 2 + rand() * (R.width - 2 * r - 4)
			local kind = look.props[math.floor(rand() * #look.props) + 1]
			local yaw = math.floor(rand() * 628) / 100
			local box = { x0 = x - r, x1 = x + r, z0 = z - r, z1 = z + r }
			local ok = clearOf(box, CardioLayout.PROP_CLEAR)
			for _, b in roomBlocks do
				ok = ok and rectDist(box, b) >= 2
			end
			for _, q in placed do
				ok = ok and math.sqrt((q.x - x) ^ 2 + (q.z - z) ^ 2) >= 0.8 * (q.r + r)
			end
			if ok then
				x, z = round1(x), round1(z)
				table.insert(placed, { x = x, z = z, r = r })
				floorCount += 1
				local liquid = look.hazard.liquid
				table.insert(props, {
					kind = kind,
					x = x,
					y = if liquid then round1(floorY - 0.3 * scale) else floorY,
					z = z,
					yaw = yaw,
					scale = scale,
					stage = n,
					wall = false,
					normal = nil,
					float = liquid,
				})
			end
		end
		for i = 1, CardioLayout.PROPS.wall do
			local scale = round1(9 + rand() * 7)
			local north = i % 2 == 0
			local x =
				round1(ix0 + (math.floor((i - 1) / 2) + 0.5 + (rand() - 0.5) * 0.6) * (ix1 - ix0) / math.ceil(CardioLayout.PROPS.wall / 2))
			table.insert(props, {
				kind = look.props[math.floor(rand() * #look.props) + 1],
				x = x,
				y = round1(O.y + 10 + rand() * (R.height - 18)),
				z = if north then room.z1 else room.z0,
				yaw = math.floor(rand() * 628) / 100,
				scale = scale,
				stage = n,
				wall = true,
				normal = { x = 0, y = 0, z = if north then -1 else 1 },
				float = false,
			})
		end

		-- Extra candy clusters from their own generator (the course's rand sequence, and so
		-- every path, stays as it was): big groups along the side walls' foot, and groups of
		-- three stuck on the walls.
		local extra = lcg(7700 + n * 131)
		local wanted = floorCount + CardioLayout.PROPS.edgeFloor
		for _ = 1, 300 do
			if floorCount >= wanted then
				break
			end
			local north = extra() < 0.5
			local ax = ix0 + 14 + extra() * (ix1 - ix0 - 28)
			for c = 1, 3 do
				local scale = round1(if c == 1 then 13 + extra() * 7 else 7 + extra() * 6)
				local r = scale / 2
				local x = ax + (if c == 1 then 0 else (extra() - 0.5) * 22)
				local inset = r + 1 + extra() * (if c == 1 then 3 else 9)
				local z = if north then room.z1 - inset else room.z0 + inset
				local box = { x0 = x - r, x1 = x + r, z0 = z - r, z1 = z + r }
				local ok = box.x0 >= ix0 + 1 and box.x1 <= ix1 - 1 and clearOf(box, CardioLayout.PROP_CLEAR)
				for _, b in roomBlocks do
					ok = ok and rectDist(box, b) >= 2
				end
				for _, q in placed do
					ok = ok and math.sqrt((q.x - x) ^ 2 + (q.z - z) ^ 2) >= 0.7 * (q.r + r)
				end
				if ok and floorCount < wanted then
					x, z = round1(x), round1(z)
					table.insert(placed, { x = x, z = z, r = r })
					floorCount += 1
					local liquid = look.hazard.liquid
					table.insert(props, {
						kind = look.props[math.floor(extra() * #look.props) + 1],
						x = x,
						y = if liquid then round1(floorY - 0.3 * scale) else floorY,
						z = z,
						yaw = math.floor(extra() * 628) / 100,
						scale = scale,
						stage = n,
						wall = false,
						normal = nil,
						float = liquid,
					})
				end
			end
		end
		local groups = CardioLayout.PROPS.wallGroups
		for g = 1, groups do
			local north = g % 2 == 1
			local ax = ix0 + (math.floor((g - 1) / 2) + 0.5 + (extra() - 0.5) * 0.4) * (ix1 - ix0) / math.ceil(groups / 2)
			local ay = O.y + 18 + extra() * (R.height - 30)
			for c = 1, 3 do
				local scale = round1(if c == 1 then 11 + extra() * 5 else 6 + extra() * 4)
				local r = scale / 2
				local x = math.clamp(ax + (if c == 1 then 0 else (c - 2.5) * 2 * (r + 6)), ix0 + r + 1, ix1 - r - 1)
				local y = math.clamp(ay + (if c == 1 then 0 else (extra() - 0.5) * 12), O.y + r + 1, room.wallTop - r - 1)
				table.insert(props, {
					kind = look.props[math.floor(extra() * #look.props) + 1],
					x = round1(x),
					y = round1(y),
					z = if north then room.z1 else room.z0,
					yaw = math.floor(extra() * 628) / 100,
					scale = scale,
					stage = n,
					wall = true,
					normal = { x = 0, y = 0, z = if north then -1 else 1 },
					float = false,
				})
			end
		end

		-- Safe zone n: the WIN pad in the north band (the last zone's on the centre line, in
		-- front of the finish podium), two rows of two treadmills in the south band.
		local final = n == Rules.STAGE_COUNT
		local size = if final then CardioLayout.FINISH_KEYS else CardioLayout.ZONE_KEYS
		local zone = deck(n, cur, size.long, size.wide)
		local mid = zone.x0 + CardioLayout.ZONE_KEYS.long * K / 2
		for _, row in CardioLayout.TREADMILL_ROWS do
			for _, dx in { -3.5 * K, 3.5 * K } do
				table.insert(zone.treadmills, { x = mid + dx, y = belt, z = O.z - row * K, yaw = face })
			end
		end
		local pad = CardioLayout.WIN_PAD
		local padCol = math.floor((size.long * K - pad) / 2 / K)
		zone.winPad = {
			x = zone.x0 + padCol * K + pad / 2,
			z = if final then O.z else O.z + CardioLayout.WIN_PAD_SIDE * K,
			size = pad,
		}
		prevZone = zone
	end
	local last = zones[#zones]
	addWall(
		last.x1,
		last.x1 + W.thick,
		W.bottom,
		rooms[#rooms].wallTop,
		last.z0 - W.thick,
		last.z1 + W.thick,
		Rules.STAGE_COUNT,
		#rooms,
		"east",
		"full",
		false
	)

	local bx0, bx1, bz0, bz1 = math.huge, -math.huge, math.huge, -math.huge
	local function grow(x0: number, x1: number, z0: number, z1: number)
		bx0, bx1 = math.min(bx0, x0), math.max(bx1, x1)
		bz0, bz1 = math.min(bz0, z0), math.max(bz1, z1)
	end
	for _, key in keys do
		local reachZ = key.sz / 2 + (key.travel or 0)
		grow(key.x - key.sx / 2, key.x + key.sx / 2, key.z - reachZ, key.z + reachZ)
	end
	for _, w in walls do
		grow(w.x - w.sx / 2, w.x + w.sx / 2, w.z - w.sz / 2, w.z + w.sz / 2)
	end
	return {
		keys = keys,
		zones = zones,
		platforms = platforms,
		signs = signs,
		walls = walls,
		bases = bases,
		rooms = rooms,
		doors = doors,
		trusses = trusses,
		props = props,
		blocks = blocks,
		finish = { x = last.x1 - 12, y = last.top, z = O.z },
		bounds = { x0 = bx0, x1 = bx1, z0 = bz0, z1 = bz1 },
	}
end

-- A key's colour as { r, g, b } (0..255).
function CardioLayout.tintOf(key: Key): RGB
	local palette = CardioLayout.PALETTES[key.stage + 1] or CardioLayout.PALETTES[1]
	return palette[key.tint] or palette[1]
end

-- The one layout every helper below reads (generate() is deterministic).
local LAYOUT = CardioLayout.generate()
CardioLayout.LAYOUT = LAYOUT

-- Keys hashed into CELL-stud squares (a key sits in every cell it touches, sliding keys over
-- their whole sweep).
local CELL = 8
local cells: { [number]: { Key } } = {}
local function cellId(cx: number, cz: number): number
	return cx * 65536 + cz
end
for _, key in LAYOUT.keys do
	local reachZ = key.sz / 2 + (key.travel or 0)
	for cx = math.floor((key.x - key.sx / 2) / CELL), math.floor((key.x + key.sx / 2) / CELL) do
		for cz = math.floor((key.z - reachZ) / CELL), math.floor((key.z + reachZ) / CELL) do
			local id = cellId(cx, cz)
			local list = cells[id]
			if not list then
				list = {}
				cells[id] = list
			end
			table.insert(list, key)
		end
	end
end

-- Safe zone of `stage` (0 = lobby).
function CardioLayout.zone(stage: number): Zone?
	return LAYOUT.zones[stage + 1]
end

-- The spawn of the safe zone of `stage` (0 = lobby). Modes.Cardio only uses the lobby's: every
-- run starts there, and a fall, a catch and a WIN pad claim all send you back to it.
function CardioLayout.spawn(stage: number): Point?
	local z = LAYOUT.zones[stage + 1]
	return if z then z.spawn else nil
end

-- The last safe zone passed at this X (the HUD runs stage + 1): n - 1 in bridge room n (not
-- stageAt's n), else stageAt(x).
function CardioLayout.startStageAt(x: number): number
	local room = CardioLayout.roomAt(x)
	return if room and room.kind == "bridge" then room.stage - 1 else CardioLayout.stageAt(x)
end

-- The safe zone whose deck is under (x, z); with y, only when the feet are near its top.
function CardioLayout.zoneAt(x: number, z: number, y: number?): Zone?
	for _, zone in LAYOUT.zones do
		if x >= zone.x0 and x <= zone.x1 and z >= zone.z0 and z <= zone.z1 then
			if y == nil or (y >= zone.top - 2 and y <= zone.top + 12) then
				return zone
			end
		end
	end
	return nil
end

-- Stage of the course at this X: 0 up to the lobby's far edge, n from safe zone n-1's far
-- edge through safe zone n.
function CardioLayout.stageAt(x: number): number
	for _, zone in LAYOUT.zones do
		if x <= zone.x1 then
			return zone.stage
		end
	end
	return Rules.STAGE_COUNT
end

-- Is a key solid at time t, and how far has it slid along its axis?
function CardioLayout.keyState(key: Key, t: number): (boolean, number)
	local on = true
	if key.blinkOn and key.blinkPeriod then
		on = ((t + (key.phase or 0)) % key.blinkPeriod) < key.blinkOn
	end
	local offset = 0
	if key.travel and key.period then
		offset = key.travel * math.sin(2 * math.pi * (t + (key.phase or 0)) / key.period)
	end
	return on, offset
end

-- The key under feet at (x, y, z) (y = feet height); with t, blinking keys that are off are
-- skipped and sliding keys are taken where they are at t (at rest without t).
function CardioLayout.isOverKey(x: number, y: number, z: number, t: number?): Key?
	local list = cells[cellId(math.floor(x / CELL), math.floor(z / CELL))]
	if not list then
		return nil
	end
	for _, key in list do
		if y >= key.y - 2.5 and y <= key.y + 6 and math.abs(x - key.x) <= key.sx / 2 then
			local on, offset = true, 0
			if t then
				on, offset = CardioLayout.keyState(key, t)
			end
			if on and math.abs(z - (key.z + offset)) <= key.sz / 2 then
				return key
			end
		end
	end
	return nil
end

-- Zone stage and treadmill index under feet at (x, y, z), if standing on a treadmill belt.
function CardioLayout.onTreadmill(x: number, y: number, z: number): (number?, number?)
	local T = CardioLayout.TREADMILL
	local zone = CardioLayout.zoneAt(x, z)
	if not zone then
		return nil, nil
	end
	for i, tm in zone.treadmills do
		if math.abs(x - tm.x) <= T.length / 2 and math.abs(z - tm.z) <= T.width / 2 and y >= tm.y - 1 and y <= tm.y + 5 then
			return zone.stage, i
		end
	end
	return nil, nil
end

-- Stage of the safe zone whose WIN pad is under feet at (x, y, z): inside the pad's square,
-- feet between the deck and WIN_PAD_ABOVE studs over it (a jump across the pad does not count).
CardioLayout.WIN_PAD_ABOVE = 4
function CardioLayout.onWinPad(x: number, y: number, z: number): number?
	local zone = CardioLayout.zoneAt(x, z)
	local pad = zone and zone.winPad
	if not zone or not pad then
		return nil
	end
	local half = pad.size / 2
	if math.abs(x - pad.x) <= half and math.abs(z - pad.z) <= half and y >= zone.top - 2 and y <= zone.top + CardioLayout.WIN_PAD_ABOVE then
		return zone.stage
	end
	return nil
end

-- The room spanning this X (lobby, bridge room or safe zone), if any.
function CardioLayout.roomAt(x: number): Room?
	for _, room in LAYOUT.rooms do
		if x >= room.x0 and x <= room.x1 then
			return room
		end
	end
	return nil
end

-- Stage n's bridge room.
function CardioLayout.room(stage: number): Room?
	for _, room in LAYOUT.rooms do
		if room.kind == "bridge" and room.stage == stage then
			return room
		end
	end
	return nil
end

-- Feet below this at X are a fall (the room's killY; KILL_Y outside every room).
function CardioLayout.killYAt(x: number): number
	local room = CardioLayout.roomAt(x)
	return if room then room.killY else CardioLayout.KILL_Y
end

-- Is a doorway open at server time t?
function CardioLayout.doorOpen(door: Door, t: number): boolean
	return not door.timed or ((t + door.phase) % door.period) < door.open
end

return CardioLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="184">
          <Properties>
            <string name="Name">CardioRules</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CardioRules: pure numbers of the CARDIO keyboard runner (no Roblox APIs; unit-tested in
	tests/cardio.luau). See docs/cardio.md.

	Speed is a permanent stat earned by stepping on keys (one step per KEY_STEP studs of ground
	run on keys, worth stepMultiplier Speed) and by standing on treadmills (treadmillRate Speed
	per second). Inside the mode, Humanoid WalkSpeed = walkSpeed(speed):
	  walkSpeed(s) = 16 + 104 * min(1, s / SPEED_AT_CAP) ^ CURVE      (16 at 0, 120 at the cap)
	Jumps use the default character (JumpHeight 7.2, Workspace.Gravity 196.2):
	  airtime(rise)      = (v0 + sqrt(v0^2 - 2 g rise)) / g,  v0 = sqrt(2 g JUMP_HEIGHT)
	  maxGap(walk, rise) = walk * airtime(rise) - SAFETY      the longest gap a stage may use
	  reach(walk, rise)  = walk * airtime(rise) + REACH_SLACK the longest gap physics may allow
	                       (the hitbox lets a body land partly over the edge)
	Stage n's longest (flat) gap is <= maxGap(walkSpeed(need_n)) and > reach(walkSpeed(need_n-1)),
	so the previous stage's Speed can never clear it, even with a perfect edge jump.
	Stage 3 is the first with a chaser, so its gaps are shorter than the curve allows: at
	exactly its need the longest jump keeps 2.9 studs of reach in reserve (2.4 with a 17), 3.5
	at the recommended Speed.
	The HUD also shows recommended(n) = RECOMMEND x need (15% more Speed) as the Speed to run a
	stage with comfortably.

	Stage table (gaps in studs, walk at exactly `need` Speed, no Sneakers):
	  stage  need     walk   maxGap  prev reach  longest gap
	    1        0    16.0     7.9        -          7
	    2      150    25.9    13.2      10.2        12
	    3    1,100    35.8    18.6      15.5        16.5
	    4    3,500    45.8    24.0      20.9        22.5
	    5    8,000    55.7    29.4      26.3        28
	    6   15,000    65.5    34.7      31.7        33
	    7   27,000    76.8    40.8      37.0        39
	    8   45,000    88.7    47.3      43.1        45
	    9   77,000   103.8    55.4      49.6        52.5
	   10  125,000   120.0    64.2      57.7        61

	Progression check (a coarse 1 s simulation, also run in tests/cardio.luau): a player who
	spends half the time running on keys (60% of the time actually stepping) and half on the
	best treadmill they have reached, and buys one treadmill level every 4 minutes, reaches
	  stage 2 ~1.5 min, 3 ~6 min, 4 ~12 min, 5 ~18 min, 6 ~23 min, 7 ~29 min, 8 ~34 min,
	  9 ~41 min, 10 ~49 min (about 70% of the Speed from treadmills).
	Step multiplier: (1 + 0.25 * bestStage) * (1 + 0.1 * treadmillLevel)  (x1 .. x7)
	Treadmill rate:  0.45 * (1 + zoneStage)^1.3 * (1 + 0.25 * level)
	                 * max(1, (speed / 150)^0.25)                         Speed/s
	Treadmill cost:  max(150 * (level + 1)^2, income * (120 + 24 * level)) cash for level -> level + 1
]]

local CardioRules = {}

-- Studs of ground run on keys per counted step (one keycap).
CardioRules.KEY_STEP = 8
CardioRules.BASE_WALK = 16
CardioRules.WALK_CAP = 120
-- Speed at which walkSpeed reaches WALK_CAP (stage 10's need) and the curve exponent.
CardioRules.SPEED_AT_CAP = 125000
CardioRules.CURVE = 0.35

CardioRules.GRAVITY = 196.2
CardioRules.JUMP_HEIGHT = 7.2
-- Studs of reach kept in reserve on every designed jump (phones, late jumps).
CardioRules.SAFETY = 0.8
-- Speed the HUD recommends for a stage, as a multiple of its need.
CardioRules.RECOMMEND = 1.15
-- Studs past the pure take-off-to-landing travel a body can still clear (half the hitbox at
-- each end). Used only to prove a gap is NOT clearable.
CardioRules.REACH_SLACK = 1.5
-- Highest step-up between platforms anywhere in the mode.
CardioRules.MAX_STEP_UP = 5

CardioRules.TREADMILL_MAX = 10
CardioRules.TREADMILL_BASE = 0.45
-- Treadmills grow with the runner: x max(1, (speed / SPEED_REF) ^ SPEED_EXP) (x1 .. ~x5.4).
CardioRules.TREADMILL_SPEED_REF = 150
CardioRules.TREADMILL_SPEED_EXP = 0.25
CardioRules.TREADMILL_ZONE_EXP = 1.3
CardioRules.TREADMILL_LEVEL_BONUS = 0.25
CardioRules.STEP_STAGE_BONUS = 0.25
CardioRules.STEP_LEVEL_BONUS = 0.1
CardioRules.COST_SECONDS = 120
CardioRules.COST_SECONDS_PER_LEVEL = 24
CardioRules.COST_MINIMUM = 150

export type Movers = { travel: number, period: number }

export type Stage = {
	n: number,
	name: string,
	-- Theme.World colour key of the stage's keycaps and sign.
	color: string,
	need: number,
	-- walkSpeed(need), filled in below.
	walk: number,
	-- Longest edge-to-edge gap (studs, flat).
	gap: number,
	-- Bridge width (across the room: 9 keys on stage 1 down to 4 keys from stage 8) and
	-- platform length (along it), studs; whole keys (multiples of CardioLayout.KEY.size = 2.8).
	-- The whole stage bridge (run-up, jog, platforms) is this wide.
	width: number,
	plat: number,
	-- Number of jumps from the end of the stage's run-up carpet to its safe zone.
	jumps: number,
	-- Step-up / step-down height between platforms (<= MAX_STEP_UP).
	rise: number,
	-- Blinking keys: on for blinkOn seconds of every blinkPeriod (nil before stage 4).
	blinkOn: number?,
	blinkPeriod: number?,
	-- Sliding keys (side to side, +-travel studs over period seconds; nil before stage 6).
	movers: Movers?,
	-- Jump course length from the end of the stage's run-up carpet to this stage's safe zone,
	-- studs (gaps + platforms; the run-up itself is laid out by CardioLayout).
	length: number,
}

export type Jump = { gap: number, rise: number }

local function stage(
	name: string,
	color: string,
	need: number,
	gap: number,
	width: number,
	plat: number,
	jumps: number,
	rise: number,
	blink: { number }?,
	movers: Movers?
): Stage
	return {
		n = 0,
		name = name,
		color = color,
		need = need,
		walk = 0,
		gap = gap,
		width = width,
		plat = plat,
		jumps = jumps,
		rise = rise,
		blinkOn = if blink then blink[1] else nil,
		blinkPeriod = if blink then blink[2] else nil,
		movers = movers,
		length = 0,
	}
end

CardioRules.STAGE_COUNT = 10
-- stylua: ignore
CardioRules.STAGES = {
	stage("Home Row",         "Mint",      0,      7,  25.2, 25.2, 4, 0,   nil,          nil),
	stage("Shift Street",     "Sunny",     150,    12, 22.4, 25.2, 4, 1,   nil,          nil),
	stage("Tab Tunnel",       "Teal",      1100,   16.5, 22.4, 22.4, 4, 2,   nil,          nil),
	stage("Caps Lock Canyon", "Orange",    3500,   22.5, 16.8, 22.4, 3, 2.5, { 2.2, 3.2 }, nil),
	stage("Enter Expressway", "Pink",      8000,   28, 16.8, 22.4, 3, 3,   { 2.0, 3.0 }, nil),
	stage("Backspace Bridge", "Blue",      15000,  33, 14, 16.8, 3, 3.5, { 1.9, 2.9 }, { travel = 8, period = 5 }),
	stage("Function Falls",   "Grape",     27000,  39, 14, 16.8, 3, 4,   { 1.8, 2.8 }, { travel = 8, period = 4.5 }),
	stage("Arrow Key Alley",  "Coral",     45000,  45, 11.2, 16.8, 3, 4.5, { 1.7, 2.7 }, { travel = 10, period = 4.2 }),
	stage("Escape Heights",   "RedOrange", 77000,  52.5, 11.2, 16.8, 3, 5,  { 1.6, 2.6 }, { travel = 10, period = 4 }),
	stage("Spacebar Skyway",  "Butter",    125000, 61, 11.2, 16.8, 3, 5,   { 1.5, 2.5 }, { travel = 12, period = 3.8 }),
} :: { Stage }

-- Smooth, increasing, diminishing-returns WalkSpeed for a Speed stat.
function CardioRules.walkSpeed(speed: number): number
	local u = math.clamp(speed / CardioRules.SPEED_AT_CAP, 0, 1)
	return CardioRules.BASE_WALK + (CardioRules.WALK_CAP - CardioRules.BASE_WALK) * u ^ CardioRules.CURVE
end

-- Take-off speed of the default jump.
function CardioRules.jumpVelocity(): number
	return math.sqrt(2 * CardioRules.GRAVITY * CardioRules.JUMP_HEIGHT)
end

-- Seconds in the air for a jump that lands `rise` studs higher (negative = lower); nil when
-- the jump can't reach that height at all.
function CardioRules.airtime(rise: number?): number?
	local r = rise or 0
	local v0 = CardioRules.jumpVelocity()
	local d = v0 * v0 - 2 * CardioRules.GRAVITY * r
	if d < 0 then
		return nil
	end
	return (v0 + math.sqrt(d)) / CardioRules.GRAVITY
end

-- Longest edge-to-edge gap a stage may ask for at this WalkSpeed (with SAFETY in reserve).
function CardioRules.maxGap(walk: number, rise: number?): number
	local t = CardioRules.airtime(rise)
	if not t then
		return 0
	end
	return walk * t - CardioRules.SAFETY
end

-- Longest gap physics could possibly allow at this WalkSpeed (used to prove "not clearable").
function CardioRules.reach(walk: number, rise: number?): number
	local t = CardioRules.airtime(rise)
	if not t then
		return 0
	end
	return walk * t + CardioRules.REACH_SLACK
end

-- The jumps of stage n in order: the first leaves the previous safe zone, the last lands on
-- this stage's safe zone. Platform k (after jump k) sits `rise` higher when k % 4 is 1 or 2,
-- so jumps go up, flat, down, flat... and every zone is at the base height. Flat jumps at
-- even indexes are the stage's longest gap; rising jumps are cut to what the stage's need
-- can clear with the step-up.
function CardioRules.jumps(n: number): { Jump }
	local s = CardioRules.STAGES[n]
	local walk = CardioRules.walkSpeed(s.need)
	local list: { Jump } = {}
	local prevH = 0
	for k = 1, s.jumps do
		local h = if k < s.jumps and (k % 4 == 1 or k % 4 == 2) then s.rise else 0
		local rise = h - prevH
		local gap
		if rise > 0 then
			gap = math.min(0.75 * s.gap, CardioRules.maxGap(walk, rise) - 0.3)
		elseif rise < 0 then
			gap = 0.85 * s.gap
		else
			gap = if k % 2 == 0 then s.gap else 0.85 * s.gap
		end
		table.insert(list, { gap = math.floor(gap * 2) / 2, rise = rise })
		prevH = h
	end
	return list
end

for n, s in CardioRules.STAGES do
	s.n = n
	s.walk = CardioRules.walkSpeed(s.need)
end
for n, s in CardioRules.STAGES do
	local total = 0
	for _, j in CardioRules.jumps(n) do
		total += j.gap
	end
	s.length = total + (s.jumps - 1) * s.plat
end

-- Highest stage whose need this Speed meets (1..STAGE_COUNT).
function CardioRules.stageFor(speed: number): number
	local best = 1
	for n, s in CardioRules.STAGES do
		if speed >= s.need then
			best = n
		end
	end
	return best
end

-- Speed the HUD recommends for stage n: RECOMMEND x its need, a whole number, and never past
-- SPEED_AT_CAP (more Speed than that runs no faster, so the last stage recommends its need).
function CardioRules.recommended(n: number): number
	local s = CardioRules.STAGES[n]
	if not s then
		return 0
	end
	return math.max(s.need, math.min(math.ceil(s.need * CardioRules.RECOMMEND), CardioRules.SPEED_AT_CAP))
end

-- First clears are kept per WIN plate in a bit set (profile.cardio.firsts): bit n - 1 is set
-- once plate n's first-clear pay was taken, so running past a plate never loses its first
-- clear. Saves from before the set (nil) had one counter: every plate up to bestStage counts
-- as taken, as it did then.
local ALL_FIRSTS = 2 ^ CardioRules.STAGE_COUNT - 1

function CardioRules.firstsOf(firsts: number?, bestStage: number): number
	if type(firsts) == "number" and firsts == firsts and firsts >= 0 then
		return bit32.band(math.floor(math.min(firsts, ALL_FIRSTS)), ALL_FIRSTS)
	end
	return 2 ^ math.clamp(math.floor(bestStage), 0, CardioRules.STAGE_COUNT) - 1
end

-- Is plate n's first-clear pay still there?
function CardioRules.isFirst(firsts: number, n: number): boolean
	if n < 1 or n > CardioRules.STAGE_COUNT then
		return false
	end
	return not bit32.btest(firsts, bit32.lshift(1, n - 1))
end

-- The set after plate n's first-clear pay was taken.
function CardioRules.claimFirst(firsts: number, n: number): number
	if n < 1 or n > CardioRules.STAGE_COUNT then
		return firsts
	end
	return bit32.bor(firsts, bit32.lshift(1, n - 1))
end

-- Speed per counted step: grows with the deepest plate claimed and every treadmill level.
function CardioRules.stepMultiplier(bestStage: number, treadmillLevel: number): number
	local b = math.clamp(math.floor(bestStage), 0, CardioRules.STAGE_COUNT)
	local l = math.clamp(math.floor(treadmillLevel), 0, CardioRules.TREADMILL_MAX)
	return (1 + CardioRules.STEP_STAGE_BONUS * b) * (1 + CardioRules.STEP_LEVEL_BONUS * l)
end

-- Speed per second while standing on a treadmill in safe zone `zoneStage` (0 = lobby) with
-- `level` SPEED UP levels; grows on its own with the runner's current Speed (nil = 0).
function CardioRules.treadmillRate(zoneStage: number, level: number, speed: number?): number
	local z = math.clamp(math.floor(zoneStage), 0, CardioRules.STAGE_COUNT)
	local l = math.clamp(math.floor(level), 0, CardioRules.TREADMILL_MAX)
	local s = math.max(speed or 0, 0)
	local grow = math.max(1, (s / CardioRules.TREADMILL_SPEED_REF) ^ CardioRules.TREADMILL_SPEED_EXP)
	return CardioRules.TREADMILL_BASE * (1 + z) ^ CardioRules.TREADMILL_ZONE_EXP * (1 + CardioRules.TREADMILL_LEVEL_BONUS * l) * grow
end

-- Cash to raise the treadmill from `level` to level + 1: 2..5.6 minutes of income, never below
-- a small minimum; math.huge at TREADMILL_MAX.
function CardioRules.treadmillCost(level: number, income: number): number
	local l = math.max(0, math.floor(level))
	if l >= CardioRules.TREADMILL_MAX then
		return math.huge
	end
	local seconds = CardioRules.COST_SECONDS + CardioRules.COST_SECONDS_PER_LEVEL * l
	return math.floor(math.max(CardioRules.COST_MINIMUM * (l + 1) ^ 2, math.max(0, income) * seconds))
end

-- Cash multiplier on stage n's reward (+25% per stage: stage 10 pays 3.25x the pack).
function CardioRules.stageBonus(n: number): number
	return 1 + 0.25 * (math.clamp(math.floor(n), 1, CardioRules.STAGE_COUNT) - 1)
end

return CardioRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="185">
          <Properties>
            <string name="Name">Catalog</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Catalog: the game modes shown on the plaza, one per gate slot (pure data).

	World.Modes builds a gate per entry (locked "COMING SOON" when not enabled); Server.GameModes
	attaches the implementation of every enabled entry by id. To add a mode: give its entry
	`enabled = true`, write its module (see Modes.Parkour for the interface) and add it to
	GameModes' BUILTIN list.
]]

export type Entry = {
	id: string,
	title: string,
	blurb: string,
	slot: number,
	enabled: boolean,
	-- Theme.World colour key of the gate's sign header.
	color: string,
}

local Catalog: { Entry } = {
	{ id = "parkour", title = "PARKOUR", blurb = "Run, jump and bounce over the sea!", slot = 1, enabled = true, color = "Coral" },
	{ id = "mog", title = "MOG TEST", blurb = "Out-mog rivals or duel a real player!", slot = 2, enabled = true, color = "Grape" },
	{
		id = "cardio",
		title = "CARDIO",
		blurb = "Run the giant keyboard and get faster with every step!",
		slot = 3,
		enabled = true,
		color = "Mint",
	},
}

return Catalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="186">
          <Properties>
            <string name="Name">Course</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Course: pure layout data for the GAME MODES plaza and the rainbow sky obby (docs/sky-obby.md).

	No Roblox types: World.Modes builds parts from these numbers, Modes.Parkour polls player
	positions against them and the unit tests check that every jump is fair. All positions
	are world coordinates; a platform's `y` is its TOP surface.

	The plaza sits on the -X side of the hub, between the two plot rows: a boardwalk spur
	leaves the hub ring's -X side at z = 0 and ends on a square wooden deck with the three
	mode gates in a row on its west edge, under one big GAME MODES sign. Every gate is a
	portal: walking through gate 1 teleports the player onto the start deck of their
	current Parkour level.

	The ten Parkour levels are the ten sections (maps) of ONE sky obby high above the clouds
	(every path top >= SKY_Y, a fall is feet below FLOOR_Y). Each map is laid out in its own
	LOCAL frame (start deck at the local origin heading +X) and then placed by the CHAIN: map
	n+1's start deck stands BRIDGE_GAP studs past map n's finish deck along the runner's
	direction there, joined by Course.BRIDGES[n] (a rainbow stair), and every map is turned
	(90-degree steps, maybe mirrored) so the chain zigzags without regions overlapping.
	LEVEL 1 is hand-made (LEVEL1_ELEMENTS); LEVELS 2..10 are generated deterministically by
	Course.generate(n) (own seeded LCG) from Course.TUNING[n], a difficulty table that
	tightens every level: wider gaps, smaller discs, thinner beams, faster/longer movers,
	faster spinners, fewer rest decks, longer paths, bigger height changes and (from level 4)
	blink pads. Every jump stays fair for the default character WITHOUT Double Jump
	(Course.maxGap). A generated path is a serpentine: lanes along local +-X joined by two
	turn pads stepping local +Z; the finish deck is placed one more step +Z, so the next map
	always leaves from the course's outer edge.

	Every level is a themed MAP (Course.MAPS[i], docs/parkour-maps.md): theme, blurb, icon,
	accent and, for 2..10, a `recipe` that makes it play differently on top of TUNING
	(element weights, gap/rise/climb, bounce count, beam length, lane length...).

	Level fields (Course.LEVELS[i] / Course.level(i)):
	  index, name, difficulty (1..10), remote (always true: every level is reached by teleport)
	  theme, blurb, icon, accent   copied from Course.MAPS[i]
	  PROPS       sky scenery (type Prop): floating islands beside the course (one carrying
	              the map's landmark), clouds below, balloons above, map extras
	  palette     Theme.World colour keys: { main, alt, checkpoint, mover, accent, blink }
	              (`checkpoint` is the old name of the rest-deck colour slot)
	              (picker cards and landmark tints; path tops are rainbow, see RAINBOW)
	  ELEMENTS    every element (below); PATH = the `path` ones in walking order
	  KILLS       the map's kill elements (lava), in ELEMENTS order
	  STAGE_FIRST the map's stage number: one stage per map (map n is stage n), a progress
	              label only (no saved respawn spot: a fall always goes back to START)
	  STAGE_LAST  the finish deck's stage (STAGE_FIRST + 1), which is the next map's
	              STAGE_FIRST; map 10's finish is Course.STAGE_COUNT (LEVEL_COUNT + 1)
	  START       { x, y, z, faceX, faceZ }: start deck spawn (feet) and facing
	  FINISH      { x0, x1, z0, z1, y0, y1 }: feet inside it finish the run
	  FINISH_ARCH { x, y, z, faceX, faceZ }: arch centre on the finish deck top; its front
	              faces the incoming runner (faceX/faceZ is that front's direction)
	  WATER_BOX   { x0, x1, z0, z1, y0, y1 }: the cloud catch volume under the map
	              (y0 = FLOOR_Y - 20, y1 = FLOOR_Y)
	  BOUNDS      { x0, x1, z0, z1, y0, y1 }: outside it for LEAVE_SECONDS ends the run
	  PATH_LENGTH horizontal studs from the start deck to the finish deck along PATH
	  MIN_SECONDS minimum seconds for a start-to-finish run (PATH_LENGTH /
	              MAX_PLAUSIBLE_SPEED, anti-cheat)
	  TUNING      the knobs it was generated from (nil for level 1)

	Element kinds (`path = true` elements are walked on, in PATH order). All have kind,
	x, y, z (y = top surface) and `color`:
	  pad         static platform; shape "box" (sx along X, sz along Z), "disc" (radius r),
	              "ring" (a hollow square sx by sz walked on its frame, `width` studs wide;
	              gaps measure it like a box) or "hex" (a six-sided tile of circumradius r, a
	              corner along X; gaps measure it like a disc of radius r, its reach from the
	              flat sides, r * sqrt(3) / 2); optional `name` ("StartDeck", "FinishDeck",
	              "Beam", "Bridge", "RestDeck", ...). A "RestDeck" is a wide square box
	              where the checkpoints used to be: a breather, NOT a checkpoint (there are
	              no checkpoints: a fall sends the runner back to the map's start deck)
	  mover       box platform (sx, sz) that moves: motion "slide" along unit `axis` {x,y,z}
	              or "bob" (axis {0,1,0}) by +-`distance` studs around (x, y, z), one full
	              cycle every `period` seconds; offset = distance * sin(2 pi t / period + phase)
	  slide       straight ramp from `from` {x,y,z} to `to` {x,y,z} (top surface), `width`
	              wide; x, y, z is its midpoint
	  spinner     obstacle (not a path element): a bar `length` long turning about the
	              vertical axis at `speed` rad/s (angle = speed * t + phase) above deck top `y`
	  wall        obstacle: a low wall `h` tall standing on `y` to hop over (sx along X, sz
	              along Z)
	  bounce      bounce pad of radius `r` on a deck top `y`: launches the player up at `power`
	              studs/s (the next path element may be higher than a normal jump)
	  kill        lava box (not a path element) standing on a path deck's top `y`: sx by sz,
	              `h` tall, colour "Lava"; a sliding bar also has motion "slide", axis,
	              distance, period and phase (same formula as movers). Maps 2..10 carry
	              Course.killCount(n) of them (placeKills); Course.inKill checks feet.
	  blink       box pad (sx, sz; path) that is solid only part of the time: solid when
	              ((t + phase) % period) < on, with t = server time (workspace:
	              GetServerTimeNow()); otherwise non-collidable and faded. Never two in a row.

	Colours: every pad/slide path element's `color` cycles Course.RAINBOW in walking order
	along the whole obby (bridges included, rest decks too); movers and blink
	pads keep their map's mover/blink colour.
]]

local Course = {}

-- The plaza deck (x0..x1, z0..z1) and the spur that joins it to the hub ring, whose outer edge
-- is at x = -(2 * PlotLayout.PLOT_HALF + 34) = -138 (World.Hub RING_OUT; tests/run.luau checks it).
Course.PLAZA = { x0 = -210, x1 = -160, z0 = -28, z1 = 28, top = 0.5 }
Course.SPUR = { x0 = -160, x1 = -138, half = 6, top = 0.3 }
-- Where GoModes / ModeQuit put the player (feet): the spur end facing the gates (-X), and
-- in front of the gates facing back toward the hub (+X). faceX: the direction faced.
Course.ARRIVAL = { x = -166, y = 0.5, z = 0, faceX = -1 }
Course.QUIT = { x = -200, y = 0.5, z = 0, faceX = 1 }

-- Mode gates: one per catalog slot, in a row on the plaza's west edge, fronts facing the
-- hub (+X). GATE_HALF is half the opening width of the open (slot 1) gate; locked gates are
-- narrower (World.Modes).
Course.GATE_X = -208
Course.GATES = {
	[1] = { z = 0 },
	[2] = { z = -19 },
	[3] = { z = 19 },
}
Course.GATE_HALF = 6
-- The big GAME MODES sign high above and behind the gates (front faces +X).
Course.BIG_SIGN = { x = -217, z = 0, width = 56, height = 15, bottom = 28 }
-- Best-times board on the plaza, facing the spur mouth.
Course.BOARD = { x = -172, z = 20, faceX = -160, faceZ = 4 }

-- Walking west across this line inside gate 1's opening starts a Parkour run (the player
-- is teleported onto the level's start deck).
Course.START_LINE_X = Course.GATE_X

-- The second plaza: the first mirrored onto the hub's +X side (x -> -x), its gates on the
-- east edge facing -X (toward the hub), the same catalog gates and signs. Walking EAST
-- across START_LINE2_X inside gate 1's opening starts a run there.
Course.PLAZA2 = { x0 = -Course.PLAZA.x1, x1 = -Course.PLAZA.x0, z0 = Course.PLAZA.z0, z1 = Course.PLAZA.z1, top = Course.PLAZA.top }
Course.SPUR2 = { x0 = -Course.SPUR.x1, x1 = -Course.SPUR.x0, half = Course.SPUR.half, top = Course.SPUR.top }
Course.ARRIVAL2 = { x = -Course.ARRIVAL.x, y = Course.ARRIVAL.y, z = Course.ARRIVAL.z, faceX = -Course.ARRIVAL.faceX }
Course.QUIT2 = { x = -Course.QUIT.x, y = Course.QUIT.y, z = Course.QUIT.z, faceX = -Course.QUIT.faceX }
Course.GATE2_X = -Course.GATE_X
Course.GATES2 = {
	[1] = { z = Course.GATES[1].z },
	[2] = { z = Course.GATES[2].z },
	[3] = { z = Course.GATES[3].z },
}
Course.BIG_SIGN2 = {
	x = -Course.BIG_SIGN.x,
	z = Course.BIG_SIGN.z,
	width = Course.BIG_SIGN.width,
	height = Course.BIG_SIGN.height,
	bottom = Course.BIG_SIGN.bottom,
}
Course.BOARD2 = { x = -Course.BOARD.x, z = Course.BOARD.z, faceX = -Course.BOARD.faceX, faceZ = Course.BOARD.faceZ }
Course.START_LINE2_X = Course.GATE2_X

-- Falling in: feet below WATER_Y beyond the island's shore (horizontal distance from the
-- world origin greater than WATER_RADIUS) was the old sea fall (see SKY_Y / inWater).
-- Holds for every level (all of them are far off the island).
Course.WATER_Y = 1.5
Course.WATER_RADIUS = 255
Course.LEAVE_SECONDS = 2.5

-- Jump limits (default character: JumpHeight 7.2, WalkSpeed 16, Workspace.Gravity 196.2):
-- edge-to-edge gaps never above MAX_GAP and step-ups never above MAX_STEP_UP (except onto
-- the element after a bounce pad).
Course.MAX_GAP = 9
Course.MAX_STEP_UP = 5
Course.GRAVITY = 196.2
Course.JUMP_HEIGHT = 7.2
Course.WALK_SPEED = 16
-- Studs of reach kept in reserve on every jump (phones, late jumps).
Course.SAFETY = 0.8

-- Integrity: nobody moves along the course faster than this (studs/s, about twice a
-- Speedy Sneakers run), so a start-to-finish run has a minimum time (MIN_SECONDS).
Course.MAX_PLAUSIBLE_SPEED = 40

Course.LEVEL_COUNT = 10

-- The sky: every path top stands at or above SKY_Y; feet below FLOOR_Y (the cloud floor)
-- is a fall (Course.inWater). WATER_Y / WATER_RADIUS above are the hub's sea line.
Course.SKY_Y = 320
Course.FLOOR_Y = Course.SKY_Y - 24

-- The chain: map n+1's start deck stands BRIDGE_GAP studs (edge to edge) past map n's finish
-- deck, joined by BRIDGE_STEPS boxes BRIDGE_STEP long, each BRIDGE_RISE above the last (the
-- start deck one more BRIDGE_RISE up). Every region keeps REGION_MARGIN studs around its
-- course and scenery; the whole chain stays within +-CHAIN_LIMIT in x and z.
Course.BRIDGE_GAP = 26
Course.BRIDGE_STEPS = 6
Course.BRIDGE_STEP = 3
Course.BRIDGE_WIDTH = 10
Course.BRIDGE_RISE = 1.2
Course.REGION_MARGIN = 9
Course.CHAIN_LIMIT = 1400

-- Path-top colours (Theme.World keys), cycled in walking order along the whole obby.
Course.RAINBOW = {
	"RainbowRed",
	"RainbowOrange",
	"RainbowYellow",
	"RainbowGreen",
	"RainbowCyan",
	"RainbowBlue",
	"RainbowPurple",
	"RainbowPink",
}

-- Longest fair edge-to-edge gap for a jump that lands `dy` studs higher (negative = drop)
-- than it took off, for a jump of apex `jumpHeight` (default 7.2): the walk-speed distance
-- covered while still at or above the landing height, minus SAFETY, capped at MAX_GAP.
-- Negative when the step is out of reach.
function Course.maxGap(dy: number, jumpHeight: number?): number
	local g = Course.GRAVITY
	local v = math.sqrt(2 * g * (jumpHeight or Course.JUMP_HEIGHT))
	local d = v * v - 2 * g * dy
	if d < 0 then
		return -1
	end
	local t = (v + math.sqrt(d)) / g
	return math.min(Course.MAX_GAP, Course.WALK_SPEED * t - Course.SAFETY)
end

export type Element = {
	kind: string,
	shape: string?,
	x: number,
	y: number,
	z: number,
	sx: number?,
	sz: number?,
	r: number?,
	color: string?,
	index: number?,
	path: boolean?,
	motion: string?,
	axis: { number }?,
	distance: number?,
	period: number?,
	phase: number?,
	on: number?,
	length: number?,
	speed: number?,
	h: number?,
	power: number?,
	from: { number }?,
	to: { number }?,
	width: number?,
	name: string?,
	stage: number?,
}

export type Box = { x0: number, x1: number, z0: number, z1: number, y0: number, y1: number }

export type Tuning = {
	gap: number, -- target edge-to-edge gap (clamped to Course.maxGap per jump)
	discR: number,
	beamW: number,
	padSize: number,
	checkpointR: number, -- half the side of a rest deck
	moverTravel: number,
	moverPeriod: number,
	spinSpeed: number,
	spinBars: number,
	checkpointEvery: number, -- path elements per rest deck
	pathLength: number,
	rise: number, -- largest height change per jump (up or down)
	blinkOn: number?, -- seconds solid per cycle (nil = no blink pads)
	blinkPeriod: number?,
}

-- Scenery (World.MapDecor draws it): `y` is where the prop's base stands (Course.WATER_Y for
-- sea props, Course.ISLET_TOP for props standing on an islet, above the course for clouds).
-- `scale` sizes most kinds; islet/lavapool use `r` (radius); a fin circles its (x, z) at `r`

-- Sky scenery (World.MapDecor draws it): `y` is where the prop's base stands (an island's
-- grass top, and the props standing on it) or, for clouds/balloons/stars, their own
-- altitude. `scale` sizes most kinds; an island uses `r` (radius). Course.propFoot(p) is the
-- horizontal radius a prop may cover.
export type Prop = { kind: string, x: number, y: number, z: number, yaw: number?, scale: number?, r: number?, speed: number? }

-- How a generated map plays: element weights (pad, disc, beam, slide = sideways slider,
-- bob, spinner, walls, blink, ramp = a slide down onto a landing pad) and knobs that
-- override or bias Course.TUNING[n] (nil = keep the tuning).
export type Recipe = {
	weights: { [string]: number },
	gap: number?, -- target edge-to-edge gap
	rise: number?, -- largest random height change per jump
	climb: number?, -- studs added to every jump's height change (the path climbs or sinks)
	yMax: number?, -- highest platform top (default Y_MAX)
	bounces: number?, -- bounce decks along the path (default 1)
	bounceRise: number?, -- studs up after each bounce (default BOUNCE_RISE)
	beamLength: number?,
	lane: number?, -- centre-x span of one serpentine lane (default LANE)
	checkpointEvery: number?,
	spinBars: number?,
	moverTravel: number?,
	moverPeriod: number?,
	blinkEvery: number?, -- every k-th plain pad blinks (nil = only by weight)
}

export type Map = { theme: string, name: string, blurb: string, icon: string, accent: string, recipe: Recipe? }

export type Level = {
	index: number,
	name: string,
	difficulty: number,
	remote: boolean,
	theme: string,
	blurb: string,
	icon: string,
	accent: string,
	PROPS: { Prop },
	palette: { [string]: string },
	ELEMENTS: { Element },
	PATH: { Element },
	KILLS: { Element },
	STAGE_FIRST: number,
	STAGE_LAST: number,
	START: { x: number, y: number, z: number, faceX: number, faceZ: number },
	FINISH: Box,
	FINISH_ARCH: { x: number, y: number, z: number, faceX: number, faceZ: number },
	WATER_BOX: Box,
	BOUNDS: Box,
	PATH_LENGTH: number,
	MIN_SECONDS: number,
	TUNING: Tuning?,
}

local function box(x: number, y: number, z: number, sx: number, sz: number, color: string, name: string?): Element
	return { kind = "pad", shape = "box", x = x, y = y, z = z, sx = sx, sz = sz, color = color, path = true, name = name }
end

local function disc(x: number, y: number, z: number, r: number, color: string): Element
	return { kind = "pad", shape = "disc", x = x, y = y, z = z, r = r, color = color, path = true }
end

-- A wide square rest deck (2r by 2r) where the old checkpoints stood: a plain pad.
local function restPad(x: number, y: number, z: number, r: number, color: string?): Element
	return box(x, y, z, 2 * r, 2 * r, color or "Sunny", "RestDeck")
end

-- A hollow square tile walked on its frame (`width` studs wide) and a six-sided tile.
local RING_FRAME = 3
local function ring(x: number, y: number, z: number, size: number, color: string): Element
	return { kind = "pad", shape = "ring", x = x, y = y, z = z, sx = size, sz = size, width = RING_FRAME, color = color, path = true }
end

local function hex(x: number, y: number, z: number, r: number, color: string): Element
	return { kind = "pad", shape = "hex", x = x, y = y, z = z, r = r, color = color, path = true }
end

-- Level 1, drawn with its start deck at x = -197, z = 0 (where it once began on the beach):
-- its local frame. The chain (FRAMES[1]: oy = SKY_Y - 0.6) lifts it so the start deck stands
-- at SKY_Y and recolours its path tops rainbow (movers stay Orange).
local LEVEL1_ELEMENTS = {
	-- Start deck and two wide steps up.
	box(-197, 0.6, 0, 14, 14, "Sunny", "StartDeck"),
	box(-210, 2.4, 0, 9, 14, "Butter"),
	box(-221, 4.2, 0, 9, 14, "Sunny"),
	restPad(-234, 5, 0, 6),
	-- Stepping discs.
	disc(-247, 5, 4, 4.5, "Butter"),
	disc(-257, 5.5, -3, 4.5, "Sunny"),
	disc(-267, 6, 3, 4.5, "Butter"),
	disc(-277, 6.5, -2, 4.5, "Sunny"),
	restPad(-291, 7, 0, 6),
	-- Balance beam.
	box(-309, 7, 0, 18, 4, "Butter", "Beam"),
	restPad(-326, 7.5, 0, 6),
	-- A platform sliding back and forth along the course.
	{
		kind = "mover",
		shape = "box",
		x = -341,
		y = 7.5,
		z = 0,
		sx = 9,
		sz = 9,
		color = "Orange",
		path = true,
		motion = "slide",
		axis = { 1, 0, 0 },
		distance = 2.8,
		period = 5,
		phase = 0,
	},
	restPad(-356, 8, 0, 6),
	-- Turn south: a deck with two slow sweeper bars to jump over.
	box(-356, 8, -21, 14, 24, "Sunny", "SweeperDeck"),
	{ kind = "spinner", x = -356, y = 8, z = -15, length = 12, speed = 1.2, phase = 0 },
	{ kind = "spinner", x = -356, y = 8, z = -27, length = 12, speed = -1, phase = math.pi / 2 },
	-- Bounce pad up to the high return lane.
	box(-356, 8, -39, 12, 10, "Butter", "BounceDeck"),
	{ kind = "bounce", x = -356, y = 8, z = -39.5, r = 2.5, power = 78 },
	restPad(-356, 17, -53, 6),
	-- Back east: a bobbing platform, then the wall-hop deck.
	{
		kind = "mover",
		shape = "box",
		x = -341,
		y = 17,
		z = -53,
		sx = 10,
		sz = 10,
		color = "Orange",
		path = true,
		motion = "bob",
		axis = { 0, 1, 0 },
		distance = 2,
		period = 4,
		phase = 0,
	},
	box(-320, 17, -53, 26, 14, "Butter", "WallHopDeck"),
	{ kind = "wall", x = -326, y = 17, z = -53, sx = 1.2, sz = 14, h = 2.4, color = "Teal" },
	{ kind = "wall", x = -320, y = 17, z = -53, sx = 1.2, sz = 14, h = 2.4, color = "Teal" },
	{ kind = "wall", x = -314, y = 17, z = -53, sx = 1.2, sz = 14, h = 2.4, color = "Teal" },
	restPad(-298, 17, -53, 6),
	-- A platform sliding sideways across the lane.
	{
		kind = "mover",
		shape = "box",
		x = -282,
		y = 17,
		z = -53,
		sx = 10,
		sz = 10,
		color = "Orange",
		path = true,
		motion = "slide",
		axis = { 0, 0, 1 },
		distance = 4,
		period = 6,
		phase = math.pi / 2,
	},
	box(-268, 16, -53, 12, 12, "Sunny"),
	restPad(-254.5, 15, -53, 6),
	-- The big slide down to the finish deck.
	box(-242.5, 15, -53, 9, 9, "Butter", "SlideTop"),
	{
		kind = "slide",
		x = -224,
		y = 8.1,
		z = -53,
		from = { -238, 15, -53 },
		to = { -210, 1.2, -53 },
