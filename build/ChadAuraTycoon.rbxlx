  <Item class="ServerScriptService" referent="76">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="77">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">Analytics</string>
          <string name="Source"><![CDATA[--[[
	Analytics: funnels for the Creator Dashboard (AnalyticsService), so ad traffic can be
	judged by where new players stop and how often the shop turns into a purchase.

	Onboarding funnel (Dashboard > Analytics > Funnels > Onboarding), once per player.
	The highest step logged is saved in profile.onboarding; saves from before this
	module start at ONBOARDING_LEGACY and never log.
	  1 Joined            first session starts
	  2 Intro Done        the cutscene finished or was skipped (Player attribute IntroSeen)
	  3..7                each tutorial step reached / finished (Buy, Orbs, Deposit, Collect, Merge)
	A skipped tutorial logs the custom event "TutorialSkipped" and stops the funnel.

	Shop funnel (recurring "Shop"): 1 Opened, 2 Prompted, 3 Purchased. One funnel session
	per shop visit; a prompt from outside the shop (pads, crate panel) starts a new one.
]]

local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TutorialSteps = require(ReplicatedStorage.Shared.TutorialSteps)

local Tycoon = require(script.Parent.Tycoon)

local Analytics = {}

Analytics.ONBOARDING_LEGACY = 99

local ONBOARDING_NAMES = { "Joined", "Intro Done" }
for i, step in TutorialSteps.STEPS do
	ONBOARDING_NAMES[2 + i] = "Tutorial " .. i .. " " .. step.id
end

-- Player -> current shop funnel session id and its last step.
local shopFunnel: { [Player]: { id: string, step: number } } = {}

local function safely(fn: (...any) -> (), ...: any)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Analytics]", err)
	end
end

-- Logs onboarding steps up to `step` that this player has not logged yet.
function Analytics.onboard(session: Tycoon.Session, step: number)
	local p = session.profile
	if not session.alive or step <= p.onboarding or p.onboarding >= Analytics.ONBOARDING_LEGACY then
		return
	end
	for s = p.onboarding + 1, math.min(step, #ONBOARDING_NAMES) do
		safely(AnalyticsService.LogOnboardingFunnelStepEvent, AnalyticsService, session.player, s, ONBOARDING_NAMES[s])
	end
	p.onboarding = step
	Tycoon.markDirty(session)
end

-- Tutorial progress: `step` is the step now current (DONE = finished); skipped = true when skipped.
function Analytics.tutorial(session: Tycoon.Session, step: number, skipped: boolean?)
	if skipped then
		safely(AnalyticsService.LogCustomEvent, AnalyticsService, session.player, "TutorialSkipped", step)
		return
	end
	-- Step n current means steps 1..n-1 are done: funnel step 2 + (n - 1).
	Analytics.onboard(session, 1 + step)
end

function Analytics.shop(player: Player, step: number, name: string)
	local funnel = shopFunnel[player]
	if step == 1 or not funnel or step <= funnel.step then
		funnel = { id = HttpService:GenerateGUID(false), step = 0 }
		shopFunnel[player] = funnel
	end
	funnel.step = step
	safely(AnalyticsService.LogFunnelStepEvent, AnalyticsService, player, "Shop", funnel.id, step, name)
end

function Analytics.onSessionStart(session: Tycoon.Session)
	local player = session.player
	Analytics.onboard(session, 1)
	if player:GetAttribute("IntroSeen") == true then
		Analytics.onboard(session, 2)
	else
		local conn
		conn = player:GetAttributeChangedSignal("IntroSeen"):Connect(function()
			if player:GetAttribute("IntroSeen") == true then
				conn:Disconnect()
				Analytics.onboard(session, 2)
			end
		end)
	end
end

function Analytics.init()
	-- The shop window reports each time it opens (Client.UI.Windows).
	Tycoon.addAction("ShopOpened", function(session)
		Analytics.shop(session.player, 1, "Opened")
	end)
	Players.PlayerRemoving:Connect(function(player)
		shopFunnel[player] = nil
	end)
end

return Analytics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">Badges</string>
          <string name="Source"><![CDATA[--[[
	Badges: awards the Roblox badges listed in Theme.Badges (ids from the universe,
	created with tools/badges.py). A badge with Id 0 is skipped.

	Each badge is awarded once: profile.badges[key] is set when BadgeService confirms it,
	and a failed award is retried on the next check (every CHECK_SECONDS, plus right after
	the tutorial finishes). Conditions read only the saved profile:
	  Welcome        joined the game
	  GymGraduate    finished the tutorial (Badges.graduate, not on a skip)
	  CertifiedChad  discovered tier 10
	  AbsoluteChad   discovered the top tier
	  ParkourMaster  cleared the last parkour level
]]

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)

local Tycoon = require(script.Parent.Tycoon)

local Badges = {}

local CHECK_SECONDS = 5

local theme: any
-- Awards in flight per session, so a slow AwardBadgeAsync is never sent twice.
local busy: { [any]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any

local conditions: { [string]: (profile: any) -> boolean } = {
	Welcome = function()
		return true
	end,
	GymGraduate = function(p)
		return p.badges.GymGraduate == false
	end,
	CertifiedChad = function(p)
		return Economy.highestTier(p.discovered) >= 10
	end,
	AbsoluteChad = function(p)
		return Economy.highestTier(p.discovered) >= Economy.MAX_TIER
	end,
	ParkourMaster = function(p)
		return (p.parkour.clears[#p.parkour.clears] or 0) > 0
	end,
}

-- Awards one badge if its condition holds. profile.badges[key]: true = awarded,
-- false = earned but not yet confirmed by BadgeService (retried), nil = not earned.
local function check(session: Tycoon.Session, key: string)
	local badge = theme.Badges[key]
	local p = session.profile
	if not badge or badge.Id == 0 or p.badges[key] == true or not conditions[key](p) then
		return
	end
	local inFlight = busy[session] or {}
	busy[session] = inFlight
	if inFlight[key] then
		return
	end
	inFlight[key] = true
	local ok, result = pcall(BadgeService.AwardBadgeAsync, BadgeService, session.player.UserId, badge.Id)
	inFlight[key] = nil
	if not session.alive then
		return
	end
	if ok and result then
		p.badges[key] = true
		Tycoon.markDirty(session)
	elseif not ok then
		warn("[Badges]", key, result)
	end
end

local function checkAll(session: Tycoon.Session)
	for key in theme.Badges do
		if session.alive then
			check(session, key)
		end
	end
end

-- The tutorial was finished (not skipped).
function Badges.graduate(session: Tycoon.Session)
	if session.profile.badges.GymGraduate == nil then
		session.profile.badges.GymGraduate = false
	end
	task.spawn(check, session, "GymGraduate")
end

function Badges.onSessionStart(session: Tycoon.Session)
	task.spawn(checkAll, session)
end

function Badges.init(themeModule: any)
	theme = themeModule
	task.spawn(function()
		while true do
			task.wait(CHECK_SECONDS)
			for _, session in Tycoon.allSessions() do
				task.spawn(checkAll, session)
			end
		end
	end)
end

return Badges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--[[
	Cosmetics: the cosmetic game passes (Theme.Cosmetics) and the Starter pack.

	Ownership: an item is owned through its own pass, or the Bundle pass (every item
	except Starter ones), or, for a Starter item, the Starter pack pass.

	Saved in profile.cosmetics: the equipped trail ("" = none) and the on/off switch of
	each toggle item (perk / wear; missing = on). profile.starterGranted marks the
	Starter pack's one-time cash as given.

	On every character (and whenever ownership or equipment changes) the server puts
	the visible pieces on the character so everyone sees them: Humanoid.WalkSpeed, the
	trail (two attachments on the HumanoidRootPart), the aura emitters and the crown.
	Local-only effects (double jump, speed puffs) live in Client.Fx.Cosmetics, which
	reads the Player attributes "CosDoubleJump" and "CosSpeed".

	Speed: WalkSpeed = Humanoid attribute "BaseWalkSpeed" (default
	Theme.Cosmetics.BaseWalkSpeed) x the boost. Code that changes a player's normal speed
	sets that attribute and calls Cosmetics.refresh(player) instead of writing WalkSpeed.

	Client actions:
	  EquipTrail      { name = "<trail item>" | "" }   "" unequips
	  ToggleCosmetic  { name = "<perk/wear item>", value = boolean? }   nil flips
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local AssetModels = require(Shared.AssetModels)

local DataService = require(script.Parent.DataService)
local Tycoon = require(script.Parent.Tycoon)

local Cosmetics = {}

type Session = Tycoon.Session

-- Name of every instance the server adds to a character.
local PIECE_ATTR = "Cosmetic"
-- Trail ribbon: attachment offsets on the HumanoidRootPart (behind the hips).
local TRAIL_TOP = Vector3.new(0, 0.55, 0.45)
local TRAIL_BOTTOM = Vector3.new(0, -1.05, 0.45)
-- Crown width as a fraction of the head's width, and how far it sinks onto the head.
local CROWN_WIDTH = 1.05
local CROWN_SINK = 0.18
-- Seconds before the join-time Starter popup is sent, so the client UI is listening.
local STARTER_NOTIFY_DELAY = 4

local theme: any
-- Per player: the cosmetic instances on the current character, and its connections.
local pieces: { [Player]: { Instance } } = {}
local pieceConns: { [Player]: { RBXScriptConnection } } = {}

-- Sprite image ids from the generated Assets module (nil when missing).
local images: { [string]: string }? = nil
do
	local module = Shared:FindFirstChild("Assets")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module :: any)
		if ok and type(result) == "table" and type((result :: any).Images) == "table" then
			images = (result :: any).Images
		end
	end
end

local function sprite(name: string): string?
	local id = images and images["vfx/" .. name]
	return if type(id) == "string" and id ~= "" then id else nil
end

-- Pure rules (also used by the unit tests) -------------------------------------------------

local function config(t: any): any
	return t and t.Cosmetics
end

-- Does a player with `passes` own cosmetic `name`?
function Cosmetics.owns(t: any, passes: { [string]: boolean }, name: string): boolean
	local c = config(t)
	local item = c and c.Items[name]
	if not item then
		return false
	end
	if item.Starter then
		return passes[c.Starter.Pass] == true
	end
	return (item.Pass ~= nil and passes[item.Pass] == true) or passes[c.Bundle] == true
end

-- { [name] = true } for every owned cosmetic.
function Cosmetics.ownedSet(t: any, passes: { [string]: boolean }): { [string]: boolean }
	local owned = {}
	local c = config(t)
	if c then
		for name in c.Items do
			if Cosmetics.owns(t, passes, name) then
				owned[name] = true
			end
		end
	end
	return owned
end

local function isToggle(item: any): boolean
	return item ~= nil and item.Kind ~= "trail"
end

-- Is toggle item `name` switched on in this profile (missing = on)?
function Cosmetics.toggleOn(profile: any, name: string): boolean
	return profile.cosmetics.toggles[name] ~= false
end

-- Is cosmetic `name` owned and in use (equipped trail / toggle switched on)?
function Cosmetics.active(t: any, profile: any, passes: { [string]: boolean }, name: string): boolean
	local c = config(t)
	local item = c and c.Items[name]
	if not item or not Cosmetics.owns(t, passes, name) then
		return false
	end
	if item.Kind == "trail" then
		return profile.cosmetics.trail == name
	end
	return Cosmetics.toggleOn(profile, name)
end

-- The equipped trail if it is still owned, else "".
function Cosmetics.trail(t: any, profile: any, passes: { [string]: boolean }): string
	local name = profile.cosmetics.trail
	if name ~= "" and Cosmetics.active(t, profile, passes, name) then
		return name
	end
	return ""
end

-- Marks the Starter pack as granted. True exactly once, the first time the pass is owned.
function Cosmetics.claimStarter(t: any, profile: any, passes: { [string]: boolean }): boolean
	local c = config(t)
	if not c or passes[c.Starter.Pass] ~= true or profile.starterGranted then
		return false
	end
	profile.starterGranted = true
	return true
end

-- The Starter pack's cash for a player at `income` cash/s and `progression`.
function Cosmetics.starterCash(t: any, income: number, progression: Economy.Progression): number
	local starter = t.Cosmetics.Starter
	return Economy.moneyPackAmount(income, starter.CashSeconds, starter.CashMin, progression)
end

-- The State snapshot's `cosmetics` field.
function Cosmetics.state(t: any, profile: any, passes: { [string]: boolean }): { [string]: any }
	local c = config(t)
	local toggles = {}
	for name, item in c.Items do
		if isToggle(item) then
			toggles[name] = Cosmetics.toggleOn(profile, name)
		end
	end
	return {
		owned = Cosmetics.ownedSet(t, passes),
		trail = Cosmetics.trail(t, profile, passes),
		toggles = toggles,
		bundleOwned = passes[c.Bundle] == true,
		starterOwned = passes[c.Starter.Pass] == true,
		starterGranted = profile.starterGranted == true,
	}
end

-- Character pieces -------------------------------------------------------------------------

local function clearPieces(player: Player)
	local conns: { RBXScriptConnection } = pieceConns[player] or {}
	for _, conn in conns do
		conn:Disconnect()
	end
	local made: { Instance } = pieces[player] or {}
	for _, inst in made do
		inst:Destroy()
	end
	pieces[player] = {}
	pieceConns[player] = {}
end

local function keep(player: Player, inst: Instance): Instance
	inst:SetAttribute(PIECE_ATTR, true)
	table.insert(pieces[player], inst)
	return inst
end

local function sequence(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keys = {}
	for i, color in colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keys)
end

local function addTrail(player: Player, root: BasePart, item: any)
	local top = keep(player, Instance.new("Attachment")) :: Attachment
	top.Name = "CosTrailTop"
	top.Position = TRAIL_TOP
	top.Parent = root
	local bottom = keep(player, Instance.new("Attachment")) :: Attachment
	bottom.Name = "CosTrailBottom"
	bottom.Position = TRAIL_BOTTOM
	bottom.Parent = root

	local trail = keep(player, Instance.new("Trail")) :: Trail
	trail.Name = "CosTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = sequence(item.Colors or { item.Color })
	trail.Lifetime = 0.55
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 0
	trail.LightInfluence = 0.35
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0.35),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = root

	local starId = if item.Stars then sprite("StarPop") else nil
	if starId then
		local stars = keep(player, Instance.new("ParticleEmitter")) :: ParticleEmitter
		stars.Name = "CosTrailStars"
		stars.Texture = starId
		stars.Rate = 5
		stars.Enabled = true
		stars.LightEmission = 0
		stars.LightInfluence = 0
		stars.Lifetime = NumberRange.new(0.7, 1.1)
		stars.Speed = NumberRange.new(0.5, 1.5)
		stars.SpreadAngle = Vector2.new(60, 60)
		stars.Acceleration = Vector3.new(0, -3, 0)
		stars.Drag = 2
		stars.Rotation = NumberRange.new(-180, 180)
		stars.RotSpeed = NumberRange.new(-60, 60)
		stars.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.15, 0.45),
			NumberSequenceKeypoint.new(0.7, 0.35),
			NumberSequenceKeypoint.new(1, 0),
		})
		stars.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		stars.Parent = bottom
		-- Stars only fall while the player is moving.
		local humanoid = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			table.insert(
				pieceConns[player],
				humanoid.Running:Connect(function(speed)
					stars.Enabled = speed > 2
				end)
			)
		end
	end
end

local function auraEmitter(player: Player, root: BasePart, name: string, props: { [string]: any })
	local id = sprite(name)
	if not id then
		return
	end
	local emitter = keep(player, Instance.new("ParticleEmitter")) :: ParticleEmitter
	emitter.Name = "CosAura" .. name
	emitter.Texture = id
	emitter.LightEmission = 0
	emitter.LightInfluence = 0
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Rotation = NumberRange.new(-180, 180)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.15),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = root
end

local function addAura(player: Player, root: BasePart, item: any)
	local color = item.Color
	auraEmitter(player, root, "Sparkle", {
		Color = ColorSequence.new(color, theme.World.Cream),
		Rate = 6,
		Lifetime = NumberRange.new(0.9, 1.4),
		Speed = NumberRange.new(1, 2),
		Drag = 1,
		RotSpeed = NumberRange.new(-90, 90),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, 0.5),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
	auraEmitter(player, root, "SoftDot", {
		Color = ColorSequence.new(color),
		Rate = 3,
		Lifetime = NumberRange.new(1.4, 2),
		Speed = NumberRange.new(0.4, 1),
		Drag = 0.5,
		RotSpeed = NumberRange.new(0, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.2),
			NumberSequenceKeypoint.new(1, 2.4),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
end

local function dressPart(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

-- A part-built crown (used when the props/Crown mesh is missing): a gold band with
-- round points and a coral gem at the front. `width` studs across, pointing up +Y,
-- centred on the origin.
local function partCrown(width: number, color: Color3): Model
	local model = Instance.new("Model")
	local bandHeight = width * 0.38
	local function piece(shape: Enum.PartType, size: Vector3, cf: CFrame, tint: Color3): BasePart
		local part = Instance.new("Part")
		part.Shape = shape
		part.Size = size
		part.CFrame = cf
		part.Color = tint
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end
	local band = piece(Enum.PartType.Cylinder, Vector3.new(bandHeight, width, width), CFrame.Angles(0, 0, math.rad(90)), color)
	band.Name = "Band"
	model.PrimaryPart = band
	local ball = width * 0.26
	for i = 0, 4 do
		local angle = i / 5 * math.pi * 2
		local offset = Vector3.new(math.sin(angle), 0, -math.cos(angle)) * (width * 0.4)
		piece(Enum.PartType.Ball, Vector3.one * ball, CFrame.new(offset + Vector3.new(0, bandHeight * 0.5 + ball * 0.3, 0)), color).Name =
			"Point"
	end
	piece(Enum.PartType.Ball, Vector3.one * width * 0.2, CFrame.new(0, 0, -width * 0.48), theme.World.Coral).Name = "Gem"
	return model
end

-- The crown model (mesh if uploaded, else part-built), `width` studs wide, bottom at y = 0.
local function crownModel(item: any, width: number): Model
	local clone = AssetModels.clone(item.Model or "props/Crown")
	local mesh: MeshPart? = nil
	if clone then
		local found = if clone:IsA("MeshPart") then clone else clone:FindFirstChildWhichIsA("MeshPart", true)
		if found then
			local part = found :: MeshPart
			mesh = part
			if part ~= clone then
				part.Parent = nil
				clone:Destroy()
			end
		else
			clone:Destroy()
		end
	end
	if mesh then
		local size = mesh.Size
		local scale = width / math.max(size.X, size.Z, 1e-3)
		mesh.Size = size * scale
		mesh.CFrame = CFrame.new(0, mesh.Size.Y / 2, 0)
		mesh.Color = Color3.new(1, 1, 1)
		mesh.Name = "CrownMesh"
		local model = Instance.new("Model")
		mesh.Parent = model
		model.PrimaryPart = mesh
		return model
	end
	local model = partCrown(width, item.Color)
	local box, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + Vector3.new(0, size.Y / 2 - box.Position.Y, 0))
	return model
end

local function addCrown(player: Player, head: BasePart, item: any)
	local width = math.min(head.Size.X, head.Size.Z) * CROWN_WIDTH
	local model = keep(player, crownModel(item, width)) :: Model
	model.Name = "CosCrown"
	-- Model space has the crown's base at y = 0: move it onto the top of the head.
	local seat = head.CFrame * CFrame.new(0, head.Size.Y / 2 - CROWN_SINK * head.Size.Y, 0)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			dressPart(part)
			local world = seat * part.CFrame
			local weld = Instance.new("Weld")
			weld.Part0 = head
			weld.Part1 = part
			weld.C0 = head.CFrame:ToObjectSpace(world)
			weld.Parent = part
			part.CFrame = world
		end
	end
	model.Parent = head.Parent
end

-- Applying ---------------------------------------------------------------------------------

local function applySpeed(player: Player, humanoid: Humanoid, boosted: boolean)
	local c = config(theme)
	local base = humanoid:GetAttribute("BaseWalkSpeed")
	if type(base) ~= "number" then
		base = c.BaseWalkSpeed
		humanoid:SetAttribute("BaseWalkSpeed", base)
	end
	local mult = if boosted then c.Items.SpeedBoost.SpeedMultiplier else 1
	humanoid:SetAttribute("SpeedMultiplier", mult)
	humanoid.WalkSpeed = base * mult
	player:SetAttribute("CosSpeed", boosted)
end

-- Rebuilds every cosmetic on the player's current character.
local function apply(session: Session)
	local player = session.player
	if not session.alive or not config(theme) then
		return
	end
	local profile, passes = session.profile, session.passes
	local items = theme.Cosmetics.Items
	clearPieces(player)
	player:SetAttribute("CosDoubleJump", Cosmetics.active(theme, profile, passes, "DoubleJump"))
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not root or not root:IsA("BasePart") then
		player:SetAttribute("CosSpeed", false)
		return
	end
	applySpeed(player, humanoid, Cosmetics.active(theme, profile, passes, "SpeedBoost"))
	local trail = Cosmetics.trail(theme, profile, passes)
	if trail ~= "" then
		addTrail(player, root, items[trail])
	end
	if Cosmetics.active(theme, profile, passes, "AuraGlow") then
		addAura(player, root, items.AuraGlow)
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") and Cosmetics.active(theme, profile, passes, "Crown") then
		local ok, err = pcall(addCrown, player, head, items.Crown)
		if not ok then
			warn("[Cosmetics] crown:", err)
		end
	end
end

-- Re-applies the player's cosmetics (e.g. after changing the humanoid's BaseWalkSpeed).
function Cosmetics.refresh(player: Player)
	local session = Tycoon.getSession(player)
	if session then
		apply(session)
	end
end

-- Starter pack -----------------------------------------------------------------------------

local function grantStarter(session: Session, delayNotify: boolean)
	local profile = session.profile
	if not Cosmetics.claimStarter(theme, profile, session.passes) then
		return
	end
	local progression = Economy.progression(Economy.highestTier(profile.discovered), profile.processLevel)
	local cash = Cosmetics.starterCash(theme, Tycoon.income(session), progression)
	local starter = theme.Cosmetics.Starter
	Tycoon.grantMoney(session, cash)
	if profile.cosmetics.trail == "" then
		profile.cosmetics.trail = starter.Item
	end
	apply(session)
	Tycoon.markDirty(session)
	if session.canSave then
		task.spawn(DataService.save, session.player, profile)
	end
	local payload = { kind = "Starter", cash = cash, item = starter.Item }
	if delayNotify then
		task.delay(STARTER_NOTIFY_DELAY, function()
			if session.alive then
				Tycoon.notify(session, payload)
			end
		end)
	else
		Tycoon.notify(session, payload)
	end
end

-- A pass was just bought (or granted in Studio).
local function onPassGranted(session: Session, passName: string)
	local c = config(theme)
	if not c then
		return
	end
	if passName == c.Starter.Pass then
		grantStarter(session, false)
		return
	end
	-- A newly bought trail goes on straight away if none is equipped.
	if session.profile.cosmetics.trail == "" then
		for _, name in c.Order do
			local item = c.Items[name]
			if item.Kind == "trail" and (item.Pass == passName or passName == c.Bundle) and not item.Starter then
				session.profile.cosmetics.trail = name
				break
			end
		end
	end
	apply(session)
end

-- Call right after Tycoon.addPlayer: hooks the character and grants an owed Starter pack.
function Cosmetics.onSessionStart(session: Session)
	if not config(theme) then
		return
	end
	local player = session.player
	local function onCharacter(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		character:WaitForChild("Head", 5)
		if humanoid and root and session.alive and player.Character == character then
			apply(session)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	-- The avatar's own parts and accessories can arrive after CharacterAdded.
	player.CharacterAppearanceLoaded:Connect(function(character)
		if session.alive and player.Character == character then
			apply(session)
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	else
		apply(session)
	end
	grantStarter(session, true)
end

function Cosmetics.init(themeModule: any)
	theme = themeModule
	local c = config(theme)
	if not c then
		return
	end

	Tycoon.hooks.passGranted = onPassGranted
	Tycoon.hooks.cosmetics = function(session)
		return Cosmetics.state(theme, session.profile, session.passes)
	end

	Tycoon.addAction("EquipTrail", function(session, data)
		local name = data.name
		if name == "" or name == nil then
			session.profile.cosmetics.trail = ""
		elseif type(name) == "string" then
			local item = c.Items[name]
			if not item or item.Kind ~= "trail" then
				return
			end
			if not Cosmetics.owns(theme, session.passes, name) then
				Tycoon.toast(session, "Unlock " .. item.Title .. " in the shop first!", "info")
				return
			end
			session.profile.cosmetics.trail = name
		else
			return
		end
		apply(session)
	end)

	Tycoon.addAction("ToggleCosmetic", function(session, data)
		local name = data.name
		local item = type(name) == "string" and c.Items[name] or nil
		if not isToggle(item) then
			return
		end
		if not Cosmetics.owns(theme, session.passes, name) then
			Tycoon.toast(session, "Unlock " .. item.Title .. " in the shop first!", "info")
			return
		end
		local value = if type(data.value) == "boolean" then data.value else not Cosmetics.toggleOn(session.profile, name)
		session.profile.cosmetics.toggles[name] = value
		apply(session)
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearPieces(player)
		pieces[player] = nil
		pieceConns[player] = nil
	end)
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService: loads and saves player profiles in a DataStore.

	- Retries with backoff on load/save.
	- If a profile cannot be loaded on a live server the player is kicked
	  instead of being given a blank profile that would overwrite their save.
	- In Studio without API access it falls back to an in-memory profile and
	  never saves, so the game is still playable for testing.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Economy = require(ReplicatedStorage.Shared.Economy)
local SessionLock = require(ReplicatedStorage.Shared.SessionLock)
local TutorialSteps = require(ReplicatedStorage.Shared.TutorialSteps)

local DataService = {}

local STORE_NAME = "TycoonProfiles_v1"
local MAX_RETRIES = 4

export type Unlocker = { rarity: string, endsAt: number }

export type Profile = {
	version: number,
	money: number,
	carried: number,
	queue: number,
	pending: number,
	units: { number },
	discovered: { number },
	totalObtained: number,
	buyTier: number,
	boughtAtTier: number,
	processLevel: number,
	heldChest: string,
	-- Rarity of the crate the player was last prompted to open with Robux ("" = none);
	-- the receipt opens this one if the crate is no longer held.
	pendingCrate: string,
	-- Smasher slot (1 or 2) that Robux prompt was for (0 = the held crate): the receipt
	-- opens the crate still in that slot.
	pendingUnlocker: number,
	unlockers: { Unlocker },
	autoMergeOwned: boolean,
	autoMerge: boolean,
	lastOnline: number,
	lastFreeReward: number,
	settings: { music: boolean, sfx: boolean, fullNumbers: boolean },
	receipts: { string },
	totalEarned: number,
	tutorialStep: number,
	tutorialDone: boolean,
	introSeen: boolean,
	-- Equipped trail ("" = none) and on/off switches of the toggle cosmetics (missing = on).
	cosmetics: { trail: string, toggles: { [string]: boolean } },
	-- The Starter pack's one-time cash and trail have been given.
	starterGranted: boolean,
	-- Highest onboarding funnel step logged (Analytics; ONBOARDING_LEGACY = saves from before it).
	onboarding: number,
	-- Roblox badges: true = awarded, false = earned and waiting to be awarded (Badges).
	badges: { [string]: boolean },
	-- Game mode records: personal best seconds (0 = never finished), finishes, and os.time()
	-- of the last full cash reward (Economy.modeReward cooldown).
	-- Mog Test: best = highest score, rivals = most rivals mogged in one run, clears = tests
	-- passed (and PvP wins paid), pvpWins / pvpPlayed = PvP duels won / fought.
	-- Parkour per level (dense, PARKOUR_LEVELS long, 0 = never): best seconds and finishes.
	-- modes.parkour keeps the shared reward cooldown and mirrors level 1 for the old UI.
	-- stage = highest global sky-obby stage reached (0 = never ran); gear = the chosen
	-- coil ("none" | "speed" | "jump" | "gravity", worn only during runs).
	parkour: { best: { number }, clears: { number }, stage: number, gear: string },
	modes: {
		parkour: { best: number, clears: number, lastRewardAt: number },
		mog: {
			best: number,
			rivals: number,
			clears: number,
			lastRewardAt: number,
			pvpWins: number,
			pvpPlayed: number,
		},
	},
}

-- Must equal Modes.Course.LEVEL_COUNT (checked by the unit tests).
local PARKOUR_LEVELS = 10
DataService.PARKOUR_LEVELS = PARKOUR_LEVELS

local function zeros(n: number): { number }
	local t = table.create(n, 0)
	return t
end

function DataService.defaultProfile(): Profile
	local units = zeros(Economy.MAX_TIER)
	units[1] = 1
	local discovered = zeros(Economy.MAX_TIER)
	discovered[1] = os.time()
	return {
		version = 1,
		money = 50,
		carried = 0,
		queue = 0,
		pending = 0,
		units = units,
		discovered = discovered,
		totalObtained = 1,
		buyTier = 1,
		boughtAtTier = 0,
		processLevel = 0,
		heldChest = "",
		pendingCrate = "",
		pendingUnlocker = 0,
		unlockers = {
			{ rarity = "", endsAt = 0 },
			{ rarity = "", endsAt = 0 },
		},
		autoMergeOwned = false,
		autoMerge = false,
		lastOnline = 0,
		lastFreeReward = 0,
		settings = { music = true, sfx = true, fullNumbers = false },
		receipts = {},
		totalEarned = 0,
		tutorialStep = 1,
		tutorialDone = false,
		introSeen = false,
		cosmetics = { trail = "", toggles = {} },
		starterGranted = false,
		onboarding = 0,
		badges = {},
		parkour = { best = zeros(PARKOUR_LEVELS), clears = zeros(PARKOUR_LEVELS), stage = 0, gear = "none" },
		modes = {
			parkour = { best = 0, clears = 0, lastRewardAt = 0 },
			mog = { best = 0, rivals = 0, clears = 0, lastRewardAt = 0, pvpWins = 0, pvpPlayed = 0 },
		},
	}
end

-- Parkour gear names a save may hold (Modes.Parkour).
local PARKOUR_GEARS = { none = true, speed = true, jump = true, gravity = true }

-- Fills in any fields missing from older saves and sanitises bad values.
local function reconcile(data: any): Profile
	local default = DataService.defaultProfile()
	if type(data) ~= "table" then
		return default
	end
	-- Saves from before Parkour levels: the old single record becomes level 1's.
	if type(data.parkour) ~= "table" then
		local old = type(data.modes) == "table" and data.modes.parkour
		local migrated = { best = zeros(PARKOUR_LEVELS), clears = zeros(PARKOUR_LEVELS), stage = 0, gear = "none" }
		if type(old) == "table" then
			migrated.best[1] = old.best
			migrated.clears[1] = old.clears
		end
		data.parkour = migrated
	end
	-- Saves from before the tutorial existed belong to players who already
	-- know the game: don't send them through onboarding.
	if data.tutorialDone == nil then
		data.tutorialDone = type(data.totalObtained) == "number" and data.totalObtained > 1
	end
	-- Saves from before the intro cutscene existed: those players already know
	-- the story, so it never plays for them.
	if data.introSeen == nil then
		data.introSeen = true
	end
	-- Rizz (gems) was removed from the game: old balances are dropped.
	data.gems = nil
	-- Saves from before the onboarding funnel: those players are not new, so they never log it.
	if data.onboarding == nil then
		data.onboarding = 99
	end
	for key, value in default :: any do
		if data[key] == nil or type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for _, key in { "units", "discovered" } do
		local list = data[key]
		for tier = 1, Economy.MAX_TIER do
			if type(list[tier]) ~= "number" or list[tier] ~= list[tier] then
				list[tier] = 0
			end
		end
	end
	for i = 1, 2 do
		local slot = data.unlockers[i]
		if type(slot) ~= "table" or type(slot.rarity) ~= "string" or type(slot.endsAt) ~= "number" then
			data.unlockers[i] = { rarity = "", endsAt = 0 }
		end
	end
	for key, value in default.settings :: any do
		if type(data.settings[key]) ~= type(value) then
			data.settings[key] = value
		end
	end
	if type(data.cosmetics.trail) ~= "string" then
		data.cosmetics.trail = ""
	end
	if type(data.cosmetics.toggles) ~= "table" then
		data.cosmetics.toggles = {}
	end
	for key, value in data.cosmetics.toggles do
		if type(key) ~= "string" or type(value) ~= "boolean" then
			data.cosmetics.toggles[key] = nil
		end
	end
	data.buyTier = math.clamp(math.floor(data.buyTier), 1, Economy.MAX_BUY_TIER)
	-- Purchases past the upgrade requirement only count once (Economy.unitPrice grows with
	-- them); a save made under a larger requirement would otherwise price units out of reach.
	data.boughtAtTier = math.clamp(math.floor(data.boughtAtTier), 0, Economy.buyTierRequirement(data.buyTier))
	data.tutorialStep = TutorialSteps.clamp(data.tutorialStep)
	if data.heldChest ~= "" and not Economy.isRarity(data.heldChest) then
		data.heldChest = ""
	end
	for id, defaults in default.modes :: any do
		local record = data.modes[id]
		if type(record) ~= "table" then
			data.modes[id] = defaults
		else
			for key, value in defaults do
				local v = record[key]
				if type(v) ~= "number" or v ~= v or v < 0 or v == math.huge then
					record[key] = value
				end
			end
		end
	end
	for _, key in { "best", "clears" } do
		local list = data.parkour[key]
		local fixed = zeros(PARKOUR_LEVELS)
		if type(list) == "table" then
			for i = 1, PARKOUR_LEVELS do
				local v = list[i]
				if type(v) == "number" and v == v and v >= 0 and v ~= math.huge then
					fixed[i] = if key == "clears" then math.floor(v) else v
				end
			end
		end
		data.parkour[key] = fixed
	end
	local stage = data.parkour.stage
	data.parkour.stage = if type(stage) == "number" and stage == stage and stage >= 0 and stage ~= math.huge then math.floor(stage) else 0
	if not PARKOUR_GEARS[data.parkour.gear] then
		data.parkour.gear = "none"
	end
	for key, value in data.badges do
		if type(key) ~= "string" or type(value) ~= "boolean" then
			data.badges[key] = nil
		end
	end
	if data.pendingCrate ~= "" and not Economy.isRarity(data.pendingCrate) then
		data.pendingCrate = ""
	end
	if data.pendingUnlocker ~= 1 and data.pendingUnlocker ~= 2 then
		data.pendingUnlocker = 0
	end
	return data :: Profile
end

-- Exposed for the unit tests.
DataService.reconcile = reconcile

local store: DataStore? = nil
local storeOk, storeErr = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if not storeOk then
	warn("[DataService] DataStore unavailable:", storeErr)
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local lastErr
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(attempt * 1.5)
	end
	warn("[DataService]", label, "failed:", lastErr)
	return false, nil
end

-- This server's identity for session locks (JobId is empty in Studio).
local JOB_ID = if game.JobId ~= "" then game.JobId else ("studio-" .. HttpService:GenerateGUID(false))
-- How long a joining player waits for another server to release their save.
local LOCK_WAIT_SECONDS = 20

local function stripMeta(data: any): any
	if type(data) == "table" then
		data._lock = nil
	end
	return data
end

-- Returns (profile, canSave). profile is nil when the player should be kicked.
-- Acquires a session lock so two servers never write the same save.
function DataService.load(player: Player): (Profile?, boolean)
	if not store then
		if RunService:IsStudio() then
			warn("[DataService] Studio without DataStore access: progress will not be saved.")
			return reconcile(nil), false
		end
		return nil, false
	end
	local activeStore = store :: DataStore
	local started = os.clock()
	while player.Parent do
		local decision: SessionLock.Decision = "acquire"
		local loaded: any = nil
		local ok = retry("load " .. player.Name, function()
			activeStore:UpdateAsync(keyFor(player), function(current)
				local existing = if type(current) == "table" then current._lock else nil
				decision = SessionLock.decide(existing, JOB_ID, os.time(), os.clock() - started, LOCK_WAIT_SECONDS)
				if decision == "wait" then
					return nil -- leave the save untouched
				end
				local data = if type(current) == "table" then current else {}
				data._lock = { jobId = JOB_ID, at = os.time() }
				loaded = table.clone(data)
				return data
			end)
			return true
		end)
		if not ok then
			if RunService:IsStudio() then
				warn("[DataService] Enable 'Studio Access to API Services' to test saving. Using a temporary profile.")
				return reconcile(nil), false
			end
			return nil, false
		end
		if decision ~= "wait" then
			if decision == "steal" then
				warn("[DataService] Took over a save still locked by another server for", player.Name)
			end
			local isNew = loaded == nil or next(stripMeta(loaded)) == nil
			return reconcile(if isNew then nil else loaded), true
		end
		task.wait(3)
	end
	return nil, false
end

-- Saves the profile if this server still owns the session lock.
-- `release` clears the lock (player left / server shutting down).
-- Returns (saved, lostOwnership). lostOwnership is true when another server has
-- taken over this save; the caller should stop playing this session.
function DataService.save(player: Player, profile: Profile, release: boolean?): (boolean, boolean)
	if not store then
		return false, false
	end
	local activeStore = store :: DataStore
	profile.lastOnline = os.time()
	local stillOwner = true
	local ok = retry("save " .. player.Name, function()
		activeStore:UpdateAsync(keyFor(player), function(current)
			local existing = if type(current) == "table" then current._lock else nil
			if existing ~= nil and not SessionLock.owns(existing, JOB_ID) then
				stillOwner = false
				return nil -- another server owns this save now; never overwrite it
			end
			local data = table.clone(profile) :: any
			data._lock = if release then nil else { jobId = JOB_ID, at = os.time() }
			return data
		end)
		return true
	end)
	if not stillOwner then
		warn("[DataService] Save for", player.Name, "is owned by another server; not overwriting.")
	end
	return ok and stillOwner, not stillOwner
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">GameModes</string>
          <string name="Source"><![CDATA[--[[
	GameModes: the registry of plaza game modes and their shared plumbing.

	A mode is a catalog entry (Modes.Catalog: id, title, blurb, gate slot, enabled) plus an
	implementation registered here (see Modes.Parkour):

	  start(player, teleport, options)
	                           begin a run (teleport = move the player to the mode's start;
	                           options = the "ModeStart" action's data table, or nil);
	                           returns false when refused
	  stop(player, reason)     end the player's run: "quit" | "left" | "respawn" | "leave" |
	                           "switch" | "invalid"
	  running(player)          is the player in a run of this mode?
	  tick(player, root, now)  every TICK seconds for every player with a character
	                           (position polling: start lines, checkpoints, falls)
	  snapshot(player)         the State snapshot's modes[id] table
	  rewardPreview(player)    what finishing right now would pay ({ cash, full, ... })

	Every implementation's create() receives (GameModes, context) with context = { built =
	World.Modes' Built, theme, Tycoon, world = WorldBuilder's whole result }.

	GameModes keeps which mode each player is in, stops runs on leave / respawn, provides the
	teleports (mode start, plaza, own plot) and the Notify / Effect helpers, and adds the
	actions "ModeStart" { mode }, "ModeQuit" and "GoModes". Modes add their own actions
	through context.Tycoon.addAction (Parkour: "ParkourGear" { gear }, "ParkourSkip"). A
	run's stop (any reason, including "respawn" and "leave") must undo whatever the mode put
	on the character (Parkour's gear).

	Notify payloads all have kind = "Mode", `event` and `mode` (see Modes.Parkour for each
	event's fields). Effects are fired on the "Effect" remote as (kind, data).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)

local Catalog = require(script.Parent.Modes.Catalog)
local Course = require(script.Parent.Modes.Course)

local GameModes = {}

export type ModeDef = {
	id: string,
	title: string,
	blurb: string,
	slot: number,
	enabled: boolean,
	start: (player: Player, teleport: boolean, options: { [string]: any }?) -> boolean,
	stop: (player: Player, reason: string) -> (),
	running: (player: Player) -> boolean,
	tick: (player: Player, root: BasePart, now: number) -> (),
	snapshot: (player: Player) -> { [string]: any },
	rewardPreview: (player: Player) -> { [string]: any },
}

-- Implementations of the built-in modes, by catalog id. Each module returns
-- { create = function(GameModes, context) -> ModeDef }.
local BUILTIN = {
	parkour = script.Parent.Modes.Parkour,
	mog = script.Parent.Modes.Mog,
}

local TICK = 0.1

local modes: { [string]: ModeDef } = {}
local order: { string } = {}
local Tycoon: any

-- Reward hooks: `reward` may change a reward before it is paid (events, boosts);
-- `rewarded` is told after it was paid. reward = { cash, full, packCash }.
GameModes.hooks = {
	reward = function(_session: any, _modeId: string, reward: { [string]: any }): { [string]: any }
		return reward
	end,
	rewarded = function(_session: any, _modeId: string, _reward: { [string]: any }) end,
}

local function catalogEntry(id: string): Catalog.Entry?
	for _, entry in Catalog do
		if entry.id == id then
			return entry
		end
	end
	return nil
end

-- Registers a mode implementation; title, blurb, slot and enabled come from the catalog.
function GameModes.register(def: ModeDef)
	local entry = catalogEntry(def.id)
	assert(entry, "unknown game mode " .. tostring(def.id))
	def.title = entry.title
	def.blurb = entry.blurb
	def.slot = entry.slot
	def.enabled = entry.enabled
	if not modes[def.id] then
		table.insert(order, def.id)
	end
	modes[def.id] = def
end

function GameModes.get(id: string): ModeDef?
	return modes[id]
end

function GameModes.list(): { ModeDef }
	local out = {}
	for _, id in order do
		table.insert(out, modes[id])
	end
	return out
end

-- The mode the player is running right now, if any.
function GameModes.active(player: Player): ModeDef?
	for _, id in order do
		local def = modes[id]
		if def.running(player) then
			return def
		end
	end
	return nil
end

function GameModes.start(player: Player, id: string, teleport: boolean, options: { [string]: any }?): boolean
	local def = modes[id]
	if not def or not def.enabled then
		return false
	end
	local current = GameModes.active(player)
	if current and current ~= def then
		current.stop(player, "switch")
	end
	local ok = def.start(player, teleport, options)
	if not ok and current then
		-- The old run is over and the new one was refused: never leave the player standing
		-- on a far arena with no run.
		GameModes.toGates(player)
	end
	return ok
end

function GameModes.stop(player: Player, reason: string)
	local current = GameModes.active(player)
	if current then
		current.stop(player, reason)
	end
end

-- Helpers for mode implementations ---------------------------------------------------------

function GameModes.session(player: Player): any
	return Tycoon and Tycoon.getSession(player)
end

function GameModes.notify(player: Player, event: string, modeId: string, data: { [string]: any }?)
	local session = GameModes.session(player)
	if not session then
		return
	end
	local payload: { [string]: any } = { kind = "Mode", event = event, mode = modeId }
	if data then
		for key, value in data do
			payload[key] = value
		end
	end
	Tycoon.notify(session, payload)
end

function GameModes.effect(player: Player, kind: string, data: { [string]: any })
	Net.event("Effect"):FireClient(player, kind, data)
end

-- Pushes a fresh State snapshot to the player.
function GameModes.refresh(player: Player)
	if Tycoon then
		Tycoon.refresh(player)
	end
end

function GameModes.root(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Moves the player's character so its feet stand at `feet`, facing `look` (horizontal).
function GameModes.teleport(player: Player, feet: Vector3, look: Vector3)
	local character = player.Character
	local root = GameModes.root(player)
	if not character or not root then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hip = if humanoid then humanoid.HipHeight else 2
	local pos = feet + Vector3.new(0, hip + root.Size.Y / 2 + 0.2, 0)
	character:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(look.X, 0, look.Z)))
	root.AssemblyLinearVelocity = Vector3.zero
end

local function spot(s: { x: number, y: number, z: number }): Vector3
	return Vector3.new(s.x, s.y, s.z)
end

type Spot = { x: number, y: number, z: number }

-- Facing for a plaza spot: its faceX (a direction, or an x to look toward) or `default`
-- (plazas sit west of the hub at -x and mirrored at +x, so the side decides the default).
local function faceOf(s: Spot, default: number): Vector3
	local f = (s :: any).faceX
	if type(f) ~= "number" then
		return Vector3.new(default, 0, 0)
	end
	local dx = if math.abs(f) <= 1 then f else f - s.x
	return Vector3.new(if dx == 0 then default else math.sign(dx), 0, 0)
end

-- The spot nearest the player's current position via Course[helper] (two plazas), else
-- `fallback` (the original plaza's spot).
local function nearest(player: Player, helper: string, fallback: Spot): Spot
	local pick = (Course :: any)[helper]
	local root = GameModes.root(player)
	if type(pick) ~= "function" or not root then
		return fallback
	end
	local found = pick(root.Position.X, root.Position.Z)
	return if type(found) == "table" then found else fallback
end

-- The nearer plaza's arrival point (end of its spur), facing the gates.
function GameModes.toPlaza(player: Player)
	local s = nearest(player, "nearestArrival", Course.ARRIVAL)
	GameModes.teleport(player, spot(s), faceOf(s, if s.x > 0 then 1 else -1))
end

-- In front of the nearer plaza's gates, facing back toward the hub (after quitting a run).
function GameModes.toGates(player: Player)
	local s = nearest(player, "nearestQuit", Course.QUIT)
	GameModes.teleport(player, spot(s), faceOf(s, if s.x > 0 then -1 else 1))
end

-- Brings a player back from a teleport-only arena (a far Parkour level, the Mog stage):
-- after `seconds`, unless they started another run or `stillThere` says they already left,
-- they stand in front of the gates again.
function GameModes.returnLater(player: Player, seconds: number, stillThere: ((root: BasePart) -> boolean)?)
	task.delay(seconds, function()
		local root = GameModes.root(player)
		if not root or GameModes.active(player) then
			return
		end
		if stillThere and not stillThere(root) then
			return
		end
		GameModes.toGates(player)
	end)
end

-- The State snapshot's `modes` table: modes[id] for every registered mode.
function GameModes.snapshot(player: Player): { [string]: any }
	local out = {}
	for _, id in order do
		out[id] = modes[id].snapshot(player)
	end
	return out
end

-- Setup --------------------------------------------------------------------------------------

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function()
		GameModes.stop(player, "respawn")
	end)
end

function GameModes.init(built: any, theme: any, tycoon: any, world: any)
	Tycoon = tycoon
	for id, module in BUILTIN do
		local impl = (require :: any)(module)
		GameModes.register(impl.create(GameModes, { built = built, theme = theme, Tycoon = tycoon, world = world }))
		assert(modes[id], "mode " .. id .. " did not register")
	end

	Tycoon.hooks.modes = function(session: any)
		return GameModes.snapshot(session.player)
	end
	-- "Home" during a run ends it first (un-anchors a Mog player, no "left" stop later).
	Tycoon.hooks.leavingForHome = function(session: any)
		GameModes.stop(session.player, "quit")
	end

	Tycoon.addAction("ModeStart", function(session, data)
		if type(data.mode) == "string" then
			GameModes.start(session.player, data.mode, true, data)
		end
	end)
	Tycoon.addAction("ModeQuit", function(session)
		if GameModes.active(session.player) then
			GameModes.stop(session.player, "quit")
			GameModes.toGates(session.player)
		end
	end)
	Tycoon.addAction("GoModes", function(session)
		GameModes.stop(session.player, "quit")
		GameModes.toPlaza(session.player)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		GameModes.stop(player, "leave")
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local now = Workspace:GetServerTimeNow()
			for _, player in Players:GetPlayers() do
				local root = GameModes.root(player)
				if root and Tycoon.getSession(player) then
					for _, id in order do
						local ok, err = pcall(modes[id].tick, player, root, now)
						if not ok then
							warn("[GameModes] tick:", err)
						end
					end
				end
			end
		end
	end)
end

return GameModes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">Intro</string>
          <string name="Source"><![CDATA[--[[
	Intro: server side of the opening cutscene (client: Client.Intro.Cutscene).

	The saved profile field introSeen says whether the player has watched it.
	When a session starts it is copied to the Player attribute "IntroSeen";
	the client plays the cutscene when that is false and sends the "IntroSeen"
	action when it ends (finished or skipped), which saves it as true.
]]

local Tycoon = require(script.Parent.Tycoon)

local Intro = {}

-- Call before Tycoon.addPlayer sends the first State snapshot.
function Intro.onSessionStart(player: Player, profile: { [string]: any })
	player:SetAttribute("IntroSeen", profile.introSeen == true)
end

function Intro.init()
	Tycoon.addAction("IntroSeen", function(session)
		if not session.alive then
			return
		end
		session.player:SetAttribute("IntroSeen", true)
		if session.profile.introSeen ~= true then
			session.profile.introSeen = true
			Tycoon.markDirty(session)
		end
	end)
end

return Intro
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="84">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the map, wires services and handles join/leave/saving.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local Net = require(ReplicatedStorage.Shared.Net)

local Server = script.Parent
local DataService = require(Server.DataService)
local WorldBuilder = require(Server.WorldBuilder)
local Tycoon = require(Server.Tycoon)
local Monetization = require(Server.Monetization)
local Ranking = require(Server.Ranking)
local Tutorial = require(Server.Tutorial)
local Intro = require(Server.Intro)
local GameModes = require(Server.GameModes)
local Cosmetics = require(Server.Cosmetics)
local Analytics = require(Server.Analytics)
local Badges = require(Server.Badges)

local AUTOSAVE_SECONDS = 90

-- Create remotes before anything else so clients never wait long.
Net.event("State")

local world = WorldBuilder.build(Theme)
Tycoon.init(world, Theme)
Tutorial.init()
Intro.init()
Monetization.init(Theme)
GameModes.init(world.modes, Theme, Tycoon, world)
Cosmetics.init(Theme)
Ranking.init(Theme, world.ranking)
Analytics.init()
Badges.init(Theme)

local saving: { [Player]: boolean } = {}

local function saveSession(session: Tycoon.Session, release: boolean?)
	if not session.canSave then
		return
	end
	local _, lost = DataService.save(session.player, session.profile, release)
	if lost and not release then
		-- Another server owns this save now (e.g. the player joined elsewhere).
		-- Stop writing from here so progress can never be overwritten.
		session.canSave = false
		session.player:Kick("Your progress is now active in another server. Please rejoin!")
	end
end

local function onPlayerAdded(player: Player)
	local profile, canSave = DataService.load(player)
	if not player.Parent then
		-- Left while loading: hand the session lock back straight away.
		if profile and canSave then
			DataService.save(player, profile, true)
		end
		return
	end
	if not profile then
		player:Kick("We couldn't load your save right now. Please rejoin in a moment - your progress is safe.")
		return
	end
	local passes = Monetization.ownedPasses(player)
	if not player.Parent then
		if canSave then
			DataService.save(player, profile, true)
		end
		return
	end
	-- Before the session's first State snapshot, so the client knows whether to play the intro.
	Intro.onSessionStart(player, profile)
	local session = Tycoon.addPlayer(player, profile, canSave, passes)
	if session then
		Cosmetics.onSessionStart(session)
		Analytics.onSessionStart(session)
		Badges.onSessionStart(session)
	end
end

local function onPlayerRemoving(player: Player)
	local session = Tycoon.removePlayer(player)
	if session and not saving[player] then
		saving[player] = true
		saveSession(session, true)
		saving[player] = nil
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_SECONDS)
		for player, session in Tycoon.allSessions() do
			if not saving[player] then
				task.spawn(saveSession, session)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player, session in Tycoon.allSessions() do
		pending += 1
		saving[player] = true
		task.spawn(function()
			saveSession(session, true)
			pending -= 1
		end)
	end
	Ranking.writeScores()
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="85">
        <Properties>
          <string name="Name">Modes</string>
        </Properties>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">Catalog</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Catalog: the game modes shown on the plaza, one per gate slot (pure data).

	World.Modes builds a gate per entry (locked "COMING SOON" when not enabled); Server.GameModes
	attaches the implementation of every enabled entry by id. To add a mode: give its entry
	`enabled = true`, write its module (see Modes.Parkour for the interface) and add it to
	GameModes' BUILTIN list.
]]

export type Entry = {
	id: string,
	title: string,
	blurb: string,
	slot: number,
	enabled: boolean,
	-- Theme.World colour key of the gate's sign header.
	color: string,
}

local Catalog: { Entry } = {
	{ id = "parkour", title = "PARKOUR", blurb = "Run, jump and bounce over the sea!", slot = 1, enabled = true, color = "Coral" },
	{ id = "mog", title = "MOG TEST", blurb = "Out-mog rivals or duel a real player!", slot = 2, enabled = true, color = "Grape" },
	{ id = "soon3", title = "COMING SOON", blurb = "A new game mode is on its way!", slot = 3, enabled = false, color = "Steel" },
}

return Catalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Course</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Course: pure layout data for the GAME MODES plaza and the rainbow sky obby (docs/sky-obby.md).

	No Roblox types: World.Modes builds parts from these numbers, Modes.Parkour polls player
	positions against them and the unit tests check that every jump is fair. All positions
	are world coordinates; a platform's `y` is its TOP surface.

	The plaza sits on the -X side of the hub, between the two plot rows: a boardwalk spur
	leaves the hub ring's -X side at z = 0 and ends on a square wooden deck with the three
	mode gates in a row on its west edge, under one big GAME MODES sign. Every gate is a
	portal: walking through gate 1 teleports the player onto the start deck of their
	current Parkour level.

	The ten Parkour levels are the ten sections (maps) of ONE sky obby high above the clouds
	(every path top >= SKY_Y, a fall is feet below FLOOR_Y). Each map is laid out in its own
	LOCAL frame (start deck at the local origin heading +X) and then placed by the CHAIN: map
	n+1's start deck stands BRIDGE_GAP studs past map n's finish deck along the runner's
	direction there, joined by Course.BRIDGES[n] (a rainbow stair), and every map is turned
	(90-degree steps, maybe mirrored) so the chain zigzags without regions overlapping.
	LEVEL 1 is hand-made (LEVEL1_ELEMENTS); LEVELS 2..10 are generated deterministically by
	Course.generate(n) (own seeded LCG) from Course.TUNING[n], a difficulty table that
	tightens every level: wider gaps, smaller discs, thinner beams, faster/longer movers,
	faster spinners, fewer checkpoints, longer paths, bigger height changes and (from level 4)
	blink pads. Every jump stays fair for the default character WITHOUT Double Jump
	(Course.maxGap). A generated path is a serpentine: lanes along local +-X joined by two
	turn pads stepping local +Z; the finish deck is placed one more step +Z, so the next map
	always leaves from the course's outer edge.

	Every level is a themed MAP (Course.MAPS[i], docs/parkour-maps.md): theme, blurb, icon,
	accent and, for 2..10, a `recipe` that makes it play differently on top of TUNING
	(element weights, gap/rise/climb, bounce count, beam length, lane length...).

	Level fields (Course.LEVELS[i] / Course.level(i)):
	  index, name, difficulty (1..10), remote (always true: every level is reached by teleport)
	  theme, blurb, icon, accent   copied from Course.MAPS[i]
	  PROPS       sky scenery (type Prop): floating islands beside the course (one carrying
	              the map's landmark), clouds below, balloons above, map extras
	  palette     Theme.World colour keys: { main, alt, checkpoint, mover, accent, blink }
	              (picker cards and landmark tints; path tops are rainbow, see RAINBOW)
	  ELEMENTS    every element (below); PATH = the `path` ones in walking order
	  CHECKPOINTS checkpoint elements by index; CHECKPOINT_COUNT
	  KILLS       the map's kill elements (lava), in ELEMENTS order
	  STAGE_FIRST global stage of the start deck; checkpoint k is stage STAGE_FIRST + k;
	  STAGE_LAST  the finish deck's stage (STAGE_FIRST + CHECKPOINT_COUNT + 1), which is the
	              next map's STAGE_FIRST
	  START       { x, y, z, faceX, faceZ }: start deck spawn (feet) and facing
	  FINISH      { x0, x1, z0, z1, y0, y1 }: feet inside it after the last checkpoint finish
	  FINISH_ARCH { x, y, z, faceX, faceZ }: arch centre on the finish deck top; its front
	              faces the incoming runner (faceX/faceZ is that front's direction)
	  WATER_BOX   { x0, x1, z0, z1, y0, y1 }: the cloud catch volume under the map
	              (y0 = FLOOR_Y - 20, y1 = FLOOR_Y)
	  BOUNDS      { x0, x1, z0, z1, y0, y1 }: outside it for LEAVE_SECONDS ends the run
	  MIN_LEG_SECONDS  minimum seconds per checkpoint leg (anti-cheat)
	  TUNING      the knobs it was generated from (nil for level 1)

	Element kinds (`path = true` elements are walked on, in PATH order). All have kind,
	x, y, z (y = top surface) and `color`:
	  pad         static platform; shape "box" (sx along X, sz along Z), "disc" (radius r),
	              "ring" (a hollow square sx by sz walked on its frame, `width` studs wide;
	              gaps measure it like a box) or "hex" (a six-sided tile of circumradius r, a
	              corner along X; gaps measure it like a disc of radius r, its reach from the
	              flat sides, r * sqrt(3) / 2); optional `name` ("StartDeck", "FinishDeck",
	              "Beam", "Bridge", ...)
	  checkpoint  static square arrow pad (shape "box", sx = sz = 2 * r), numbered `index`
	              1..n in course order, global `stage`
	  mover       box platform (sx, sz) that moves: motion "slide" along unit `axis` {x,y,z}
	              or "bob" (axis {0,1,0}) by +-`distance` studs around (x, y, z), one full
	              cycle every `period` seconds; offset = distance * sin(2 pi t / period + phase)
	  slide       straight ramp from `from` {x,y,z} to `to` {x,y,z} (top surface), `width`
	              wide; x, y, z is its midpoint
	  spinner     obstacle (not a path element): a bar `length` long turning about the
	              vertical axis at `speed` rad/s (angle = speed * t + phase) above deck top `y`
	  wall        obstacle: a low wall `h` tall standing on `y` to hop over (sx along X, sz
	              along Z)
	  bounce      bounce pad of radius `r` on a deck top `y`: launches the player up at `power`
	              studs/s (the next path element may be higher than a normal jump)
	  kill        lava box (not a path element) standing on a path deck's top `y`: sx by sz,
	              `h` tall, colour "Lava"; a sliding bar also has motion "slide", axis,
	              distance, period and phase (same formula as movers). Maps 2..10 carry
	              Course.killCount(n) of them (placeKills); Course.inKill checks feet.
	  blink       box pad (sx, sz; path) that is solid only part of the time: solid when
	              ((t + phase) % period) < on, with t = server time (workspace:
	              GetServerTimeNow()); otherwise non-collidable and faded. Never two in a row.

	Colours: every pad/slide path element's `color` cycles Course.RAINBOW in walking order
	along the whole obby (bridges included); checkpoints are "Checkpoint"; movers and blink
	pads keep their map's mover/blink colour.
]]

local Course = {}

-- The plaza deck (x0..x1, z0..z1) and the spur that joins it to the hub ring at x = -118.
Course.PLAZA = { x0 = -190, x1 = -140, z0 = -28, z1 = 28, top = 0.5 }
Course.SPUR = { x0 = -140, x1 = -118, half = 6, top = 0.3 }
-- Where GoModes / ModeQuit put the player (feet): the spur end facing the gates (-X), and
-- in front of the gates facing back toward the hub (+X). faceX: the direction faced.
Course.ARRIVAL = { x = -146, y = 0.5, z = 0, faceX = -1 }
Course.QUIT = { x = -180, y = 0.5, z = 0, faceX = 1 }

-- Mode gates: one per catalog slot, in a row on the plaza's west edge, fronts facing the
-- hub (+X). GATE_HALF is half the opening width of the open (slot 1) gate; locked gates are
-- narrower (World.Modes).
Course.GATE_X = -188
Course.GATES = {
	[1] = { z = 0 },
	[2] = { z = -19 },
	[3] = { z = 19 },
}
Course.GATE_HALF = 6
-- The big GAME MODES sign high above and behind the gates (front faces +X).
Course.BIG_SIGN = { x = -197, z = 0, width = 56, height = 15, bottom = 28 }
-- Best-times board on the plaza, facing the spur mouth.
Course.BOARD = { x = -152, z = 20, faceX = -140, faceZ = 4 }

-- Walking west across this line inside gate 1's opening starts a Parkour run (the player
-- is teleported onto the level's start deck).
Course.START_LINE_X = Course.GATE_X

-- The second plaza: the first mirrored onto the hub's +X side (x -> -x), its gates on the
-- east edge facing -X (toward the hub), the same catalog gates and signs. Walking EAST
-- across START_LINE2_X inside gate 1's opening starts a run there.
Course.PLAZA2 = { x0 = -Course.PLAZA.x1, x1 = -Course.PLAZA.x0, z0 = Course.PLAZA.z0, z1 = Course.PLAZA.z1, top = Course.PLAZA.top }
Course.SPUR2 = { x0 = -Course.SPUR.x1, x1 = -Course.SPUR.x0, half = Course.SPUR.half, top = Course.SPUR.top }
Course.ARRIVAL2 = { x = -Course.ARRIVAL.x, y = Course.ARRIVAL.y, z = Course.ARRIVAL.z, faceX = -Course.ARRIVAL.faceX }
Course.QUIT2 = { x = -Course.QUIT.x, y = Course.QUIT.y, z = Course.QUIT.z, faceX = -Course.QUIT.faceX }
Course.GATE2_X = -Course.GATE_X
Course.GATES2 = {
	[1] = { z = Course.GATES[1].z },
	[2] = { z = Course.GATES[2].z },
	[3] = { z = Course.GATES[3].z },
}
Course.BIG_SIGN2 = {
	x = -Course.BIG_SIGN.x,
	z = Course.BIG_SIGN.z,
	width = Course.BIG_SIGN.width,
	height = Course.BIG_SIGN.height,
	bottom = Course.BIG_SIGN.bottom,
}
Course.BOARD2 = { x = -Course.BOARD.x, z = Course.BOARD.z, faceX = -Course.BOARD.faceX, faceZ = Course.BOARD.faceZ }
Course.START_LINE2_X = Course.GATE2_X

-- Falling in: feet below WATER_Y beyond the island's shore (horizontal distance from the
-- world origin greater than WATER_RADIUS) sends a running player back to their checkpoint.
-- Holds for every level (all of them are far off the island).
Course.WATER_Y = 1.5
Course.WATER_RADIUS = 219
Course.LEAVE_SECONDS = 2.5

-- Jump limits (default character: JumpHeight 7.2, WalkSpeed 16, Workspace.Gravity 196.2):
-- edge-to-edge gaps never above MAX_GAP and step-ups never above MAX_STEP_UP (except onto
-- the element after a bounce pad).
Course.MAX_GAP = 9
Course.MAX_STEP_UP = 5
Course.GRAVITY = 196.2
Course.JUMP_HEIGHT = 7.2
Course.WALK_SPEED = 16
-- Studs of reach kept in reserve on every jump (phones, late jumps).
Course.SAFETY = 0.8

-- Integrity: nobody moves along the course faster than this (studs/s, about twice a
-- Speedy Sneakers run), so each checkpoint-to-checkpoint leg has a minimum time.
Course.MAX_PLAUSIBLE_SPEED = 40

Course.LEVEL_COUNT = 10

-- The sky: every path top stands at or above SKY_Y; feet below FLOOR_Y (the cloud floor)
-- is a fall (Course.inWater). WATER_Y / WATER_RADIUS above are the hub's sea line.
Course.SKY_Y = 320
Course.FLOOR_Y = Course.SKY_Y - 24

-- The chain: map n+1's start deck stands BRIDGE_GAP studs (edge to edge) past map n's finish
-- deck, joined by BRIDGE_STEPS boxes BRIDGE_STEP long, each BRIDGE_RISE above the last (the
-- start deck one more BRIDGE_RISE up). Every region keeps REGION_MARGIN studs around its
-- course and scenery; the whole chain stays within +-CHAIN_LIMIT in x and z.
Course.BRIDGE_GAP = 26
Course.BRIDGE_STEPS = 6
Course.BRIDGE_STEP = 3
Course.BRIDGE_WIDTH = 10
Course.BRIDGE_RISE = 1.2
Course.REGION_MARGIN = 9
Course.CHAIN_LIMIT = 1400

-- Path-top colours (Theme.World keys), cycled in walking order along the whole obby.
Course.RAINBOW = {
	"RainbowRed",
	"RainbowOrange",
	"RainbowYellow",
	"RainbowGreen",
	"RainbowCyan",
	"RainbowBlue",
	"RainbowPurple",
	"RainbowPink",
}

-- Longest fair edge-to-edge gap for a jump that lands `dy` studs higher (negative = drop)
-- than it took off, for a jump of apex `jumpHeight` (default 7.2): the walk-speed distance
-- covered while still at or above the landing height, minus SAFETY, capped at MAX_GAP.
-- Negative when the step is out of reach.
function Course.maxGap(dy: number, jumpHeight: number?): number
	local g = Course.GRAVITY
	local v = math.sqrt(2 * g * (jumpHeight or Course.JUMP_HEIGHT))
	local d = v * v - 2 * g * dy
	if d < 0 then
		return -1
	end
	local t = (v + math.sqrt(d)) / g
	return math.min(Course.MAX_GAP, Course.WALK_SPEED * t - Course.SAFETY)
end

export type Element = {
	kind: string,
	shape: string?,
	x: number,
	y: number,
	z: number,
	sx: number?,
	sz: number?,
	r: number?,
	color: string?,
	index: number?,
	path: boolean?,
	motion: string?,
	axis: { number }?,
	distance: number?,
	period: number?,
	phase: number?,
	on: number?,
	length: number?,
	speed: number?,
	h: number?,
	power: number?,
	from: { number }?,
	to: { number }?,
	width: number?,
	name: string?,
	stage: number?,
}

export type Box = { x0: number, x1: number, z0: number, z1: number, y0: number, y1: number }

export type Tuning = {
	gap: number, -- target edge-to-edge gap (clamped to Course.maxGap per jump)
	discR: number,
	beamW: number,
	padSize: number,
	checkpointR: number,
	moverTravel: number,
	moverPeriod: number,
	spinSpeed: number,
	spinBars: number,
	checkpointEvery: number, -- path elements per checkpoint
	pathLength: number,
	rise: number, -- largest height change per jump (up or down)
	blinkOn: number?, -- seconds solid per cycle (nil = no blink pads)
	blinkPeriod: number?,
}

-- Scenery (World.MapDecor draws it): `y` is where the prop's base stands (Course.WATER_Y for
-- sea props, Course.ISLET_TOP for props standing on an islet, above the course for clouds).
-- `scale` sizes most kinds; islet/lavapool use `r` (radius); a fin circles its (x, z) at `r`

-- Sky scenery (World.MapDecor draws it): `y` is where the prop's base stands (an island's
-- grass top, and the props standing on it) or, for clouds/balloons/stars, their own
-- altitude. `scale` sizes most kinds; an island uses `r` (radius). Course.propFoot(p) is the
-- horizontal radius a prop may cover.
export type Prop = { kind: string, x: number, y: number, z: number, yaw: number?, scale: number?, r: number?, speed: number? }

-- How a generated map plays: element weights (pad, disc, beam, slide = sideways slider,
-- bob, spinner, walls, blink, ramp = a slide down onto a landing pad) and knobs that
-- override or bias Course.TUNING[n] (nil = keep the tuning).
export type Recipe = {
	weights: { [string]: number },
	gap: number?, -- target edge-to-edge gap
	rise: number?, -- largest random height change per jump
	climb: number?, -- studs added to every jump's height change (the path climbs or sinks)
	yMax: number?, -- highest platform top (default Y_MAX)
	bounces: number?, -- bounce decks along the path (default 1)
	bounceRise: number?, -- studs up after each bounce (default BOUNCE_RISE)
	beamLength: number?,
	lane: number?, -- centre-x span of one serpentine lane (default LANE)
	checkpointEvery: number?,
	spinBars: number?,
	moverTravel: number?,
	moverPeriod: number?,
	blinkEvery: number?, -- every k-th plain pad blinks (nil = only by weight)
}

export type Map = { theme: string, name: string, blurb: string, icon: string, accent: string, recipe: Recipe? }

export type Level = {
	index: number,
	name: string,
	difficulty: number,
	remote: boolean,
	theme: string,
	blurb: string,
	icon: string,
	accent: string,
	PROPS: { Prop },
	palette: { [string]: string },
	ELEMENTS: { Element },
	PATH: { Element },
	CHECKPOINTS: { Element },
	KILLS: { Element },
	CHECKPOINT_COUNT: number,
	STAGE_FIRST: number,
	STAGE_LAST: number,
	START: { x: number, y: number, z: number, faceX: number, faceZ: number },
	FINISH: Box,
	FINISH_ARCH: { x: number, y: number, z: number, faceX: number, faceZ: number },
	WATER_BOX: Box,
	BOUNDS: Box,
	MIN_LEG_SECONDS: { number },
	TUNING: Tuning?,
}

local function box(x: number, y: number, z: number, sx: number, sz: number, color: string, name: string?): Element
	return { kind = "pad", shape = "box", x = x, y = y, z = z, sx = sx, sz = sz, color = color, path = true, name = name }
end

local function disc(x: number, y: number, z: number, r: number, color: string): Element
	return { kind = "pad", shape = "disc", x = x, y = y, z = z, r = r, color = color, path = true }
end

local function checkpoint(index: number, x: number, y: number, z: number, r: number, color: string?): Element
	return {
		kind = "checkpoint",
		shape = "box",
		index = index,
		x = x,
		y = y,
		z = z,
		sx = 2 * r,
		sz = 2 * r,
		r = r,
		color = color or "Checkpoint",
		path = true,
	}
end

-- A hollow square tile walked on its frame (`width` studs wide) and a six-sided tile.
local RING_FRAME = 3
local function ring(x: number, y: number, z: number, size: number, color: string): Element
	return { kind = "pad", shape = "ring", x = x, y = y, z = z, sx = size, sz = size, width = RING_FRAME, color = color, path = true }
end

local function hex(x: number, y: number, z: number, r: number, color: string): Element
	return { kind = "pad", shape = "hex", x = x, y = y, z = z, r = r, color = color, path = true }
end

