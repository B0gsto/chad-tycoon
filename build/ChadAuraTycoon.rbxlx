<roblox version="4">
  <Item class="ReplicatedFirst" referent="0">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="1">
      <Properties>
        <string name="Name">Loader</string>
        <string name="Source"><![CDATA[-- Loader (ReplicatedFirst): replaces Roblox's default loading screen with the
-- game's own splash and fades it out once the first State snapshot arrives
-- (the client sets the player's "GameReady" attribute) or after a timeout.

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LoadingScreen = require(script:WaitForChild("LoadingScreen"))

local TIMEOUT = 25

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
pcall(function()
	gui.ScreenInsets = Enum.ScreenInsets.None
end)
gui.Parent = player:WaitForChild("PlayerGui")

local screen = LoadingScreen.build(gui, nil)
ReplicatedFirst:RemoveDefaultLoadingScreen()

local started = os.clock()

task.spawn(function()
	local themeModule = ReplicatedStorage:WaitForChild("Theme", TIMEOUT)
	if themeModule and themeModule:IsA("ModuleScript") then
		local ok, theme = pcall(require, themeModule)
		if ok then
			screen.applyTheme(theme)
		end
	end
end)

if not game:IsLoaded() then
	game.Loaded:Wait()
end
while player:GetAttribute("GameReady") ~= true and os.clock() - started < TIMEOUT do
	task.wait(0.1)
end
-- Keep the splash up briefly so it doesn't just flash on fast joins.
local shown = os.clock() - started
if shown < 1.2 then
	task.wait(1.2 - shown)
end
screen.finish()
task.delay(1, function()
	gui:Destroy()
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">LoadingScreen</string>
          <string name="Source"><![CDATA[--[[
	LoadingScreen: full-screen splash shown from ReplicatedFirst until the
	first State snapshot arrives. Standalone (the client Kit isn't replicated
	yet when this runs); it takes the theme later, once ReplicatedStorage has
	arrived, to show the game name, tagline and colours.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local LoadingScreen = {}

export type Handle = {
	root: CanvasGroup,
	applyTheme: (any) -> (),
	setStatus: (string) -> (),
	finish: () -> (),
}

local DEFAULT = {
	Primary = Color3.fromRGB(255, 200, 45),
	Secondary = Color3.fromRGB(165, 80, 255),
	Panel = Color3.fromRGB(24, 20, 36),
	PanelDark = Color3.fromRGB(12, 10, 20),
	Sky = Color3.fromRGB(30, 20, 52),
	Stroke = Color3.fromRGB(8, 6, 14),
	Text = Color3.new(1, 1, 1),
	TextDim = Color3.fromRGB(190, 185, 210),
}

local function new(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function stroke(parent: Instance, thickness: number, color: Color3): UIStroke
	return new("UIStroke", { Thickness = thickness, Color = color, Parent = parent })
end

local function tween(obj: Instance, time: number, props: { [string]: any })
	TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

function LoadingScreen.build(parent: Instance, theme: any?): Handle
	local colors = DEFAULT
	local root = new("CanvasGroup", {
		Name = "Loading",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 100,
		Parent = parent,
	})
	local background = new("UIGradient", { Rotation = 90, Parent = root })

	-- Big soft diagonal bands for depth.
	local bands = {}
	for i = 1, 4 do
		local band = new("Frame", {
			Name = "Band",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.94,
			BorderSizePixel = 0,
			Size = UDim2.new(0.16, 0, 2.5, 0),
			Position = UDim2.fromScale(-0.2 + i * 0.3, -0.7),
			Rotation = 28,
			Parent = root,
		})
		table.insert(bands, band)
	end

	local center = new("Frame", {
		Name = "Center",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(900, 360),
		Position = UDim2.fromScale(0.5, 0.46),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = root,
	})
	new("UISizeConstraint", { MaxSize = Vector2.new(900, 360), Parent = center })
	local scale = new("UIScale", { Parent = center })

	local title = new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.FredokaOne,
		TextSize = 76,
		TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(0, 40),
		Parent = center,
	})
	local titleStroke = stroke(title, 5, colors.Stroke)
	local titleGradient = new("UIGradient", { Rotation = 90, Parent = title })
	local tagline = new("TextLabel", {
		Name = "Tagline",
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.FredokaOne,
		TextSize = 26,
		TextColor3 = colors.TextDim,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 134),
		Parent = center,
	})
	stroke(tagline, 2, colors.Stroke)

	-- Spinner: a ring of dots that fades around.
	local spinner = new("Frame", {
		Name = "Spinner",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.new(0.5, 0, 0, 230),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = center,
	})
	local dots: { Frame } = {}
	local DOTS = 10
	for i = 1, DOTS do
		local angle = (i - 1) / DOTS * math.pi * 2
		local dot = new("Frame", {
			Name = "Dot",
			BackgroundColor3 = colors.Primary,
			BackgroundTransparency = (i - 1) / DOTS * 0.85,
			Size = UDim2.fromOffset(13, 13),
			Position = UDim2.new(0.5 + math.sin(angle) * 0.42, 0, 0.5 - math.cos(angle) * 0.42, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Parent = spinner,
		})
		new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
		stroke(dot, 2, colors.Stroke)
		dots[i] = dot
	end

	local status = new("TextLabel", {
		Name = "Status",
		BackgroundTransparency = 1,
		Text = "Loading...",
		Font = Enum.Font.FredokaOne,
		TextSize = 22,
		TextColor3 = colors.Text,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 284),
		Parent = center,
	})
	stroke(status, 2, colors.Stroke)

	local tip = new("TextLabel", {
		Name = "Tip",
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = colors.TextDim,
		TextWrapped = true,
		Size = UDim2.new(1, -40, 0, 50),
		Position = UDim2.new(0, 20, 1, -80),
		Parent = root,
	})
	stroke(tip, 1.5, colors.Stroke)

	local tips: { string } = {}
	local tipIndex = 0

	local function applyTheme(t: any)
		if type(t) ~= "table" then
			t = {}
		end
		local c = t.Colors or {}
		local primary = c.Primary or DEFAULT.Primary
		local sky = c.Sky or DEFAULT.Sky
		local dark = c.PanelDark or DEFAULT.PanelDark
		background.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, sky:Lerp(Color3.new(1, 1, 1), 0.05)),
			ColorSequenceKeypoint.new(0.6, dark),
			ColorSequenceKeypoint.new(1, dark:Lerp(Color3.new(0, 0, 0), 0.4)),
		})
		for _, band in bands do
			band.BackgroundColor3 = c.Secondary or DEFAULT.Secondary
			band.BackgroundTransparency = 0.94
		end
		local fonts = t.Fonts or {}
		title.Text = string.upper(t.GameName or "")
		title.Font = fonts.Title or Enum.Font.FredokaOne
		titleGradient.Color = ColorSequence.new(primary:Lerp(Color3.new(1, 1, 1), 0.45), primary)
		titleStroke.Color = c.Stroke or DEFAULT.Stroke
		tagline.Text = t.Tagline or ""
		tagline.Font = fonts.Body or Enum.Font.FredokaOne
		status.Font = fonts.Title or Enum.Font.FredokaOne
		for _, dot in dots do
			dot.BackgroundColor3 = primary
		end
		local loading = t.Loading or {}
		status.Text = loading.Status or "Loading..."
		tips = loading.Tips or {}
		if #tips > 0 then
			tipIndex = 1
			tip.Text = tips[1]
		end
	end
	applyTheme(theme)

	local alive = true
	local clock = 0
	local nextTip = 4
	local connection = RunService.RenderStepped:Connect(function(dt)
		clock += dt
		spinner.Rotation = math.floor(clock * 12) * (360 / DOTS)
		if clock >= nextTip and #tips > 1 then
			nextTip = clock + 4
			tipIndex = tipIndex % #tips + 1
			tip.Text = tips[tipIndex]
		end
		local camera = workspace.CurrentCamera
		if camera then
			local size = camera.ViewportSize
			scale.Scale = math.clamp(math.min(size.X / 1000, size.Y / 560), 0.45, 1.4)
		end
	end)

	local function finish()
		if not alive then
			return
		end
		alive = false
		tween(root, 0.6, { GroupTransparency = 1 })
		tween(scale, 0.6, { Scale = scale.Scale * 1.08 })
		task.delay(0.65, function()
			connection:Disconnect()
			root:Destroy()
		end)
	end

	return {
		root = root,
		applyTheme = applyTheme,
		setStatus = function(text: string)
			status.Text = text
		end,
		finish = finish,
	}
end

return LoadingScreen
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="3">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CharacterFactory</string>
          <string name="Source"><![CDATA[--[[
	CharacterFactory: builds the blocky unit figures from a theme "look" table.
	Used by the server (display shelves) and the client (Index / reward
	viewports). Everything is made from plain parts, so no uploaded assets are
	needed.

	Look fields (all optional except colours):
	  skin, shirt, pants : Color3
	  face               : string drawn on the head (emoji or text)
	  faceColor          : Color3 for text faces
	  material           : Enum.Material name for the body ("Metal", "Glass", ...)
	  buff               : 0..1 extra width on torso/arms
	  scale              : overall size multiplier
	  jaw                : true for a wide chin block
	  acc                : list of accessory names (see ACCESSORIES)
	  accColor           : Color3 for accessories
	  aura               : Color3 particle aura
	  sparkles           : true for a Sparkles effect
	  fire               : Color3 fire effect
	  glow               : Color3 point light
]]

local CharacterFactory = {}

export type Look = {
	skin: Color3,
	shirt: Color3,
	pants: Color3,
	face: string?,
	faceColor: Color3?,
	faceFont: Enum.Font?,
	material: string?,
	buff: number?,
	scale: number?,
	jaw: boolean?,
	acc: { string }?,
	accColor: Color3?,
	aura: Color3?,
	sparkles: boolean?,
	fire: Color3?,
	glow: Color3?,
}

local function part(model: Model, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function materialFrom(name: string?): Enum.Material
	if name then
		local ok, value = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and value then
			return value
		end
	end
	return Enum.Material.SmoothPlastic
end

type Ctx = {
	model: Model,
	head: Part,
	torso: Part,
	headTop: number,
	torsoWidth: number,
	color: Color3,
}

local ACCESSORIES: { [string]: (Ctx) -> () } = {}

ACCESSORIES.Cap = function(c)
	local y = c.headTop
	part(c.model, "Cap", Vector3.new(1.4, 0.4, 1.4), CFrame.new(0, y + 0.1, 0), c.color)
	part(c.model, "Brim", Vector3.new(1.3, 0.12, 0.7), CFrame.new(0, y - 0.05, -0.95), c.color)
end

ACCESSORIES.Headband = function(c)
	part(c.model, "Headband", Vector3.new(1.42, 0.25, 1.42), CFrame.new(0, c.headTop - 0.35, 0), c.color)
end

ACCESSORIES.Shades = function(c)
	local y = c.headTop - 0.6
	part(c.model, "Shades", Vector3.new(1.36, 0.28, 0.12), CFrame.new(0, y, -0.68), Color3.new(0.05, 0.05, 0.05), Enum.Material.Glass)
end

ACCESSORIES.Visor = function(c)
	local y = c.headTop - 0.6
	part(c.model, "Visor", Vector3.new(1.4, 0.3, 0.12), CFrame.new(0, y, -0.68), c.color, Enum.Material.Neon)
end

ACCESSORIES.Chain = function(c)
	local gold = Color3.fromRGB(255, 205, 60)
	part(c.model, "ChainBand", Vector3.new(c.torsoWidth * 0.7, 0.14, 0.08), CFrame.new(0, 3.75, -0.55), gold, Enum.Material.Metal)
	local medal = part(
		c.model,
		"Medal",
		Vector3.new(0.1, 0.55, 0.55),
		CFrame.new(0, 3.3, -0.56) * CFrame.Angles(0, math.rad(90), 0),
		gold,
		Enum.Material.Metal
	)
	medal.Shape = Enum.PartType.Cylinder
end

ACCESSORIES.Crown = function(c)
	local y = c.headTop
	local gold = c.color
	part(c.model, "CrownBase", Vector3.new(1.45, 0.35, 1.45), CFrame.new(0, y + 0.15, 0), gold, Enum.Material.Metal)
	for i = 0, 3 do
		local angle = math.rad(i * 90 + 45)
		local spike = part(
			c.model,
			"Spike",
			Vector3.new(0.3, 0.45, 0.3),
			CFrame.new(math.cos(angle) * 0.55, y + 0.5, math.sin(angle) * 0.55),
			gold,
			Enum.Material.Metal
		)
		spike.Shape = Enum.PartType.Ball
	end
end

ACCESSORIES.Halo = function(c)
	local y = c.headTop + 0.6
	for i = 0, 9 do
		local angle = math.rad(i * 36)
		local bead = part(
			c.model,
			"Halo",
			Vector3.new(0.22, 0.22, 0.22),
			CFrame.new(math.cos(angle) * 0.75, y, math.sin(angle) * 0.75),
			c.color,
			Enum.Material.Neon
		)
		bead.Shape = Enum.PartType.Ball
	end
end

ACCESSORIES.Horns = function(c)
	local y = c.headTop + 0.15
	for side = -1, 1, 2 do
		local horn = part(
			c.model,
			"Horn",
			Vector3.new(0.25, 0.7, 0.25),
			CFrame.new(side * 0.5, y, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)),
			c.color,
			Enum.Material.Neon
		)
		horn.Shape = Enum.PartType.Block
	end
end

ACCESSORIES.Antenna = function(c)
	local y = c.headTop
	part(c.model, "AntennaRod", Vector3.new(0.1, 0.8, 0.1), CFrame.new(0, y + 0.4, 0), Color3.fromRGB(80, 80, 90), Enum.Material.Metal)
	local tip = part(c.model, "AntennaTip", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, y + 0.85, 0), c.color, Enum.Material.Neon)
	tip.Shape = Enum.PartType.Ball
end

ACCESSORIES.Cape = function(c)
	part(
		c.model,
		"Cape",
		Vector3.new(c.torsoWidth * 0.95, 2.6, 0.1),
		CFrame.new(0, 2.75, 0.6) * CFrame.Angles(math.rad(-8), 0, 0),
		c.color,
		Enum.Material.Fabric
	)
end

ACCESSORIES.Wings = function(c)
	for side = -1, 1, 2 do
		part(
			c.model,
			"Wing",
			Vector3.new(2.2, 1.6, 0.1),
			CFrame.new(side * (c.torsoWidth / 2 + 0.7), 3.4, 0.75) * CFrame.Angles(0, math.rad(side * 25), math.rad(side * 20)),
			c.color,
			Enum.Material.Neon
		).Transparency =
			0.25
	end
end

ACCESSORIES.Backpack = function(c)
	part(c.model, "Pack", Vector3.new(c.torsoWidth * 0.7, 1.4, 0.6), CFrame.new(0, 3, 0.8), c.color, Enum.Material.Metal)
end

ACCESSORIES.Shoulders = function(c)
	for side = -1, 1, 2 do
		part(
			c.model,
			"Pad",
			Vector3.new(1.3, 0.4, 1.3),
			CFrame.new(side * (c.torsoWidth / 2 + 0.45), 4.05, 0),
			c.color,
			Enum.Material.Metal
		)
	end
end

-- Builds a model standing on y = 0 at the origin, facing -Z.
function CharacterFactory.build(look: Look, name: string?): Model
	local model = Instance.new("Model")
	model.Name = name or "Unit"

	local buff = look.buff or 0
	local bodyMaterial = materialFrom(look.material)
	local torsoWidth = 2 + buff * 0.8
	local armWidth = 1 + buff * 0.45

	-- Root sits at the feet so PivotTo/ScaleTo keep the unit standing on the floor.
	local root = part(model, "Root", Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 0, 0), Color3.new(1, 1, 1))
	root.Transparency = 1
	model.PrimaryPart = root

	part(model, "LeftLeg", Vector3.new(0.95, 2, 1), CFrame.new(-0.5, 1, 0), look.pants, bodyMaterial)
	part(model, "RightLeg", Vector3.new(0.95, 2, 1), CFrame.new(0.5, 1, 0), look.pants, bodyMaterial)
	local torso = part(model, "Torso", Vector3.new(torsoWidth, 2, 1), CFrame.new(0, 3, 0), look.shirt, bodyMaterial)
	local armX = torsoWidth / 2 + armWidth / 2
	part(model, "LeftArm", Vector3.new(armWidth, 2, 1), CFrame.new(-armX, 3, 0), look.skin, bodyMaterial)
	part(model, "RightArm", Vector3.new(armWidth, 2, 1), CFrame.new(armX, 3, 0), look.skin, bodyMaterial)

	local head = part(model, "Head", Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 4.65, 0), look.skin, bodyMaterial)
	local headTop = 5.3
	if look.jaw then
		part(model, "Jaw", Vector3.new(1.45, 0.45, 1.2), CFrame.new(0, 4.1, -0.05), look.skin, bodyMaterial)
	end

	if look.face and look.face ~= "" then
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Face"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.LightInfluence = 0
		gui.Parent = head
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Text = look.face
		label.TextScaled = true
		label.Font = look.faceFont or Enum.Font.GothamBold
		label.TextColor3 = look.faceColor or Color3.new(0.1, 0.1, 0.1)
		label.Parent = gui
	end

	local ctx: Ctx = {
		model = model,
		head = head,
		torso = torso,
		headTop = headTop,
		torsoWidth = torsoWidth,
		color = look.accColor or Color3.fromRGB(255, 205, 60),
	}
	local accessories: { string } = look.acc or {}
	for _, accName in accessories do
		local builder = ACCESSORIES[accName]
		if builder then
			builder(ctx)
		end
	end

	if look.aura then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Aura"
		emitter.Color = ColorSequence.new(look.aura)
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.8, 1.4)
		emitter.Rate = 10
		emitter.Speed = NumberRange.new(1.5, 3)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, 3, 0)
		emitter.Parent = torso
	end
	if look.sparkles then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = look.aura or Color3.new(1, 1, 1)
		sparkles.Parent = torso
	end
	if look.fire then
		local fire = Instance.new("Fire")
		fire.Color = look.fire
		fire.SecondaryColor = Color3.new(1, 1, 1)
		fire.Size = 4
		fire.Heat = 6
		fire.Parent = torso
	end
	if look.glow or look.aura then
		local light = Instance.new("PointLight")
		light.Color = look.glow or look.aura :: Color3
		light.Brightness = 1.5
		light.Range = 8
		light.Parent = torso
	end

	local scale = look.scale or 1
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

-- Turns a model into a black silhouette (for undiscovered Index entries).
function CharacterFactory.silhouette(model: Model)
	-- Collect first, destroy after, so we never visit children of a destroyed instance.
	local remove: { Instance } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Transparency < 1 then
				d.Color = Color3.fromRGB(15, 15, 20)
				d.Material = Enum.Material.SmoothPlastic
				d.Transparency = 0
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("Fire") or d:IsA("Light") or d:IsA("SurfaceGui") then
			table.insert(remove, d)
		end
	end
	for _, d in remove do
		d:Destroy()
	end
end

-- Height of the built model (for placing labels above it).
function CharacterFactory.height(look: Look): number
	local h = 5.3
	local acc = look.acc or {}
	if table.find(acc, "Halo") then
		h += 0.8
	elseif table.find(acc, "Crown") or table.find(acc, "Antenna") then
		h += 0.6
	end
	return h * (look.scale or 1)
end

return CharacterFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Economy: every balance number and pure formula in the game.

	This module has no Roblox dependencies so it can be unit-tested with Lune
	(see tests/). Both variants share it; only names, colours and looks differ
	per theme.

	Core loop:
	  buy units -> units drop orbs -> walk over orbs to carry them
	  -> deposit at the converter (x random multiplier) -> processed into cash
	  -> collect cash -> buy more / upgrade.
	Two units of the same tier merge into one unit of the next tier.
]]

local Economy = {}

Economy.VERSION = "1.0.0"

Economy.MAX_TIER = 25
Economy.MAX_BUY_TIER = 15
Economy.MERGE_RATIO = 2
Economy.DISPLAY_SLOTS = 30

-- Production ------------------------------------------------------------------

-- Each tier produces this many times more than the previous one. Must be greater
-- than MERGE_RATIO so merging is always an upgrade.
Economy.TIER_RATE_GROWTH = 2.6

function Economy.unitRate(tier: number): number
	return Economy.TIER_RATE_GROWTH ^ (tier - 1)
end

function Economy.productionPerSecond(units: { number }): number
	local total = 0
	for tier = 1, Economy.MAX_TIER do
		local count = units[tier] or 0
		if count > 0 then
			total += count * Economy.unitRate(tier)
		end
	end
	return total
end

function Economy.totalUnits(units: { number }): number
	local total = 0
	for tier = 1, Economy.MAX_TIER do
		total += units[tier] or 0
	end
	return total
end

function Economy.highestTier(discovered: { number }): number
	for tier = Economy.MAX_TIER, 1, -1 do
		if (discovered[tier] or 0) > 0 then
			return tier
		end
	end
	return 1
end

-- Merges every pair it can, cascading upward. Mutates `units` in place.
-- Returns how many merges happened and the highest tier that received a unit.
function Economy.mergeAll(units: { number }): (number, number)
	local merges = 0
	local topCreated = 0
	for tier = 1, Economy.MAX_TIER - 1 do
		local count = units[tier] or 0
		local made = math.floor(count / Economy.MERGE_RATIO)
		if made > 0 then
			units[tier] = count - made * Economy.MERGE_RATIO
			units[tier + 1] = (units[tier + 1] or 0) + made
			merges += made
			topCreated = tier + 1
		end
	end
	return merges, topCreated
end

-- Buying ----------------------------------------------------------------------

Economy.BUY_BASE_PRICE = 20
Economy.BUY_PRICE_GROWTH = 2.3
Economy.BUY_AMOUNTS = { 1, 5, 25, 100 }

function Economy.basePrice(buyTier: number): number
	return Economy.BUY_BASE_PRICE * Economy.BUY_PRICE_GROWTH ^ (buyTier - 1)
end

-- Units that must be bought at the current buy tier before it can be upgraded.
function Economy.buyTierRequirement(buyTier: number): number
	return math.floor(150 * 1.6 ^ (buyTier - 1))
end

-- Price of the next single unit. Grows linearly with purchases made at this
-- tier (2x once the upgrade requirement is reached) to push tier upgrades.
function Economy.unitPrice(buyTier: number, boughtAtTier: number): number
	return Economy.basePrice(buyTier) * (1 + boughtAtTier / Economy.buyTierRequirement(buyTier))
end

-- Exact sum of unitPrice for `amount` consecutive purchases.
function Economy.bulkPrice(buyTier: number, boughtAtTier: number, amount: number): number
	local req = Economy.buyTierRequirement(buyTier)
	local linear = amount * boughtAtTier + amount * (amount - 1) / 2
	return Economy.basePrice(buyTier) * (amount + linear / req)
end

function Economy.buyTierUpgradeCost(buyTier: number): number
	return Economy.basePrice(buyTier + 1) * Economy.buyTierRequirement(buyTier) * 0.5
end

Economy.AUTO_MERGE_COST = 25000

-- Processing (the converter that turns deposited orbs into cash) ---------------

Economy.PROCESS_BASE = 10
Economy.PROCESS_GROWTH = 1.12
Economy.PROCESS_COST_BASE = 75
Economy.PROCESS_COST_GROWTH = 1.155
Economy.PROCESS_BULK = 10

function Economy.processRate(level: number): number
	return Economy.PROCESS_BASE * Economy.PROCESS_GROWTH ^ level
end

function Economy.processUpgradeCost(level: number): number
	return Economy.PROCESS_COST_BASE * Economy.PROCESS_COST_GROWTH ^ level
end

-- Cost of buying `amount` levels starting from `level` (geometric series).
function Economy.processBulkCost(level: number, amount: number): number
	local g = Economy.PROCESS_COST_GROWTH
	return Economy.processUpgradeCost(level) * (g ^ amount - 1) / (g - 1)
end

-- Cash value of one orb point before multipliers.
Economy.CASH_PER_POINT = 1

-- Deposit multiplier (global, rerolled on a timer) ------------------------------

Economy.DEPOSIT_REROLL_SECONDS = 20
Economy.DEPOSIT_MULTIPLIERS = {
	{ value = 0.5, weight = 6 },
	{ value = 0.7, weight = 10 },
	{ value = 0.8, weight = 12 },
	{ value = 0.9, weight = 14 },
	{ value = 1.0, weight = 16 },
	{ value = 1.1, weight = 14 },
	{ value = 1.2, weight = 10 },
	{ value = 1.3, weight = 8 },
	{ value = 1.5, weight = 5 },
	{ value = 1.8, weight = 3 },
	{ value = 2.0, weight = 1.5 },
	{ value = 3.0, weight = 0.5 },
}
Economy.DEPOSIT_MIN = 0.5
Economy.DEPOSIT_MAX = 3.0

local function pickWeighted<T>(entries: { T }, weightOf: (T) -> number, roll: number): T
	local total = 0
	for _, entry in entries do
		total += weightOf(entry)
	end
	local target = roll * total
	for _, entry in entries do
		target -= weightOf(entry)
		if target < 0 then
			return entry
		end
	end
	return entries[#entries]
end

function Economy.rollDepositMultiplier(rng: () -> number): number
	local entry = pickWeighted(Economy.DEPOSIT_MULTIPLIERS, function(e)
		return e.weight
	end, rng())
	return entry.value
end

-- Global "surge" event: double orbs for the last part of every cycle. ----------

Economy.SURGE_CYCLE = 600
Economy.SURGE_DURATION = 120
Economy.SURGE_MULTIPLIER = 2

-- Returns whether a surge is active at `now` and seconds until it changes state.
function Economy.surgeState(now: number): (boolean, number)
	local t = now % Economy.SURGE_CYCLE
	local start = Economy.SURGE_CYCLE - Economy.SURGE_DURATION
	if t >= start then
		return true, Economy.SURGE_CYCLE - t
	end
	return false, start - t
end

-- Chests ----------------------------------------------------------------------

Economy.CHEST_RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

Economy.CHEST_INFO = {
	Common = { weight = 82, unlockSeconds = 180, gemPrice = 5, priceMult = 1, offsets = { { -2, 75 }, { -1, 20 }, { 0, 5 } } },
	Uncommon = { weight = 12, unlockSeconds = 480, gemPrice = 12, priceMult = 2.5, offsets = { { -1, 70 }, { 0, 25 }, { 1, 5 } } },
	Rare = { weight = 4.5, unlockSeconds = 1200, gemPrice = 30, priceMult = 6, offsets = { { -1, 40 }, { 0, 45 }, { 1, 15 } } },
	Epic = { weight = 1.2, unlockSeconds = 2700, gemPrice = 60, priceMult = 15, offsets = { { 0, 60 }, { 1, 32 }, { 2, 8 } } },
	Legendary = { weight = 0.3, unlockSeconds = 5400, gemPrice = 120, priceMult = 40, offsets = { { 0, 30 }, { 1, 50 }, { 2, 20 } } },
}

Economy.CHEST_SPAWN_INTERVAL = 40
Economy.CHEST_SPAWN_CHANCE = 0.45
Economy.MAX_FLOOR_CHESTS = 3
Economy.PREMIUM_UNLOCK_SPEED = 3

function Economy.isRarity(rarity: string): boolean
	return Economy.CHEST_INFO[rarity] ~= nil
end

function Economy.rollChestRarity(rng: () -> number): string
	return pickWeighted(Economy.CHEST_RARITIES, function(r)
		return Economy.CHEST_INFO[r].weight
	end, rng())
end

export type Odds = { tier: number, chance: number }

-- Possible tiers and their % chance, relative to the player's highest tier.
-- Offsets that clamp onto the same tier are combined.
function Economy.chestOdds(rarity: string, highestTier: number): { Odds }
	local info = Economy.CHEST_INFO[rarity]
	local byTier: { [number]: number } = {}
	for _, pair in info.offsets do
		local tier = math.clamp(highestTier + pair[1], 1, Economy.MAX_TIER)
		byTier[tier] = (byTier[tier] or 0) + pair[2]
	end
	local list: { Odds } = {}
	for tier, chance in byTier do
		table.insert(list, { tier = tier, chance = chance })
	end
	table.sort(list, function(a, b)
		return a.tier < b.tier
	end)
	return list
end

function Economy.rollChest(rarity: string, highestTier: number, rng: () -> number): number
	local entry = pickWeighted(Economy.chestOdds(rarity, highestTier), function(o)
		return o.chance
	end, rng())
	return entry.tier
end

function Economy.chestMoneyPrice(rarity: string, highestTier: number): number
	local info = Economy.CHEST_INFO[rarity]
	return 40 * Economy.unitRate(math.max(highestTier - 1, 1)) * info.priceMult
end

function Economy.unlockSeconds(rarity: string, premium: boolean): number
	local seconds = Economy.CHEST_INFO[rarity].unlockSeconds
	if premium then
		seconds = math.ceil(seconds / Economy.PREMIUM_UNLOCK_SPEED)
	end
	return seconds
end

-- Gems to finish an unlocker immediately: one per started minute.
function Economy.finishGemCost(secondsLeft: number): number
	return math.max(1, math.ceil(secondsLeft / 60))
end

-- Rewards ---------------------------------------------------------------------

function Economy.discoveryGems(tier: number): number
	return tier
end

Economy.FREE_REWARD_COOLDOWN = 600
Economy.FREE_REWARD_GEMS = 3
Economy.FREE_REWARD_SECONDS = 120
Economy.FREE_REWARD_MIN = 100

-- One-time reward for finishing the onboarding tutorial.
Economy.TUTORIAL_REWARD_GEMS = 25
Economy.TUTORIAL_REWARD_CASH = 250

Economy.OFFLINE_CAP_SECONDS = 8 * 3600
Economy.OFFLINE_EFFICIENCY = 0.25
Economy.OFFLINE_MIN_SECONDS = 60

Economy.FRIEND_BONUS = 0.1
Economy.MAX_FRIEND_BONUS = 0.5
Economy.PREMIUM_BONUS = 0.1

-- Cash per second the player is currently able to earn (bottlenecked by
-- whichever is slower: production or processing).
function Economy.incomePerSecond(production: number, processRate: number, moneyMult: number): number
	return math.min(production, processRate) * Economy.CASH_PER_POINT * moneyMult
end

-- Money developer products scale with income so they stay useful.
function Economy.moneyPackAmount(income: number, seconds: number, minimum: number): number
	return math.max(minimum, math.floor(income * seconds))
end

-- Tier rarity bands (used for label colours in the Index and on units).
Economy.TIER_BANDS = {
	{ upTo = 5, name = "Common" },
	{ upTo = 10, name = "Uncommon" },
	{ upTo = 15, name = "Rare" },
	{ upTo = 20, name = "Epic" },
	{ upTo = 24, name = "Legendary" },
	{ upTo = 25, name = "Mythic" },
}

function Economy.tierBand(tier: number): string
	for _, band in Economy.TIER_BANDS do
		if tier <= band.upTo then
			return band.name
		end
	end
	return "Mythic"
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting. Pure Luau so it can be unit-tested with Lune.

local Format = {}

local SUFFIXES = {
	"",
	"K",
	"M",
	"B",
	"T",
	"Qa",
	"Qi",
	"Sx",
	"Sp",
	"Oc",
	"No",
	"Dc",
	"Ud",
	"Dd",
	"Td",
	"Qad",
	"Qid",
	"Sxd",
	"Spd",
	"Ocd",
	"Nod",
	"Vg",
}

-- 1234 -> "1.23K", 999 -> "999", 1e6 -> "1.00M"
function Format.short(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local sign = if n < 0 then "-" else ""
	n = math.abs(n)
	if n < 1000 then
		return sign .. tostring(math.floor(n))
	end
	local index = math.floor(math.log10(n) / 3)
	if index >= #SUFFIXES then
		return sign .. string.format("%.2e", n)
	end
	local scaled = n / 10 ^ (index * 3)
	-- log10 can round up just below a power of 1000 (e.g. 0.99T); step back.
	if scaled < 1 and index > 1 then
		index -= 1
		scaled = n / 10 ^ (index * 3)
	end
	-- Truncate (not round) so displayed balances never overstate what you have.
	scaled = math.floor(scaled * 100) / 100
	return sign .. string.format("%.2f", scaled) .. SUFFIXES[index + 1]
end

-- 1234567 -> "1,234,567". Very large numbers fall back to short form.
function Format.commas(n: number): string
	if n ~= n then
		return "0"
	end
	if math.abs(n) >= 1e15 then
		return Format.short(n)
	end
	local sign = if n < 0 then "-" else ""
	local digits = tostring(math.floor(math.abs(n)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return sign .. out
end

function Format.money(n: number): string
	return "$" .. Format.short(n)
end

function Format.multiplier(n: number): string
	return string.format("%.1fx", n)
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Always "HH:MM:SS" (for unlocker screens).
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

function Format.date(timestamp: number): string
	local t = os.date("*t", math.floor(timestamp)) :: any
	return string.format("%d/%d/%d", t.month, t.day, t.year)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Remote events/functions. The server creates them, clients wait for them.
--
--   State   (server -> client)  full public snapshot of the player's tycoon
--   Notify  (server -> client)  toasts, popups, reward reveals, confirms
--   Effect  (server -> client)  cosmetic feedback (collect sounds, floating text)
--   Action  (client -> server)  button presses from the UI
--   Query   (client -> server)  request/response data (ranking)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = { "State", "Notify", "Effect", "Action" }
local FUNCTIONS = { "Query" }

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local f = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
		if not f then
			local created = Instance.new("Folder")
			created.Name = "Remotes"
			f = created
		end
		assert(f, "Remotes folder missing")
		for _, name in EVENTS do
			if not f:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = f
			end
		end
		for _, name in FUNCTIONS do
			if not f:FindFirstChild(name) then
				local remote = Instance.new("RemoteFunction")
				remote.Name = name
				remote.Parent = f
			end
		end
		f.Parent = ReplicatedStorage
		folder = f
		return f
	end
	local f = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	folder = f
	return f
end

function Net.event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
