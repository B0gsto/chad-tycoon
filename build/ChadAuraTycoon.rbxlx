		actions = {
			{ t = 0, act = "expr", actor = "Hero", name = "Smirk" },
			{ t = 0.1, act = "sound", name = "Open" },
			{ t = 0.75, act = "flash", dur = 0.8 },
			{ t = 1.2, act = "marker", on = true },
			{ t = 1.3, act = "title", on = true },
			{ t = 1.3, act = "sound", name = "Celebrate" },
			{ t = 1.3, act = "expr", actor = "Hero", name = "Happy" },
			{ t = 4.3, act = "title", on = false },
			{ t = 4.6, act = "marker", on = false },
			{ t = 4.6, act = "letterbox", on = false },
		},
	},
} :: { Beat }

-- Total running time in seconds.
function Timeline.total(): number
	local sum = 0
	for _, beat in Timeline.BEATS do
		sum += beat.duration
	end
	return sum
end

-- Start time of beat `index` (seconds from the start of the cutscene).
function Timeline.startOf(index: number): number
	local sum = 0
	for i = 1, index - 1 do
		sum += Timeline.BEATS[i].duration
	end
	return sum
end

return Timeline
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Ui: the cutscene's screen overlay and world bubbles.

	Screen (ScreenGui "IntroUI", DisplayOrder 80: above the HUD, below the loading screen):
	letterbox bars, the subtitle card (cream card with Ink text, sized to its line and
	kept just above the bottom bar), a quiet Skip button bottom-right, the MAX GIGA CHAD
	name card, the game title card, a white flash and a full-screen fade.

	Layout is computed in pixels from the real screen size (and recomputed when it
	changes): every card is clamped inside a safe area (6% / 5% margins plus the Roblox
	top-bar inset), scaled by `k` = screen size relative to 1280x720 (clamped 0.6..1.6).
	Text uses TextScaled under a UITextSizeConstraint, so it shrinks instead of clipping.
	Nothing uses CanvasGroup: cards fade by tweening each element's own transparency.

	World (BillboardGuis under the stage): speech / thought bubbles and the hero's name
	and AURA tag. Everything tweens in and out.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Kit = require(script.Parent.Parent.UI.Kit)

local Ui = {}
Ui.__index = Ui

local BAR = 0.1 -- letterbox bar height (screen fraction)
local SAFE_X = 0.06 -- side margins (screen fraction), clears phone notches
local SAFE_Y = 0.05 -- top / bottom margins
local OUT = Enum.EasingStyle.Quad
local BACK = Enum.EasingStyle.Back

export type Ui = typeof(setmetatable(
	{} :: {
		theme: any,
		gui: ScreenGui,
		k: number,
		width: number,
		height: number,
		safe: Rect,
		top: Frame,
		bottom: Frame,
		caption: Frame,
		captionScale: UIScale,
		captionLabel: TextLabel,
		captionText: string,
		captionToken: number,
		skip: TextButton,
		skipHit: TextButton,
		nameCardGui: Frame?,
		titleCardGui: Frame?,
		flashFrame: Frame,
		fadeFrame: Frame,
		world: Folder,
		tag: BillboardGui?,
		tagStat: TextLabel?,
		tagPill: Frame?,
		tagPillScale: UIScale?,
		statFrom: number,
		statTo: number,
		statStart: number,
		statDur: number,
		statShown: number,
		clock: number,
		connections: { RBXScriptConnection },
	},
	Ui
))

local function new(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for key, value in props do
		(inst :: any)[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent: Instance, radius: number)
	new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

-- A TextScaled label that never grows past `maxSize` and never clips.
local function scaledText(parent: Instance, props: { [string]: any }, maxSize: number): TextLabel
	props.BackgroundTransparency = 1
	props.TextScaled = true
	props.TextWrapped = if props.TextWrapped == nil then true else props.TextWrapped
	local label = new("TextLabel", props, parent)
	new("UITextSizeConstraint", { MaxTextSize = math.max(math.floor(maxSize), 9), MinTextSize = 8 }, label)
	return label
end

local function setMaxText(label: Instance, maxSize: number)
	local c = label:FindFirstChildOfClass("UITextSizeConstraint")
	if c then
		c.MaxTextSize = math.max(math.floor(maxSize), 9)
	end
end

-- Width/height of `text` at `size`, wrapped at `maxWidth`.
local function measure(text: string, size: number, font: Enum.Font, maxWidth: number): Vector2
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(maxWidth, 10000))
	end)
	if ok and bounds.X > 0 then
		return bounds
	end
	local w = (utf8.len(text) or #text) * size * 0.55
	local lines = math.max(math.ceil(w / maxWidth), 1)
	return Vector2.new(math.min(w, maxWidth), lines * size * 1.2)
end

-- Fades a whole card (every background, text and stroke) to its built look or out.
-- The built transparencies are remembered as attributes on first use.
local function fadeTree(root: Instance, visible: boolean, t: number)
	local items = root:GetDescendants()
	table.insert(items, root)
	for _, inst in items do
		local props: { [string]: number } = {}
		local function track(attr: string, prop: string)
			local base = inst:GetAttribute(attr)
			if base == nil then
				base = (inst :: any)[prop]
				inst:SetAttribute(attr, base)
			end
			props[prop] = if visible then base :: number else 1
		end
		if inst:IsA("GuiObject") then
			track("FadeBg", "BackgroundTransparency")
			if inst:IsA("TextLabel") or inst:IsA("TextButton") then
				track("FadeText", "TextTransparency")
			end
		elseif inst:IsA("UIStroke") then
			track("FadeStroke", "Transparency")
		end
		if next(props) then
			if t <= 0 then
				for prop, value in props do
					(inst :: any)[prop] = value
				end
			else
				Kit.tween(inst, t, props, OUT)
			end
		end
	end
end

-- A rounded card with a coloured header band (the band's lower corners squared off).
local function bandCard(parent: Instance, W: any, bandColor: Color3, bandFrac: number, radius: number): (Frame, Frame)
	local card = new("Frame", {
		BackgroundColor3 = W.Cream,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 10,
	}, parent)
	corner(card, radius)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, card)
	local band = new("Frame", {
		Name = "Band",
		BackgroundColor3 = bandColor,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, bandFrac),
		ZIndex = 11,
	}, card)
	corner(band, radius)
	new("Frame", {
		Name = "BandFill",
		BackgroundColor3 = bandColor,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, bandFrac),
		Size = UDim2.new(1, 0, bandFrac * 0.5, 0),
		ZIndex = 11,
	}, card)
	return card, band
end

function Ui.new(theme: any, worldParent: Instance, onSkip: () -> ()): Ui
	local W = theme.World
	local C = theme.Colors
	local F = theme.Fonts
	local player = Players.LocalPlayer

	local gui = new("ScreenGui", {
		Name = "IntroUI",
		Enabled = true,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 80,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	-- Letterbox bars (they slide in from the screen edges).
	local top = new("Frame", {
		Name = "BarTop",
		BackgroundColor3 = C.Ink,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.fromScale(1, BAR),
		Position = UDim2.fromScale(0, 0),
		ZIndex = 1,
	}, gui)
	local bottom = new("Frame", {
		Name = "BarBottom",
		BackgroundColor3 = C.Ink,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0),
		Size = UDim2.fromScale(1, BAR),
		Position = UDim2.fromScale(0, 1),
		ZIndex = 1,
	}, gui)

	-- Subtitle card: sized to its line in relayout, sitting just above the bottom bar.
	local caption = new("Frame", {
		Name = "Caption",
		BackgroundColor3 = W.Cream,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1 - BAR, -12),
		Size = UDim2.fromOffset(200, 54),
		Visible = false,
		ZIndex = 15,
	}, gui)
	corner(caption, 18)
	new("UIStroke", { Color = W.Ink, Thickness = 2.5, Transparency = 0.15 }, caption)
	local captionScale = new("UIScale", {}, caption)
	local captionLabel = scaledText(caption, {
		Name = "Text",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Font = F.UI,
		TextColor3 = W.Ink,
		Text = "",
		ZIndex = 16,
	}, 26)
	fadeTree(caption, false, 0)

	-- Skip: small and quiet, bottom-right inside the letterbox bar.
	local skip = new("TextButton", {
		Name = "Skip",
		AutoButtonColor = false,
		BackgroundColor3 = W.White,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1 - SAFE_X, 0, 1 - BAR / 2, 0),
		Size = UDim2.fromOffset(92, 34),
		Font = F.UI,
		TextScaled = true,
		TextColor3 = W.Ink,
		TextTransparency = 1,
		Text = theme.Intro.Skip .. "  »",
		Visible = false,
		ZIndex = 18,
	}, gui)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, skip)
	new("UIPadding", {
		PaddingTop = UDim.new(0.2, 0),
		PaddingBottom = UDim.new(0.2, 0),
		PaddingLeft = UDim.new(0.12, 0),
		PaddingRight = UDim.new(0.12, 0),
	}, skip)
	new("UITextSizeConstraint", { MaxTextSize = 20, MinTextSize = 10 }, skip)
	skip.Activated:Connect(onSkip)
	-- Gamepad: Skip takes the shared selection ring (B also skips, see Cutscene).
	pcall(Kit.selectable, skip)
	-- Touch: an invisible hit area at least 48 px each way, centred on the pill (sized in
	-- _layout), so the quiet button keeps its look but takes a thumb.
	local skipHit = new("TextButton", {
		Name = "Hit",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Selectable = false,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(104, 48),
		ZIndex = 19,
	}, skip)
	skipHit.Activated:Connect(onSkip)

	local flashFrame = new("Frame", {
		Name = "Flash",
		BackgroundColor3 = W.White,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
	}, gui)
	local fadeFrame = new("Frame", {
		Name = "Fade",
		BackgroundColor3 = W.Cream,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
	}, gui)

	local world = new("Folder", { Name = "IntroBubbles" }, worldParent)

	local self = setmetatable({
		theme = theme,
		gui = gui,
		k = 1,
		width = 1280,
		height = 720,
		safe = Rect.new(0, 0, 1280, 720),
		top = top,
		bottom = bottom,
		caption = caption,
		captionScale = captionScale,
		captionLabel = captionLabel,
		captionText = "",
		captionToken = 0,
		skip = skip,
		skipHit = skipHit,
		nameCardGui = nil,
		titleCardGui = nil,
		flashFrame = flashFrame,
		fadeFrame = fadeFrame,
		world = world,
		tag = nil,
		tagStat = nil,
		tagPill = nil,
		tagPillScale = nil,
		statFrom = 0,
		statTo = 0,
		statStart = 0,
		statDur = 0,
		statShown = -1,
		clock = 0,
		connections = {},
	}, Ui)

	gui.Parent = player and player:FindFirstChildOfClass("PlayerGui")

	local function relayout()
		self:_relayout()
	end
	relayout()
	local camera = Workspace.CurrentCamera
	if camera then
		table.insert(self.connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(relayout))
	end
	table.insert(self.connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout))
	return self
end

-- Layout --------------------------------------------------------------------------------

-- Recomputes the screen size, safe area and scale, then re-places every screen card.
function Ui._relayout(self: Ui)
	local size = self.gui.AbsoluteSize
	if size.X < 2 or size.Y < 2 then
		local camera = Workspace.CurrentCamera
		size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	end
	if size.X < 2 or size.Y < 2 then
		size = Vector2.new(1280, 720)
	end
	local w, h = size.X, size.Y
	local insetTop = 0
	local ok, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if ok and typeof(topLeft) == "Vector2" then
		insetTop = topLeft.Y
	end
	self.width, self.height = w, h
	self.k = math.clamp(math.min(w / 1280, h / 720), 0.6, 1.6)
	self.safe = Rect.new(w * SAFE_X, math.max(h * SAFE_Y, insetTop), w * (1 - SAFE_X), h * (1 - SAFE_Y))

	local k = self.k
	local skipW, skipH = math.floor(96 * k), math.floor(math.min(36 * k, h * BAR * 0.7))
	self.skip.Size = UDim2.fromOffset(skipW, skipH)
	self.skipHit.Size = UDim2.fromOffset(math.max(skipW + 8, 48), math.max(skipH + 12, 48))
	setMaxText(self.skip, 20 * k)

	self:_layoutCaption()
	if self.nameCardGui then
		self:_layoutNameCard(self.nameCardGui)
	end
	if self.titleCardGui then
		self:_layoutTitleCard(self.titleCardGui)
	end
end

function Ui._layoutCaption(self: Ui)
	local k = self.k
	local textSize = math.floor(26 * k + 0.5)
	local padX, padY = math.floor(24 * k), math.floor(12 * k)
	local maxWidth = self.width * 0.9
	local text = if self.captionText == "" then " " else self.captionText
	local bounds = measure(text, textSize, self.theme.Fonts.UI, maxWidth - padX * 2)
	local cw = math.min(math.ceil(bounds.X) + padX * 2 + 4, maxWidth)
	local ch = math.ceil(bounds.Y) + padY * 2 + 2
	self.caption.Size = UDim2.fromOffset(cw, ch)
	self.caption.Position = UDim2.new(0.5, 0, 1 - BAR, -math.floor(12 * k))
	local label = self.captionLabel
	label.Size = UDim2.new(1, -padX * 2, 1, -padY * 2)
	setMaxText(label, textSize)
	local c = self.caption:FindFirstChildOfClass("UICorner")
	if c then
		c.CornerRadius = UDim.new(0, math.floor(math.min(18 * k, ch / 2)))
	end
end

function Ui._layoutNameCard(self: Ui, card: Frame)
	local safe, k = self.safe, self.k
	local cw = math.min(safe.Width * 0.46, 430 * k)
	local ch = cw / 2.9
	-- Upper left of the safe area (the rival stands in the right third); 8 px spare
	-- for the tilt.
	local cx = safe.Min.X + cw / 2 + 8
	local cy = math.clamp(self.height * 0.24, safe.Min.Y + ch / 2 + 8, safe.Max.Y - ch / 2 - 8)
	card.Size = UDim2.fromOffset(cw, ch)
	card.Position = UDim2.fromOffset(cx, cy)
	for _, label in card:GetDescendants() do
		if label:IsA("TextLabel") then
			setMaxText(label, (label:GetAttribute("MaxText") :: number? or 40) * k)
		end
	end
end

function Ui._layoutTitleCard(self: Ui, card: Frame)
	local safe, k = self.safe, self.k
	local cw = math.min(self.width * 0.7, safe.Width, 640 * k)
	local ch = cw * 0.26
	local cy = math.clamp(self.height * 0.36, safe.Min.Y + ch / 2, safe.Max.Y - ch / 2)
	card.Size = UDim2.fromOffset(cw, ch)
	card.Position = UDim2.fromOffset(self.width / 2, cy)
	for _, label in card:GetDescendants() do
		if label:IsA("TextLabel") then
			setMaxText(label, 64 * k)
		end
	end
end

-- Letterbox ---------------------------------------------------------------------------

function Ui.letterbox(self: Ui, on: boolean, instant: boolean?)
	local t = if instant then 0 else 0.45
	local topPos = if on then UDim2.fromScale(0, BAR) else UDim2.fromScale(0, 0)
	local bottomPos = if on then UDim2.fromScale(0, 1 - BAR) else UDim2.fromScale(0, 1)
	if t == 0 then
		self.top.Position = topPos
		self.bottom.Position = bottomPos
	else
		Kit.tween(self.top, t, { Position = topPos }, Enum.EasingStyle.Quart)
		Kit.tween(self.bottom, t, { Position = bottomPos }, Enum.EasingStyle.Quart)
	end
end

-- Captions ------------------------------------------------------------------------------

-- Shows `text` at once: the card is fully readable within ~0.2 s.
function Ui.say(self: Ui, text: string)
	self.captionToken += 1
	local caption = self.caption
	local wasShown = caption.Visible and (caption:GetAttribute("Shown") == true)
	self.captionText = text
	self.captionLabel.Text = text
	self:_layoutCaption()
	caption.Visible = true
	caption:SetAttribute("Shown", true)
	if wasShown then
		-- Swapping lines: the card stays up and gives a small pop.
		fadeTree(caption, true, 0.1)
		self.captionScale.Scale = 0.96
		Kit.tween(self.captionScale, 0.18, { Scale = 1 }, BACK)
	else
		self.captionScale.Scale = 0.9
		fadeTree(caption, true, 0.15)
		Kit.tween(self.captionScale, 0.22, { Scale = 1 }, BACK)
	end
end

function Ui.hideCaption(self: Ui)
	self.captionToken += 1
	local token = self.captionToken
	local caption = self.caption
	caption:SetAttribute("Shown", false)
	if not caption.Visible then
		return
	end
	fadeTree(caption, false, 0.22)
	task.delay(0.24, function()
		if token == self.captionToken and caption.Parent then
			caption.Visible = false
		end
	end)
end

-- Skip button ---------------------------------------------------------------------------

function Ui.showSkip(self: Ui)
	local skip = self.skip
	skip.Visible = true
	Kit.tween(skip, 0.35, { BackgroundTransparency = 0.25, TextTransparency = 0.1 }, OUT)
	-- On a controller the selection sits on Skip, so A skips as well as B.
	if Kit.gamepad or Kit.tenFoot then
		pcall(function()
			GuiService.SelectedObject = skip
		end)
	end
end

-- Name card ----------------------------------------------------------------------------

-- MAX GIGA CHAD's card slams in on the right; `onLand` runs when it hits.
function Ui.nameCard(self: Ui, onLand: (() -> ())?)
	local theme = self.theme
	local W, F = theme.World, theme.Fonts
	if self.nameCardGui then
		self.nameCardGui:Destroy()
	end
	local card, band = bandCard(self.gui, W, W.Sunny, 0.56, 20)
	card.Name = "NameCard"
	card.Rotation = -3
	self.nameCardGui = card
	-- The name sits over the band but belongs to the card: the band's square-off fill is a
	-- later sibling of the band and would otherwise draw over the lower half of the letters.
	local bandFrac = band.Size.Y.Scale
	local nameLabel = scaledText(card, {
		Name = "Name",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, bandFrac * 0.52),
		Size = UDim2.fromScale(0.9, bandFrac * 0.72),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = theme.Intro.RivalName,
		ZIndex = 12,
	}, 44)
	nameLabel:SetAttribute("MaxText", 44)
	local statLabel = scaledText(card, {
		Name = "Stat",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.78),
		Size = UDim2.fromScale(0.86, 0.32),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = theme.Intro.RivalStat,
		ZIndex = 12,
	}, 32)
	statLabel:SetAttribute("MaxText", 32)
	self:_layoutNameCard(card)

	-- Slam: drops from big to a touch small, then settles with a Back overshoot.
	local cardScale = new("UIScale", { Scale = 2.2 }, card)
	fadeTree(card, false, 0)
	fadeTree(card, true, 0.1)
	Kit.tween(cardScale, 0.14, { Scale = 0.93 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.14, function()
		if card.Parent then
			Kit.tween(cardScale, 0.24, { Scale = 1 }, BACK)
			if onLand then
				onLand()
			end
		end
	end)
end

function Ui.hideNameCard(self: Ui)
	local card = self.nameCardGui
	if not card then
		return
	end
	self.nameCardGui = nil
	fadeTree(card, false, 0.28)
	Kit.tween(card, 0.3, { Position = card.Position + UDim2.fromOffset(math.floor(40 * self.k), 0) }, OUT)
	task.delay(0.32, function()
		card:Destroy()
	end)
end

-- Title card ----------------------------------------------------------------------------

function Ui.title(self: Ui, on: boolean, instant: boolean?)
	local theme = self.theme
	local W, F = theme.World, theme.Fonts
	if not on then
		local card = self.titleCardGui
		self.titleCardGui = nil
		if card then
			fadeTree(card, false, 0.28)
			task.delay(0.32, function()
				card:Destroy()
			end)
		end
		return
	end
	if self.titleCardGui then
		return
	end
	local card = new("Frame", {
		Name = "TitleCard",
		BackgroundColor3 = W.Cream,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ClipsDescendants = false,
		ZIndex = 10,
	}, self.gui)
	self.titleCardGui = card
	corner(card, 26)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, card)
	-- Candy stripe header band, inset so it sits inside the rounded corners.
	local stripes = { W.Coral, W.Sunny, W.Mint, W.Blue, W.Pink }
	local strip = new("Frame", {
		Name = "Stripes",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromScale(0.86, 0.1),
		ZIndex = 11,
	}, card)
	for i, color in stripes do
		local s = new("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromScale((i - 1) / #stripes, 0),
			Size = UDim2.new(1 / #stripes, -4, 1, 0),
			ZIndex = 11,
		}, strip)
		corner(s, 6)
	end
	scaledText(card, {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.fromScale(0.88, 0.56),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = theme.GameName,
		ZIndex = 12,
	}, 64)
	self:_layoutTitleCard(card)
	local cardScale = new("UIScale", { Scale = if instant then 1 else 0.6 }, card)
	if not instant then
		fadeTree(card, false, 0)
		fadeTree(card, true, 0.22)
		Kit.tween(cardScale, 0.4, { Scale = 1 }, BACK)
	end
end

-- Flash and fade ---------------------------------------------------------------------------

function Ui.flash(self: Ui, dur: number)
	local f = self.flashFrame
	local inTime = dur * 0.4
	Kit.tween(f, inTime, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(inTime, function()
		if f.Parent then
			Kit.tween(f, dur - inTime, { BackgroundTransparency = 1 }, OUT)
		end
	end)
end

function Ui.fade(self: Ui, on: boolean, t: number)
	Kit.tween(self.fadeFrame, t, { BackgroundTransparency = if on then 0 else 1 }, OUT)
end

-- World bubbles ----------------------------------------------------------------------------

-- A speech (or thought) bubble at `offset` (world studs) from `adornee`.
function Ui.bubble(self: Ui, adornee: BasePart, offset: Vector3, text: string, dur: number, thought: boolean?)
	local W, F = self.theme.World, self.theme.Fonts
	local textSize = 38
	local cardH = 70
	local width = math.max(96, math.ceil(measure(text, textSize, F.Display, 1000).X) + 44)
	local bb = new("BillboardGui", {
		Name = "Bubble",
		Adornee = adornee,
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 500,
		Size = UDim2.fromOffset(width + 8, cardH + 40),
		StudsOffsetWorldSpace = offset,
		ResetOnSpawn = false,
	}, self.world)
	local root = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, bb)
	local s = new("UIScale", { Scale = 0.05 }, root)
	local card = new("Frame", {
		BackgroundColor3 = W.White,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(width, cardH),
		ZIndex = 2,
	}, root)
	corner(card, 28)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, card)
	scaledText(card, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -24, 1, -14),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = text,
		ZIndex = 3,
	}, textSize)
	if thought then
		for i, d in { 20, 12 } do
			local dot = new("Frame", {
				BackgroundColor3 = W.White,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, (i - 1) * 10, 0, cardH + 6 + (i - 1) * 18),
				Size = UDim2.fromOffset(d, d),
				ZIndex = 2,
			}, root)
			corner(dot, d)
			new("UIStroke", { Color = W.Ink, Thickness = 2.5, Transparency = 0.1 }, dot)
		end
	else
		local tail = new("Frame", {
			BackgroundColor3 = W.White,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, cardH + 2),
			Size = UDim2.fromOffset(22, 22),
			Rotation = 45,
			ZIndex = 1,
		}, root)
		new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, tail)
	end
	Kit.tween(s, 0.28, { Scale = 1 }, BACK)
	task.delay(math.max(dur - 0.2, 0.1), function()
		if bb.Parent then
			Kit.tween(s, 0.18, { Scale = 0.05 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.2, function()
				bb:Destroy()
			end)
		end
	end)
end

-- The hero's tag: his name over an "AURA: n" pill (Sunny, turning Coral at zero).
-- Sized in studs, so it reads like a sign above his head in every shot.
-- Shows or hides the hero's tag (switched on camera cuts, so it never pops on screen).
function Ui.tagShown(self: Ui, on: boolean)
	if self.tag then
		self.tag.Enabled = on
	end
end

function Ui.heroTag(self: Ui, adornee: BasePart, height: number, name: string, aura: number)
	local W, F = self.theme.World, self.theme.Fonts
	if self.tag then
		self.tag:Destroy()
	end
	local bb = new("BillboardGui", {
		Name = "HeroTag",
		Adornee = adornee,
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 120,
		Size = UDim2.fromScale(5.2, 2.3),
		StudsOffsetWorldSpace = Vector3.new(0, height, 0),
		ResetOnSpawn = false,
	}, self.world)
	local namePill = new("Frame", {
		Name = "Name",
		BackgroundColor3 = W.White,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.7, 0.4),
	}, bb)
	corner(namePill, 999)
	new("UIStroke", { Color = W.Ink, Thickness = 2, Transparency = 0.2 }, namePill)
	scaledText(namePill, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.74),
		Font = F.UI,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = name,
	}, 40)
	local pill = new("Frame", {
		Name = "Aura",
		BackgroundColor3 = W.Sunny,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 0.54),
	}, bb)
	corner(pill, 999)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.05 }, pill)
	local pillScale = new("UIScale", {}, pill)
	local stat = scaledText(pill, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.84, 0.72),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = string.format(self.theme.Intro.Stat, aura),
	}, 56)
	self.tag = bb
	self.tagStat = stat
	self.tagPill = pill
	self.tagPillScale = pillScale
	self.statFrom, self.statTo, self.statShown = aura, aura, aura
	self:_paintStat(aura)
end

-- Sunny pill with Ink text normally; Coral pill with White text at zero.
function Ui._paintStat(self: Ui, value: number)
	local W = self.theme.World
	local pill, label = self.tagPill, self.tagStat
	if pill and label then
		local zero = value <= 0
		Kit.tween(pill, 0.2, { BackgroundColor3 = if zero then W.Coral else W.Sunny }, OUT)
		label.TextColor3 = if zero then W.White else W.Ink
	end
end

-- Counts the hero's AURA tag between two values over `dur` seconds.
function Ui.countStat(self: Ui, from: number, to: number, dur: number)
	self.statFrom, self.statTo = from, to
	self.statStart = self.clock
	self.statDur = math.max(dur, 0)
end

function Ui.update(self: Ui, dt: number, onTick: (() -> ())?)
	self.clock += dt
	local label = self.tagStat
	if not label then
		return
	end
	local u = if self.statDur > 0 then math.clamp((self.clock - self.statStart) / self.statDur, 0, 1) else 1
	local value = math.floor(self.statFrom + (self.statTo - self.statFrom) * u + 0.5)
	if value ~= self.statShown then
		self.statShown = value
		label.Text = string.format(self.theme.Intro.Stat, value)
		self:_paintStat(value)
		local pillScale = self.tagPillScale
		if pillScale then
			pillScale.Scale = 1.12
			Kit.tween(pillScale, 0.15, { Scale = 1 }, OUT)
		end
		if onTick then
			onTick()
		end
	end
end

function Ui.destroy(self: Ui)
	for _, c in self.connections do
		c:Disconnect()
	end
	pcall(function()
		if GuiService.SelectedObject == self.skip then
			GuiService.SelectedObject = nil
		end
	end)
	self.captionToken += 1
	self.gui:Destroy()
	self.world:Destroy()
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="145">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI and routes server messages.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Client = script.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local Guide = require(Client.Guide)
local Kit = require(Client.UI.Kit)
local Animator = require(Client.Animator)
local Hud = require(Client.UI.Hud)
local Windows = require(Client.UI.Windows)
local Popups = require(Client.UI.Popups)
local Tutorial = require(Client.UI.Tutorial)
local MogHud = require(Client.UI.MogHud)
local ObbyHud = require(Client.UI.ObbyHud)

-- The opening cutscene (optional: the game runs without it if it fails to load).
local introOk, Cutscene = pcall(require, Client.Intro.Cutscene)
if not introOk then
	warn("[Intro] failed to load: " .. tostring(Cutscene))
	Cutscene = nil
end

local player = Players.LocalPlayer
local C = Theme.Colors
local I = Theme.Icons

local screen = Instance.new("ScreenGui")
screen.Name = "TycoonUI"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.IgnoreGuiInset = false
pcall(function()
	-- Keep clear of the Roblox top bar buttons and device notches.
	screen.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
end)
screen.Parent = player:WaitForChild("PlayerGui")

-- Scale the whole UI from a 1280x720 design size. Touch screens get a little
-- extra so buttons stay comfortably tappable; a TV (10-foot console, or a
-- gamepad on a big screen) gets extra for the viewing distance and may go up
-- to 3x on 4K; short screens switch the HUD to its compact layout.
local uiScale = Instance.new("UIScale")
uiScale.Parent = screen
local function rescale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	local topInset = 58
	pcall(function()
		local topLeft = GuiService:GetGuiInset()
		topInset = topLeft.Y
	end)
	local fit = math.min(size.X / 1280, size.Y / 720)
	if Kit.touch then
		fit *= 1.15
	elseif Kit.tenFoot or (Kit.gamepad and size.X >= 1600) then
		fit *= 1.12
	end
	uiScale.Scale = math.clamp(fit, 0.5, if Kit.tenFoot then 3 else 1.5)
	screen:SetAttribute("Compact", (size.Y - topInset) / uiScale.Scale < 600)
end
rescale()
-- Modules that only hold the ScreenGui read the input mode from its Input attribute.
Kit.onInput(function(mode)
	screen:SetAttribute("Input", mode)
	rescale()
end)
-- Console navigation: the D-pad / left stick moves the selection between buttons.
pcall(function()
	GuiService.AutoSelectGuiEnabled = true
end)
pcall(function()
	GuiService.GuiNavigationEnabled = true
end)
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(rescale)
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end

Kit.setSoundPlayer(function(name)
	Sounds.play(name)
end)

Animator.start()
Popups.build(screen, Sounds)
Windows.build(screen)
MogHud.build(screen)
-- The Modes window's MOG TEST PLAY opens the VS RIVALS / 1v1 DUEL picker.
Windows.onMogPlay = MogHud.choose
Guide.build()
Hud.build(screen, {
	openWindow = Windows.open,
	toast = Popups.toast,
	guide = function(target)
		Guide.navigate(target, "CLAIM!", 45)
	end,
}, Sounds)
-- The sky obby's rainbow progress bar, stage counter, skip button and gear hotbar.
-- Hud's run pill docks into its row; its gear hotbar rides on Hud's dumbbell.
ObbyHud.build(screen, { sounds = Sounds, dockRun = Hud.dockRun, tank = Hud.tank })
-- Last "Cash" effect: the tutorial reward waits for the wallet count-up.
local lastCashAt = 0

Tutorial.build(screen, {
	popups = Popups,
	sounds = Sounds,
	guide = Guide,
	walletIdle = function(): boolean
		return os.clock() - lastCashAt >= 1.5 and Hud.walletIdle()
	end,
	highlight = function(name, on)
		local button = Hud.buttons[name]
		if button then
			Kit.setGlow(button, on)
		end
	end,
})

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- The intro hides the default player list while it plays; registering it as a
-- reason keeps windows that close mid-intro from showing the list again.
player:GetAttributeChangedSignal("IntroPlaying"):Connect(function()
	Kit.hidePlayerList("intro", player:GetAttribute("IntroPlaying") == true)
end)

local action = Net.event("Action")

-- Plays the intro once, after the first snapshot, for players who haven't seen
-- it (the server sets the "IntroSeen" attribute before that snapshot). The
-- loading screen fades out over its first shot.
local introChecked = false
local function maybePlayIntro()
	if introChecked or not Cutscene then
		return
	end
	introChecked = true
	task.spawn(function()
		local waited = 0
		while player:GetAttribute("IntroSeen") == nil and waited < 3 do
			waited += task.wait(0.1)
		end
		if player:GetAttribute("IntroSeen") ~= false then
			return
		end
		-- Start after the loading screen (ReplicatedFirst) has faded out, not under it.
		local playerGui = player:WaitForChild("PlayerGui")
		while playerGui:FindFirstChild("LoadingScreen") and waited < 50 do
			waited += task.wait(0.1)
		end
		Cutscene.play({
			delay = 1.4,
			onDone = function()
				action:FireServer({ action = "IntroSeen" })
			end,
		})
	end)
end

-- Studio-only capture hook: setting the LocalPlayer attribute "IntroPreview" to
-- "<beat>,<pauseSeconds>" replays the intro paused inside that beat.
if RunService:IsStudio() and Cutscene then
	player:GetAttributeChangedSignal("IntroPreview"):Connect(function()
		local spec = player:GetAttribute("IntroPreview")
		if typeof(spec) ~= "string" or spec == "" then
			return
		elseif spec == "skip" then
			Cutscene.skip()
			return
		end
		local beat, pause = string.match(spec, "^(%d+),?([%d%.]*)$")
		if beat then
			if Cutscene.isPlaying() then
				Cutscene.skip()
				task.wait(0.6)
			end
			-- Deferred so the Studio MCP's camera reset after execute_luau runs first.
			task.wait(0.8)
			Cutscene.preview(tonumber(beat) :: number, tonumber(pause))
		end
	end)
end
-- Studio-only capture hook: "UiPreview" = "<WindowName>", "Shop,<focus>", "close", "starter" or "reward,<tier>".
if RunService:IsStudio() then
	player:GetAttributeChangedSignal("UiPreview"):Connect(function()
		local spec = player:GetAttribute("UiPreview")
		if typeof(spec) ~= "string" or spec == "" then
			return
		end
		local tier = string.match(spec, "^reward,(%d+)$")
		if tier then
			Popups.reward({ kind = "Reward", tier = tonumber(tier), tiers = { tonumber(tier) }, new = true })
		elseif spec == "close" then
			Windows.closeAll()
			Popups.closeModals()
		elseif spec == "starter" then
			Popups.starterOffer()
		elseif string.match(spec, "^Shop,") then
			Windows.open("Shop", { focus = string.sub(spec, 6) })
		else
			Windows.open(spec)
		end
	end)
end

Net.event("State").OnClientEvent:Connect(function(data)
	State.set(data)
	maybePlayIntro()
	Sounds.updateMusic()
	if data.freeIn and data.freeIn > 0 then
		Guide.clearNavigate("Free")
	end
	-- Tells the loading screen (ReplicatedFirst) that the game is ready.
	if player:GetAttribute("GameReady") ~= true then
		player:SetAttribute("GameReady", true)
	end
end)

Net.event("Notify").OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	if payload.kind == "Toast" then
		Popups.toast(payload.text, payload.tone)
	elseif payload.kind == "Reward" then
		Popups.reward(payload)
	elseif payload.kind == "Offline" then
		Popups.offline(payload)
	elseif payload.kind == "Confirm" then
		Popups.confirm(payload.text, function()
			action:FireServer(payload.action)
		end)
	elseif payload.kind == "Tutorial" then
		Tutorial.onNotify(payload)
	elseif payload.kind == "Mode" and payload.mode == "mog" then
		-- MOG TEST (vs rivals or a 1v1 duel): the picker, queue panel, ring, HP and finish card
		-- (Fx.Mog does the 3D side).
		MogHud.onNotify(payload)
		if payload.event == "stop" and payload.reason == "full" then
			-- All six duel spots are taken: the test never started.
			Popups.toast("The Mog stage is full right now, try again in a moment", "info")
		end
	elseif payload.kind == "Mode" then
		-- Game-mode runs: the HUD run pill and the finish card (Fx.Modes does the 3D side).
		local event = payload.event
		if event == "pick" then
			-- Walked through gate 1's portal: pick a map (opening the window plays "Open").
			Windows.openMaps(tonumber(payload.level))
		elseif event == "start" then
			-- A run teleports the player onto the course: no window (the map picker, the
			-- Modes window) may stay up over it.
			Windows.closeAll()
			if payload.mode == "parkour" then
				-- The obby HUD owns the top centre for the run: the tycoon's counter, deposit
				-- strip, quest pill, promo and FREE gift step aside; it docks the run pill
				-- before the pill slides in.
				Hud.setObbyMode(true)
				ObbyHud.show(tonumber(payload.stage), tonumber(payload.stageCount))
			end
			Hud.runStart(
				tonumber(payload.startedAt) or workspace:GetServerTimeNow(),
				0,
				tonumber(payload.checkpoints) or 0,
				tonumber(payload.level)
			)
			Sounds.play("Ready")
		elseif event == "checkpoint" then
			Hud.runCheckpoint(tonumber(payload.index) or 0, tonumber(payload.checkpoints) or 0)
			if payload.stage ~= nil then
				ObbyHud.setStage(tonumber(payload.stage), tonumber(payload.stageCount))
			end
			Sounds.play("Step")
		elseif event == "respawn" then
			-- Fell through the clouds (or touched lava): back on the last checkpoint, the run goes on.
			if payload.stage ~= nil then
				ObbyHud.setStage(tonumber(payload.stage), tonumber(payload.stageCount))
			end
			if payload.reason == "kill" then
				Sounds.play("Error")
				Popups.toast("Ouch! Back to your checkpoint", "bad")
			end
		elseif event == "skip" then
			-- Paid a stage skip: on to the next checkpoint (the run is now assisted).
			ObbyHud.setStage(tonumber(payload.stage), tonumber(payload.stageCount))
			if payload.index ~= nil then
				Hud.runCheckpoint(tonumber(payload.index) or 0, tonumber(payload.checkpoints) or 0)
			end
			Sounds.play("Step")
		elseif event == "finish" then
			Hud.setObbyMode(false)
			Hud.runStop()
			ObbyHud.hide()
			-- "Run again" replays the same level; "Next level" starts the one just unlocked;
			-- "Choose map" opens the Maps window on the next level (or this one).
			local onPick = if payload.mode == "parkour"
				then function()
					Windows.openMaps(tonumber(payload.nextLevel) or tonumber(payload.level))
				end
				else nil
			Popups.modeFinish(payload, function()
				action:FireServer({ action = "ModeStart", mode = payload.mode, level = tonumber(payload.level) })
			end, function()
				action:FireServer({ action = "Home" })
			end, function()
				action:FireServer({ action = "ModeStart", mode = payload.mode, level = tonumber(payload.nextLevel) })
			end, onPick)
		elseif event == "invalid" then
			Hud.setObbyMode(false)
			Hud.runStop()
			ObbyHud.hide()
			Popups.toast(
				if payload.reason == "fast" then "Whoa, too fast! Try the course again" else "Missed a checkpoint! Try again",
				"info"
			)
		elseif event == "stop" then
			Hud.setObbyMode(false)
			Hud.runStop()
			ObbyHud.hide()
			if payload.reason == "left" then
				Popups.toast("You left the course. Run ended", "info")
			elseif payload.reason == "respawn" then
				Popups.toast("Run reset. Hop back in at the gate!", "info")
			elseif payload.reason == "quit" then
				Popups.toast("Run ended", "info")
			end
		end
	end
end)

-- Floating "+X" anchors: beside the HUD dumbbell (bottom centre) and above the
-- cash amount (bottom left).
local TANK = UDim2.new(0.5, 170, 1, -90)
local WALLET = UDim2.new(0, 150, 1, -110)

-- Sounds for effects owned by the UI. Fx modules (Client.Fx.*) listen to the
-- same remote for their 3D work and their own sounds (OrbPickup, MergeCharge,
-- MergeBoom, BuyPop): no sound here for "Merge".
Net.event("Effect").OnClientEvent:Connect(function(kind, data)
	data = if type(data) == "table" then data else {}
	if kind == "Collect" then
		-- Silent: Fx.Orbs already popped for each pickup.
		Hud.pulseTank()
		Popups.float("+" .. I.Orb .. Format.short(data.amount or 0), C.Orb, TANK)
	elseif kind == "Cash" then
		-- Auto Cash pays out every few seconds: no sound, float or coin burst for it, the
		-- wallet number simply rolls up.
		if data.source == "Auto" then
			return
		end
		local amount = if type(data.amount) == "number" then data.amount else 0
		lastCashAt = os.clock()
		if data.source == "Purchase" then
			-- Developer-product cash pack: full-screen celebration (plays its own sounds).
			Popups.purchase(amount)
			Hud.coinBurst(amount, nil)
			return
		end
		Sounds.play("Cash")
		Popups.float("+" .. Format.money(amount), C.Good, WALLET)
		-- Claimed from the Free menu button: coins fly from the button.
		local fromMenu = data.source == "Free" and os.clock() - Hud.freeClaimedAt < 3
		Hud.coinBurst(amount, if typeof(data.padPos) == "Vector3" then data.padPos else nil, if fromMenu then Hud.buttons.Free else nil)
	elseif kind == "Pad" then
		-- Fx.Machines plays the deny sound and pad wobble; the wallet shake
		-- guards against double calls.
		if data.ok == false and data.reason == "money" then
			Hud.shakeWallet()
		end
	elseif kind == "AuraGrant" then
		-- Aura pack: orbs fly into the tank (the server sends the "+X aura" toast).
		Hud.orbBurst(if type(data.amount) == "number" then data.amount else 0)
	elseif kind == "Deposit" then
		Sounds.play("Deposit")
		Popups.float(string.format("%s%s x%.1f", I.Orb, Format.short(data.amount or 0), data.mult or 1), C.Primary, TANK)
	elseif kind == "Buy" then
		Sounds.play("Buy", 0.1)
	elseif kind == "Merge" then
		Popups.noteMerge()
	elseif kind == "Upgrade" then
		Sounds.play("Upgrade")
	elseif kind == "ChestOpen" then
		-- The crate reveal (Popups) plays its own shake/burst sounds.
		Popups.noteChestOpen(data.rarity)
	elseif kind == "ChestPickup" then
		Sounds.play("Pickup")
	end
end)

-- 3D effect modules (built by other streams; any may be missing or fail).
local fxFolder = Client:FindFirstChild("Fx")
if fxFolder then
	for _, name in { "Camera", "Shelf", "Orbs", "Machines", "Crates", "Fans", "Ambient", "Plates", "Cosmetics", "Modes", "Mog", "Surge" } do
		local moduleScript = fxFolder:FindFirstChild(name)
		if moduleScript and moduleScript:IsA("ModuleScript") then
			local ok, err = pcall(function()
				local fx = require(moduleScript) :: any
				if type(fx) == "table" and type(fx.init) == "function" then
					fx.init()
				end
			end)
			if not ok then
				warn("[Fx] " .. name .. " failed: " .. tostring(err))
			end
		end
	end
end

-- Ask for a fresh snapshot now that every listener is connected.
action:FireServer({ action = "Sync" })
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="146">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[-- Sound effects plus background music.
--
-- Every name has a list of candidate sound ids (primary first). All ids below
-- were verified to load in the client (IsLoaded, TimeLength > 0). Each candidate
-- is still preloaded once at runtime; one that fails to load (moderation,
-- missing asset, timeout) is skipped in favour of the next. Until any candidate
-- is confirmed, the first one not known to have failed plays (it streams in).
--
-- Sources: Roblox-made UI sounds (creator "Roblox"), the licensed APM / Pro
-- Sound Effects libraries, this game's own uploads, and free public Creator
-- Store audio. The only bundled client file used is volume_slider.ogg (a soft
-- tick, shipped with every client) as a last resort for UI clicks.
--
-- Sounds.play(name, pitchJitter?, pitchMult?): unknown names are a no-op.
-- Sounds.updateMusic(): starts/stops the music per settings.music. The music is a
-- playlist: each track plays once, then the next in a shuffled order (reshuffled
-- when it runs out, never the same track twice in a row).
-- Sounds.setMood("surge" | nil): during an Aura Surge the music cross-fades (1 s)
-- to the surge playlist (Theme.SurgeMusicId, else SURGE_MUSIC; each surge starts
-- the next track) and back, resuming the normal track where it paused. With no
-- surge track loaded yet the normal track just speeds up for the surge. Music
-- off stays off; the mood waits while the intro cutscene plays.

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local State = require(script.Parent.State)

local Sounds = {}

local function lib(id: number): string
	return "rbxassetid://" .. id
end

-- Bundled with the client (content/sounds); always available.
local BUNDLED_TICK = "rbxasset://sounds/volume_slider.ogg"

-- Roblox-made UI sounds.
local UI_SMALL_CLICK = lib(15675032796) -- Roblox_UI_Small_Click
local UI_BRIGHT_CLICK = lib(15675059323) -- Roblox_UI_Bright_Click
local UI_CUTE_POP = lib(15675055424) -- Roblox_UI_Cute_Pop
local UI_TONAL_STINGER = lib(15675043410) -- Roblox_UI_Tonal_Stinger
local UI_WHOOSH_01 = lib(15675024286) -- Roblox_UI_Whoosh_01
local UI_DELETE = lib(15675075163) -- Roblox_UI_Delete
local GUI_SELECT = lib(17208396156) -- Roblox GUI - Select
local GUI_NOTIFY_HIGH = lib(17208361335) -- Roblox GUI - Notification High
local GUI_BUBBLE = lib(17208204604) -- Roblox GUI - Bubble
local GUI_BACK = lib(17208186900) -- Roblox GUI - Back
local GUI_ACCEPT = lib(17208209318) -- Roblox GUI - Call Accept
local GUI_DECLINE = lib(17208214688) -- Roblox GUI - Call Decline
local GUI_PURCHASE = lib(17208380755) -- Roblox GUI - Purchase

-- Pro Sound Effects library.
local WHOOSH_ZOOM = lib(9125648149) -- Magic Zoom Up Sharp Tubular Whoosh

-- Free public Creator Store audio.
local KACHING = lib(134208887292061) -- cash-register-kaching
local COIN_COLLECT = lib(135483737426662) -- Coin Collect
local ERROR_BUZZ = lib(91501650514390) -- Error Buzz

-- This game's own uploads.
local POP_MARIMBA = lib(82880781602391)
local POP_BELL = lib(108513451493306)
local TICK_A = lib(95444478167276)
local TICK_B = lib(104556737710683)
local TICK_C = lib(111480305904301)
local CRACKLE_A = lib(130988843893972)
local CRACKLE_B = lib(109769434232691)
local HIT_A = lib(132346841133984)
local HIT_B = lib(83739861834001)
local HIT_C = lib(112084716984188)
local LEVELUP = lib(139915238370208)
local FRENZY_START = lib(87726512735006)
local RING_A = lib(131720940448187)
local RING_B = lib(102704930703884)
local UNLOCK_STINGER = lib(121068318613723)
local CEREMONY_COMMON = lib(75797999851350)
local CEREMONY_EPIC = lib(100965222685530)
local CEREMONY_LEGENDARY = lib(85196226744574)

-- Funk / disco APM library tracks (licensed for every experience). The playlist
-- when the theme leaves MusicId empty.
local DEFAULT_MUSIC = {
	lib(1839889634), -- APM "Work Out"
	lib(9038367768), -- APM "Funky Disco Beats"
	lib(1843481682), -- APM "Flash Funk"
	lib(1843481858), -- APM "Funk Jam"
	lib(1839686686), -- APM "So Groovy"
	lib(1839802242), -- APM "Bouncy Funk"
	lib(1835725225), -- APM "Disco Sapiens"
	lib(1847605088), -- APM "Retro Funk"
	lib(9042511427), -- APM "Downtown Swagger C"
}
-- Harder APM tracks for an Aura Surge, when the theme leaves SurgeMusicId empty.
local SURGE_MUSIC = {
	lib(1847444965), -- APM "Party Hype A"
	lib(1839890308), -- APM "Football Frenzy"
	lib(1839705126), -- APM "Hype"
	lib(1845056062), -- APM "Pump It Up (a)"
	lib(9043939853), -- APM "Big Muscles A"
	lib(1837110694), -- APM "Skyhook"
	lib(1840321644), -- APM "Rave!"
}
local MUSIC_VOLUME = 0.18
-- Aura Surge music: cross-fade time, the surge track's loudness, and the speed
-- of the normal track when it has to double as the surge track.
local MOOD_FADE = 1
local SURGE_VOLUME = MUSIC_VOLUME * 1.15
local SURGE_SOLO_SPEED = 1.15

-- `rotate` names pick a random loaded candidate on each play.
type Def = {
	ids: { string },
	volume: number,
	pitch: number?,
	gap: number?,
	rotate: boolean?,
}

local DEFS: { [string]: Def } = {
	-- UI
	Click = { ids = { UI_SMALL_CLICK, GUI_SELECT, BUNDLED_TICK }, volume = 0.45 },
	Toggle = { ids = { UI_BRIGHT_CLICK, GUI_SELECT, BUNDLED_TICK }, volume = 0.45 },
	Toast = { ids = { GUI_NOTIFY_HIGH, GUI_BUBBLE }, volume = 0.25, gap = 0.05 },
	Error = { ids = { ERROR_BUZZ, GUI_DECLINE, UI_DELETE }, volume = 0.35 },
	Open = { ids = { WHOOSH_ZOOM, UI_WHOOSH_01 }, volume = 0.18 },
	Close = { ids = { GUI_BACK, WHOOSH_ZOOM }, volume = 0.3, pitch = 1.1 },
	Step = { ids = { GUI_ACCEPT, POP_BELL }, volume = 0.5 },
	Reward = { ids = { CEREMONY_COMMON, UI_TONAL_STINGER }, volume = 0.55 },
	Celebrate = { ids = { CEREMONY_EPIC, CEREMONY_COMMON }, volume = 0.6 },
	CelebrateLegendary = { ids = { CEREMONY_LEGENDARY, CEREMONY_EPIC }, volume = 0.7 },
	-- Economy
	Collect = { ids = { POP_MARIMBA, COIN_COLLECT }, volume = 0.3, gap = 0.05 },
	Cash = { ids = { KACHING, GUI_PURCHASE }, volume = 0.35, gap = 0.1 },
	Coin = { ids = { POP_MARIMBA, COIN_COLLECT }, volume = 0.28, gap = 0.045 },
	-- One soft pop when the Deposit pad banks your aura.
	Deposit = { ids = { UI_CUTE_POP, POP_BELL }, volume = 0.5, gap = 0.15 },
	Buy = { ids = { GUI_PURCHASE, KACHING }, volume = 0.5 },
	BuyPop = { ids = { POP_BELL, UI_CUTE_POP }, volume = 0.45 },
	Upgrade = { ids = { LEVELUP, UNLOCK_STINGER }, volume = 0.45 },
	Pickup = { ids = { GUI_BUBBLE, UI_CUTE_POP }, volume = 0.45 },
	-- Orbs
	OrbPickup = { ids = { UI_CUTE_POP, POP_BELL }, volume = 0.35, gap = 0.08 },
	-- Merges
	MergeCharge = { ids = { CRACKLE_A, CRACKLE_B }, volume = 0.4 },
	MergeBoom = { ids = { HIT_A, HIT_B, HIT_C }, volume = 0.55, rotate = true },
	-- Machines
	Ready = { ids = { RING_A, RING_B }, volume = 0.6 },
	Tick = { ids = { TICK_A, TICK_B, TICK_C, BUNDLED_TICK }, volume = 0.35, gap = 0.03, rotate = true },
	-- Events (SurgeStart is the intro cutscene's sting; the live surge itself is silent)
	SurgeStart = { ids = { FRENZY_START, UNLOCK_STINGER }, volume = 0.7 },
	CrateShake = { ids = { CRACKLE_B, CRACKLE_A }, volume = 0.55 },
	CrateBurst = { ids = { UNLOCK_STINGER, CEREMONY_COMMON }, volume = 0.6 },
}

local PRELOAD_TIMEOUT = 6

-- Load status per sound id: nil = unknown, "pending", "ok", "failed".
local status: { [string]: string } = {}
-- One Sound instance per name holding the currently chosen id.
local instances: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}

local function probe(id: string)
	if status[id] ~= nil then
		return
	end
	status[id] = "pending"
	task.spawn(function()
		local probeSound = Instance.new("Sound")
		probeSound.SoundId = id
		probeSound.Volume = 0
		probeSound.Parent = SoundService
		local result = "failed"
		local done = false
		task.delay(PRELOAD_TIMEOUT, function()
			done = true
		end)
		task.spawn(function()
			local ok = pcall(function()
				ContentProvider:PreloadAsync({ probeSound }, function(_, fetch)
					if fetch == Enum.AssetFetchStatus.Success then
						result = "ok"
					end
				end)
			end)
			if not ok then
				result = "failed"
			end
			done = true
		end)
		while not done do
			task.wait(0.1)
		end
		if result == "ok" and not (probeSound.IsLoaded and probeSound.TimeLength > 0) then
			-- Preload succeeded but the Sound must also report a playable length.
			result = "failed"
		end
		status[id] = result
		probeSound:Destroy()
	end)
end

-- Best id right now: a confirmed candidate (random among them for `rotate`),
-- else the first candidate not known to have failed. Nil when all failed.
local function chooseId(ids: { string }, rotate: boolean?): string?
	for _, id in ids do
		probe(id)
	end
	if rotate then
		local ready = {}
		for _, id in ids do
			if status[id] == "ok" and string.sub(id, 1, 11) ~= "rbxasset://" then
				table.insert(ready, id)
			end
		end
		if #ready > 0 then
			return ready[math.random(1, #ready)]
		end
	end
	for _, id in ids do
		if status[id] == "ok" then
			return id
		end
	end
	for _, id in ids do
		if status[id] ~= "failed" then
			return id
		end
	end
	return nil
end

local function sfxEnabled(): boolean
	local data = State.data
	return not data or not data.settings or data.settings.sfx ~= false
end

local function playNow(name: string, pitchJitter: number?, pitchMult: number?)
	local entry = DEFS[name]
	if not entry or not sfxEnabled() then
		return
	end
	local now = os.clock()
	if entry.gap and now - (lastPlayed[name] or 0) < entry.gap then
		return
	end
	lastPlayed[name] = now
	local id = chooseId(entry.ids, entry.rotate)
	if not id then
		return
	end
	local sound = instances[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Sfx_" .. name
		sound.Parent = SoundService
		instances[name] = sound
	end
	if sound.SoundId ~= id then
		sound.SoundId = id
	end
	sound.Volume = entry.volume
	local pitch = (entry.pitch or 1) * (pitchMult or 1)
	if pitchJitter then
		pitch += (math.random() - 0.5) * pitchJitter
	end
	sound.PlaybackSpeed = math.max(0.1, pitch)
	SoundService:PlayLocalSound(sound)
end

-- While the intro cutscene plays (LocalPlayer attribute "IntroPlaying"), gameplay sounds
-- stay silent: the tycoon keeps running behind it and its merges and pickups would leak in.
local function introPlaying(): boolean
	return Players.LocalPlayer:GetAttribute("IntroPlaying") == true
end

function Sounds.play(name: string, pitchJitter: number?, pitchMult: number?)
	if introPlaying() then
		return
	end
	playNow(name, pitchJitter, pitchMult)
end

-- For the cutscene's own sounds, which are the only ones heard while it plays.
function Sounds.playCutscene(name: string, pitchJitter: number?, pitchMult: number?)
	playNow(name, pitchJitter, pitchMult)
end

-- A shuffled play order over `ids`; `pos` is the last track handed out.
type Playlist = { ids: { string }, order: { string }, pos: number }

local function newPlaylist(ids: { string }): Playlist
	return { ids = ids, order = {}, pos = 0 }
end

-- The track the playlist hands out next. A used-up order is reshuffled, with the
-- track that just played moved off the front so it never plays twice in a row.
local function peek(list: Playlist): string
	if list.pos >= #list.order then
		local last = list.order[#list.order]
		local order = table.clone(list.ids)
		for i = #order, 2, -1 do
			local j = math.random(1, i)
			order[i], order[j] = order[j], order[i]
		end
		if #order > 1 and order[1] == last then
			order[1], order[#order] = order[#order], order[1]
		end
		list.order = order
		list.pos = 0
	end
	return list.order[list.pos + 1]
end

-- Hands out the next track, skipping ones that failed to load, and starts loading
-- the one after it. A track still loading is handed out anyway (it streams in)
-- unless `loadedOnly`, which then returns nil and keeps it for later. Nil when
-- every track failed.
local function nextTrack(list: Playlist, loadedOnly: boolean?): string?
	for _ = 1, #list.ids do
		local id = peek(list)
		probe(id)
		local state = status[id]
		if state == "failed" then
			list.pos += 1
		elseif state == "ok" or not loadedOnly then
			list.pos += 1
			probe(peek(list))
			return id
		else
			return nil
		end
	end
	return nil
end

local mainList = newPlaylist(if Theme.MusicId ~= "" then { Theme.MusicId } else DEFAULT_MUSIC)
local surgeMusicId: string = (Theme :: any).SurgeMusicId or ""
local surgeList = newPlaylist(if surgeMusicId ~= "" then { surgeMusicId } else SURGE_MUSIC)

-- Kick off loading of every sound effect and the first surge track early (the
-- music loads its tracks one ahead as it goes).
task.defer(function()
	for _, entry in DEFS do
		for _, id in entry.ids do
			probe(id)
		end
	end
	probe(peek(surgeList))
end)

local music: Sound? = nil

-- Music mood ("surge" or nil) and how the surge music is playing right now:
-- "track" = a second Sound (surgeMusic) with the normal track paused under it,
-- "speed" = the normal track itself sped up; nil = normal music.
local mood: string? = nil
local surgeMode: string? = nil
local surgeMusic: Sound? = nil

-- The running cross-fade per Sound (a new fade replaces it).
local fades: { [Sound]: Tween } = {}

local function fade(sound: Sound, props: { [string]: any }): Tween
	local old = fades[sound]
	if old then
		old:Cancel()
	end
	local tween = TweenService:Create(sound, TweenInfo.new(MOOD_FADE, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), props)
	fades[sound] = tween
	tween:Play()
	return tween
end

local function cancelFades()
	for _, tween in fades do
		tween:Cancel()
	end
	table.clear(fades)
end

local function enterSurge(m: Sound)
	-- A surge track still fading out from the last surge just carries on.
	local s = surgeMusic
	local carryOn = s ~= nil and s.IsPlaying and status[s.SoundId] == "ok"
	local id = if carryOn then (s :: Sound).SoundId else nextTrack(surgeList, true)
	if not id then
		surgeMode = "speed"
		fade(m, { PlaybackSpeed = SURGE_SOLO_SPEED, Volume = SURGE_VOLUME })
		return
	end
	surgeMode = "track"
	if not s then
		local sound = Instance.new("Sound")
		sound.Name = "MusicSurge"
		sound.Parent = SoundService
		sound.Ended:Connect(function()
			if surgeMode ~= "track" then
				return
			end
			local nextId = nextTrack(surgeList, true)
			if nextId then
				sound.SoundId = nextId
				sound.TimePosition = 0
				sound:Play()
			elseif music then
				-- The next surge track is still loading: the normal track speeds up instead.
				surgeMode = "speed"
				music:Resume()
				fade(music, { PlaybackSpeed = SURGE_SOLO_SPEED, Volume = SURGE_VOLUME })
			end
		end)
		surgeMusic = sound
		s = sound
	end
	local surgeSound = s :: Sound
	if surgeSound.SoundId ~= id then
		surgeSound:Stop()
		surgeSound.SoundId = id
	end
	surgeSound.Volume = 0
	if not surgeSound.IsPlaying then
		surgeSound:Play()
	end
	fade(surgeSound, { Volume = SURGE_VOLUME })
	fade(m, { Volume = 0 }).Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and surgeMode == "track" then
			m:Pause()
		end
	end)
end

local function leaveSurge(m: Sound)
	local wasTrack = surgeMode == "track"
	surgeMode = nil
	if not m.IsPlaying then
		m:Resume()
	end
	fade(m, { Volume = MUSIC_VOLUME, PlaybackSpeed = 1 })
	local s = surgeMusic
	if wasTrack and s then
		fade(s, { Volume = 0 }).Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and surgeMode == nil then
				s:Stop()
			end
		end)
	end
end

-- Music off: everything stops at once and the next start is the normal track.
local function stopAll(m: Sound)
	surgeMode = nil
	cancelFades()
	if surgeMusic then
		surgeMusic:Stop()
	end
	m:Stop()
	m.Volume = MUSIC_VOLUME
	m.PlaybackSpeed = 1
end

-- Called on every state update: also skips to the next track if the current one
-- turned out not to load.
function Sounds.updateMusic()
	local data = State.data
	local enabled = not data or not data.settings or data.settings.music ~= false
	if not music and not enabled then
		return
	end
	local current = if music then music.SoundId else ""
	local id = if current ~= "" and status[current] ~= "failed" then current else nextTrack(mainList)
	if not music then
		if not id then
			return
		end
		local sound = Instance.new("Sound")
		sound.Name = "Music"
		sound.Volume = MUSIC_VOLUME
		sound.Parent = SoundService
		-- Each track plays once, then the playlist moves on (also while sped up for
		-- a surge; under a surge track it is paused and never ends).
		sound.Ended:Connect(function()
			local nextId = nextTrack(mainList)
			if nextId then
				sound.SoundId = nextId
				sound.TimePosition = 0
				sound:Play()
			end
		end)
		music = sound
	end
	local m = music :: Sound
	if id and m.SoundId ~= id then
		m:Stop()
		m.SoundId = id
	end
	if not enabled or not id then
		if m.IsPlaying or surgeMode then
			stopAll(m)
		end
		return
	end
	local wantSurge = mood == "surge" and not introPlaying()
	if wantSurge and not surgeMode then
		if not m.IsPlaying then
			m:Play()
		end
		enterSurge(m)
	elseif not wantSurge and surgeMode then
		leaveSurge(m)
	elseif surgeMode ~= "track" and not m.IsPlaying then
		m:Play()
	end
end

function Sounds.setMood(name: string?)
	if name == mood then
		return
	end
	mood = name
	Sounds.updateMusic()
end

-- The surge mood waits for the intro to finish (and clears if the intro replays).
Players.LocalPlayer:GetAttributeChangedSignal("IntroPlaying"):Connect(function()
	if mood ~= nil or surgeMode ~= nil then
		Sounds.updateMusic()
	end
end)

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="147">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Client-side store for the latest server snapshot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage.Shared.Format)

local State = {}

State.data = nil :: { [string]: any }?
State.changed = Instance.new("BindableEvent")
State.clockOffset = 0
State.receivedAt = 0

function State.set(data: { [string]: any })
	State.data = data
	State.clockOffset = (data.now or os.time()) - os.time()
	State.receivedAt = os.clock()
	State.changed:Fire(data)
end

-- Server unix time estimate.
function State.now(): number
	return os.time() + State.clockOffset
end

-- Seconds since the snapshot arrived (for smooth countdowns between pushes).
function State.age(): number
	return os.clock() - State.receivedAt
end

-- Formats a number honouring the "full numbers" setting.
function State.num(n: number): string
	local data = State.data
	if data and data.settings and data.settings.fullNumbers then
		return Format.commas(n)
	end
	return Format.short(n)
end

function State.money(n: number): string
	return "$" .. State.num(n)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="148">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--[[
	Hud: always-on screen elements (design space 1280x720, below the top bar).
	Laid out like the owner's reference game: no panels or chips, just chunky
	icons and bold white Ink-outlined text straight over the world.

	  top bar right  Settings gear alone (Roblox's player list sits under it)
	  top centre     Chad icon + unit count "37/100" (sunny + "RACK FULL" when full)
	                 under it a low dark strip "Deposit bonus: x1.3 · 12s"
	                 ("AURA SURGE x2 · 1:23" in orange during a surge); the
	                 tutorial quest pill and the parkour run pill dock under that
	  left edge      icon grid with captions: Home Ranking Modes / Index Shop Invite
	                 promo under it: tilted "PERMANENT" tag, wide 2X CASH (or
	                 STARTER PACK) button, "Only 199 R$"
	  bottom left    status row (Premium, Friends, Boost), "Cash [ x1.0 ]",
	                 the big cash amount + square "+"
	  bottom centre  the dumbbell: "AURA" + the carried amount on its plaque
	  bottom right   FREE gift with its countdown, version in the corner

	Numbers roll, things pop and the HUD staggers in when it is built. While a
	window is open (attribute "WindowOpen") the groups slide off their edges.
	Short screens (attribute "Compact") get smaller grid icons, drop the status
	captions and the promo, and hide Roblox's player list.

	Input (Kit.onInput, re-placed live): on touch the wallet moves to the top
	left with the grid under it (one row on phones) so nothing sits on Roblox's
	thumbstick (bottom-left third, lower half) or jump button, the FREE gift
	rises above the jump button, the gear leaves the top bar and every button is
	at least 44 screen px (invisible hit pads on the small ones). On gamepad / TV
	the edges get a title-safe margin; every HUD button is Selectable (the Kit
	ring, hover scale on SelectionGained) unless a window or dialog is open.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)

local Theme = Kit.Theme
local C = Kit.C
local F = Kit.F
local W = Theme.Words

local Hud = {}

export type Handlers = {
	openWindow: (string, { focus: string? }?) -> (),
	guide: ((string?) -> ())?,
	toast: ((string, string?) -> ())?,
}

-- Buttons by name (Shop, Index, Ranking, Free, Home, Invite, Settings, Modes) so
-- other modules (tutorial, guide) can badge, glow or aim coin bursts at them.
Hud.buttons = {} :: { [string]: TextButton }

-- Filled in by build(); safe no-ops before that.
Hud.pulseTank = function(_big: boolean?) end
Hud.coinBurst = function(_amount: number, _padPos: Vector3?, _fromGui: GuiObject?) end
-- Aura orbs burst from the screen centre into the dumbbell tank (aura pack bought).
Hud.orbBurst = function(_amount: number) end
-- os.clock() of the last free-reward claim from the HUD (Main flies those coins from it).
Hud.freeClaimedAt = 0
-- Red shake on the cash amount ("can't afford").
Hud.shakeWallet = function() end
-- Game-mode run pill (timer + checkpoints + quit).
Hud.runStart = function(_startedAt: number, _checkpoint: number, _checkpoints: number, _level: number?) end
Hud.runCheckpoint = function(_index: number, _checkpoints: number) end
Hud.runStop = function() end
-- The sky obby docks the run pill into its own row (pos + anchor; nil puts it back).
Hud.dockRun = function(_pos: UDim2?, _anchor: Vector2?) end
-- A parkour run is on: the tycoon's top centre (units, deposit strip), the quest pill,
-- the promo and the FREE gift step aside for the obby HUD; off brings them back.
Hud.setObbyMode = function(_on: boolean) end
-- The dumbbell group (the obby gear hotbar sits on top of it).
Hud.tank = nil :: Frame?
-- True once the cash counter has finished rolling.
Hud.walletIdle = function(): boolean
	return true
end

-- Layout (design px). The top centre group sits just under the top bar.
local EDGE_X = 14
local UNITS_Y = 4 -- unit counter row: y 4..48
local STRIP_Y = 54 -- deposit strip: y 54..84
local STRIP_H = 30
local RUN_Y = 92 -- tutorial / run pill slot (Tutorial.luau TOP_Y matches)
local GRID_Y = 104 -- left icon grid, first row
local GRID_ICON = 64
local GRID_ICON_COMPACT = 48
local GRID_GAP_X = 10
local GRID_GAP_Y = 18 -- room for the caption under each row
local GEAR = 44
local DUMBBELL_W = 264
local DUMBBELL_W_COMPACT = 200
local DUMBBELL_ASPECT = 448 / 1024
local NARROW_PX = 900
local TAP_PX = 44 -- smallest touch target, in screen px
local TOP_BAR_PX = 58
local SAFE_X = 40 -- gamepad / TV title-safe edge (design px)
local SAFE_BOTTOM = 24
local PREMIUM_BONUS = 10

local function textWidth(text: string, size: number, font: Enum.Font): number
	local plain = string.gsub(text, "<[^>]->", "")
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(plain, size, font, Vector2.new(2000, 200))
	end)
	if ok and typeof(bounds) == "Vector2" and bounds.X > 0 then
		return math.ceil(bounds.X)
	end
	return math.ceil(#plain * size * 0.6)
end

-- A row of guis laid out left to right and centred vertically: icons keep their
-- width, labels are measured. Hidden items take no space. Returns the end x.

function Hud.build(screen: ScreenGui, handlers: Handlers, sounds: any)
	local action = Net.event("Action")
	local compact = false
	local promoFits = true -- touch: the promo only shows where it clears the thumbstick
	local screenScale = screen:FindFirstChildOfClass("UIScale")

	local function toast(text: string, tone: string?)
		if handlers.toast then
			handlers.toast(text, tone)
		end
	end
	local function designSize(): Vector2
		local ok, absolute = pcall(function()
			return screen.AbsoluteSize
		end)
		if not ok or typeof(absolute) ~= "Vector2" then
			return Vector2.zero
		end
		return absolute / (if screenScale then screenScale.Scale else 1)
	end

	-- Rolling numbers: each label counts from what it last showed to the new
	-- value (Kit.countTo); unchanged values just re-render (number format setting).
	local rolled: { [Instance]: number } = {}
	local rollEnds: { [Instance]: number } = {}
	local function roll(label: TextLabel, value: number, format: (number) -> string, duration: number?)
		local last = rolled[label]
		rolled[label] = value
		if last == nil or last == value then
			if (rollEnds[label] or 0) <= os.clock() then
				label.Text = format(value)
			end
			return
		end
		local time = duration or 0.45
		Kit.countTo(label, last, value, format, time)
		rollEnds[label] = os.clock() + time
	end
	-- A transparent group frame (HUD blocks have no backing).
	local function group(name: string, props: { [string]: any }): Frame
		props.Name = name
		props.BackgroundTransparency = 1
		props.Parent = props.Parent or screen
		return Kit.new("Frame", props)
	end
	-- Invisible hit pads grow small buttons to TAP_PX on touch (sized in place()).
	local pads: { { pad: TextButton, button: GuiObject } } = {}
	local function hitPad(button: GuiObject, onClick: () -> ())
		local pad = Kit.new("TextButton", {
			Name = "Hit",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Selectable = false,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			ZIndex = 30,
			Parent = button,
		})
		pad.Activated:Connect(function()
			Kit.sound("Click")
			onClick()
		end)
		table.insert(pads, { pad = pad, button = button })
	end
	-- A panel-less tap target: icon + caption are children, the button itself is
	-- the icon square (badges and glow rings sit on it).
	local function bareButton(parent: Instance, name: string, size: number, onClick: () -> ()): TextButton
		local button = Kit.new("TextButton", {
			Name = name,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			Parent = parent,
		})
		local scale = Kit.new("UIScale", { Parent = button })
		Kit.selectable(button)
		local function hover()
			Kit.tween(scale, 0.12, { Scale = 1.07 })
		end
		local function unhover()
			Kit.tween(scale, 0.12, { Scale = 1 })
		end
		button.MouseEnter:Connect(hover)
		button.MouseLeave:Connect(unhover)
		-- Gamepad selection shows the same lift as the mouse hover.
		pcall(function()
			button.SelectionGained:Connect(hover)
			button.SelectionLost:Connect(unhover)
		end)
		button.MouseButton1Down:Connect(function()
			Kit.tween(scale, 0.08, { Scale = 0.92 })
		end)
		button.MouseButton1Up:Connect(function()
			Kit.tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
		button.Activated:Connect(function()
			Kit.sound("Click")
			onClick()
		end)
		return button
	end

	-- Top bar, far right: the Settings gear alone ----------------------------------------
	-- It sits on the top bar's line (above our safe area) so Roblox's player list,
	-- which starts under the top bar, never covers it.
	local gear = bareButton(screen, "Settings", GEAR, function()
		handlers.openWindow("Settings")
	end)
	gear.AnchorPoint = Vector2.new(1, 0)
	gear.Position = UDim2.new(1, -10, 0, -GEAR - 7)
	Kit.hudIcon(gear, "Settings", GEAR, C.Text, { Name = "Icon", ZIndex = 2 }).Size = UDim2.fromScale(1, 1)
	Hud.buttons.Settings = gear

	-- Left edge: icon grid with captions --------------------------------------------------
	local GRID_ROWS = { { "Home", "Ranking", "Modes" }, { "Index", "Shop", "Invite" } }
	local CAPTIONS: { [string]: string } = {
		Home = "Home",
		Ranking = "Ranking",
		Modes = "Modes",
		Index = "Index",
		Shop = "Shop",
		Invite = "Invite",
	}
	-- Modes draws the rendered finish-flag image; Star stands in if it is missing.
	local ICON_FOR: { [string]: string } = { Modes = Kit.pickIcon("Modes", "Star") }
	local grid = group("Menu", { Position = UDim2.fromOffset(EDGE_X, GRID_Y) })
	local captions: { TextLabel } = {}
	local function gridButton(name: string, onClick: () -> ()): TextButton
		local button = bareButton(grid, name, GRID_ICON, onClick)
		local icon = Kit.hudIcon(button, ICON_FOR[name] or name, GRID_ICON, C.Text, { Name = "Icon", ZIndex = 2 })
		icon.Size = UDim2.fromScale(1, 1)
		local caption = Kit.hudText(button, {
			Name = "Caption",
			Text = CAPTIONS[name],
			TextSize = 18,
			Size = UDim2.new(1, 16, 0, 20),
			Position = UDim2.new(0.5, 0, 1, 6),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 4,
		})
		table.insert(captions, caption)
		button:SetAttribute("Label", CAPTIONS[name])
		Hud.buttons[name] = button
		return button
	end

	-- New discoveries since the Index was last opened (badge).
	local seenDiscoveries: number? = nil
	local function discoveredCount(data: { [string]: any }): number
		local found = 0
		for tier = 1, Economy.MAX_TIER do
			if (data.discovered[tier] or 0) > 0 then
				found += 1
			end
		end
		return found
	end
	local function refreshIndexBadge()
		local data = State.data
		if not data or not seenDiscoveries then
			return
		end
		local fresh = discoveredCount(data) - seenDiscoveries
		Kit.setBadge(Hud.buttons.Index, if fresh > 0 then tostring(fresh) else nil)
	end
	gridButton("Home", function()
		action:FireServer({ action = "Home" })
	end)
	gridButton("Ranking", function()
		handlers.openWindow("Ranking")
	end)
	gridButton("Modes", function()
		Kit.setGlow(Hud.buttons.Modes, false)
		handlers.openWindow("Modes")
	end)
	gridButton("Index", function()
		Kit.setGlow(Hud.buttons.Index, false)
		local data = State.data
		if data then
			seenDiscoveries = discoveredCount(data)
			refreshIndexBadge()
		end
		handlers.openWindow("Index")
	end)
	gridButton("Shop", function()
		handlers.openWindow("Shop")
	end)
	gridButton("Invite", function()
		pcall(function()
			SocialService:PromptGameInvite(Players.LocalPlayer)
		end)
	end)
	-- Right after the tutorial finishes (watched live this session), one toast and a
	-- soft glow point at the Modes button.
	local tutorialWasOpen = false
	State.changed.Event:Connect(function(data)
		if data.tutorialDone ~= true then
			tutorialWasOpen = true
		elseif tutorialWasOpen then
			tutorialWasOpen = false
			task.delay(9, function()
				Kit.setGlow(Hud.buttons.Modes, true)
				toast("New! " .. (if Kit.touch then "Tap" else "Open") .. " MODES to try Parkour and the Mog Test", "info")
			end)
		end
	end)

	-- Promo under the grid: tilted tag, wide button, price line ---------------------------
	-- Starter pack until it is owned, then 2X CASH until that is owned, then nothing.
	local PROMOS = {
		Starter = { tag = "LIMITED", text = "STARTER PACK", price = 59, focus = Theme.Cosmetics.Starter.Pass },
		DoubleMoney = { tag = "PERMANENT", text = "2X CASH", price = 199, focus = "DoubleMoney" },
	}
	local PROMO_W, PROMO_H = 3 * GRID_ICON + 2 * GRID_GAP_X, 44
	local promo = group("Promo", { Size = UDim2.fromOffset(PROMO_W, PROMO_H + 40), Visible = false })
	local promoMode = "DoubleMoney"
	local promoButton = Kit.button(promo, {
		Name = "Button",
		Text = "2X CASH",
		Font = F.Display,
		TextSize = 24,
		TextColor = Color3.new(1, 1, 1),
		Color = C.Cash,
		Size = UDim2.fromOffset(PROMO_W, PROMO_H),
		Position = UDim2.fromOffset(0, 12),
		Radius = 12,
		Depth = 4,
	}, function()
		handlers.openWindow("Shop", { focus = PROMOS[promoMode].focus })
	end)
	local promoLabel = Kit.buttonLabel(promoButton)
	if promoLabel then
		local stroke = promoLabel:FindFirstChildOfClass("UIStroke") or Kit.textStroke(promoLabel, 2.5, 0)
		stroke.Color = C.Ink
		stroke.Thickness = 2.5
		stroke.Transparency = 0
	end
	local promoTag = Kit.hudText(promo, {
		Name = "Tag",
		Text = "PERMANENT",
		TextSize = 15,
		TextColor3 = C.Gold,
		Size = UDim2.fromOffset(110, 18),
		Position = UDim2.fromOffset(-4, 2),
		Rotation = -8,
		ZIndex = 8,
	})
	local promoPrice = Kit.hudText(promo, {
		Name = "Price",
		Text = "Only 199 " .. Kit.ROBUX,
		TextSize = 18,
		Size = UDim2.fromOffset(PROMO_W, 22),
		Position = UDim2.fromOffset(0, PROMO_H + 18),
		ZIndex = 3,
	})
	local function dressPromo(mode: string)
		promoMode = mode
		local look = PROMOS[mode]
		if promoLabel then
			promoLabel.Text = look.text
		end
		promoTag.Text = look.tag
		promoPrice.Text = string.format("Only %d %s", look.price, Kit.ROBUX)
	end
	local stopPromoShine: (() -> ())? = nil
	local promoShown = false
	local function wantedPromo(): string?
		local data = State.data
		if not data then
			return nil
		end
		local cosmetics = data.cosmetics
		if not (type(cosmetics) == "table" and cosmetics.starterOwned == true) then
			return "Starter"
		elseif data.passes.DoubleMoney ~= true then
			return "DoubleMoney"
		end
		return nil
	end
	local function updatePromo()
		local mode = wantedPromo()
		local show = mode ~= nil
			and not compact
			and promoFits
			and screen:GetAttribute("WindowOpen") ~= true
			and screen:GetAttribute("ObbyMode") ~= true
		if show and mode ~= promoMode then
			if promoShown then
				-- Switching offers: the old one eases out, the new one eases in.
				promoShown = false
				Kit.disappear(promo, {
					to = 0.85,
					time = 0.18,
					onDone = function()
						dressPromo(mode :: string)
						updatePromo()
					end,
				})
				return
			end
			dressPromo(mode :: string)
		end
		if show == promoShown then
			return
		end
		promoShown = show
		if show then
			Kit.appear(promo, { from = 0.8, time = 0.26 })
			local face = Kit.buttonFace(promoButton)
			if face and not stopPromoShine then
				stopPromoShine = Kit.shimmer(face, 7, 5)
			end
		else
			Kit.disappear(promo, { to = 0.85, time = 0.18 })
			if mode == nil and stopPromoShine then
				stopPromoShine()
				stopPromoShine = nil
			end
		end
	end
	dressPromo("DoubleMoney")

	-- Bottom right: FREE gift + countdown, version in the corner --------------------------
	local corner = group("FreeCorner", {
		Size = UDim2.fromOffset(84, 92),
		AnchorPoint = Vector2.new(1, 1),
	})
	local freeButton = bareButton(corner, "Free", 60, function()
		local data = State.data
		if not data then
			return
		end
		local left = math.max(0, (data.freeIn or 0) - State.age())
		if left <= 0 then
			-- Claim straight from the HUD; the server answers with a "Cash" effect
			-- (source "Free") that flies coins into the cash amount.
			action:FireServer({ action = "ClaimFree" })
			Hud.freeClaimedAt = os.clock()
			local button = Hud.buttons.Free
			if button then
				Kit.pop(button, 1.4)
				Kit.confetti(button, {
					Origin = UDim2.fromScale(0.5, 0.4),
					Count = 14,
					ZIndex = 12,
					Colors = { C.Cash, C.GoldLight, Color3.new(1, 1, 1) },
					Power = 0.5,
				})
			end
		else
			toast("Next free reward in " .. Format.time(left), "info")
		end
	end)
	freeButton.AnchorPoint = Vector2.new(0.5, 0)
	freeButton.Position = UDim2.fromScale(0.5, 0)
	freeButton:SetAttribute("Label", "Free")
	Kit.hudIcon(freeButton, Kit.pickIcon("Free", "Gift2"), 60, C.Gold, { Name = "Icon", ZIndex = 2 }).Size = UDim2.fromScale(1, 1)
	Hud.buttons.Free = freeButton
	local freeTimer = Kit.hudText(corner, {
		Name = "Timer",
		Text = "",
		TextSize = 20,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
	})
	local version = Kit.hudText(screen, {
		Name = "Version",
		Text = "v" .. Economy.VERSION,
		Font = F.UI,
		TextSize = 12,
		StrokeThickness = 1.5,
		Size = UDim2.fromOffset(80, 14),
		Position = UDim2.new(1, -8, 1, -4),
		AnchorPoint = Vector2.new(1, 1),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTransparency = 0.15,
	})
	version.ZIndex = 1

	-- Run pill: a game-mode run's timer under the multiplier chip (the tutorial pill's
	-- slot; ScreenGui attribute "RunActive" tells Tutorial to step aside). Timer from the
	-- server clock, checkpoint n/N, and an "x" that asks "QUIT?" before firing ModeQuit.
	-- A gold "L3" chip on the left names the Parkour level (the Star shows without one).
	local RUN_W, RUN_H = 236, 36
	local RUN_ANCHOR = Vector2.new(0.5, 0)
	local runRest = UDim2.new(0.5, 0, 0, RUN_Y)
	local runAway = UDim2.new(0.5, 0, 0, -RUN_H - 20)
	local runPill = Kit.panel(screen, {
		Name = "RunPill",
		Size = UDim2.fromOffset(RUN_W, RUN_H),
		Position = runAway,
		AnchorPoint = Vector2.new(0.5, 0),
		Radius = RUN_H // 2,
		Visible = false,
	})
	local runStar =
		Kit.icon(runPill, "Star", 22, C.Gold, { Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 3 })
	local runLevel = Kit.text(runPill, {
		Name = "Level",
		Text = "L1",
		Font = Theme.Fonts.Display,
		TextSize = 15,
		TextWrapped = false,
		Size = UDim2.fromOffset(34, 24),
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = 0,
		TextColor3 = C.GoldInk,
		StrokeThickness = 0,
		Visible = false,
		ZIndex = 3,
	})
	Kit.round(runLevel)
	local runClock = Kit.number(runPill, {
		Name = "Clock",
		Text = "0:00.0",
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromOffset(82, RUN_H),
		Position = UDim2.fromOffset(42, 0),
		ZIndex = 3,
	})
	local runCheck = Kit.text(runPill, {
		Name = "Checkpoint",
		Text = "0/0",
		Font = F.UI,
		TextSize = 14,
		TextWrapped = false,
		Size = UDim2.fromOffset(62, 24),
		Position = UDim2.new(0, 124, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.Well,
		BackgroundTransparency = 0,
		ZIndex = 3,
	})
	Kit.round(runCheck)
	local runCheckScale = Kit.new("UIScale", { Parent = runCheck })
	local quitArmed = false
	local quitButton: TextButton
	local function onQuit()
		if quitArmed then
			quitArmed = false
			action:FireServer({ action = "ModeQuit" })
			return
		end
		-- First tap arms it: the button widens to "QUIT?" for a few seconds.
		quitArmed = true
		Kit.setButton(quitButton, "QUIT?", C.Bad)
		Kit.tween(quitButton, 0.2, { Size = UDim2.fromOffset(64, 28) }, Enum.EasingStyle.Back)
		-- The pill widens with it so "QUIT?" never covers the checkpoint chip.
		Kit.tween(runPill, 0.2, { Size = UDim2.fromOffset(RUN_W + 36, RUN_H) }, Enum.EasingStyle.Back)
		task.delay(3, function()
			if quitArmed then
				quitArmed = false
				Kit.setButton(quitButton, "X", C.SurfaceHi)
				Kit.tween(quitButton, 0.2, { Size = UDim2.fromOffset(30, 28) })
				Kit.tween(runPill, 0.2, { Size = UDim2.fromOffset(RUN_W, RUN_H) })
			end
		end)
	end
	quitButton = Kit.button(runPill, {
		Name = "Quit",
		Text = "X",
		Color = C.SurfaceHi,
		TextSize = 14,
		Size = UDim2.fromOffset(30, 28),
		Position = UDim2.new(1, -4, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Radius = 14,
		Depth = 2,
		ZIndex = 4,
	}, onQuit)
	hitPad(quitButton, onQuit)
	local runStartedAt = 0
	local runShown = false
	local runConn: RBXScriptConnection? = nil
	local lastClockText = ""
	Hud.runStart = function(startedAt: number, checkpoint: number, checkpoints: number, level: number?)
		runStartedAt = startedAt
		runStar.Visible = level == nil
		runLevel.Visible = level ~= nil
		if level then
			runLevel.Text = "L" .. tostring(level)
		end
		runCheck.Text = string.format("%d/%d", checkpoint, checkpoints)
		quitArmed = false
		Kit.setButton(quitButton, "X", C.SurfaceHi)
		quitButton.Size = UDim2.fromOffset(30, 28)
		runPill.Size = UDim2.fromOffset(RUN_W, RUN_H)
		runPill.AnchorPoint = RUN_ANCHOR
		screen:SetAttribute("RunActive", true)
		if not runShown then
			runShown = true
			runPill.Visible = true
			runPill.Position = runAway
			Kit.tween(runPill, 0.3, { Position = runRest }, Enum.EasingStyle.Back)
		end
		if not runConn then
			runConn = RunService.Heartbeat:Connect(function()
				local tenths = math.floor(math.max(Workspace:GetServerTimeNow() - runStartedAt, 0) * 10)
				local text = string.format("%d:%02d.%d", tenths // 600, (tenths // 10) % 60, tenths % 10)
				if text ~= lastClockText then
					lastClockText = text
					runClock.Text = text
				end
			end)
		end
	end
	Hud.runCheckpoint = function(index: number, checkpoints: number)
		runCheck.Text = string.format("%d/%d", index, checkpoints)
		runCheckScale.Scale = 1.35
		Kit.tween(runCheckScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		Kit.tween(runCheck, 0.12, { BackgroundColor3 = C.Good })
		task.delay(0.35, function()
			Kit.tween(runCheck, 0.3, { BackgroundColor3 = C.Well })
		end)
	end
	Hud.runStop = function()
		if runConn then
			runConn:Disconnect()
			runConn = nil
		end
		quitArmed = false
		screen:SetAttribute("RunActive", false)
		if runShown then
			runShown = false
			Kit.tween(runPill, 0.25, { Position = runAway }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.26, function()
				if not runShown then
					runPill.Visible = false
				end
			end)
		end
	end

	Hud.dockRun = function(pos: UDim2?, anchor: Vector2?)
		local rest = pos or UDim2.new(0.5, 0, 0, RUN_Y)
		RUN_ANCHOR = anchor or Vector2.new(0.5, 0)
		runRest = rest
		runAway = UDim2.new(rest.X.Scale, rest.X.Offset, 0, -RUN_H - 20)
		if runShown then
			runPill.AnchorPoint = RUN_ANCHOR
			Kit.tween(runPill, 0.25, { Position = runRest }, Enum.EasingStyle.Quad)
		end
	end

	-- Top centre: Chad icon + unit count ------------------------------------------------
	local units = group("Units", {
		Size = UDim2.fromOffset(300, 44),
		Position = UDim2.new(0.5, 0, 0, UNITS_Y),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	local unitsRow = Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = units,
	})
	local counter = Kit.hudIcon(units, "Chad", 42, C.Rizz, { Name = "Counter", LayoutOrder = 1, ZIndex = 2 })
	local counterLabel = Kit.hudText(units, {
		Name = "Count",
		Text = "0/100",
		Font = F.Number,
		TextSize = 34,
		StrokeThickness = 3,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40),
		LayoutOrder = 2,
		ZIndex = 3,
	})
	local counterCaption = Kit.hudText(units, {
		Name = "Full",
		Text = "RACK FULL",
		TextSize = 14,
		TextColor3 = C.Gold,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 18),
		LayoutOrder = 3,
		Visible = false,
		ZIndex = 3,
	})
	unitsRow.Padding = UDim.new(0, 6)
	local unitCap = 100
	local function unitsText(n: number): string
		return string.format("%d/%d", n, unitCap)
	end
	local rackFull: boolean? = nil
	local function setRackFull(full: boolean)
		if full == rackFull then
			return
		end
		local first = rackFull == nil
		rackFull = full
		counterCaption.Visible = full
		local color = if full then C.Gold else Color3.new(1, 1, 1)
		if first then
			counterLabel.TextColor3 = color
		else
			Kit.tween(counterLabel, 0.3, { TextColor3 = color })
			if full then
				Kit.pop(counter, 0.6)
			end
		end
	end

	-- The strip under it: "Deposit bonus: x1.3 · 12s" ------------------------------------
	local strip = Kit.new("Frame", {
		Name = "DepositStrip",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(340, STRIP_H),
		Position = UDim2.new(0.5, 0, 0, STRIP_Y),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = screen,
	})
	Kit.corner(strip, 8)
	local stripRow = Kit.new("Frame", {
		Name = "Row",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = strip,
	})
	Kit.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = stripRow,
	})
	local function stripText(name: string, order: number, size: number): TextLabel
		return Kit.hudText(stripRow, {
			Name = name,
			Text = "",
			TextSize = size,
			StrokeThickness = 2,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, STRIP_H),
			LayoutOrder = order,
			ZIndex = 3,
		})
	end
	local stripLead = stripText("Lead", 1, 20)
	stripLead.Text = "Deposit bonus:"
	local gaugeValue = stripText("Value", 2, 22)
	local gaugeNext = stripText("Next", 3, 15)
	gaugeNext.TextColor3 = Color3.fromRGB(225, 230, 250)
	local surgeActiveNow = false
	-- Big-roll cheer: pops out to the right of the strip for a moment.
	local niceLabel = Kit.hudText(strip, {
		Name = "Nice",
		Text = "NICE!",
		TextSize = 24,
		TextColor3 = C.Gold,
		Size = UDim2.fromOffset(96, 30),
		Position = UDim2.new(1, 8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Left,
		Rotation = 6,
		Visible = false,
		ZIndex = 5,
	})
	local function paintSurge(active: boolean)
		surgeActiveNow = active
		stripLead.Text = if active then "AURA SURGE" else "Deposit bonus:"
		Kit.tween(strip, 0.3, {
			BackgroundColor3 = if active then C.Amber else C.Ink,
			BackgroundTransparency = if active then 0.15 else 0.45,
		})
	end

	-- Bottom centre: the dumbbell with "AURA" and the carried amount ----------------------
	local Assets = (function(): any
		local shared = ReplicatedStorage:FindFirstChild("Shared")
		local module = shared and shared:FindFirstChild("Assets")
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				return result
			end
		end
		return nil
	end)()
	local images = if Assets and type(Assets.Images) == "table" then Assets.Images else {}
	local plainId: string? = images["hud/Dumbbell"]
	local glowId: string? = images["hud/DumbbellGlow"]
	local tank = group("Dumbbell", {
		Size = UDim2.fromOffset(DUMBBELL_W, DUMBBELL_W * DUMBBELL_ASPECT),
		Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1),
	})
	local tankScale = Kit.new("UIScale", { Parent = tank })
	local glowImage: ImageLabel? = nil
	-- Text rectangles in image pixels (art/out/ui/HudDumbbell.json, x y w h of 1024x448).
	local function rect(x: number, y: number, w: number, h: number): (UDim2, UDim2)
		return UDim2.fromScale(x / 1024, y / 448), UDim2.fromScale(w / 1024, h / 448)
	end
	local captionPos, captionSize = rect(310, 66, 404, 87)
	local numberPos, numberSize = rect(310, 156, 404, 160)
	if plainId then
		Kit.new("ImageLabel", {
			Name = "Art",
			BackgroundTransparency = 1,
			Image = plainId,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
			Parent = tank,
		})
		if glowId then
			glowImage = Kit.new("ImageLabel", {
				Name = "Glow",
				BackgroundTransparency = 1,
				Image = glowId,
				ImageTransparency = 1,
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 2,
				Parent = tank,
			})
		end
	else
		-- No art: a code-drawn pill in the plaque's place with the same two lines.
		captionPos, captionSize = UDim2.fromScale(0.25, 0.12), UDim2.fromScale(0.5, 0.22)
		numberPos, numberSize = UDim2.fromScale(0.25, 0.34), UDim2.fromScale(0.5, 0.42)
		local pill = Kit.new("Frame", {
			Name = "Plaque",
			BackgroundColor3 = C.Ink,
			BackgroundTransparency = 0.2,
			Size = UDim2.fromScale(0.56, 0.8),
			Position = UDim2.fromScale(0.22, 0.08),
			ZIndex = 1,
			Parent = tank,
		})
		Kit.corner(pill, 18)
	end
	local tankCaption = Kit.hudText(tank, {
		Name = "Caption",
		Text = string.upper(W.Orb),
		TextScaled = true,
		StrokeThickness = 2,
		TextColor3 = C.GoldLight,
		Size = captionSize,
		Position = captionPos,
		ZIndex = 4,
	})
	local carriedLabel = Kit.hudText(tank, {
		Name = "Carried",
		Text = "0",
		Font = F.Number,
		TextScaled = true,
		StrokeThickness = 2.5,
		Size = numberSize,
		Position = numberPos,
		ZIndex = 4,
	})
	tankCaption.TextSize = 20
	carriedLabel.TextSize = 36
	-- A bounce and a short cross-fade to the glow art; deposits bounce a little more.
	local glowToken = 0
	Hud.pulseTank = function(big: boolean?)
		tankScale.Scale = if big then 1.16 else 1.08
		Kit.tween(tankScale, if big then 0.45 else 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		local glow = glowImage
		if glow then
			glowToken += 1
			local token = glowToken
			Kit.tween(glow, 0.12, { ImageTransparency = 0 })
			task.delay(if big then 0.5 else 0.3, function()
				if token == glowToken then
					Kit.tween(glow, 0.35, { ImageTransparency = 1 })
				end
			end)
		end
	end

	-- Bottom left: status row, cash multiplier line, cash amount + plus -------------------
	local wallet = group("Wallet", {
		Size = UDim2.fromOffset(420, 168),
		Position = UDim2.new(0, EDGE_X, 1, -6),
		AnchorPoint = Vector2.new(0, 1),
	})
	local function status(name: string, icon: string, color: Color3, x: number): (Frame, TextLabel)
		local holder = group(name, { Size = UDim2.fromOffset(64, 56), Position = UDim2.fromOffset(x, 0), Parent = wallet })
		Kit.hudIcon(holder, icon, 36, color, {
			Name = "Icon",
			Position = UDim2.fromScale(0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 2,
		})
		local caption = Kit.hudText(holder, {
			Name = "Caption",
			Text = "",
			Font = F.UI,
			TextSize = 14,
			StrokeThickness = 2,
			Size = UDim2.new(1, 12, 0, 16),
			Position = UDim2.new(0.5, 0, 0, 38),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 3,
		})
		table.insert(captions, caption)
		return holder, caption
	end
	local premiumRow, premiumText = status("Premium", Kit.pickIcon("Crown", "Star"), C.Gold, 0)
	local friendsRow, friendsText = status("Friends", Kit.pickIcon("Invite", "Fans"), C.Rizz, 70)
	local boostRow, boostText = status("Boost", "Surge", C.Amber, 140)
	local multLine = Kit.hudText(wallet, {
		Name = "CashMult",
		Text = "",
		RichText = true,
		TextSize = 20,
		Size = UDim2.fromOffset(200, 22),
		Position = UDim2.fromOffset(0, 62),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
	})
	local moneyLabel = Kit.hudText(wallet, {
		Name = "Money",
		Text = "$0",
		Font = F.Number,
		TextSize = 46,
		StrokeThickness = 3,
		TextColor3 = C.MoneyText,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 50),
		Position = UDim2.fromOffset(0, 88),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
	})
	local coin = moneyLabel -- coin bursts fly into the cash amount
	local addButton = Kit.button(wallet, {
		Name = "Add",
		Icon = "Plus",
		IconColor = Color3.new(1, 1, 1),
		Color = C.Cash,
		Size = UDim2.fromOffset(44, 44),
		Radius = 10,
		Depth = 3,
		ZIndex = 3,
	}, function()
		handlers.openWindow("Shop", { focus = "Cash" })
	end)
	hitPad(addButton, function()
		handlers.openWindow("Shop", { focus = "Cash" })
	end)
	-- The plus follows the cash amount's width.
	local function layoutWallet()
		local x = math.max(textWidth(moneyLabel.Text, moneyLabel.TextSize, moneyLabel.Font) + 4, 60)
		addButton.Position = UDim2.fromOffset(x + 10, 92)
	end
	moneyLabel:GetPropertyChangedSignal("Text"):Connect(layoutWallet)

	-- Layout mode ------------------------------------------------------------------------
	-- Compact screens: smaller grid icons, no status captions, no promo, a smaller
	-- dumbbell. Touch (live, Kit.onInput): the wallet moves to the top left with the
	-- grid under it (one row when compact) so the thumbstick's bottom-left third stays
	-- clear, the FREE gift rises above the jump button, the gear leaves the top bar,
	-- and every button is >= TAP_PX on screen. Gamepad / TV: title-safe edges. While a
	-- window is open the grid slides off the left edge, the bottom groups below the
	-- bottom edge and the top groups up, and all glide back.
	local gridIcon = GRID_ICON
	local oneRow = false
	local L = { edge = EDGE_X, bottom = -6, walletTop = false, walletY = 0, gridY = GRID_Y, tap = 0, tankX = 0, freeY = -20 }
	local function gridRows(): { { string } }
		if oneRow then
			return { { "Home", "Ranking", "Modes", "Index", "Shop", "Invite" } }
		end
		return GRID_ROWS
	end
	local function gridHeight(): number
		local rows = #gridRows()
		return rows * gridIcon + (rows - 1) * GRID_GAP_Y
	end
	-- Viewport (screen px) and the UI scale Main applied.
	local function view(): (Vector2, number)
		local scale = if screenScale then screenScale.Scale else 1
		local ok, size = pcall(function()
			return Workspace.CurrentCamera.ViewportSize
		end)
		if not ok or typeof(size) ~= "Vector2" or size.X <= 0 then
			size = Vector2.new(1280, 720)
		end
		return size, math.max(scale, 0.01)
	end
	local function measure()
		local size, scale = view()
		local touch = Kit.touch
		local pad = Kit.gamepad or Kit.tenFoot
		L.edge = if pad then SAFE_X else EDGE_X
		L.bottom = if pad then -SAFE_BOTTOM else -6
		L.tap = if touch then math.ceil(TAP_PX / scale) else 0
		L.walletTop = touch
		oneRow = touch and compact
		gridIcon = math.max(if compact then GRID_ICON_COMPACT else GRID_ICON, L.tap)
		-- Top-left wallet: compact screens drop the status row (its 62 px) there.
		local skip = if touch and compact then 62 else 0
		L.walletY = 168 - skip
		L.gridY = if touch then 138 - skip + 12 else GRID_Y
		-- Thumbstick zone: left third, lower half of the screen (design px below the top bar).
		local designW = size.X / scale
		local halfY = (size.Y / 2 - TOP_BAR_PX) / scale
		promoFits = not touch or L.gridY + gridHeight() + 26 + PROMO_H + 40 <= halfY
		local tankW = if compact then DUMBBELL_W_COMPACT else DUMBBELL_W
		L.tankX = if touch then math.max(0, designW / 3 + 8 - (designW - tankW) / 2) else 0
		-- Jump button: 70 px at 20 px from the corner on small screens, 120 px 90 px up otherwise.
		local jumpTop = if math.min(size.X, size.Y) <= 500 then 90 else 210
		L.freeY = if touch then -math.ceil((jumpTop + 8) / scale) elseif pad then -SAFE_BOTTOM else -20
	end

	local slots: { { gui: GuiObject, rest: () -> UDim2, away: () -> UDim2 } } = {}
	local function slot(gui: GuiObject, rest: () -> UDim2, away: () -> UDim2)
		table.insert(slots, { gui = gui, rest = rest, away = away })
	end
	slot(grid, function()
		return UDim2.fromOffset(L.edge, L.gridY)
	end, function()
		return UDim2.fromOffset(-600, L.gridY)
	end)
	slot(promo, function()
		return UDim2.fromOffset(L.edge, L.gridY + gridHeight() + 26)
	end, function()
		return UDim2.fromOffset(-260, L.gridY + gridHeight() + 26)
	end)
	slot(wallet, function()
		return if L.walletTop then UDim2.new(0, L.edge, 0, L.walletY) else UDim2.new(0, L.edge, 1, L.bottom)
	end, function()
		return if L.walletTop then UDim2.new(0, L.edge, 0, -60) else UDim2.new(0, L.edge, 1, 200)
	end)
	slot(tank, function()
		return UDim2.new(0.5, L.tankX, 1, L.bottom)
	end, function()
		return UDim2.new(0.5, L.tankX, 1, 160)
	end)
	slot(corner, function()
		return UDim2.new(1, -L.edge, 1, L.freeY)
	end, function()
		return UDim2.new(1, 120, 1, L.freeY)
	end)
	slot(units, function()
		return UDim2.new(0.5, 0, 0, UNITS_Y)
	end, function()
		return UDim2.new(0.5, 0, 0, -140)
	end)
	slot(strip, function()
		return UDim2.new(0.5, 0, 0, STRIP_Y)
	end, function()
		return UDim2.new(0.5, 0, 0, -140)
	end)
	local targets: { [GuiObject]: UDim2 } = {}
	local function place(animate: boolean)
		local away = screen:GetAttribute("WindowOpen") == true
		-- The crate panel (Popups, attribute "CratePanelOpen") covers the right edge
		-- down to the FREE gift, so the gift steps aside while it is up.
		local crate = screen:GetAttribute("CratePanelOpen") == true
		for _, s in slots do
			local pos = if away or (crate and s.gui == corner) then s.away() else s.rest()
			if targets[s.gui] ~= pos then
				targets[s.gui] = pos
				if animate then
					Kit.tween(s.gui, 0.3, { Position = pos }, Enum.EasingStyle.Quad)
				else
					s.gui.Position = pos
				end
			end
		end
	end
	local function applyCompact()
		compact = screen:GetAttribute("Compact") == true
		measure()
		local step = gridIcon + GRID_GAP_X
		local columns = 0
		for row, names in gridRows() do
			columns = math.max(columns, #names)
			for column, name in names do
				local button = Hud.buttons[name]
				button.Size = UDim2.fromOffset(gridIcon, gridIcon)
				button.Position = UDim2.fromOffset((column - 1) * step, (row - 1) * (gridIcon + GRID_GAP_Y))
			end
		end
		grid.Size = UDim2.fromOffset(columns * step - GRID_GAP_X, gridHeight())
		for _, caption in captions do
			caption.TextSize = if compact then 15 else 18
		end
		-- Status captions go first on short screens; the icons stay (not on a touch
		-- phone, where the wallet sits in the top-left corner).
		for _, label in { premiumText, friendsText, boostText } do
			label.Visible = not compact
		end
		for _, row in { premiumRow, friendsRow, boostRow } do
			row.Visible = not (Kit.touch and compact)
		end
		local width = if compact then DUMBBELL_W_COMPACT else DUMBBELL_W
		tank.Size = UDim2.fromOffset(width, width * DUMBBELL_ASPECT)
		-- Gear: on the top bar's line with a mouse; below it (never on Roblox's bar) otherwise.
		local gearSize = math.max(GEAR, L.tap)
		gear.Size = UDim2.fromOffset(gearSize, gearSize)
		gear.Position = if Kit.input == "keyboard" and not Kit.tenFoot then UDim2.new(1, -10, 0, -GEAR - 7) else UDim2.new(1, -L.edge, 0, 4)
		-- FREE gift grows to a full touch target; the countdown follows it.
		local freeSize = math.max(60, L.tap)
		freeButton.Size = UDim2.fromOffset(freeSize, freeSize)
		corner.Size = UDim2.fromOffset(math.max(84, freeSize + 16), freeSize + 32)
		freeTimer.Position = UDim2.new(0.5, 0, 0, freeSize + 2)
		for _, p in pads do
			local w, h = p.button.Size.X.Offset, p.button.Size.Y.Offset
			p.pad.Size = UDim2.fromOffset(math.max(w, L.tap), math.max(h, L.tap))
			p.pad.Visible = Kit.touch and (w < L.tap or h < L.tap)
		end
		updatePromo()
		place(next(targets) ~= nil)
	end
	-- Gamepad: HUD buttons leave the D-pad's reach while a window or dialog is up.
	local selectables: { GuiObject } = { promoButton, addButton, quitButton }
	for _, button in Hud.buttons do
		table.insert(selectables, button)
	end
	local function updateSelectable()
		local blocked = screen:GetAttribute("WindowOpen") == true or screen:GetAttribute("ModalOpen") == true
		for _, button in selectables do
			Kit.selectable(button, not blocked)
		end
	end
	screen:GetAttributeChangedSignal("WindowOpen"):Connect(function()
		place(true)
		updatePromo()
		updateSelectable()
	end)
	screen:GetAttributeChangedSignal("ModalOpen"):Connect(updateSelectable)
	screen:GetAttributeChangedSignal("CratePanelOpen"):Connect(function()
		place(true)
	end)
	State.changed.Event:Connect(updatePromo)
	-- Compact, narrow or touch screens: Roblox's player list would cover the top-right
	-- corner (the gear on touch) and the unit counter, so it stays hidden there.
	local function updatePlayerList()
		local size = designSize()
		local narrow = size.X > 0 and size.X * (if screenScale then screenScale.Scale else 1) < NARROW_PX
		Kit.hidePlayerList("smallscreen", screen:GetAttribute("Compact") == true or narrow or Kit.touch)
	end
	local function relayout()
		applyCompact()
		updatePlayerList()
	end
	screen:GetAttributeChangedSignal("Compact"):Connect(relayout)
	pcall(function()
		screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(updatePlayerList)
	end)
	if screenScale then
		screenScale:GetPropertyChangedSignal("Scale"):Connect(relayout)
	end
	Kit.onInput(relayout)
	updateSelectable()

	-- Updates ------------------------------------------------------------------------------
	local moneyShown: number? = nil
	local moneyRollEnd = 0
	local lastMult: number? = nil
	local lastCarried: number? = nil
	local premiumOn: boolean? = nil
	local function refresh()
		local data = State.data
		if not data then
			return
		end
		-- Cash rolls up (longer for bigger gains) and quickly down when spent.
		if moneyShown ~= nil and data.money ~= moneyShown then
			local gain = data.money - (moneyShown :: number)
			local time = if gain > 0 then math.clamp(0.4 + 0.08 * math.log10(math.max(gain, 1)), 0.45, 0.9) else 0.25
			moneyRollEnd = os.clock() + time
			roll(moneyLabel, data.money, State.money, time)
		else
			roll(moneyLabel, data.money, State.money)
		end
		moneyShown = data.money
		if lastMult ~= nil and lastMult ~= data.moneyMult then
			Kit.pop(multLine, 0.8)
		end
		lastMult = data.moneyMult
		multLine.Text = string.format('Cash <font color="#%s">[ x%.1f ]</font>', C.Gold:ToHex(), data.moneyMult)
		local owned = 0
		if type(data.unitTotal) == "number" then
			owned = data.unitTotal
		elseif type(data.units) == "table" then
			for _, count in data.units do
				if type(count) == "number" then
					owned += count
				end
			end
		end
		unitCap = if type(data.unitCap) == "number" then data.unitCap else unitCap
		roll(counterLabel, owned, unitsText)
		setRackFull(owned >= unitCap)
		roll(carriedLabel, data.carried, State.num, 0.3)
		-- Carried aura dropping to nothing is a deposit: the bigger bounce.
		if lastCarried ~= nil and lastCarried > 0 and data.carried <= 0 then
			Hud.pulseTank(true)
		end
		lastCarried = data.carried

		local premium = data.premium == true
		premiumText.Text = if premium then string.format("Active +%d%%", PREMIUM_BONUS) else "Inactive"
		premiumText.TextColor3 = if premium then C.Gold else Color3.new(1, 1, 1)
		if premiumOn ~= nil and premium ~= premiumOn then
			Kit.pop(premiumRow, 0.6)
		end
		premiumOn = premium
		friendsText.Text = string.format("+%d%%", math.floor((data.friendBonus or 0) * 100 + 0.5))

		if seenDiscoveries == nil then
			seenDiscoveries = discoveredCount(data)
		end
		refreshIndexBadge()
		layoutWallet()
	end
	State.changed.Event:Connect(refresh)

	-- Coin burst to the wallet ------------------------------------------------------------
	-- Its own ScreenGui with no insets/scale so world->viewport points map 1:1.
	local fxGui = Instance.new("ScreenGui")
	fxGui.Name = "HudFx"
	fxGui.ResetOnSpawn = false
	fxGui.IgnoreGuiInset = true
	fxGui.DisplayOrder = 5
	fxGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function()
		fxGui.ScreenInsets = Enum.ScreenInsets.None
	end)
	fxGui.Parent = screen.Parent
	local fxLayer = Kit.new("Frame", {
		Name = "Layer",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = fxGui,
	})
	local uiScale = screen:FindFirstChildOfClass("UIScale")
	local coinPitch = 1
	local lastCoinAt = 0

	local function makeCoin(size: number): Frame
		return Kit.icon(fxLayer, "Coin", size, C.Gold, { Name = "Coin", AnchorPoint = Vector2.new(0.5, 0.5) })
	end

	Hud.coinBurst = function(amount: number, padPos: Vector3?, fromGui: GuiObject?)
		local layerAt = fxLayer.AbsolutePosition
		local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local origin = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
		local camera = Workspace.CurrentCamera
		if fromGui then
			origin = fromGui.AbsolutePosition + fromGui.AbsoluteSize * 0.5 - layerAt
		elseif padPos and camera then
			local point, onScreen = camera:WorldToViewportPoint(padPos)
			if onScreen and point.Z > 0 then
				origin = Vector2.new(point.X, point.Y)
			end
		end
		local target = coin.AbsolutePosition + coin.AbsoluteSize * 0.5 - layerAt
		local scale = if uiScale then uiScale.Scale else 1
		local magnitude = math.log10(math.max(amount, 1))
		local count = math.clamp(8 + math.floor(magnitude * 1.2), 8, 16)
		local size = math.floor(30 * scale)
		if os.clock() - lastCoinAt > 1 then
			coinPitch = 1
		end
		for i = 1, count do
			local c = makeCoin(size)
			c.Position = UDim2.fromOffset(origin.X, origin.Y)
			c.Size = UDim2.fromOffset(size * 0.4, size * 0.4)
			local angle = math.random() * math.pi * 2
			local radius = (40 + math.random() * 90) * scale
			local spread = origin + Vector2.new(math.cos(angle), math.sin(angle) * 0.7 - 0.4) * radius
			Kit.tween(
				c,
				0.3,
				{ Position = UDim2.fromOffset(spread.X, spread.Y), Size = UDim2.fromOffset(size, size) },
				Enum.EasingStyle.Back
			)
			task.delay(0.3 + i * 0.045, function()
				local fly = 0.42 + math.random() * 0.08
				Kit.tween(c, fly, {
					Position = UDim2.fromOffset(target.X, target.Y),
					Size = UDim2.fromOffset(size * 0.6, size * 0.6),
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(fly, function()
					c:Destroy()
					lastCoinAt = os.clock()
					sounds.play("Coin", 0.04, coinPitch)
					coinPitch = math.min(coinPitch + 0.035, 1.5)
					Kit.pop(moneyLabel, 0.4)
				end)
			end)
		end
	end

	-- Aura pack: a handful of orbs pop out at the screen centre and fly into the tank, each
	-- landing with the walk-over pickup pop at a rising pitch; the tank number rolls up from
	-- the State refresh that follows the grant.
	Hud.orbBurst = function(amount: number)
		local layerAt = fxLayer.AbsolutePosition
		local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local origin = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
		local target = carriedLabel.AbsolutePosition + carriedLabel.AbsoluteSize * 0.5 - layerAt
		local scale = if uiScale then uiScale.Scale else 1
		local count = math.clamp(6 + math.floor(math.log10(math.max(amount, 1))), 6, 12)
		local size = math.floor(34 * scale)
		for i = 1, count do
			local orb = Kit.icon(fxLayer, "Orb", size, C.Orb, { Name = "Orb", AnchorPoint = Vector2.new(0.5, 0.5) })
			orb.Position = UDim2.fromOffset(origin.X, origin.Y)
			orb.Size = UDim2.fromOffset(size * 0.4, size * 0.4)
			local angle = (i / count + math.random() * 0.1) * math.pi * 2
			local radius = (50 + math.random() * 70) * scale
			local spread = origin + Vector2.new(math.cos(angle), math.sin(angle) * 0.7) * radius
			Kit.tween(
				orb,
				0.3,
				{ Position = UDim2.fromOffset(spread.X, spread.Y), Size = UDim2.fromOffset(size, size) },
				Enum.EasingStyle.Back
			)
			task.delay(0.3 + i * 0.06, function()
				local fly = 0.45 + math.random() * 0.1
				Kit.tween(orb, fly, {
					Position = UDim2.fromOffset(target.X, target.Y),
					Size = UDim2.fromOffset(size * 0.5, size * 0.5),
				}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(fly, function()
					orb:Destroy()
					sounds.play("OrbPickup", 0, math.min(1 + i * 0.05, 1.6))
					Hud.pulseTank(i == count)
				end)
			end)
		end
	end

	local shaking = false
	Hud.shakeWallet = function()
		if shaking then
			return
		end
		shaking = true
		local home = moneyLabel.Position
		moneyLabel.TextColor3 = C.Danger
		Kit.pop(moneyLabel, 0.4)
		task.spawn(function()
			for _, dx in { 9, -8, 6, -4, 2, 0 } do
				Kit.tween(moneyLabel, 0.045, { Position = home + UDim2.fromOffset(dx, 0) }, Enum.EasingStyle.Sine)
				task.wait(0.045)
			end
			moneyLabel.Position = home
			Kit.tween(moneyLabel, 0.35, { TextColor3 = C.MoneyText })
			shaking = false
		end)
	end
	Hud.walletIdle = function(): boolean
		return os.clock() >= moneyRollEnd
	end

	-- Deposit multiplier re-roll: the value flickers like a slot machine ------------------
	local spinning = false
	local function multColor(mult: number): Color3
		return if mult >= 1.2 then C.MoneyText elseif mult < 1 then C.Danger else C.Gold
	end
	local depositMult = ReplicatedStorage:GetAttribute("DepositMult") or 1
	local function showMult(mult: number)
		if surgeActiveNow then
			gaugeValue.Text = "x" .. Economy.SURGE_MULTIPLIER
			gaugeValue.TextColor3 = Color3.new(1, 1, 1)
		else
			gaugeValue.Text = string.format("x%.1f", mult)
			gaugeValue.TextColor3 = multColor(mult)
		end
	end
	showMult(depositMult)
	ReplicatedStorage:GetAttributeChangedSignal("DepositMult"):Connect(function()
		depositMult = ReplicatedStorage:GetAttribute("DepositMult") or 1
		if spinning or surgeActiveNow then
			showMult(depositMult)
			return
		end
		spinning = true
		task.spawn(function()
			local elapsed = 0
			local step = 0.035
			-- Silent visual roll: the value flickers, then lands with a pop.
			while elapsed < 0.6 do
				showMult(Economy.DEPOSIT_MIN + math.random() * (Economy.DEPOSIT_MAX - Economy.DEPOSIT_MIN))
				task.wait(step)
				elapsed += step
				step *= 1.22
			end
			depositMult = ReplicatedStorage:GetAttribute("DepositMult") or depositMult
			showMult(depositMult)
			Kit.pop(gaugeValue, 1)
			Kit.pop(strip, 0.4)
			if depositMult >= 1.5 then
				niceLabel.Text = if depositMult >= 2 then "HUGE!" else "NICE!"
				Kit.appear(niceLabel, { from = 0.3, time = 0.3 })
				task.delay(1.4, function()
					Kit.disappear(niceLabel, { to = 1.1, time = 0.25 })
				end)
			end
			spinning = false
		end)
	end)

	-- Aura Surge: the strip and boost icon change; the screen grade and music are Fx.Surge's.
	local surgeActive: boolean? = nil
	local lastSurgeSecond = -1

	local function setSurge(active: boolean, announce: boolean)
		paintSurge(active)
		showMult(depositMult)
		boostText.Text = if active then "200%" else "100%"
		boostText.TextColor3 = if active then C.Amber else Color3.new(1, 1, 1)
		if announce then
			Kit.pop(strip, if active then 0.8 else 0.4)
			if active then
				Kit.pop(boostRow, 0.8)
			end
		end
	end

	-- Free gift: countdown under it; sunny "CLAIM!" with a gentle bounce when ready.
	local freeText = ""
	local freeReady: boolean? = nil
	local stopFreeBounce: (() -> ())? = nil
	local function paintFree(text: string, ready: boolean)
		if ready ~= freeReady then
			freeReady = ready
			Kit.setBadge(freeButton, if ready then "!" else nil)
			freeTimer.TextColor3 = if ready then C.Gold else Color3.new(1, 1, 1)
			if ready then
				Kit.pop(freeButton, 0.8)
				stopFreeBounce = Kit.breathe(freeButton, 0.06)
			elseif stopFreeBounce then
				stopFreeBounce()
				stopFreeBounce = nil
			end
		end
		freeTimer.Text = text
	end
	local nextText = ""
	RunService.Heartbeat:Connect(function()
		local now = Workspace:GetServerTimeNow()
		local active, left = Economy.surgeState(now)
		if active ~= surgeActive then
			-- Announce only real transitions, not the state found on join.
			setSurge(active, surgeActive ~= nil)
			surgeActive = active
		end
		local text
		if active then
			-- Countdown pop in the last 10 seconds.
			local second = math.ceil(left)
			if left <= 10 and second ~= lastSurgeSecond then
				lastSurgeSecond = second
				Kit.pop(gaugeNext, 0.8)
			end
			text = "· " .. Format.time(left)
		else
			local nextAt = ReplicatedStorage:GetAttribute("DepositNextAt") or now
			text = string.format("· %ds", math.max(0, math.ceil(nextAt - now)))
		end
		if text ~= nextText then
			nextText = text
			gaugeNext.Text = text
		end
		local data = State.data
		if data then
			local freeLeft = math.max(0, (data.freeIn or 0) - State.age())
			local ready = freeLeft <= 0
			local label = if ready then "CLAIM!" else Format.time(freeLeft)
			if label ~= freeText then
				freeText = label
				paintFree(label, ready)
			end
		end
	end)
	refresh()
	layoutWallet()

	-- Obby mode: the run's own HUD owns the top centre ----------------------------------
	Hud.tank = tank
	local obbyOn = false
	local tutorialConn: RBXScriptConnection? = nil
	local tutorialWanted = false
	local forcing = false
	Hud.setObbyMode = function(on: boolean)
		if on == obbyOn then
			return
		end
		obbyOn = on
		screen:SetAttribute("ObbyMode", on)
		for _, gui in { units, strip, corner } :: { GuiObject } do
			gui.Visible = not on
		end
		updatePromo()
		-- The quest pill (Tutorial) stays down even if it re-renders mid-run; whatever
		-- it asked for meanwhile is applied when the run ends.
		local pill = screen:FindFirstChild("TutorialPill")
		if not (pill and pill:IsA("GuiObject")) then
			return
		end
		if on then
			tutorialWanted = pill.Visible
			pill.Visible = false
			tutorialConn = pill:GetPropertyChangedSignal("Visible"):Connect(function()
				if forcing then
					return
				end
				tutorialWanted = pill.Visible
				if pill.Visible then
					forcing = true
					pill.Visible = false
					forcing = false
				end
			end)
		else
			if tutorialConn then
				tutorialConn:Disconnect()
				tutorialConn = nil
			end
			pill.Visible = tutorialWanted
		end
	end

	-- Entrance: the HUD eases in a block at a time, top first.
	local entrance: { GuiObject } = { units, strip, gear }
	for _, row in GRID_ROWS do
		for _, name in row do
			table.insert(entrance, Hud.buttons[name])
		end
	end
	table.insert(entrance, wallet)
	table.insert(entrance, tank)
	table.insert(entrance, corner)
	Kit.stagger(entrance, 0.03)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--[[
	Kit: the design system for the code-built UI.

	Visual language: "bright toy". Royal-blue panels that read as chunky
	moulded plastic: lighter at the top, a thin white highlight along the top
	inner edge, a darker blue lip along the bottom and a soft navy shadow.
	Wells are a deeper blue. Sunny yellow (orange lip, Ink text) is the one
	call-to-action colour; mint is money, sky blue the premium currency, orange
	the surge, coral close/danger. Text is light on blue; outlines only on text
	over the 3D world (Shadow = true). Icons are built from shapes (Kit.icon) or
	come from the optional Shared.Assets icon atlas.

	Motion: everything eases. Kit.appear / Kit.disappear (scale + fade),
	Kit.stagger (rows in), Kit.countTo (number rolls), Kit.pop (landing pop),
	Kit.breathe (idle CTA). Buttons squash on press and spring back.

	Tokens
	  Kit.TEXT    type scale (TextSize in design pixels; the ScreenGui UIScale
	              scales the whole 1280x720 design to the device)
	  Kit.RADIUS  corner radii
	  Kit.input   "touch" | "gamepad" | "keyboard", the input used last
	              (Kit.touch / Kit.gamepad follow it; Kit.onInput re-flows)
	              Kit.onInput(fn) -> disconnect; Kit.tenFoot on TV consoles
	  Kit.keyHint prompt text per mode: Kit.keyHint("confirm"|"back"|"jump")
	              ("TAP" / "A" / "SPACE"...); Kit.hint(touch, keyboard, gamepad)
	  Kit.focus   gamepad selection: Kit.focus(target) selects target's first
	              visible button (FocusFirst attribute wins), Kit.focus(nil)
	              clears, Kit.unfocus(container) releases, Kit.confine(holder)
	              traps the D-pad; Kit.selectable(button) + Kit.selectionRing()
	              give buttons built elsewhere the shared selection ring
	  Kit.ICONS   names accepted by Kit.icon (and Kit.button's Icon prop)

	Every builder keeps its public signature; see the headers below.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local CharacterFactory = require(ReplicatedStorage.Shared.CharacterFactory)
local Animator = require(script.Parent.Parent.Animator)
local Sprites = require(script.Parent.Parent.Fx.Sprites)

local Kit = {}
Kit.Theme = Theme
Kit.C = Theme.Colors
Kit.F = Theme.Fonts

Kit.TEXT = {
	Hero = 40,
	H1 = 28,
	H2 = 22,
	H3 = 18,
	Body = 16,
	Small = 14,
	Tiny = 12,
}

Kit.RADIUS = {
	S = 10,
	M = 14,
	L = 18,
	XL = 22,
}

-- Input mode ----------------------------------------------------------------------------
--[[
	Kit.input is "touch", "gamepad" or "keyboard" (keyboard + mouse): the kind of
	input the player used last, starting from what the device offers (a console
	is gamepad, a phone touch, a laptop keyboard even with a touch screen until it
	is tapped). Kit.touch and Kit.gamepad follow it. Kit.onInput(fn) runs fn(mode)
	now and whenever the mode changes, so layouts and hints can re-flow when a
	player picks up a controller or plugs in a keyboard. Kit.tenFoot is true on a
	TV-distance (10-foot) console interface (Kit.console is the same flag).
]]
export type InputMode = "touch" | "gamepad" | "keyboard"
Kit.input = "keyboard" :: InputMode
Kit.touch = false
Kit.gamepad = false
Kit.tenFoot = false
pcall(function()
	Kit.tenFoot = GuiService:IsTenFootInterface() == true
end)
Kit.console = Kit.tenFoot
local inputListeners: { (InputMode) -> () } = {}

-- Maps a UserInputType to a mode; nil for types that say nothing (Focus, TextInput...).
local function classifyInput(inputType: Enum.UserInputType?): InputMode?
	if inputType == nil then
		return nil
	end
	if inputType == Enum.UserInputType.Touch then
		return "touch"
	end
	local name = inputType.Name
	if string.sub(name, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	if name == "Keyboard" or string.sub(name, 1, 5) == "Mouse" then
		return "keyboard"
	end
	return nil
end

local function applyInput(mode: InputMode)
	Kit.input = mode
	Kit.touch = mode == "touch"
	Kit.gamepad = mode == "gamepad"
end

local function setInput(mode: InputMode)
	if mode == Kit.input then
		return
	end
	applyInput(mode)
	for _, fn in table.clone(inputListeners) do
		task.spawn(fn, mode)
	end
end

pcall(function()
	local mode: InputMode = "keyboard"
	local touch, keyboard, gamepad = UserInputService.TouchEnabled, UserInputService.KeyboardEnabled, UserInputService.GamepadEnabled
	if gamepad and not keyboard and not touch then
		mode = "gamepad"
	elseif touch and not keyboard then
		mode = "touch"
	end
	if Kit.tenFoot then
		mode = "gamepad"
	end
	applyInput(mode)
end)
-- A controller counts as "in use" on a button press or a clear stick / trigger move; a
-- resting stick's drift (reported as gamepad input) must not re-flow a keyboard player's HUD.
local STICK_DEADZONE = 0.35
local function gamepadIntent(input: InputObject): boolean
	local key = input.KeyCode
	if key == Enum.KeyCode.Thumbstick1 or key == Enum.KeyCode.Thumbstick2 then
		return input.Position.Magnitude >= STICK_DEADZONE
	end
	if key == Enum.KeyCode.ButtonL2 or key == Enum.KeyCode.ButtonR2 then
		return input.Position.Z >= STICK_DEADZONE
	end
	return input.UserInputState == Enum.UserInputState.Begin
end
pcall(function()
	UserInputService.LastInputTypeChanged:Connect(function(inputType: Enum.UserInputType)
		local mode = classifyInput(inputType)
		if mode and mode ~= "gamepad" then
			setInput(mode)
		end
	end)
	local function onGamepad(input: InputObject)
		if classifyInput(input.UserInputType) == "gamepad" and gamepadIntent(input) then
			setInput("gamepad")
		end
	end
	UserInputService.InputBegan:Connect(onGamepad)
	UserInputService.InputChanged:Connect(onGamepad)
end)

-- Runs fn(Kit.input) now and on every change; returns a disconnect function.
function Kit.onInput(fn: (InputMode) -> ()): () -> ()
	table.insert(inputListeners, fn)
	task.spawn(fn, Kit.input)
	return function()
		local i = table.find(inputListeners, fn)
		if i then
			table.remove(inputListeners, i)
		end
	end
end

local KEY_HINTS: { [string]: { [string]: string } } = {
	touch = { confirm = "TAP", back = "TAP", jump = "TAP" },
	gamepad = { confirm = "A", back = "B", jump = "A" },
	keyboard = { confirm = "SPACE", back = "ESC", jump = "SPACE" },
}

-- Prompt text for an action in the current mode: Kit.keyHint("confirm") -> "TAP" / "A" / "SPACE".
function Kit.keyHint(action: "confirm" | "back" | "jump"): string
	local hints = KEY_HINTS[Kit.input] or KEY_HINTS.keyboard
	return hints[action] or hints.confirm
end

-- Picks free wording for the current input: Kit.hint("TAP", "SPACE", "A").
function Kit.hint(touch: string, keyboard: string, gamepad: string): string
	if Kit.touch then
		return touch
	elseif Kit.gamepad then
		return gamepad
	end
	return keyboard
end

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local C = Kit.C
local F = Kit.F

-- Face colour of disabled buttons (a quiet blue-grey that still reads as plastic).
local DISABLED = Color3.fromRGB(150, 166, 212)

-- The Lune preview exporter stubs TweenInfo with a plain table and jumps every
-- tween to its end state; transient effects (pops, breathing) are skipped there
-- so captures show the resting layout.
local PREVIEW = typeof(TweenInfo.new(0)) ~= "TweenInfo"

-- Roblox's built-in Robux glyph (drawn by the Gotham/Builder fonts); plain "R$"
-- in the web preview. Every Robux price in the UI is written with it.
Kit.ROBUX = if PREVIEW then "R$" else utf8.char(0xE002)

-- Sounds are injected by Main so Kit stays free of client state.
local soundPlayer: ((string) -> ())? = nil
function Kit.setSoundPlayer(fn: (string) -> ())
	soundPlayer = fn
end
function Kit.sound(name: string)
	if soundPlayer then
		soundPlayer(name)
	end
end

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	local properties: { [string]: any } = props or {}
	for key, value in properties do
		if key == "Parent" then
			parent = value
		else
			(inst :: any)[key] = value
		end
	end
	local childList: { Instance } = children or {}
	for _, child in childList do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Gamepad selection -------------------------------------------------------------------
--[[
	Console players move a selection (GuiService.SelectedObject) between
	GuiButtons with the D-pad / left stick. Every Kit control is Selectable and
	wears Kit.selectionRing() (a sunny rounded outline with a soft glow) so the
	focus reads in the toy style; decorative hit areas and backdrops are not
	Selectable. Kit.selectable(button) does the same for buttons built elsewhere.

	Kit.focus(target) selects the first visible, Selectable button under target
	(a descendant with attribute FocusFirst = true wins; else lowest LayoutOrder,
	then topmost-leftmost) on gamepad / 10-foot only; Kit.focus(nil) clears the
	selection in every mode. Kit.unfocus(container) clears it when it sits inside
	container (or always for nil). Kit.confine(holder) makes holder a
	SelectionGroup the D-pad cannot leave (Kit.window does this).
]]
local selectionRing: Frame? = nil

function Kit.selectionRing(): Frame
	if selectionRing then
		return selectionRing
	end
	local frame = Kit.new("Frame", {
		Name = "SelectionRing",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 12, 1, 12),
		Position = UDim2.fromOffset(-6, -6),
		ZIndex = 50,
	})
	Kit.new("UICorner", { CornerRadius = UDim.new(0, Kit.RADIUS.M), Parent = frame })
	Kit.new("UIStroke", {
		Thickness = 3,
		Color = C.Primary,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = frame,
	})
	-- Inner white hairline so the ring reads on yellow buttons too.
	local inner = Kit.new("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.fromOffset(3, 3),
		ZIndex = 50,
		Parent = frame,
	})
	Kit.new("UICorner", { CornerRadius = UDim.new(0, Kit.RADIUS.M - 3), Parent = inner })
	Kit.new("UIStroke", { Thickness = 1.5, Color = WHITE, Transparency = 0.15, Parent = inner })
	-- Soft outer glow: two wider, fading strokes.
	for i, spec in { { 4, 0.55 }, { 9, 0.8 } } do
		local glow = Kit.new("Frame", {
			Name = "Glow" .. i,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, spec[1] * 2, 1, spec[1] * 2),
			Position = UDim2.fromOffset(-spec[1], -spec[1]),
			ZIndex = 49,
			Parent = frame,
		})
		Kit.new("UICorner", { CornerRadius = UDim.new(0, Kit.RADIUS.M + spec[1]), Parent = glow })
		Kit.new("UIStroke", { Thickness = spec[1], Color = C.Primary, Transparency = spec[2], Parent = glow })
	end
	selectionRing = frame
	return frame
end
Kit.SELECTION = Kit.selectionRing()

-- Makes a button navigable by gamepad with the shared ring (`on` = false opts out).
function Kit.selectable(button: GuiObject, on: boolean?)
	pcall(function()
		button.Selectable = on ~= false
		if on ~= false then
			button.SelectionImageObject = Kit.selectionRing()
		end
	end)
end

local function currentSelection(): GuiObject?
	local ok, selected = pcall(function()
		return GuiService.SelectedObject
	end)
	return if ok then selected else nil
end

local function setSelection(gui: GuiObject?)
	pcall(function()
		GuiService.SelectedObject = gui
	end)
end

function Kit.selectedIn(holder: Instance?): boolean
	local selected = currentSelection()
	return selected ~= nil and holder ~= nil and (selected == holder or selected:IsDescendantOf(holder))
end

-- Moves the selection to `gui` on gamepad only, so mouse and touch are never hijacked.
function Kit.select(gui: GuiObject?)
	if Kit.gamepad or Kit.tenFoot then
		setSelection(gui)
	end
end

local function navigable(inst: Instance): boolean
	if not inst:IsA("GuiButton") then
		return false
	end
	local ok, result = pcall(function()
		return inst.Selectable and inst.Visible and inst.AbsoluteSize.X > 0
	end)
	return ok and result == true
end

-- First visible, Selectable GuiButton under `root` (FocusFirst, then LayoutOrder,
-- then topmost-leftmost). Hidden branches are skipped.
function Kit.firstSelectable(root: Instance): GuiObject?
	local best: GuiObject? = nil
	local bestKey: { number }? = nil
	local function better(a: { number }, b: { number }?): boolean
		if b == nil then
			return true
		end
		for i = 1, #a do
			if a[i] ~= b[i] then
				return a[i] < b[i]
			end
		end
		return false
	end
	local function visit(inst: Instance)
		if inst:IsA("GuiObject") and not inst.Visible then
			return
		end
		if navigable(inst) then
			local gui = inst :: GuiObject
			local pos = gui.AbsolutePosition
			local key = {
				if gui:GetAttribute("FocusFirst") == true then 0 else 1,
				gui.LayoutOrder,
				math.floor(pos.Y),
				math.floor(pos.X),
			}
			if better(key, bestKey) then
				best, bestKey = gui, key
			end
		end
		for _, child in inst:GetChildren() do
			visit(child)
		end
	end
	for _, child in root:GetChildren() do
		visit(child)
	end
	return best
end

-- Keeps the D-pad inside `holder` (a SelectionGroup that stops at its edges).
function Kit.confine(holder: GuiObject, on: boolean?)
	pcall(function()
		holder.SelectionGroup = on ~= false
		local stop = if on ~= false then Enum.SelectionBehavior.Stop else Enum.SelectionBehavior.Escape
		holder.SelectionBehaviorUp = stop
		holder.SelectionBehaviorDown = stop
		holder.SelectionBehaviorLeft = stop
		holder.SelectionBehaviorRight = stop
	end)
end

-- Selects the first navigable button in `target` (or target itself) on gamepad;
-- nil clears the selection in every mode. `preferred` overrides the search.
function Kit.focus(target: GuiObject?, preferred: GuiObject?)
	if target == nil then
		setSelection(nil)
		return
	end
	if not (Kit.gamepad or Kit.tenFoot) then
		return
	end
	local pick = preferred
	if pick == nil then
		local ok, found = pcall(function()
			if navigable(target) then
				return target
			end
			return Kit.firstSelectable(target)
		end)
		pick = if ok then found else nil
	end
	if pick then
		setSelection(pick)
	end
end

-- Drops the selection if it is inside `container` (nil: always).
function Kit.unfocus(container: GuiObject?)
	if container == nil or Kit.selectedIn(container) then
		setSelection(nil)
	end
end
Kit.blur = Kit.unfocus

-- Colour helpers ----------------------------------------------------------------------

function Kit.lighten(color: Color3, amount: number): Color3
	return color:Lerp(WHITE, amount)
end

function Kit.darken(color: Color3, amount: number): Color3
	return color:Lerp(BLACK, amount)
end

function Kit.hex(color: Color3): string
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

-- Perceived brightness (0..1): picks ink or white text on a coloured face.
local function luminance(color: Color3): number
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end
function Kit.inkOn(color: Color3): Color3
	return if luminance(color) > 0.62 then C.GoldInk else C.Text
end

-- The darker "moulded plastic" lip under a coloured face: the named deep tone
-- for the accent colours (orange under sunny yellow), else the colour pushed
-- toward navy (never toward black).
local LIPS: { [string]: Color3 } = {
	[Kit.hex(C.Gold)] = C.GoldDeep,
	[Kit.hex(C.Cash)] = C.CashDeep,
	[Kit.hex(C.Good)] = C.CashDeep,
	[Kit.hex(C.Rizz)] = C.RizzDeep,
	[Kit.hex(C.Violet)] = C.VioletDeep,
	[Kit.hex(C.Surface)] = C.Edge,
	[Kit.hex(C.SurfaceHi)] = C.Edge,
}
function Kit.lip(color: Color3): Color3
	return LIPS[Kit.hex(color)] or color:Lerp(C.Ink, 0.42)
end

function Kit.tween(obj: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween =
		TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Tween with a start delay (stagger), same defaults as Kit.tween.
local function tweenAfter(
	obj: Instance,
	time: number,
	delay: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out, 0, false, delay)
	local tween = TweenService:Create(obj, info, props)
	tween:Play()
	return tween
end

-- Modifiers ---------------------------------------------------------------------------

function Kit.corner(parent: Instance, radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or Kit.RADIUS.M), Parent = parent })
end

function Kit.round(parent: Instance): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

--[[
	Edge stroke. On frames: a 1.5 px outline in the darker blue Edge colour (pass
	a colour to tint it). On text objects: a border stroke around the box.
]]
function Kit.stroke(parent: Instance, thickness: number?, color: Color3?): UIStroke
	local isText = parent:IsA("TextLabel") or parent:IsA("TextButton")
	return Kit.new("UIStroke", {
		Thickness = thickness or 1.5,
		Color = color or C.Edge,
		Transparency = 0.1,
		ApplyStrokeMode = if isText then Enum.ApplyStrokeMode.Border else Enum.ApplyStrokeMode.Contextual,
		Parent = parent,
	})
end

--[[
	Moulded-plastic chrome shared by panels, buttons and tab pills. Chrome
	children carry the attribute KitChrome = true so screen code can skip them
	when clearing a container.
]]
local function chrome(inst: Instance)
	inst:SetAttribute("KitChrome", true)
end

-- Thin white highlight line along the top inner edge of `parent`.
local function highlight(parent: GuiObject, radius: number, transparency: number?): Frame
	local inset = math.max(math.floor(radius * 0.75), 6)
	local line = Kit.new("Frame", {
		Name = "Highlight",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = transparency or 0.45,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -inset * 2, 0, 2),
		Position = UDim2.fromOffset(inset, 2),
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
	Kit.round(line)
	chrome(line)
	return line
end

--[[
	Darker lip that peeks out below the bottom edge of `parent` (children draw
	over their parent, so the lip is a strip whose upper part is transparent and
	only the `depth` px under the edge show). Slightly inset so it reads as the
	rounded base the panel sits on.
]]
local function lip(parent: GuiObject, radius: number, depth: number, color: Color3): Frame
	local height = radius + depth
	local inset = math.floor(radius * 0.3)
	local strip = Kit.new("Frame", {
		Name = "Lip",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -inset * 2, 0, height),
		Position = UDim2.new(0, inset, 1, depth - height),
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
	Kit.corner(strip, radius)
	local cut = math.clamp(radius / height, 0, 0.98)
	Kit.new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(cut, 1),
			NumberSequenceKeypoint.new(math.min(cut + 0.01, 0.99), 0),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = strip,
	})
	chrome(strip)
	return strip
end

-- Soft navy halo around glyphs (for text over the 3D world).
function Kit.textStroke(parent: Instance, thickness: number?, transparency: number?)
	return Kit.new("UIStroke", {
		Thickness = thickness or 1.5,
		Color = C.Ink,
		Transparency = transparency or 0.4,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function Kit.gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function Kit.padding(parent: Instance, px: number, horizontal: number?)
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, horizontal or px),
		PaddingRight = UDim.new(0, horizontal or px),
		Parent = parent,
	})
end

function Kit.list(parent: Instance, gap: number?, horizontal: boolean?, align: Enum.HorizontalAlignment?): UIListLayout
	return Kit.new("UIListLayout", {
		Padding = UDim.new(0, gap or 8),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = if horizontal then Enum.VerticalAlignment.Center else Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

--[[
	Soft navy drop shadow under `parent`: a fading strip that peeks out below
	the bottom edge (and below the lip), so it never covers the body. `offset`
	is how far below the edge it starts (the lip depth). Call after the
	UICorner is set.
]]
function Kit.shadow(parent: GuiObject, radius: number?, strength: number?, offset: number?): Frame
	local r = radius or Kit.RADIUS.L
	local s = strength or 1
	local below = offset or 0
	local height = r + below + 6 + 4 * s
	local shadow = Kit.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -math.floor(r * 0.5), 0, height),
		Position = UDim2.new(0, math.floor(r * 0.25), 1, below + 6 + 4 * s - height),
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
	Kit.corner(shadow, r)
	-- Hidden behind the body down to the lip, then a soft fade.
	local cut = math.clamp((r + below - 2) / height, 0, 0.9)
	Kit.new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(cut, 1),
			NumberSequenceKeypoint.new(math.min(cut + 0.02, 0.95), 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shadow,
	})
	chrome(shadow)
	return shadow
end

-- Text ----------------------------------------------------------------------------------

--[[
	Text. Pass TextSize for a fixed size from the type scale (preferred), or
	leave it out for TextScaled (optionally capped with MaxTextSize).
	  Font            any Theme.Fonts role (Display, UI, Bold, Body, Number)
	  Shadow = true   navy outline (only for text directly over the 3D world)
	  StrokeThickness explicit halo thickness (0 = none)
	Body text on panels gets no halo; Display text gets a faint embossed edge.
]]
function Kit.text(parent: Instance, props: { [string]: any }): TextLabel
	local fixed = props.TextSize ~= nil and props.TextScaled ~= true
	local label = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = F.Body,
		TextColor3 = C.Text,
		TextScaled = not fixed,
		TextWrapped = true,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	local maxSize = props.MaxTextSize
	local strokeThickness = props.StrokeThickness
	local shadow = props.Shadow
	for key, value in props do
		if key ~= "MaxTextSize" and key ~= "StrokeThickness" and key ~= "Shadow" then
			(label :: any)[key] = value
		end
	end
	if maxSize then
		Kit.new("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8, Parent = label })
	end
	if strokeThickness and strokeThickness > 0 then
		Kit.textStroke(label, math.clamp(strokeThickness * 0.6, 1, 2.5), 0.35)
	elseif strokeThickness == nil and shadow then
		-- Text over the 3D world: a readable navy outline.
		Kit.textStroke(label, if shadow == true then 1.8 else 1.3, 0.3)
	elseif strokeThickness == nil and label.Font == F.Display then
		-- Display titles on panels: a faint embossed edge, not an outline.
		Kit.textStroke(label, 1.4, 0.65)
	end
	return label
end

function Kit.title(parent: Instance, props: { [string]: any }): TextLabel
	props.Font = props.Font or F.Display
	return Kit.text(parent, props)
end

-- Number label (tabular, never scaled).
function Kit.number(parent: Instance, props: { [string]: any }): TextLabel
	props.Font = props.Font or F.Number
	props.TextWrapped = if props.TextWrapped == nil then false else props.TextWrapped
	return Kit.text(parent, props)
end

-- Icons ----------------------------------------------------------------------------------

-- A filled shape: frame + corner + gradient (+ optional stroke). Sizes are scales of the icon box.
local function shape(parent: Instance, props: { [string]: any }): Frame
	local color: Color3 = props.Color or C.Text
	local frame = Kit.new("Frame", {
		Name = props.Name or "Shape",
		BackgroundColor3 = color,
		BackgroundTransparency = props.Transparency or 0,
		Size = props.Size or UDim2.fromScale(0.5, 0.5),
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		Rotation = props.Rotation or 0,
		ZIndex = props.ZIndex or 1,
		ClipsDescendants = props.Clip == true,
		Parent = parent,
	})
	if props.Round then
		Kit.round(frame)
	else
		Kit.new("UICorner", { CornerRadius = UDim.new(props.RadiusScale or 0, props.Radius or 0), Parent = frame })
	end
	if props.Light ~= false and (props.Transparency or 0) == 0 then
		Kit.gradient(frame, Kit.lighten(color, props.Light or 0.28), Kit.darken(color, 0.08))
	end
	if props.Stroke then
		Kit.new("UIStroke", {
			Thickness = props.Stroke,
			Color = props.StrokeColor or color,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = frame,
		})
	end
	return frame
end

local ICONS: { [string]: (Frame, Color3) -> () } = {}
Kit.ICONS = ICONS

