	["Shop"] = { image = "rbxassetid://100180679123457", x = 408, y = 204, w = 204, h = 204 },
	["Sound"] = { image = "rbxassetid://100180679123457", x = 612, y = 204, w = 204, h = 204 },
	["Star"] = { image = "rbxassetid://100180679123457", x = 816, y = 204, w = 204, h = 204 },
	["Surge"] = { image = "rbxassetid://100180679123457", x = 0, y = 408, w = 204, h = 204 },
	["Timer"] = { image = "rbxassetid://100180679123457", x = 204, y = 408, w = 204, h = 204 },
}

local Assets = {
	Images = Images,
	Meshes = Meshes,
	Icons = Icons,
}

-- The image id for `key` (e.g. "ui/coin"), or nil when it is not uploaded; callers keep a fallback.
function Assets.image(key: string): string?
	return Images[key]
end

-- The mesh record for `key` (e.g. "props/dumbbell"), or nil when it is not uploaded.
function Assets.mesh(key: string): Mesh?
	return Meshes[key]
end

-- The atlas cell for icon `name` (e.g. "Coin"), or nil when no uploaded atlas holds it.
function Assets.icon(name: string): Icon?
	return Icons[name]
end

-- True when `key` names an uploaded image or mesh.
function Assets.has(key: string): boolean
	return Images[key] ~= nil or Meshes[key] ~= nil
end

return Assets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="155">
        <Properties>
          <string name="Name">CharacterFactory</string>
          <string name="Source"><![CDATA[--[[
	CharacterFactory: builds the unit figures from a theme "look" table.
	Used by the server (display shelves) and the client (Index / reward
	viewports). Everything is made from plain parts, so no uploaded assets are
	needed.

	Every unit is a jointed R15-style rig (15 limbs, see Poses.LIMBS). Each part
	carries a "Limb" attribute naming the limb it moves with; the model carries
	the joint pivots ("J_<Limb>"), its "RigScale", its "AnimSet" and the
	"AnimatedUnit" tag, so the client Animator can pose it. The PrimaryPart
	"Root" sits at the feet (y = 0) and the unit faces -Z.

	Look fields (all optional except the three colours):
	  skin, shirt, pants : Color3 (bots: head/forearm plating, chest, legs;
	               fans: leggings / joggers)
	  anim       : "Chad" | "Bot" | "Fan" — body style and animation set
	               (defaults to the theme's Theme.AnimSet, else "Chad")
	  material   : Enum.Material name for the body ("Metal", "Glass", ...)
	  buff       : 0..1 muscle / bulk (wider chest, thicker arms)
	  scale      : overall size multiplier (1..2; fans 0.85..0.92)
	  acc        : list of accessory names (see ACCESSORIES)
	  accColor   : Color3 for accessories
	  trim       : Color3 secondary colour (chad belt / jacket inner shirt,
	               bot joints and frame, fan shirt emblem)
	  aura       : Color3 particle aura
	  auraRate   : aura particles per second (default 10; low tiers use a faint aura)
	  sparkles   : true for a Sparkles effect
	  fire       : Color3 fire effect
	  glow       : Color3 point light
	  manual     : true to leave off the "AnimatedUnit" tag, for models that
	               code poses itself with RigPose (cutscenes)
	 Chad and Fan:
	  expr       : "Neutral" | "Smirk" | "Smug" | "Determined" | "Angry" |
	               "Happy" | "Stoic" | "Cheer" | "Starry" | "Sad" | "Shock"
	  exprs      : extra expressions to build hidden, switched with
	               CharacterFactory.setExpression(model, name)
	  hair       : Color3 (also the eyebrows)
	  hairStyle  : "Buzz" | "Flat" | "Slick" | "Quiff" | "Spiky" | "Bun" | "Bald" |
	               "Ponytail" | "Pigtails" | "Bob" | "LongHair"
	  beard      : "Stubble" | "Beard"
	  jaw        : true (or 0..1) for a wide chiselled jaw and chin
	  top        : "Tee" | "Tank" | "Shirtless" | "Jacket" | "Hoodie"
	  bottoms    : "Pants" | "Joggers" | "Shorts" | "Skirt" (fans: knee-length
	               over leggings in the pants colour)
	  shoes, sole: Color3 sneaker upper / sole
	  eyeGlow    : Color3 glowing eyes instead of pupils
	 Fan only (smaller, rounder build with big eyes):
	  skirt      : Color3 of the skirt (default accColor)
	  emblem     : "Heart" | "Star" | "Disc" shirt print in the trim colour
	  lashes     : true for eyelashes
	  blush      : false to leave off the cheek blush
	  prop       : accessory held by the fan ("FanSign" | "PomPoms" | "FoamFinger")
	  signText   : text on a FanSign (model attribute "SignText", default "#1 FAN")
	 Bot only:
	  eyes       : "Dots" | "Visor" | "Mono" | "Angry" | "Happy" | "Bars"
	  mouth      : "Grille" | "Bar" | "None"
	  faceColor  : Color3 of the LEDs (eyes, chest core)
]]

local CharacterFactory = {}

export type Look = {
	skin: Color3,
	shirt: Color3,
	pants: Color3,
	anim: string?,
	material: string?,
	buff: number?,
	scale: number?,
	acc: { string }?,
	accColor: Color3?,
	trim: Color3?,
	aura: Color3?,
	auraRate: number?,
	sparkles: boolean?,
	fire: Color3?,
	glow: Color3?,
	expr: string?,
	hair: Color3?,
	hairStyle: string?,
	beard: string?,
	jaw: (boolean | number)?,
	top: string?,
	bottoms: string?,
	shoes: Color3?,
	sole: Color3?,
	eyeGlow: Color3?,
	eyes: string?,
	mouth: string?,
	faceColor: Color3?,
	manual: boolean?,
	exprs: { string }?,
	skirt: Color3?,
	emblem: string?,
	lashes: boolean?,
	blush: boolean?,
	prop: string?,
	signText: string?,
	-- Legacy (ignored): emoji faces cannot render inside ViewportFrames.
	face: string?,
	faceFont: Enum.Font?,
}

local TAG = "AnimatedUnit"
local DETAIL = 0.16 -- parts thinner than this cast no shadow

local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local EYE_WHITE = Color3.fromRGB(248, 248, 250)
local PUPIL = Color3.fromRGB(28, 26, 34)
local MOUTH = Color3.fromRGB(96, 38, 40)
local GOLD = Color3.fromRGB(255, 200, 50)
local FACEPLATE = Color3.fromRGB(14, 16, 22)
local TONGUE = Color3.fromRGB(255, 128, 140)
local BLUSH = Color3.fromRGB(255, 168, 182)
local STAR = Color3.fromRGB(255, 212, 64) -- Theme.World.Sunny
local INK = Color3.fromRGB(58, 48, 96) -- Theme.World.Ink
local WOOD = Color3.fromRGB(222, 170, 112) -- Theme.World.Wood
local SIGN_TEXT = "#1 FAN"

local function shade(c: Color3, k: number): Color3
	return c:Lerp(BLACK, k)
end

local function tint(c: Color3, k: number): Color3
	return c:Lerp(WHITE, k)
end

local function materialFrom(name: string?): Enum.Material
	if name then
		local ok, value = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		if ok and value then
			return value
		end
	end
	return Enum.Material.SmoothPlastic
end

-- Default animation set, from the place's Theme module when there is one.
local defaultAnim: string? = nil
function CharacterFactory.setDefaultAnim(name: string)
	defaultAnim = name
end
local function themeAnim(): string
	if defaultAnim == nil then
		defaultAnim = "Chad"
		pcall(function()
			local theme = game:GetService("ReplicatedStorage"):FindFirstChild("Theme")
			if theme and theme:IsA("ModuleScript") then
				local loaded = (require :: any)(theme)
				if type(loaded) == "table" and type(loaded.AnimSet) == "string" then
					defaultAnim = loaded.AnimSet
				end
			end
		end)
	end
	return defaultAnim :: string
end

local function animOf(look: Look): string
	return look.anim or themeAnim()
end

-- Build context -------------------------------------------------------------------

type Ctx = {
	model: Model,
	look: Look,
	scale: number,
	mat: Enum.Material,
	acc: Color3,
	trim: Color3,
	isBot: boolean,
	cute: boolean, -- fan build: big eyes, no nose / ears, rounder parts
	exprTag: string?, -- expression the face parts being built belong to
	exprHidden: boolean,
	has: { [string]: boolean },
	top: number,
	parts: { [string]: BasePart },
	-- geometry (unscaled studs, model space)
	W: number,
	chestD: number,
	chestTop: number,
	chestY: number,
	waistW: number,
	hipY: number,
	A: number,
	delt: number,
	armX: number,
	shoulderY: number,
	wristY: number,
	headY: number,
	HW: number,
	HH: number,
	HD: number,
	headTop: number,
	hairTop: number,
	eyeY: number,
	led: Color3,
}

local function trackTop(c: Ctx, size: Vector3, cf: CFrame)
	local _, _, _, _, _, _, r10, r11, r12 = cf:GetComponents()
	local top = cf.Position.Y + (math.abs(r10) * size.X + math.abs(r11) * size.Y + math.abs(r12) * size.Z) / 2
	if top > c.top then
		c.top = top
	end
end

-- Adds a part to the unit. Size and CFrame are in unscaled model space.
local function add(
	c: Ctx,
	limb: string,
	name: string,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	local s = c.scale
	p.Size = size * s
	p.CFrame = if s == 1 then cf else CFrame.new(cf.Position * s) * cf.Rotation
	p.Color = color
	p.Material = material or c.mat
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if math.min(size.X, size.Y, size.Z) < DETAIL then
		p.CastShadow = false
	end
	p:SetAttribute("Limb", limb)
	if c.exprTag then
		p:SetAttribute("Expr", c.exprTag)
		if c.exprHidden then
			p.Transparency = 1
		end
	end
	p.Parent = c.model
	trackTop(c, size, cf)
	return p
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function rot(x: number, y: number, z: number, rx: number, ry: number, rz: number): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
end

local SIDES = { { 1, "Right" }, { -1, "Left" } }

local function setPivot(c: Ctx, limb: string, x: number, y: number, z: number)
	c.model:SetAttribute("J_" .. limb, Vector3.new(x, y, z))
end

-- Wedge whose right angle sits at the top-inner corner (lats under the chest).
local function underWedge(side: number): (Vector3, Vector3)
	return Vector3.new(0, 0, -side), Vector3.new(0, -1, 0)
end
-- Wedge whose right angle sits at the bottom-inner corner (traps by the neck).
local function slopeWedge(side: number): (Vector3, Vector3)
	return Vector3.new(0, 0, side), Vector3.new(0, 1, 0)
end

-- Chad and fan faces --------------------------------------------------------------

type Expr = {
	lid: number, -- eye openness 0..1 (above 1 = wide open)
	look: number, -- pupil shift (+ = unit's right)
	brow: number, -- inner-end drop in degrees (+ = angry, - = worried)
	browY: number,
	browRaise: number, -- extra lift of the unit's left brow (one raised eyebrow)
	mouth: string, -- "Flat" | "Smirk" | "Grin" | "Open" | "Big" | "Frown" | "O"
	mouthW: number,
	mouthTilt: number,
	lookY: number?, -- pupil drop (+ = looking down)
	pupil: number?, -- pupil size multiplier
	star: boolean?, -- star-shaped eyes
}

local EXPRESSIONS: { [string]: Expr } = {
	Neutral = { lid = 1, look = 0, brow = 0, browY = 0, browRaise = 0, mouth = "Flat", mouthW = 0.34, mouthTilt = 0 },
	Smirk = { lid = 0.9, look = 0, brow = 4, browY = 0, browRaise = 0.06, mouth = "Smirk", mouthW = 0.32, mouthTilt = 12 },
	Smug = { lid = 0.55, look = 0, brow = -6, browY = 0.02, browRaise = 0.03, mouth = "Smirk", mouthW = 0.34, mouthTilt = 9 },
	Determined = { lid = 0.85, look = 0, brow = 16, browY = -0.02, browRaise = 0, mouth = "Flat", mouthW = 0.28, mouthTilt = 0 },
	Angry = { lid = 0.8, look = 0, brow = 26, browY = -0.03, browRaise = 0, mouth = "Open", mouthW = 0.34, mouthTilt = 0 },
	Happy = { lid = 0.9, look = 0, brow = -8, browY = 0.04, browRaise = 0, mouth = "Grin", mouthW = 0.4, mouthTilt = 0 },
	Stoic = { lid = 0.62, look = 0.055, brow = 6, browY = -0.03, browRaise = 0, mouth = "Flat", mouthW = 0.3, mouthTilt = 0 },
	Cheer = { lid = 0.95, look = 0, brow = -10, browY = 0.06, browRaise = 0, mouth = "Big", mouthW = 0.42, mouthTilt = 0 },
	Starry = { lid = 1, look = 0, brow = -8, browY = 0.06, browRaise = 0, mouth = "Big", mouthW = 0.38, mouthTilt = 0, star = true },
	Sad = { lid = 0.7, look = 0, brow = -20, browY = 0.03, browRaise = 0, mouth = "Frown", mouthW = 0.3, mouthTilt = 0, lookY = 0.03 },
	Shock = { lid = 1.2, look = 0, brow = -10, browY = 0.1, browRaise = 0, mouth = "O", mouthW = 0.17, mouthTilt = 0, pupil = 0.7 },
}
CharacterFactory.EXPRESSIONS = EXPRESSIONS

-- Eyes, brows and mouth for one expression.
local function buildExpression(c: Ctx, expr: Expr)
	local look = c.look
	local skin = look.skin
	local hair = look.hair or Color3.fromRGB(52, 36, 26)
	local front = -c.HD / 2
	local bottom = c.headY - c.HH / 2
	local eyeY = c.eyeY
	local plain = Enum.Material.SmoothPlastic
	local cute = c.cute

	-- Eyes (hidden behind shades / visor). Fans get big round eyes with a shine.
	if not (c.has.Shades or c.has.Visor) then
		local eyeX = if cute then 0.25 else 0.24
		local eyeW = if cute then 0.27 else 0.25
		local eyeH = (if cute then 0.27 else 0.17) * expr.lid
		local pupilK = expr.pupil or 1
		for _, side in SIDES do
			local s = side[1]
			local x = s * eyeX
			if look.eyeGlow then
				add(
					c,
					"Head",
					"Eye",
					Vector3.new(0.26, 0.13 * expr.lid + 0.03, 0.05),
					at(x, eyeY, front - 0.015),
					look.eyeGlow,
					Enum.Material.Neon
				)
			elseif expr.star then
				-- Two squares turned 45 degrees apart make an eight-point star.
				for _, angle in { 0, 45 } do
					add(c, "Head", "Eye", Vector3.new(0.23, 0.23, 0.04), rot(x, eyeY, front - 0.015, 0, 0, angle), STAR, plain)
				end
				add(c, "Head", "Shine", Vector3.new(0.07, 0.07, 0.03), at(x - s * 0.04, eyeY + 0.05, front - 0.035), WHITE, plain)
			else
				add(c, "Head", "Eye", Vector3.new(eyeW, eyeH, 0.04), at(x, eyeY, front - 0.01), EYE_WHITE, plain)
				local pw = (if cute then 0.17 else 0.12) * pupilK
				local ph = (if cute then 0.22 else 0.15) * math.min(expr.lid, 1) * pupilK
				local px = x - s * 0.02 + expr.look
				local py = eyeY - 0.005 - (expr.lookY or 0)
				add(c, "Head", "Pupil", Vector3.new(pw, ph, 0.04), at(px, py, front - 0.025), PUPIL, plain)
				if cute then
					add(c, "Head", "Shine", Vector3.new(0.06, 0.06, 0.03), at(px + 0.035, py + ph * 0.25, front - 0.045), WHITE, plain)
				end
			end
			if look.lashes and not look.eyeGlow then
				local lashY = eyeY + (if expr.star then 0.1 else eyeH / 2)
				add(
					c,
					"Head",
					"Lash",
					Vector3.new(0.12, 0.05, 0.04),
					rot(x + s * eyeW * 0.5, lashY, front - 0.02, 0, 0, s * 28),
					PUPIL,
					plain
				)
			end
		end
	end
	local browColor = if look.hairStyle == "Bald" then shade(skin, 0.45) else shade(hair, 0.1)
	local browSize = if cute then Vector3.new(0.24, 0.06, 0.06) else Vector3.new(0.3, 0.075, 0.07)
	local browUp = if cute then 0.22 else 0.17
	for _, side in SIDES do
		local s = side[1]
		local lift = expr.browY + (if s < 0 then expr.browRaise else 0)
		add(c, "Head", "Brow", browSize, rot(s * 0.25, eyeY + browUp + lift, front - 0.025, 0, 0, s * expr.brow), browColor, plain)
	end

	-- Mouth.
	local mouthY = bottom + (if cute then 0.24 else 0.22)
	local mz = front - 0.03
	local w = expr.mouthW
	if expr.mouth == "Grin" then
		add(c, "Head", "Mouth", Vector3.new(w, 0.15, 0.04), at(0, mouthY - 0.02, mz), MOUTH, plain)
		add(c, "Head", "Teeth", Vector3.new(w - 0.12, 0.05, 0.04), at(0, mouthY + 0.015, mz - 0.01), EYE_WHITE, plain)
	elseif expr.mouth == "Open" then
		add(c, "Head", "Mouth", Vector3.new(w, 0.15, 0.04), at(0, mouthY - 0.01, mz), MOUTH, plain)
		add(c, "Head", "Teeth", Vector3.new(w - 0.06, 0.05, 0.04), at(0, mouthY + 0.03, mz - 0.01), EYE_WHITE, plain)
	elseif expr.mouth == "Big" then
		-- Wide open cheering smile: teeth along the top, tongue at the bottom.
		add(c, "Head", "Mouth", Vector3.new(w, 0.21, 0.04), at(0, mouthY - 0.04, mz), MOUTH, plain)
		add(c, "Head", "Teeth", Vector3.new(w - 0.08, 0.06, 0.04), at(0, mouthY + 0.03, mz - 0.01), EYE_WHITE, plain)
		add(c, "Head", "Tongue", Vector3.new(w * 0.5, 0.07, 0.04), at(0, mouthY - 0.1, mz - 0.01), TONGUE, plain)
	elseif expr.mouth == "Frown" then
		for _, side in SIDES do
			local s = side[1]
			add(
				c,
				"Head",
				"Mouth",
				Vector3.new(w / 2 + 0.03, 0.06, 0.04),
				rot(s * w / 4, mouthY - 0.02, mz, 0, 0, -s * 18),
				shade(MOUTH, 0.2),
				plain
			)
		end
	elseif expr.mouth == "O" then
		add(c, "Head", "Mouth", Vector3.new(w, w * 1.25, 0.04), at(0, mouthY - 0.03, mz), MOUTH, plain)
	elseif expr.mouth == "Smirk" then
		add(c, "Head", "Mouth", Vector3.new(w, 0.065, 0.04), rot(-0.05, mouthY, mz, 0, 0, -expr.mouthTilt), shade(MOUTH, 0.2), plain)
	else
		add(c, "Head", "Mouth", Vector3.new(w, 0.065, 0.04), at(0, mouthY, mz), shade(MOUTH, 0.2), plain)
	end
end

local GIRL_HAIR = { Ponytail = true, Pigtails = true, Bob = true, LongHair = true }

-- The longer fan hairstyles: a cap, a fringe and a back / sides / tails.
local function buildLongHair(c: Ctx, style: string, hair: Color3, hatted: boolean)
	local HW, HD, top = c.HW, c.HD, c.headTop
	local front = -HD / 2
	local back = HD / 2
	local dark = shade(hair, 0.06)
	add(c, "Head", "Hair", Vector3.new(HW + 0.08, 0.22, HD + 0.08), at(0, top + 0.04, 0.01), hair)
	if not hatted then
		add(c, "Head", "Bangs", Vector3.new(HW + 0.04, 0.2, 0.14), at(0, top - 0.09, front + 0.02), tint(hair, 0.05))
	end
	if style == "Ponytail" then
		add(c, "Head", "HairBack", Vector3.new(HW + 0.06, 0.7, 0.12), at(0, top - 0.33, back + 0.04), hair)
		local tieY = top - 0.1
		add(c, "Head", "HairTie", Vector3.one * 0.24, at(0, tieY, back + 0.14), c.acc, nil, Enum.PartType.Ball)
		add(c, "Head", "Ponytail", Vector3.new(0.36, 1.0, 0.32), rot(0, tieY - 0.48, back + 0.3, -18, 0, 0), dark)
	elseif style == "Pigtails" then
		add(c, "Head", "HairBack", Vector3.new(HW + 0.06, 0.7, 0.12), at(0, top - 0.33, back + 0.04), hair)
		for _, side in SIDES do
			local s = side[1]
			local x = s * (HW / 2 + 0.1)
			local y = c.headY + 0.14
			add(c, "Head", "HairTie", Vector3.one * 0.22, at(x, y, 0.1), c.acc, nil, Enum.PartType.Ball)
			add(c, "Head", "Pigtail", Vector3.new(0.34, 0.86, 0.34), rot(x + s * 0.12, y - 0.44, 0.12, 0, 0, s * 14), dark)
		end
	elseif style == "Bob" then
		add(c, "Head", "HairBack", Vector3.new(HW + 0.08, 0.92, 0.14), at(0, top - 0.44, back + 0.05), hair)
		for _, side in SIDES do
			local s = side[1]
			add(c, "Head", "HairSide", Vector3.new(0.14, 0.84, HD * 0.86), at(s * (HW / 2 + 0.05), top - 0.42, 0.06), hair)
		end
	else -- LongHair: down past the shoulders at the back.
		add(c, "Head", "HairBack", Vector3.new(HW + 0.1, 1.7, 0.16), at(0, top - 0.82, back + 0.06), hair)
		for _, side in SIDES do
			local s = side[1]
			add(c, "Head", "HairSide", Vector3.new(0.14, 1.2, HD * 0.8), at(s * (HW / 2 + 0.05), top - 0.58, 0.1), hair)
		end
	end
end

local function buildChadFace(c: Ctx)
	local look = c.look
	local skin = look.skin
	local hair = look.hair or Color3.fromRGB(52, 36, 26)
	local HW, HD = c.HW, c.HD
	local front = -HD / 2
	local bottom = c.headY - c.HH / 2
	local eyeY = c.eyeY
	local jawValue = look.jaw
	local jaw = if jawValue == true then 1 elseif type(jawValue) == "number" then jawValue else 0
	local plain = Enum.Material.SmoothPlastic

	if jaw > 0 then
		add(c, "Head", "Jaw", Vector3.new(HW + 0.08 * jaw, 0.4, HD - 0.1), at(0, bottom + 0.1, -0.03), shade(skin, 0.03))
		add(c, "Head", "Chin", Vector3.new(0.46, 0.24, 0.12), at(0, bottom - 0.03, front + 0.02), shade(skin, 0.04))
	end
	if c.cute then
		if look.blush ~= false then
			for _, side in SIDES do
				add(
					c,
					"Head",
					"Blush",
					Vector3.new(0.02, 0.17, 0.17),
					rot(side[1] * 0.38, eyeY - 0.2, front - 0.005, 0, 90, 0),
					BLUSH,
					plain,
					Enum.PartType.Cylinder
				)
			end
		end
	else
		-- Both ears as one block through the head (saves a part).
		add(c, "Head", "Ears", Vector3.new(HW + 0.08, 0.28, 0.22), at(0, eyeY - 0.12, 0.06), skin)
		add(c, "Head", "Nose", Vector3.new(0.16, 0.24, 0.14), at(0, eyeY - 0.17, front - 0.06), shade(skin, 0.06))
	end

	-- Eyes, brows and mouth. With `exprs`, every listed expression is built and
	-- all but the current one are hidden (see CharacterFactory.setExpression).
	local current = look.expr or (if c.cute then "Cheer" else "Neutral")
	if look.exprs and #look.exprs > 0 then
		local list = table.clone(look.exprs)
		if not table.find(list, current) then
			table.insert(list, 1, current)
		end
		for _, name in list do
			c.exprTag = name
			c.exprHidden = name ~= current
			buildExpression(c, EXPRESSIONS[name] or EXPRESSIONS.Neutral)
		end
		c.exprTag = nil
		c.exprHidden = false
		c.model:SetAttribute("Expression", current)
	else
		buildExpression(c, EXPRESSIONS[current] or EXPRESSIONS.Neutral)
	end

	-- Facial hair.
	if look.beard == "Stubble" then
		add(c, "Head", "Stubble", Vector3.new(HW * 0.84, 0.38, 0.03), at(0, bottom + 0.13, front - 0.005), shade(skin, 0.22), plain)
	elseif look.beard == "Beard" then
		add(c, "Head", "Beard", Vector3.new(HW + 0.08 + 0.1 * jaw, 0.5, HD * 0.86), at(0, bottom + 0.07, -0.08), hair)
		add(c, "Head", "Moustache", Vector3.new(0.46, 0.09, 0.06), at(0, bottom + 0.32, front - 0.04), hair)
	end

	-- Hair.
	local style = look.hairStyle or "Buzz"
	local top = c.headTop
	local hatted = c.has.Cap or c.has.CapBack or c.has.Crown or c.has.Mohawk
	if GIRL_HAIR[style] then
		buildLongHair(c, style, hair, hatted == true)
	elseif style ~= "Bald" then
		local backH = if style == "Buzz" then 0.48 else 0.62
		add(c, "Head", "HairBack", Vector3.new(HW + 0.05, backH, 0.08), at(0, top - backH / 2 + 0.02, HD / 2 + 0.03), hair)
		if hatted then
			add(c, "Head", "Hair", Vector3.new(HW + 0.04, 0.1, HD + 0.04), at(0, top + 0.02, 0), hair)
		elseif style == "Buzz" then
			add(c, "Head", "Hair", Vector3.new(HW + 0.04, 0.1, HD + 0.04), at(0, top + 0.02, 0.02), hair)
		elseif style == "Flat" then
			add(c, "Head", "Hair", Vector3.new(HW + 0.06, 0.38, HD + 0.04), at(0, top + 0.11, 0.01), hair)
		elseif style == "Slick" then
			add(c, "Head", "Hair", Vector3.new(HW + 0.06, 0.2, HD + 0.06), at(0, top + 0.05, 0.01), hair)
			add(c, "Head", "HairFront", Vector3.new(HW * 0.92, 0.14, 0.4), rot(0, top + 0.16, front + 0.22, 12, 0, 0), tint(hair, 0.08))
		elseif style == "Quiff" then
			add(c, "Head", "Hair", Vector3.new(HW + 0.05, 0.16, HD + 0.05), at(0, top + 0.03, 0.01), hair)
			add(c, "Head", "Quiff", Vector3.new(HW * 0.84, 0.36, 0.56), rot(0, top + 0.2, front + 0.26, 24, 0, 0), tint(hair, 0.06))
		elseif style == "Spiky" then
			add(c, "Head", "Hair", Vector3.new(HW + 0.05, 0.16, HD + 0.05), at(0, top + 0.03, 0.01), hair)
			local spikes = { { -0.26, -0.18, 16, -18 }, { 0.26, -0.18, 16, 18 }, { 0, 0.22, -20, 0 } }
			for _, sp in spikes do
				add(
					c,
					"Head",
					"Spike",
					Vector3.new(0.3, 0.42, 0.3),
					CFrame.new(sp[1], top + 0.2, sp[2])
						* CFrame.Angles(math.rad(sp[3]), 0, math.rad(sp[4]))
						* CFrame.Angles(0, math.rad(45), 0),
					hair
				)
			end
		elseif style == "Bun" then
			add(c, "Head", "Hair", Vector3.new(HW + 0.05, 0.16, HD + 0.05), at(0, top + 0.03, 0.01), hair)
			add(c, "Head", "Bun", Vector3.new(0.44, 0.44, 0.44), at(0, top - 0.02, HD / 2 + 0.16), hair, nil, Enum.PartType.Ball)
			if c.cute and not hatted then
				add(c, "Head", "Bangs", Vector3.new(HW + 0.04, 0.2, 0.14), at(0, top - 0.09, front + 0.02), tint(hair, 0.05))
			end
		end
	end
	c.hairTop = c.top
end

-- Chad body -----------------------------------------------------------------------

local function buildChad(c: Ctx)
	local look = c.look
	local b = math.clamp(look.buff or 0, 0, 1)
	local skin, shirt, pants = look.skin, look.shirt, look.pants
	local topStyle = look.top or "Tee"
	local bottoms = look.bottoms or "Pants"
	local shirtless = topStyle == "Shirtless"
	local sleeved = topStyle == "Jacket" or topStyle == "Hoodie"
	local torsoColor = if shirtless then skin else shirt

	local hipX = 0.4 + 0.06 * b
	local legT = 0.64 + 0.14 * b
	local hipY, kneeY, ankleY = 2.05, 1.12, 0.32
	local waistY = 2.5
	local waistW = 1.42 + 0.22 * b
	local W = 1.72 + 0.9 * b
	local chestD = 0.92 + 0.14 * b
	local A = 0.54 + 0.34 * b
	local armX = W / 2 + A / 2 - 0.06
	local shoulderY = 3.95
	local elbowY = shoulderY - 0.96
	local wristY = elbowY - 0.84
	local neckY = 4.3
	local HW, HH, HD = 1.1, 1.16, 1.06
	local headY = neckY + 0.14 + HH / 2

	c.W, c.chestD, c.chestTop, c.chestY, c.waistW, c.hipY = W, chestD, 4.21, 3.72, waistW, hipY
	c.A, c.armX, c.shoulderY, c.wristY = A, armX, shoulderY, wristY
	c.delt = A + 0.16
	c.headY, c.HW, c.HH, c.HD = headY, HW, HH, HD
	c.headTop = headY + HH / 2
	c.eyeY = headY + 0.08

	setPivot(c, "LowerTorso", 0, hipY, 0)
	setPivot(c, "UpperTorso", 0, waistY, 0)
	setPivot(c, "Head", 0, neckY, 0)

	-- Legs.
	local shoes = look.shoes or Color3.fromRGB(240, 240, 244)
	local sole = look.sole or Color3.fromRGB(250, 250, 250)
	local plainShoes = look.shoes == nil and look.sole == nil
	for _, side in SIDES do
		local s, n = side[1], side[2]
		setPivot(c, n .. "UpperLeg", s * hipX, hipY, 0)
		setPivot(c, n .. "LowerLeg", s * hipX, kneeY, 0)
		setPivot(c, n .. "Foot", s * hipX, ankleY, 0)
		if plainShoes then
			add(c, n .. "Foot", "Shoe", Vector3.new(legT + 0.08, 0.36, 1.06), at(s * hipX, 0.18, -0.15), shoes)
		else
			add(c, n .. "Foot", "Shoe", Vector3.new(legT + 0.06, 0.28, 1.02), at(s * hipX, 0.22, -0.14), shoes)
			add(c, n .. "Foot", "Sole", Vector3.new(legT + 0.1, 0.1, 1.08), at(s * hipX, 0.05, -0.15), sole)
		end
		local shin = if bottoms == "Shorts" then skin else pants
		add(
			c,
			n .. "LowerLeg",
			n .. "LowerLeg",
			Vector3.new(legT * 0.9, kneeY - ankleY + 0.04, legT * 0.92),
			at(s * hipX, (kneeY + ankleY) / 2, 0),
			shin
		)
		add(
			c,
			n .. "UpperLeg",
			n .. "UpperLeg",
			Vector3.new(legT, hipY - kneeY + 0.08, legT * 1.02),
			at(s * hipX, (hipY + kneeY) / 2, 0),
			pants
		)
	end

	-- Hips.
	local hipsW = math.max(waistW, 2 * hipX + legT) + 0.04
	local hipsD = 0.88 + 0.1 * b
	c.parts.LowerTorso = add(c, "LowerTorso", "LowerTorso", Vector3.new(hipsW, 0.58, hipsD), at(0, 2.2, 0), pants)
	if look.trim and not c.has.ChampBelt then
		add(c, "LowerTorso", "Belt", Vector3.new(hipsW + 0.04, 0.13, hipsD + 0.04), at(0, 2.43, 0), look.trim)
	end

	-- Torso: V-taper from the waist to the chest.
	add(c, "UpperTorso", "Abs", Vector3.new(waistW, 0.8, chestD * 0.9), at(0, 2.88, 0), torsoColor)
	c.parts.UpperTorso = add(c, "UpperTorso", "UpperTorso", Vector3.new(W, 0.98, chestD), at(0, 3.72, 0), torsoColor)
	local latW = (W - waistW) / 2
	if latW > 0.12 then
		for _, side in SIDES do
			local s = side[1]
			local x, y = underWedge(s)
			add(
				c,
				"UpperTorso",
				"Lat",
				Vector3.new(chestD * 0.86, 0.6, latW),
				CFrame.fromMatrix(Vector3.new(s * (waistW / 2 + latW / 2), 2.93, 0.02), x, y),
				shade(torsoColor, 0.03),
				nil,
				Enum.PartType.Wedge
			)
		end
	end
	if b >= 0.15 then
		local pecColor = if shirtless then shade(skin, 0.04) else torsoColor
		for _, side in SIDES do
			local s = side[1]
			add(c, "UpperTorso", "Pec", Vector3.new(W / 2 - 0.1, 0.44, 0.1), at(s * (W / 4 - 0.01), 3.84, -chestD / 2 - 0.03), pecColor)
		end
	end
	if shirtless and b >= 0.3 then
		-- Two rows of abs split by a centre line.
		local absZ = -chestD * 0.45 - 0.02
		for row = 0, 1 do
			add(c, "UpperTorso", "Abs", Vector3.new(0.66, 0.2, 0.06), at(0, 3.06 - row * 0.25, absZ), shade(skin, 0.07))
		end
		add(c, "UpperTorso", "AbLine", Vector3.new(0.05, 0.48, 0.07), at(0, 2.94, absZ - 0.01), shade(skin, 0.3))
	end
	if topStyle == "Jacket" then
		add(c, "UpperTorso", "InnerShirt", Vector3.new(W * 0.34, 1.7, 0.06), at(0, 3.3, -chestD / 2 - 0.0), look.trim or WHITE)
	elseif topStyle == "Hoodie" then
		add(c, "UpperTorso", "Hood", Vector3.new(W * 0.56, 0.42, 0.42), at(0, 4.2, chestD / 2 - 0.05), shade(shirt, 0.08))
	end
	local neckW = 0.46 + 0.26 * b
	add(c, "UpperTorso", "Neck", Vector3.new(neckW, 0.38, 0.48 + 0.16 * b), at(0, 4.3, 0.03), skin)
	if b >= 0.5 then
		local trapColor = if topStyle == "Tank" then skin else torsoColor
		local trapW = W / 2 - neckW / 2 - 0.12
		local trapH = 0.26 + 0.12 * b
		for _, side in SIDES do
			local s = side[1]
			local x, y = slopeWedge(s)
			add(
				c,
				"UpperTorso",
				"Trap",
				Vector3.new(0.56, trapH, trapW),
				CFrame.fromMatrix(Vector3.new(s * (neckW / 2 + trapW / 2 - 0.02), 4.2 + trapH / 2, 0.08), x, y),
				trapColor,
				nil,
				Enum.PartType.Wedge
			)
		end
	end

	-- Arms.
	local sleeveColor = if topStyle == "Tee" or sleeved then shirt else skin
	local armColor = if sleeved then shirt else skin
	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x = s * armX
		setPivot(c, n .. "UpperArm", x, shoulderY, 0)
		setPivot(c, n .. "LowerArm", x, elbowY, 0)
		setPivot(c, n .. "Hand", x, wristY, 0)
		add(c, n .. "UpperArm", "Delt", Vector3.one * c.delt, at(x, shoulderY - 0.1, 0), sleeveColor, nil, Enum.PartType.Ball)
		add(c, n .. "UpperArm", n .. "UpperArm", Vector3.new(A, 0.98, A * 0.98), at(x, shoulderY - 0.49, 0), armColor)
		if topStyle == "Tee" then
			add(c, n .. "UpperArm", "Sleeve", Vector3.new(A + 0.06, 0.32, A + 0.06), at(x, shoulderY - 0.2, 0), shirt)
		end
		if b >= 0.3 and not sleeved then
			add(c, n .. "UpperArm", "Bicep", Vector3.new(A * 0.72, 0.44, 0.2), at(x, shoulderY - 0.62, -A / 2 - 0.05), shade(skin, 0.03))
		end
		add(c, n .. "LowerArm", n .. "LowerArm", Vector3.new(A * 0.9, 0.86, A * 0.92), at(x, elbowY - 0.43, 0), armColor)
		add(c, n .. "Hand", n .. "Hand", Vector3.new(A * 0.8, 0.42, A * 0.88), at(x, wristY - 0.2, -0.02), skin)
	end

	-- Head.
	setPivot(c, "Head", 0, neckY, 0)
	c.parts.Head = add(c, "Head", "Head", Vector3.new(HW, HH, HD), at(0, headY, 0), skin)
	buildChadFace(c)
end

-- Fan body ------------------------------------------------------------------------

-- Shirt print on the chest: a heart, a star or a plain disc in the trim colour.
local function addEmblem(c: Ctx, y: number)
	local kind = c.look.emblem
	if not kind then
		return
	end
	local color = c.look.trim or WHITE
	local z = -c.chestD / 2 - 0.02
	local plain = Enum.Material.SmoothPlastic
	if kind == "Heart" then
		for _, side in SIDES do
			add(
				c,
				"UpperTorso",
				"Emblem",
				Vector3.new(0.05, 0.25, 0.25),
				rot(side[1] * 0.1, y + 0.05, z, 0, 90, 0),
				color,
				plain,
				Enum.PartType.Cylinder
			)
		end
		add(c, "UpperTorso", "Emblem", Vector3.new(0.25, 0.25, 0.05), rot(0, y - 0.05, z, 0, 0, 45), color, plain)
	elseif kind == "Star" then
		for _, angle in { 0, 45 } do
			add(c, "UpperTorso", "Emblem", Vector3.new(0.3, 0.3, 0.05), rot(0, y, z, 0, 0, angle), color, plain)
		end
	else
		add(c, "UpperTorso", "Emblem", Vector3.new(0.05, 0.4, 0.4), rot(0, y, z, 0, 90, 0), color, plain, Enum.PartType.Cylinder)
	end
end

-- A small, round, cheerful build: big head, ball hands and shoulders, sneakers.
local function buildFan(c: Ctx)
	local look = c.look
	local skin, shirt, pants = look.skin, look.shirt, look.pants
	local topStyle = if look.top == "Hoodie" then "Hoodie" else "Tee"
	local bottoms = look.bottoms or "Joggers"
	local hoodie = topStyle == "Hoodie"

	local hipX = 0.33
	local legT = 0.5
	local hipY, kneeY, ankleY = 1.8, 1.02, 0.3
	local waistY = 2.15
	local waistW = 1.22
	local W = 1.42
	local chestD = 0.8
	local A = 0.42
	local armX = W / 2 + A / 2 - 0.01
	local shoulderY = 3.28
	local elbowY = shoulderY - 0.78
	local wristY = elbowY - 0.7
	local neckY = 3.56
	local HW, HH, HD = 1.18, 1.12, 1.08
	local headY = neckY + 0.12 + HH / 2

	c.W, c.chestD, c.chestTop, c.chestY, c.waistW, c.hipY = W, chestD, 3.47, 3.05, waistW, hipY
	c.A, c.armX, c.shoulderY, c.wristY = A, armX, shoulderY, wristY
	c.delt = A + 0.1
	c.headY, c.HW, c.HH, c.HD = headY, HW, HH, HD
	c.headTop = headY + HH / 2
	c.eyeY = headY + 0.02

	setPivot(c, "LowerTorso", 0, hipY, 0)
	setPivot(c, "UpperTorso", 0, waistY, 0)
	setPivot(c, "Head", 0, neckY, 0)

	-- Legs: leggings or joggers and chunky sneakers.
	local shoes = look.shoes or WHITE
	local sole = look.sole or Color3.fromRGB(250, 250, 250)
	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x = s * hipX
		setPivot(c, n .. "UpperLeg", x, hipY, 0)
		setPivot(c, n .. "LowerLeg", x, kneeY, 0)
		setPivot(c, n .. "Foot", x, ankleY, 0)
		add(c, n .. "Foot", "Shoe", Vector3.new(legT + 0.1, 0.3, 0.9), at(x, 0.22, -0.1), shoes)
		add(c, n .. "Foot", "Sole", Vector3.new(legT + 0.14, 0.1, 0.96), at(x, 0.05, -0.11), sole)
		local shin = if bottoms == "Shorts" then skin else pants
		add(
			c,
			n .. "LowerLeg",
			n .. "LowerLeg",
			Vector3.new(legT * 0.88, kneeY - ankleY + 0.06, legT * 0.9),
			at(x, (kneeY + ankleY) / 2, 0),
			shin
		)
		if bottoms == "Joggers" then
			add(
				c,
				n .. "LowerLeg",
				"Cuff",
				Vector3.new(legT * 0.88 + 0.06, 0.14, legT * 0.9 + 0.06),
				at(x, ankleY + 0.13, 0),
				shade(pants, 0.1)
			)
		end
		add(c, n .. "UpperLeg", n .. "UpperLeg", Vector3.new(legT, hipY - kneeY + 0.08, legT), at(x, (hipY + kneeY) / 2, 0), pants)
	end

	-- Hips, and a knee-length skirt with a white hem over the leggings.
	local hipsW = 2 * hipX + legT + 0.08
	local hipsD = 0.8
	local skirt = look.skirt or look.accColor or shirt
	c.parts.LowerTorso = add(
		c,
		"LowerTorso",
		"LowerTorso",
		Vector3.new(hipsW, 0.52, hipsD),
		at(0, hipY + 0.12, 0),
		if bottoms == "Skirt" then skirt else pants
	)
	if bottoms == "Skirt" then
		add(c, "LowerTorso", "Skirt", Vector3.new(hipsW + 0.3, 0.84, hipsD + 0.24), at(0, hipY - 0.2, 0), skirt)
		add(c, "LowerTorso", "SkirtHem", Vector3.new(hipsW + 0.36, 0.12, hipsD + 0.3), at(0, hipY - 0.58, 0), WHITE)
	end

	-- Torso.
	add(c, "UpperTorso", "Waist", Vector3.new(waistW, 0.76, chestD * 0.94), at(0, 2.5, 0), shirt)
	c.parts.UpperTorso = add(c, "UpperTorso", "UpperTorso", Vector3.new(W, 0.86, chestD), at(0, 3.05, 0), shirt)
	add(c, "UpperTorso", "Neck", Vector3.new(0.36, 0.3, 0.38), at(0, neckY + 0.02, 0.02), skin)
	if hoodie then
		add(c, "UpperTorso", "Hood", Vector3.new(W * 0.62, 0.4, 0.4), at(0, 3.5, chestD / 2 - 0.02), shade(shirt, 0.08))
		add(c, "UpperTorso", "Pocket", Vector3.new(W * 0.56, 0.3, 0.06), at(0, 2.45, -chestD * 0.47 - 0.02), shade(shirt, 0.06))
	end
	addEmblem(c, 2.98)

	-- Arms: round shoulders, tee sleeves or hoodie sleeves, ball hands.
	local armColor = if hoodie then shirt else skin
	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x = s * armX
		setPivot(c, n .. "UpperArm", x, shoulderY, 0)
		setPivot(c, n .. "LowerArm", x, elbowY, 0)
		setPivot(c, n .. "Hand", x, wristY, 0)
		add(c, n .. "UpperArm", "Shoulder", Vector3.one * c.delt, at(x, shoulderY - 0.06, 0), shirt, nil, Enum.PartType.Ball)
		add(c, n .. "UpperArm", n .. "UpperArm", Vector3.new(A, 0.8, A), at(x, shoulderY - 0.4, 0), armColor)
		if not hoodie then
			add(c, n .. "UpperArm", "Sleeve", Vector3.new(A + 0.08, 0.34, A + 0.08), at(x, shoulderY - 0.2, 0), shirt)
		end
		add(c, n .. "LowerArm", n .. "LowerArm", Vector3.new(A * 0.92, 0.74, A * 0.92), at(x, elbowY - 0.36, 0), armColor)
		add(c, n .. "Hand", n .. "Hand", Vector3.one * (A + 0.06), at(x, wristY - 0.16, -0.02), skin, nil, Enum.PartType.Ball)
	end

	-- Head.
	c.parts.Head = add(c, "Head", "Head", Vector3.new(HW, HH, HD), at(0, headY, 0), skin)
	buildChadFace(c)
end

-- Bot body ------------------------------------------------------------------------

local function buildBotFace(c: Ctx)
	local look = c.look
	local HW, HD, headY = c.HW, c.HD, c.headY
	local front = -HD / 2
	local led = c.led
	local neon = Enum.Material.Neon
	local plain = Enum.Material.SmoothPlastic
	local eyeY = c.eyeY
	local z = front - 0.06

	add(c, "Head", "Faceplate", Vector3.new(HW - 0.18, 0.58, 0.06), at(0, headY + 0.06, front - 0.02), FACEPLATE, plain)
	local eyes = look.eyes or "Dots"
	if c.has.Visor then
		eyes = "None"
	end
	if eyes == "Visor" then
		add(c, "Head", "Eye", Vector3.new(HW - 0.36, 0.15, 0.04), at(0, eyeY, z), led, neon)
	elseif eyes == "Mono" then
		add(c, "Head", "Eye", Vector3.new(0.04, 0.36, 0.36), rot(0, eyeY - 0.02, z, 0, 90, 0), led, neon, Enum.PartType.Cylinder)
		-- A bright lens gets a dark iris, a coloured one a white-hot core.
		local bright = led.R + led.G + led.B > 2.4
		local core = if bright then FACEPLATE else WHITE
		add(
			c,
			"Head",
			"Pupil",
			Vector3.new(0.04, 0.14, 0.14),
			rot(0, eyeY - 0.02, z - 0.02, 0, 90, 0),
			core,
			if bright then plain else neon,
			Enum.PartType.Cylinder
		)
	elseif eyes ~= "None" then
		for _, side in SIDES do
			local s = side[1]
			local x = s * 0.26
			if eyes == "Angry" then
				add(c, "Head", "Eye", Vector3.new(0.3, 0.1, 0.04), rot(x, eyeY, z, 0, 0, s * 18), led, neon)
			elseif eyes == "Happy" then
				add(c, "Head", "Eye", Vector3.new(0.17, 0.06, 0.04), rot(x - 0.06, eyeY, z, 0, 0, 35), led, neon)
				add(c, "Head", "Eye", Vector3.new(0.17, 0.06, 0.04), rot(x + 0.06, eyeY, z, 0, 0, -35), led, neon)
			elseif eyes == "Bars" then
				add(c, "Head", "Eye", Vector3.new(0.3, 0.08, 0.04), at(x, eyeY, z), led, neon)
			else
				add(c, "Head", "Eye", Vector3.new(0.04, 0.22, 0.22), rot(x, eyeY, z, 0, 90, 0), led, neon, Enum.PartType.Cylinder)
			end
		end
	end
	local mouth = look.mouth or "Grille"
	if mouth == "Grille" then
		for row = 0, 2 do
			add(
				c,
				"Head",
				"Grille",
				Vector3.new(0.46, 0.045, 0.04),
				at(0, headY - 0.3 - row * 0.085, front - 0.01),
				shade(c.trim, 0.3),
				plain
			)
		end
	elseif mouth == "Bar" then
		add(c, "Head", "Mouth", Vector3.new(0.42, 0.06, 0.04), at(0, headY - 0.14, z), led, neon)
	end
	-- Both ear bolts as one cylinder through the head.
	add(c, "Head", "EarBolts", Vector3.new(HW + 0.14, 0.38, 0.38), at(0, headY, 0), c.trim, Enum.Material.Metal, Enum.PartType.Cylinder)
	if not c.has.Mohawk then
		add(c, "Head", "Crest", Vector3.new(0.2, 0.12, HD * 0.78), at(0, c.headTop + 0.05, 0.02), shade(look.skin, 0.15))
	end
	c.hairTop = c.top
end

local function buildBot(c: Ctx)
	local look = c.look
	local b = math.clamp(look.buff or 0, 0, 1)
	local skin, shirt, pants, trim = look.skin, look.shirt, look.pants, c.trim
	local metal = Enum.Material.Metal
	local plain = Enum.Material.SmoothPlastic

	local hipX = 0.46 + 0.06 * b
	local legT = 0.56 + 0.1 * b
	local hipY, kneeY, ankleY = 2.1, 1.22, 0.4
	local waistY = 2.45
	local W = 1.85 + 0.75 * b
	local chestD = 1.05 + 0.15 * b
	local A = 0.55 + 0.3 * b
	local armX = W / 2 + 0.3 + 0.12 * b
	local shoulderY = 3.8
	local elbowY, wristY = 2.98, 2.16
	local neckY = 4.12
	local HW, HH, HD = 1.28, 1.0, 1.12
	local headY = neckY + 0.12 + HH / 2

	c.W, c.chestD, c.chestTop, c.chestY, c.waistW, c.hipY = W, chestD, 4.05, 3.4, 1.4, hipY
	c.A, c.armX, c.shoulderY, c.wristY = A, armX, shoulderY, wristY
	c.delt = 0.62 + 0.12 * b
	c.headY, c.HW, c.HH, c.HD = headY, HW, HH, HD
	c.headTop = headY + HH / 2
	c.eyeY = headY + 0.1

	setPivot(c, "LowerTorso", 0, hipY, 0)
	setPivot(c, "UpperTorso", 0, waistY, 0)
	setPivot(c, "Head", 0, neckY, 0)

	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x = s * hipX
		setPivot(c, n .. "UpperLeg", x, hipY, 0)
		setPivot(c, n .. "LowerLeg", x, kneeY, 0)
		setPivot(c, n .. "Foot", x, ankleY, 0)
		add(c, n .. "Foot", "Boot", Vector3.new(legT + 0.2, 0.4, 1.1), at(x, 0.2, -0.12), trim, metal)
		add(c, n .. "Foot", "ToeCap", Vector3.new(legT + 0.12, 0.14, 0.42), at(x, 0.42, -0.44), pants)
		add(c, n .. "LowerLeg", n .. "LowerLeg", Vector3.new(legT + 0.08, 0.86, legT + 0.14), at(x, 0.8, -0.02), pants)
		add(c, n .. "LowerLeg", "Knee", Vector3.one * (legT * 0.8), at(x, kneeY, 0), trim, metal, Enum.PartType.Ball)
		add(c, n .. "UpperLeg", n .. "UpperLeg", Vector3.new(legT * 0.78, 0.86, legT * 0.78), at(x, 1.66, 0), trim, metal)
	end

	c.parts.LowerTorso = add(c, "LowerTorso", "LowerTorso", Vector3.new(2 * hipX + legT * 0.8 + 0.12, 0.52, 0.86), at(0, 2.2, 0), pants)
	add(c, "UpperTorso", "Waist", Vector3.new(0.44, 0.95, 0.95), rot(0, 2.6, 0, 0, 0, 90), trim, metal, Enum.PartType.Cylinder)
	c.parts.UpperTorso = add(c, "UpperTorso", "UpperTorso", Vector3.new(W, 1.3, chestD), at(0, 3.4, 0), shirt)
	add(c, "UpperTorso", "ChestPlate", Vector3.new(W * 0.64, 0.74, 0.1), at(0, 3.5, -chestD / 2 - 0.04), skin)
	add(
		c,
		"UpperTorso",
		"Core",
		Vector3.new(0.1, 0.44, 0.44),
		rot(0, 3.5, -chestD / 2 - 0.12, 0, 90, 0),
		c.led,
		Enum.Material.Neon,
		Enum.PartType.Cylinder
	)
	add(c, "UpperTorso", "Vent", Vector3.new(W * 0.44, 0.16, 0.05), at(0, 2.96, -chestD / 2 - 0.01), shade(trim, 0.35), plain)
	for _, side in SIDES do
		add(
			c,
			"UpperTorso",
			"Bolt",
			Vector3.one * 0.12,
			at(side[1] * W * 0.28, 3.8, -chestD / 2 - 0.1),
			tint(trim, 0.3),
			metal,
			Enum.PartType.Ball
		)
	end
	add(c, "UpperTorso", "Neck", Vector3.new(0.34, 0.5, 0.5), rot(0, 4.15, 0, 0, 0, 90), trim, metal, Enum.PartType.Cylinder)

	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x = s * armX
		setPivot(c, n .. "UpperArm", x, shoulderY, 0)
		setPivot(c, n .. "LowerArm", x, elbowY, 0)
		setPivot(c, n .. "Hand", x, wristY, 0)
		add(c, n .. "UpperArm", "ShoulderJoint", Vector3.one * c.delt, at(x, shoulderY, 0), trim, metal, Enum.PartType.Ball)
		add(c, n .. "UpperArm", n .. "UpperArm", Vector3.new(0.36, 0.84, 0.36), at(x, shoulderY - 0.42, 0), trim, metal)
		add(c, n .. "LowerArm", "Elbow", Vector3.one * 0.48, at(x, elbowY, 0), trim, metal, Enum.PartType.Ball)
		add(c, n .. "LowerArm", n .. "LowerArm", Vector3.new(A, 0.78, A + 0.04), at(x, elbowY - 0.42, 0), skin)
		add(c, n .. "Hand", n .. "Hand", Vector3.new(0.42 + 0.1 * b, 0.36, 0.5), at(x, wristY - 0.2, -0.02), trim, metal)
	end

	c.parts.Head = add(c, "Head", "Head", Vector3.new(HW, HH, HD), at(0, headY, 0), skin)
	buildBotFace(c)
end

-- Accessories ---------------------------------------------------------------------

local ACCESSORIES: { [string]: (Ctx) -> () } = {}

local function capCrown(c: Ctx): number
	local y = c.headTop + 0.06
	add(c, "Head", "Cap", Vector3.new(c.HW + 0.1, 0.3, c.HD + 0.1), at(0, y, 0), c.acc, Enum.Material.SmoothPlastic)
	return y
end

ACCESSORIES.Cap = function(c)
	local y = capCrown(c)
	add(
		c,
		"Head",
		"Brim",
		Vector3.new(c.HW * 0.92, 0.07, 0.56),
		rot(0, y - 0.12, -c.HD / 2 - 0.22, -6, 0, 0),
		shade(c.acc, 0.15),
		Enum.Material.SmoothPlastic
	)
end

ACCESSORIES.CapBack = function(c)
	local y = capCrown(c)
	add(
		c,
		"Head",
		"Brim",
		Vector3.new(c.HW * 0.92, 0.07, 0.5),
		rot(0, y - 0.1, c.HD / 2 + 0.2, 8, 0, 0),
		shade(c.acc, 0.15),
		Enum.Material.SmoothPlastic
	)
end

ACCESSORIES.Headband = function(c)
	if c.cute then
		-- Fans: a hair band over the crown from ear to ear.
		local top = c.headTop
		add(c, "Head", "Headband", Vector3.new(c.HW + 0.2, 0.12, 0.22), at(0, top + 0.2, -0.14), c.acc)
		for _, side in SIDES do
			add(c, "Head", "BandSide", Vector3.new(0.12, 0.5, 0.22), at(side[1] * (c.HW / 2 + 0.14), top - 0.06, -0.14), c.acc)
		end
		return
	end
	local y = if c.isBot then c.headTop - 0.16 else c.eyeY + 0.36
	add(c, "Head", "Headband", Vector3.new(c.HW + 0.08, 0.16, c.HD + 0.08), at(0, y, 0), c.acc, Enum.Material.Fabric)
	add(c, "Head", "BandTail", Vector3.new(0.16, 0.42, 0.05), rot(0.12, y - 0.2, c.HD / 2 + 0.07, 0, 0, 18), c.acc, Enum.Material.Fabric)
end

ACCESSORIES.Shades = function(c)
	local front = -c.HD / 2
	local lens = Color3.fromRGB(16, 16, 22)
	add(c, "Head", "Shades", Vector3.new(c.HW + 0.04, 0.07, 0.07), at(0, c.eyeY + 0.09, front - 0.04), BLACK, Enum.Material.SmoothPlastic)
	for _, side in SIDES do
		add(
			c,
			"Head",
			"Lens",
			Vector3.new(0.42, 0.22, 0.06),
			at(side[1] * 0.25, c.eyeY - 0.02, front - 0.05),
			lens,
			Enum.Material.SmoothPlastic
		)
	end
	add(c, "Head", "Glint", Vector3.new(0.1, 0.05, 0.02), rot(0.32, c.eyeY + 0.02, front - 0.085, 0, 0, 25), WHITE, Enum.Material.Neon)
end

ACCESSORIES.Visor = function(c)
	local front = -c.HD / 2
	add(c, "Head", "Visor", Vector3.new(c.HW + 0.06, 0.22, 0.1), at(0, c.eyeY, front - 0.06), c.acc, Enum.Material.Neon)
	add(
		c,
		"Head",
		"VisorBand",
		Vector3.new(c.HW + 0.08, 0.08, c.HD + 0.08),
		at(0, c.eyeY + 0.14, 0),
		Color3.fromRGB(30, 30, 36),
		Enum.Material.Metal
	)
end

ACCESSORIES.Chain = function(c)
	local front = -c.chestD / 2 - (if c.isBot then 0.13 else 0.1)
	local top = c.chestTop - 0.02
	for _, side in SIDES do
		local s = side[1]
		add(
			c,
			"UpperTorso",
			"Chain",
			Vector3.new(0.08, 0.7, 0.08),
			rot(s * 0.19, top - 0.3, front, 0, 0, s * 32),
			GOLD,
			Enum.Material.Metal
		)
	end
	add(
		c,
		"UpperTorso",
		"Medal",
		Vector3.new(0.08, 0.38, 0.38),
		rot(0, top - 0.7, front - 0.02, 0, 90, 0),
		GOLD,
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
end

ACCESSORIES.Crown = function(c)
	local y = c.hairTop - 0.04
	local gold = c.acc
	add(c, "Head", "Crown", Vector3.new(c.HW + 0.14, 0.28, c.HD + 0.14), at(0, y + 0.1, 0), gold, Enum.Material.Metal)
	local w, d = (c.HW + 0.14) / 2 - 0.1, (c.HD + 0.14) / 2 - 0.1
	for _, corner in { { -w, -d }, { w, -d }, { 0, d } } do
		add(c, "Head", "CrownPoint", Vector3.new(0.2, 0.32, 0.2), rot(corner[1], y + 0.36, corner[2], 0, 45, 0), gold, Enum.Material.Metal)
	end
	add(
		c,
		"Head",
		"CrownGem",
		Vector3.new(0.16, 0.16, 0.05),
		rot(0, y + 0.1, -(c.HD + 0.14) / 2 - 0.02, 0, 0, 45),
		Color3.fromRGB(255, 40, 90),
		Enum.Material.Neon
	)
end

ACCESSORIES.Halo = function(c)
	local y = c.hairTop + (if c.has.Crown then 0.78 else 0.42)
	local r = 0.62
	for i = 0, 5 do
		local angle = i * 60
		local a = math.rad(angle)
		add(
			c,
			"Head",
			"Halo",
			Vector3.new(0.74, 0.09, 0.12),
			rot(math.sin(a) * r, y, math.cos(a) * r, 0, angle, 0),
			c.acc,
			Enum.Material.Neon
		)
	end
end

ACCESSORIES.Horns = function(c)
	local y = c.headTop
	for _, side in SIDES do
		local s = side[1]
		local x = s * (c.HW / 2 - 0.12)
		add(
			c,
			"Head",
			"Horn",
			Vector3.new(0.24, 0.4, 0.24),
			rot(x + s * 0.06, y + 0.14, -0.1, 0, 0, -s * 28),
			shade(c.acc, 0.2),
			Enum.Material.SmoothPlastic
		)
		add(c, "Head", "HornTip", Vector3.new(0.15, 0.36, 0.15), rot(x + s * 0.12, y + 0.44, -0.1, 0, 0, s * 8), c.acc, Enum.Material.Neon)
	end
end

ACCESSORIES.Antenna = function(c)
	local y = c.hairTop
	local x = if c.isBot then c.HW / 2 - 0.2 else 0
	add(c, "Head", "AntennaRod", Vector3.new(0.08, 0.8, 0.08), at(x, y + 0.38, 0.1), Color3.fromRGB(80, 80, 90), Enum.Material.Metal)
	add(c, "Head", "AntennaTip", Vector3.one * 0.26, at(x, y + 0.82, 0.1), c.acc, Enum.Material.Neon, Enum.PartType.Ball)
end

ACCESSORIES.Mohawk = function(c)
	local y = c.headTop
	add(c, "Head", "Mohawk", Vector3.new(0.18, 0.34, c.HD * 0.8), at(0, y + 0.15, 0.06), c.acc)
	add(c, "Head", "MohawkFront", Vector3.new(0.18, 0.38, 0.32), rot(0, y + 0.28, -c.HD / 2 + 0.16, 26, 0, 0), c.acc)
end

ACCESSORIES.Headphones = function(c)
	local y = c.hairTop
	add(
		c,
		"Head",
		"Headband",
		Vector3.new(c.HW + 0.22, 0.1, 0.18),
		at(0, y + 0.03, 0.04),
		Color3.fromRGB(30, 30, 36),
		Enum.Material.SmoothPlastic
	)
	for _, side in SIDES do
		local s = side[1]
		add(
			c,
			"Head",
			"EarCup",
			Vector3.new(0.2, 0.5, 0.5),
			at(s * (c.HW / 2 + 0.1), c.eyeY - 0.12, 0.04),
			c.acc,
			Enum.Material.SmoothPlastic,
			Enum.PartType.Cylinder
		)
	end
end

ACCESSORIES.Cape = function(c)
	local back = c.chestD / 2
	add(
		c,
		"UpperTorso",
		"CapeCollar",
		Vector3.new(c.W + 0.12, 0.26, 0.34),
		at(0, c.chestTop - 0.02, back),
		shade(c.acc, 0.15),
		Enum.Material.Fabric
	)
	add(
		c,
		"UpperTorso",
		"Cape",
		Vector3.new(c.W * 0.94, 2.8, 0.08),
		rot(0, c.chestTop - 1.42, back + 0.3, -9, 0, 0),
		c.acc,
		Enum.Material.Fabric
	)
end

ACCESSORIES.Wings = function(c)
	local back = c.chestD / 2 + 0.2
	local y = c.chestTop - 0.2
	for _, side in SIDES do
		local s = side[1]
		local feathers = { { 2.5, 0.9, 28, 0, 0 }, { 1.9, 0.82, 2, -0.5, 0.25 } }
		for _, f in feathers do
			local length, height, angle, drop = f[1], f[2], f[3], f[4]
			local a = math.rad(angle)
			local cx = s * (0.3 + math.cos(a) * length / 2)
			local cy = y + drop + math.sin(a) * length / 2
			local p = add(
				c,
				"UpperTorso",
				"Wing",
				Vector3.new(length, height, 0.08),
				CFrame.new(cx, cy, back) * CFrame.Angles(0, math.rad(-s * 18), math.rad(s * angle)),
				tint(c.acc, f[5]),
				Enum.Material.Neon
			)
			p.Transparency = 0.15
		end
	end
end

ACCESSORIES.Backpack = function(c)
	local back = c.chestD / 2
	add(c, "UpperTorso", "Pack", Vector3.new(c.W * 0.6, 1.2, 0.56), at(0, c.chestY - 0.15, back + 0.26), c.acc, Enum.Material.Metal)
	add(
		c,
		"UpperTorso",
		"PackFlap",
		Vector3.new(c.W * 0.62, 0.3, 0.62),
		at(0, c.chestY + 0.38, back + 0.26),
		shade(c.acc, 0.25),
		Enum.Material.Metal
	)
end

ACCESSORIES.Jetpack = function(c)
	local back = c.chestD / 2
	add(
		c,
		"UpperTorso",
		"Jetpack",
		Vector3.new(c.W * 0.56, 1.1, 0.5),
		at(0, c.chestY - 0.1, back + 0.24),
		Color3.fromRGB(70, 74, 84),
		Enum.Material.Metal
	)
	for _, side in SIDES do
		local x = side[1] * c.W * 0.2
		add(
			c,
			"UpperTorso",
			"Thruster",
			Vector3.new(0.6, 0.38, 0.38),
			rot(x, c.chestY - 0.75, back + 0.3, 0, 0, 90),
			c.acc,
			Enum.Material.Metal,
			Enum.PartType.Cylinder
		)
		add(
			c,
			"UpperTorso",
			"Flame",
			Vector3.one * 0.3,
			at(x, c.chestY - 1.12, back + 0.3),
			Color3.fromRGB(255, 170, 60),
			Enum.Material.Neon,
			Enum.PartType.Ball
		)
	end
end

-- Pauldrons: a top plate plus a side plate hanging over the upper arm.
ACCESSORIES.Shoulders = function(c)
	local size = c.delt + 0.26
	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x = s * (c.armX + 0.04)
		local top = Vector3.new(size, 0.3, size)
		add(c, n .. "UpperArm", "Pad", top, rot(x, c.shoulderY + 0.2, 0, 0, 0, -s * 12), c.acc, Enum.Material.Metal)
		local plate = Vector3.new(0.14, 0.62, size - 0.08)
		local px = x + s * (size / 2 - 0.02)
		add(c, n .. "UpperArm", "PadSide", plate, rot(px, c.shoulderY - 0.14, 0, 0, 0, -s * 12), shade(c.acc, 0.25), Enum.Material.Metal)
	end
end

ACCESSORIES.Dumbbell = function(c)
	local x = c.armX
	local y = c.wristY - 0.2
	local iron = Color3.fromRGB(45, 45, 52)
	add(
		c,
		"RightHand",
		"DumbbellBar",
		Vector3.new(1.0, 0.12, 0.12),
		rot(x, y, -0.02, 0, 90, 0),
		Color3.fromRGB(180, 180, 190),
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	for _, z in { -0.42, 0.38 } do
		add(
			c,
			"RightHand",
			"DumbbellPlate",
			Vector3.new(0.16, 0.56, 0.56),
			rot(x, y, z, 0, 90, 0),
			iron,
			Enum.Material.Metal,
			Enum.PartType.Cylinder
		)
	end
end

ACCESSORIES.Towel = function(c)
	local x = -(c.W / 2 - 0.35)
	local towel = c.acc
	add(c, "UpperTorso", "Towel", Vector3.new(0.5, 0.12, c.chestD + 0.16), at(x, c.chestTop + 0.04, 0), towel, Enum.Material.Fabric)
	add(
		c,
		"UpperTorso",
		"TowelEnd",
		Vector3.new(0.48, 0.9, 0.08),
		at(x, c.chestTop - 0.4, -c.chestD / 2 - 0.12),
		towel,
		Enum.Material.Fabric
	)
end

ACCESSORIES.Wristbands = function(c)
	for _, side in SIDES do
		local s, n = side[1], side[2]
		add(
			c,
			n .. "LowerArm",
			"Wristband",
			Vector3.new(c.A * 0.98, 0.18, c.A),
			at(s * c.armX, c.wristY + 0.12, 0),
			c.acc,
			Enum.Material.Fabric
		)
	end
end

ACCESSORIES.ChampBelt = function(c)
	local d = (if c.isBot then 0.86 else 0.92) + 0.06
	local w = math.max(c.waistW, 1.5) + 0.26
	add(c, "LowerTorso", "Belt", Vector3.new(w, 0.26, d), at(0, 2.4, 0), Color3.fromRGB(30, 26, 22), Enum.Material.Fabric)
	add(c, "LowerTorso", "BeltPlate", Vector3.new(0.66, 0.44, 0.08), at(0, 2.4, -d / 2 - 0.03), c.acc, Enum.Material.Metal)
end

ACCESSORIES.Cannon = function(c)
	local x = c.armX
	local dark = Color3.fromRGB(50, 52, 60)
	add(c, "RightLowerArm", "CannonHousing", Vector3.new(c.A + 0.16, 0.56, c.A + 0.2), at(x, c.wristY + 0.36, 0), dark, Enum.Material.Metal)
	add(
		c,
		"RightLowerArm",
		"CannonBarrel",
		Vector3.new(0.9, 0.42, 0.42),
		rot(x, c.wristY - 0.1, 0, 0, 0, 90),
		dark,
		Enum.Material.Metal,
		Enum.PartType.Cylinder
	)
	add(
		c,
		"RightLowerArm",
		"CannonMuzzle",
		Vector3.new(0.08, 0.34, 0.34),
		rot(x, c.wristY - 0.58, 0, 0, 0, 90),
		c.acc,
		Enum.Material.Neon,
		Enum.PartType.Cylinder
	)
end

-- Fan accessories -----------------------------------------------------------------

-- A bow on the top right of the head.
ACCESSORIES.Bow = function(c)
	local x = c.HW * 0.28
	local y = c.headTop + 0.16
	local z = -0.12
	local plain = Enum.Material.SmoothPlastic
	for _, side in SIDES do
		local s = side[1]
		add(c, "Head", "Bow", Vector3.new(0.3, 0.26, 0.12), rot(x + s * 0.17, y, z, 0, 0, s * 15), c.acc, plain)
	end
	add(c, "Head", "BowKnot", Vector3.new(0.14, 0.16, 0.15), at(x, y, z), shade(c.acc, 0.12), plain)
end

local function signLabel(card: BasePart, face: Enum.NormalId, text: string): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.MaxDistance = 120
	gui.Parent = card
	local label = Instance.new("TextLabel")
	label.Name = "SignText"
	label.BackgroundTransparency = 1
	-- (The Lune unit-test environment has no UDim2.)
	if UDim2 ~= nil then
		label.Position = UDim2.fromScale(0.05, 0.27)
		label.Size = UDim2.fromScale(0.9, 0.66)
	end
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = INK
	label.Text = text
	label.Parent = gui
	return label
end

-- A white card with a coloured header band on a wooden stick, held in the
-- right hand. The text (both faces) is the model's "SignText" attribute.
ACCESSORIES.FanSign = function(c)
	local x = c.armX + c.A / 2 + 0.08
	local bottom = c.wristY - 0.48
	local stick = 2.1
	local cardW, cardH = 1.6, 1.05
	local cx = x + 0.35
	local cy = bottom + stick + cardH / 2 - 0.12
	local plain = Enum.Material.SmoothPlastic
	add(c, "RightHand", "SignStick", Vector3.new(0.1, stick, 0.1), at(x, bottom + stick / 2, 0), WOOD, plain)
	local card = add(c, "RightHand", "SignCard", Vector3.new(cardW, cardH, 0.1), at(cx, cy, 0), WHITE, plain)
	add(c, "RightHand", "SignHeader", Vector3.new(cardW + 0.02, 0.24, 0.12), at(cx, cy + cardH / 2 - 0.12, 0), c.acc, plain)
	local text = c.look.signText or SIGN_TEXT
	c.model:SetAttribute("SignText", text)
	local labels = { signLabel(card, Enum.NormalId.Front, text), signLabel(card, Enum.NormalId.Back, text) }
	-- Keep the text in sync with the attribute (no signals under Lune, hence pcall).
	local model = c.model
	pcall(function()
		model:GetAttributeChangedSignal("SignText"):Connect(function()
			local value = model:GetAttribute("SignText")
			for _, label in labels do
				label.Text = if type(value) == "string" then value else SIGN_TEXT
			end
		end)
	end)
end

-- Fluffy pom-poms in both hands.
ACCESSORIES.PomPoms = function(c)
	for _, side in SIDES do
		local s, n = side[1], side[2]
		local x, y = s * c.armX, c.wristY - 0.2
		add(c, n .. "Hand", "PomPom", Vector3.one * 0.8, at(x, y - 0.1, -0.04), c.acc, Enum.Material.Fabric, Enum.PartType.Ball)
		add(
			c,
			n .. "Hand",
			"PomPomPuff",
			Vector3.one * 0.5,
			at(x + s * 0.2, y - 0.4, -0.2),
			tint(c.acc, 0.4),
			Enum.Material.Fabric,
			Enum.PartType.Ball
		)
	end
end

-- A big foam "#1" hand on the right hand, index finger out along the arm.
ACCESSORIES.FoamFinger = function(c)
	local x, y = c.armX, c.wristY - 0.2
	local plain = Enum.Material.SmoothPlastic
	add(c, "RightHand", "FoamPalm", Vector3.new(0.66, 0.62, 0.38), at(x, y - 0.12, -0.02), c.acc, plain)
	add(c, "RightHand", "FoamFinger", Vector3.new(0.24, 0.8, 0.26), at(x - 0.15, y - 0.8, -0.02), c.acc, plain)
	add(c, "RightHand", "FoamThumb", Vector3.new(0.22, 0.36, 0.24), rot(x - 0.38, y - 0.2, -0.06, 0, 0, -30), shade(c.acc, 0.06), plain)
end

CharacterFactory.ACCESSORIES = ACCESSORIES

-- Effects -------------------------------------------------------------------------

local function addEffects(c: Ctx)
	local look = c.look
	local chest = c.parts.UpperTorso
	local s = c.scale
	if look.aura then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Aura"
		emitter.Color = ColorSequence.new(look.aura)
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6 * s),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.8, 1.4)
		emitter.Rate = look.auraRate or 10
		emitter.Speed = NumberRange.new(1.5 * s, 3 * s)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, 3, 0)
		emitter.Parent = chest
	end
	if look.sparkles then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = look.aura or Color3.new(1, 1, 1)
		sparkles.Parent = chest
	end
	if look.fire then
		local fire = Instance.new("Fire")
		fire.Color = look.fire
		fire.SecondaryColor = Color3.new(1, 1, 1)
		fire.Size = 4 * s
		fire.Heat = 6
		fire.Parent = chest
	end
	if look.glow or look.aura then
		local light = Instance.new("PointLight")
		light.Color = look.glow or look.aura :: Color3
		-- Faint auras (low tiers) get a dimmer, smaller light.
		local strength = if look.glow then 1 else math.clamp((look.auraRate or 10) / 10, 0.35, 1)
		light.Brightness = 1.5 * strength
		light.Range = (5 + 3 * strength) * s
		light.Parent = chest
	end
end

-- Build ---------------------------------------------------------------------------

-- Builds a model standing on y = 0 at the origin, facing -Z. Its PrimaryPart
-- "Root" is at the feet, so model:PivotTo(CFrame) places the feet.
function CharacterFactory.build(look: Look, name: string?): Model
	local model = Instance.new("Model")
	model.Name = name or "Unit"
	local anim = animOf(look)
	local scale = look.scale or 1

	local accList: { string } = table.clone(look.acc or {})
	if look.prop and not table.find(accList, look.prop) then
		table.insert(accList, look.prop)
	end
	local has: { [string]: boolean } = {}
	for _, accName in accList do
		has[accName] = true
	end

	local c: Ctx = {
		model = model,
		look = look,
		scale = scale,
		mat = materialFrom(look.material),
		acc = look.accColor or Color3.fromRGB(255, 205, 60),
		trim = look.trim or Color3.fromRGB(58, 62, 72),
		isBot = anim == "Bot",
		cute = anim == "Fan",
		exprTag = nil,
		exprHidden = false,
		has = has,
		top = 0,
		parts = {},
		W = 2,
		chestD = 1,
		chestTop = 4,
		chestY = 3.5,
		waistW = 1.5,
		hipY = 2,
		A = 0.6,
		delt = 0.7,
		armX = 1.3,
		shoulderY = 3.9,
		wristY = 2.1,
		headY = 5,
		HW = 1.1,
		HH = 1.1,
		HD = 1.1,
		headTop = 5.6,
		hairTop = 5.6,
		eyeY = 5.1,
		led = look.faceColor or Color3.fromRGB(0, 220, 255),
	}

	-- Root sits at the feet so PivotTo keeps the unit standing on the floor.
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.Parent = model
	model.PrimaryPart = root

	if c.isBot then
		buildBot(c)
	elseif c.cute then
		buildFan(c)
	else
		buildChad(c)
	end
	for _, accName in accList do
		local builder = ACCESSORIES[accName]
		if builder then
			builder(c)
		end
	end
	addEffects(c)

	model:SetAttribute("RigScale", scale)
	model:SetAttribute("AnimSet", anim)
	model:SetAttribute("Height", c.top * scale)
	if not look.manual then
		model:AddTag(TAG)
	end
	return model
end

-- Shows one of the expressions a model was built with (look.exprs) and hides
-- the others. Returns false if the model has no such expression.
function CharacterFactory.setExpression(model: Model, name: string): boolean
	local found = false
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("Expr") == name then
			found = true
			break
		end
	end
	if not found then
		return false
	end
	for _, d in model:GetDescendants() do
		local tag = d:GetAttribute("Expr")
		if tag ~= nil and d:IsA("BasePart") then
			d.Transparency = if tag == name then 0 else 1
		end
	end
	model:SetAttribute("Expression", name)
	return true
end

-- Changes the text on a model's FanSign (both faces).
function CharacterFactory.setSignText(model: Model, text: string)
	model:SetAttribute("SignText", text)
	for _, d in model:GetDescendants() do
		if d:IsA("TextLabel") and d.Name == "SignText" then
			d.Text = text
		end
	end
end

-- Turns a model into a black silhouette (for undiscovered Index entries).
function CharacterFactory.silhouette(model: Model)
	-- Collect first, destroy after, so we never visit children of a destroyed instance.
	local remove: { Instance } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Transparency < 1 then
				d.Color = Color3.fromRGB(15, 15, 20)
				d.Material = Enum.Material.SmoothPlastic
				d.Transparency = 0
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("Fire") or d:IsA("Light") or d:IsA("SurfaceGui") then
			table.insert(remove, d)
		end
	end
	for _, d in remove do
		d:Destroy()
	end
end

-- Height of the built model in studs (for placing labels above it).
local heights: { [Look]: number } = setmetatable({}, { __mode = "k" }) :: any
function CharacterFactory.height(look: Look): number
	local cached = heights[look]
	if cached then
		return cached
	end
	local model = CharacterFactory.build(look)
	local value = model:GetAttribute("Height")
	model:Destroy()
	local h = if type(value) == "number" then value else 5.6 * (look.scale or 1)
	heights[look] = h
	return h
end

return CharacterFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="156">
        <Properties>
          <string name="Name">CratePickup</string>
          <string name="Source"><![CDATA[--!strict
-- Pure rules for the automatic crate pickup, shared by the server (Tycoon fast tick), the
-- client crate visuals (Fx/Crates: the "can't" wiggle) and the unit tests.
--
--   * A crate is picked up by walking to it: the plot owner's root within RADIUS studs
--     (horizontal, REACH_Y vertical) of a crate that has landed, while holding no crate.
--   * landTime(length): a conservative upper bound of the client's arrival animation for a
--     route of `length` studs, so a crate is never grabbed in mid-air.
--   * Re-arm: for REARM seconds after a held crate is released (opened, discarded, dropped
--     on a Crate Smasher) nothing is picked up, and crates in range at that moment stay
--     blocked until the player has left their range once.

local CratePickup = {}

CratePickup.RADIUS = 4.5 -- studs, horizontal distance from the crate's centre
CratePickup.REACH_Y = 8 -- studs, vertical tolerance (jumping still picks up)
CratePickup.REARM = 1.5 -- seconds after a release with no automatic pickup
CratePickup.WIGGLE_GAP = 2 -- seconds between "can't" wiggles of one crate (client)

-- Upper bounds of the client's arrival legs (Fx/Crates): pop + hop + fall + gutter bounce,
-- the slide (from 3 studs/s, accelerating at 11 up to 13) and the two pen bounces, plus
-- replication slack.
local FIXED = 0.2 + 0.6 + 0.75 + 0.3 + 0.44 + 0.26 + 0.4
local V0, ACCEL, VMAX = 3, 11, 13

function CratePickup.landTime(length: number): number
	local len = math.max(0, length)
	local reachT = (VMAX - V0) / ACCEL
	local reachD = V0 * reachT + 0.5 * ACCEL * reachT * reachT
	local slide
	if len <= reachD then
		slide = (-V0 + math.sqrt(V0 * V0 + 2 * ACCEL * len)) / ACCEL
	else
		slide = reachT + (len - reachD) / VMAX
	end
	return math.min(FIXED + slide, 10)
end

-- Horizontal + vertical range test for an offset (crate centre minus player root).
function CratePickup.inRange(dx: number, dy: number, dz: number): boolean
	return dx * dx + dz * dz <= CratePickup.RADIUS * CratePickup.RADIUS and math.abs(dy) < CratePickup.REACH_Y
end

export type Check = {
	now: number,
	landsAt: number, -- when the crate has landed (same clock as now)
	inRange: boolean,
	holding: boolean, -- the player already carries a crate
	rearmUntil: number, -- no pickup before this (0 when never released)
	blocked: boolean, -- was in range at the last release and the player has not left it since
}

-- May this crate be picked up automatically right now?
function CratePickup.mayPick(c: Check): boolean
	return c.inRange and not c.holding and not c.blocked and c.now >= c.landsAt and c.now >= c.rearmUntil
end

-- Updated `blocked` flag for one crate this tick: leaving its range clears the block.
function CratePickup.stillBlocked(blocked: boolean, inRange: boolean): boolean
	return blocked and inRange
end

return CratePickup
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="157">
        <Properties>
          <string name="Name">DailyReward</string>
          <string name="Source"><![CDATA[--!strict
--[[
	DailyReward: pure rules of the 7-day daily reward (no Roblox dependencies,
	unit-tested with Lune; Server.Daily applies them, the Daily window shows them).

	One claim per UTC day. Claiming on the day after the last claim continues the
	streak; missing a day starts again at day 1; after day 7 the cards loop while
	the streak keeps counting. Every day pays cash sized like a shop cash pack
	(Economy.moneyPackAmount: seconds of the player's income, never below the
	day's minimum), so a reward matters at every stage. Days 3 and 7 also open a
	crate on the spot.

	A player's first day is the exception: minutes of income would jump a brand-new
	player over the tuned first tiers, so that day pays no more than the next
	FIRST_DAY_UNITS units cost (firstDayCap).
]]

local Economy = require(script.Parent.Economy)

local DailyReward = {}

DailyReward.DAY_SECONDS = 86400

-- `seconds` of income, at least `min` cash; `crate` = rarity of the crate opened with it.
export type Reward = { seconds: number, min: number, crate: string? }

DailyReward.REWARDS = {
	{ seconds = 5 * 60, min = 250 },
	{ seconds = 10 * 60, min = 500 },
	{ seconds = 15 * 60, min = 1000, crate = "Rare" },
	{ seconds = 20 * 60, min = 2000 },
	{ seconds = 30 * 60, min = 4000 },
	{ seconds = 45 * 60, min = 8000 },
	{ seconds = 60 * 60, min = 15000, crate = "Legendary" },
} :: { Reward }

DailyReward.DAYS = #DailyReward.REWARDS

-- UTC day number of a unix time (days since 1970-01-01).
function DailyReward.dayNumber(now: number): number
	return math.floor(now / DailyReward.DAY_SECONDS)
end

-- Seconds until the next UTC day starts (1..DAY_SECONDS).
function DailyReward.secondsLeft(now: number): number
	return DailyReward.DAY_SECONDS - math.floor(now) % DailyReward.DAY_SECONDS
end

-- The card (1..DAYS) a streak of `streak` claims ends on.
function DailyReward.card(streak: number): number
	return (math.max(streak, 1) - 1) % DailyReward.DAYS + 1
end

export type Status = {
	-- A reward can be claimed today.
	claimable: boolean,
	-- Today's card: the one to claim now, or the one already claimed today.
	day: number,
	-- Cards ticked in the current run of seven (0..DAYS).
	claimed: number,
	-- Days claimed in a row so far (0 after a missed day).
	streak: number,
}

-- `lastDay` = day number of the last claim (0 = never), `streak` = days in a row at that
-- claim, `today` = today's day number. A last claim "in the future" (a server clock ahead
-- of this one) counts as claimed today, so a reward is never paid twice for one day.
function DailyReward.status(lastDay: number, streak: number, today: number): Status
	if lastDay >= today and streak >= 1 then
		local day = DailyReward.card(streak)
		return { claimable = false, day = day, claimed = day, streak = streak }
	end
	if lastDay == today - 1 and streak >= 1 then
		local day = DailyReward.card(streak + 1)
		return { claimable = true, day = day, claimed = day - 1, streak = streak }
	end
	return { claimable = true, day = 1, claimed = 0, streak = 0 }
end

-- Claims today's reward: returns the new streak and the card it pays, or nil when today's
-- reward was already claimed.
function DailyReward.claim(lastDay: number, streak: number, today: number): (number?, number?)
	local status = DailyReward.status(lastDay, streak, today)
	if not status.claimable then
		return nil, nil
	end
	return status.streak + 1, status.day
end

-- Units whose price is the most a player's first day pays.
DailyReward.FIRST_DAY_UNITS = 4

-- The most card `day` pays on a player's first day: what their next FIRST_DAY_UNITS units
-- cost (a few hundred cash in the first minutes), never below the day's minimum. A boost,
-- not a tier skip.
function DailyReward.firstDayCap(day: number, bought: number): number
	local reward = DailyReward.REWARDS[DailyReward.card(day)]
	return math.max(reward.min, math.floor(Economy.bulkPrice(bought, DailyReward.FIRST_DAY_UNITS)))
end

-- Cash of card `day` for a player earning `income` cash/s at `progression`, at most `cap`
-- (firstDayCap on a player's first day, nil after it).
function DailyReward.cash(day: number, income: number, progression: Economy.Progression, cap: number?): number
	local reward = DailyReward.REWARDS[DailyReward.card(day)]
	local amount = Economy.moneyPackAmount(income, reward.seconds, reward.min, progression)
	return if cap then math.min(amount, cap) else amount
end

-- What card `day` pays on top of its cash when the rack has no room for the crate's unit:
-- the cash that unit is worth on average (0 on a day without a crate), so the crate is
-- never lost.
function DailyReward.crateCash(day: number, highestTier: number): number
	local crate = DailyReward.REWARDS[DailyReward.card(day)].crate
	return if crate then math.floor(Economy.chestExpectedValue(crate, highestTier)) else 0
end

-- One line naming card `day`'s reward: "$1.20K" or "Rare Crate + $1.20K" (`cashText` is the
-- formatted cash, `chestWord` the theme's word for a crate).
function DailyReward.describe(day: number, cashText: string, chestWord: string): string
	local reward = DailyReward.REWARDS[DailyReward.card(day)]
	if reward.crate then
		return string.format("%s %s + %s", reward.crate, chestWord, cashText)
	end
	return cashText
end

-- Opening by itself (Client.UI.DailyWindow) ------------------------------------------

-- The Daily window opens by itself after some calm seconds. A held crate (its panel is up)
-- is not calm, so the window waits for it to be dealt with; but a crate can be carried for
-- minutes, so once the crate alone has kept the window back for CRATE_PATIENCE seconds it
-- stops counting.
DailyReward.CRATE_PATIENCE = 10

-- Seconds of calm so far, and seconds spent waiting for nothing but the held crate.
export type AutoOpen = { calm: number, crate: number }

function DailyReward.autoOpen(): AutoOpen
	return { calm = 0, crate = 0 }
end

-- One tick of `step` seconds; true when the window should open now. `blocked` = something
-- the window must never cover (the intro, the tutorial, a window, a popup, a mode run):
-- the calm starts over. `crate` = the held-crate panel is up. `needed` = calm seconds asked.
function DailyReward.autoOpenTick(state: AutoOpen, step: number, blocked: boolean, crate: boolean, needed: number): boolean
	if blocked then
		state.calm = 0
		return false
	end
	if crate and state.crate < DailyReward.CRATE_PATIENCE then
		state.crate += step
		state.calm = 0
		return false
	end
	state.calm += step
	return state.calm >= needed
end

return DailyReward
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="158">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Economy: every balance number and pure formula in the game.

	This module has no Roblox dependencies so it can be unit-tested with Lune
	(see tests/). Both variants share it; only names, colours and looks differ
	per theme.

	Core loop:
	  buy units -> units drop orbs -> walk over orbs to carry them
	  -> deposit at the converter: the aura carried is queued and processed into cash,
	     and the random deposit multiplier's bonus part is paid as cash at once
	  -> collect cash -> buy more / upgrade.
	Two units of the same tier merge into one unit of the next tier. The converter never
	falls behind a new tier: discovering one lifts its level for free (minProcessLevel),
	and paid levels only add speed on top.
]]

local Economy = {}

Economy.VERSION = "2.0.0"

Economy.MAX_TIER = 25
Economy.MERGE_RATIO = 2
-- A player owns at most UNIT_CAP units, each shown as its own model on the display rack
-- (DISPLAY_ROWS shelves, DISPLAY_COLS units per shelf on average). See addUnitsCapped.
Economy.UNIT_CAP = 100
Economy.DISPLAY_ROWS = 10
Economy.DISPLAY_COLS = 10
Economy.DISPLAY_SLOTS = Economy.DISPLAY_ROWS * Economy.DISPLAY_COLS

-- Production ------------------------------------------------------------------

-- Each tier produces this many times more than the previous one. Must be greater
-- than MERGE_RATIO so merging is always an upgrade.
Economy.TIER_RATE_GROWTH = 3.0

function Economy.unitRate(tier: number): number
	return Economy.TIER_RATE_GROWTH ^ (tier - 1)
end

function Economy.productionPerSecond(units: { number }): number
	local total = 0
	for tier = 1, Economy.MAX_TIER do
		local count = units[tier] or 0
		if count > 0 then
			total += count * Economy.unitRate(tier)
		end
	end
	return total
end

function Economy.totalUnits(units: { number }): number
	local total = 0
	for tier = 1, Economy.MAX_TIER do
		total += units[tier] or 0
	end
	return total
end

function Economy.highestTier(discovered: { number }): number
	for tier = Economy.MAX_TIER, 1, -1 do
		if (discovered[tier] or 0) > 0 then
			return tier
		end
	end
	return 1
end

-- Merges every pair it can, cascading upward. Mutates `units` in place.
-- Returns how many merges happened, the highest tier that received a unit and
-- the merge steps in order (one per tier: `made` units of `tier` + 1 created).
export type MergeStep = { tier: number, made: number }

function Economy.mergeAll(units: { number }): (number, number, { MergeStep })
	local merges = 0
	local topCreated = 0
	local steps: { MergeStep } = {}
	for tier = 1, Economy.MAX_TIER - 1 do
		local count = units[tier] or 0
		local made = math.floor(count / Economy.MERGE_RATIO)
		if made > 0 then
			units[tier] = count - made * Economy.MERGE_RATIO
			units[tier + 1] = (units[tier + 1] or 0) + made
			merges += made
			topCreated = tier + 1
			table.insert(steps, { tier = tier, made = made })
		end
	end
	return merges, topCreated, steps
end

export type CapResult = {
	-- The new per-tier counts (1..MAX_TIER); the input table is left untouched.
	units: { number },
	-- How many of the incoming units were taken (charge only for these).
	accepted: number,
	-- Overflow merges in the order they happened; consecutive merges of the same tier are
	-- combined into one step (`made` units of `tier` + 1 created).
	steps: { MergeStep },
}

-- Lowest tier below MAX_TIER that holds a mergeable pair, or nil.
local function lowestPair(units: { number }): number?
	for tier = 1, Economy.MAX_TIER - 1 do
		if units[tier] >= Economy.MERGE_RATIO then
			return tier
		end
	end
	return nil
end

-- Adds `amount` units of `tier` without letting the total pass `cap` (default UNIT_CAP).
-- Whenever a unit would arrive beyond the cap, the lowest tier holding a pair merges once
-- first (the arriving unit counts, so it can complete that pair); the unit made by a merge
-- may pair up again later. The top tier never merges, so once nothing can merge the rest of
-- the batch is refused. A count already above the cap (an old save; pass amount 0) is merged
-- down first, and while it stays above the cap nothing new is accepted.
-- Every merge conserves unitValue exactly, so the result is worth the old units plus
-- `accepted` units of `tier`.
function Economy.addUnitsCapped(units: { number }, tier: number, amount: number, cap: number?): CapResult
	local limit = cap or Economy.UNIT_CAP
	local out: { number } = table.create(Economy.MAX_TIER, 0)
	local total = 0
	for t = 1, Economy.MAX_TIER do
		out[t] = units[t] or 0
		total += out[t]
	end
	local steps: { MergeStep } = {}
	local function mergeOnce(): boolean
		local t = lowestPair(out)
		if not t then
			return false
		end
		out[t] -= Economy.MERGE_RATIO
		out[t + 1] += 1
		total -= Economy.MERGE_RATIO - 1
		local last = steps[#steps]
		if last and last.tier == t then
			last.made += 1
		else
			table.insert(steps, { tier = t, made = 1 })
		end
		return true
	end

	while total > limit do
		if not mergeOnce() then
			break
		end
	end

	local remaining = math.max(0, math.floor(amount))
	local accepted = 0
	if total <= limit then
		-- Everything that fits without merging.
		local direct = math.min(remaining, limit - total)
		out[tier] += direct
		total += direct
		accepted += direct
		remaining -= direct
		-- The rest one at a time: an arrival past the cap is paid for by one merge (a merge
		-- removes at least one unit).
		while remaining > 0 do
			out[tier] += 1
			total += 1
			if total > limit and not mergeOnce() then
				out[tier] -= 1
				total -= 1
				break
			end
			accepted += 1
			remaining -= 1
		end
	end
	return { units = out, accepted = accepted, steps = steps }
end

-- Buying ----------------------------------------------------------------------

Economy.BUY_BASE_PRICE = 50
Economy.BUY_AMOUNTS = { 1, 5, 25, 100 }
-- Purchases that raise the price by one base price.
Economy.BUY_RAMP_UNITS = 1
-- A new player's first units are cheap: the first BUY_EASY_UNITS bought raise the price by
-- only 1 / BUY_EASY_REQ of the base each (the normal rate comes back after them). Together
-- with the starter unit they are worth one tier-6 unit and most of a tier-7 one: a fixed
-- head start, after which every price is what it always was.
Economy.BUY_EASY_UNITS = 60
Economy.BUY_EASY_REQ = 10

-- Sum of `n` consecutive purchase counts starting at `from`.
local function span(from: number, n: number): number
	return n * from + n * (n - 1) / 2
end

-- Exact price of `amount` consecutive purchases, the first made with `bought` units already
-- bought. Each purchase costs the base price times 1 + its growth: every earlier purchase
-- adds 1 / BUY_RAMP_UNITS, or 1 / BUY_EASY_REQ while it is an easy one.
local function price(bought: number, amount: number): number
	-- Purchases of this batch whose price still counts only easy units, then the rest.
	local easy = math.clamp(Economy.BUY_EASY_UNITS - bought, 0, amount)
	local rest = amount - easy
	local growth = span(bought, easy) / Economy.BUY_EASY_REQ
	if rest > 0 then
		local start = bought + easy
		local easyBefore = math.min(start, Economy.BUY_EASY_UNITS)
		growth += rest * easyBefore / Economy.BUY_EASY_REQ + span(start - easyBefore, rest) / Economy.BUY_RAMP_UNITS
	end
	return Economy.BUY_BASE_PRICE * (amount + growth)
end

-- Price of the next single unit (always the first tier). Grows linearly with the units
-- bought so far: 2x after BUY_RAMP_UNITS of them, the easy ones aside.
function Economy.unitPrice(bought: number): number
	return price(bought, 1)
end

-- Exact sum of unitPrice for `amount` consecutive purchases.
function Economy.bulkPrice(bought: number, amount: number): number
	return price(bought, amount)
end

-- Processing (the converter that turns deposited orbs into cash) ---------------

-- Each level is 25% faster and costs 25% more than the one before, so a level always costs
-- the same 50 seconds of the converter's own output.
Economy.PROCESS_BASE = 4
Economy.PROCESS_GROWTH = 1.25
Economy.PROCESS_COST_BASE = 200
Economy.PROCESS_COST_GROWTH = 1.25
Economy.PROCESS_BULK = 10
-- An upgrade is refused (no charge) once the converter is this many times faster than the
-- units produce: more speed would buy nothing.
Economy.CONVERTER_HEADROOM = 4

function Economy.processRate(level: number): number
	return Economy.PROCESS_BASE * Economy.PROCESS_GROWTH ^ level
end

function Economy.processUpgradeCost(level: number): number
	return Economy.PROCESS_COST_BASE * Economy.PROCESS_COST_GROWTH ^ level
end

-- The free converter floor: the lowest level whose rate covers one unit of `tier`. A profile's
-- level is never below the floor of its best tier (about 5 free levels per new tier). A rack
-- with every pair merged produces 1x to 2x unitRate(best), so a converter nobody upgraded is
-- never short by more than 2x.
function Economy.minProcessLevel(tier: number): number
	local needed = Economy.unitRate(math.clamp(tier, 1, Economy.MAX_TIER)) / Economy.PROCESS_BASE
	return math.max(0, math.ceil(math.log(needed) / math.log(Economy.PROCESS_GROWTH)))
end

-- Cost of buying `amount` levels starting from `level` (geometric series).
function Economy.processBulkCost(level: number, amount: number): number
	local g = Economy.PROCESS_COST_GROWTH
	return Economy.processUpgradeCost(level) * (g ^ amount - 1) / (g - 1)
end

-- Cash value of one orb point before multipliers.
Economy.CASH_PER_POINT = 1

-- Deposit multiplier (global, rerolled on a timer) ------------------------------

-- Never below x1 (a deposit is never a loss); the mean is about x1.15.
Economy.DEPOSIT_REROLL_SECONDS = 20
Economy.DEPOSIT_MULTIPLIERS = {
	{ value = 1.0, weight = 50 },
	{ value = 1.1, weight = 18 },
	{ value = 1.2, weight = 12 },
	{ value = 1.3, weight = 8 },
	{ value = 1.5, weight = 6 },
	{ value = 1.8, weight = 3.5 },
	{ value = 2.0, weight = 2 },
	{ value = 3.0, weight = 0.5 },
}
Economy.DEPOSIT_MIN = 1.0
Economy.DEPOSIT_MAX = 3.0

local function pickWeighted<T>(entries: { T }, weightOf: (T) -> number, roll: number): T
	local total = 0
	for _, entry in entries do
		total += weightOf(entry)
	end
	local target = roll * total
	for _, entry in entries do
		target -= weightOf(entry)
		if target < 0 then
			return entry
		end
	end
	return entries[#entries]
end

function Economy.rollDepositMultiplier(rng: () -> number): number
	local entry = pickWeighted(Economy.DEPOSIT_MULTIPLIERS, function(e)
		return e.weight
	end, rng())
	return entry.value
end

-- What a deposit of `carried` aura at multiplier `mult` gives: the aura queued in the
-- converter (always all of it) and the bonus aura, which is paid as cash at once.
function Economy.depositSplit(carried: number, mult: number): (number, number)
	return carried, carried * (math.max(mult, 1) - 1)
end

-- Global "surge" event: double orbs for the last part of every cycle. ----------
-- The converter runs at double speed too, so the cash earned really doubles. Rewards are
-- sized with the income outside the surge.

Economy.SURGE_CYCLE = 600
Economy.SURGE_DURATION = 120
Economy.SURGE_MULTIPLIER = 2

-- Returns whether a surge is active at `now` and seconds until it changes state.
function Economy.surgeState(now: number): (boolean, number)
	local t = now % Economy.SURGE_CYCLE
	local start = Economy.SURGE_CYCLE - Economy.SURGE_DURATION
	if t >= start then
		return true, Economy.SURGE_CYCLE - t
	end
	return false, start - t
end

-- Chests ----------------------------------------------------------------------

Economy.CHEST_RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }

-- `offsets` = { tier offset from the crate anchor (see chestAnchor), % chance }.
-- `minAnchor` = the lowest tier the offsets are applied to: at very low highest
-- tiers Rare+ crates shift their window up instead of piling the clamped
-- chances onto tier 1, so they still feel better than a Common crate.
export type ChestInfo = {
	weight: number,
	unlockSeconds: number,
	minAnchor: number?,
	offsets: { { number } },
}

Economy.CHEST_INFO = {
	Common = { weight = 82, unlockSeconds = 60, offsets = { { -2, 75 }, { -1, 20 }, { 0, 5 } } },
	Uncommon = { weight = 12, unlockSeconds = 120, offsets = { { -1, 60 }, { 0, 32 }, { 1, 8 } } },
	Rare = { weight = 4.5, unlockSeconds = 180, minAnchor = 2, offsets = { { -1, 20 }, { 0, 50 }, { 1, 30 } } },
	Epic = { weight = 1.2, unlockSeconds = 240, minAnchor = 2, offsets = { { 0, 30 }, { 1, 50 }, { 2, 20 } } },
	Legendary = {
		weight = 0.3,
		unlockSeconds = 300,
		minAnchor = 2,
		offsets = { { 0, 15 }, { 1, 45 }, { 2, 30 }, { 3, 10 } },
	},
} :: { [string]: ChestInfo }

Economy.CHEST_SPAWN_INTERVAL = 40
Economy.CHEST_SPAWN_CHANCE = 0.45
Economy.MAX_FLOOR_CHESTS = 3
Economy.PREMIUM_UNLOCK_SPEED = 3
-- The very first crate of a profile opens this fast, whatever its rarity.
Economy.FIRST_CRATE_SECONDS = 10

-- Crates are anchored this share of the way from the player's highest tier down to tier 1
-- (rounded towards the highest tier). Late tiers take hours to reach while crates keep
-- arriving every few minutes, so the gap grows with the tier to keep crates a bonus
-- rather than a shortcut: highest 3 -> anchor 3, 5 -> 4, 10 -> 7, 17 -> 12, 25 -> 17.
Economy.CHEST_TIER_LAG = 0.35

function Economy.chestAnchor(highestTier: number): number
	return highestTier - math.floor((highestTier - 1) * Economy.CHEST_TIER_LAG)
end

function Economy.isRarity(rarity: string): boolean
	return Economy.CHEST_INFO[rarity] ~= nil
end

function Economy.rollChestRarity(rng: () -> number): string
	return pickWeighted(Economy.CHEST_RARITIES, function(r)
		return Economy.CHEST_INFO[r].weight
	end, rng())
end

export type Odds = { tier: number, chance: number }

-- Possible tiers and their % chance, relative to the crate anchor of the player's highest tier.
-- Offsets that clamp onto the same tier are combined (see `minAnchor`).
function Economy.chestOdds(rarity: string, highestTier: number): { Odds }
	local info = Economy.CHEST_INFO[rarity]
	local anchor = math.max(Economy.chestAnchor(highestTier), info.minAnchor or 1)
	local byTier: { [number]: number } = {}
	for _, pair in info.offsets do
		local tier = math.clamp(anchor + pair[1], 1, Economy.MAX_TIER)
		byTier[tier] = (byTier[tier] or 0) + pair[2]
	end
	local list: { Odds } = {}
	for tier, chance in byTier do
		table.insert(list, { tier = tier, chance = chance })
	end
	table.sort(list, function(a, b)
		return a.tier < b.tier
	end)
	return list
end

function Economy.rollChest(rarity: string, highestTier: number, rng: () -> number): number
	local entry = pickWeighted(Economy.chestOdds(rarity, highestTier), function(o)
		return o.chance
	end, rng())
	return entry.tier
end

-- What a unit of `tier` costs to make by buying tier-1 units and merging them up.
function Economy.unitValue(tier: number): number
	return Economy.BUY_BASE_PRICE * Economy.MERGE_RATIO ^ (math.max(tier, 1) - 1)
end

-- Expected unit value of what a crate of this rarity contains.
function Economy.chestExpectedValue(rarity: string, highestTier: number): number
	local total = 0
	for _, entry in Economy.chestOdds(rarity, highestTier) do
		total += Economy.unitValue(entry.tier) * entry.chance / 100
	end
	return total
end

function Economy.unlockSeconds(rarity: string, premium: boolean): number
	local seconds = Economy.CHEST_INFO[rarity].unlockSeconds
	if premium then
		seconds = math.ceil(seconds / Economy.PREMIUM_UNLOCK_SPEED)
	end
	return seconds
end

-- Rewards ---------------------------------------------------------------------

Economy.FREE_REWARD_COOLDOWN = 600
Economy.FREE_REWARD_SECONDS = 120
Economy.FREE_REWARD_MIN = 100

-- A new profile's cash and converter level (DataService.defaultProfile). The converter
-- starts a few levels up so it keeps pace with the first three tiers; from there the free
-- floor (minProcessLevel) lifts it with every new tier.
Economy.START_CASH = 100
Economy.START_PROCESS_LEVEL = 8

-- One-time reward for finishing the onboarding tutorial: enough for the next few units,
-- so the first merge is followed by a second one straight away.
Economy.TUTORIAL_REWARD_CASH = 200

Economy.OFFLINE_CAP_SECONDS = 8 * 3600
Economy.OFFLINE_EFFICIENCY = 0.25
Economy.OFFLINE_MIN_SECONDS = 60

Economy.FRIEND_BONUS = 0.1
Economy.MAX_FRIEND_BONUS = 0.5
Economy.PREMIUM_BONUS = 0.1

-- Cash per second the player is currently able to earn (bottlenecked by
-- whichever is slower: production or processing).
function Economy.incomePerSecond(production: number, processRate: number, moneyMult: number): number
	return math.min(production, processRate) * Economy.CASH_PER_POINT * moneyMult
end

-- Progression (what Robux packs scale with) ---------------------------------------

-- Durable progress only: the highest tier ever discovered and the converter level. Neither
-- can go down, so selling, merging or a bad multiplier moment never makes a pack worse.
export type Progression = { tier: number, processLevel: number }

function Economy.progression(highestTier: number, processLevel: number): Progression
	return {
		tier = math.clamp(math.floor(highestTier), 1, Economy.MAX_TIER),
		processLevel = math.max(0, math.floor(processLevel)),
	}
end

-- Cash per second a player at this progression earns at the very least: the output of ONE
-- unit of their highest tier, run through their own converter, with no boosts. Anyone who
-- discovered that tier made such a unit (and a real rack holds many more units below it),
-- and the converter cap is the same one Tycoon.income applies, so the floor stays at or
-- below what a real player at that stage earns.
function Economy.progressionIncome(progression: Progression): number
	return Economy.incomePerSecond(Economy.unitRate(progression.tier), Economy.processRate(progression.processLevel), 1)
end

-- Cash packs: `seconds` of income at the better of the live income and the progression
-- floor, never below the pack's fixed `minimum` (which only matters for brand-new players).
function Economy.moneyPackAmount(income: number, seconds: number, minimum: number, progression: Progression): number
	local perSecond = math.max(income, Economy.progressionIncome(progression))
	return math.max(minimum, math.floor(perSecond * seconds))
end

-- Aura packs (aura straight into the tank): `seconds` of aura at the better of the live
-- production (orbs per second, Tycoon.production) and the progression floor (one unit of the
-- highest tier, the same floor progressionIncome uses), never below the pack's fixed
-- `minimum` (which only matters for brand-new players).
function Economy.auraPackAmount(production: number, seconds: number, minimum: number, progression: Progression): number
	local perSecond = math.max(production, Economy.unitRate(progression.tier))
	return math.max(minimum, math.floor(perSecond * seconds))
end

-- Game modes (Parkour) ------------------------------------------------------------

-- Finishing a mode pays a cash pack's worth sized like the shop's (moneyPackAmount with the
-- mode's own seconds and minimum, Theme.Modes): on the first finish ever and then
-- at most once per MODE_REWARD_COOLDOWN. Players may run again straight away; a finish
-- inside the cooldown is worth MODE_REPEAT_SHARE of the pack (`repeatCash`), which the mode
-- pays only for a clean, unassisted run.
Economy.MODE_REWARD_COOLDOWN = 1800
Economy.MODE_REPEAT_SHARE = 0.2
-- Cash price of a Parkour "Skip Stage" (teleport to the next checkpoint; the run becomes
-- assisted: it pays and unlocks but sets no best time): two minutes of income, at least $250.
Economy.PARKOUR_SKIP_MIN = 250
Economy.PARKOUR_SKIP_SECONDS = 120
function Economy.parkourSkipCost(income: number): number
	return math.max(Economy.PARKOUR_SKIP_MIN, math.floor(income * Economy.PARKOUR_SKIP_SECONDS + 0.5))
end

export type ModeReward = {
	-- Cash this finish pays (packCash when `full`, else 0).
	cash: number,
	full: boolean,
	packCash: number,
	-- What a clean finish inside the cooldown is worth (MODE_REPEAT_SHARE of the pack).
	repeatCash: number,
}

function Economy.modeReward(
	income: number,
	progression: Progression,
	packSeconds: number,
	packMinimum: number,
	firstClear: boolean,
	lastFullAt: number,
	now: number
): ModeReward
	local packCash = Economy.moneyPackAmount(income, packSeconds, packMinimum, progression)
	local full = firstClear or now >= lastFullAt + Economy.MODE_REWARD_COOLDOWN
	return {
		cash = if full then packCash else 0,
		full = full,
		packCash = packCash,
		repeatCash = math.floor(packCash * Economy.MODE_REPEAT_SHARE),
	}
end

-- Parkour level multiplier on the finish cash: +20% per level above the first (level 10
-- pays 2.8x the pack).
function Economy.parkourLevelBonus(level: number): number
	return 1 + 0.2 * (math.max(1, math.floor(level)) - 1)
end

-- Tier rarity bands (used for label colours in the Index and on units).
Economy.TIER_BANDS = {
	{ upTo = 5, name = "Common" },
	{ upTo = 10, name = "Uncommon" },
	{ upTo = 15, name = "Rare" },
	{ upTo = 20, name = "Epic" },
	{ upTo = 24, name = "Legendary" },
	{ upTo = 25, name = "Mythic" },
}

function Economy.tierBand(tier: number): string
	for _, band in Economy.TIER_BANDS do
		if tier <= band.upTo then
			return band.name
		end
	end
	return "Mythic"
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="159">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting. Pure Luau so it can be unit-tested with Lune.

local Format = {}

local SUFFIXES = {
	"",
	"K",
	"M",
	"B",
	"T",
	"Qa",
	"Qi",
	"Sx",
	"Sp",
	"Oc",
	"No",
	"Dc",
	"Ud",
	"Dd",
	"Td",
	"Qad",
	"Qid",
	"Sxd",
	"Spd",
	"Ocd",
	"Nod",
	"Vg",
}

-- 1234 -> "1.23K", 999 -> "999", 1e6 -> "1.00M"
function Format.short(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	local sign = if n < 0 then "-" else ""
	n = math.abs(n)
	if n < 1000 then
		return sign .. tostring(math.floor(n))
	end
	local index = math.floor(math.log10(n) / 3)
	if index >= #SUFFIXES then
		return sign .. string.format("%.2e", n)
	end
	local scaled = n / 10 ^ (index * 3)
	-- log10 can round up just below a power of 1000 (e.g. 0.99T); step back.
	if scaled < 1 and index > 1 then
		index -= 1
		scaled = n / 10 ^ (index * 3)
	end
	-- Truncate (not round) so displayed balances never overstate what you have.
	scaled = math.floor(scaled * 100) / 100
	return sign .. string.format("%.2f", scaled) .. SUFFIXES[index + 1]
end

-- 1234567 -> "1,234,567". Very large numbers fall back to short form.
function Format.commas(n: number): string
	if n ~= n then
		return "0"
	end
	if math.abs(n) >= 1e15 then
		return Format.short(n)
	end
	local sign = if n < 0 then "-" else ""
	local digits = tostring(math.floor(math.abs(n)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return sign .. out
end

function Format.money(n: number): string
	return "$" .. Format.short(n)
end

-- A Robux price: the Robux glyph (private-use U+E002, drawn by every Roblox font) and the amount.
function Format.robux(n: number): string
	return utf8.char(0xE002) .. " " .. tostring(n)
end

function Format.multiplier(n: number): string
	return string.format("%.1fx", n)
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Format.time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Always "HH:MM:SS" (for unlocker screens).
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

function Format.date(timestamp: number): string
	local t = os.date("*t", math.floor(timestamp)) :: any
	return string.format("%d/%d/%d", t.month, t.day, t.year)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="160">
        <Properties>
          <string name="Name">Funnel</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Funnel: the onboarding funnel's steps and rules as pure data + functions.

	No Roblox dependencies, so it is unit-tested with Lune (tests/run.luau).
	Server.Analytics does the logging.

	Steps, logged once per new player. The Creator Dashboard keeps its history by
	step number, so steps are only ever appended:
	  1 Joined         first session starts
	  2 Intro Done     the cutscene finished or was skipped
	  3..7             each tutorial step finished (buy, orbs, deposit, collect, merge)
	  8..11            highest tier discovered: Tier 3, Tier 5, Tier 7, Tier 10

	profile.onboarding says where a player is:
	  0..11         the highest step logged
	  SKIPPED + n   the tutorial was skipped. The funnel stops there: logging the rest
	                of it would count tutorial steps the player never did. Their tier
	                milestones are logged as one-time custom events instead
	                ("SkipperTier3", ...); n counts the ones already logged
	  LEGACY        a save from before the funnel: not a new player, never logs

	The tier milestones (steps 8..11 and the Skipper events) were added later. A save from
	before them whose tutorial is over is a returning player: Funnel.returning marks every
	milestone as logged without sending anything, so only new players' tiers are counted.
]]

local Funnel = {}

Funnel.LEGACY = 99
Funnel.SKIPPED = 50
-- The step that finishing the tutorial logs (2 + TutorialSteps.COUNT).
Funnel.TUTORIAL_END = 7
-- Tiers whose first discovery is a step, in order.
Funnel.MILESTONES = { 3, 5, 7, 10 }
Funnel.LAST = Funnel.TUTORIAL_END + #Funnel.MILESTONES

export type Plan = {
	-- The new profile.onboarding.
	onboarding: number,
	-- Funnel steps to log, in order.
	steps: { number },
	-- Custom events to log, in order.
	events: { string },
}

-- How many milestones a player whose best tier is `highestTier` has reached.
function Funnel.reached(highestTier: number): number
	local count = 0
	for _, tier in Funnel.MILESTONES do
		if highestTier >= tier then
			count += 1
		end
	end
	return count
end

function Funnel.milestoneName(index: number): string
	return "Tier " .. Funnel.MILESTONES[index]
end

-- profile.onboarding after the tutorial is skipped (unchanged when the tutorial was
-- finished, already skipped, or the save is a legacy one).
function Funnel.skip(onboarding: number): number
	return if onboarding < Funnel.TUTORIAL_END then Funnel.SKIPPED else onboarding
end

-- profile.onboarding for a save from before the tier milestones, on its first load since
-- (DataService). A tutorial that is over (finished, or skipped: `tutorialDone` below the
-- tutorial's last step is a skip from before skips were marked) leaves the funnel with
-- every milestone marked as logged, so tiers reached long ago are never sent as new. A
-- tutorial still running goes on as before.
function Funnel.returning(onboarding: number, tutorialDone: boolean): number
	if onboarding >= Funnel.LEGACY then
		return onboarding
	elseif onboarding >= Funnel.SKIPPED or (tutorialDone and onboarding < Funnel.TUTORIAL_END) then
		return Funnel.SKIPPED + #Funnel.MILESTONES
	elseif onboarding >= Funnel.TUTORIAL_END then
		return Funnel.LAST
	end
	return onboarding
end

-- What a profile at `onboarding` logs now that its best tier is `highestTier`. Nothing
-- while the tutorial is still running: the milestones follow once it is finished or
-- skipped.
function Funnel.tiers(onboarding: number, highestTier: number): Plan
	local plan: Plan = { onboarding = onboarding, steps = {}, events = {} }
	local reached = Funnel.reached(highestTier)
	if onboarding >= Funnel.LEGACY then
		return plan
	elseif onboarding >= Funnel.SKIPPED then
		for index = onboarding - Funnel.SKIPPED + 1, reached do
			table.insert(plan.events, "SkipperTier" .. Funnel.MILESTONES[index])
			plan.onboarding = Funnel.SKIPPED + index
		end
	elseif onboarding >= Funnel.TUTORIAL_END then
		for step = onboarding + 1, Funnel.TUTORIAL_END + reached do
			table.insert(plan.steps, step)
			plan.onboarding = step
		end
	end
	return plan
end

return Funnel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="161">
        <Properties>
          <string name="Name">InteractiveRules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure rules for the plot's interactive gym props (Client.Fx.Interactive plays them; the props
-- themselves are built by World.Decor), shared with the unit tests. Cosmetic only: nothing
-- here touches the economy.
--
--   * Trampoline: a bounce is a jump of BOUNCE_BASE x the normal jump height from standing,
--     + BOUNCE_CHAIN for landing out of a full bounce, + BOUNCE_HOLD while jump is held: 3x to
--     4x in all. A bounce is mostly straight up: it keeps at most BOUNCE_DRIFT studs/s sideways.
--   * Punch bag: at most one hit every HIT_GAP seconds; a hit within COMBO_RESET seconds of
--     the last one grows the combo, else it starts again at 1; MILESTONES get the big text.
--     The bag is a damped pendulum: each hit kicks it (kick), swingStep moves it on.
--   * A punch lasts PUNCH_TIME seconds: punch(t) gives how far the fist is out and how much
--     of the pose shows over the avatar's own animation.
--   * Bench press: a rep takes REP_TIME seconds, from arms out, down to the chest and back up
--     (press); reps(t) counts the finished ones.

local Rules = {}

-- Trampoline -------------------------------------------------------------------------------

Rules.BOUNCE_BASE = 3 -- x the normal jump height, bouncing from a standstill
Rules.BOUNCE_CHAIN = 0.5 -- more for landing at a full bounce's speed
Rules.BOUNCE_HOLD = 0.5 -- more for holding jump
Rules.BOUNCE_GAP = 0.2 -- seconds between two bounces
Rules.BOUNCE_DRIFT = 6 -- studs/s of sideways speed a bounce keeps

-- Take-off speed of a jump that reaches `height` studs under `gravity`.
function Rules.jumpSpeed(gravity: number, height: number): number
	return math.sqrt(2 * math.max(0, gravity) * math.max(0, height))
end

-- How many normal jumps high a bounce goes: `jumpSpeed` is the avatar's normal take-off speed,
-- `landingSpeed` how fast it came down onto the pad (0 when it just stands there).
function Rules.bounceHeight(jumpSpeed: number, landingSpeed: number, holding: boolean): number
	local full = jumpSpeed * math.sqrt(Rules.BOUNCE_BASE)
	local chain = if full > 0 then math.clamp(landingSpeed / full, 0, 1) else 0
	return Rules.BOUNCE_BASE + Rules.BOUNCE_CHAIN * chain + (if holding then Rules.BOUNCE_HOLD else 0)
end

-- Upward speed of that bounce.
function Rules.bounceSpeed(jumpSpeed: number, landingSpeed: number, holding: boolean): number
	return jumpSpeed * math.sqrt(Rules.bounceHeight(jumpSpeed, landingSpeed, holding))
end

-- The sideways velocity (x, z) a bounce keeps.
function Rules.drift(x: number, z: number): (number, number)
	local speed = math.sqrt(x * x + z * z)
	if speed <= Rules.BOUNCE_DRIFT then
		return x, z
	end
	local k = Rules.BOUNCE_DRIFT / speed
	return x * k, z * k
end

-- Punch bag --------------------------------------------------------------------------------

Rules.HIT_GAP = 0.25 -- seconds between two hits (4 a second)
Rules.COMBO_RESET = 2 -- seconds without a hit before the combo starts over
Rules.MILESTONES = { 10, 25, 50 }

function Rules.canHit(lastHit: number?, now: number): boolean
	return lastHit == nil or now - lastHit >= Rules.HIT_GAP
end

-- True while a hit at `now` would still add to the combo.
function Rules.comboAlive(lastHit: number?, now: number): boolean
	return lastHit ~= nil and now - lastHit <= Rules.COMBO_RESET
end

-- The combo after a hit at `now`.
function Rules.combo(combo: number, lastHit: number?, now: number): number
	return if Rules.comboAlive(lastHit, now) then combo + 1 else 1
end

function Rules.milestone(combo: number): boolean
	return table.find(Rules.MILESTONES, combo) ~= nil
end

-- Size of the combo text: it grows a little with the combo and jumps on a milestone.
function Rules.comboScale(combo: number): number
	if Rules.milestone(combo) then
		return 1.8
	end
	return 1 + 0.35 * math.clamp((combo - 1) / 49, 0, 1)
end

-- The bag's swing: an angle (radians, + is away from the puncher) and its speed.
Rules.SWING_MAX = math.rad(34)
local SWING_RATE = 7 -- rad/s: a swing there and back takes about 0.9 s
local SWING_DAMPING = 0.14 -- of critical: settled about 4 s after the last hit
local SWING_STEP = 1 / 120

-- Angular speed one hit adds: a first hit swings the bag about 20 degrees, a long combo more.
function Rules.kick(combo: number): number
	return 2.9 + 1.1 * math.clamp((combo - 1) / 9, 0, 1)
end

-- Moves the swing on by `dt` seconds; the angle never passes SWING_MAX.
function Rules.swingStep(angle: number, speed: number, dt: number): (number, number)
	local left = math.clamp(dt, 0, 0.25)
	while left > 0 do
		local h = math.min(left, SWING_STEP)
		left -= h
		speed += (-SWING_RATE * SWING_RATE * angle - 2 * SWING_DAMPING * SWING_RATE * speed) * h
		angle += speed * h
		if math.abs(angle) > Rules.SWING_MAX then
			angle = math.sign(angle) * Rules.SWING_MAX
			speed = 0
		end
	end
	return angle, speed
end

-- True once a swing is too small to see.
function Rules.swingStill(angle: number, speed: number): boolean
	return math.abs(angle) < math.rad(0.15) and math.abs(speed) < math.rad(1.5)
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

Rules.PUNCH_TIME = 0.36
local PUNCH_OUT = 0.1 -- seconds from the guard to the fist fully out
local PUNCH_IN = 0.05 -- seconds for the pose to take over
local PUNCH_FADE = 0.16 -- seconds for it to hand back at the end

-- A punch `t` seconds in: reach (0 = on guard, 1 = fist out) and weight (0 = the avatar's own
-- animation, 1 = the punch pose).
function Rules.punch(t: number): (number, number)
	if t < 0 or t >= Rules.PUNCH_TIME then
		return 0, 0
	end
	local reach = smooth(t / PUNCH_OUT)
	local weight = math.min(smooth(t / PUNCH_IN), smooth((Rules.PUNCH_TIME - t) / PUNCH_FADE))
	return reach, weight
end

-- Bench press ------------------------------------------------------------------------------

Rules.REP_TIME = 1.7
local REP_DOWN = 0.55 -- share of a rep spent lowering the bar

-- How far the bar is pushed out `t` seconds after lying down: 1 = arms straight, 0 = on the
-- chest. Every rep lowers it gently and pushes it back up faster.
function Rules.press(t: number): number
	local u = (math.max(0, t) / Rules.REP_TIME) % 1
	if u < REP_DOWN then
		return 1 - smooth(u / REP_DOWN)
	end
	return smooth((u - REP_DOWN) / (1 - REP_DOWN))
end

-- Reps finished `t` seconds after lying down.
function Rules.reps(t: number): number
	return math.floor(math.max(0, t) / Rules.REP_TIME)
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="162">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Remote events/functions. The server creates them, clients wait for them.
--
--   State   (server -> client)  full public snapshot of the player's tycoon
--   Notify  (server -> client)  toasts, popups, reward reveals, confirms
--   Effect  (server -> client)  cosmetic feedback (collect sounds, floating text)
--   Action  (client -> server)  button presses from the UI
--   Query   (client -> server)  request/response data (ranking)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = { "State", "Notify", "Effect", "Action" }
local FUNCTIONS = { "Query" }

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local f = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
		if not f then
			local created = Instance.new("Folder")
			created.Name = "Remotes"
			f = created
		end
		assert(f, "Remotes folder missing")
		for _, name in EVENTS do
			if not f:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = f
			end
		end
		for _, name in FUNCTIONS do
			if not f:FindFirstChild(name) then
				local remote = Instance.new("RemoteFunction")
				remote.Name = name
				remote.Parent = f
			end
		end
		f.Parent = ReplicatedStorage
		folder = f
		return f
	end
	local f = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	folder = f
	return f
end

function Net.event(name: string): RemoteEvent
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	return getFolder():WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="163">
        <Properties>
          <string name="Name">NextGoal</string>
          <string name="Source"><![CDATA[--!strict
--[[
	NextGoal: picks the one concrete target the HUD's "Next:" line names (pure,
	unit-tested with Lune; Client.UI.Hud draws it once the tutorial is done).

	In order:
	  merge    the next undiscovered tier: merge two units of the best tier found
	  rack     every tier is discovered: stack units of the top tier
]]

local Economy = require(script.Parent.Economy)

local NextGoal = {}

export type Goal = {
	kind: "merge" | "rack",
	-- merge: the tier to discover; rack: the top tier.
	tier: number,
	-- merge: the tier to merge two of; rack: the top tier.
	from: number,
	-- Units counted toward the goal and how many it takes.
	have: number,
	need: number,
	-- 0..1 for a progress bar; `ready` = one step on a pad finishes it.
	progress: number,
	ready: boolean,
}

-- The fields of the State snapshot (or a saved profile) the pick reads.
export type Input = {
	discovered: { number },
	units: { number },
}

local function count(units: { number }, tier: number): number
	local n = units[tier]
	return if type(n) == "number" and n == n and n > 0 then math.floor(n) else 0
end

function NextGoal.pick(input: Input): Goal
	local best = Economy.highestTier(input.discovered)
	if best < Economy.MAX_TIER then
		-- Everything owned up to `best`, counted in units of `best` (two of a tier make one
		-- of the next), so buying and merging lower tiers moves the bar too.
		local worth = 0
		for tier = 1, best do
			worth += count(input.units, tier) / Economy.MERGE_RATIO ^ (best - tier)
		end
		local have = count(input.units, best)
		return {
			kind = "merge",
			tier = best + 1,
			from = best,
			have = math.min(have, Economy.MERGE_RATIO),
			need = Economy.MERGE_RATIO,
			progress = math.clamp(worth / Economy.MERGE_RATIO, 0, 1),
			ready = have >= Economy.MERGE_RATIO,
		}
	end
	local top = count(input.units, Economy.MAX_TIER)
	return {
		kind = "rack",
		tier = Economy.MAX_TIER,
		from = Economy.MAX_TIER,
		have = math.min(top, Economy.UNIT_CAP),
		need = Economy.UNIT_CAP,
		progress = math.clamp(top / Economy.UNIT_CAP, 0, 1),
		ready = false,
	}
end

--[[
	The goal in words: (title, hint, count), e.g. ("Protein Bro", "merge 2x Gym
	Rookie", "1/2"). `nameOf(tier)` names a unit tier.
	The HUD shows "Next: <title> (<hint>) <count>" and drops the hint when short of room.
]]
function NextGoal.text(goal: Goal, nameOf: (number) -> string): (string, string, string)
	if goal.kind == "merge" then
		local hint = string.format("merge %dx %s", goal.need, nameOf(goal.from))
		return nameOf(goal.tier), hint, string.format("%d/%d", goal.have, goal.need)
	end
	return nameOf(goal.tier), "fill your rack", string.format("%d/%d", goal.have, goal.need)
end

return NextGoal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="164">
        <Properties>
          <string name="Name">OrbLook</string>
          <string name="Source"><![CDATA[--!strict
-- Pure helpers for the aura orb look, the pen fill rule and the Auto Aura timing, shared by
-- the client orb visuals (Fx/Orbs), the server (Tycoon) and the unit tests.
--
--   * Every orb is the same size. Its paint comes from the unit tier that produced it:
--     tierIndex(tier, n) picks one of the n Theme.OrbColors, cycling so neighbouring tiers differ.
--   * feedTarget(balls, tier, cap, roll): the pen fill rule. Below the cap every produced orb is
--     a new ball; at the cap it joins an existing ball (same tier first, then the lowest count).
--   * Dumbbells: about one produced piece in DUMBBELL_CHANCE lands as a tier-tinted dumbbell
--     instead of a ball, DUMBBELL_SCALE times an orb's size and worth DUMBBELL_VALUE times the
--     piece. It never joins or is fed by other balls and keeps the floor cells around it clear.
--   * tagRGB(r, g, b): text colour of a ball's "xN" tag (a lightened ball colour, white if pale).
--   * travelTime(length, queue): a conservative upper bound of how long the client's roll-in
--     animation takes for a route of `length` studs (hop + fall + gutter/chute roll that
--     accelerates from 6 to 18 studs/s + floor bounces), plus the chute queue wait.

local OrbLook = {}

OrbLook.CAP = 64 -- balls a pen holds before new orbs count up existing balls
OrbLook.SETTLE = 1.2 -- seconds an orb rests in the pen before Auto Aura collects it

OrbLook.DUMBBELL_CHANCE = 1 / 25 -- share of produced pieces that land as a dumbbell
OrbLook.DUMBBELL_VALUE = 10 -- a dumbbell is worth this many times the piece it replaces
OrbLook.DUMBBELL_SCALE = 2 -- its length, in orb diameters
OrbLook.DUMBBELL_PLATE = 0.31 -- radius of its big plates (its resting height), in dumbbell lengths

-- Palette slot (1..n) for orbs produced by a unit of `tier` (tier 1 = slot 1).
function OrbLook.tierIndex(tier: number?, n: number): number
	local t = math.max(1, math.floor(tier or 1))
	return (t - 1) % math.max(1, n) + 1
end

function OrbLook.tierColor<T>(tier: number?, palette: { T }): T
	return palette[OrbLook.tierIndex(tier, #palette)]
end

export type Ball = { tier: number, count: number }

-- Where a newly produced orb of `tier` goes when the pen holds `balls`: nil means it lands as a
-- new ball (the pen is below `cap`); otherwise the index of the ball it joins. Balls of the same
-- tier are preferred, then the lowest count; `roll` (0..1, optional) breaks ties so the counts
-- spread over the pen instead of piling onto one ball.
function OrbLook.feedTarget(balls: { Ball }, tier: number?, cap: number, roll: number?): number?
	if #balls < cap or #balls == 0 then
		return nil
	end
	local t = tier or 1
	local sameTier = false
	for _, ball in balls do
		if ball.tier == t then
			sameTier = true
			break
		end
	end
	local lowest = math.huge
	for _, ball in balls do
		if (not sameTier or ball.tier == t) and ball.count < lowest then
			lowest = ball.count
		end
	end
	local ties = {}
	for i, ball in balls do
		if (not sameTier or ball.tier == t) and ball.count == lowest then
			table.insert(ties, i)
		end
	end
	local k = math.clamp(math.floor((roll or 0) * #ties) + 1, 1, #ties)
	return ties[k]
end

-- sRGB 0-255 of the "xN" tag text for a ball painted (r, g, b): the colour lifted halfway to
-- white so it reads on the ball, or plain white when the ball is already pale.
function OrbLook.tagRGB(r: number, g: number, b: number): (number, number, number)
	local luma = (0.299 * r + 0.587 * g + 0.114 * b) / 255
	if luma > 0.78 then
		return 255, 255, 255
	end
	local function lift(c: number): number
		return math.floor(c + (255 - c) * 0.5 + 0.5)
	end
	return lift(r), lift(g), lift(b)
end

-- Slowest roll the client uses: starts at 6 studs/s, accelerates at 14 up to 18.
local V0, ACCEL, VMAX = 6, 14, 18
local HOP_FALL = 0.45 + 0.7
local LANDING = 0.26 + 0.16 + 1.2 -- two bounces + the longest floor glide

function OrbLook.travelTime(length: number, queue: number?): number
	local reachT = (VMAX - V0) / ACCEL
	local reachD = V0 * reachT + 0.5 * ACCEL * reachT * reachT
	local roll
	if length <= reachD then
		roll = (-V0 + math.sqrt(V0 * V0 + 2 * ACCEL * math.max(0, length))) / ACCEL
	else
		roll = reachT + (length - reachD) / VMAX
	end
	return HOP_FALL + roll + LANDING + math.clamp(queue or 0, 0, 2.5)
end

-- Seconds from spawn until Auto Aura collects the orb: lands, rests SETTLE, capped at 12 s.
function OrbLook.autoCollectDelay(length: number, queue: number?): number
	return math.min(OrbLook.travelTime(length, queue) + OrbLook.SETTLE, 12)
end

-- Tank credit for a set of collected orb values. Walking over orbs and Auto Aura both credit
-- through this, so the same orbs are worth exactly the same either way.
function OrbLook.credit(values: { number }): number
	local sum = 0
	for _, v in values do
		sum += v
	end
	return sum
end

return OrbLook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="165">
        <Properties>
          <string name="Name">Poses</string>
          <string name="Source"><![CDATA[--[[
	Poses: the procedural animation library for unit models.

	Pure Luau (CFrame maths only, no services or instances), so the same code
	runs in the client Animator and in the Lune preview exporter.

	Rig: every unit is a 15-limb R15-style rig (see LIMBS). Each limb rotates
	about a joint pivot. Pivots are positions relative to the model's Root part
	(the feet) and are written onto the model by CharacterFactory. At rest every
	limb frame is CFrame.new(pivot) with no rotation, so a joint transform is
	simply the rotation applied at that pivot:

	  frame[limb] = frame[parent] * CFrame.new(pivot[limb] - pivot[parent]) * transform[limb]

	Axes (model space): +X is the unit's right, +Y up, the unit faces -Z.
	Pose angles are degrees, applied as CFrame.Angles(x, y, z) (Z first, then Y,
	then X). Useful directions for the right arm/leg (left limbs are mirrored):
	  UpperArm  +z raises the arm sideways, +x raises it forwards, +y swings a
	            raised arm forwards
	  LowerArm  +x bends the elbow forwards, +z bends it outwards/up
	  UpperLeg  +x lifts the knee forwards, +z spreads the leg
	  LowerLeg  -x bends the knee
	  Torso     +x leans back, +y turns to the unit's left
	  Head      +x looks up, +y turns to the unit's left

	Animation: each animation set ("Chad" / "Bot" / "Fan" / "Story") is a looping
	sequence of poses held for a couple of seconds with eased blends between
	them, plus an idle overlay (breathing / hovering / bouncing). The sequence
	order and phase come from a per-model seed so a shelf of units never moves
	in sync.

	Explicit poses (cutscenes, code-driven models): samplePose / samplePoseInto
	give one named pose, blendInto mixes two, and the Walk / Run / Strut gaits
	are cycles of time; gaitTime(gait, distance, scale) turns the distance a
	model has travelled into the time that keeps its feet planted. Pose names
	are looked up in the model's set first, then in Story, Fan, Chad and Bot.
]]

local Poses = {}

Poses.LIMBS = {
	"LowerTorso",
	"UpperTorso",
	"Head",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
}

Poses.PARENT = {
	UpperTorso = "LowerTorso",
	Head = "UpperTorso",
	LeftUpperArm = "UpperTorso",
	LeftLowerArm = "LeftUpperArm",
	LeftHand = "LeftLowerArm",
	RightUpperArm = "UpperTorso",
	RightLowerArm = "RightUpperArm",
	RightHand = "RightLowerArm",
	LeftUpperLeg = "LowerTorso",
	LeftLowerLeg = "LeftUpperLeg",
	LeftFoot = "LeftLowerLeg",
	RightUpperLeg = "LowerTorso",
	RightLowerLeg = "RightUpperLeg",
	RightFoot = "RightLowerLeg",
}

-- Attribute names CharacterFactory writes on each unit model.
Poses.PIVOT_PREFIX = "J_" -- Vector3 joint pivot per limb, relative to Root, before scaling
Poses.SCALE_ATTRIBUTE = "RigScale"
Poses.SET_ATTRIBUTE = "AnimSet"
Poses.LIMB_ATTRIBUTE = "Limb"
Poses.TAG = "AnimatedUnit"

local LIMBS = Poses.LIMBS
local N = #LIMBS
local SIZE = N * 3 + 1 -- three angles per limb, then the root's vertical offset
local ROOT_Y = SIZE

local INDEX: { [string]: number } = {}
for i, limb in LIMBS do
	INDEX[limb] = i
end

local MIRROR = {
	LeftUpperArm = "RightUpperArm",
	LeftLowerArm = "RightLowerArm",
	LeftHand = "RightHand",
	LeftUpperLeg = "RightUpperLeg",
	LeftLowerLeg = "RightLowerLeg",
	LeftFoot = "RightFoot",
}

type Vec = { number }
type PoseDef = {
	base: Vec,
	anim: ((v: Vec, t: number, seed: number) -> ())?,
}

-- Builds a pose vector. Right-side limbs are mirrored onto the left unless
-- the left limb is given explicitly.
local function P(def: { [string]: { number } }, rootY: number?): Vec
	local v = table.create(SIZE, 0)
	local function set(limb: string, x: number, y: number, z: number)
		local i = INDEX[limb] * 3
		v[i - 2], v[i - 1], v[i] = x, y, z
	end
	for limb, a in def do
		set(limb, a[1] or 0, a[2] or 0, a[3] or 0)
	end
	for left, right in MIRROR do
		local a = def[right]
		if def[left] == nil and a then
			set(left, a[1] or 0, -(a[2] or 0), -(a[3] or 0))
		end
	end
	v[ROOT_Y] = rootY or 0
	return v
end

local function add(v: Vec, limb: string, x: number, y: number, z: number)
	local i = INDEX[limb] * 3
	v[i - 2] += x
	v[i - 1] += y
	v[i] += z
end

-- Deterministic 0..1 noise.
local function hash(n: number): number
	local x = math.sin(n * 12.9898 + 78.233) * 43758.5453
	return x - math.floor(x)
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function easeInOutCubic(a: number): number
	a = math.clamp(a, 0, 1)
	if a < 0.5 then
		return 4 * a * a * a
	end
	local f = -2 * a + 2
	return 1 - f * f * f / 2
end

-- Stepped random value that snaps to a new target every `period` seconds
-- (servo-like), easing over `snap` seconds.
local function servo(t: number, period: number, snap: number, seed: number, lo: number, hi: number): number
	local k = math.floor(t / period)
	local a = lo + (hi - lo) * hash(k * 7.13 + seed)
	local b = lo + (hi - lo) * hash((k - 1) * 7.13 + seed)
	local w = smooth((t - k * period) / snap)
	return b + (a - b) * w
end

