	["props/YogaBall"] = {
		id = "rbxassetid://135099897931092",
		model = "rbxassetid://114693396389988",
		size = Vector3.new(2.397, 2.204, 2.398),
	},
}

local Icons: { [string]: Icon } = {
	["AuraPack1"] = { image = "rbxassetid://124009831336881", x = 0, y = 0, w = 204, h = 204 },
	["AuraPack2"] = { image = "rbxassetid://124009831336881", x = 204, y = 0, w = 204, h = 204 },
	["AuraPack3"] = { image = "rbxassetid://124009831336881", x = 408, y = 0, w = 204, h = 204 },
	["AuraPack4"] = { image = "rbxassetid://124009831336881", x = 612, y = 0, w = 204, h = 204 },
	["CashPack1"] = { image = "rbxassetid://124009831336881", x = 816, y = 0, w = 204, h = 204 },
	["CashPack2"] = { image = "rbxassetid://124009831336881", x = 0, y = 204, w = 204, h = 204 },
	["CashPack3"] = { image = "rbxassetid://124009831336881", x = 204, y = 204, w = 204, h = 204 },
	["CashPack4"] = { image = "rbxassetid://124009831336881", x = 408, y = 204, w = 204, h = 204 },
