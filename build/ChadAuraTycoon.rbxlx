} :: { Map }

local function round2(x: number): number
	return math.floor(x * 100 + 0.5) / 100
end

local function lerp(a: number, b: number, t: number): number
	return round2(a + (b - a) * t)
end

-- The difficulty table: level 2 (t = 0) to level 10 (t = 1).
Course.TUNING = {} :: { [number]: Tuning }
for n = 2, Course.LEVEL_COUNT do
	local t = (n - 2) / (Course.LEVEL_COUNT - 2)
	local b = (n - 4) / (Course.LEVEL_COUNT - 4)
	Course.TUNING[n] = {
		gap = lerp(5.5, 8.3, t),
		discR = lerp(5.5, 4.6, t),
		beamW = lerp(5, 3, t),
		padSize = lerp(12, 9.5, t),
		checkpointR = lerp(6, 5, t),
		moverTravel = lerp(3, 7, t),
		moverPeriod = lerp(5, 2.6, t),
		spinSpeed = lerp(1.2, 2.8, t),
		spinBars = 1 + (n - 2) // 3,
		checkpointEvery = 4 + (n - 2) // 2,
		pathLength = 24 + 4 * (n - 2),
		rise = lerp(1.5, Course.MAX_STEP_UP, t),
		blinkOn = if n >= 4 then lerp(3, 1.3, b) else nil,
		blinkPeriod = if n >= 4 then lerp(4.5, 3.3, b) else nil,
	}
end

-- Positions { x, y, z } an element takes along its motion (movers sampled, else itself).
function Course.poses(e: Element): { { number } }
	if e.kind ~= "mover" then
		return { { e.x, e.y, e.z } }
	end
	local axis, distance = e.axis :: { number }, e.distance :: number
	local out = {}
	for s = -1, 1, 0.125 do
		local d = distance * s
		table.insert(out, { e.x + axis[1] * d, e.y + axis[2] * d, e.z + axis[3] * d })
	end
	return out
end

local HEX_APOTHEM = math.sqrt(3) / 2

-- Is e measured as a rectangle (sx by sz)? Boxes and rings are; discs and hexes are round.
local function boxy(e: Element): boolean
	return e.shape == "box" or e.shape == "ring"
end

-- Edge-to-edge horizontal distance between element a at (ax, az) and b at (bx, bz). A hex
-- counts as a disc of its corner radius, or, with `inner`, of its flat-side radius (the
-- longest a jump onto or off it can be).
function Course.edgeGap(a: Element, ax: number, az: number, b: Element, bx: number, bz: number, inner: boolean?): number
	local function half(e: Element): (number, number, number)
		if boxy(e) then
			return (e.sx :: number) / 2, (e.sz :: number) / 2, 0
		end
		local r = e.r or 0
		return 0, 0, if inner and e.shape == "hex" then r * HEX_APOTHEM else r
	end
	local ahx, ahz, ar = half(a)
	local bhx, bhz, br = half(b)
	local dx = math.max(0, math.abs(ax - bx) - ahx - bhx)
	local dz = math.max(0, math.abs(az - bz) - ahz - bhz)
	return math.sqrt(dx * dx + dz * dz) - ar - br
end

-- Can a player jump from a to b at EVERY phase of their motion (no touching either)?
local function fits(a: Element, b: Element, jumpHeight: number?): boolean
	for _, pa in Course.poses(a) do
		for _, pb in Course.poses(b) do
			local gap = Course.edgeGap(a, pa[1], pa[3], b, pb[1], pb[3])
			local far = Course.edgeGap(a, pa[1], pa[3], b, pb[1], pb[3], true)
			if gap < 0.6 or far > Course.maxGap(pb[2] - pa[2], jumpHeight) then
				return false
			end
		end
	end
	return true
end

local function halfAlong(e: Element, alongX: boolean): number
	if boxy(e) then
		return (if alongX then e.sx :: number else e.sz :: number) / 2
	end
	return e.r :: number
end

-- Park-Miller LCG in [0, 1).
local function rng(seed: number): () -> number
	local s = seed % 2147483646 + 1
	return function(): number
		s = s * 16807 % 2147483647
		return (s - 1) / 2147483646
	end
end

local LANE = 120 -- centre-x span of one serpentine lane
local Y_MIN, Y_MAX = 3, 30
local BOUNCE_POWER = 78
local BOUNCE_RISE = 8
-- Nothing of a generated map reaches past this local x: the start deck's back edge (x = -6)
-- less 2 studs, so the bridge from the previous map arrives over open sky.
local X_FLOOR = -8
-- Apex of a bounce launch, less the 3 studs from the pad to the feet landing height.
local BOUNCE_HEIGHT = BOUNCE_POWER * BOUNCE_POWER / (2 * Course.GRAVITY) - 3

-- Scenery keeps PROP_CLEARANCE studs (horizontally) between its footprint and every path
-- element at every phase. Props standing on an island share its footprint; the giant
-- rainbow arch stands over the bridge into its map on purpose (only its feet keep clear).
Course.PROP_CLEARANCE = 4
-- Footprint radius of each kind at scale 1 (island: r, its radius).
Course.PROP_FOOT = {
	island = 1,
	lighthouse = 5,
	windmill = 7,
	tree = 3,
	balloon = 6,
	cloud = 11.5,
	star = 2,
	rainbowarch = 9,
	landmark = 16,
	loop = 22,
	spiral = 11,
} :: { [string]: number }
-- How far each kind reaches above its y at scale 1 (Course bounds' top; landmark: the
-- tallest one).
Course.PROP_HEIGHT = {
	landmark = 82,
	balloon = 22,
	rainbowarch = 21,
	loop = 42,
	spiral = 38,
	cloud = 6.5,
} :: { [string]: number }
-- Sky clouds never come within CLOUD_CLEAR studs under the path: a `cloud` prop's top
-- (y + PROP_HEIGHT.cloud * scale) stays CLOUD_CLEAR under the lowest path top, or the cloud
-- sits CLOUD_BESIDE studs (beyond its footprint) off every element. The cloud floor floats
-- CLOUD_FLOOR_DEPTH studs under the lowest path top, CLOUD_FLOOR_SPREAD past the bounds.
Course.CLOUD_CLEAR = 30
Course.CLOUD_BESIDE = 40
Course.CLOUD_FLOOR_DEPTH = { 150, 220 }
Course.CLOUD_FLOOR_SPREAD = 80
-- The giant rainbow arch over the bridge into maps 1, 4, 7 and 10 (maps 1: behind its lobby
-- deck): scale, and its two cloud feet at +-ARCH_FEET[1] along the arch, ARCH_FEET[2] wide
-- (radius) at scale 1 (World.MapDecor rainbowarch).
Course.ARCH_SCALE = 2.5
Course.ARCH_FEET = { 15.2, 4.5 }
-- The other anchor set pieces beside the course: a rainbow loop (maps 2, 5, 8) and a spiral
-- rainbow stair (maps 3, 6, 9), at this scale.
Course.ANCHOR_SCALE = 1.5

function Course.propFoot(p: Prop): number
	if p.kind == "island" then
		return p.r or 0
	end
	return (Course.PROP_FOOT[p.kind] or 3) * (p.scale or 1)
end

-- Horizontal distance from (px, pz) to element e's footprint at the nearest phase of its
-- motion (negative inside it).
function Course.footDistance(e: Element, px: number, pz: number): number
	if e.kind == "slide" then
		local a, b = e.from :: { number }, e.to :: { number }
		local dx, dz = b[1] - a[1], b[3] - a[3]
		local t = math.clamp(((px - a[1]) * dx + (pz - a[3]) * dz) / math.max(1e-9, dx * dx + dz * dz), 0, 1)
		local cx, cz = a[1] + dx * t, a[3] + dz * t
		return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2) - (e.width or 0) / 2
	end
	local best = math.huge
	for _, pose in Course.poses(e) do
		local d
		if e.sx then
			local dx = math.max(0, math.abs(px - pose[1]) - (e.sx :: number) / 2)
			local dz = math.max(0, math.abs(pz - pose[3]) - (e.sz :: number) / 2)
			d = math.sqrt(dx * dx + dz * dz)
		else
			d = math.sqrt((px - pose[1]) ^ 2 + (pz - pose[3]) ^ 2) - (e.r or (e.length or 0) / 2)
		end
		best = math.min(best, d)
	end
	return best
end

-- Smallest footprint distance from (x, z) to any element of the list.
local function clearOf(elements: { Element }, x: number, z: number): number
	local best = math.huge
	for _, e in elements do
		best = math.min(best, Course.footDistance(e, x, z))
	end
	return best
end

-- Uniform scale of each theme's landmark (World.MapDecor LANDMARKS), sizing it 110-145 studs
-- tall; its footprint is PROP_FOOT.landmark * scale. (The shark's fin arch stands on a wide
-- sea disc, so it grows a little less, to stay on its island.)
Course.LANDMARK_SCALE = {
	beach = 2.7,
	cove = 2.6,
	bay = 2.7,
	reef = 2.9,
	bubble = 2.7,
	coral = 2.6,
	shark = 3.2,
	storm = 2.6,
	volcano = 2.25,
	giga = 3,
} :: { [string]: number }
-- Islands: the landmark's is LANDMARK_ISLAND wide (radius), the others ISLAND_R.
Course.LANDMARK_ISLAND = 48
Course.ISLAND_R = { 28, 44 }

local function clearOfTaken(taken: { { number } }, x: number, z: number, foot: number): boolean
	for _, t in taken do
		if math.sqrt((x - t[1]) ^ 2 + (z - t[2]) ^ 2) < foot + t[3] + 1 then
			return false
		end
	end
	return true
end

-- Rectangle (x0, x1, z0, z1) covering every element's footprint at every phase.
local function footprint(elements: { Element }): (number, number, number, number)
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	local function cover(x: number, z: number, hx: number, hz: number)
		x0, x1 = math.min(x0, x - hx), math.max(x1, x + hx)
		z0, z1 = math.min(z0, z - hz), math.max(z1, z + hz)
	end
	for _, e in elements do
		if e.kind == "slide" then
			local w = (e.width or 0) / 2
			for _, point in { e.from :: { number }, e.to :: { number } } do
				cover(point[1], point[3], w, w)
			end
		else
			local half = e.r or (e.length or 0) / 2
			for _, pose in Course.poses(e) do
				cover(pose[1], pose[3], (e.sx or 2 * half) / 2, (e.sz or 2 * half) / 2)
			end
		end
	end
	return x0, x1, z0, z1
end

-- Lowest and highest path top at any phase.
local function pathHeights(elements: { Element }): (number, number)
	local lo, hi = math.huge, -math.huge
	for _, e in elements do
		if e.path then
			for _, pose in Course.poses(e) do
				lo, hi = math.min(lo, pose[2]), math.max(hi, pose[2])
			end
			for _, point in { e.from, e.to } do
				if point then
					lo, hi = math.min(lo, point[2]), math.max(hi, point[2])
				end
			end
		end
	end
	return lo, hi
end

-- What stands on each map's floating islands: the first carries the landmark, then (every
-- map but storm) a windmill island, and the map's extras.
local function islandCrews(theme: string): { { string } }
	local crews = { { "landmark" } }
	if theme == "beach" or theme == "cove" then
		table.insert(crews, { "windmill", "tree", "tree" })
		table.insert(crews, { "tree", "tree", "tree" })
	elseif theme == "bay" then
		table.insert(crews, { "windmill" })
		table.insert(crews, { "lighthouse" })
	elseif theme == "storm" then
		table.insert(crews, {})
	else
		table.insert(crews, { "windmill" })
		if theme == "reef" or theme == "coral" or theme == "giga" then
			table.insert(crews, {})
		end
	end
	return crews
end

local function propSpot(x0: number, x1: number, z0: number, z1: number, foot: number, rand: () -> number): (number, number)
	local x = if x1 - x0 > 2 * foot then x0 + foot + rand() * (x1 - x0 - 2 * foot) else (x0 + x1) / 2
	local z = if z1 - z0 > 2 * foot then z0 + foot + rand() * (z1 - z0 - 2 * foot) else (z0 + z1) / 2
	return round2(x), round2(z)
end

-- Does a rainbow arch (feet at y, centred on (x, z), spanning across `face`, at `scale`) stand
-- clear of `elements`: its two cloud feet PROP_CLEARANCE off every footprint, and every
-- element under its span inside the opening (ARCH_INNER) with 8 studs of headroom?
Course.ARCH_INNER = 9.6
Course.ARCH_OUTER = 21
function Course.archFits(elements: { Element }, x: number, y: number, z: number, face: { number }, scale: number): boolean
	local rx, rz = -face[2], face[1]
	local spread, feetR = Course.ARCH_FEET[1] * scale, Course.ARCH_FEET[2] * scale
	local inner, outer = Course.ARCH_INNER * scale, Course.ARCH_OUTER * scale
	for _, sign in { -1, 1 } do
		if clearOf(elements, x + rx * spread * sign, z + rz * spread * sign) < feetR + Course.PROP_CLEARANCE then
			return false
		end
	end
	for _, e in elements do
		if math.abs(e.x - x) + math.abs(e.z - z) < outer + 40 then
			for d = -outer, outer, 1 do
				if Course.footDistance(e, x + rx * d, z + rz * d) < 2.5 then
					local top = e.y + (if e.kind == "spinner" or e.kind == "wall" then 3 else 0)
					if math.abs(d) >= inner - 1 or top + 8 > y + math.sqrt(inner * inner - d * d) then
						return false
					end
				end
			end
		end
	end
	return true
end

-- A map's sky scenery in its local frame, deterministic from `rand`: 2-4 floating islands
-- just past the course's `side` edge (+1: +X, -1: -X) within the course's z span, never within
-- PROP_CLEARANCE of the path nor overlapping each other (one carries the landmark), its
-- anchor set piece beside them (a rainbow loop on maps 2, 5, 8, a spiral rainbow stair on
-- 3, 6, 9), 4-8 clouds (CLOUD_CLEAR under the path or CLOUD_BESIDE off it), 1-2 balloons
-- 25-40 studs above it, giga's stars and the giant rainbow arch over the bridge into maps 1,
-- 4, 7 and 10 (`face`: the local direction the start deck faces). Nothing but the arch
-- reaches past the course's z span, so the chain's bridges and neighbours stay clear.
local function placeScenery(
	elements: { Element },
	theme: string,
	index: number,
	side: number,
	face: { number },
	rand: () -> number
): { Prop }
	local fx0, fx1, fz0, fz1 = footprint(elements)
	local lo, hi = pathHeights(elements)
	local clearance = Course.PROP_CLEARANCE
	local cx, cz = (fx0 + fx1) / 2, (fz0 + fz1) / 2
	local props: { Prop } = {}
	local taken: { { number } } = {}
	local edge = if side > 0 then fx1 else fx0
	-- The frame the islands span (grows as they land).
	local ax0, ax1, az0, az1 = fx0, fx1, fz0, fz1
	-- A spot just past the course's side edge for something `foot` wide, clear of the path
	-- and of everything placed so far; nil when 200 tries find none.
	local function besideSpot(foot: number): (number?, number?)
		for attempt = 1, 200 do
			local x = round2(edge + side * (foot + clearance + 1 + rand() * (10 + 2 * attempt)))
			local _, z = propSpot(0, 0, fz0, fz1, foot, rand)
			if clearOf(elements, x, z) >= foot + clearance and clearOfTaken(taken, x, z, foot) then
				table.insert(taken, { x, z, foot })
				ax0, ax1 = math.min(ax0, x - foot), math.max(ax1, x + foot)
				az0, az1 = math.min(az0, z - foot), math.max(az1, z + foot)
				return x, z
			end
		end
		return nil, nil
	end
	local function facingCourse(x: number, z: number): number
		return round2(math.atan2(-(cx - x), -(cz - z)))
	end
	for _, crew in islandCrews(theme) do
		local landmark: Prop? = if crew[1] == "landmark"
			then { kind = "landmark", x = 0, y = 0, z = 0, scale = Course.LANDMARK_SCALE[theme] or 2.7 }
			else nil
		local lo_r, hi_r = Course.ISLAND_R[1], Course.ISLAND_R[2]
		local r = if landmark then Course.LANDMARK_ISLAND else round2(lo_r + (hi_r - lo_r) * rand())
		local foot = if landmark then math.max(r, Course.propFoot(landmark)) else r
		local x, z = besideSpot(foot)
		assert(x and z, `Course: no room for an island on map {index}`)
		local y = round2(lo - 6 - 10 * rand())
		table.insert(props, { kind = "island", x = x, y = y, z = z, r = r, yaw = round2(rand() * 2 * math.pi) })
		for k, kind in crew do
			local c: Prop = { kind = kind, x = x, y = y, z = z, scale = 1, yaw = round2(rand() * 2 * math.pi) }
			if landmark and k == 1 then
				c.scale = landmark.scale
				c.yaw = facingCourse(x, z)
			elseif kind == "windmill" then
				c.scale = round2(1.7 + 0.3 * rand())
			elseif kind == "lighthouse" then
				c.scale = 1.8
			elseif kind == "tree" then
				c.scale = round2(1.4 + 0.6 * rand())
			end
			if k > 1 then
				local angle = (k / #crew + 0.15 * rand()) * 2 * math.pi
				local dist = r - Course.propFoot(c) - 1.5
				c.x, c.z = round2(x + math.cos(angle) * dist), round2(z + math.sin(angle) * dist)
			end
			table.insert(props, c)
		end
	end
	-- The anchor set piece beside the islands, facing the course.
	local anchor = if index % 3 == 2 then "loop" elseif index % 3 == 0 then "spiral" else nil
	if anchor then
		local scale = Course.ANCHOR_SCALE
		local x, z = besideSpot(Course.PROP_FOOT[anchor] * scale)
		assert(x and z, `Course: no room for the {anchor} on map {index}`)
		local y = round2(if anchor == "loop" then lo - 4 - 6 * rand() else lo - 10 - 4 * rand())
		table.insert(props, { kind = anchor, x = x, y = y, z = z, scale = scale, yaw = facingCourse(x, z) })
	end
	-- Clouds: about half beside the course (CLOUD_BESIDE off every element, near path
	-- height), the rest under it, their tops CLOUD_CLEAR under the lowest path top.
	-- (Clouds keep off the islands and each other; the balloons above ignore them.)
	local low: { { number } } = {}
	local clouds = if theme == "storm" then 8 else 4 + math.floor(rand() * 4)
	for _ = 1, clouds do
		local beside = rand() < 0.5
		for attempt = 1, 80 do
			local scale = round2(1 + 0.8 * rand() * (1 - attempt / 80))
			local foot = Course.PROP_FOOT.cloud * scale
			local x, z = propSpot(ax0, ax1, az0, az1, foot, rand)
			local need = if beside and attempt <= 40 then Course.CLOUD_BESIDE + foot else 2
			if clearOf(elements, x, z) >= need and clearOfTaken(taken, x, z, foot) and clearOfTaken(low, x, z, foot) then
				local y = if need > 2
					then round2(lo - 6 - 16 * rand())
					else round2(lo - Course.CLOUD_CLEAR - 2 - Course.PROP_HEIGHT.cloud * scale - 14 * rand())
				table.insert(props, { kind = "cloud", x = x, y = y, z = z, scale = scale, yaw = round2(rand() * 2 * math.pi) })
				table.insert(low, { x, z, foot })
				break
			end
		end
	end
	-- Hot-air balloons high above, beside the course.
	local balloons = if rand() < 0.5 then 1 else 2
	for _ = 1, balloons do
		for _ = 1, 80 do
			local foot = Course.PROP_FOOT.balloon * 2
			local x, z = propSpot(ax0, ax1, az0, az1, foot, rand)
			if clearOf(elements, x, z) >= foot and clearOfTaken(taken, x, z, foot) then
				table.insert(props, { kind = "balloon", x = x, y = round2(hi + 25 + 15 * rand()), z = z, scale = 2 })
				table.insert(taken, { x, z, foot })
				break
			end
		end
	end
	if theme == "giga" then
		for _ = 1, 6 do
			for _ = 1, 80 do
				local scale = round2(1.5 + 0.7 * rand())
				local foot = Course.PROP_FOOT.star * scale
				local x, z = propSpot(ax0, ax1, az0, az1, foot, rand)
				if clearOf(elements, x, z) >= foot + clearance and clearOfTaken(taken, x, z, foot) then
					local y = round2(hi + 8 + 14 * rand())
					table.insert(props, { kind = "star", x = x, y = y, z = z, scale = scale, yaw = round2(rand() * 2 * math.pi) })
					table.insert(taken, { x, z, foot })
					break
				end
			end
		end
	end
	if index % 3 == 1 then
		-- The giant arch across the walking line, facing along the start: over the bridge into
		-- the map, as far back as its feet need to clear the course; map 1 (no bridge in)
		-- straddles its first lane where it fits.
		local s = elements[1]
		local spots: { { number } } = {}
		if index > 1 then
			for back = 15, 24, 0.5 do
				local along = (s.sx :: number) / 2 + back
				table.insert(spots, { s.x - face[1] * along, s.z - face[2] * along })
			end
		else
			for _, e in elements do
				if e.path and e ~= s and math.abs(e.z - s.z) < 1 then
					for k = 0, 32 do
						local shift = (if k % 2 == 0 then 1 else -1) * math.ceil(k / 2)
						table.insert(spots, { e.x, e.z + shift })
					end
				end
			end
		end
		local placed = false
		for _, spot in spots do
			local x, z = round2(spot[1]), round2(spot[2])
			if Course.archFits(elements, x, s.y, z, face, Course.ARCH_SCALE) then
				local yaw = round2(math.atan2(-face[1], -face[2]))
				table.insert(props, { kind = "rainbowarch", x = x, y = s.y, z = z, scale = Course.ARCH_SCALE, yaw = yaw })
				placed = true
				break
			end
		end
		assert(placed, `Course: no room for the rainbow arch on map {index}`)
	end
	return props
end

-- A map's local region: every element and prop footprint (the arch over the bridge aside)
-- grown by REGION_MARGIN; y is filled in when the map is placed.
local function localBounds(elements: { Element }, props: { Prop }): Box
	local x0, x1, z0, z1 = footprint(elements)
	for _, p in props do
		if p.kind ~= "rainbowarch" then
			local foot = Course.propFoot(p)
			x0, x1 = math.min(x0, p.x - foot), math.max(x1, p.x + foot)
			z0, z1 = math.min(z0, p.z - foot), math.max(z1, p.z + foot)
		end
	end
	local m = Course.REGION_MARGIN
	return { x0 = round2(x0 - m), x1 = round2(x1 + m), z0 = round2(z0 - m), z1 = round2(z1 + m), y0 = 0, y1 = 0 }
end

-- Highest local y anything of the map reaches (landmarks stand up to ~145 studs tall).
local function topOf(elements: { Element }, props: { Prop }): number
	local _, hi = pathHeights(elements)
	local top = hi + 40
	for _, p in props do
		top = math.max(top, p.y + (Course.PROP_HEIGHT[p.kind] or 15) * (p.scale or 1) + 5)
	end
	return round2(top)
end

-- Is box deck `e` at least 1 stud clear of every element but `except`, at every phase?
local function deckClear(elements: { Element }, except: Element, e: Element): boolean
	local hx, hz = (e.sx :: number) / 2, (e.sz :: number) / 2
	for _, o in elements do
		if o ~= except and math.abs(o.x - e.x) < hx + 45 and math.abs(o.z - e.z) < hz + 45 then
			for x = -hx, hx, 1 do
				for z = -hz, hz, 1 do
					if Course.footDistance(o, e.x + x, e.z + z) < 1 then
						return false
					end
				end
			end
		end
	end
	return true
end

-- Kill elements (lava) on map n's wide path decks, in its local frame: up to 1 + n // 3 of
-- them (Course.killCount), at most KILL_PER_DECK per deck, KILL_SPACING studs clear of each
-- other; fewer when the decks run out. A deck qualifies when it is a plain box pad (not the start/finish deck, a
-- rest deck, mover, blink pad or ring) at least KILL_MIN_DECK long along the walking axis
-- (the direction from the previous path element). A strip lies across the deck KILL_WIDTH
-- wide, leaving KILL_CLEAR studs of the deck free on each side along the walking axis and
-- KILL_GAP studs from every wall and bounce pad on it; a deck KILL_SLIDE_DECK long or more
-- with no wall or bounce pad may instead carry a sliding bar (centre of the deck, moving
-- +-(extent / 2 - KILL_CLEAR) along the walking axis). Decks with spinners (they already guard
-- them) carry lava only when the map has no other deck.
Course.KILL_WIDTH = 1.6
Course.KILL_PER_DECK = 2
Course.KILL_SPACING = 6
Course.KILL_HEIGHT = 0.6
Course.KILL_CLEAR = 4
Course.KILL_GAP = 2
Course.KILL_MIN_DECK = 16
Course.KILL_SLIDE_DECK = 20

function Course.killCount(n: number): number
	return if n >= 2 then 1 + n // 3 else 0
end

local function placeKills(elements: { Element }, n: number, rand: () -> number): { Element }
	local want = Course.killCount(n)
	if want == 0 then
		return {}
	end
	type Spot = { deck: Element, alongX: boolean, length: number, offsets: { number }, slide: boolean, used: { number } }
	local w = Course.KILL_WIDTH / 2
	local calmSpots, busySpots = {} :: { Spot }, {} :: { Spot }
	local before: Element? = nil
	for _, e in elements do
		if not e.path then
			continue
		end
		local from = before
		before = e
		if
			not from
			or e.kind ~= "pad"
			or e.shape ~= "box"
			or e.name == "StartDeck"
			or e.name == "FinishDeck"
			or e.name == "Bridge"
			or e.name == "RestDeck"
		then
			continue
		end
		local alongX = math.abs(e.x - from.x) >= math.abs(e.z - from.z)
		local length = (if alongX then e.sx else e.sz) :: number
		if length < Course.KILL_MIN_DECK then
			continue
		end
		-- Walls and bounce pads on this deck ({ along-axis offset, half extent }), and spinners.
		local blocks: { { number } } = {}
		local spinners = false
		for _, o in elements do
			local on = math.abs(o.y - e.y) < 0.01
				and math.abs(o.x - e.x) <= (e.sx :: number) / 2
				and math.abs(o.z - e.z) <= (e.sz :: number) / 2
			if on and o.kind == "wall" then
				table.insert(blocks, { if alongX then o.x - e.x else o.z - e.z, ((if alongX then o.sx else o.sz) :: number) / 2 })
			elseif on and o.kind == "bounce" then
				table.insert(blocks, { if alongX then o.x - e.x else o.z - e.z, o.r :: number })
			elseif on and o.kind == "spinner" then
				spinners = true
			end
		end
		-- Strip centres every 0.2 studs, KILL_CLEAR from both ends and KILL_GAP from blocks.
		local limit = length / 2 - Course.KILL_CLEAR - w
		local offsets = {}
		for k = -math.floor(limit * 5 + 1e-6), math.floor(limit * 5 + 1e-6) do
			local c = k / 5
			local ok = true
			for _, b in blocks do
				ok = ok and math.abs(c - b[1]) - w - b[2] >= Course.KILL_GAP - 1e-6
			end
			if ok then
				table.insert(offsets, c)
			end
		end
		local slide = length >= Course.KILL_SLIDE_DECK and #blocks == 0
		if #offsets > 0 or slide then
			local spot = { deck = e, alongX = alongX, length = length, offsets = offsets, slide = slide, used = {} }
			table.insert(if spinners then busySpots else calmSpots, spot)
		end
	end
	local kills: { Element } = {}
	local function add(spot: Spot, slide: boolean, offset: number)
		local e = spot.deck
		local across = (if spot.alongX then e.sz else e.sx) :: number
		local kill: Element = {
			kind = "kill",
			x = if spot.alongX then round2(e.x + offset) else e.x,
			y = e.y,
			z = if spot.alongX then e.z else round2(e.z + offset),
			sx = if spot.alongX then Course.KILL_WIDTH else across,
			sz = if spot.alongX then across else Course.KILL_WIDTH,
			h = Course.KILL_HEIGHT,
			color = "Lava",
		}
		if slide then
			kill.motion = "slide"
			kill.axis = if spot.alongX then { 1, 0, 0 } else { 0, 0, 1 }
			kill.distance = round2(spot.length / 2 - Course.KILL_CLEAR)
			kill.period = round2(4 + 2 * rand())
			kill.phase = round2(rand() * 2 * math.pi)
			spot.offsets = {}
		end
		table.insert(spot.used, offset)
		table.insert(kills, kill)
	end
	-- Strip centres on a deck still KILL_SPACING (plus both half widths) from its other strips.
	local function free(spot: Spot): { number }
		local out = {}
		if #spot.used >= Course.KILL_PER_DECK then
			return out
		end
		for _, c in spot.offsets do
			local ok = true
			for _, u in spot.used do
				ok = ok and math.abs(c - u) >= 2 * w + Course.KILL_SPACING - 1e-6
			end
			if ok then
				table.insert(out, c)
			end
		end
		return out
	end
	-- One per deck, picked at random (spinner decks only when there is no other); then, if
	-- decks run short, a second strip on decks that already have one.
	local order: { Spot } = {}
	local list = if #calmSpots > 0 then calmSpots else busySpots
	-- (A sliding bar takes its whole deck: none when decks are short.)
	local plenty = #list >= want
	do
		while #kills < want and #list > 0 do
			local spot = table.remove(list, 1 + math.floor(rand() * #list)) :: Spot
			table.insert(order, spot)
			local slide = spot.slide and (#spot.offsets == 0 or (plenty and rand() < 0.5))
			add(spot, slide, if slide then 0 else spot.offsets[1 + math.floor(rand() * #spot.offsets)])
		end
	end
	local progress = true
	while #kills < want and progress do
		progress = false
		for _, spot in order do
			local room = free(spot)
			if #kills < want and #room > 0 then
				add(spot, false, room[1 + math.floor(rand() * #room)])
				progress = true
			end
		end
	end
	assert(#kills >= 1, `Course.generate: level {n} has no deck for lava`)
	return kills
end

-- One map before it is placed: everything in its local frame.
type Local = {
	n: number,
	elements: { Element },
	props: { Prop },
	bounds: Box,
	start: Element,
	finish: Element,
	startFace: { number }, -- local { x, z } the start deck faces
	exit: { number }, -- local { x, z } the runner leaves the finish deck along
	arch: { number }, -- local { x, z } of the finish arch
	top: number,
	tuning: Tuning?,
}

local KINDS = { "pad", "disc", "beam", "slide", "bob", "spinner", "walls", "blink", "ramp" }
-- Kinds never placed right after a mover/blink pad, a bounce or near a lane's turn.
local LIVELY = { slide = true, bob = true, blink = true, ramp = true }

local function finalize(level: Level)
	level.PATH, level.KILLS = {}, {}
	for _, element in level.ELEMENTS do
		if element.path then
			table.insert(level.PATH, element)
		end
		if element.kind == "kill" then
			table.insert(level.KILLS, element)
		end
	end
	level.PATH_LENGTH = Course.pathLength(level)
	level.MIN_SECONDS = level.PATH_LENGTH / Course.MAX_PLAUSIBLE_SPEED
end

-- Lays out level n (2..LEVEL_COUNT) in its local frame from TUNING[n] and its map's recipe
-- (Course.MAPS[n].recipe); same result on every call.
local function generateLocal(n: number): Local
	local T = Course.TUNING[n]
	local map = Course.MAPS[n]
	local R = map.recipe :: Recipe
	local pal = Course.PALETTES[n]
	local rand = rng(n * 7919 + 17)
	local gapTarget = R.gap or T.gap
	local rise = R.rise or T.rise
	local climb = R.climb or 0
	local yMax = R.yMax or Y_MAX
	local bounceCount = R.bounces or 1
	local bounceRise = R.bounceRise or BOUNCE_RISE
	local beamLength = R.beamLength or 16
	local lane = R.lane or LANE
	local checkpointEvery = R.checkpointEvery or T.checkpointEvery
	local spinBars = R.spinBars or T.spinBars
	local moverTravel = R.moverTravel or T.moverTravel
	local moverPeriod = R.moverPeriod or T.moverPeriod
	local elements: { Element } = {}
	local count = 0
	local function add(e: Element)
		table.insert(elements, e)
		if e.path then
			count += 1
		end
	end
	local prev = box(0, Y_MIN + 2, 0, 12, 12, pal.main, "StartDeck")
	add(prev)
	local dir, laneStart, laneZ, turnLeft = 1, 0, 0, 0
	-- Studs one more element may take along a lane (the widest kind, its gap and a turn
	-- pad's overhang): lanes heading back -X turn before anything reaches X_FLOOR, behind the
	-- start deck, where the bridge from the previous map arrives.
	local reach = math.max(beamLength, 8 + 9 * spinBars, 26) + gapTarget + 6
	local function room(): number
		local left = lane - (prev.x - laneStart) * dir
		if dir < 0 then
			left = math.min(left, prev.x - halfAlong(prev, true) - reach - X_FLOOR)
		end
		return left
	end
	local sinceCp, bounced, afterBounce = 0, 0, false
	local plainPads = 0
	while count < T.pathLength do
		if turnLeft == 0 and room() <= 0 then
			turnLeft = 2
		end
		local turning = turnLeft > 0
		local kind
		if count == T.pathLength - 1 then
			kind = "finish"
		elseif sinceCp >= checkpointEvery - 1 then
			kind = "rest"
		elseif turning then
			kind = "pad"
		elseif bounced < bounceCount and count >= T.pathLength * (bounced + 1) // (bounceCount + 1) and not afterBounce then
			kind = "bounce"
		else
			-- No two moving/blinking pads in a row, none right after a bounce, and no
			-- sideways slider where the lane turns (it would slide into the turn pad).
			local left = room()
			-- (nor right before the finish deck, which steps off sideways).
			local calm = prev.kind == "mover" or prev.kind == "blink" or afterBounce or left <= 24 or count >= T.pathLength - 2
			local rampOk = not calm
				and left > 32
				and count < T.pathLength - 3
				and prev.y >= Y_MIN + 2.5
				and (
					(prev.kind == "pad" and prev.shape ~= "hex" and (prev.name == nil or prev.name == "Beam" or prev.name == "StartDeck"))
					or prev.name == "RestDeck"
				)
			local function weight(k: string): number
				if (calm and LIVELY[k]) or (k == "ramp" and not rampOk) or (k == "blink" and not T.blinkOn) then
					return 0
				end
				return R.weights[k] or 0
			end
			local total = 0
			for _, k in KINDS do
				total += weight(k)
			end
			local pick = rand() * total
			kind = "pad"
			for _, k in KINDS do
				local w = weight(k)
				if w > 0 then
					pick -= w
					if pick < 0 then
						kind = k
						break
					end
				end
			end
			-- Blink maps: every k-th plain pad blinks, so blink pads never run dry.
			if kind == "pad" and T.blinkOn and R.blinkEvery and not calm then
				plainPads += 1
				if plainPads % R.blinkEvery == 0 then
					kind = "blink"
				end
			end
		end
		local size = T.padSize
		local colour = if count % 2 == 0 then pal.main else pal.alt
		if kind == "ramp" then
			-- A slide from prev's far edge down onto a landing pad, straight along the lane.
			local drop = round2(math.min(prev.y - Y_MIN, 2.5 + 2.5 * rand()))
			local length = round2(12 + 4 * rand())
			local fromX = prev.x + dir * halfAlong(prev, true)
			local toX = fromX + dir * length
			local ramp: Element = {
				kind = "slide",
				x = round2((fromX + toX) / 2),
				y = round2(prev.y - drop / 2),
				z = prev.z,
				from = { fromX, prev.y, prev.z },
				to = { toX, round2(prev.y - drop), prev.z },
				width = 6,
				color = pal.accent,
				path = true,
			}
			local landing = box(round2(toX + dir * size / 2), round2(prev.y - drop), prev.z, size, size + 1, colour)
			add(ramp)
			add(landing)
			sinceCp += 2
			afterBounce = false
			prev = landing
			continue
		end
		local e: Element
		local extras: { Element } = {}
		if kind == "finish" then
			e = box(0, 0, 0, 16, 14, pal.main, "FinishDeck")
		elseif kind == "rest" then
			e = restPad(0, 0, 0, T.checkpointR, pal.checkpoint)
		elseif kind == "disc" then
			-- Every other round tile or so is a big hex.
			e = if rand() < 0.45 then hex(0, 0, 0, round2(6 + rand()), colour) else disc(0, 0, 0, T.discR, colour)
		elseif kind == "beam" then
			e = box(0, 0, 0, beamLength, T.beamW, colour, "Beam")
		elseif kind == "slide" or kind == "bob" then
			local bob = kind == "bob"
			e = box(0, 0, 0, size, size, pal.mover)
			e.kind, e.name = "mover", nil
			e.motion = if bob then "bob" else "slide"
			e.axis = if bob then { 0, 1, 0 } else { 0, 0, 1 }
			e.distance = if bob then round2(moverTravel / 2) else moverTravel
			e.period = moverPeriod
			e.phase = round2(rand() * 2 * math.pi)
		elseif kind == "blink" then
			e = box(0, 0, 0, size, size, pal.blink)
			e.kind = "blink"
			e.on, e.period = T.blinkOn, T.blinkPeriod
			e.phase = round2(rand() * (T.blinkPeriod :: number))
		elseif kind == "spinner" then
			e = box(0, 0, 0, 8 + 9 * spinBars, 12, colour, "SweeperDeck")
			for k = 1, spinBars do
				local sign = if k % 2 == 0 then -1 else 1
				local bar = { kind = "spinner", x = (k - (spinBars + 1) / 2) * 9, y = 0, z = 0, length = 10 }
				bar.speed, bar.phase = sign * T.spinSpeed, round2(k * 1.3)
				table.insert(extras, bar :: Element)
			end
		elseif kind == "walls" then
			e = box(0, 0, 0, 20, size + 3, colour, "WallHopDeck")
			for k = -1, 1 do
				table.insert(extras, { kind = "wall", x = k * 6, y = 0, z = 0, sx = 1.2, sz = size + 3, h = 2.4, color = pal.accent })
			end
		elseif kind == "bounce" then
			bounced += 1
			e = box(0, 0, 0, 10, size + 2, colour, "BounceDeck")
			table.insert(extras, { kind = "bounce", x = 0, y = 0, z = 0, r = 2.5, power = BOUNCE_POWER, color = pal.accent })
		elseif not turning and rand() < 0.35 then
			e = ring(0, 0, 0, round2(12 + 2 * rand()), colour)
		else
			e = box(0, 0, 0, size, size, colour)
		end
		-- Height change and spacing: the widest gap up to the target that is fair at every
		-- phase; smaller steps if nothing fits.
		-- The finish deck always steps +Z off the last lane: the course's outer edge.
		local alongX = not turning and kind ~= "finish"
		local jumpHeight = if afterBounce then BOUNCE_HEIGHT else nil
		local wantUp = if afterBounce then bounceRise else math.min(Course.MAX_STEP_UP, (rand() * 2 - 1) * rise + climb)
		if prev.y + wantUp < Y_MIN then
			wantUp = -wantUp
		end
		wantUp = math.clamp(wantUp, Y_MIN - prev.y, yMax - prev.y)
		local target = gapTarget * (0.9 + 0.1 * rand())
		local jitter = if (e.shape == "disc" or e.shape == "hex") and alongX then (rand() * 2 - 1) * 1.5 else 0
		local placed = false
		for _, dy in { wantUp, wantUp / 2, 0, -1, -2.5, -4 } do
			e.y = round2(math.max(Y_MIN, prev.y + dy))
			local g = target
			while g >= 1 do
				local centre = halfAlong(prev, alongX) + g + halfAlong(e, alongX)
				if alongX then
					e.x, e.z = round2(prev.x + dir * centre), round2(laneZ + jitter)
				else
					e.x, e.z = prev.x, round2(prev.z + centre)
				end
				if fits(prev, e, jumpHeight) and (kind ~= "finish" or deckClear(elements, prev, e)) then
					placed = true
					break
				end
				g -= 0.2
			end
			if placed then
				break
			end
		end
		assert(placed, `Course.generate: no fair spot (level {n}, {kind} after {prev.kind}, turning {turning}, prev y {prev.y})`)
		for _, x in extras do
			x.x, x.y, x.z = e.x + x.x, e.y, e.z
		end
		add(e)
		for _, x in extras do
			add(x)
		end
		afterBounce = kind == "bounce"
		sinceCp = if kind == "rest" then 0 else sinceCp + 1
		if turning then
			turnLeft -= 1
			laneZ = e.z
			if turnLeft == 0 then
				dir, laneStart = -dir, e.x
			end
		end
		prev = e
	end

	local x0, _, _, z1 = footprint(elements)
	assert(x0 >= X_FLOOR - 1e-6, `Course.generate: level {n} reaches behind its start deck`)
	assert(z1 <= prev.z + (prev.sz :: number) / 2 + 1e-6, `Course.generate: level {n} finish is not its outer edge`)
	local props = placeScenery(elements, map.theme, n, 1, { 1, 0 }, rand)
	-- Lava last (after the scenery, from the same rng), so nothing above shifts.
	for _, kill in placeKills(elements, n, rand) do
		table.insert(elements, kill)
	end
	return {
		n = n,
		elements = elements,
		props = props,
		bounds = localBounds(elements, props),
		start = elements[1],
		finish = prev,
		startFace = { 1, 0 },
		exit = { 0, 1 },
		arch = { prev.x, prev.z },
		top = topOf(elements, props),
		tuning = T,
	}
end

-- Horizontal distance along the centres of consecutive path elements, start deck to finish
-- deck (Level.PATH_LENGTH; MIN_SECONDS divides it by MAX_PLAUSIBLE_SPEED).
function Course.pathLength(level: Level): number
	local path = level.PATH
	local total = 0
	for i = 1, #path - 1 do
		local a, b = path[i], path[i + 1]
		total += math.sqrt((a.x - b.x) ^ 2 + (a.z - b.z) ^ 2)
	end
	return total
end

local function copyElement(e: Element): Element
	local c = table.clone(e)
	for _, key in { "axis", "from", "to" } do
		local list = (e :: any)[key]
		if list then
			(c :: any)[key] = table.clone(list)
		end
	end
	return c
end

-- Level 1 in its local frame: LEVEL1_ELEMENTS as drawn (start deck at x = -197, z = 0,
-- facing west; the finish deck at the east end of the south lane, left eastward), its
-- islands on the west side.
local function level1Local(): Local
	local elements: { Element } = {}
	local finish: Element? = nil
	for _, e in LEVEL1_ELEMENTS do
		local c = copyElement(e)
		table.insert(elements, c)
		if c.path then
			finish = c
		end
	end
	local props = placeScenery(elements, Course.MAPS[1].theme, 1, -1, { -1, 0 }, rng(1 * 7919 + 17))
	return {
		n = 1,
		elements = elements,
		props = props,
		bounds = localBounds(elements, props),
		start = elements[1],
		finish = finish :: Element,
		startFace = { -1, 0 },
		exit = { 1, 0 },
		-- The runner comes off the slide at the deck's west edge.
		arch = { -204, -53 },
		top = topOf(elements, props),
		tuning = nil,
	}
end

local function buildLocal(n: number): Local
	return if n == 1 then level1Local() else generateLocal(n)
end

-- Where a map's local frame lands: world (x, z) = (ox, oz) + x * u + z * v and y + oy, with
-- u, v unit axes (a 90-degree turn, maybe mirrored). stageFirst / rainbowFirst: the map's
-- first global stage and its start deck's slot in the RAINBOW cycle.
type Frame = { u: { number }, v: { number }, ox: number, oz: number, oy: number, stageFirst: number, rainbowFirst: number }

local function toWorld(f: Frame, x: number, z: number): (number, number)
	return round2(f.ox + x * f.u[1] + z * f.v[1]), round2(f.oz + x * f.u[2] + z * f.v[2])
end

local function turnDir(f: Frame, x: number, z: number): (number, number)
	return x * f.u[1] + z * f.v[1] + 0, x * f.u[2] + z * f.v[2] + 0
end

local function boxToWorld(f: Frame, b: Box): Box
	local ax, az = toWorld(f, b.x0, b.z0)
	local bx, bz = toWorld(f, b.x1, b.z1)
	return {
		x0 = math.min(ax, bx),
		x1 = math.max(ax, bx),
		z0 = math.min(az, bz),
		z1 = math.max(az, bz),
		y0 = round2(b.y0 + f.oy),
		y1 = round2(b.y1 + f.oy),
	}
end

-- The frame of map `nextL` chained after map `L` (placed by `f`): its start deck BRIDGE_GAP
-- past L's finish deck along L's exit, its lanes running on along that direction and its
-- serpentine advancing to one side (flip = +1: left of the exit, -1: right), its start deck
-- (BRIDGE_STEPS + 1) * BRIDGE_RISE above L's finish deck.
local function nextFrame(f: Frame, L: Local, nextL: Local, flip: number): Frame
	local fin, s = L.finish, nextL.start
	local fx, fz = toWorld(f, fin.x, fin.z)
	local dx, dz = turnDir(f, L.exit[1], L.exit[2])
	local half = if math.abs(L.exit[1]) > 0.5 then (fin.sx :: number) / 2 else (fin.sz :: number) / 2
	local dist = half + Course.BRIDGE_GAP + (s.sx :: number) / 2
	local u = { dx, dz }
	local v = { -dz * flip + 0, dx * flip + 0 }
	local sx, sz = fx + dx * dist, fz + dz * dist
	return {
		u = u,
		v = v,
		ox = round2(sx - (s.x * u[1] + s.z * v[1])),
		oz = round2(sz - (s.x * u[2] + s.z * v[2])),
		oy = round2(fin.y + f.oy + (Course.BRIDGE_STEPS + 1) * Course.BRIDGE_RISE - s.y),
		stageFirst = 0,
		rainbowFirst = 0,
	}
end

local function overlaps(a: Box, b: Box): boolean
	return not (a.x1 < b.x0 or b.x1 < a.x0 or a.z1 < b.z0 or b.z1 < a.z0)
end

-- The chain: map 1 as drawn (lifted so its start deck is at SKY_Y), then every next map on
-- the side that keeps the regions apart and the whole chain within 2 * CHAIN_LIMIT, trying
-- the staircase side (towards +X / +Z) first; finally the chain is centred on the origin.
local LOCALS: { Local } = {}
for n = 1, Course.LEVEL_COUNT do
	LOCALS[n] = buildLocal(n)
end
local FRAMES: { Frame } = {
	{ u = { 1, 0 }, v = { 0, 1 }, ox = 0, oz = 0, oy = round2(Course.SKY_Y - LOCALS[1].start.y), stageFirst = 1, rainbowFirst = 0 },
}
do
	local regions: { Box } = { boxToWorld(FRAMES[1], LOCALS[1].bounds) }
	local span = 2 * Course.CHAIN_LIMIT - 20
	local function solve(n: number): boolean
		if n > Course.LEVEL_COUNT then
			return true
		end
		local prev, L = FRAMES[n - 1], LOCALS[n - 1]
		local dx, dz = turnDir(prev, L.exit[1], L.exit[2])
		local first = if -dz + dx > 0 then 1 else -1
		for _, flip in { first, -first } do
			local f = nextFrame(prev, L, LOCALS[n], flip)
			local r = boxToWorld(f, LOCALS[n].bounds)
			local ok = true
			local x0, x1, z0, z1 = r.x0, r.x1, r.z0, r.z1
			for j = 1, n - 1 do
				local o = regions[j]
				ok = ok and not overlaps(r, o)
				x0, x1, z0, z1 = math.min(x0, o.x0), math.max(x1, o.x1), math.min(z0, o.z0), math.max(z1, o.z1)
			end
			if ok and x1 - x0 <= span and z1 - z0 <= span then
				FRAMES[n], regions[n] = f, r
				if solve(n + 1) then
					return true
				end
			end
		end
		FRAMES[n], regions[n] = nil :: any, nil :: any
		return false
	end
	assert(solve(2), "Course: the sky chain does not fit")
	local x0, x1, z0, z1 = math.huge, -math.huge, math.huge, -math.huge
	for _, r in regions do
		x0, x1, z0, z1 = math.min(x0, r.x0), math.max(x1, r.x1), math.min(z0, r.z0), math.max(z1, r.z1)
	end
	local shiftX, shiftZ = -math.floor((x0 + x1) / 2 + 0.5), -math.floor((z0 + z1) / 2 + 0.5)
	-- Global stages and rainbow slots run on from map to map (a bridge takes BRIDGE_STEPS).
	local stage, slot = 1, 0
	for n, f in FRAMES do
		f.ox, f.oz = round2(f.ox + shiftX), round2(f.oz + shiftZ)
		f.stageFirst, f.rainbowFirst = stage, slot
		local path = 0
		for _, e in LOCALS[n].elements do
			if e.path then
				path += 1
			end
		end
		stage += 1
		slot += path + Course.BRIDGE_STEPS
	end
	-- Map 10's finish deck.
	Course.STAGE_COUNT = stage
end

local function rainbow(slot: number): string
	return Course.RAINBOW[slot % #Course.RAINBOW + 1]
end

-- Turns map L (its tables, in place) into its world Level with frame f.
local function place(L: Local, f: Frame): Level
	local n = L.n
	local map = Course.MAPS[n]
	local swap = math.abs(f.u[1]) < 0.5
	local slot = f.rainbowFirst
	for _, e in L.elements do
		e.x, e.z = toWorld(f, e.x, e.z)
		e.y = round2(e.y + f.oy)
		if swap and e.sx then
			e.sx, e.sz = e.sz, e.sx
		end
		local axis = e.axis
		if axis then
			local ax, az = turnDir(f, axis[1], axis[3])
			e.axis = { ax, axis[2], az }
		end
		for _, key in { "from", "to" } do
			local point = (e :: any)[key]
			if point then
				local px, pz = toWorld(f, point[1], point[3]);
				(e :: any)[key] = { px, round2(point[2] + f.oy), pz }
			end
		end
		if e.path then
			if e.kind == "pad" or e.kind == "slide" then
				e.color = rainbow(slot)
			end
			slot += 1
		end
	end
	for _, p in L.props do
		p.x, p.z = toWorld(f, p.x, p.z)
		p.y = round2(p.y + f.oy)
		if p.yaw then
			local lx, lz = turnDir(f, -math.sin(p.yaw), -math.cos(p.yaw))
			p.yaw = round2(math.atan2(-lx, -lz))
		end
	end
	local s, fin = L.start, L.finish
	local faceX, faceZ = turnDir(f, L.startFace[1], L.startFace[2])
	local archX, archZ = toWorld(f, L.arch[1], L.arch[2])
	local archFaceX, archFaceZ = turnDir(f, -L.exit[1], -L.exit[2])
	local hx, hz = (fin.sx :: number) / 2, (fin.sz :: number) / 2
	local bounds = boxToWorld(f, L.bounds)
	bounds.y0, bounds.y1 = Course.FLOOR_Y - 30, round2(L.top + f.oy)
	local level: Level = {
		index = n,
		name = Course.NAMES[n],
		difficulty = n,
		remote = true,
		theme = map.theme,
		blurb = map.blurb,
		icon = map.icon,
		accent = map.accent,
		PROPS = L.props,
		palette = Course.PALETTES[n],
		ELEMENTS = L.elements,
		PATH = {},
		KILLS = {},
		STAGE_FIRST = f.stageFirst,
		STAGE_LAST = f.stageFirst + 1,
		START = { x = s.x, y = s.y, z = s.z, faceX = faceX, faceZ = faceZ },
		FINISH = { x0 = fin.x - hx, x1 = fin.x + hx, z0 = fin.z - hz, z1 = fin.z + hz, y0 = fin.y - 1, y1 = fin.y + 10 },
		FINISH_ARCH = { x = archX, y = fin.y, z = archZ, faceX = archFaceX, faceZ = archFaceZ },
		WATER_BOX = { x0 = bounds.x0, x1 = bounds.x1, z0 = bounds.z0, z1 = bounds.z1, y0 = Course.FLOOR_Y - 20, y1 = Course.FLOOR_Y },
		BOUNDS = bounds,
		PATH_LENGTH = 0,
		MIN_SECONDS = 0,
		TUNING = L.tuning,
	}
	finalize(level)
	return level
end

-- Builds level n (1..LEVEL_COUNT) afresh, placed on the chain; same result on every call.
function Course.generate(n: number): Level
	return place(buildLocal(n), FRAMES[n])
end

Course.LEVELS = {} :: { Level }
-- Each level's rectangle (its BOUNDS) and centre (x, z).
Course.REGIONS = {} :: { Box }
Course.CENTRES = {} :: { { number } }
for n = 1, Course.LEVEL_COUNT do
	local level = place(LOCALS[n], FRAMES[n])
	Course.LEVELS[n] = level
	Course.REGIONS[n] = level.BOUNDS
	local b = level.BOUNDS
	Course.CENTRES[n] = { round2((b.x0 + b.x1) / 2), round2((b.z0 + b.z1) / 2) }
end

-- The rainbow stairs: BRIDGES[n] joins map n's finish deck to map n + 1's start deck.
Course.BRIDGES = {} :: { { Element } }
for n = 1, Course.LEVEL_COUNT - 1 do
	local level, f = Course.LEVELS[n], FRAMES[n + 1]
	local fin = level.PATH[#level.PATH]
	local dx, dz = f.u[1], f.u[2]
	local alongX = math.abs(dx) > 0.5
	local half = if alongX then (fin.sx :: number) / 2 else (fin.sz :: number) / 2
	local steps, step = Course.BRIDGE_STEPS, Course.BRIDGE_STEP
	local gap = (Course.BRIDGE_GAP - steps * step) / (steps + 1)
	local list: { Element } = {}
	for k = 1, steps do
		local along = half + gap * k + step * (k - 0.5)
		local sx = if alongX then step else Course.BRIDGE_WIDTH
		local sz = if alongX then Course.BRIDGE_WIDTH else step
		local slot = FRAMES[n].rainbowFirst + #level.PATH + k - 1
		local x, z = round2(fin.x + dx * along), round2(fin.z + dz * along)
		table.insert(list, box(x, round2(fin.y + Course.BRIDGE_RISE * k), z, sx, sz, rainbow(slot), "Bridge"))
	end
	Course.BRIDGES[n] = list
end

-- The cloud floor far under a map (World draws it, never colliding: the WATER_BOX catch
-- volume at FLOOR_Y handles falls): 40-80 thin, wide, overlapping puffs, each an upright
-- cylinder { x, y, z, d (diameter), h (height) } with y its centre, in loose clusters on a
-- jittered grid with whole cells left open so the blue sky shows through. They spread
-- CLOUD_FLOOR_SPREAD studs past the map's bounds and float CLOUD_FLOOR_DEPTH studs under its
-- lowest path top (every part, top to bottom). Same result on every call.
export type Puff = { x: number, y: number, z: number, d: number, h: number }
function Course.cloudLayer(level: Level): { Puff }
	local lo = pathHeights(level.ELEMENTS)
	local b, spread = level.BOUNDS, Course.CLOUD_FLOOR_SPREAD
	local x0, x1, z0, z1 = b.x0 - spread, b.x1 + spread, b.z0 - spread, b.z1 + spread
	local w, d = x1 - x0, z1 - z0
	local top, bottom = lo - Course.CLOUD_FLOOR_DEPTH[1], lo - Course.CLOUD_FLOOR_DEPTH[2]
	-- About 28 cells; whole cells stay open (never more than 8 of them).
	local nx = math.clamp(math.floor(math.sqrt(28 * w / d) + 0.5), 3, 9)
	local nz = math.clamp(math.floor(28 / nx + 0.5), 3, 9)
	local cw, cd = w / nx, d / nz
	local rand = rng(level.index * 97 + 5)
	local puffs: { Puff } = {}
	local open, cells = 0, nx * nz
	local function add(x: number, y: number, z: number, dia: number, h: number)
		if #puffs < 80 then
			table.insert(puffs, { x = round2(x), y = round2(y), z = round2(z), d = round2(dia), h = round2(h) })
		end
	end
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			if rand() < 0.25 and open < math.min(8, cells - 20) then
				open += 1
				continue
			end
			local x = x0 + (i + 0.5 + (rand() - 0.5) * 0.4) * cw
			local z = z0 + (j + 0.5 + (rand() - 0.5) * 0.4) * cd
			local main = math.clamp(math.min(cw, cd) * (0.7 + 0.3 * rand()), 40, 120)
			local h = 6 + 2 * rand()
			local y = bottom + h / 2 + 4 + (top - bottom - h - 12) * rand()
			add(x, y, z, main, h)
			-- One or two smaller, taller puffs heaped on its edge.
			for _ = 1, if rand() < 0.5 then 1 else 2 do
				local a = rand() * 2 * math.pi
				local dia = math.clamp(main * (0.45 + 0.25 * rand()), 40, 120)
				local hh = 8 + 2 * rand()
				add(x + math.cos(a) * main * 0.3, y + 2.5, z + math.sin(a) * main * 0.3, dia, hh)
			end
		end
	end
	return puffs
end

function Course.level(i: number): Level
	return Course.LEVELS[math.clamp(math.floor(i), 1, Course.LEVEL_COUNT)]
end

-- The level whose stage `stage` is (clamped to 1..STAGE_COUNT): map n is stage n; the last
-- stage (STAGE_COUNT) is map 10's finish deck.
function Course.levelOfStage(stage: number): Level
	return Course.level(math.clamp(math.floor(stage), 1, Course.LEVEL_COUNT))
end

-- Is (x, z) outside every CLEAR rectangle (free for hub props)?
function Course.isClear(x: number, z: number): boolean
	for _, r in Course.CLEAR do
		if x >= r.x0 and x <= r.x1 and z >= r.z0 and z <= r.z1 then
			return false
		end
	end
	return true
end

local function inBox(b: Box, x: number, y: number, z: number): boolean
	return x >= b.x0 and x <= b.x1 and z >= b.z0 and z <= b.z1 and y >= b.y0 and y <= b.y1
end

function Course.inFinish(level: Level, x: number, y: number, z: number): boolean
	return inBox(level.FINISH, x, y, z)
end

function Course.inBounds(level: Level, x: number, y: number, z: number): boolean
	return inBox(level.BOUNDS, x, y, z)
end

-- Fell: feet below the cloud floor (the name stays from the sea days; x and z are unused).
function Course.inWater(_x: number, y: number, _z: number): boolean
	return y < Course.FLOOR_Y
end

-- Did a player's feet cross a start line inside gate 1's opening: westward at the first
-- plaza (-X) or eastward at the second (+X)?
function Course.crossedStart(prevX: number, x: number, z: number): boolean
	if prevX > Course.START_LINE_X and x <= Course.START_LINE_X then
		return math.abs(z - Course.GATES[1].z) <= Course.GATE_HALF + 1
	end
	if prevX < Course.START_LINE2_X and x >= Course.START_LINE2_X then
		return math.abs(z - Course.GATES2[1].z) <= Course.GATE_HALF + 1
	end
	return false
end

export type Spot = { x: number, y: number, z: number, faceX: number }

local function closer(a: Spot, b: Spot, x: number, z: number): Spot
	return if (x - b.x) ^ 2 + (z - b.z) ^ 2 < (x - a.x) ^ 2 + (z - a.z) ^ 2 then b else a
end

-- The quit spot (in front of the gates, facing the hub) of the plaza nearer to (x, z).
function Course.nearestQuit(x: number, z: number): Spot
	return closer(Course.QUIT, Course.QUIT2, x, z)
end

-- The arrival spot (the spur end, facing the gates) of the plaza nearer to (x, z).
function Course.nearestArrival(x: number, z: number): Spot
	return closer(Course.ARRIVAL, Course.ARRIVAL2, x, z)
end

-- Are a player's feet in one of the level's kill boxes at server time t (a sliding bar at
-- its pose then): inside it horizontally and y in [top - 0.5, top + h + 2.5]?
function Course.inKill(level: Level, x: number, y: number, z: number, t: number): boolean
	for _, k in level.KILLS do
		if y < k.y - 0.5 or y > k.y + (k.h or 0) + 2.5 then
			continue
		end
		local cx, cz = k.x, k.z
		if k.motion == "slide" then
			local axis = k.axis :: { number }
			local d = (k.distance :: number) * math.sin(2 * math.pi * t / (k.period :: number) + (k.phase or 0))
			cx, cz = cx + axis[1] * d, cz + axis[3] * d
		end
		if math.abs(x - cx) <= (k.sx :: number) / 2 and math.abs(z - cz) <= (k.sz :: number) / 2 then
			return true
		end
	end
	return false
end

-- Respawn spot on `level`: always its start deck (no checkpoints; every fall and lava touch
-- sends the runner back to the start of the map). Feet position { x, y, z } and the
-- horizontal direction { dx, dz } toward the next path element.
function Course.respawn(level: Level): ({ number }, { number })
	local start = level.START
	local at = { start.x, start.y, start.z }
	local nextElement: Element? = level.PATH[2]
	if not nextElement then
		return at, { start.faceX, start.faceZ }
	end
	local dx, dz = nextElement.x - at[1], nextElement.z - at[3]
	local length = math.max(1e-6, math.sqrt(dx * dx + dz * dz))
	return at, { dx / length, dz / length }
end

-- Beach props the hub must not place here (palms, beach balls): both plazas, their spurs
-- and the big signs behind the gates (the second mirrors the first).
Course.CLEAR = {
	{ x0 = -230, x1 = -138, z0 = -36, z1 = 36 },
	{ x0 = 138, x1 = 230, z0 = -36, z1 = 36 },
}

return Course
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="187">
          <Properties>
            <string name="Name">Mog</string>
            <string name="Source"><![CDATA[--[[
	Mog: the MOG TEST game mode, a skill-check duel on the MOG STAGE out at sea
	(World.MogStage, numbers in Modes.MogLayout, rules in Modes.MogRules).

	- The "ModeStart" action { mode = "mog", vs = "rivals" | "pvp" } starts a run. Without a
	  valid `vs` (walking west through gate 2, old clients) nothing starts: the client gets
	  { event = "choose" } and shows a picker that fires ModeStart again with `vs`.
	- vs = "rivals" (PvE): the player is teleported to a free duel spot (MogLayout.SPOTS;
	  refused when all are taken), facing a rival chad, and held still (HumanoidRootPart
	  anchored, no jumping) until the run ends.
	- Skill checks come one after another (MogRules.check); the client answers with the
	  "MogPress" action { id, at } (at = its workspace:GetServerTimeNow() at the press). The
	  server judges the press from `at`; a check nobody answers is a "timeout" miss.
	- Hits wear the rival down; a mogged rival makes way for a tougher one. Mogging
	  MogRules.PASS_RIVALS rivals passes the test and pays Economy.modeReward (same rules as
	  Parkour: first pass ever, then once per Economy.MODE_REWARD_COOLDOWN). The run then goes
	  on for a high score until the lives run out; afterwards the player is sent back to the
	  gates (GameModes.returnLater).
	- vs = "pvp": 1v1 against a real player. A player waiting in the queue is matched at once;
	  otherwise the player waits (not teleported, def.running is true) for QUEUE_TIMEOUT
	  seconds, then gets stop "noOpponent". The "MogCancel" action leaves the queue. A match
	  needs a whole free spot: the earlier-queued player (side A) stands on spot.player facing
	  inward, the other (side B) on spot.rival facing A; both are held still. Both get the same
	  check at the same time (the first PVP_FIRST_LEAD later), press once each (judged like
	  PvE), and the round ends when both answered or the needle lap timed out (MogRules
	  duelPress / duelRound: hit 1 damage to the opponent, perfect 2, miss 1 to yourself, all
	  at once; KO tie = sudden death at 1 HP). The winner is paid on the same cooldown as a PvE
	  pass, but never as a first clear: that one belongs to the first PvE pass
	  (MogRules.firstPass / countClear). Leaving, respawning, quitting or switching mode
	  mid-duel forfeits: the other side wins at once. So does letting
	  MogRules.PVP_IDLE_FORFEIT checks in a row time out (both sides idle: a draw, nobody
	  wins), and a duel still open after PVP_MAX_ROUNDS rounds goes to the higher HP, then the
	  higher score. PvP never goes on the TOP MOGGERS board.
	- A duel's checks are hidden: "check" carries no zone, and the zone follows in "zone" when
	  the needle starts (a client cannot work out the press before it can see the zone). A
	  press stamped sooner than MogRules.MIN_REACTION after the zone was sent is ignored.

	Notify payloads (kind = "Mode", mode = "mog"):
	  { event = "choose" }                           no `vs` given: show the rivals / PvP picker
	  { event = "start", vs = "rivals", lives, maxLives, startedAt, best, spot, playerPos, rivalPos, rival,
	    passRivals, score = 0 }                      playerPos / rivalPos: feet (Vector3)
	  { event = "check", id, n, appearAt, speed, dir, zoneStart, zoneSize, perfectSize,
	    duration }                                   sent `lead` seconds before appearAt
	  { event = "result", id, result, reason?, travel?, score, combo, lives, rivalHp, rivalMax }
	  { event = "rival", mogged, rival, rivals, passed, cash?, full? }
	  { event = "finish", score, rivals, best, newBest, passed, cash, full,
	    cooldownEnds, rank? }
	  { event = "stop", reason }                     ended without a finish ("full" = no free spot,
	                                                 "noOpponent" = queue timed out, "cancel")
	PvP payloads (every one carries vs = "pvp"; hp values are after the round):
	  { event = "queue", vs, since, timeout }        waiting for an opponent (since: server time)
	  { event = "start", vs, startedAt, spot, playerPos, rivalPos, hp, maxHp,
	    opponent = { userId, name, hp, maxHp }, score = 0, wins }   rivalPos: the opponent's feet
	  { event = "check", vs, hidden = true, pressFrom, id, n, appearAt, speed, dir, duration }
	                                                 the same check for both sides, no zone yet;
	                                                 pressFrom: presses stamped earlier are ignored
	  { event = "zone", vs, id, zoneStart, zoneSize, perfectSize }   sent when the needle starts
	  { event = "result", vs, id, result, reason?, travel?, score, combo }   own press, no HP change
	  { event = "round", vs, id, you = { result, hp, maxHp, combo, score },
	    opp = { result, hp, maxHp }, suddenDeath? }
	  { event = "finish", vs, won, reason ("ko" | "forfeit"), opponent = { userId, name }, score,
	    wins, played, cash, full, cooldownEnds, afk?, rounds?, draw?, close? }
	                                                 afk = true: an idle forfeit (reason "forfeit");
	                                                 rounds = true: decided at the round cap (reason
	                                                 "ko"); draw = true: nobody won (won is false);
	                                                 close = true: a KO or round-cap result by a
	                                                 small HP margin or in sudden death
	                                                 (MogRules.duelClose)
	Rival info: { index, name, tier, hp, maxHp } (tier = Theme.Tiers index the client dresses).
	Effects: the usual "Cash" { amount, source = "Mode", padPos } when the pass pays cash.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Course = require(script.Parent.Course)
local MogLayout = require(script.Parent.MogLayout)
local MogRules = require(script.Parent.MogRules)

local ID = "mog"
local BEST_SIZE = 8
-- Seconds from the start to the first check being announced.
local FIRST_CHECK = 2.0
-- Press timing slack (seconds) around the needle's lap and around the server clock.
local LAP_SLACK = 0.05
local PRESS_PAST = 0.6
local PRESS_FUTURE = 0.25
-- An unanswered check becomes a miss this long after the needle's lap ends.
local TIMEOUT_SLACK = 0.35
-- Seconds after finishing before the player is brought back to the gates.
local RETURN_AFTER = 6
-- Seconds a PvP player waits in the queue before giving up.
local QUEUE_TIMEOUT = 45
-- Feet are this far below the HumanoidRootPart's centre on a default character.
local FEET_BELOW_ROOT = 3

type Saved = { root: BasePart, humanoid: Humanoid?, jumpHeight: number, jumpPower: number }

type State = {
	run: MogRules.Run,
	spot: number,
	rng: Random,
	check: MogRules.Check?,
	checkId: number,
	appearAt: number,
	pending: boolean,
	reward: Economy.ModeReward?,
	saved: Saved?,
}

-- A PvP duel shared by both players (players[1] = side A, players[2] = side B).
type Duel = {
	rules: MogRules.Duel,
	players: { Player },
	spot: number,
	rng: Random,
	check: MogRules.Check?,
	checkId: number,
	appearAt: number,
	-- The current check's needle start once its zone was sent (math.huge until then).
	revealAt: number,
	pending: boolean,
	saved: { [Player]: Saved? },
	over: boolean,
}

type QueueEntry = { player: Player, since: number }

local function escape(s: string): string
	return (string.gsub(s, "[&<>]", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;" }))
end

local function vec(p: MogLayout.Point): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function info(r: MogRules.Rival): { [string]: any }
	return { index = r.index, name = r.name, tier = r.tier, hp = r.hp, maxHp = r.maxHp }
end

local function create(GameModes: any, context: { built: any, theme: any, Tycoon: any, world: any })
	local theme = context.theme
	local Tycoon = context.Tycoon
	local runs: { [Player]: State } = {}
	local lastX: { [Player]: number } = {}
	local spotOwner: { [number]: Player } = {}
	-- Bumped every time a spot is handed out, so a stale freeLater never frees a reused spot.
	local spotGen: { [number]: number } = {}
	local duels: { [Player]: Duel } = {}
	local queue: { QueueEntry } = {}
	local serverBest: { MogRules.BestEntry } = {}
	local nextCheckId = 0

	local tierNames: { string } = {}
	for _, tier in theme.Tiers do
		table.insert(tierNames, tier.Name)
	end

	local function now(): number
		return workspace:GetServerTimeNow()
	end

	local function record(session: any): {
		best: number,
		rivals: number,
		clears: number,
		lastRewardAt: number,
		pvpWins: number,
		pvpPlayed: number,
	}
		return session.profile.modes.mog
	end

	-- What a PvE pass (vs = "rivals") or a PvP win ("pvp") pays right now. Only a pass can be
	-- the first clear; both share the cooldown.
	local function rewardFor(session: any, vs: string): Economy.ModeReward
		local p = session.profile
		local rec = record(session)
		local pack = theme.Modes.Reward
		local progression = Economy.progression(Economy.highestTier(p.discovered), p.processLevel)
		local first = vs == "rivals" and MogRules.firstPass(rec)
		return Economy.modeReward(Tycoon.income(session), progression, pack.Seconds, pack.Min, first, rec.lastRewardAt, os.time())
	end

	local function updateBoard()
		local label = context.world and context.world.mog and context.world.mog.bestList
		if not label then
			return
		end
		if #serverBest == 0 then
			label.Text = "Be the first to pass!"
			return
		end
		local lines = {}
		for i, entry in serverBest do
			table.insert(lines, string.format("%d. %s  <b>%d</b>", i, escape(entry.name), entry.score))
		end
		label.Text = table.concat(lines, "\n")
	end

	local function freeSpot(player: Player, other: Player?): number?
		-- A solo player who plays again within RETURN_AFTER still holds their spot: reuse it.
		-- A duel never does: the last opponent may still stand on that spot's other pad.
		if not other then
			for i = 1, #MogLayout.SPOTS do
				if spotOwner[i] == player then
					return i
				end
			end
		end
		for i = 1, #MogLayout.SPOTS do
			local owner = spotOwner[i]
			if not owner or owner.Parent == nil then
				return i
			end
		end
		return nil
	end

	-- Holds the character still on its pad: anchored root, no jumping. Returns what unhold needs.
	local function hold(player: Player): Saved?
		local root = GameModes.root(player)
		if not root then
			return nil
		end
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local saved: Saved = {
			root = root,
			humanoid = humanoid,
			jumpHeight = if humanoid then humanoid.JumpHeight else 7.2,
			jumpPower = if humanoid then humanoid.JumpPower else 50,
		}
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = true
		if humanoid then
			humanoid.JumpHeight = 0
			humanoid.JumpPower = 0
		end
		return saved
	end

	local function unhold(saved: Saved?)
		if saved then
			saved.root.Anchored = false
			if saved.humanoid then
				saved.humanoid.JumpHeight = saved.jumpHeight
				saved.humanoid.JumpPower = saved.jumpPower
			end
		end
	end

	-- Frees `spot` once its players are gone: they stand on the pads a few more seconds after a
	-- finish (RETURN_AFTER), so nobody is teleported onto them meanwhile.
	local function freeLater(spot: number, owner: Player)
		if spotOwner[spot] == owner then
			local gen = spotGen[spot]
			task.delay(RETURN_AFTER + 1, function()
				if spotOwner[spot] == owner and spotGen[spot] == gen then
					spotOwner[spot] = nil
				end
			end)
		end
	end

	-- Undoes hold() and frees the spot. Must run before any teleport away from the stage.
	local function release(player: Player, state: State)
		unhold(state.saved)
		state.saved = nil
		freeLater(state.spot, player)
		runs[player] = nil
	end

	local issueCheck: (player: Player, state: State) -> ()

	-- Announces the next check after `delay` seconds, unless this run has ended by then.
	local function scheduleCheck(player: Player, state: State, delay: number)
		task.delay(delay, function()
			if runs[player] == state and not state.pending and not state.run.finished then
				issueCheck(player, state)
			end
		end)
	end

	issueCheck = function(player: Player, state: State)
		local run = state.run
		run.n += 1
		local check = MogRules.check(run.n, function()
			return state.rng:NextNumber()
		end)
		nextCheckId += 1
		state.check = check
		state.checkId = nextCheckId
		state.appearAt = now() + check.lead
		state.pending = true
		GameModes.notify(player, "check", ID, {
			id = state.checkId,
			n = check.n,
			appearAt = state.appearAt,
			speed = check.speed,
			dir = check.dir,
			zoneStart = check.zoneStart,
			zoneSize = check.zoneSize,
			perfectSize = check.perfectSize,
			duration = check.duration,
		})
	end

	-- Pays the mode reward for a PvE pass (vs = "rivals") or a PvP win ("pvp"): one cooldown
	-- for both, the first clear only for a pass. `padPos` places the "Cash" effect when the
	-- character is gone.
	local function payReward(player: Player, padPos: Vector3, vs: string): Economy.ModeReward?
		local session = GameModes.session(player)
		if not session then
			return nil
		end
		local rec = record(session)
		local reward = GameModes.hooks.reward(session, ID, rewardFor(session, vs))
		MogRules.countClear(rec, vs)
		if reward.full then
			rec.lastRewardAt = os.time()
		end
		local p = session.profile
		if reward.cash > 0 then
			p.money += reward.cash
			p.totalEarned += reward.cash
			local root = GameModes.root(player)
			GameModes.effect(player, "Cash", {
				amount = reward.cash,
				source = "Mode",
				padPos = if root then root.Position else padPos,
			})
		end
		GameModes.hooks.rewarded(session, ID, reward)
		Tycoon.markDirty(session)
		return reward
	end

	local function payPass(player: Player, state: State): Economy.ModeReward?
		local reward = payReward(player, vec(MogLayout.SPOTS[state.spot].player), "rivals")
		state.reward = reward
		return reward
	end

	local function finish(player: Player, state: State)
		release(player, state)
		local session = GameModes.session(player)
		if not session then
			return
		end
		local run = state.run
		local rec = record(session)
		local newBest = run.score > rec.best
		if newBest then
			rec.best = run.score
		end
		rec.rivals = math.max(rec.rivals, run.rivals)
		local rank = nil
		if run.score > 0 then
			rank = MogRules.recordBest(serverBest, player.UserId, player.DisplayName, run.score, run.rivals, BEST_SIZE)
			updateBoard()
		end
		local reward = state.reward
		GameModes.notify(player, "finish", ID, {
			score = run.score,
			rivals = run.rivals,
			best = rec.best,
			newBest = newBest,
			passed = run.passed,
			cash = if reward then reward.cash else 0,
			full = if reward then reward.full else false,
			cooldownEnds = rec.lastRewardAt + Economy.MODE_REWARD_COOLDOWN,
			rank = rank,
		})
		Tycoon.markDirty(session)
		GameModes.refresh(player)
		GameModes.returnLater(player, RETURN_AFTER, function(root: BasePart): boolean
			return MogLayout.onStage(root.Position.X, root.Position.Z)
		end)
	end

	-- Settles the current check with `result` and moves the run on.
	local function resolve(player: Player, state: State, result: string, reason: string?, travel: number?)
		local check = state.check :: MogRules.Check
		state.pending = false
		local hitRival = state.run.rival
		local outcome = MogRules.apply(state.run, result)
		local run = state.run
		GameModes.notify(player, "result", ID, {
			id = state.checkId,
			result = result,
			reason = reason,
			travel = travel,
			score = run.score,
			combo = run.combo,
			lives = run.lives,
			rivalHp = hitRival.hp,
			rivalMax = hitRival.maxHp,
		})
		if outcome.moggedRival then
			local payload: { [string]: any } = {
				mogged = info(outcome.moggedRival :: MogRules.Rival),
				rival = info(run.rival),
				rivals = run.rivals,
				passed = outcome.passed == true,
			}
			if outcome.passed then
				local reward = payPass(player, state)
				payload.cash = if reward then reward.cash else 0
				payload.full = if reward then reward.full else false
			end
			GameModes.notify(player, "rival", ID, payload)
			GameModes.refresh(player)
		end
		if outcome.finished then
			finish(player, state)
		else
			scheduleCheck(player, state, check.delay)
		end
	end

	-- Judges a "MogPress" { id, at } against a check announced for `appearAt` with id `checkId`.
	-- Returns nil for a stale, malformed or implausibly timed press; in a duel that includes
	-- one stamped before `from` (sooner after the zone was sent than anyone can react).
	local function judgePress(
		check: MogRules.Check,
		checkId: number,
		appearAt: number,
		data: { [string]: any },
		from: number?
	): (string?, string?, number?)
		local id, at = data.id, data.at
		if type(id) ~= "number" or type(at) ~= "number" or at ~= at or id ~= checkId then
			return nil
		end
		local t = now()
		if at < appearAt - LAP_SLACK or at > appearAt + check.duration + LAP_SLACK then
			return nil
		end
		if from and at < from then
			return nil
		end
		if at < t - PRESS_PAST or at > t + PRESS_FUTURE then
			return nil
		end
		local travel = check.speed * (at - appearAt)
		local result, reason = MogRules.judge(check, travel)
		return result, reason, travel
	end

	-- PvP --------------------------------------------------------------------------------------

	local function queued(player: Player): number?
		for i, entry in queue do
			if entry.player == player then
				return i
			end
		end
		return nil
	end

	local function dequeue(player: Player): boolean
		local i = queued(player)
		if i then
			table.remove(queue, i)
		end
		return i ~= nil
	end

	-- Can this queued player be put in a duel right now?
	local function ready(player: Player): boolean
		return player.Parent ~= nil
			and GameModes.session(player) ~= nil
			and GameModes.root(player) ~= nil
			and not runs[player]
			and not duels[player]
	end

	local function sideOf(duel: Duel, player: Player): number
		return if duel.players[1] == player then 1 else 2
	end

	-- Feet of side `side` on the duel's spot: A on the player pad, B on the rival pad.
	local function padOf(duel: Duel, side: number): Vector3
		local spot = MogLayout.SPOTS[duel.spot]
		return vec(if side == 1 then spot.player else spot.rival)
	end

	local function sendPvp(player: Player, event: string, data: { [string]: any })
		data.vs = "pvp"
		GameModes.notify(player, event, ID, data)
	end

	local issueDuelCheck: (duel: Duel) -> ()

	local function scheduleDuelCheck(duel: Duel, delay: number)
		task.delay(delay, function()
			if not duel.over and not duel.pending then
				issueDuelCheck(duel)
			end
		end)
	end

	-- Both sides get the same check with the same id and appearAt. It is hidden: the zone is
	-- sent only when the needle starts, to both at once.
	issueDuelCheck = function(duel: Duel)
		local rules = duel.rules
		rules.n += 1
		local check = MogRules.check(rules.n, function()
			return duel.rng:NextNumber()
		end, true)
		nextCheckId += 1
		local id = nextCheckId
		local lead = check.lead + (if rules.n == 1 then MogRules.PVP_FIRST_LEAD else 0)
		duel.check = check
		duel.checkId = id
		duel.appearAt = now() + lead
		duel.revealAt = math.huge
		duel.pending = true
		for _, player in duel.players do
			sendPvp(player, "check", {
				id = id,
				n = check.n,
				appearAt = duel.appearAt,
				speed = check.speed,
				dir = check.dir,
				duration = check.duration,
				hidden = true,
				pressFrom = duel.appearAt + MogRules.MIN_REACTION,
			})
		end
		task.delay(lead, function()
			if duel.over or not duel.pending or duel.checkId ~= id then
				return
			end
			-- task.delay never fires early; the stamp is the needle's start, which is also what
			-- the clients' `pressFrom` counts from.
			duel.revealAt = duel.appearAt
			for _, player in duel.players do
				sendPvp(player, "zone", {
					id = id,
					zoneStart = check.zoneStart,
					zoneSize = check.zoneSize,
					perfectSize = check.perfectSize,
				})
			end
		end)
	end

	-- Ends the duel: releases both players, frees the spot (after RETURN_AFTER), counts it on
	-- both records and pays `winner` (nil = a draw: nobody wins). `reason` is "ko", "forfeit"
	-- (left), "afk" (idle forfeit) or "rounds" (the round cap). Everyone but `quitter` (who
	-- gets a stop from def.stop) gets a finish and is sent back to the gates later.
	local function endDuel(duel: Duel, winner: Player?, reason: string, quitter: Player?)
		if duel.over then
			return
		end
		duel.over = true
		-- A forfeit before any round was played pays nothing (no win-trading by quitting).
		local pays = reason ~= "forfeit" or duel.rules.n >= 2
		-- Only a duel fought to the end can have been close (the loser's card says so).
		local close = (reason == "ko" or reason == "rounds") and MogRules.duelClose(duel.rules)
		duel.pending = false
		for _, player in duel.players do
			unhold(duel.saved[player])
			duels[player] = nil
		end
		duel.saved = {}
		freeLater(duel.spot, duel.players[1])
		for i, player in duel.players do
			local session = GameModes.session(player)
			if not session then
				continue
			end
			local won = winner ~= nil and player == winner
			local rec = record(session)
			rec.pvpPlayed += 1
			local reward = nil
			if won then
				rec.pvpWins += 1
				if pays then
					reward = payReward(player, padOf(duel, i), "pvp")
				end
			end
			Tycoon.markDirty(session)
			if player ~= quitter then
				local opponent = duel.players[3 - i]
				sendPvp(player, "finish", {
					won = won,
					-- The finish card knows "ko" and "forfeit"; the flags say which kind.
					reason = if reason == "afk" then "forfeit" elseif reason == "rounds" then "ko" else reason,
					afk = if reason == "afk" then true else nil,
					rounds = if reason == "rounds" then true else nil,
					draw = if winner == nil then true else nil,
					close = if close then true else nil,
					opponent = { userId = opponent.UserId, name = opponent.DisplayName },
					score = duel.rules.sides[i].score,
					wins = rec.pvpWins,
					played = rec.pvpPlayed,
					cash = if reward then reward.cash else 0,
					full = if reward then reward.full else false,
					cooldownEnds = rec.lastRewardAt + Economy.MODE_REWARD_COOLDOWN,
				})
				GameModes.refresh(player)
				GameModes.returnLater(player, RETURN_AFTER, function(root: BasePart): boolean
					return MogLayout.onStage(root.Position.X, root.Position.Z)
				end)
			end
		end
	end

	-- Records `player`'s answer to the current check and tells them (no HP change yet).
	local function answer(duel: Duel, player: Player, result: string, reason: string?, travel: number?)
		local side = sideOf(duel, player)
		if not MogRules.duelPress(duel.rules, side, result) then
			return
		end
		local d = duel.rules.sides[side]
		sendPvp(player, "result", {
			id = duel.checkId,
			result = result,
			reason = reason,
			travel = travel,
			score = d.score,
			combo = d.combo,
		})
	end

	-- Both answered (or timed out): the damage lands, then the duel ends or goes on.
	local function endRound(duel: Duel)
		local check = duel.check :: MogRules.Check
		duel.pending = false
		local round = MogRules.duelRound(duel.rules)
		for i, player in duel.players do
			local you, opp = duel.rules.sides[i], duel.rules.sides[3 - i]
			sendPvp(player, "round", {
				id = duel.checkId,
				you = { result = round.results[i], hp = you.hp, maxHp = you.maxHp, combo = you.combo, score = you.score },
				opp = { result = round.results[3 - i], hp = opp.hp, maxHp = opp.maxHp },
				suddenDeath = if round.suddenDeath then true else nil,
			})
		end
		if round.finished then
			local winner = if round.winner then duel.players[round.winner] else nil
			endDuel(duel, winner, round.reason or "ko", nil)
		else
			scheduleDuelCheck(duel, check.delay)
		end
	end

	local function startDuel(a: Player, b: Player, index: number)
		local t = now()
		local duel: Duel = {
			rules = MogRules.newDuel(),
			players = { a, b },
			spot = index,
			rng = Random.new(),
			check = nil,
			checkId = 0,
			appearAt = 0,
			revealAt = math.huge,
			pending = false,
			saved = {},
			over = false,
		}
		duels[a] = duel
		duels[b] = duel
		spotOwner[index] = a
		spotGen[index] = (spotGen[index] or 0) + 1
		local spot = MogLayout.SPOTS[index]
		local inward = Vector3.new(spot.faceX, 0, spot.faceZ)
		GameModes.teleport(a, padOf(duel, 1), inward)
		GameModes.teleport(b, padOf(duel, 2), -inward)
		lastX[a] = spot.player.x
		lastX[b] = spot.rival.x
		duel.saved[a] = hold(a)
		duel.saved[b] = hold(b)
		for i, player in duel.players do
			local opponent = duel.players[3 - i]
			local session = GameModes.session(player)
			sendPvp(player, "start", {
				startedAt = t,
				spot = index,
				playerPos = padOf(duel, i),
				rivalPos = padOf(duel, 3 - i),
				hp = MogRules.PVP_HP,
				maxHp = MogRules.PVP_HP,
				opponent = {
					userId = opponent.UserId,
					name = opponent.DisplayName,
					hp = MogRules.PVP_HP,
					maxHp = MogRules.PVP_HP,
				},
				score = 0,
				wins = if session then record(session).pvpWins else 0,
			})
			GameModes.refresh(player)
		end
		scheduleDuelCheck(duel, FIRST_CHECK)
	end

	-- Matches the two earliest ready players in the queue when a whole spot is free.
	local function tryMatch()
		local a: Player?, b: Player? = nil, nil
		for _, entry in queue do
			if ready(entry.player) then
				if not a then
					a = entry.player
				else
					b = entry.player
					break
				end
			end
		end
		if not a or not b then
			return
		end
		local index = freeSpot(a, b)
		if not index then
			return
		end
		dequeue(a)
		dequeue(b)
		startDuel(a, b, index)
	end

	-- Settles a duel's check once the needle's lap is over: missing answers are timeouts
	-- (MogRules.duelRound books them as misses and counts them toward the idle forfeit).
	local function duelTimeout(duel: Duel, t: number)
		local check = duel.check
		if not duel.pending or not check or t <= duel.appearAt + check.duration + TIMEOUT_SLACK then
			return
		end
		for i, player in duel.players do
			local d = duel.rules.sides[i]
			if d.result == nil then
				sendPvp(player, "result", {
					id = duel.checkId,
					result = "miss",
					reason = "timeout",
					score = d.score,
					combo = 0,
				})
			end
		end
		endRound(duel)
	end

	local def = {} :: any
	def.id = ID

	-- True during a PvE run, a duel, or while waiting in the PvP queue.
	function def.running(player: Player): boolean
		return runs[player] ~= nil or duels[player] ~= nil or queued(player) ~= nil
	end

	function def.start(player: Player, _teleport: boolean, options: { [string]: any }?): boolean
		local vs = options and options.vs
		if vs ~= "rivals" and vs ~= "pvp" then
			if def.running(player) then
				return true
			end
			GameModes.notify(player, "choose", ID)
			return false
		end
		if runs[player] or duels[player] then
			return true
		end
		if queued(player) then
			if vs == "pvp" then
				return true
			end
			dequeue(player)
		end
		local session = GameModes.session(player)
		if not session or not GameModes.root(player) then
			return false
		end
		if vs == "pvp" then
			local since = now()
			table.insert(queue, { player = player, since = since })
			tryMatch()
			if queued(player) then
				sendPvp(player, "queue", { since = since, timeout = QUEUE_TIMEOUT })
				GameModes.refresh(player)
			end
			return true
		end
		local index = freeSpot(player)
		if not index then
			GameModes.notify(player, "stop", ID, { reason = "full" })
			return false
		end
		local t = now()
		local state: State = {
			run = MogRules.newRun(t, tierNames),
			spot = index,
			rng = Random.new(),
			check = nil,
			checkId = 0,
			appearAt = 0,
			pending = false,
			reward = nil,
			saved = nil,
		}
		runs[player] = state
		spotOwner[index] = player
		spotGen[index] = (spotGen[index] or 0) + 1
		-- The stage is teleport-only, so every start teleports.
		local spot = MogLayout.SPOTS[index]
		GameModes.teleport(player, vec(spot.player), Vector3.new(spot.faceX, 0, spot.faceZ))
		lastX[player] = spot.player.x
		state.saved = hold(player)
		local best = record(session).best
		GameModes.notify(player, "start", ID, {
			vs = "rivals",
			lives = state.run.lives,
			maxLives = MogRules.LIVES,
			startedAt = t,
			best = best,
			spot = index,
			playerPos = vec(spot.player),
			rivalPos = vec(spot.rival),
			rival = info(state.run.rival),
			passRivals = MogRules.PASS_RIVALS,
			score = 0,
		})
		GameModes.refresh(player)
		scheduleCheck(player, state, FIRST_CHECK)
		return true
	end

	-- Leaving the queue just dequeues; leaving a duel forfeits it to the opponent.
	function def.stop(player: Player, reason: string)
		local wasQueued = dequeue(player)
		local duel = duels[player]
		if wasQueued or duel then
			if duel then
				endDuel(duel, duel.players[3 - sideOf(duel, player)], "forfeit", player)
			end
			if reason ~= "leave" then
				sendPvp(player, "stop", { reason = reason })
				GameModes.refresh(player)
			end
			return
		end
		local state = runs[player]
		if not state then
			return
		end
		release(player, state)
		if reason ~= "leave" then
			GameModes.notify(player, "stop", ID, { reason = reason })
			GameModes.refresh(player)
		end
	end

	function def.tick(player: Player, root: BasePart, t: number)
		local pos = root.Position
		local x, z = pos.X, pos.Z
		local prevX = lastX[player]
		lastX[player] = x
		local duel = duels[player]
		if duel then
			duelTimeout(duel, t)
			return
		end
		local waiting = queued(player)
		if waiting then
			if t - queue[waiting].since > QUEUE_TIMEOUT then
				table.remove(queue, waiting)
				sendPvp(player, "stop", { reason = "noOpponent" })
				GameModes.refresh(player)
			else
				tryMatch()
			end
			return
		end
		local state = runs[player]
		if not state then
			if
				prevX
				and prevX > Course.GATE_X
				and x <= Course.GATE_X
				and math.abs(z - Course.GATES[2].z) <= Course.GATE_HALF + 1
				and pos.Y - FEET_BELOW_ROOT < Course.PLAZA.top + 8
			then
				-- No `vs`: the client is asked to choose (rivals or PvP).
				GameModes.start(player, ID, true)
			end
			return
		end
		local check = state.check
		if state.pending and check and t > state.appearAt + check.duration + TIMEOUT_SLACK then
			resolve(player, state, "miss", "timeout", nil)
		end
	end

	Tycoon.addAction("MogPress", function(session: any, data: { [string]: any })
		local player = session.player
		local duel = duels[player]
		if duel then
			local check = duel.check
			if not check or not duel.pending then
				return
			end
			-- No press counts before the zone was sent, nor sooner after it than a reaction takes.
			local from = duel.revealAt + MogRules.MIN_REACTION
			local result, reason, travel = judgePress(check, duel.checkId, duel.appearAt, data, from)
			if result then
				answer(duel, player, result, reason, travel)
				if duel.pending and MogRules.duelAnswered(duel.rules) then
					endRound(duel)
				end
			end
			return
		end
		local state = runs[player]
		local check = state and state.check
		if not state or not check or not state.pending then
			return
		end
		local result, reason, travel = judgePress(check, state.checkId, state.appearAt, data)
		if result then
			resolve(player, state, result, reason, travel)
		end
	end)

	-- Leaves the PvP queue (no teleport: a queued player never left the plaza).
	Tycoon.addAction("MogCancel", function(session: any, _data: { [string]: any })
		local player = session.player
		if dequeue(player) then
			sendPvp(player, "stop", { reason = "cancel" })
			GameModes.refresh(player)
		end
	end)

	function def.rewardPreview(player: Player): { [string]: any }
		local session = GameModes.session(player)
		if not session then
			return { cash = 0, full = false, packCash = 0 }
		end
		local r = rewardFor(session, "rivals")
		return { cash = r.cash, full = r.full, packCash = r.packCash }
	end

	function def.snapshot(player: Player): { [string]: any }
		local session = GameModes.session(player)
		local state = runs[player]
		local duel = duels[player]
		local rec = session and record(session)
		return {
			best = if rec then rec.best else 0,
			rivals = if rec then rec.rivals else 0,
			clears = if rec then rec.clears else 0,
			pvpWins = if rec then rec.pvpWins else 0,
			pvpPlayed = if rec then rec.pvpPlayed else 0,
			running = state ~= nil or duel ~= nil,
			queued = queued(player) ~= nil,
			score = if state then state.run.score elseif duel then duel.rules.sides[sideOf(duel, player)].score else 0,
			lives = if state then state.run.lives else MogRules.LIVES,
			cooldownEnds = if rec and rec.lastRewardAt > 0 then rec.lastRewardAt + Economy.MODE_REWARD_COOLDOWN else 0,
			rewardPreview = def.rewardPreview(player),
			passRivals = MogRules.PASS_RIVALS,
		}
	end

	Players.PlayerRemoving:Connect(function(player)
		-- Releases a PvE run, leaves the queue or forfeits a duel (GameModes also stops it).
		def.stop(player, "leave")
		lastX[player] = nil
	end)
	updateBoard()
	return def
end

return { create = create }
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="188">
          <Properties>
            <string name="Name">MogLayout</string>
            <string name="Source"><![CDATA[--[[
	MogLayout: pure layout numbers of the MOG STAGE (no Roblox APIs), shared by
	World.MogStage (builds it) and Modes.Mog (teleports, spots, "still on the stage" checks).

	The stage is a round floating disc out at sea, north (+Z) of the island (the island's
	shallows end ~286 studs from the origin; the ocean top is at y = -1.2), reached only by teleport.
	CENTER is the middle of the stage's top surface. SPOTS duel spots sit evenly around it on
	radial lines: the player's pad near the rim faces inward to the rival's pad DUEL studs
	closer to the centre. A central tower carries the MOG TEST sign above everyone's heads.
]]

local MogLayout = {}

MogLayout.CENTER = { x = 0, y = 6, z = 400 }
MogLayout.RADIUS = 46
-- Stage disc thickness (the top is CENTER.y) and the pad height above the stage top.
MogLayout.THICKNESS = 3
MogLayout.PAD_HEIGHT = 0.4
MogLayout.PAD_RADIUS = 3.2
MogLayout.SPOT_COUNT = 6
-- Radius of the player pads and the player-to-rival distance.
MogLayout.PLAYER_RING = 33
MogLayout.DUEL = 14
-- The rope ring's posts sit on this radius; the central tower is this wide.
MogLayout.POST_RING = 43.5
MogLayout.TOWER_RADIUS = 5
-- Sea level (the ocean top) for the pontoon floats and foam.
MogLayout.SEA_Y = -1.2
-- The TOP MOGGERS board sits at this angle (between spots 1 and 2), facing the centre.
MogLayout.BOARD_ANGLE = math.pi / MogLayout.SPOT_COUNT
MogLayout.BOARD_RING = 40

export type Point = { x: number, y: number, z: number }
export type Spot = { index: number, angle: number, player: Point, rival: Point, faceX: number, faceZ: number }

-- Angle of spot `index` around the centre (0 = +Z, counter-clockwise seen from above).
function MogLayout.angle(index: number): number
	return (index - 1) * 2 * math.pi / MogLayout.SPOT_COUNT
end

-- A point at radius `r` along `angle`, at height `y`.
function MogLayout.at(angle: number, r: number, y: number): Point
	local c = MogLayout.CENTER
	return { x = c.x + math.sin(angle) * r, y = y, z = c.z + math.cos(angle) * r }
end

local spots: { Spot } = {}
for i = 1, MogLayout.SPOT_COUNT do
	local a = MogLayout.angle(i)
	local feetY = MogLayout.CENTER.y + MogLayout.PAD_HEIGHT
	table.insert(spots, {
		index = i,
		angle = a,
		player = MogLayout.at(a, MogLayout.PLAYER_RING, feetY),
		rival = MogLayout.at(a, MogLayout.PLAYER_RING - MogLayout.DUEL, feetY),
		-- Player faces the rival (inward).
		faceX = -math.sin(a),
		faceZ = -math.cos(a),
	})
end
MogLayout.SPOTS = spots

-- Is (x, z) over the stage (with a little slack past the rim)?
function MogLayout.onStage(x: number, z: number): boolean
	local c = MogLayout.CENTER
	local dx, dz = x - c.x, z - c.z
	local r = MogLayout.RADIUS + 4
	return dx * dx + dz * dz <= r * r
end

return MogLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="189">
          <Properties>
            <string name="Name">MogRules</string>
            <string name="Source"><![CDATA[--[[
	MogRules: pure rules of the MOG TEST duel (no Roblox APIs; unit-tested in tests/mog.luau).

	A run is a chain of skill checks. Each check is a needle sweeping one lap (360 degrees of
	"travel") at `speed` deg/s; the zone covers travel in [zoneStart, zoneStart + zoneSize]
	and its first `perfectSize` degrees are the "perfect" part. A hit takes 1 HP off the
	rival (perfect: 2); at 0 HP the rival is mogged and the next, tougher one steps in.
	A miss costs a life; at 0 lives the run is finished. Mogging PASS_RIVALS rivals passes
	the Mog Test (the mode reward); the run goes on for a high score.

	Difficulty for the n-th check of a run (n >= 1):
	  speed(n)  = min(540, 220 + 12 * (n - 1))             deg/s
	  zoneSize  = max(40, 0.37 * 0.945^(n - 1) * speed)    degrees; never grows (the floor holds from n = 30)
	  window(n) = zoneSize / speed                         seconds of needle time inside the zone (370 ms .. 74 ms)
	  perfect   = max(0.25 * zoneSize, 0.04 * speed)       degrees: at least 40 ms of needle travel (from n = 16)
	  dir       = +1 for n <= 7, then random +-1
	  zoneStart = random in [120, 330 - zoneSize] (n <= 11), [70, 330 - zoneSize] after
	  lead      = max(0.6, 1.4 - 0.03 * (n - 1))     seconds between telling the client and the needle start
	  delay     = random in [0.5, 1.4]               seconds before the next check after a result
	A `hidden` check (PvP) keeps its zone secret until the needle starts, so the zone starts no
	sooner than REVEAL_TIME seconds of needle travel (time to see it): zoneStart from
	min(330 - zoneSize, max(the floor above, REVEAL_TIME * speed)).
	All randomness comes from the `rand()` function passed in (values in [0, 1)).

	Pass rate of the first PASS_RIVALS rivals for a player whose presses miss the zone centre by
	a Gaussian timing error (4,000 runs each): 50 ms 100%, 70 ms 94%, 100 ms 57%, 140 ms 17%
	(before this curve: 94%, 62%, 18%, 3%).
]]

local MogRules = {}

MogRules.LIVES = 3
MogRules.PASS_RIVALS = 3
-- Score per result (perfect also does PERFECT_DAMAGE to the rival).
MogRules.HIT_SCORE = 1
MogRules.PERFECT_SCORE = 2
MogRules.HIT_DAMAGE = 1
MogRules.PERFECT_DAMAGE = 2
-- Rival tiers when no tier name list is given (Theme.Tiers has 25).
MogRules.DEFAULT_TIERS = 25

MogRules.WINDOW_START = 0.37
MogRules.WINDOW_DECAY = 0.945
MogRules.SPEED_START = 220
MogRules.SPEED_STEP = 12
MogRules.SPEED_MAX = 540
-- Smallest zone, degrees (74 ms at SPEED_MAX): the zone shrinks to it and stays there.
MogRules.ZONE_MIN = 40
-- The perfect slice: a share of the zone, never less than this many seconds of needle travel.
MogRules.PERFECT_SHARE = 0.25
MogRules.PERFECT_MIN_TIME = 0.04
MogRules.FIXED_DIR_CHECKS = 7
MogRules.EASY_ZONE_CHECKS = 11
MogRules.ZONE_FROM_EASY = 120
MogRules.ZONE_FROM_HARD = 70
MogRules.ZONE_UNTIL = 330
MogRules.DELAY_MIN = 0.5
MogRules.DELAY_MAX = 1.4
-- PvP: HP per duelist, self-damage of a miss, extra lead (seconds) before the first check.
MogRules.PVP_HP = 8
MogRules.PVP_MISS_DAMAGE = 1
MogRules.PVP_FIRST_LEAD = 0.6
-- PvP checks are hidden: the zone is sent when the needle starts and begins no sooner than
-- REVEAL_TIME seconds later. A press sooner than MIN_REACTION seconds after the zone was sent
-- is not a human reaction and is ignored.
MogRules.REVEAL_TIME = 0.55
MogRules.MIN_REACTION = 0.15
-- PvP: a side that lets this many checks in a row time out forfeits; a duel that is still
-- undecided after PVP_MAX_ROUNDS rounds goes to the higher HP, then the higher score.
MogRules.PVP_IDLE_FORFEIT = 3
MogRules.PVP_MAX_ROUNDS = 40
-- PvP: a decided duel was close when the winner ended at most this many HP ahead (or it went
-- to sudden death); only then does the loser's card say "So close!".
MogRules.PVP_CLOSE_MARGIN = 2

export type Check = {
	n: number,
	window: number,
	speed: number,
	dir: number,
	zoneStart: number,
	zoneSize: number,
	perfectSize: number,
	duration: number,
	lead: number,
	delay: number,
}

export type Rival = { index: number, name: string, tier: number, hp: number, maxHp: number }

export type Run = {
	startedAt: number,
	n: number,
	score: number,
	combo: number,
	bestCombo: number,
	lives: number,
	rival: Rival,
	rivals: number,
	passed: boolean,
	finished: boolean,
	names: { string }?,
}

export type Outcome = { moggedRival: Rival?, rival: Rival?, passed: boolean?, finished: boolean? }

-- One side of a PvP duel; `result` is this round's answer (nil = not answered yet), `idle`
-- the checks in a row this side let time out.
export type Duelist = {
	hp: number,
	maxHp: number,
	score: number,
	combo: number,
	bestCombo: number,
	result: string?,
	idle: number,
}

-- A PvP duel: sides[1] and sides[2]; `rounds` played; once finished, winner = 1 | 2, or nil
-- for a draw (both sides idle, or level on HP and score at the round cap).
export type Duel = {
	n: number,
	rounds: number,
	sides: { Duelist },
	finished: boolean,
	winner: number?,
	suddenDeath: boolean,
}

-- What a round did: each side's result (a missing answer counts as "miss"), suddenDeath when
-- a KO tie sent both back to 1 HP, and when the duel is over the winner (nil = draw) and why:
-- "ko", "afk" (PVP_IDLE_FORFEIT timeouts in a row) or "rounds" (PVP_MAX_ROUNDS played).
export type Round = {
	results: { string },
	finished: boolean,
	winner: number?,
	suddenDeath: boolean,
	reason: string?,
}

-- The saved Mog record's fields the reward rules read (profile.modes.mog).
export type Record = { clears: number, rivals: number }

export type BestEntry = { userId: number, name: string, score: number, rivals: number }

function MogRules.speed(n: number): number
	return math.min(MogRules.SPEED_MAX, MogRules.SPEED_START + MogRules.SPEED_STEP * (n - 1))
end

-- Degrees of zone: the decaying window at the needle's speed, floored at ZONE_MIN. The decay
-- outruns the speed-up, so the zone never grows from one check to the next.
function MogRules.zoneSize(n: number): number
	return math.max(MogRules.ZONE_MIN, MogRules.WINDOW_START * MogRules.WINDOW_DECAY ^ (n - 1) * MogRules.speed(n))
end

-- Seconds the needle spends inside the zone.
function MogRules.window(n: number): number
	return MogRules.zoneSize(n) / MogRules.speed(n)
end

-- Degrees of the zone's perfect part (at least PERFECT_MIN_TIME of needle travel).
function MogRules.perfectSize(n: number): number
	local zoneSize = MogRules.zoneSize(n)
	return math.min(zoneSize, math.max(MogRules.PERFECT_SHARE * zoneSize, MogRules.PERFECT_MIN_TIME * MogRules.speed(n)))
end

function MogRules.lead(n: number): number
	return math.max(0.6, 1.4 - 0.03 * (n - 1))
end

-- The n-th check of a run. Calls rand() for the direction (n > FIXED_DIR_CHECKS only), the
-- zone start and the delay, in that order. `hidden` (PvP): the zone is only shown when the
-- needle starts, so it starts at least REVEAL_TIME seconds of travel in.
function MogRules.check(n: number, rand: () -> number, hidden: boolean?): Check
	local window = MogRules.window(n)
	local speed = MogRules.speed(n)
	local zoneSize = MogRules.zoneSize(n)
	local perfectSize = MogRules.perfectSize(n)
	local dir = 1
	if n > MogRules.FIXED_DIR_CHECKS then
		dir = if rand() < 0.5 then -1 else 1
	end
	local from = if n <= MogRules.EASY_ZONE_CHECKS then MogRules.ZONE_FROM_EASY else MogRules.ZONE_FROM_HARD
	if hidden then
		from = math.min(MogRules.ZONE_UNTIL - zoneSize, math.max(from, MogRules.REVEAL_TIME * speed))
	end
	local to = math.max(from, MogRules.ZONE_UNTIL - zoneSize)
	local zoneStart = from + (to - from) * rand()
	local delay = MogRules.DELAY_MIN + (MogRules.DELAY_MAX - MogRules.DELAY_MIN) * rand()
	return {
		n = n,
		window = window,
		speed = speed,
		dir = dir,
		zoneStart = zoneStart,
		zoneSize = zoneSize,
		perfectSize = perfectSize,
		duration = 360 / speed,
		lead = MogRules.lead(n),
		delay = delay,
	}
end

-- Judges a press at `travel` degrees of needle travel. Returns the result and, for a miss,
-- "early" or "late".
function MogRules.judge(check: Check, travel: number): (string, string?)
	if travel < check.zoneStart then
		return "miss", "early"
	elseif travel > check.zoneStart + check.zoneSize then
		return "miss", "late"
	elseif travel <= check.zoneStart + check.perfectSize then
		return "perfect", nil
	end
	return "hit", nil
end

-- The i-th rival of a run: tougher (more HP, up to 6) and a higher unit tier each time.
-- `names` are the theme's tier names (Theme.Tiers[k].Name); the tier index is capped at #names.
function MogRules.rival(i: number, names: { string }?): Rival
	local count = if names and #names > 0 then #names else MogRules.DEFAULT_TIERS
	local tier = math.clamp(1 + 2 * i, 1, count)
	local hp = 3 + math.min(i - 1, 3)
	local base = if names and names[tier] then names[tier] else "Rival"
	return { index = i, name = base .. " #" .. i, tier = tier, hp = hp, maxHp = hp }
end

function MogRules.newRun(now: number, names: { string }?): Run
	return {
		startedAt = now,
		n = 0,
		score = 0,
		combo = 0,
		bestCombo = 0,
		lives = MogRules.LIVES,
		rival = MogRules.rival(1, names),
		rivals = 0,
		passed = false,
		finished = false,
		names = names,
	}
end

-- Applies a check result ("perfect" | "hit" | "miss") to the run. The outcome says whether
-- the rival was mogged (moggedRival, and the next `rival`), whether that mog passed the
-- test (the PASS_RIVALS-th) and whether the run is finished (no lives left).
function MogRules.apply(run: Run, result: string): Outcome
	local outcome: Outcome = {}
	if run.finished then
		return outcome
	end
	if result == "perfect" or result == "hit" then
		local perfect = result == "perfect"
		run.score += if perfect then MogRules.PERFECT_SCORE else MogRules.HIT_SCORE
		run.combo += 1
		run.bestCombo = math.max(run.bestCombo, run.combo)
		local rival = run.rival
		rival.hp = math.max(0, rival.hp - (if perfect then MogRules.PERFECT_DAMAGE else MogRules.HIT_DAMAGE))
		if rival.hp <= 0 then
			run.rivals += 1
			local passed = run.rivals == MogRules.PASS_RIVALS
			if passed then
				run.passed = true
			end
			run.rival = MogRules.rival(run.rivals + 1, run.names)
			outcome.moggedRival = rival
			outcome.rival = run.rival
			outcome.passed = passed
		end
	else
		run.combo = 0
		run.lives = math.max(0, run.lives - 1)
		if run.lives <= 0 then
			run.finished = true
			outcome.finished = true
		end
	end
	return outcome
end

-- Records a score on a best list (one entry per player, highest first, ties keep the
-- earlier entry ahead, at most `size` entries). Returns the player's rank, or nil.
function MogRules.recordBest(list: { BestEntry }, userId: number, name: string, score: number, rivals: number, size: number): number?
	for i, entry in list do
		if entry.userId == userId then
			if entry.score >= score then
				return i
			end
			table.remove(list, i)
			break
		end
	end
	local at = #list + 1
	for i, entry in list do
		if entry.score < score then
			at = i
			break
		end
	end
	if at > size then
		return nil
	end
	table.insert(list, at, { userId = userId, name = name, score = score, rivals = rivals })
	while #list > size do
		table.remove(list)
	end
	return at
end

-- Is a PvE pass still this record's first clear (always paid)? Only a pass uses it up: a PvP
-- win is paid on the cooldown alone. Saves whose `clears` was spent by a PvP win (the two
-- used to share it) get it back: they never mogged PASS_RIVALS rivals in one run.
function MogRules.firstPass(rec: Record): boolean
	return rec.clears == 0 or rec.rivals < MogRules.PASS_RIVALS
end

-- Books a paid result on the record: a PvE pass ("rivals") counts as a clear and records its
-- PASS_RIVALS rivals at once; a PvP win ("pvp") leaves both alone.
function MogRules.countClear(rec: Record, vs: string)
	if vs == "rivals" then
		rec.clears += 1
		rec.rivals = math.max(rec.rivals, MogRules.PASS_RIVALS)
	end
end

local function duelist(): Duelist
	return { hp = MogRules.PVP_HP, maxHp = MogRules.PVP_HP, score = 0, combo = 0, bestCombo = 0, result = nil, idle = 0 }
end

function MogRules.newDuel(): Duel
	return { n = 0, rounds = 0, sides = { duelist(), duelist() }, finished = false, winner = nil, suddenDeath = false }
end

-- Records side `side`'s answer ("perfect" | "hit" | "miss") to this round's check and
-- updates its score and combo; a press of any kind ends that side's idle streak. Returns
-- false (and changes nothing) when that side already answered or the duel is over. HP only
-- changes in duelRound.
function MogRules.duelPress(duel: Duel, side: number, result: string): boolean
	local d = duel.sides[side]
	if duel.finished or not d or d.result ~= nil then
		return false
	end
	d.result = result
	d.idle = 0
	if result == "perfect" or result == "hit" then
		d.score += if result == "perfect" then MogRules.PERFECT_SCORE else MogRules.HIT_SCORE
		d.combo += 1
		d.bestCombo = math.max(d.bestCombo, d.combo)
	else
		d.combo = 0
	end
	return true
end

-- Has every side answered this round's check?
function MogRules.duelAnswered(duel: Duel): boolean
	return duel.sides[1].result ~= nil and duel.sides[2].result ~= nil
end

-- Ends the duel inside duelRound: `winner` nil is a draw.
local function decide(duel: Duel, round: Round, winner: number?, reason: string)
	duel.winner = winner
	duel.finished = true
	round.finished = true
	round.winner = winner
	round.reason = reason
	round.suddenDeath = false
end

-- Ends the round: a side that has not answered misses by timeout (one more idle check), then
-- both sides' damage lands at once and the duel is decided (or goes to sudden death). A KO
-- comes first; then a side idle for PVP_IDLE_FORFEIT checks in a row forfeits (both idle: a
-- draw), so two players who walked away cannot hold a duel spot; then the round cap. Clears
-- the answers for the next round.
function MogRules.duelRound(duel: Duel): Round
	local round: Round = { results = {}, finished = false, winner = nil, suddenDeath = false, reason = nil }
	if duel.finished then
		return round
	end
	duel.rounds += 1
	for side = 1, 2 do
		local d = duel.sides[side]
		if d.result == nil then
			local idle = d.idle + 1
			MogRules.duelPress(duel, side, "miss")
			d.idle = idle
		end
	end
	local damage = { 0, 0 }
	for side = 1, 2 do
		local result = duel.sides[side].result :: string
		round.results[side] = result
		if result == "perfect" then
			damage[3 - side] += MogRules.PERFECT_DAMAGE
		elseif result == "hit" then
			damage[3 - side] += MogRules.HIT_DAMAGE
		else
			damage[side] += MogRules.PVP_MISS_DAMAGE
		end
	end
	local a, b = duel.sides[1], duel.sides[2]
	a.hp -= damage[1]
	b.hp -= damage[2]
	a.result, b.result = nil, nil
	if a.hp <= 0 or b.hp <= 0 then
		if a.hp == b.hp then
			-- Sudden death: both back to 1 HP, the next round decides.
			a.hp, b.hp = 1, 1
			duel.suddenDeath = true
			round.suddenDeath = true
		else
			decide(duel, round, if a.hp > b.hp then 1 else 2, "ko")
			a.hp, b.hp = math.max(0, a.hp), math.max(0, b.hp)
		end
	end
	if not duel.finished then
		local idleA, idleB = a.idle >= MogRules.PVP_IDLE_FORFEIT, b.idle >= MogRules.PVP_IDLE_FORFEIT
		if idleA or idleB then
			decide(duel, round, if idleA and idleB then nil elseif idleB then 1 else 2, "afk")
		elseif duel.rounds >= MogRules.PVP_MAX_ROUNDS then
			local winner: number? = nil
			if a.hp ~= b.hp then
				winner = if a.hp > b.hp then 1 else 2
			elseif a.score ~= b.score then
				winner = if a.score > b.score then 1 else 2
			end
			decide(duel, round, winner, "rounds")
		end
	end
	return round
end

-- Was a decided duel close? It went to sudden death, or the winner ended at most
-- PVP_CLOSE_MARGIN HP ahead. False for a draw and for a duel that is not over (the caller
-- leaves out forfeits: a side that left or stopped pressing did not lose a close duel).
function MogRules.duelClose(duel: Duel): boolean
	local winner = duel.winner
	if not duel.finished or winner == nil then
		return false
	end
	return duel.suddenDeath or duel.sides[winner].hp - duel.sides[3 - winner].hp <= MogRules.PVP_CLOSE_MARGIN
end

return MogRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="190">
          <Properties>
            <string name="Name">Parkour</string>
            <string name="Source"><![CDATA[--[[
	Parkour: the first game mode. Timed runs over the ten levels in Modes.Course.

	- Levels: every level is out at sea and reached only by teleport. A player has unlocked
	  level 1 + (number of consecutive cleared or skipped levels from 1); "ModeStart" may pick
	  any unlocked level (options.level), else the lowest level not yet cleared or skipped
	  (with none left: the lowest not yet cleared). Walking west
	  through gate 1's portal (Course.crossedStart) does not start a run: it sends a "pick"
	  notify so the client opens the Maps window on the default level. Starting again
	  restarts.
	- No checkpoints (owner's call, docs/sky-obby.md): falling below the cloud floor
	  (Course.inWater) or touching lava (Course.inKill) sends the player back to the START
	  DECK of the map they are running; the clock keeps going.
	- Standing on the finish deck ends the run; Rules.finish checks that the start-to-finish
	  time was not impossibly fast (Course level MIN_SECONDS). Valid finishes record the per-level best/clears
	  (profile.parkour; level 1 is mirrored into profile.modes.parkour) and the server best
	  list of that level, and pay Economy.modeReward × Economy.parkourLevelBonus(level):
	  Theme.Modes.Reward (Seconds of income, at least Min, sized like a cash pack) on the
	  first clear OF THAT LEVEL and then once per
	  Economy.MODE_REWARD_COOLDOWN (one cooldown shared by all levels, modes.parkour.
	  lastRewardAt). After a remote
	  finish the player is brought back to the gates (GameModes.returnLater) wherever they
	  stand on the sky course by then (the finish deck, a bridge, the next map's start deck).
	- Leaving the level's bounds for Course.LEAVE_SECONDS ends the run ("left"); on a remote
	  level the player goes back to the gates.
	- Nobody stays on the sky course without a run: a player with no run who is below the
	  cloud floor, or off every map's start and finish deck for STRANDED_SECONDS (a bridge, a
	  map's path), is taken back to the gates with the toast "Back to the gates" (checked on
	  every mode tick).
	- Stages (docs/sky-obby.md): the ten maps are one chained sky obby; a stage is a map (map n
	  is stage n, map 10's finish is Course.STAGE_COUNT = 11). Stage numbers are progress
	  labels only, never a respawn spot. profile.parkour.stage keeps the highest stage
	  reached (finishing map n reaches n + 1); it follows only the maps really cleared in a
	  row from map 1, so a skipped map never counts (the STAGE board reads it). Player
	  attributes "ParkourStage" (this run's stage, 0 when not running) and "ParkourBestStage"
	  feed the HUD's progress bar.
	- Gear: action "ParkourGear" { gear = "none" | "speed" | "jump" | "gravity" } saves the
	  choice (profile.parkour.gear); it is worn only during a run (speed: WalkSpeed 16 -> 28
	  through the Humanoid's BaseWalkSpeed; jump: JumpHeight 7.2 -> 14 or JumpPower 50 -> 70;
	  gravity: a "GravityCoil" VectorForce on the root lifting 55% of the weight) and taken off
	  on stop / finish / leave. A run that wore gear at any point is `assisted`.
	- Skip Map: action "ParkourSkip" costs Economy.parkourSkipCost(income) cash (two minutes
	  of income, at least Economy.PARKOUR_SKIP_MIN; the snapshot's `skipCost`; a cash action,
	  no Robux receipt). It only unlocks the next map (profile.parkour.skipped[level] = 1): no
	  reward, no clear, no best time, no stage and no board entry, so the map's real first
	  clear still pays later. The run ends and the player stands in front of the gates with
	  the Maps window opened on the next map (nothing starts by itself). With nothing to
	  unlock (the last map, or the next map already unlocked) it is refused and costs nothing.
	  Assisted runs (gear) pay, unlock and count clears but never record a best time or a
	  board entry.

	Notify payloads (kind = "Mode", mode = "parkour"):
	  { event = "pick", level }                                  crossed gate 1: open the Maps
	                                                             window on `level` (the default)
	  { event = "start", checkpoints = 0, startedAt, best?, level, levelName, levels, remote,
	    stage, stageCount, gear, assisted }
	  { event = "respawn", index = 0, stage, stageCount, reason? }
	                                                             back at the map's start deck
	                                                             reason = "kill" after lava
	  { event = "skip", stage, stageCount, index = 0, checkpoints = 0, level, paid = 0,
	    nextLevel, unlocked }                                    paid Skip Map of `level`: it
	                                                             paid nothing; followed by
	                                                             "stop" (reason "skip") and
	                                                             "pick" (level = nextLevel)
	(`checkpoints` / `index` stay 0 for older client code; there is no "checkpoint" event.)
	  { event = "finish", time, best, newBest, first, cash, full, cooldownEnds, rank?,
	    level, levelName, nextLevel?, unlockedNew, unlocked, levels, stage, stageCount,
	    assisted }                                               assisted: newBest false, no rank
	`stage` is the global stage (the map being run; its finish deck: the next one).
	  { event = "invalid", reason }                              "fast"
	  { event = "stop", reason }                                 run ended without a finish
	Effects: "ModeSplash" { pos } where the player hit the water; "ModeKill" { pos } where a
	kill brick (Course.inKill) caught them; "ModeFinish" { pos, newBest }; plus the usual "Cash" { amount,
	source = "Mode", padPos } when cash is paid.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Course = require(script.Parent.Course)
local Rules = require(script.Parent.Rules)

local Parkour = {}

local ID = "parkour"
local BEST_SIZE = 8
-- Seconds after a teleport during which position checks are skipped (the client may still
-- report its old position).
local TELEPORT_GRACE = 0.6
-- Feet are this far below the HumanoidRootPart's centre on a default character.
local FEET_BELOW_ROOT = 3
-- Seconds after a remote finish before the player is taken back to the gates.
local RETURN_SECONDS = 15
-- Seconds a player with no run may stand off every start / finish deck of the sky course
-- before they are taken back to the gates.
local STRANDED_SECONDS = 2
-- A player with no run is caught down to this far under the cloud floor (the hub lies under
-- some maps, much lower: nobody down there is touched).
local RESCUE_DEPTH = 150
-- Studs around the maps' rectangles that still count as the sky course (the bridges between
-- them, the drift of a fall).
local SKY_MARGIN = 60
-- A deck holds feet this far past its edge, under its top and over it (a jump).
local DECK_EDGE = 1.5
local DECK_UNDER = 2
local DECK_OVER = 20

-- Gear (coils) worn during runs.
local GEARS = { none = true, speed = true, jump = true, gravity = true }
local GEAR_WALK_SPEED = 28
local GEAR_JUMP_HEIGHT = 14
local DEFAULT_JUMP_POWER = 50
local GEAR_JUMP_POWER = 70
-- Share of the character's weight the gravity coil cancels.
local GRAVITY_CANCEL = 0.55
local COIL = "GravityCoil"

type State = {
	run: Rules.Run,
	outsideSince: number?,
	graceUntil: number,
	-- Gear was worn during this run.
	assisted: boolean,
	-- The speed coil was worn during this run (looser anti-cheat minimums).
	speedUsed: boolean,
}

type Worn = { gear: string, humanoid: any, root: any, base: any }

-- `skipped` (1 = opened with a paid Skip Map, one slot per level like `clears`) is missing in
-- saves from before it.
type Record = { best: { number }, clears: { number }, stage: number, gear: string, skipped: { number }? }

local function escape(s: string): string
	return (string.gsub(s, "[&<>]", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;" }))
end

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function stageCount(): number
	return Course.STAGE_COUNT
end

local function setAttribute(player: Player, name: string, value: any)
	if player:GetAttribute(name) ~= value then
		player:SetAttribute(name, value)
	end
end

local function speedMultiplier(humanoid: any): number
	local mult = humanoid:GetAttribute("SpeedMultiplier")
	return if type(mult) == "number" then mult else 1
end

-- Was `level` opened with a paid Skip Map?
local function skippedIn(rec: Record, level: number): boolean
	local list = rec.skipped
	return type(list) == "table" and (tonumber(list[level]) or 0) > 0
end

-- Levels unlocked: 1 + consecutive cleared or skipped levels from level 1 (at most
-- LEVEL_COUNT).
local function unlockedOf(rec: Record): number
	local n = 1
	while n < Course.LEVEL_COUNT and ((rec.clears[n] or 0) > 0 or skippedIn(rec, n)) do
		n += 1
	end
	return n
end

-- The lowest level not cleared or skipped yet; with none left, the lowest level not cleared
-- (the last level once all are cleared).
local function defaultOf(rec: Record): number
	local uncleared: number? = nil
	for i = 1, Course.LEVEL_COUNT do
		if (rec.clears[i] or 0) == 0 then
			if not skippedIn(rec, i) then
				return i
			end
			uncleared = uncleared or i
		end
	end
	return uncleared or Course.LEVEL_COUNT
end

-- The stage a record has earned: one past the maps really cleared in a row from map 1 (a
-- skipped map stops the count).
local function earnedStage(rec: Record): number
	local n = 1
	while n <= Course.LEVEL_COUNT and (rec.clears[n] or 0) > 0 do
		n += 1
	end
	return n
end

-- Every map's start and finish deck: where a player with no run may stand.
local DECKS: { Course.Element } = {}
for _, level in Course.LEVELS do
	table.insert(DECKS, level.PATH[1])
	table.insert(DECKS, level.PATH[#level.PATH])
end

-- Are feet at (x, y, z) on one of the DECKS (or hopping over it)?
local function onDeck(x: number, y: number, z: number): boolean
	for _, deck in DECKS do
		if y >= deck.y - DECK_UNDER and y <= deck.y + DECK_OVER and Course.footDistance(deck, x, z) <= DECK_EDGE then
			return true
		end
	end
	return false
end

-- The sky course volume: over any map's rectangle (SKY_MARGIN around it), from RESCUE_DEPTH
-- under the cloud floor up.
local function inSky(x: number, y: number, z: number): boolean
	if y < Course.FLOOR_Y - RESCUE_DEPTH then
		return false
	end
	for _, b in Course.REGIONS do
		if x >= b.x0 - SKY_MARGIN and x <= b.x1 + SKY_MARGIN and z >= b.z0 - SKY_MARGIN and z <= b.z1 + SKY_MARGIN then
			return true
		end
	end
	return false
end

function Parkour.create(GameModes: any, context: { built: any, theme: any, Tycoon: any })
	local theme = context.theme
	local Tycoon = context.Tycoon
	local runs: { [Player]: State } = {}
	local lastX: { [Player]: number } = {}
	-- Players with no run on the sky course: since when they stand off every deck, until
	-- when their position is not trusted (just teleported), and their latest timed return.
	local offDeckSince: { [Player]: number } = {}
	local settleUntil: { [Player]: number } = {}
	local returnTicket: { [Player]: number } = {}
	-- Server best times per level (in memory; see Rules.recordBest for the OrderedDataStore
	-- shape).
	local serverBest: { { Rules.BestEntry } } = {}
	for i = 1, Course.LEVEL_COUNT do
		serverBest[i] = {}
	end

	local function now(): number
		return workspace:GetServerTimeNow()
	end

	-- Shared cooldown + level 1 mirror (old UI).
	local function shared(session: any): { best: number, clears: number, lastRewardAt: number }
		return session.profile.modes.parkour
	end

	local function levels(session: any): Record
		return session.profile.parkour
	end

	local function rewardFor(session: any, level: number): Economy.ModeReward
		local p = session.profile
		local pack = theme.Modes.Reward
		local progression = Economy.progression(Economy.highestTier(p.discovered), p.processLevel)
		local first = (levels(session).clears[level] or 0) == 0
		local r =
			Economy.modeReward(Tycoon.income(session), progression, pack.Seconds, pack.Min, first, shared(session).lastRewardAt, os.time())
		local bonus = Economy.parkourLevelBonus(level)
		r.packCash = math.floor(r.packCash * bonus + 0.5)
		r.cash = if r.full then r.packCash else 0
		return r
	end

	local function updateBoard()
		local label = context.built and context.built.bestList
		if not label then
			return
		end
		local lines = {}
		for i = 1, Course.LEVEL_COUNT do
			local top = serverBest[i][1]
			if top then
				table.insert(lines, string.format("L%d  %s  <b>%.2fs</b>", i, escape(top.name), top.time))
			else
				table.insert(lines, string.format("L%d  —", i))
			end
		end
		label.Text = table.concat(lines, "\n")
	end

	-- Puts the player on `level`'s start deck (start, falls, lava).
	local function teleportTo(player: Player, level: Course.Level)
		local at, look = Course.respawn(level)
		GameModes.teleport(player, vec(at), Vector3.new(look[1], 0, look[2]))
		lastX[player] = at[1]
	end

	-- The runner now stands on global `stage` (a map's start or finish deck): attributes +
	-- saved best. The saved best follows earnedStage, never the stage itself: the map after
	-- a skipped one is not progress on the STAGE board.
	local function reach(player: Player, session: any, stage: number)
		setAttribute(player, "ParkourStage", stage)
		local rec = levels(session)
		local earned = earnedStage(rec)
		if earned > rec.stage then
			rec.stage = earned
			Tycoon.markDirty(session)
		end
		setAttribute(player, "ParkourBestStage", rec.stage)
	end

	-- In front of the gates, off the sky course.
	local function backToGates(player: Player, t: number)
		offDeckSince[player] = nil
		settleUntil[player] = t + TELEPORT_GRACE
		GameModes.toGates(player)
		lastX[player] = nil
	end

	-- Nobody stays on the sky course without a run: below the cloud floor, or off every
	-- start / finish deck for STRANDED_SECONDS (a bridge, a map's path), back to the gates.
	local function rescue(player: Player, x: number, y: number, z: number, t: number)
		if t < (settleUntil[player] or 0) or not inSky(x, y, z) then
			offDeckSince[player] = nil
			return
		end
		if not Course.inWater(x, y, z) then
			if onDeck(x, y, z) then
				offDeckSince[player] = nil
				return
			end
			local since = offDeckSince[player] or t
			offDeckSince[player] = since
			if t - since < STRANDED_SECONDS then
				return
			end
		end
		backToGates(player, t)
		local session = GameModes.session(player)
		if session then
			Tycoon.toast(session, "Back to the gates", "info")
		end
	end

	-- Back to the gates after `seconds`, wherever the player then stands on the sky course
	-- (not if they went home, started a run, or a later return took over).
	local function returnFromSky(player: Player, seconds: number)
		local ticket = (returnTicket[player] or 0) + 1
		returnTicket[player] = ticket
		GameModes.returnLater(player, seconds, function(r: BasePart): boolean
			local at = r.Position
			return returnTicket[player] == ticket and inSky(at.X, at.Y - FEET_BELOW_ROOT, at.Z)
		end)
	end

	-- Gear -------------------------------------------------------------------------------

	local worn: { [Player]: Worn } = {}

	-- Takes the worn coil off and restores the defaults it changed.
	local function removeGear(player: Player)
		local w = worn[player]
		if not w then
			return
		end
		worn[player] = nil
		local humanoid = w.humanoid
		if w.gear == "speed" then
			local base = if type(w.base) == "number" then w.base else Course.WALK_SPEED
			humanoid:SetAttribute("BaseWalkSpeed", base)
			humanoid.WalkSpeed = base * speedMultiplier(humanoid)
		elseif w.gear == "jump" then
			if humanoid.UseJumpPower then
				humanoid.JumpPower = DEFAULT_JUMP_POWER
			else
				humanoid.JumpHeight = Course.JUMP_HEIGHT
			end
		elseif w.gear == "gravity" then
			for _, name in { COIL, COIL .. "Attachment" } do
				local part = w.root:FindFirstChild(name)
				if part then
					part:Destroy()
				end
			end
		end
	end

	-- Puts `gear` on the player's character (taking any other coil off first). True when a
	-- coil is now worn.
	local function wearGear(player: Player, gear: string): boolean
		removeGear(player)
		if gear == "none" or not GEARS[gear] then
			return false
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid") :: any
		local root = GameModes.root(player) :: any
		if not humanoid or not root then
			return false
		end
		local w: Worn = { gear = gear, humanoid = humanoid, root = root, base = humanoid:GetAttribute("BaseWalkSpeed") }
		if gear == "speed" then
			-- Through BaseWalkSpeed so Cosmetics' speed boost still multiplies it.
			humanoid:SetAttribute("BaseWalkSpeed", GEAR_WALK_SPEED)
			humanoid.WalkSpeed = GEAR_WALK_SPEED * speedMultiplier(humanoid)
		elseif gear == "jump" then
			if humanoid.UseJumpPower then
				humanoid.JumpPower = GEAR_JUMP_POWER
			else
				humanoid.JumpHeight = GEAR_JUMP_HEIGHT
			end
		elseif gear == "gravity" then
			local attachment = Instance.new("Attachment")
			attachment.Name = COIL .. "Attachment"
			attachment.Parent = root
			local force = Instance.new("VectorForce")
			force.Name = COIL
			force.Attachment0 = attachment
			force.RelativeTo = Enum.ActuatorRelativeTo.World
			force.ApplyAtCenterOfMass = true
			force.Force = Vector3.new(0, GRAVITY_CANCEL * root.AssemblyMass * workspace.Gravity, 0)
			force.Parent = root
		end
		worn[player] = w
		return true
	end

	-- Wears the player's chosen gear for the run in `state` (marks the run assisted).
	local function equip(player: Player, session: any, state: State)
		local gear = levels(session).gear
		if wearGear(player, gear) then
			state.assisted = true
			state.speedUsed = state.speedUsed or gear == "speed"
		end
	end

	local def = {} :: any
	def.id = ID

	function def.running(player: Player): boolean
		return runs[player] ~= nil
	end

	function def.start(player: Player, teleport: boolean, options: { [string]: any }?): boolean
		local session = GameModes.session(player)
		if not session then
			return false
		end
		local rec = levels(session)
		local index = defaultOf(rec)
		local asked = options and options.level
		if type(asked) == "number" then
			if asked ~= asked or asked < 1 or asked > unlockedOf(rec) then
				return false
			end
			index = math.floor(asked)
		end
		local level = Course.level(index)
		local t = now()
		local state: State = {
			run = Rules.newRun(t, level),
			outsideSince = nil,
			graceUntil = t + TELEPORT_GRACE,
			assisted = false,
			speedUsed = false,
		}
		runs[player] = state
		if teleport or level.remote then
			teleportTo(player, level)
		end
		equip(player, session, state)
		local stage = level.STAGE_FIRST
		reach(player, session, stage)
		local best = rec.best[index] or 0
		GameModes.notify(player, "start", ID, {
			checkpoints = 0,
			startedAt = t,
			best = if best > 0 then best else nil,
			level = index,
			levelName = level.name,
			levels = Course.LEVEL_COUNT,
			remote = level.remote,
			stage = stage,
			stageCount = stageCount(),
			gear = rec.gear,
			assisted = state.assisted,
		})
		GameModes.refresh(player)
		return true
	end

	function def.stop(player: Player, reason: string)
		if not runs[player] then
			return
		end
		runs[player] = nil
		removeGear(player)
		if reason ~= "leave" then
			setAttribute(player, "ParkourStage", 0)
			settleUntil[player] = now() + TELEPORT_GRACE
		end
		if reason ~= "leave" then
			GameModes.notify(player, "stop", ID, { reason = reason })
			GameModes.refresh(player)
		end
	end

	local function finish(player: Player, state: State, root: BasePart, t: number)
		runs[player] = nil
		removeGear(player)
		setAttribute(player, "ParkourStage", 0)
		local session = GameModes.session(player)
		if not session then
			return
		end
		local speedScale = if state.speedUsed then GEAR_WALK_SPEED / Course.WALK_SPEED else 1
		local ok, result = Rules.finish(state.run, t, speedScale)
		if not ok then
			GameModes.notify(player, "invalid", ID, { reason = result })
			GameModes.refresh(player)
			if state.run.level.remote then
				GameModes.returnLater(player, 4, nil)
			end
			return
		end
		local level = state.run.level
		local index = level.index
		local time = Rules.roundTime(result :: number)
		local rec = levels(session)
		local cooldown = shared(session)
		local first = rec.clears[index] == 0
		local unlockedBefore = unlockedOf(rec)
		local reward = GameModes.hooks.reward(session, ID, rewardFor(session, index))
		rec.clears[index] += 1
		if reward.full then
			cooldown.lastRewardAt = os.time()
		end
		local assisted = state.assisted
		local newBest = not assisted and (rec.best[index] <= 0 or time < rec.best[index])
		if newBest then
			rec.best[index] = time
		end
		if index == 1 then
			cooldown.best, cooldown.clears = rec.best[1], rec.clears[1]
		end
		local unlocked = unlockedOf(rec)
		local rank = nil
		if not assisted then
			rank = Rules.recordBest(serverBest[index], player.UserId, player.DisplayName, time, BEST_SIZE)
			updateBoard()
		end
		local stage = level.STAGE_LAST
		reach(player, session, stage)
		setAttribute(player, "ParkourStage", 0)

		local p = session.profile
		if reward.cash > 0 then
			p.money += reward.cash
			p.totalEarned += reward.cash
			GameModes.effect(player, "Cash", { amount = reward.cash, source = "Mode", padPos = root.Position })
		end
		GameModes.effect(player, "ModeFinish", { pos = root.Position, newBest = newBest })
		GameModes.notify(player, "finish", ID, {
			time = time,
			best = rec.best[index],
			newBest = newBest,
			first = first,
			cash = reward.cash,
			full = reward.full,
			cooldownEnds = cooldown.lastRewardAt + Economy.MODE_REWARD_COOLDOWN,
			rank = rank,
			level = index,
			levelName = level.name,
			nextLevel = if index < Course.LEVEL_COUNT then index + 1 else nil,
			unlockedNew = unlocked > unlockedBefore,
			unlocked = unlocked,
			levels = Course.LEVEL_COUNT,
			stage = stage,
			stageCount = stageCount(),
			assisted = assisted,
		})
		GameModes.hooks.rewarded(session, ID, reward)
		Tycoon.markDirty(session)
		GameModes.refresh(player)
		if level.remote then
			returnFromSky(player, RETURN_SECONDS)
		end
	end

	function def.tick(player: Player, root: BasePart, t: number)
		local pos = root.Position
		local x, y, z = pos.X, pos.Y - FEET_BELOW_ROOT, pos.Z
		local prevX = lastX[player]
		lastX[player] = x
		local state = runs[player]
		if prevX and Course.crossedStart(prevX, x, z) and y < Course.PLAZA.top + 8 then
			local session = GameModes.session(player)
			if session then
				GameModes.notify(player, "pick", ID, { level = defaultOf(levels(session)) })
			end
			return
		end
		if not state then
			rescue(player, x, y, z, t)
			return
		end
		offDeckSince[player] = nil
		if t < state.graceUntil then
			return
		end
		local level = state.run.level
		-- Back to the start deck of this map (no checkpoints); the run goes on.
		local function backToStart(reason: string?)
			state.graceUntil = t + TELEPORT_GRACE
			state.outsideSince = nil
			teleportTo(player, level)
			GameModes.notify(player, "respawn", ID, {
				index = 0,
				stage = level.STAGE_FIRST,
				stageCount = stageCount(),
				reason = reason,
			})
		end
		if Course.inWater(x, y, z) then
			GameModes.effect(player, "ModeSplash", { pos = Vector3.new(x, level.WATER_BOX.y0 + 1.2, z) })
			backToStart(nil)
			return
		end
		if Course.inBounds(level, x, y, z) then
			state.outsideSince = nil
			if Course.inKill(level, x, y, z, t) then
				GameModes.effect(player, "ModeKill", { pos = pos })
				backToStart("kill")
				return
			end
		else
			state.outsideSince = state.outsideSince or t
			if t - (state.outsideSince :: number) >= Course.LEAVE_SECONDS then
				def.stop(player, "left")
				if level.remote then
					GameModes.toGates(player)
				end
			end
			return
		end
		if Course.inFinish(level, x, y, z) then
			finish(player, state, root, t)
		end
	end

	-- Reward preview for `level` (default: the player's default level).
	function def.rewardPreview(player: Player, level: number?): { [string]: any }
		local session = GameModes.session(player)
		if not session then
			return { cash = 0, full = false, packCash = 0 }
		end
		local r = rewardFor(session, level or defaultOf(levels(session)))
		return { cash = r.cash, full = r.full, packCash = r.packCash }
	end

	function def.snapshot(player: Player): { [string]: any }
		local session = GameModes.session(player)
		local state = runs[player]
		local rec = session and levels(session)
		local cooldown = session and shared(session)
		local default = if rec then defaultOf(rec) else 1
		local current = if state then state.run.level else Course.level(default)
		local list = {}
		for i, level in Course.LEVELS do
			list[i] = {
				name = level.name,
				difficulty = level.difficulty,
				best = if rec then rec.best[i] else 0,
				clears = if rec then rec.clears[i] else 0,
				checkpoints = 0,
				bonus = Economy.parkourLevelBonus(i),
				-- Map look (Course.MAPS); read defensively so older Course data still works.
				theme = (level :: any).theme,
				blurb = (level :: any).blurb,
				icon = (level :: any).icon,
				accent = (level :: any).accent,
			}
		end
		local best = if rec then rec.best[default] else 0
		local stage = if state then current.STAGE_FIRST else 0
		-- Snapshots go out on join too: keep the HUD bar's attributes current.
		setAttribute(player, "ParkourStage", stage)
		if rec then
			setAttribute(player, "ParkourBestStage", rec.stage)
		end
		return {
			best = if best > 0 then best else nil,
			clears = if rec then rec.clears[default] else 0,
			running = state ~= nil,
			checkpoint = 0,
			checkpoints = 0,
			startedAt = if state then state.run.startedAt else nil,
			cooldownEnds = if cooldown and cooldown.lastRewardAt > 0 then cooldown.lastRewardAt + Economy.MODE_REWARD_COOLDOWN else 0,
			rewardPreview = def.rewardPreview(player, current.index),
			level = current.index,
			unlocked = if rec then unlockedOf(rec) else 1,
			levelCount = Course.LEVEL_COUNT,
			levels = list,
			gear = if rec then rec.gear else "none",
			stage = stage,
			bestStage = if rec then rec.stage else 0,
			stageCount = stageCount(),
			assisted = if state then state.assisted else false,
			skipCost = if session then Economy.parkourSkipCost(Tycoon.income(session)) else Economy.PARKOUR_SKIP_MIN,
		}
	end

	-- Actions ------------------------------------------------------------------------------

	Tycoon.addAction("ParkourGear", function(session: any, data: { [string]: any })
		local gear = data.gear
		if type(gear) ~= "string" or not GEARS[gear] then
			return
		end
		local player = session.player
		levels(session).gear = gear
		Tycoon.markDirty(session)
		local state = runs[player]
		if state then
			equip(player, session, state)
		end
		GameModes.refresh(player)
	end)

	Tycoon.addAction("ParkourSkip", function(session: any)
		local player = session.player
		local state = runs[player]
		if not state or not GameModes.root(player) then
			return
		end
		local level = state.run.level
		local index = level.index
		local rec = levels(session)
		-- A skip only unlocks the next map: with nothing to unlock it is refused, not charged.
		if index >= Course.LEVEL_COUNT then
			Tycoon.toast(session, "This is the last map: there is no map to skip to", "info")
			return
		end
		if unlockedOf(rec) > index then
			Tycoon.toast(session, string.format("Map %d is already unlocked", index + 1), "info")
			return
		end
		local p = session.profile
		local cost = Economy.parkourSkipCost(Tycoon.income(session))
		if p.money < cost then
			Tycoon.toast(session, "Not enough cash! Skip costs " .. Format.money(cost), "bad")
			return
		end
		p.money -= cost
		-- Skip Map: the next map unlocks and nothing else. No finish: no reward, no clear, no
		-- best, no stage and no board entry (the real first clear still pays later).
		local skipped = {}
		for i = 1, Course.LEVEL_COUNT do
			skipped[i] = if skippedIn(rec, i) then 1 else 0
		end
		skipped[index] = 1
		rec.skipped = skipped
		Tycoon.markDirty(session)
		GameModes.notify(player, "skip", ID, {
			stage = level.STAGE_FIRST,
			stageCount = stageCount(),
			index = 0,
			checkpoints = 0,
			level = index,
			paid = 0,
			nextLevel = index + 1,
			unlocked = unlockedOf(rec),
		})
		-- The run is over: back to the gates with the Maps window on the next map, which
		-- starts only when the player presses play (no card over a running clock).
		def.stop(player, "skip")
		backToGates(player, now())
		Tycoon.toast(session, string.format("Map %d skipped. Map %d is unlocked!", index, index + 1), "good")
		GameModes.notify(player, "pick", ID, { level = index + 1 })
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		runs[player] = nil
		lastX[player] = nil
		offDeckSince[player] = nil
		settleUntil[player] = nil
		returnTicket[player] = nil
		removeGear(player)
	end)
	updateBoard()
	return def
end

return Parkour
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="191">
          <Properties>
            <string name="Name">Rules</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rules: the pure parts of a Parkour run (no Roblox dependencies, unit-tested).

	A run records its Course level and the server time it started. There are no checkpoints:
	a run is one leg from the map's start deck to its finish deck, and a fall only sends the
	runner back to the start deck (the clock keeps running). The finish counts only when the
	run took at least the level's MIN_SECONDS (its PATH_LENGTH at MAX_PLAUSIBLE_SPEED: nobody
	crosses the map faster). That minimum assumes WalkSpeed 16: a run that wore the speed coil
	passes `speedScale` (28/16) to Rules.finish so it may be that much quicker. A paid Skip
	Map is no finish at all (it only unlocks the next map), so it never reaches Rules.finish.
]]

local Course = require(script.Parent.Course)

local Rules = {}

export type Run = {
	-- The Course level being run (Course.LEVELS[i]).
	level: Course.Level,
	startedAt: number,
}

function Rules.newRun(now: number, level: Course.Level?): Run
	return { level = level or Course.LEVELS[1], startedAt = now }
end

-- Validates a finish at `now`: (true, seconds) or (false, "fast") when the run was quicker
-- than possible. `speedScale` (default 1) is how much faster than WalkSpeed 16 the runner
-- could move.
function Rules.finish(run: Run, now: number, speedScale: number?): (boolean, number | string)
	local scale = if type(speedScale) == "number" and speedScale >= 1 then speedScale else 1
	local minimum = run.level.MIN_SECONDS
	if type(minimum) ~= "number" or now - run.startedAt < minimum / scale then
		return false, "fast"
	end
	return true, now - run.startedAt
end

-- Seconds rounded to hundredths (what boards and saves store).
function Rules.roundTime(seconds: number): number
	return math.floor(seconds * 100 + 0.5) / 100
end

export type BestEntry = { userId: number, name: string, time: number }

-- Records a time on a best list (one entry per player, fastest first, at most `size`
-- entries). The list is plain data so an OrderedDataStore board (key userId, value
-- centiseconds) can mirror it later. Returns the player's rank on it, or nil.
function Rules.recordBest(list: { BestEntry }, userId: number, name: string, time: number, size: number): number?
	local found = nil
	for i, entry in list do
		if entry.userId == userId then
			found = i
			break
		end
	end
	if found then
		if list[found].time <= time then
			return found
		end
		table.remove(list, found)
	end
	table.insert(list, { userId = userId, name = name, time = time })
	table.sort(list, function(a, b)
		return a.time < b.time
	end)
	while #list > size do
		table.remove(list)
	end
	for i, entry in list do
		if entry.userId == userId then
			return i
		end
	end
	return nil
end

return Rules
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="192">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--[[
	Monetization: game passes and developer products.

	Developer products: cash packs (Theme.Monetization.MoneyPacks),
	aura packs (AuraPacks: aura straight into the tank, Tycoon.grantAura) and the instant
	crate open. Pack amounts follow the buyer's progression (Shared.Economy).

	IDs come from the theme. While an ID is 0:
	  - in Studio, "buying" grants it immediately (so every feature is testable)
	  - on a live server, the player is told it is coming soon.

	Instant crate opening is one developer product for every crate rarity
	(Theme.Monetization.CrateOpen), for the held crate or one still in a smasher; the
	prompted crate's rarity (and smasher slot) is recorded in profile.pendingCrate
	(pendingUnlocker) so the receipt can pay out even if the crate is gone.
	Crates are paid random items, so the product is only offered where PolicyService
	allows them (unknown or failed lookup = not allowed). The Crate Master pass
	(Passes.CrateKey) opens every crate free; Tycoon handles that without a prompt.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)

local Analytics = require(script.Parent.Analytics)
local DataService = require(script.Parent.DataService)
local Tycoon = require(script.Parent.Tycoon)

local Monetization = {}

local theme: any
local MAX_RECEIPTS = 50

-- Players whose policy allows paid random items (crate products). Absent = not
-- allowed: still loading, the lookup failed, or restricted.
local crateAllowed: { [Player]: boolean } = {}

local function loadPolicy(player: Player)
	local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
	if not player.Parent then
		return
	end
	local allowed = ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false
	if allowed then
		crateAllowed[player] = true
	end
	Tycoon.refresh(player)
end

function Monetization.crateRobuxAllowed(player: Player): boolean
	return crateAllowed[player] == true
end

local function passByName(name: string): any
	return theme.Monetization.Passes[name]
end

local function productList(kind: string): { any }?
	if kind == "Money" then
		return theme.Monetization.MoneyPacks
	elseif kind == "Aura" then
		return theme.Monetization.AuraPacks
	elseif kind == "LegacyMoney" then
		-- Retired packs: only reachable through a receipt (Tycoon never prompts this kind).
		return theme.Monetization.LegacyMoneyPacks
	end
	return nil
end

-- Checks which passes a player already owns. Studio play tests start with none: the
-- place's creator owns every pass, and Auto Aura would turn the orb loop off (passes
-- are still granted there by test purchases).
function Monetization.ownedPasses(player: Player): { [string]: boolean }
	local owned = {}
	if RunService:IsStudio() then
		return owned
	end
	for name, pass in theme.Monetization.Passes do
		if pass.Id ~= 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and result then
				owned[name] = true
			end
		end
	end
	return owned
end

-- Packs are sized by the buyer's progression at the moment the receipt is processed, with
-- the same shared functions the shop uses to show each player their own amounts.
local function grantProduct(session: Tycoon.Session, kind: string, index: number)
	local p = session.profile
	local progression = Economy.progression(Economy.highestTier(p.discovered), p.processLevel)
	if kind == "Money" or kind == "LegacyMoney" then
		local pack = (productList(kind) :: { any })[index]
		local amount = Economy.moneyPackAmount(Tycoon.income(session), pack.Seconds, pack.Min, progression)
		Tycoon.grantMoney(session, amount)
	elseif kind == "Aura" then
		local pack = theme.Monetization.AuraPacks[index]
		-- Surge-free production (the shop card's State.rewardProduction): a pack bought during an
		-- Aura Surge is not doubled by accident, and is what the card showed.
		local amount = Economy.auraPackAmount(Tycoon.steadyProduction(session), pack.Seconds, pack.Min, progression)
		Tycoon.grantAura(session, amount)
	end
end

-- Instant crate open for a held crate of `rarity`, or for the crate in smasher `slot`
-- (see Tycoon.openCrateProduct).
function Monetization.promptCrate(player: Player, rarity: string, slot: number?)
	local session = Tycoon.getSession(player)
	local product = theme.Monetization.CrateOpen
	if not session or not Economy.isRarity(rarity) then
		return
	end
	if not Monetization.crateRobuxAllowed(player) then
		if slot then
			Tycoon.toast(session, "Come back when the timer ends!", "info")
		else
			Tycoon.toast(session, "Carry it to a " .. theme.Words.Unlocker .. " to open it free!", "info")
		end
		return
	end
	-- The product is the same for every rarity: remember which crate this prompt is for.
	session.profile.pendingCrate = rarity
	session.profile.pendingUnlocker = slot or 0
	if product.Id == 0 then
		if RunService:IsStudio() then
			Tycoon.openCrateProduct(session)
			Tycoon.toast(session, "[Studio test] Crate opened", "good")
		else
			Tycoon.toast(session, "Opening crates instantly is coming soon!", "info")
		end
		return
	end
	Analytics.shop(player, 2, "Prompted")
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

function Monetization.promptPass(player: Player, name: string)
	local session = Tycoon.getSession(player)
	local pass = passByName(name)
	if not session or not pass then
		return
	end
	if session.passes[name] then
		Tycoon.toast(session, "You already own " .. pass.Title .. "!", "info")
		return
	end
	-- Cosmetic passes are not random items: never behind the paid-random-items policy.
	local cosmetics = theme.Cosmetics
	local item = cosmetics and cosmetics.Items[name]
	if item and not item.Starter and session.passes[cosmetics.Bundle] then
		Tycoon.toast(session, pass.Title .. " is already in your " .. theme.Monetization.Passes[cosmetics.Bundle].Title .. "!", "info")
		return
	end
	-- Crate Master opens paid random items: only sold where those are allowed.
	if name == "CrateKey" and not Monetization.crateRobuxAllowed(player) then
		Tycoon.toast(session, pass.Title .. " is not available here.", "info")
		return
	end
	if pass.Id == 0 then
		if RunService:IsStudio() then
			Tycoon.setPass(player, name)
			Tycoon.toast(session, "[Studio test] Granted " .. pass.Title, "good")
		else
			Tycoon.toast(session, pass.Title .. " is coming soon!", "info")
		end
		return
	end
	Analytics.shop(player, 2, "Prompted")
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

function Monetization.promptProduct(player: Player, kind: string, index: number)
	local session = Tycoon.getSession(player)
	local list = productList(kind)
	local product = list and list[index]
	if not session or not product then
		return
	end
	if product.Id == 0 then
		if RunService:IsStudio() then
			grantProduct(session, kind, index)
			Tycoon.toast(session, "[Studio test] Product granted", "good")
		else
			Tycoon.toast(session, "This pack is coming soon!", "info")
		end
		return
	end
	Analytics.shop(player, 2, "Prompted")
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

-- (kind, index) of a pack, or ("Crate", true) for the crate product.
local function findProduct(productId: number): (string?, any)
	for _, kind in { "Money", "Aura", "LegacyMoney" } do
		for index, product in productList(kind) :: { any } do
			if product.Id ~= 0 and product.Id == productId then
				return kind, index
			end
		end
	end
	local crate = theme.Monetization.CrateOpen
	if crate.Id ~= 0 and crate.Id == productId then
		return "Crate", true
	end
	return nil, nil
end

-- Persists the profile; only report the purchase as granted once it is saved.
local function saveOrRetry(session: Tycoon.Session): Enum.ProductPurchaseDecision
	if not session.canSave then
		-- Studio without API access: nothing to persist.
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if DataService.save(session.player, session.profile) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local session = Tycoon.getSessionByUserId(receipt.PlayerId)
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = session.profile
	if table.find(profile.receipts, receipt.PurchaseId) then
		-- Already granted in this session; make sure it is persisted.
		return saveOrRetry(session)
	end
	local kind, index = findProduct(receipt.ProductId)
	if not kind or not index then
		warn("[Monetization] Unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Grant and record the receipt together. If the save below fails, Roblox
	-- retries this callback; the recorded receipt makes the retry a no-op grant
	-- that only re-attempts the save, so the player is never paid twice.
	-- A crate product always pays out, even if the crate was dropped or the
	-- player rejoined (no session = NotProcessedYet above, retried on rejoin):
	-- the prompted smasher's crate, else the held crate, else the saved pendingCrate
	-- rarity, else a Common crate.
	if kind == "Crate" then
		Tycoon.openCrateProduct(session)
	else
		grantProduct(session, kind, index)
	end
	Analytics.shop(session.player, 3, "Purchased")
	table.insert(profile.receipts, receipt.PurchaseId)
	while #profile.receipts > MAX_RECEIPTS do
		table.remove(profile.receipts, 1)
	end
	return saveOrRetry(session)
end

function Monetization.init(themeModule: any)
	theme = themeModule
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for name, pass in theme.Monetization.Passes do
			if pass.Id == passId then
				Analytics.shop(player, 3, "Purchased")
				Tycoon.setPass(player, name)
				local session = Tycoon.getSession(player)
				if session then
					Tycoon.toast(session, "Thanks! " .. pass.Title .. " is active.", "good")
				end
			end
		end
	end)
	Tycoon.hooks.promptPass = Monetization.promptPass
	Tycoon.hooks.promptProduct = Monetization.promptProduct
	Tycoon.hooks.promptCrate = Monetization.promptCrate
	Tycoon.hooks.crateRobuxAllowed = Monetization.crateRobuxAllowed
	Players.PlayerAdded:Connect(loadPolicy)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPolicy, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		crateAllowed[player] = nil
	end)
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="193">
        <Properties>
          <string name="Name">PlotLayout</string>
          <string name="Source"><![CDATA[--!strict
--[[
	PlotLayout: the plot-local geometry shared by WorldBuilder (which builds it)
	and Tycoon (orb and crate routes, pen detection).

	Pure data with no Roblox dependencies so tests/run.luau can check that pads,
	the pen, its stairs, the gutter/chute, machines and fan zones never overlap,
	that crates land in the front of the pen and that the walkway from the entrance stays clear.

	Plot-local axes: Z = toward the back fence, Y = up, and (Roblox being
	right-handed) +X is on your LEFT when you walk in from the hub facing +Z.
	The plot floor's top surface is y = 0; the entrance is at z = -PLOT_HALF (-52).

	Units stand on a tall display rack along the back: up to 10 shelves stacked
	upward, each a little behind the one below, one model per unit (100 slots;
	only the shelves the owner's units need are shown). Their orbs drop off the
	front of the rack into a gutter at its foot (it drains to x = 0), roll down a
	short chute over the pen's back wall and pile up in the walled PEN. Crates
	take the same route: a Chad drops one, it slides down the gutter and chute
	and lands in the front half of the pen. The pen floor is at ground level;
	stairs climb over its side walls.

	Side view of the rack (+Z to the right, entrance on the left):

	        y ~ 65 |   [roof + sign]       shelf n+1 would sit here
	               |   ||=====|  shelf 3   (each shelf: board, rim, band,
	               |  ||=====|   shelf 2    back panel, side posts)
	   y = 3.8   ~~|=====| (*)   shelf 1, (*) = champion pedestal at x = 0
	   gutter    \_/   z = 34 ->  1.1 studs further back per shelf, 6 up

	Top-down as seen walking in (hub at the bottom, +X on the left). The plot is roomy (100 studs
	between the fences) and the room is spent on open floor: the rack stands against the back
	fence with the gutter, chute and pen in front of it, and the middle of the plot is bare sand
	around the pen. Every group of pads stands on its own painted court (COURTS) with at least 5
	studs between neighbouring pad bases: the buy row on one long court across the back, either
	side of the pen; the crate stations down the +X court; the aura -> cash stations down the -X
	court, each machine right behind its own pad(s). A wide cream path runs from the entrance to
	the round merge court and branches along the pen's front (PLAZA) to both side courts; the
	main loop is pen -> merge -> deposit (level with the plaza) -> collect. The front fence holds
	a little gym dressing and the interactive props (INTERACTIVE), each on its own round mat:

	                       back fence (z = 52)
	  +---------------------------------------------------------+
	  | fans    [ display rack: 10 shelves, 100 slots ]   fans  |
	  | fans    [~~~~~~~~ gutter -> (x = 0) <- ~~~~~~~~]   fans  |
	  |,--------------------- chute ---------------------------.|
	  |:        B1   B5   #==== PEN ====#   B25   B100   AUTO  :|  buy court
	  |`------------------#             #----------------------'|
	  | ,------------.   _|# (orbs)    #|_      ,------------.  |
	  | :crk> UNLOCK1:    #  [crates]   #       :DEPOSIT<conv:  |
	  | :            :    #=============#       :            :  |
	  | :            :=======( MERGE )==========:            :  |  plaza
	  | :palm        :        |    |            :        palm:  |
	  | :crk> UNLOCK2:        |walk|            :PROC^10<proc:  |
	  | :            :        |way |            :PROC^1 <proc:  |
	  | :            :        |    |            :            :  |
	  | :gift  FREE  :        |    |            :COLLECT<vlt :  |
	  | `------------'        |    |            `------------'  |
	  |                                                         |
	  | (tramp)  (bag)  palm  |    |  palm  [bench]  (podium)   |
	  |                  [ entrance arch ]                      |
	  +---------------------------------------------------------+
	 x = +52                                                x = -52
]]

export type Rect = { minX: number, maxX: number, minZ: number, maxZ: number }
export type PadSpot = { x: number, z: number, sizeX: number, sizeZ: number, round: boolean? }
export type Point = { x: number, y: number, z: number }
export type Step = { rect: Rect, top: number }
export type Stair = { side: number, rect: Rect, steps: { Step } }
export type FanZone = { rect: Rect, side: number }
export type FanSpot = { x: number, z: number, faceX: number, faceZ: number }

local Layout = {}

local function rect(minX: number, maxX: number, minZ: number, maxZ: number): Rect
	return { minX = minX, maxX = maxX, minZ = minZ, maxZ = maxZ }
end

Layout.PLOT_HALF = 52
-- Inner faces of the fences: nothing should be built past this.
Layout.INNER_HALF = 50

-- Front edge of the display rack (the gutter's back edge). The rack's footprint is 15 deep and
-- ends a stud off the back fence; the gutter, chute and pen are all placed from this line, so
-- the whole group keeps its shape wherever the plot's size puts it.
local RACK_FRONT_Z = Layout.INNER_HALF - 16

-- Radius of the orbs Tycoon places (ORB_SIZE / 2); orb paths are orb-centre positions.
Layout.ORB_RADIUS = 0.8

-- The walled orb pen, at ground level, directly in front of the display ledge.
-- `interior` is the open floor inside the walls; the walls sit around it.
local PEN_INTERIOR = rect(-10, 10, RACK_FRONT_Z - 22, RACK_FRONT_Z - 6)
local PEN_WALL_THICK = 1.6
Layout.PEN = {
	interior = PEN_INTERIOR,
	wallHeight = 1.6,
	wallThick = PEN_WALL_THICK,
	-- Square corner posts, a little taller than the walls.
	postSize = 2.4,
	postHeight = 2.2,
	-- Top of the pen floor part ("Field"); it sits just above the plot floor.
	floorY = 0.15,
}

-- The pen's footprint, walls included ("pool" in Tycoon and Plot).
Layout.POOL = rect(
	PEN_INTERIOR.minX - PEN_WALL_THICK,
	PEN_INTERIOR.maxX + PEN_WALL_THICK,
	PEN_INTERIOR.minZ - PEN_WALL_THICK,
	PEN_INTERIOR.maxZ + PEN_WALL_THICK
)
-- Local Y of the pen floor's walkable surface (orbs rest on it).
Layout.POOL_FLOOR_Y = Layout.PEN.floorY
Layout.POOL_CENTER_Z = (PEN_INTERIOR.minZ + PEN_INTERIOR.maxZ) / 2

-- Stairs over the pen's side walls, one on each side (+X = left when walking in), at the
-- front half of the wall. Each has three outer steps (the last one level with the wall top)
-- and one inner step down to the pen floor. `rect` covers the outer steps only.
Layout.STAIR_RUN = 1.2
Layout.STAIR_WIDTH = 4
local STAIR_Z = PEN_INTERIOR.minZ + 3.5
Layout.PEN_STAIRS = {} :: { Stair }
for _, side in { 1, -1 } do
	local wallOuter = side * Layout.POOL.maxX
	local wallInner = side * PEN_INTERIOR.maxX
	local z0, z1 = STAIR_Z - Layout.STAIR_WIDTH / 2, STAIR_Z + Layout.STAIR_WIDTH / 2
	local steps: { Step } = {}
	for i = 1, 3 do
		-- Step i is the i-th from the outside; step 3 touches the wall.
		local far = wallOuter + side * (4 - i) * Layout.STAIR_RUN
		local near = wallOuter + side * (3 - i) * Layout.STAIR_RUN
		table.insert(steps, {
			rect = rect(math.min(far, near), math.max(far, near), z0, z1),
			top = Layout.PEN.wallHeight * i / 3,
		})
	end
	local innerEdge = wallInner - side * Layout.STAIR_RUN
	table.insert(steps, {
		rect = rect(math.min(wallInner, innerEdge), math.max(wallInner, innerEdge), z0, z1),
		top = Layout.PEN.wallHeight / 2,
	})
	local outerEdge = wallOuter + side * 3 * Layout.STAIR_RUN
	table.insert(Layout.PEN_STAIRS, {
		side = side,
		rect = rect(math.min(wallOuter, outerEdge), math.max(wallOuter, outerEdge), z0, z1),
		steps = steps,
	})
end

-- Where dropped orbs land: the pen floor, clear of the walls and the inner stair steps.
Layout.ORB_AREA = rect(
	PEN_INTERIOR.minX + Layout.STAIR_RUN + 0.6,
	PEN_INTERIOR.maxX - Layout.STAIR_RUN - 0.6,
	PEN_INTERIOR.minZ + 1,
	PEN_INTERIOR.maxZ - 1
)

-- Display rack: Economy.DISPLAY_ROWS shelves stacked up the back of the ledge, 100 slots.
-- Odd shelves hold 11 units and even ones 9 (10 on average) so every shelf is centred on
-- x = 0 and the front shelf's centre slot is the raised "best unit" pedestal (slot 1).
-- Each shelf stands stepBack further back and rowRise higher than the one below, like steep
-- bleachers. Shelf models are display-scaled to at most unitMaxHeight tall (displayScale)
-- so every unit fits under the shelf above: rowRise = standY + unitMaxHeight + headroom +
-- boardThick (the front shelf gets championRise extra for the pedestal).
Layout.SHELF = {
	-- Between the side posts' inner faces; the posts stand postWidth outside it.
	width = 58,
	postWidth = 1.6,
	rows = 10,
	rowCols = { 11, 9, 11, 9, 11, 9, 11, 9, 11, 9 },
	-- Centre-to-centre distance of neighbouring units on a shelf (all shelves share the grid).
	spacing = 5.3,
	-- Front edge of the front shelf (the gutter's back edge) and every shelf board's depth.
	frontZ = RACK_FRONT_Z,
	depth = 4,
	stepBack = 1.1,
	-- Centre Z of the front shelf (where its units stand).
	firstZ = RACK_FRONT_Z + 2,
	-- Deck top of the front shelf; each shelf above is rowRise higher (see rowTop).
	firstTop = 3.8,
	rowRise = 6,
	boardThick = 0.7,
	headroom = 0.3,
	-- Standing height above a shelf's deck top.
	standY = 0,
	-- Extra height of the best-unit pedestal (slot 1).
	championRise = 1.3,
	-- Tallest a unit is shown on the rack (studs); taller tiers are scaled down to this.
	unitMaxHeight = 5,
	-- How far a shelf's rim and front band stick out past its front edge.
	frontReach = 0.3,
}
local SHELF_FRONT_Z = Layout.SHELF.frontZ

-- Deck top (y) of shelf `row`; row = rows + 1 is the rack's roof.
function Layout.rowTop(row: number): number
	local s = Layout.SHELF
	return s.firstTop + (row - 1) * s.rowRise + (if row > 1 then s.championRise else 0)
end

-- Front edge (z) of shelf `row`; the shelf is SHELF.depth deep behind it.
function Layout.rowFrontZ(row: number): number
	local s = Layout.SHELF
	return s.frontZ + (row - 1) * s.stepBack
end

-- Shelves needed to show `unitCount` units (at least one, at most SHELF.rows).
function Layout.rackRows(unitCount: number): number
	local s = Layout.SHELF
	local room = 0
	for row = 1, s.rows do
		room += s.rowCols[row]
		if unitCount <= room then
			return row
		end
	end
	return s.rows
end

-- Scale applied to a shelf model whose true height is `height` so it fits its shelf (the
-- Index and reward viewports keep true sizes; Tycoon applies this when it builds shelf models).
function Layout.displayScale(height: number): number
	return math.min(1, Layout.SHELF.unitMaxHeight / height)
end

-- The gutter along the foot of the ledge. Its rolling surface (trough bottom) is at endY at
-- both ends and drains to centerY at x = 0; the lips stand lipHeight above the surface.
Layout.GUTTER = {
	rect = rect(-29, 29, SHELF_FRONT_Z - 2.5, SHELF_FRONT_Z),
	-- Centre line of the trough.
	z = SHELF_FRONT_Z - 1.25,
	width = 2.5,
	endY = 3.2,
	centerY = 2.6,
	lipHeight = 0.5,
}

-- The chute from the gutter's centre down over the pen's back wall into the pen. Heights are
-- the rolling surface at each end; the bottom end hangs just inside the back wall.
Layout.CHUTE = {
	x = 0,
	width = 2.4,
	topZ = Layout.GUTTER.z,
	topY = Layout.GUTTER.centerY,
	bottomZ = PEN_INTERIOR.maxZ - 0.8,
	bottomY = 1.9,
	rect = rect(-1.2, 1.2, PEN_INTERIOR.maxZ - 0.8, Layout.GUTTER.z),
}

-- Height of a crate's pivot (the centre of its body) above the surface it rests on.
Layout.CRATE_LIFT = 1.1
-- Clearance from a crate's centre to anything it must not overlap, at any yaw (half the
-- diagonal of its 3.6 x 2.6 lid, rounded up).
Layout.CRATE_RADIUS = 2.3

-- Where dropped crates land (crate centres): the front half of the pen, a crate radius clear
-- of the walls and the inner stair steps, and far from the chute mouth at the back.
Layout.CHEST_AREAS = {
	rect(
		PEN_INTERIOR.minX + Layout.STAIR_RUN + Layout.CRATE_RADIUS,
		PEN_INTERIOR.maxX - Layout.STAIR_RUN - Layout.CRATE_RADIUS,
		PEN_INTERIOR.minZ + Layout.CRATE_RADIUS,
		Layout.POOL_CENTER_Z
	),
}

-- Centre of the merge pad: on the centre line, its base a little over 4 studs in front of the
-- pen's front wall.
local MERGE_Z = PEN_INTERIOR.minZ - 10

-- The entrance walkway: kept clear of pads, crates and machines from the entrance to the
-- merge pad, which ends it in front of the pen (Layout.PADS.Merge: 7 + 2 * PAD_RIM wide). The
-- path painted along it is wider (World.Decor).
Layout.WALKWAY = rect(-4, 4, -Layout.INNER_HALF, MERGE_Z - 4)

export type ShelfSlot = { x: number, y: number, z: number, row: number, best: boolean }

-- Every display slot in fill order: the bottom shelf first, each shelf centre-out, so the
-- highest tiers (the display fills best-first) stand at eye level and slot 1 is the
-- front-centre champion pedestal. y = the unit's standing height.
function Layout.shelfSlots(): { ShelfSlot }
	local s = Layout.SHELF
	local out: { ShelfSlot } = {}
	for row = 1, s.rows do
		local cols = s.rowCols[row]
		local spacing = s.spacing
		local top = Layout.rowTop(row)
		local z = Layout.rowFrontZ(row) + s.depth / 2
		-- Column indices (1-based, left to right in -X..+X) ordered centre-out.
		local order: { number } = {}
		local mid = (cols + 1) / 2
		if cols % 2 == 1 then
			table.insert(order, mid)
			for k = 1, (cols - 1) / 2 do
				table.insert(order, mid - k)
				table.insert(order, mid + k)
			end
		else
			for k = 0, cols / 2 - 1 do
				table.insert(order, math.floor(mid) - k)
				table.insert(order, math.ceil(mid) + k)
			end
		end
		for _, col in order do
			local best = #out == 0
			table.insert(out, {
				x = -(cols - 1) * spacing / 2 + (col - 1) * spacing,
				y = top + s.standY + (if best then s.championRise else 0),
				z = z,
				row = row,
				best = best,
			})
		end
	end
	return out
end

-- On the walkway, facing the pen from as far in front of it as on the old, smaller plot, so
-- the spawn view frames the pen and the rack the same way; the spawn camera (Fx.Camera, about
-- 15 studs behind and above) is well inside the plot.
Layout.SPAWN = { x = 0, z = MERGE_Z - 16 }

-- A pad's thin base reaches this far past its coloured top on every side.
Layout.PAD_RIM = 0.5

-- Pad tops (the trigger area). Order is the build order.
Layout.PAD_ORDER = {
	"Buy1",
	"Buy5",
	"Buy25",
	"Buy100",
	"AutoMerge",
	"Merge",
	"Deposit",
	"ProcUp1",
	"ProcUp10",
	"Collect",
	"Unlock1",
	"Unlock2",
	"Free",
}
-- Small pads (4 x 4.2 tops, at least 4 studs on the short side so a walking character fits) with
-- at least 5 studs of open floor between neighbouring bases and 6 between a pad and the pen.
local BUY_Z = PEN_INTERIOR.maxZ - 1.5
-- The side courts hold three stations each, mirrored left and right: level with the plaza in
-- front of the pen, half-way down, and by the front fence.
local ROW_BACK, ROW_MID, ROW_FRONT = 7, -14, -32
-- The pad column of each side court (the machines stand behind it, toward the fence).
local PAD_X = 34
Layout.PADS = {
	-- One row at the foot of the unit rack, level with the back of the pen, reading Buy 1,
	-- Buy 5, [pen], Buy 25, Buy 100, Auto Merge from the player's left (+X) to right.
	Buy1 = { x = 32, z = BUY_Z, sizeX = 4, sizeZ = 4.2 },
	Buy5 = { x = 22, z = BUY_Z, sizeX = 4, sizeZ = 4.2 },
	Buy25 = { x = -22, z = BUY_Z, sizeX = 4, sizeZ = 4.2 },
	Buy100 = { x = -32, z = BUY_Z, sizeX = 4, sizeZ = 4.2 },
	AutoMerge = { x = -42, z = BUY_Z, sizeX = 4, sizeZ = 4.2 },
	-- The merge pad closes the walkway, centred in front of the pen's front wall.
	Merge = { x = 0, z = MERGE_Z, sizeX = 7, sizeZ = 7 },
	-- -X court (right when walking in), back to front: the big deposit pad in front of the
	-- converter, level with the plaza (the first stop after merging); the two process upgrades
	-- in front of the processor; collect in front of the vault.
	Deposit = { x = -31, z = ROW_BACK, sizeX = 10, sizeZ = 12 },
	ProcUp10 = { x = -PAD_X, z = ROW_MID + 5.2, sizeX = 4, sizeZ = 4.2 },
	ProcUp1 = { x = -PAD_X, z = ROW_MID - 5.2, sizeX = 4, sizeZ = 4.2 },
	Collect = { x = -PAD_X, z = ROW_FRONT, sizeX = 4.5, sizeZ = 4.5 },
	-- +X court (left when walking in): a crate cracker pad per station, then the free reward.
	Unlock1 = { x = PAD_X, z = ROW_BACK, sizeX = 4.5, sizeZ = 4.5 },
	Unlock2 = { x = PAD_X, z = ROW_MID, sizeX = 4.5, sizeZ = 4.5 },
	Free = { x = PAD_X, z = ROW_FRONT, sizeX = 4.5, sizeZ = 4.5 },
} :: { [string]: PadSpot }

-- Open floor kept between pads: between neighbouring bases, and from any pad to the pen's
-- walls and stairs (the merge pad, which ends the walkway, sits MERGE_PEN_GAP in front).
Layout.PAD_GAP = 5
Layout.PAD_PEN_GAP = 6
Layout.MERGE_PEN_GAP = 3

-- Floor footprints of the big machines (pads, crates and fans must stay clear). Each stands on
-- its side court right behind its own pad(s), its front toward the plot's centre line, its
-- back about MACHINE_BACK from the centre, clear of the fence.
local MACHINE_BACK = 45.5
Layout.MACHINES = {
	Converter = rect(-MACHINE_BACK, -MACHINE_BACK + 7, ROW_BACK - 3.5, ROW_BACK + 3.5),
	-- The juice bar is a thin counter: it stands a stud in so its sign board fits behind it.
	Processor = rect(-MACHINE_BACK + 1, -MACHINE_BACK + 5.5, ROW_MID - 7, ROW_MID + 7),
	Vault = rect(-MACHINE_BACK + 0.5, -MACHINE_BACK + 5.5, ROW_FRONT - 3, ROW_FRONT + 3),
	Unlocker1 = rect(MACHINE_BACK - 6, MACHINE_BACK, ROW_BACK - 4.5, ROW_BACK + 4.5),
	Unlocker2 = rect(MACHINE_BACK - 6, MACHINE_BACK, ROW_MID - 4.5, ROW_MID + 4.5),
	-- The display rack, side posts included.
	Shelves = rect(
		-Layout.SHELF.width / 2 - Layout.SHELF.postWidth,
		Layout.SHELF.width / 2 + Layout.SHELF.postWidth,
		SHELF_FRONT_Z,
		SHELF_FRONT_Z + 15
	),
}

-- Painted courts (flat floor paint, see World.Decor): one rounded mat per group of pads, in the
-- group's pad colour family with a white border line and a clear margin round every pad. The
-- buy court runs across the back (the pen stands on its middle); the side courts stand well
-- off the pen (COURT_INNER from the centre line), so the pen and its stairs have open sand all
-- round. Sand joints separate the courts from each other and from the fences.
local COURT_INNER = 23
local COURT_OUTER = MACHINE_BACK + 2
Layout.COURTS = {
	Buy = rect(-47, 47, BUY_Z - 5, BUY_Z + 4.8),
	Cash = rect(-COURT_OUTER, -COURT_INNER, -38, 19),
	Crates = rect(COURT_INNER, COURT_OUTER, -38, 19),
} :: { [string]: Rect }
-- Width of the white border line round every court.
Layout.COURT_LINE = 0.6
-- The pads and machines standing on each court.
Layout.COURT_MEMBERS = {
	Buy = { pads = { "Buy1", "Buy5", "Buy25", "Buy100", "AutoMerge" }, machines = {} },
	Cash = { pads = { "ProcUp1", "ProcUp10", "Deposit", "Collect" }, machines = { "Processor", "Converter", "Vault" } },
	Crates = { pads = { "Unlock1", "Unlock2", "Free" }, machines = { "Unlocker1", "Unlocker2" } },
} :: { [string]: { pads: { string }, machines: { string } } }
-- The round court under the merge pad (it covers the pad's whole base).
Layout.MERGE_COURT = { x = Layout.PADS.Merge.x, z = Layout.PADS.Merge.z, radius = 7 }
-- The cream plaza across the front of the pen: the walkway's crossbar, joining both side courts.
Layout.PLAZA = rect(-COURT_INNER, COURT_INNER, MERGE_Z - 5, Layout.POOL.minZ - 0.9)

-- Interactive props along the front fence, each on its own round mat of `radius` (World.Decor
-- builds them as Interactive_<Kind> models). They keep off the courts and the spawn view. The
-- bench press mirrors the punch bag; its mat is a teal rectangle inside the same radius.
local PROP_Z = -Layout.INNER_HALF + 6
Layout.INTERACTIVE = {
	Trampoline = { x = 42, z = PROP_Z, radius = 4 },
	PunchBag = { x = 30.5, z = PROP_Z, radius = 3.5 },
	Bench = { x = -30.5, z = PROP_Z, radius = 4 },
	FlexPodium = { x = -42, z = PROP_Z, radius = 4 },
} :: { [string]: { x: number, z: number, radius: number } }

-- Where cheering fans stand: the back corners beside the display rack, off every walkway and
-- behind the buy court. `side` is +1 for the +X zone and -1 for the -X zone.
Layout.FAN_ZONES = {
	{ rect = rect(36, 44, SHELF_FRONT_Z + 1.5, SHELF_FRONT_Z + 15), side = 1 },
	{ rect = rect(-44, -36, SHELF_FRONT_Z + 1.5, SHELF_FRONT_Z + 15), side = -1 },
} :: { FanZone }

-- The point fans face: the middle of the display rack's footprint.
Layout.FAN_FOCUS = { x = 0, z = SHELF_FRONT_Z + 7.5 }

-- Fan standing spots in fill order: alternating sides, front-of-ledge and nearest-the-centre
-- first, each with a unit facing direction (faceX, faceZ) toward the display.
function Layout.fanSpots(): { FanSpot }
	local spacing = 3
	local perSide: { { FanSpot } } = {}
	for _, zone in Layout.FAN_ZONES do
		local r = zone.rect
		local list: { FanSpot } = {}
		local cols = math.max(1, math.floor((r.maxX - r.minX) / spacing))
		local rows = math.max(1, math.floor((r.maxZ - r.minZ) / spacing))
		local colGap = (r.maxX - r.minX) / cols
		local rowGap = (r.maxZ - r.minZ) / rows
		-- Columns nearest the centre line first, then rows front to back.
		for ci = 0, cols - 1 do
			local x = if zone.side > 0 then r.minX + colGap * (ci + 0.5) else r.maxX - colGap * (ci + 0.5)
			for ri = 0, rows - 1 do
				local z = r.minZ + rowGap * (ri + 0.5)
				local dx, dz = Layout.FAN_FOCUS.x - x, Layout.FAN_FOCUS.z - z
				local len = math.sqrt(dx * dx + dz * dz)
				table.insert(list, { x = x, z = z, faceX = dx / len, faceZ = dz / len })
			end
		end
		table.insert(perSide, list)
	end
	local out: { FanSpot } = {}
	local i = 1
	while true do
		local added = false
		for _, list in perSide do
			if list[i] then
				table.insert(out, list[i])
				added = true
			end
		end
		if not added then
			break
		end
		i += 1
	end
	return out
end

-- Helpers -----------------------------------------------------------------------

Layout.rect = rect

-- Footprint of a pad's top, grown by `extra` on every side.
function Layout.padRect(spot: PadSpot, extra: number?): Rect
	local e = extra or 0
	return {
		minX = spot.x - spot.sizeX / 2 - e,
		maxX = spot.x + spot.sizeX / 2 + e,
		minZ = spot.z - spot.sizeZ / 2 - e,
		maxZ = spot.z + spot.sizeZ / 2 + e,
	}
end

function Layout.contains(r: Rect, x: number, z: number, margin: number?): boolean
	local m = margin or 0
	return x >= r.minX - m and x <= r.maxX + m and z >= r.minZ - m and z <= r.maxZ + m
end

-- True when the rectangles overlap (touching edges do not count).
function Layout.overlaps(a: Rect, b: Rect, margin: number?): boolean
	local m = margin or 0
	return a.minX < b.maxX + m and b.minX < a.maxX + m and a.minZ < b.maxZ + m and b.minZ < a.maxZ + m
end

-- Is a plot-local point (x, z) over the pen (walls included)?
-- Tycoon.fastTick does the same test against Plot.pool.
function Layout.inPool(x: number, z: number): boolean
	return Layout.contains(Layout.POOL, x, z)
end

-- Height of the gutter's rolling surface at plot-local x (clamped to the gutter's length).
function Layout.gutterY(x: number): number
	local g = Layout.GUTTER
	local half = (g.rect.maxX - g.rect.minX) / 2
	local t = math.clamp(math.abs(x) / half, 0, 1)
	return g.centerY + (g.endY - g.centerY) * t
end

local slotCache: { ShelfSlot }? = nil

-- Standing height of the display slot nearest to (x, z).
local function feetY(x: number, z: number): number
	local best, bestDist = Layout.SHELF.firstTop + Layout.SHELF.standY, math.huge
	if not slotCache then
		slotCache = Layout.shelfSlots()
	end
	for _, slot in slotCache :: { ShelfSlot } do
		local d = (slot.x - x) ^ 2 + (slot.z - z) ^ 2
		if d < bestDist then
			best, bestDist = slot.y, d
		end
	end
	return best
end

-- Half the length of a crate's lid: how far its body reaches in front of its pivot.
local CRATE_HALF_LENGTH = 1.8

-- Rack -> gutter -> chute -> pen waypoints for something whose centre rides `r` above each
-- surface and reaches `reach` in front of its centre (see orbPath and cratePath). It first
-- moves straight out at its own shelf's height (above every shelf below, whose units stand
-- under that shelf) to a drop point in front of the rack, then falls into the gutter.
local function routeVia(r: number, reach: number, fromX: number, fromZ: number, toX: number, toZ: number, toY: number?): { Point }
	local g = Layout.GUTTER
	local c = Layout.CHUTE
	local gx = math.clamp(fromX, g.rect.minX + g.width / 2, g.rect.maxX - g.width / 2)
	local feet = feetY(fromX, fromZ) + r
	local dropZ = math.min(g.z, SHELF_FRONT_Z - Layout.SHELF.frontReach - reach)
	return {
		{ x = fromX, y = feet, z = fromZ },
		{ x = fromX, y = feet, z = dropZ },
		{ x = gx, y = Layout.gutterY(gx) + r, z = g.z },
		{ x = c.x, y = c.topY + r, z = c.topZ },
		{ x = c.x, y = c.bottomY + r, z = c.bottomZ },
		{ x = toX, y = toY or (Layout.PEN.floorY + r), z = toZ },
	}
end

-- The route an orb takes from a unit's feet to its landing spot in the pen, as orb-centre
-- waypoints (plot-local): unit feet -> drop point in front of the rack at the same height ->
-- gutter below the unit -> chute top -> chute bottom -> landing. Always 6 points; a segment
-- can be zero length (a unit standing over the chute). `toY` is the landing centre height
-- (default: resting on the pen floor).
function Layout.orbPath(fromX: number, fromZ: number, toX: number, toZ: number, toY: number?): { Point }
	return routeVia(Layout.ORB_RADIUS, Layout.ORB_RADIUS, fromX, fromZ, toX, toZ, toY)
end

-- The same route for a crate dropped by the unit at (fromX, fromZ): crate-pivot waypoints
-- (CRATE_LIFT above each surface), unit feet -> drop point -> gutter -> chute top -> chute
-- bottom -> landing (6 points).
function Layout.cratePath(fromX: number, fromZ: number, toX: number, toZ: number, toY: number?): { Point }
	return routeVia(Layout.CRATE_LIFT, CRATE_HALF_LENGTH, fromX, fromZ, toX, toZ, toY)
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="194">
        <Properties>
          <string name="Name">Ranking</string>
          <string name="Source"><![CDATA[--[[
	Ranking: global leaderboards (OrderedDataStore), falling back to the players in this
	server when DataStores are unavailable.

	- Units: total units obtained (TOP_COUNT entries, also on the plaza boards).
	- Stage: the sky obby's highest global stage reached (profile.parkour.stage), top
	  STAGE_TOP_COUNT, ties broken by total parkour clears. The ordered value packs both:
	  stage * STAGE_PACK + min(clears, STAGE_PACK - 1).

	Query "Ranking" returns { entries = { { rank, userId, name, value } }, updatedAt,
	stage = { { rank, userId, name, stage, clears } } }.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Net = require(ReplicatedStorage.Shared.Net)
local Tycoon = require(script.Parent.Tycoon)

local Ranking = {}

local TOP_COUNT = 50
local REFRESH_SECONDS = 90
local MAX_SCORE = 2 ^ 53

local STAGE_TOP_COUNT = 10
local STAGE_PACK = 10000

type Entry = { rank: number, userId: number, name: string, value: number }
type StageEntry = { rank: number, userId: number, name: string, stage: number, clears: number }

local ordered: OrderedDataStore? = nil
local stageOrdered: OrderedDataStore? = nil
local top: { Entry } = {}
local stageTop: { StageEntry } = {}
local updatedAt = 0
local nameCache: { [number]: string } = {}

local ok, err = pcall(function()
	ordered = DataStoreService:GetOrderedDataStore("TotalUnits_v1")
	stageOrdered = DataStoreService:GetOrderedDataStore("ObbyStage_v1")
end)
if not ok then
	warn("[Ranking] OrderedDataStore unavailable:", err)
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local success, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if success and name then name else ("User " .. userId)
	nameCache[userId] = result
	return result
end

-- (stage, clears) of a profile's sky obby record.
local function stageOf(profile: any): (number, number)
	local rec = profile.parkour
	if type(rec) ~= "table" then
		return 0, 0
	end
	local clears = 0
	if type(rec.clears) == "table" then
		for _, n in rec.clears do
			clears += n
		end
	end
	return if type(rec.stage) == "number" then rec.stage else 0, clears
end

local function packStage(stage: number, clears: number): number
	return math.floor(stage) * STAGE_PACK + math.min(math.floor(clears), STAGE_PACK - 1)
end

local function unpackStage(value: number): (number, number)
	return value // STAGE_PACK, value % STAGE_PACK
end

local function writeScores()
	if ordered then
		local store = ordered :: OrderedDataStore
		for player, session in Tycoon.allSessions() do
			local score = math.floor(math.min(session.profile.totalObtained, MAX_SCORE))
			pcall(store.SetAsync, store, tostring(player.UserId), score)
		end
	end
	if stageOrdered then
		local store = stageOrdered :: OrderedDataStore
		for player, session in Tycoon.allSessions() do
			local stage, clears = stageOf(session.profile)
			if stage > 0 then
				pcall(store.SetAsync, store, tostring(player.UserId), packStage(stage, clears))
			end
		end
	end
end

local function localFallback(): { Entry }
	local list: { Entry } = {}
	for player, session in Tycoon.allSessions() do
		table.insert(list, { rank = 0, userId = player.UserId, name = player.Name, value = session.profile.totalObtained })
	end
	table.sort(list, function(a, b)
		return a.value > b.value
	end)
	for i, entry in list do
		entry.rank = i
	end
	return list
end

local function readTop(): { Entry }?
	if not ordered then
		return nil
	end
	local store = ordered :: OrderedDataStore
	local success, pages = pcall(store.GetSortedAsync, store, false, TOP_COUNT)
	if not success or not pages then
		return nil
	end
	local list: { Entry } = {}
	for i, item in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(item.key) or 0
		table.insert(list, { rank = i, userId = userId, name = nameFor(userId), value = item.value })
	end
	return list
end

local function localStageFallback(): { StageEntry }
	local list: { StageEntry } = {}
	for player, session in Tycoon.allSessions() do
		local stage, clears = stageOf(session.profile)
		if stage > 0 then
			table.insert(list, { rank = 0, userId = player.UserId, name = player.Name, stage = stage, clears = clears })
		end
	end
	table.sort(list, function(a, b)
		if a.stage ~= b.stage then
			return a.stage > b.stage
		end
		return a.clears > b.clears
	end)
	while #list > STAGE_TOP_COUNT do
		table.remove(list)
	end
	for i, entry in list do
		entry.rank = i
	end
	return list
end

local function readStageTop(): { StageEntry }?
	if not stageOrdered then
		return nil
	end
	local store = stageOrdered :: OrderedDataStore
	local success, pages = pcall(store.GetSortedAsync, store, false, STAGE_TOP_COUNT)
	if not success or not pages then
		return nil
	end
	local list: { StageEntry } = {}
	for i, item in (pages :: DataStorePages):GetCurrentPage() do
		local userId = tonumber(item.key) or 0
		local stage, clears = unpackStage(item.value)
		table.insert(list, { rank = i, userId = userId, name = nameFor(userId), stage = stage, clears = clears })
	end
	return list
end

local function updateBoards(labels: { TextLabel }, themeModule: any)
	local lines = {}
	for i = 1, math.min(10, #top) do
		local entry = top[i]
		local color = if i == 1 then "#FFD23C" elseif i == 2 then "#D8D8E6" elseif i == 3 then "#E08A4A" else "#FFFFFF"
		table.insert(
			lines,
			string.format(
				'<font color="%s">#%d</font>  %s  <font color="#9CF0A0">%s</font>',
				color,
				i,
				entry.name,
				Format.short(entry.value)
			)
		)
	end
	if #lines == 0 then
		table.insert(lines, "Be the first " .. themeModule.Words.Unit .. " collector!")
	end
	local text = table.concat(lines, "\n")
	for _, label in labels do
		label.Text = text
	end
end

local function refresh(labels: { TextLabel }, themeModule: any)
	writeScores()
	top = readTop() or localFallback()
	stageTop = readStageTop() or localStageFallback()
	updatedAt = os.time()
	updateBoards(labels, themeModule)
end

function Ranking.init(themeModule: any, labels: { TextLabel })
	Net.func("Query").OnServerInvoke = function(_player, kind)
		if kind == "Ranking" then
			if #top == 0 then
				top = localFallback()
			end
			if #stageTop == 0 then
				stageTop = localStageFallback()
			end
			return { entries = top, updatedAt = updatedAt, stage = stageTop }
		end
		return nil
	end

	task.spawn(function()
		task.wait(5)
		while true do
			local success, problem = pcall(refresh, labels, themeModule)
			if not success then
				warn("[Ranking] refresh failed:", problem)
			end
			task.wait(REFRESH_SECONDS)
		end
	end)
end

Ranking.writeScores = writeScores
-- Exposed for the unit tests.
Ranking.packStage = packStage
Ranking.unpackStage = unpackStage
Ranking.stageOf = stageOf

return Ranking
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="195">
        <Properties>
          <string name="Name">Tutorial</string>
          <string name="Source"><![CDATA[--[[
	Tutorial: server side of the onboarding checklist.

	Progress lives in the saved profile (tutorialStep 1..6, tutorialDone) and
	is sent to the client in the State snapshot. Steps advance on real gameplay
	events reported by Tycoon.listeners; the order and rules are in
	Shared.TutorialSteps. Finishing grants a one-time reward; skipping does not.

	Notify payloads (client shows them):
	  { kind = "Tutorial", event = "step", step = n }
	  { kind = "Tutorial", event = "done", cash = c }
	  { kind = "Tutorial", event = "skipped" }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local Net = require(Shared.Net)
local TutorialSteps = require(Shared.TutorialSteps)

local Analytics = require(script.Parent.Analytics)
local Badges = require(script.Parent.Badges)
local Tycoon = require(script.Parent.Tycoon)

local Tutorial = {}

local NotifyRemote: RemoteEvent

local function notify(session: Tycoon.Session, payload: { [string]: any })
	payload.kind = "Tutorial"
	NotifyRemote:FireClient(session.player, payload)
end

local function finish(session: Tycoon.Session)
	local p = session.profile
	p.tutorialStep = TutorialSteps.DONE
	p.tutorialDone = true
	p.money += Economy.TUTORIAL_REWARD_CASH
	p.totalEarned += Economy.TUTORIAL_REWARD_CASH
	Badges.graduate(session)
	notify(session, { event = "done", cash = Economy.TUTORIAL_REWARD_CASH })
end

-- Moves to `step`, skipping anything the profile already shows as done.
local function advanceTo(session: Tycoon.Session, step: number)
	local p = session.profile
	step = TutorialSteps.catchUp(step, p)
	if step == p.tutorialStep then
		return
	end
	p.tutorialStep = step
	Analytics.tutorial(session, step)
	if step >= TutorialSteps.DONE then
		finish(session)
	else
		notify(session, { event = "step", step = step })
	end
	Tycoon.markDirty(session)
end

local function active(session: Tycoon.Session): boolean
	return session.alive and not session.profile.tutorialDone
end

function Tutorial.onEvent(session: Tycoon.Session, name: string, _data: { [string]: any })
	if not active(session) then
		return
	end
	local current = TutorialSteps.clamp(session.profile.tutorialStep)
	local nextStep = TutorialSteps.onEvent(current, name)
	if nextStep ~= current then
		advanceTo(session, nextStep)
	end
end

function Tutorial.skip(session: Tycoon.Session)
	if not active(session) then
		return
	end
	local p = session.profile
	p.tutorialDone = true
	Analytics.tutorial(session, p.tutorialStep, true)
	p.tutorialStep = TutorialSteps.DONE
	notify(session, { event = "skipped" })
	Tycoon.markDirty(session)
end

function Tutorial.init()
	NotifyRemote = Net.event("Notify")
	table.insert(Tycoon.listeners, Tutorial.onEvent)
	Tycoon.addAction("SkipTutorial", function(session)
		Tutorial.skip(session)
	end)

	-- Safety net: a step the profile already satisfies (e.g. a pass collected
	-- the orbs for you) completes on its own.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, session in Tycoon.allSessions() do
				if active(session) then
					local current = TutorialSteps.clamp(session.profile.tutorialStep)
					advanceTo(session, current)
				end
			end
		end
	end)
end

return Tutorial
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="196">
        <Properties>
          <string name="Name">Tycoon</string>
          <string name="Source"><![CDATA[--[[
	Tycoon: the core game loop for every player.

	One Session per player: owns a plot, the saved profile and all runtime
	objects on that plot (displayed units, orbs, floor crates, the held crate).

	Loops:
	  fast (0.1s)  pad detection, orb pickup, automatic crate pickup
	  slow (1s)    production, processing, auto passes, boards, state push
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local OrbLook = require(Shared.OrbLook)
local CratePickup = require(Shared.CratePickup)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local TutorialSteps = require(Shared.TutorialSteps)
local CharacterFactory = require(Shared.CharacterFactory)

local WorldBuilder = require(script.Parent.WorldBuilder)
local Layout = require(script.Parent.PlotLayout)
local Shelves = require(script.Parent.World.Shelves)
local Props = require(script.Parent.World.Props)

type Profile = any

-- Roblox's built-in Robux glyph, for prices in server-made messages.
local ROBUX = utf8.char(0xE002)
type Plot = WorldBuilder.Plot

-- `cell` is the pile slot the orb rests in (see orbCells): 1..n on the floor, PILE_TOP + k on top.
-- `due`: Auto Aura collects the orb at this os.clock() (after its roll-in lands and rests).
-- `dumbbell`: a rare prize piece (OrbLook.DUMBBELL_*) that is never fed and blocks the cells around it.
type Orb = { part: BasePart, value: number, count: number, cell: number, tier: number, due: number?, dumbbell: boolean? }
-- `landsAt`: os.clock() by which the client's arrival has landed (CratePickup.landTime);
-- `blocked`: in range when the last held crate was released, until the player leaves its range.
type FloorChest = { model: Model, rarity: string, position: Vector3, landsAt: number, blocked: boolean }
type DisplaySlot = { tier: number, model: Model }

-- One stay on a pad: `since` = os.clock() of the step onto it, `fired` = its handler ran,
-- `linger` = the handler asked for its padLingerHandlers entry if the player stays.
type PadVisit = { since: number, fired: boolean, linger: boolean }

export type Session = {
	player: Player,
	profile: Profile,
	canSave: boolean,
	plot: Plot,
	passes: { [string]: boolean },
	premium: boolean,
	friendBonus: number,
	inside: { [string]: PadVisit },
	converterPos: Vector3?,
	orbs: { Orb },
	floorChests: { FloorChest },
	heldModel: Model?,
	display: { [number]: DisplaySlot },
	displayCounts: string,
	dirty: boolean,
	chestTimer: number,
	-- First run: no crates until the tutorial is done (`inTutorial` = it was still running on
	-- the last slow tick); the first crate after it always drops (`chestCertain`).
	inTutorial: boolean,
	chestCertain: boolean,
	collectBuffer: number,
	actionBudget: number,
	lastPickupFlush: number,
	crateRearmUntil: number,
	lastToast: { [string]: number },
	-- os.clock() of the last "this is a game pass" toast per pad (PASS_HINT_INTERVAL).
	lastPassHint: { [string]: number },
	alive: boolean,
}

local Tycoon = {}

local theme: any
local world: WorldBuilder.World
local sessions: { [Player]: Session } = {}
local plotOwners: { [number]: Player } = {}
local rng = Random.new()

-- Pen fill: every produced orb lands as its own ball until the pen holds OrbLook.CAP balls (or
-- the pile has no free slot); after that a new orb joins an existing ball (OrbLook.feedTarget)
-- and that ball's Count goes up.
local ORB_SIZE = Layout.ORB_RADIUS * 2
-- The pile: floor slots on a jittered grid around PILE_FOCUS (plot-local), and top slots
-- resting in the hollow between four occupied floor slots.
local PILE_SPACING = 1.8
local PILE_JITTER = 0.1
local PILE_SCATTER = 6 -- random studs added to each slot's distance when picking one
local PILE_TOP = 1000 -- cell ids above this are top-layer slots
local PILE_TOP_FROM = 40 -- floor orbs needed before the pile grows a partial second layer
local PILE_TOP_CHANCE = 0.3
local ORB_PICKUP_RADIUS = 6
local ORB_PICKED_POSITIONS = 12
-- Merge effects per action; more steps are sent as one summarised effect.
local MAX_MERGE_EFFECTS = 6
local MERGE_FROM_POSITIONS = 4
-- Crates keep this far apart (centre to centre) when they land in the pen.
local CHEST_SPACING = 6
-- Landing spots tried before a crate drop is skipped (the pen front is full).
local CHEST_SPOT_TRIES = 12
local ACTIONS_PER_SECOND = 15
-- Orb pickups push State right away (so the HUD tank keeps up), at most this often.
local PICKUP_FLUSH_INTERVAL = 0.09
-- Plot-local height window for the HumanoidRootPart to count as standing on a
-- pad (pads sit on the main floor at y = 0).
local PAD_MIN_Y = 0.5
local PAD_MAX_Y = 10
-- Pads that fire only after the player has stood on them this long (seconds): the upgrade
-- pads lie on the Deposit to Collect walking line, and a walker crosses a 4.2-stud pad in
-- 0.26 s. Every other pad fires on entry.
local PAD_DWELL = { ProcUp1 = 0.4, ProcUp10 = 0.4 }
-- Standing this long on a busy Smasher pad (no crate in hand) offers the Robux smash.
local SMASH_OFFER_DWELL = 1.5
-- A pass pad says "this is a game pass" at most this often (seconds); it never opens a prompt.
local PASS_HINT_INTERVAL = 60
-- Orbs can be collected only from inside the pen (walls and stair tops included),
-- up to this high above its floor.
local POOL_REACH_Y = 12

local NotifyRemote: RemoteEvent
local EffectRemote: RemoteEvent
local StateRemote: RemoteEvent
local ActionRemote: RemoteEvent

-- Filled in by Main so Tycoon does not depend on Monetization directly.
Tycoon.hooks = {
	promptPass = function(_player: Player, _name: string) end,
	promptProduct = function(_player: Player, _kind: string, _index: number) end,
	promptCrate = function(_player: Player, _rarity: string, _slot: number?) end,
	-- May this player buy instant crate opens (paid random items)? Monetization
	-- answers from PolicyService; this default only serves previews and tests.
	crateRobuxAllowed = function(_player: Player): boolean
		return true
	end,
	-- Called after setPass records a newly bought pass (Cosmetics applies it).
	passGranted = function(_session: Session, _name: string) end,
	-- The State snapshot's `cosmetics` field (filled in by Cosmetics).
	cosmetics = function(_session: Session): { [string]: any }?
		return nil
	end,
	-- The State snapshot's `modes` field (filled in by GameModes).
	modes = function(_session: Session): { [string]: any }?
		return nil
	end,
	-- Called before the "Home" action moves the player (GameModes ends any run first).
	leavingForHome = function(_session: Session) end,
	-- The State snapshot's `daily` field (filled in by Daily).
	daily = function(_session: Session): { [string]: any }?
		return nil
	end,
}

-- Gameplay event listeners (used by the tutorial): fn(session, name, data).
-- Names: "Buy", "Pickup", "Deposit", "Cash", "Merge", and "Discover" (a tier was discovered
-- for the first time; Analytics counts its milestones).
Tycoon.listeners = {} :: { (Session, string, { [string]: any }) -> () }

local function emit(session: Session, name: string, data: { [string]: any })
	for _, listener in Tycoon.listeners do
		task.spawn(listener, session, name, data)
	end
end

local function random(): number
	return rng:NextNumber()
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

-- Helpers ----------------------------------------------------------------------

function Tycoon.getSession(player: Player): Session?
	return sessions[player]
end

function Tycoon.getSessionByUserId(userId: number): Session?
	for player, session in sessions do
		if player.UserId == userId then
			return session
		end
	end
	return nil
end

function Tycoon.allSessions(): { [Player]: Session }
	return sessions
end

local function notify(session: Session, payload: { [string]: any })
	NotifyRemote:FireClient(session.player, payload)
end

local function toast(session: Session, text: string, tone: string?)
	-- Pads fire repeatedly if a player hops on them; avoid spamming the same text.
	local now = os.clock()
	if session.lastToast[text] and now - session.lastToast[text] < 1 then
		return
	end
	session.lastToast[text] = now
	notify(session, { kind = "Toast", text = text, tone = tone or "info" })
end
Tycoon.toast = toast
Tycoon.notify = notify

local function effect(session: Session, kind: string, data: { [string]: any }?)
	EffectRemote:FireClient(session.player, kind, data or {})
end

local function markDirty(session: Session)
	session.dirty = true
end
Tycoon.markDirty = markDirty

local function tierName(tier: number): string
	local entry = theme.Tiers[tier]
	return if entry then entry.Name else ("Tier " .. tier)
end

function Tycoon.moneyMultiplier(session: Session): number
	local mult = if session.passes.DoubleMoney then 2 else 1
	local bonus = session.friendBonus + (if session.premium then Economy.PREMIUM_BONUS else 0)
	return mult * (1 + bonus)
end

function Tycoon.orbMultiplier(session: Session): number
	local mult = if session.passes.DoubleAura then 2 else 1
	local surge = Economy.surgeState(serverNow())
	if surge then
		mult *= Economy.SURGE_MULTIPLIER
	end
	return mult
end

function Tycoon.production(session: Session): number
	return Economy.productionPerSecond(session.profile.units) * Tycoon.orbMultiplier(session)
end

-- Orbs per second the converter turns into cash: doubled by the Double Aura pass and, with
-- `surge`, while the Aura Surge runs (both double the orbs too, so the cash really doubles).
local function processRate(session: Session, surge: boolean): number
	local rate = Economy.processRate(session.profile.processLevel)
	if session.passes.DoubleAura then
		rate *= 2
	end
	if surge and Economy.surgeState(serverNow()) then
		rate *= Economy.SURGE_MULTIPLIER
	end
	return rate
end

-- Production without the Aura Surge (the Double Aura pass counts): what aura packs are sized
-- with, so a pack is the same in and out of a surge.
function Tycoon.steadyProduction(session: Session): number
	return Economy.productionPerSecond(session.profile.units) * (if session.passes.DoubleAura then 2 else 1)
end
local steadyProduction = Tycoon.steadyProduction

-- Cash per second without the Aura Surge: what every reward is sized with (free gift, daily,
-- mode packs, Robux packs), so a reward is the same in and out of a surge.
function Tycoon.income(session: Session): number
	return Economy.incomePerSecond(steadyProduction(session), processRate(session, false), Tycoon.moneyMultiplier(session))
end

-- Cash per second right now, surge included (the HUD's number).
function Tycoon.incomeNow(session: Session): number
	return Economy.incomePerSecond(Tycoon.production(session), processRate(session, true), Tycoon.moneyMultiplier(session))
end

local function highestTier(session: Session): number
	return Economy.highestTier(session.profile.discovered)
end

local function canAfford(session: Session, cost: number): boolean
	return session.profile.money >= cost - 1e-6
end

-- Tells the client a pad action was refused (shake / buzz on the pad).
local function refusePad(session: Session, name: string, reason: string)
	local pad = session.plot.padByName[name]
	effect(session, "Pad", { name = name, padPos = pad and pad.part.Position, ok = false, reason = reason })
end

-- `padName` = the pad that asked for the purchase (gets a "money" refusal effect).
local function spend(session: Session, cost: number, padName: string?): boolean
	if not canAfford(session, cost) then
		toast(session, "Not enough cash! Need " .. Format.money(cost), "bad")
		if padName then
			refusePad(session, padName, "money")
		end
		return false
	end
	session.profile.money = math.max(0, session.profile.money - cost)
	return true
end

local function addMoney(session: Session, amount: number)
	session.profile.money += amount
	session.profile.totalEarned += amount
end

-- Unit display -------------------------------------------------------------------

-- Every owned unit stands on the rack as its own model (the unit cap keeps the total
-- within Economy.DISPLAY_SLOTS). Shelf models are built display-scaled so tall tiers fit
-- under the shelf above (Layout.displayScale); viewports elsewhere keep true sizes.
local displayLooks: { [number]: any } = {}

local function displayLook(tier: number): any
	local cached = displayLooks[tier]
	if cached then
		return cached
	end
	local look = theme.Tiers[tier].Look
	local scale = Layout.displayScale(CharacterFactory.height(look))
	local shown = look
	if scale < 1 then
		shown = table.clone(look)
		shown.scale = (look.scale or 1) * scale
	end
	displayLooks[tier] = shown
	return shown
end

-- World positions of shelf models by tier: consumed (destroyed), newly created,
-- and everything shown after the refresh.
type ShelfDiff = {
	removed: { [number]: { Vector3 } },
	added: { [number]: { Vector3 } },
	shown: { [number]: { Vector3 } },
}

local function pushPos(map: { [number]: { Vector3 } }, tier: number, pos: Vector3)
	local list = map[tier]
	if not list then
		list = {}
		map[tier] = list
	end
	table.insert(list, pos)
end

-- Tags a display model with its slot and the top front edge of the shelf lip under its feet
-- (Fx.Plates hangs the unit's name plate from that edge, facing the pen).
local function markSlot(model: Model, slotIndex: number, slot: CFrame)
	local s = Layout.SHELF
	local lift = s.standY + (if slotIndex == 1 then s.championRise else 0)
	model:SetAttribute("Slot", slotIndex)
	model:SetAttribute("PlateAt", slot * CFrame.new(0, -lift, -(s.depth / 2 + s.frontReach)))
end

-- Diffs the shelf against the unit counts: models that keep their tier stay put,
-- models whose tier moved to another slot are re-pivoted, only new units get new
-- models, and surplus models are destroyed (after recording their positions). Then shows
-- just the rack shelves those units need (Shelves.setRows).
local function refreshDisplay(session: Session): ShelfDiff
	local units = session.profile.units
	local slots = session.plot.slots
	local wanted: { number } = {}
	for tier = Economy.MAX_TIER, 1, -1 do
		local count = units[tier] or 0
		local shown = math.min(count, Economy.DISPLAY_SLOTS - #wanted)
		for _ = 1, shown do
			table.insert(wanted, tier)
		end
		if #wanted >= Economy.DISPLAY_SLOTS then
			break
		end
	end

	local diff: ShelfDiff = { removed = {}, added = {}, shown = {} }
	local old = session.display
	local nextDisplay: { [number]: DisplaySlot } = {}

	-- Keep models already standing in a slot that still shows their tier.
	for slotIndex = 1, Economy.DISPLAY_SLOTS do
		local current = old[slotIndex]
		if current and wanted[slotIndex] == current.tier then
			nextDisplay[slotIndex] = current
		end
	end
	-- Everything else is up for reuse, per tier, in slot order.
	local spare: { [number]: { DisplaySlot } } = {}
	for slotIndex = 1, Economy.DISPLAY_SLOTS do
		local current = old[slotIndex]
		if current and nextDisplay[slotIndex] ~= current then
			local list = spare[current.tier]
			if not list then
				list = {}
				spare[current.tier] = list
			end
			table.insert(list, current)
		end
	end

	for slotIndex = 1, Economy.DISPLAY_SLOTS do
		local tier = wanted[slotIndex]
		if tier and not nextDisplay[slotIndex] then
			local list = spare[tier]
			if list and #list > 0 then
				local entry = table.remove(list, 1) :: DisplaySlot
				entry.model:PivotTo(slots[slotIndex])
				markSlot(entry.model, slotIndex, slots[slotIndex])
				nextDisplay[slotIndex] = entry
			else
				local model = CharacterFactory.build(displayLook(tier), tierName(tier))
				model:PivotTo(slots[slotIndex])
				model:SetAttribute("Tier", tier)
				model:SetAttribute("Spawned", serverNow())
				markSlot(model, slotIndex, slots[slotIndex])
				model.Parent = session.plot.unitFolder
				nextDisplay[slotIndex] = { tier = tier, model = model }
				pushPos(diff.added, tier, model:GetPivot().Position)
			end
		end
	end

	for tier, list in spare do
		for _, entry in list do
			pushPos(diff.removed, tier, entry.model:GetPivot().Position)
			entry.model:Destroy()
		end
	end

	for slotIndex = 1, Economy.DISPLAY_SLOTS do
		local entry = nextDisplay[slotIndex]
		if entry then
			pushPos(diff.shown, entry.tier, entry.model:GetPivot().Position)
		end
	end

	session.display = nextDisplay
	Shelves.setRows(session.plot.folder, Layout.rackRows(#wanted))
	return diff
end

-- Merge effects --------------------------------------------------------------------

local function mergeTarget(diff: ShelfDiff, tier: number): Vector3?
	local added = diff.added[tier]
	if added and added[1] then
		return added[1]
	end
	local shown = diff.shown[tier]
	return shown and shown[1]
end

-- One "Merge" effect per merge step (fromTier -> fromTier + 1), or a single
-- summarised effect when a batch cascades through many tiers.
local function sendMergeEffects(session: Session, steps: { Economy.MergeStep }, auto: boolean, diff: ShelfDiff)
	if #steps == 0 then
		return
	end
	if #steps > MAX_MERGE_EFFECTS then
		local from: { Vector3 } = {}
		local total = 0
		for _, step in steps do
			total += step.made
			local removed: { Vector3 } = diff.removed[step.tier] or {}
			for _, pos in removed do
				if #from < MERGE_FROM_POSITIONS then
					table.insert(from, pos)
				end
			end
		end
		local toTier = steps[#steps].tier + 1
		effect(session, "Merge", {
			fromTier = steps[1].tier,
			toTier = toTier,
			from = from,
			to = mergeTarget(diff, toTier),
			auto = auto,
			count = total,
			summary = true,
		})
		return
	end
	-- A cascade feeds each step's result into the next one, so a step whose
	-- consumed unit was never on the shelf starts from the previous result.
	local carry: Vector3? = nil
	for _, step in steps do
		local from: { Vector3 } = {}
		local removed: { Vector3 } = diff.removed[step.tier] or {}
		for _, pos in removed do
			if #from >= MERGE_FROM_POSITIONS then
				break
			end
			table.insert(from, pos)
		end
		if #from < 2 and carry then
			table.insert(from, carry)
		end
		local to = mergeTarget(diff, step.tier + 1)
		effect(session, "Merge", {
			fromTier = step.tier,
			toTier = step.tier + 1,
			from = from,
			to = to,
			auto = auto,
			count = step.made,
		})
		carry = to or from[1]
	end
end

-- One summarised "Merge" effect (overflow = true) for the merges the unit cap forced
-- (Economy.addUnitsCapped): lowest consumed tier -> highest created tier, `count` merges.
local function sendOverflowEffect(session: Session, steps: { Economy.MergeStep }, diff: ShelfDiff)
	if #steps == 0 then
		return
	end
	local low, high, total = math.huge, 0, 0
	local from: { Vector3 } = {}
	for _, step in steps do
		low = math.min(low, step.tier)
		high = math.max(high, step.tier + 1)
		total += step.made
		local removed: { Vector3 } = diff.removed[step.tier] or {}
		for _, pos in removed do
			if #from < MERGE_FROM_POSITIONS and not table.find(from, pos) then
				table.insert(from, pos)
			end
		end
	end
	effect(session, "Merge", {
		fromTier = low,
		toTier = high,
		from = from,
		to = mergeTarget(diff, high),
		auto = true,
		count = total,
		summary = true,
		overflow = true,
	})
end

-- Unit cap ------------------------------------------------------------------------

-- Copies an Economy.addUnitsCapped result into the profile (in place: State shares the table).
local function applyCapped(session: Session, result: Economy.CapResult)
	local units = session.profile.units
	for tier = 1, Economy.MAX_TIER do
		units[tier] = result.units[tier]
	end
end

-- Discovery / rewards ------------------------------------------------------------

-- Marks every owned tier (plus `extra` tiers, e.g. ones a merge passed through)
-- as discovered and announces the newest one.
local function discoverAll(session: Session, extra: { number }?)
	local p = session.profile
	local newest = 0
	local found: { number } = {}
	local function mark(tier: number)
		if tier >= 1 and tier <= Economy.MAX_TIER and p.discovered[tier] == 0 then
			p.discovered[tier] = os.time()
			newest = math.max(newest, tier)
			table.insert(found, tier)
		end
	end
	for _, tier in extra or ({} :: { number }) do
		mark(tier)
	end
	for tier = 1, Economy.MAX_TIER do
		if (p.units[tier] or 0) > 0 then
			mark(tier)
		end
	end
	if newest > 0 then
		table.sort(found)
		notify(session, { kind = "Reward", tier = newest, tiers = found, new = true })
		emit(session, "Discover", { tier = newest })
		-- The free converter floor: a new best tier lifts the converter to cover one of its units.
		local floor = Economy.minProcessLevel(newest)
		if floor > p.processLevel then
			p.processLevel = floor
			local pad = session.plot.padByName.ProcUp1
			effect(session, "Upgrade", { pad = "ProcUp1", padPos = pad and pad.part.Position, level = floor, free = true })
			toast(session, string.format("Blender upgraded for free: Lv %d", floor), "good")
			markDirty(session)
		end
	end
end

local function stepTiers(steps: { Economy.MergeStep }, base: { number }?): { number }
	local tiers = table.clone(base or {})
	for _, step in steps do
		table.insert(tiers, step.tier)
		table.insert(tiers, step.tier + 1)
	end
	return tiers
end

local function autoMergeIfOn(session: Session): { Economy.MergeStep }
	if session.profile.autoMerge then
		local _, _, steps = Economy.mergeAll(session.profile.units)
		return steps
	end
	return {}
end

-- Gives one unit (crate rewards). At the unit cap the lowest pair merges first; the unit is
-- refused only when nothing at all can merge (see Economy.addUnitsCapped).
local function awardUnit(session: Session, tier: number, source: string)
	local p = session.profile
	local isNew = p.discovered[tier] == 0
	local fit = Economy.addUnitsCapped(p.units, tier, 1)
	if fit.accepted == 0 then
		toast(session, string.format("Your rack is full! (%d %s max)", Economy.UNIT_CAP, theme.Words.Units), "bad")
		return
	end
	applyCapped(session, fit)
	p.totalObtained += 1
	local steps = autoMergeIfOn(session)
	local diff = refreshDisplay(session)
	sendOverflowEffect(session, fit.steps, diff)
	sendMergeEffects(session, steps, true, diff)
	if not isNew then
		notify(session, { kind = "Reward", tier = tier, new = false, source = source })
	end
	discoverAll(session, stepTiers(steps, stepTiers(fit.steps, { tier })))
	markDirty(session)
end

-- Crates --------------------------------------------------------------------------

-- Defined with the state code below; crate prompts push state right away.
local flush: (session: Session) -> ()

local function rootPart(session: Session): BasePart?
	local character = session.player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Over the orb pen (walls included)? Pads never fire from there and orbs can
-- only be collected from there (crates land in the pen and are grabbed anywhere).
-- Returns (overPool, inPool) for a world position.
local function poolState(plot: Plot, pos: Vector3): (boolean, boolean)
	local localPos = plot.cframe:PointToObjectSpace(pos)
	local pool = plot.pool
	local overPool = localPos.X >= pool.minX and localPos.X <= pool.maxX and localPos.Z >= pool.minZ and localPos.Z <= pool.maxZ
	return overPool, overPool and localPos.Y < plot.orbFloorY + POOL_REACH_Y
end

local function buildChest(rarity: string): Model
	local c = theme.Colors
	local model = Instance.new("Model")
	model.Name = rarity .. "Crate"
	local rarityColor = c.Rarity[rarity]
	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = offset
		p.Color = color
		p.Material = material
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local wood = Color3.fromRGB(130, 85, 45):Lerp(rarityColor, if rarity == "Common" then 0 else 0.35)
	local body = piece("Body", Vector3.new(3.4, 2.2, 2.4), CFrame.new(0, 1.1, 0), wood, Enum.Material.WoodPlanks)
	-- The Blender crate (warm wood, gold lock on the -Z front) stands on the model origin; the
	-- invisible Body keeps the pivot, prompt and sparkles. Rarity-coloured straps cover its
	-- white corner bands, so every rarity reads at a glance (Fx.Crates adds a rarity chip
	-- client-side when the player comes close).
	local mesh = Props.mesh("Crate", CFrame.new(), 1, model)
	if mesh then
		body.Transparency = 1
		for _, x in { -1.36, 1.36 } do
			piece("Band", Vector3.new(0.46, 2.68, 2.78), CFrame.new(x, 1.46, 0.07), rarityColor, Enum.Material.SmoothPlastic)
		end
	else
		piece("Lid", Vector3.new(3.6, 0.6, 2.6), CFrame.new(0, 2.5, 0), wood:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.WoodPlanks)
		for _, x in { -1.45, 1.45 } do
			piece(
				"Band",
				Vector3.new(0.3, 2.9, 2.7),
				CFrame.new(x, 1.45, 0),
				rarityColor,
				if rarity == "Common" then Enum.Material.Metal else Enum.Material.SmoothPlastic
			)
		end
		piece("Lock", Vector3.new(0.6, 0.7, 0.25), CFrame.new(0, 2, -1.3), Color3.fromRGB(255, 205, 60), Enum.Material.Metal)
	end
	model.PrimaryPart = body

	if rarity ~= "Common" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = rarityColor
		sparkles.Parent = body
	end
	return model
end

local function removeHeldModel(session: Session)
	if session.heldModel then
		session.heldModel:Destroy()
		session.heldModel = nil
	end
end

local function attachHeldModel(session: Session)
	removeHeldModel(session)
	local rarity = session.profile.heldChest
	if rarity == "" then
		return
	end
	local character = session.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not root then
		return
	end
	local model = buildChest(rarity)
	model:PivotTo(root.CFrame * CFrame.new(0, 0.6, -2.4))
	local primary = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
			if d ~= primary then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = primary
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = primary
	weld.Parent = primary
	model.Parent = character
	session.heldModel = model
end

-- Releasing the held crate re-arms the automatic pickup: nothing for CratePickup.REARM
-- seconds, and crates in range right now wait until the player has left their range.
local function clearHeld(session: Session)
	session.profile.heldChest = ""
	removeHeldModel(session)
	session.crateRearmUntil = os.clock() + CratePickup.REARM
	local root = rootPart(session)
	for _, chest in session.floorChests do
		local offset = if root then chest.position - root.Position else nil
		chest.blocked = offset ~= nil and CratePickup.inRange(offset.X, offset.Y, offset.Z)
	end
	markDirty(session)
end

local function pickUpChest(session: Session, chest: FloorChest)
	local index = table.find(session.floorChests, chest)
	if not index or not session.alive then
		return
	end
	if session.profile.heldChest ~= "" then
		toast(session, "You're already carrying a " .. theme.Words.Chest .. "!", "info")
		return
	end
	if not rootPart(session) then
		return
	end
	chest.model:Destroy()
	table.remove(session.floorChests, index)
	session.profile.heldChest = chest.rarity
	attachHeldModel(session)
	effect(session, "ChestPickup", { rarity = chest.rarity })
	markDirty(session)
	flush(session)
end

-- The displayed unit that drops the next crate: the higher tier of two random picks, so
-- better units drop crates a little more often. Returns its pivot (feet) or nil.
local function crateSource(session: Session): Vector3?
	local shown: { DisplaySlot } = {}
	for slotIndex = 1, Economy.DISPLAY_SLOTS do
		local slot = session.display[slotIndex]
		if slot and slot.model.Parent then
			table.insert(shown, slot)
		end
	end
	if #shown == 0 then
		return nil
	end
	local a = shown[rng:NextInteger(1, #shown)]
	local b = shown[rng:NextInteger(1, #shown)]
	local pick = if b.tier > a.tier then b else a
	return pick.model:GetPivot().Position
end

-- What each waypoint of a Layout.orbPath / Layout.cratePath route is (clients read it as
-- <prefix>Kinds; Fx.Orbs.readRoute infers the roles when it is missing or does not match).
local ROUTE_KINDS = "feet,drop,gutter,chuteTop,chuteBottom,land"
local ROUTE_KIND_COUNT = #string.split(ROUTE_KINDS, ",")

-- A unit on the ledge drops a crate: it slides down the gutter and chute like an orb and
-- lands in the front half of the pen. The server places it anchored on its landing spot
-- with `Origin` (the dropping unit's feet) and the route Path1..PathN + PathCount + PathKinds
-- (world-space crate-pivot waypoints, see Layout.cratePath); Fx.Crates animates the trip.
-- It can be picked up (by walking to it, see crateTick) once CratePickup.landTime has passed.
local function spawnFloorChest(session: Session)
	if #session.floorChests >= Economy.MAX_FLOOR_CHESTS then
		return
	end
	local plot = session.plot
	-- A landing spot in the pen's crate zone, clear of the other crates.
	local localPos: Vector3? = nil
	for _ = 1, CHEST_SPOT_TRIES do
		local area = plot.chestAreas[rng:NextInteger(1, #plot.chestAreas)]
		local candidate = Vector3.new(rng:NextNumber(area.minX, area.maxX), 0, rng:NextNumber(area.minZ, area.maxZ))
		local clear = true
		for _, other in session.floorChests do
			local offset = plot.cframe:PointToObjectSpace(other.position) - candidate
			if Vector2.new(offset.X, offset.Z).Magnitude < CHEST_SPACING then
				clear = false
				break
			end
		end
		if clear then
			localPos = candidate
			break
		end
	end
	if not localPos then
		return
	end
	local rarity = Economy.rollChestRarity(random)
	local landY = Layout.PEN.floorY + Layout.CRATE_LIFT
	local world0 = plot.cframe * CFrame.new(localPos.X, landY, localPos.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)

	-- The route from the dropping unit (or the middle of the ledge when none is shown).
	local origin = crateSource(session)
	local from = if origin then plot.cframe:PointToObjectSpace(origin) else Vector3.new(0, 0, Layout.SHELF.firstZ)
	local route = Layout.cratePath(from.X, from.Z, localPos.X, localPos.Z, landY)
	if not origin then
		local p = route[1]
		origin = plot.cframe:PointToWorldSpace(Vector3.new(p.x, p.y - Layout.CRATE_LIFT, p.z))
	end

	local model = buildChest(rarity)
	model:PivotTo(world0)
	model:SetAttribute("Rarity", rarity)
	model:SetAttribute("Origin", origin)
	for i, p in route do
		model:SetAttribute("Path" .. i, plot.cframe:PointToWorldSpace(Vector3.new(p.x, p.y, p.z)))
	end
	model:SetAttribute("PathCount", #route)
	model:SetAttribute("PathKinds", if #route == ROUTE_KIND_COUNT then ROUTE_KINDS else nil)
	local length = 0
	for i = 2, #route do
		local p, q = route[i - 1], route[i]
		length += Vector3.new(q.x - p.x, q.y - p.y, q.z - p.z).Magnitude
	end
	local chest: FloorChest = {
		model = model,
		rarity = rarity,
		position = world0.Position,
		landsAt = os.clock() + CratePickup.landTime(length),
		blocked = false,
	}
	model.Parent = plot.chestFolder
	table.insert(session.floorChests, chest)
	if rarity ~= "Common" then
		-- "An Uncommon Crate", "An Epic Crate", "A Rare Crate".
		local article = if string.find(rarity, "^[AEIOU]") then "An" else "A"
		toast(session, string.format("%s %s %s is on its way!", article, rarity, theme.Words.Chest), "good")
	end
end

local function openChest(session: Session, rarity: string, source: string)
	local tier = Economy.rollChest(rarity, highestTier(session), random)
	-- The profile's first crate has opened: later ones take their full Smasher time.
	session.profile.firstCrateDone = true
	awardUnit(session, tier, source)
	effect(session, "ChestOpen", { rarity = rarity, tier = tier })
end

-- Orbs ------------------------------------------------------------------------------

-- Units on the display ledge drop orbs that roll down the gutter and chute into
-- the pen in front of them. The server only places the orb at its landing spot;
-- clients animate the trip (`Origin` and the waypoint attributes), the bob, feed
-- pulses and the pickup magnet.
-- Returns (origin above the unit, the unit's feet, its tier) for a random displayed unit.
local function orbSource(session: Session): (Vector3?, Vector3?, number?)
	local count = 0
	for slotIndex = 1, Economy.DISPLAY_SLOTS do
		if session.display[slotIndex] then
			count = slotIndex
		end
	end
	if count == 0 then
		return nil, nil, nil
	end
	local slot = session.display[rng:NextInteger(1, count)]
	if not slot then
		return nil, nil, nil
	end
	local pivot = slot.model:GetPivot()
	return (pivot * CFrame.new(0, 4, 0)).Position, pivot.Position, slot.tier
end

-- World-space orb-centre waypoints from a unit's feet to `landing` (see Layout.orbPath).
local function orbRoute(session: Session, feet: Vector3?, landing: Vector3): { Vector3 }?
	if not feet then
		return nil
	end
	local cf = session.plot.cframe
	local from = cf:PointToObjectSpace(feet)
	local to = cf:PointToObjectSpace(landing)
	local out: { Vector3 } = {}
	for _, p in Layout.orbPath(from.X, from.Z, to.X, to.Z, to.Y) do
		table.insert(out, cf:PointToWorldSpace(Vector3.new(p.x, p.y, p.z)))
	end
	return out
end

-- Stores a route as Vector3 attributes <prefix>1..<prefix>N, <prefix>Count and <prefix>Kinds.
local function setRoute(inst: Instance, prefix: string, route: { Vector3 }?)
	if not route then
		return
	end
	for i, point in route do
		inst:SetAttribute(prefix .. i, point)
	end
	inst:SetAttribute(prefix .. "Count", #route)
	inst:SetAttribute(prefix .. "Kinds", if #route == ROUTE_KIND_COUNT then ROUTE_KINDS else nil)
end

-- Paint colour of an orb produced by a unit of `tier` (Theme.OrbColors, cycled by tier).
local function orbTint(tier: number?): Color3
	local palette = theme.OrbColors
	if palette and #palette > 0 then
		return OrbLook.tierColor(tier, palette)
	end
	return theme.Colors.Orb
end

-- Pile grid (plot-local): floor slot centres on a PILE_SPACING grid centred in the orb area.
type PileGrid = { cols: number, rows: number, x0: number, z0: number, focusX: number, focusZ: number }

local function pileGrid(area: { minX: number, maxX: number, minZ: number, maxZ: number }): PileGrid
	local cols = math.floor((area.maxX - area.minX) / PILE_SPACING) + 1
	local rows = math.floor((area.maxZ - area.minZ) / PILE_SPACING) + 1
	local cx, cz = (area.minX + area.maxX) / 2, (area.minZ + area.maxZ) / 2
	return {
		cols = cols,
		rows = rows,
		x0 = cx - (cols - 1) * PILE_SPACING / 2,
		z0 = cz - (rows - 1) * PILE_SPACING / 2,
		-- The heap gathers a little toward the chute mouth (the pen's back, +Z).
		focusX = cx,
		focusZ = cz + 1.5,
	}
end

local function floorCell(g: PileGrid, col: number, row: number): number
	return (row - 1) * g.cols + col
end

-- The four floor cells a top-layer cell rests on.
local function topSupports(g: PileGrid, cell: number): (number, number, number, number)
	local k = cell - PILE_TOP - 1
	local col, row = k % (g.cols - 1) + 1, k // (g.cols - 1) + 1
	return floorCell(g, col, row), floorCell(g, col + 1, row), floorCell(g, col, row + 1), floorCell(g, col + 1, row + 1)
end

-- The floor cells around a floor cell (up to 8; fewer at the grid's edge).
local function floorNeighbours(g: PileGrid, cell: number): { number }
	local col, row = (cell - 1) % g.cols + 1, (cell - 1) // g.cols + 1
	local out = {}
	for dr = -1, 1 do
		for dc = -1, 1 do
			local c, r = col + dc, row + dr
			if (dc ~= 0 or dr ~= 0) and c >= 1 and c <= g.cols and r >= 1 and r <= g.rows then
				table.insert(out, floorCell(g, c, r))
			end
		end
	end
	return out
end

-- Plot-local centres of the occupied pile cells, how many orbs sit on the floor, and the empty
-- floor cells a dumbbell covers (its 8 neighbours: it is twice an orb's size). Nothing lands
-- on those, so no top-layer slot can ever rest on a dumbbell either.
local function pileTaken(session: Session): ({ [number]: Vector3 }, number, { [number]: boolean })
	local cf = session.plot.cframe
	local taken: { [number]: Vector3 } = {}
	local blocked: { [number]: boolean } = {}
	local floorCount = 0
	local g: PileGrid? = nil
	for _, orb in session.orbs do
		taken[orb.cell] = cf:PointToObjectSpace(orb.part.CFrame.Position)
		if orb.cell < PILE_TOP then
			floorCount += 1
		end
		if orb.dumbbell then
			g = g or pileGrid(session.plot.orbArea)
			for _, cell in floorNeighbours(g :: PileGrid, orb.cell) do
				blocked[cell] = true
			end
		end
	end
	return taken, floorCount, blocked
end

-- Picks a free pile cell: floor cells near the focus first (with random scatter so the heap
-- looks natural), and once the floor is crowded sometimes a hollow on top of four floor orbs.
-- A `dumbbell` only takes an inner floor cell whose 8 neighbours are empty too.
-- Returns (cell, world landing CFrame of an orb resting there), or nil when the pile has no room.
local function orbLanding(session: Session, dumbbell: boolean?): (number?, CFrame?)
	local plot = session.plot
	local g = pileGrid(plot.orbArea)
	local r = ORB_SIZE / 2
	local restY = plot.orbFloorY + r
	local taken, floorCount, blocked = pileTaken(session)

	if not dumbbell and floorCount >= PILE_TOP_FROM and rng:NextNumber() < PILE_TOP_CHANCE then
		local best: number?, bestScore, bestPos = nil, math.huge, Vector3.zero
		for k = 1, (g.cols - 1) * (g.rows - 1) do
			local cell = PILE_TOP + k
			if taken[cell] then
				continue
			end
			local a, b, c, d = topSupports(g, cell)
			local pa, pb, pc, pd = taken[a], taken[b], taken[c], taken[d]
			if not (pa and pb and pc and pd) then
				continue
			end
			local x, z = (pa.X + pb.X + pc.X + pd.X) / 4, (pa.Z + pb.Z + pc.Z + pd.Z) / 4
			local score = math.sqrt((x - g.focusX) ^ 2 + (z - g.focusZ) ^ 2) + rng:NextNumber(0, PILE_SCATTER)
			if score < bestScore then
				-- Rest in the hollow: high enough to clear every support.
				local lift = 0
				for _, sp in { pa, pb, pc, pd } do
					local h2 = (sp.X - x) ^ 2 + (sp.Z - z) ^ 2
					lift = math.max(lift, math.sqrt(math.max(0, ORB_SIZE * ORB_SIZE - h2)))
				end
				best, bestScore, bestPos = cell, score, Vector3.new(x, restY + lift, z)
			end
		end
		if best then
			return best, plot.cframe * CFrame.new(bestPos)
		end
	end

	local best: number?, bestScore, bestPos = nil, math.huge, Vector3.zero
	for row = 1, g.rows do
		for col = 1, g.cols do
			local cell = floorCell(g, col, row)
			if taken[cell] or blocked[cell] then
				continue
			end
			if dumbbell then
				if col == 1 or col == g.cols or row == 1 or row == g.rows then
					continue
				end
				local clear = true
				for _, n in floorNeighbours(g, cell) do
					if taken[n] then
						clear = false
						break
					end
				end
				if not clear then
					continue
				end
			end
			local x, z = g.x0 + (col - 1) * PILE_SPACING, g.z0 + (row - 1) * PILE_SPACING
			local score = math.sqrt((x - g.focusX) ^ 2 + (z - g.focusZ) ^ 2) + rng:NextNumber(0, PILE_SCATTER)
			if score < bestScore then
				local jx, jz = rng:NextNumber(-PILE_JITTER, PILE_JITTER), rng:NextNumber(-PILE_JITTER, PILE_JITTER)
				best, bestScore, bestPos = cell, score, Vector3.new(x + jx, restY, z + jz)
			end
		end
	end
	if best then
		return best, plot.cframe * CFrame.new(bestPos)
	end
	return nil, nil
end

-- True while every floor orb under a top-layer cell is still there.
local function orbSupported(session: Session, cell: number, taken: { [number]: Vector3 }): boolean
	if cell < PILE_TOP then
		return true
	end
	local a, b, c, d = topSupports(pileGrid(session.plot.orbArea), cell)
	return taken[a] ~= nil and taken[b] ~= nil and taken[c] ~= nil and taken[d] ~= nil
end

-- Auto Aura: the orb is collected once its roll-in (an upper bound of the client's timing for
-- this route, including the chute queue) has landed and rested OrbLook.SETTLE seconds.
local function scheduleAuto(session: Session, orb: Orb, origin: Vector3?, route: { Vector3 }?)
	if not session.passes.AutoLoot then
		return
	end
	local length = 0
	local last = origin
	local points: { Vector3 } = route or {}
	for _, point in points do
		if last then
			length += (point - last).Magnitude
		end
		last = point
	end
	orb.due = math.max(orb.due or 0, os.clock() + OrbLook.autoCollectDelay(length, 2.5))
end

-- `dumbbell`: the piece lands as a dumbbell (Kind = "Dumbbell"): a cylinder along X,
-- OrbLook.DUMBBELL_SCALE orbs long and as thick as its plates, resting on them. Its route still
-- ends at the orb resting point `target` (clients lift the dumbbell onto its plates).
local function spawnOrb(
	session: Session,
	value: number,
	cell: number,
	target: CFrame,
	origin: Vector3?,
	route: { Vector3 }?,
	tier: number?,
	dumbbell: boolean?
)
	local plot = session.plot
	local tint = orbTint(tier)
	local part = Instance.new("Part")
	part.Name = "Orb"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(ORB_SIZE, ORB_SIZE, ORB_SIZE)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = tint
	part.CastShadow = false
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CFrame = target
	if dumbbell then
		local length = ORB_SIZE * OrbLook.DUMBBELL_SCALE
		local plate = length * OrbLook.DUMBBELL_PLATE
		part.Name = "Dumbbell"
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(length, plate * 2, plate * 2)
		part.CFrame = target + Vector3.new(0, plate - ORB_SIZE / 2, 0)
		part:SetAttribute("Kind", "Dumbbell")
	end
	if origin then
		part:SetAttribute("Origin", origin)
	end
	setRoute(part, "Path", route)
	part:SetAttribute("Value", value)
	part:SetAttribute("Count", 1)
	part:SetAttribute("Tier", tier or 1)
	part:SetAttribute("Tint", tint)
	-- Centre height of an orb resting on the pen floor (clients roll orbs along it).
	part:SetAttribute("RestY", (plot.cframe * CFrame.new(0, plot.orbFloorY + ORB_SIZE / 2, 0)).Position.Y)
	part:SetAttribute("Spawned", serverNow())
	part.Parent = plot.orbFolder
	local orb: Orb = { part = part, value = value, count = 1, cell = cell, tier = tier or 1, dumbbell = dumbbell }
	scheduleAuto(session, orb, origin, route)
	table.insert(session.orbs, orb)
end

-- Adds a produced orb to an existing ball (the pen is full): its value joins the ball, Count
-- goes up by one and Feed/FeedFrom/FeedPath/FeedTint tell clients to roll the orb in from the
-- unit and let it vanish into the ball. The ball keeps its own colour.
local function feedOrb(session: Session, orb: Orb, value: number, origin: Vector3?, route: { Vector3 }?, tier: number?)
	orb.value += value
	orb.count += 1
	local part = orb.part
	part:SetAttribute("Value", orb.value)
	part:SetAttribute("Count", orb.count)
	if origin then
		part:SetAttribute("FeedFrom", origin)
	end
	setRoute(part, "FeedPath", route)
	part:SetAttribute("FeedTint", orbTint(tier))
	scheduleAuto(session, orb, origin, route)
	part:SetAttribute("Feed", ((part:GetAttribute("Feed") :: number?) or 0) + 1)
end

-- The ball a produced orb joins once the pen is full. Dumbbells never take feed orbs.
local function feedTargetOrb(session: Session, tier: number?): Orb?
	local candidates: { Orb } = {}
	local balls: { OrbLook.Ball } = {}
	for _, orb in session.orbs do
		if not orb.dumbbell then
			table.insert(candidates, orb)
			table.insert(balls, { tier = orb.tier, count = orb.count })
		end
	end
	local index = OrbLook.feedTarget(balls, tier, #balls, rng:NextNumber())
	return if index then candidates[index] else nil
end

local function produceOrbs(session: Session, amount: number)
	if amount <= 0 then
		return
	end
	local pieces = if amount >= 4 then 2 else 1
	for _ = 1, pieces do
		local value = amount / pieces
		local origin, feet, tier = orbSource(session)
		local cell, target = nil, nil
		local dumbbell = false
		if #session.orbs < OrbLook.CAP then
			-- Now and then the piece lands as a dumbbell worth DUMBBELL_VALUE times as much
			-- (only where it has room; otherwise it stays a plain orb).
			if rng:NextNumber() < OrbLook.DUMBBELL_CHANCE then
				cell, target = orbLanding(session, true)
				dumbbell = cell ~= nil
			end
			if not cell then
				cell, target = orbLanding(session)
			end
		end
		if cell and target then
			spawnOrb(
				session,
				if dumbbell then value * OrbLook.DUMBBELL_VALUE else value,
				cell,
				target,
				origin,
				orbRoute(session, feet, target.Position),
				tier,
				dumbbell
			)
		else
			-- Pen full (or no free slot): the orb joins an existing ball and its Count goes up.
			local orb = feedTargetOrb(session, tier)
			if orb then
				feedOrb(session, orb, value, origin, orbRoute(session, feet, orb.part.CFrame.Position), tier)
			end
		end
	end
end

local function clearOrbs(session: Session)
	for _, orb in session.orbs do
		orb.part:Destroy()
	end
	table.clear(session.orbs)
end

-- Pads ---------------------------------------------------------------------------------

local padHandlers: { [string]: (Session) -> () } = {}

local function padPos(session: Session, name: string): Vector3?
	local pad = session.plot.padByName[name]
	return pad and pad.part.Position
end

-- Where deposited orbs enter the converter (falls back to the deposit pad).
local function converterPos(session: Session): Vector3
	if session.converterPos then
		return session.converterPos
	end
	local part = session.plot.folder:FindFirstChild("ConverterIntake", true) or session.plot.folder:FindFirstChild("ConverterCore", true)
	local pos = if part and part:IsA("BasePart") then part.Position else padPos(session, "Deposit") or session.plot.cframe.Position
	session.converterPos = pos
	return pos
end

-- Buys up to `amount` units of the first tier. Past the unit cap the lowest pairs
-- merge to make room (Economy.addUnitsCapped); units that still do not fit are not bought
-- and not charged.
local function buy(session: Session, amount: number)
	local p = session.profile
	local padName = "Buy" .. amount
	local tier = 1
	local fit = Economy.addUnitsCapped(p.units, tier, amount)
	local bought = fit.accepted
	if bought == 0 then
		toast(session, string.format("Your rack is full! (%d %s max)", Economy.UNIT_CAP, theme.Words.Units), "bad")
		refusePad(session, padName, "locked")
		return
	end
	local cost = Economy.bulkPrice(p.bought, bought)
	if not spend(session, cost, padName) then
		return
	end
	applyCapped(session, fit)
	p.bought += bought
	p.totalObtained += bought
	local steps = autoMergeIfOn(session)
	local diff = refreshDisplay(session)
	effect(session, "Buy", { amount = bought, tier = tier, cost = cost, padPos = padPos(session, padName) })
	sendOverflowEffect(session, fit.steps, diff)
	sendMergeEffects(session, steps, true, diff)
	discoverAll(session, stepTiers(steps, stepTiers(fit.steps, { tier })))
	if bought < amount then
		toast(session, string.format("Rack full: bought %d of %d", bought, amount), "info")
	end
	emit(session, "Buy", { amount = bought })
	markDirty(session)
end

for _, amount in Economy.BUY_AMOUNTS do
	padHandlers["Buy" .. amount] = function(session)
		buy(session, amount)
	end
end

-- A per-second amount for toasts and pad titles: "1.20K", "37", and one decimal under 10
-- ("0.5") so a small gain never reads as zero.
local function perSecond(amount: number): string
	return if amount < 10 then string.format("%.1f", amount) else Format.short(amount)
end

local function doMerge(session: Session, verbose: boolean, auto: boolean)
	local p = session.profile
	local before = Economy.productionPerSecond(p.units)
	local bestBefore = highestTier(session)
	local merges, top, steps = Economy.mergeAll(p.units)
	if merges > 0 then
		local after = Economy.productionPerSecond(p.units)
		local diff = refreshDisplay(session)
		sendMergeEffects(session, steps, auto, diff)
		discoverAll(session, stepTiers(steps))
		emit(session, "Merge", { merges = merges, top = top, before = before, after = after })
		if verbose then
			local times = if merges == 1 then "once" else Format.short(merges) .. " times"
			local text = string.format("Merged %s! %s +%s/sec", times, theme.Words.Orb, perSecond(after - before))
			-- Named only when this merge made a tier the player never had.
			if top > bestBefore then
				text ..= string.format(" New best: %s!", tierName(top))
			end
			toast(session, text, "good")
		end
		markDirty(session)
	elseif verbose then
		-- First run: a new player spawns facing this pad and walks onto it before the
		-- tutorial has asked for a merge, so the toast waits for that step.
		if TutorialSteps.mergeToast(p.tutorialStep, p.tutorialDone) then
			toast(session, "Nothing to merge yet. You need 2 of the same tier.", "info")
		end
		refusePad(session, "Merge", "locked")
	end
end

padHandlers.Merge = function(session)
	doMerge(session, true, false)
end

-- Auto Merge is a game pass (Theme.Monetization.Passes.AutoMerge). Profiles that unlocked it
-- with cash before it became a pass keep it (autoMergeOwned).
local function ownsAutoMerge(session: Session): boolean
	return session.passes.AutoMerge == true or session.profile.autoMergeOwned == true
end

-- A pad that needs a game pass the player does not own: it never opens a purchase prompt
-- (players cross these pads on foot all the time); it shakes and, at most once per
-- PASS_HINT_INTERVAL, says where the pass is sold.
local function passPadHint(session: Session, padName: string, text: string)
	refusePad(session, padName, "locked")
	local now = os.clock()
	local last = session.lastPassHint[padName]
	if last and now - last < PASS_HINT_INTERVAL then
		return
	end
	session.lastPassHint[padName] = now
	toast(session, text, "info")
end

padHandlers.AutoMerge = function(session)
	local p = session.profile
	if not ownsAutoMerge(session) then
		passPadHint(session, "AutoMerge", "Auto Merge is a game pass. Find it in the Shop or Settings.")
		return
	end
	p.autoMerge = not p.autoMerge
	if p.autoMerge then
		doMerge(session, false, true)
	end
	toast(session, "Auto Merge " .. (if p.autoMerge then "ON" else "OFF"), "info")
	markDirty(session)
end

padHandlers.Deposit = function(session)
	local p = session.profile
	if p.carried <= 0 then
		toast(session, "Your tank is empty! Walk over " .. theme.Words.Orb .. " orbs first.", "info")
		refusePad(session, "Deposit", "locked")
		return
	end
	local mult = ReplicatedStorage:GetAttribute("DepositMult") or 1
	-- All the aura goes into the converter; the multiplier's bonus part is cash in the vault
	-- at once (Economy.depositSplit).
	local amount, bonus = Economy.depositSplit(p.carried, mult)
	local cashPerOrb = Economy.CASH_PER_POINT * Tycoon.moneyMultiplier(session)
	local bonusCash = bonus * cashPerOrb
	p.pending += bonusCash
	-- First run: the deposit that completes the tutorial's step becomes cash at once, so
	-- its Collect step never waits for the converter.
	if TutorialSteps.instantDeposit(p.tutorialStep, p.tutorialDone) then
		p.pending += amount * cashPerOrb
	else
		p.queue += amount
	end
	p.carried = 0
	local root = rootPart(session)
	local to = converterPos(session)
	-- `amount` = aura queued, `bonus` = cash the multiplier paid on top.
	effect(session, "Deposit", { amount = amount, mult = mult, bonus = bonusCash, from = if root then root.Position else to, to = to })
	emit(session, "Deposit", { amount = amount })
	markDirty(session)
end

padHandlers.Collect = function(session)
	local p = session.profile
	if p.pending < 1 then
		toast(session, "No cash ready yet. Deposit " .. theme.Words.Orb .. " first!", "info")
		refusePad(session, "Collect", "locked")
		return
	end
	local amount = p.pending
	addMoney(session, amount)
	p.pending = 0
	effect(session, "Cash", { amount = amount, source = "Collect", padPos = padPos(session, "Collect") })
	emit(session, "Cash", { amount = amount })
	markDirty(session)
end

-- "+25%" for one converter level, "+9.3x" for a bulk step.
local function upgradeSpeed(amount: number): string
	local growth = Economy.PROCESS_GROWTH ^ amount
	return if amount == 1 then string.format("%d%%", math.floor((growth - 1) * 100 + 0.5)) else string.format("%.1fx", growth)
end

-- Cash per second `amount` more converter levels would add right now (0 while the converter
-- already keeps up with the units). Sized without the Aura Surge so pad titles hold still.
local function upgradeGain(session: Session, amount: number): number
	local production = steadyProduction(session)
	local rate = processRate(session, false)
	local faster = rate * Economy.PROCESS_GROWTH ^ amount
	return (math.min(production, faster) - math.min(production, rate)) * Economy.CASH_PER_POINT * Tycoon.moneyMultiplier(session)
end

-- The converter is so far ahead of the units that more speed would buy nothing: the upgrade
-- pads refuse instead of charging.
local function upgradeNotNeeded(session: Session): boolean
	local p = session.profile
	return Economy.processRate(p.processLevel) >= Economy.CONVERTER_HEADROOM * Economy.productionPerSecond(p.units)
end

local function procUpgrade(session: Session, amount: number, padName: string)
	local p = session.profile
	if upgradeNotNeeded(session) then
		toast(
			session,
			string.format("Your blender is already faster than your %s. Buy or merge %s first!", theme.Words.Units, theme.Words.Units),
			"info"
		)
		refusePad(session, padName, "locked")
		return
	end
	local gain = upgradeGain(session, amount)
	if spend(session, Economy.processBulkCost(p.processLevel, amount), padName) then
		p.processLevel += amount
		effect(session, "Upgrade", { pad = padName, padPos = padPos(session, padName), level = p.processLevel })
		local what = if gain > 0 then "+$" .. perSecond(gain) .. "/sec" else string.format("+%s speed", upgradeSpeed(amount))
		toast(session, string.format("Blender Lv %d: %s", p.processLevel, what), "good")
		markDirty(session)
	end
end
padHandlers.ProcUp1 = function(session)
	procUpgrade(session, 1, "ProcUp1")
end
padHandlers.ProcUp10 = function(session)
	procUpgrade(session, Economy.PROCESS_BULK, "ProcUp10")
end

-- Puts the held crate in a Smasher slot and returns the seconds it will take. A profile's
-- first crate opens after Economy.FIRST_CRATE_SECONDS.
local function loadUnlocker(session: Session, slotIndex: number): number
	local p = session.profile
	local slot = p.unlockers[slotIndex]
	local seconds = Economy.unlockSeconds(p.heldChest, slotIndex == 2)
	if not p.firstCrateDone then
		seconds = math.min(seconds, Economy.FIRST_CRATE_SECONDS)
	end
	slot.rarity = p.heldChest
	slot.endsAt = os.time() + seconds
	clearHeld(session)
	return seconds
end

local function useUnlocker(session: Session, slotIndex: number)
	local p = session.profile
	local padName = "Unlock" .. slotIndex
	if slotIndex == 2 and not session.passes.PremiumUnlocker then
		passPadHint(session, padName, "VIP Crate Smasher is a game pass. Find it in the Shop.")
		return
	end
	local slot = p.unlockers[slotIndex]
	if slot.rarity ~= "" then
		local left = slot.endsAt - os.time()
		if left <= 0 or session.passes.CrateKey then
			-- Crate Master owners smash it right away for free.
			local rarity = slot.rarity
			slot.rarity = ""
			slot.endsAt = 0
			openChest(session, rarity, "unlocker")
			-- A crate in hand goes into the freed slot in the same visit.
			if p.heldChest ~= "" then
				toast(session, "Opened! Next crate is in: " .. Format.time(loadUnlocker(session, slotIndex)), "good")
			end
		elseif p.heldChest ~= "" then
			toast(session, string.format("Smasher busy: ready in %s. Keep your crate, it goes in next.", Format.time(left)), "info")
			refusePad(session, padName, "locked")
		else
			toast(session, "Ready in " .. Format.time(left) .. ". Come back when the timer ends!", "info")
			-- The Robux smash is offered only to a player who stays on the pad (offerSmash).
			local visit = session.inside[padName]
			if visit then
				visit.linger = true
			end
		end
		markDirty(session)
		return
	end
	if p.heldChest == "" then
		toast(session, "Bring a " .. theme.Words.Chest .. " here to open it for free over time.", "info")
		refusePad(session, padName, "locked")
		return
	end
	loadUnlocker(session, slotIndex)
	toast(session, "Unlocking... come back when the timer ends!", "good")
	markDirty(session)
end

-- Still on a busy Smasher pad after SMASH_OFFER_DWELL with empty hands: offer to smash the
-- crate now for Robux. Walking across the pad never asks.
local function offerSmash(session: Session, slotIndex: number)
	local p = session.profile
	local slot = p.unlockers[slotIndex]
	if slotIndex == 2 and not session.passes.PremiumUnlocker then
		return
	end
	if slot.rarity == "" or p.heldChest ~= "" or session.passes.CrateKey or slot.endsAt - os.time() <= 0 then
		return
	end
	if not Tycoon.hooks.crateRobuxAllowed(session.player) then
		return
	end
	notify(session, {
		kind = "Confirm",
		text = string.format("Smash it now for %s%d?", ROBUX, theme.Monetization.CrateOpen.Price),
		action = { action = "FinishUnlocker", slot = slotIndex },
	})
end

-- Run once when the player has stood on the pad for SMASH_OFFER_DWELL, if the pad's handler
-- asked for it (PadVisit.linger).
local padLingerHandlers: { [string]: (Session) -> () } = {
	Unlock1 = function(session)
		offerSmash(session, 1)
	end,
	Unlock2 = function(session)
		offerSmash(session, 2)
	end,
}

padHandlers.Unlock1 = function(session)
	useUnlocker(session, 1)
end
padHandlers.Unlock2 = function(session)
	useUnlocker(session, 2)
end

padHandlers.Free = function(session)
	local p = session.profile
	local left = p.lastFreeReward + Economy.FREE_REWARD_COOLDOWN - os.time()
	if left > 0 then
		toast(session, "Next free reward in " .. Format.time(left), "info")
		refusePad(session, "Free", "locked")
		return
	end
	local cash = math.max(Economy.FREE_REWARD_MIN, Tycoon.income(session) * Economy.FREE_REWARD_SECONDS)
	addMoney(session, cash)
	p.lastFreeReward = os.time()
	toast(session, "Free reward: +" .. Format.money(cash), "good")
	effect(session, "Cash", { amount = cash, source = "Free", padPos = padPos(session, "Free") })
	markDirty(session)
end

-- Boards ------------------------------------------------------------------------------

local function setPad(session: Session, name: string, title: string?, sub: string, affordable: boolean?)
	local pad = session.plot.padByName[name]
	if not pad then
		return
	end
	if title then
		pad.title.Text = title
	end
	pad.sub.Text = sub
	if affordable ~= nil then
		pad.sub.TextColor3 = if affordable then theme.Colors.Good else theme.Colors.Bad
	end
end

local function updateBoards(session: Session)
	local p = session.profile
	local labels = session.plot.labels
	local now = os.time()

	for _, amount in Economy.BUY_AMOUNTS do
		local cost = Economy.bulkPrice(p.bought, amount)
		setPad(session, "Buy" .. amount, "Buy " .. amount .. " " .. tierName(1), Format.money(cost), canAfford(session, cost))
	end

	if ownsAutoMerge(session) then
		setPad(session, "AutoMerge", "Auto Merge", if p.autoMerge then "ON" else "OFF", p.autoMerge)
	else
		setPad(session, "AutoMerge", "Auto Merge", Format.robux(theme.Monetization.Passes.AutoMerge.Price), true)
	end

	-- Upgrade pads: the cash an upgrade adds while the units out-produce the converter,
	-- else the speed step; no price once the pads refuse (upgradeNotNeeded).
	local rateNow = processRate(session, true)
	local notNeeded = upgradeNotNeeded(session)
	for padName, amount in { ProcUp1 = 1, ProcUp10 = Economy.PROCESS_BULK } do
		local cost = Economy.processBulkCost(p.processLevel, amount)
		local gain = upgradeGain(session, amount)
		local title = if gain > 0 then "+$" .. perSecond(gain) .. "/sec" else string.format("+%s speed", upgradeSpeed(amount))
		if notNeeded then
			setPad(session, padName, title, "Not needed yet", false)
		else
			setPad(session, padName, title, Format.money(cost), canAfford(session, cost))
		end
	end

	local moneyMult = Tycoon.moneyMultiplier(session)
	labels.ProcessQueue.Text = theme.Icons.Orb .. " " .. Format.short(p.queue)
	local cashRate = Format.money(math.min(p.queue, rateNow) * moneyMult) .. " per second"
	labels.ProcessRate.Text = if p.queue > 0 then cashRate .. "  |  Done in " .. Format.time(math.ceil(p.queue / rateNow)) else cashRate
	labels.ProcessSpeed.Text = string.format("Speed: %s %s/sec  (Lv %d)", Format.short(rateNow), theme.Words.Orb, p.processLevel)

	setPad(session, "Collect", nil, Format.money(p.pending), p.pending >= 1)

	local mult = ReplicatedStorage:GetAttribute("DepositMult") or 1
	local nextAt = ReplicatedStorage:GetAttribute("DepositNextAt") or 0
	labels.DepositMult.Text = "x" .. string.format("%.1f", mult)
	labels.DepositMult.TextColor3 = if mult >= 1.2 then theme.Colors.Good else theme.Colors.Primary
	labels.DepositNext.Text = "next change in " .. math.max(0, math.ceil(nextAt - serverNow())) .. "s"
	setPad(session, "Deposit", nil, theme.Icons.Orb .. Format.short(p.carried) .. "  x" .. string.format("%.1f", mult), p.carried > 0)

	local freeLeft = p.lastFreeReward + Economy.FREE_REWARD_COOLDOWN - now
	labels.FreeStatus.Text = if freeLeft <= 0 then "READY!" else Format.time(freeLeft)
	labels.FreeStatus.TextColor3 = if freeLeft <= 0 then theme.Colors.Good else theme.Colors.Text
	setPad(session, "Free", nil, if freeLeft <= 0 then "Claim!" else Format.time(freeLeft), freeLeft <= 0)

	for i, screen in session.plot.unlockerScreens do
		local slot = p.unlockers[i]
		local locked = i == 2 and not session.passes.PremiumUnlocker
		if locked then
			screen.status.Text = "🔒 3x faster"
			screen.timer.Text = "UNLOCK"
			setPad(session, "Unlock" .. i, nil, "🔒 Game Pass", false)
		elseif slot.rarity == "" then
			screen.status.Text = "EMPTY"
			screen.timer.Text = "--:--:--"
			setPad(session, "Unlock" .. i, nil, if p.heldChest ~= "" then "Drop crate here" else "Empty", p.heldChest ~= "")
		else
			local left = slot.endsAt - now
			screen.status.Text = slot.rarity .. " " .. theme.Words.Chest
			screen.status.TextColor3 = theme.Colors.Rarity[slot.rarity]
			if left <= 0 then
				screen.timer.Text = "READY!"
				setPad(session, "Unlock" .. i, nil, "Open!", true)
			else
				screen.timer.Text = Format.clock(left)
				setPad(session, "Unlock" .. i, nil, Format.clock(left), false)
			end
		end
	end
end

-- State ------------------------------------------------------------------------------

local function snapshot(session: Session): { [string]: any }
	local p = session.profile
	local now = os.time()
	local unlockers = {}
	for i, slot in p.unlockers do
		unlockers[i] = {
			rarity = slot.rarity,
			secondsLeft = if slot.rarity ~= "" then math.max(0, slot.endsAt - now) else 0,
		}
	end
	local production = Tycoon.production(session)
	local rate = processRate(session, true)
	local moneyMult = Tycoon.moneyMultiplier(session)
	return {
		now = now,
		money = p.money,
		carried = p.carried,
		queue = p.queue,
		pending = p.pending,
		units = p.units,
		discovered = p.discovered,
		totalObtained = p.totalObtained,
		-- Units owned right now (all shown on the rack) and the most a player can hold.
		unitTotal = Economy.totalUnits(p.units),
		unitCap = Economy.UNIT_CAP,
		bought = p.bought,
		processLevel = p.processLevel,
		heldChest = p.heldChest,
		crateRobux = Tycoon.hooks.crateRobuxAllowed(session.player),
		highestTier = highestTier(session),
		unlockers = unlockers,
		autoMergeOwned = ownsAutoMerge(session),
		autoMerge = p.autoMerge,
		settings = p.settings,
		passes = session.passes,
		premium = session.premium,
		friendBonus = session.friendBonus,
		moneyMult = moneyMult,
		orbMult = Tycoon.orbMultiplier(session),
		production = production,
		processRate = rate,
		income = Tycoon.incomeNow(session),
		-- What rewards and packs are sized with (no Aura Surge): the shop, Starter Pack and Daily
		-- cards show the amounts the server grants, in and out of a surge.
		rewardIncome = Tycoon.income(session),
		rewardProduction = steadyProduction(session),
		freeIn = math.max(0, p.lastFreeReward + Economy.FREE_REWARD_COOLDOWN - now),
		plotIndex = session.plot.index,
		tutorialStep = p.tutorialStep,
		tutorialDone = p.tutorialDone,
		cosmetics = Tycoon.hooks.cosmetics(session),
		modes = Tycoon.hooks.modes(session),
		daily = Tycoon.hooks.daily(session),
	}
end

local function updateLeaderstats(session: Session)
	local stats = session.player:FindFirstChild("leaderstats")
	if not stats then
		return
	end
	local units = stats:FindFirstChild(theme.Words.Units) :: StringValue?
	local cash = stats:FindFirstChild("Cash") :: StringValue?
	if units then
		units.Value = Format.short(session.profile.totalObtained)
	end
	if cash then
		cash.Value = Format.short(session.profile.money)
	end
end

function flush(session: Session)
	if not session.dirty or not session.alive then
		return
	end
	session.dirty = false
	updateBoards(session)
	updateLeaderstats(session)
	StateRemote:FireClient(session.player, snapshot(session))
end

-- Ticks --------------------------------------------------------------------------------

-- Credits picked-up orbs to the tank: the same path for walking over them and for Auto Aura.
-- Auto Aura is silent: no "OrbsPicked" magnet and no "Collect" cue, the carried number on the
-- dumbbell simply rolls up.
local function creditPicked(session: Session, collected: number, positions: { Vector3 }, counts: { number }, now: number, auto: boolean)
	if collected <= 0 then
		return
	end
	session.profile.carried += collected
	if not auto then
		session.collectBuffer += collected
		effect(session, "OrbsPicked", { amount = collected, positions = positions, counts = counts })
	end
	emit(session, "Pickup", { amount = collected })
	markDirty(session)
	if now - session.lastPickupFlush >= PICKUP_FLUSH_INTERVAL then
		session.lastPickupFlush = now
		flush(session)
	end
end

-- Auto Aura: orbs past their `due` time are collected wherever the player is. They simply
-- vanish from the pen: no wind-up, flight, sparkle or sound.
local function autoCollect(session: Session, now: number)
	if not session.passes.AutoLoot or #session.orbs == 0 then
		return
	end
	local values: { number } = {}
	for i = #session.orbs, 1, -1 do
		local orb = session.orbs[i]
		if orb.due == nil then
			orb.due = now + 0.3 + 0.15 * i -- pass bought with orbs already in the pen
		elseif now >= orb.due then
			table.insert(values, orb.value)
			orb.part:Destroy()
			table.remove(session.orbs, i)
		end
	end
	creditPicked(session, OrbLook.credit(values), {}, {}, now, true)
end

-- Automatic crate pickup: the plot owner walks to a landed crate in their pen and picks up
-- the nearest one in range (CratePickup.mayPick: not holding one, re-armed after a release).
local function crateTick(session: Session, pos: Vector3, now: number)
	local holding = session.profile.heldChest ~= ""
	local best: FloorChest? = nil
	local bestDist = math.huge
	for _, chest in session.floorChests do
		local offset = chest.position - pos
		local inRange = CratePickup.inRange(offset.X, offset.Y, offset.Z)
		chest.blocked = CratePickup.stillBlocked(chest.blocked, inRange)
		local may = CratePickup.mayPick({
			now = now,
			landsAt = chest.landsAt,
			inRange = inRange,
			holding = holding,
			rearmUntil = session.crateRearmUntil,
			blocked = chest.blocked,
		})
		local dist = Vector2.new(offset.X, offset.Z).Magnitude
		if may and dist < bestDist then
			best, bestDist = chest, dist
		end
	end
	if best then
		pickUpChest(session, best)
	end
end

local function fastTick(session: Session)
	autoCollect(session, os.clock())
	local root = rootPart(session)
	if not root then
		-- Respawning: forget pad visits so a fresh character starts clean.
		table.clear(session.inside)
		return
	end
	local plot = session.plot
	local pos = root.Position
	local localPos = plot.cframe:PointToObjectSpace(pos)
	local overPool, inPool = poolState(plot, pos)

	local now = os.clock()

	-- Pads fire once per visit, the moment the player steps on them (PAD_DWELL pads: once
	-- the player has stood on them that long); stepping off and on again fires them again.
	for _, pad in plot.pads do
		local name = pad.name
		local inside = not overPool
			and math.abs(localPos.X - pad.center.X) <= pad.half.X
			and math.abs(localPos.Z - pad.center.Z) <= pad.half.Y
			and localPos.Y > PAD_MIN_Y
			and localPos.Y < PAD_MAX_Y
		if inside then
			local visit = session.inside[name]
			if not visit then
				visit = { since = now, fired = false, linger = false }
				session.inside[name] = visit
			end
			local stood = now - visit.since
			if not visit.fired and stood >= (PAD_DWELL[name] or 0) then
				visit.fired = true
				local handler = padHandlers[name]
				if handler then
					handler(session)
					flush(session)
				end
			end
			if visit.linger and stood >= SMASH_OFFER_DWELL then
				visit.linger = false
				local linger = padLingerHandlers[name]
				if linger then
					linger(session)
				end
			end
		else
			session.inside[name] = nil
		end
	end

	-- Orb pickup: only from inside the pen (so standing beside it doesn't
	-- vacuum it), by horizontal distance so jumping still collects.
	local collected = 0
	local positions: { Vector3 } = {}
	local counts: { number } = {}
	local function collect(i: number)
		local orb = session.orbs[i]
		collected += OrbLook.credit({ orb.value })
		if #positions < ORB_PICKED_POSITIONS then
			table.insert(positions, orb.part.CFrame.Position)
			table.insert(counts, orb.count)
		end
		orb.part:Destroy()
		table.remove(session.orbs, i)
	end
	for i = if inPool then #session.orbs else 0, 1, -1 do
		local offset = session.orbs[i].part.CFrame.Position - pos
		if Vector2.new(offset.X, offset.Z).Magnitude <= ORB_PICKUP_RADIUS and math.abs(offset.Y) < 8 then
			collect(i)
		end
	end
	-- Top-layer orbs that lost a floor orb under them tumble into the pickup too.
	if collected > 0 then
		local taken = pileTaken(session)
		for i = #session.orbs, 1, -1 do
			if not orbSupported(session, session.orbs[i].cell, taken) then
				collect(i)
			end
		end
	end
	creditPicked(session, collected, positions, counts, now, false)
	crateTick(session, pos, now)
end

local function slowTick(session: Session)
	local p = session.profile
	local production = Tycoon.production(session)

	produceOrbs(session, production)

	local rate = processRate(session, true)
	local processed = math.min(p.queue, rate)
	if processed > 0 then
		p.queue -= processed
		p.pending += processed * Economy.CASH_PER_POINT * Tycoon.moneyMultiplier(session)
	end
	if session.passes.AutoCash and p.pending > 0 then
		emit(session, "Cash", { amount = p.pending })
		effect(session, "Cash", { amount = p.pending, source = "Auto" })
		addMoney(session, p.pending)
		p.pending = 0
	end

	-- No crates during the tutorial; the first one drops for sure about 20 s after it ends.
	if not p.tutorialDone then
		session.inTutorial = true
		session.chestTimer = 0
	else
		if session.inTutorial then
			session.inTutorial = false
			session.chestTimer = Economy.CHEST_SPAWN_INTERVAL - 20
			session.chestCertain = true
		end
		session.chestTimer += 1
		if session.chestTimer >= Economy.CHEST_SPAWN_INTERVAL then
			session.chestTimer = 0
			if session.chestCertain or rng:NextNumber() < Economy.CHEST_SPAWN_CHANCE then
				session.chestCertain = false
				spawnFloorChest(session)
			end
		end
	end

	if session.collectBuffer > 0 then
		effect(session, "Collect", { amount = session.collectBuffer })
		session.collectBuffer = 0
	end

	-- Re-attach a held crate after respawning.
	if p.heldChest ~= "" and (not session.heldModel or not session.heldModel.Parent) then
		attachHeldModel(session)
	end

	markDirty(session)
	flush(session)
end

local function rerollDeposit()
	ReplicatedStorage:SetAttribute("DepositMult", Economy.rollDepositMultiplier(random))
	ReplicatedStorage:SetAttribute("DepositNextAt", serverNow() + Economy.DEPOSIT_REROLL_SECONDS)
end

-- Actions from the client ---------------------------------------------------------------

local actionHandlers: { [string]: (Session, { [string]: any }) -> () } = {}

-- Opens a held crate of `rarity` right now (Crate Master owners, crate receipts).
local function openCrateNow(session: Session, rarity: string)
	if session.profile.heldChest == rarity then
		clearHeld(session)
	else
		toast(session, string.format("Your %s %s is opening!", rarity, theme.Words.Chest), "good")
	end
	openChest(session, rarity, "unlock")
	markDirty(session)
	flush(session)
end

-- Instant opening of the held crate. Crate Master (pass CrateKey) owners open it
-- free. Everyone else is prompted the single "Open Crate" developer product, which
-- Monetization refuses where paid random items are restricted; that crate is opened
-- only when the receipt arrives (Tycoon.openCrateProduct).
actionHandlers.OpenCrateNow = function(session)
	local rarity = session.profile.heldChest
	if rarity == "" or not Economy.isRarity(rarity) then
		return
	end
	if session.passes.CrateKey then
		openCrateNow(session, rarity)
		return
	end
	Tycoon.hooks.promptCrate(session.player, rarity)
end

actionHandlers.DiscardChest = function(session)
	if session.profile.heldChest ~= "" then
		clearHeld(session)
		toast(session, theme.Words.Chest .. " discarded.", "info")
	end
end

-- Smashes the crate in an unlocker slot early. Crate Master owners (and finished timers)
-- open it free; everyone else is prompted the same "Open Crate" product as a held crate,
-- and the slot is emptied only when the receipt arrives (Tycoon.openCrateProduct).
actionHandlers.FinishUnlocker = function(session, data)
	local slotIndex = data.slot
	if slotIndex ~= 1 and slotIndex ~= 2 then
		return
	end
	local slot = session.profile.unlockers[slotIndex]
	if slot.rarity == "" or not Economy.isRarity(slot.rarity) then
		return
	end
	if slot.endsAt - os.time() > 0 and not session.passes.CrateKey then
		Tycoon.hooks.promptCrate(session.player, slot.rarity, slotIndex)
		return
	end
	local rarity = slot.rarity
	slot.rarity = ""
	slot.endsAt = 0
	openChest(session, rarity, "unlocker")
	markDirty(session)
end

actionHandlers.PromptPass = function(session, data)
	if type(data.name) == "string" and theme.Monetization.Passes[data.name] then
		Tycoon.hooks.promptPass(session.player, data.name)
	end
end

actionHandlers.PromptProduct = function(session, data)
	if (data.kind == "Money" or data.kind == "Aura") and type(data.index) == "number" then
		Tycoon.hooks.promptProduct(session.player, data.kind, data.index)
	end
end

actionHandlers.SetSetting = function(session, data)
	local p = session.profile
	if data.key == "autoMerge" then
		if not ownsAutoMerge(session) then
			Tycoon.hooks.promptPass(session.player, "AutoMerge")
		elseif type(data.value) == "boolean" then
			p.autoMerge = data.value
			if p.autoMerge then
				doMerge(session, false, true)
			end
		end
	elseif type(data.key) == "string" and type(p.settings[data.key]) == "boolean" and type(data.value) == "boolean" then
		p.settings[data.key] = data.value
	end
	markDirty(session)
end

actionHandlers.Home = function(session)
	Tycoon.hooks.leavingForHome(session)
	local character = session.player.Character
	if character then
		-- A lifter on the bench press is welded to its seat (World.Decor): let go first.
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		local weld = seat and seat:FindFirstChild("SeatWeld")
		if humanoid and weld then
			weld:Destroy()
			humanoid.Sit = false
		end
		character:PivotTo(session.plot.spawn)
	end
end

-- Sent by the client once its UI is ready; the caller flushes fresh state.
actionHandlers.Sync = function(_session) end

actionHandlers.Merge = function(session)
	doMerge(session, true, false)
end

-- Same as standing on the Free pad (cooldown checked there; the action budget
-- rate-limits the remote).
actionHandlers.ClaimFree = function(session)
	padHandlers.Free(session)
end

-- Lets other server modules (e.g. Tutorial) accept their own client actions.
function Tycoon.addAction(name: string, handler: (Session, { [string]: any }) -> ())
	actionHandlers[name] = handler
end

-- Players ---------------------------------------------------------------------------------

local function freePlot(): number?
	for index = 1, #world.plots do
		if not plotOwners[index] then
			return index
		end
	end
	return nil
end

local function setOwnerSign(plot: Plot, player: Player?)
	if player then
		plot.labels.Owner.Text = player.DisplayName .. "'s " .. (if theme.Id == "chad" then "Gym" else "Factory")
		plot.ownerImage.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", player.UserId)
	else
		plot.labels.Owner.Text = "FREE PLOT"
		plot.ownerImage.Image = ""
		-- Back to the pads Server.WorldBuilder built: names only, no prices, no "+N% speed"
		-- titles, and "Game pass" on Auto Merge (nothing of the last owner stays).
		for _, pad in plot.pads do
			pad.title.Text = pad.defaultTitle
			pad.sub.TextColor3 = pad.defaultTint
			pad.sub.Text = pad.defaultSub
		end
		for _, screen in plot.unlockerScreens do
			screen.status.Text = ""
			screen.timer.Text = ""
		end
		-- Clear the previous owner's numbers from the dynamic boards.
		for _, key in
			{
				"ProcessQueue",
				"ProcessRate",
				"ProcessSpeed",
				"FreeStatus",
				"DepositNext",
			}
		do
			local boardLabel = plot.labels[key]
			if boardLabel then
				boardLabel.Text = ""
			end
		end
	end
end

local function refreshFriendBonuses()
	local list = Players:GetPlayers()
	for _, player in list do
		local session = sessions[player]
		if session then
			task.spawn(function()
				local friends = 0
				for _, other in list do
					if other ~= player and other.Parent then
						local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
						if ok and isFriend then
							friends += 1
						end
					end
				end
				session.friendBonus = math.min(friends * Economy.FRIEND_BONUS, Economy.MAX_FRIEND_BONUS)
				markDirty(session)
			end)
		end
	end
end

local function applyOffline(session: Session)
	local p = session.profile
	if p.lastOnline <= 0 then
		return
	end
	local elapsed = math.min(os.time() - p.lastOnline, Economy.OFFLINE_CAP_SECONDS)
	if elapsed < Economy.OFFLINE_MIN_SECONDS then
		return
	end
	local produced = Economy.productionPerSecond(p.units)
		* (if session.passes.DoubleAura then 2 else 1)
		* elapsed
		* Economy.OFFLINE_EFFICIENCY
	p.queue += produced
	local processed = math.min(p.queue, processRate(session, false) * elapsed)
	p.queue -= processed
	local cash = processed * Economy.CASH_PER_POINT * (if session.passes.DoubleMoney then 2 else 1)
	p.pending += cash
	notify(session, { kind = "Offline", seconds = elapsed, orbs = produced, cash = cash })
end

function Tycoon.addPlayer(player: Player, profile: Profile, canSave: boolean, passes: { [string]: boolean }): Session?
	local index = freePlot()
	if not index then
		player:Kick("This server is full. Please join another server!")
		return nil
	end
	plotOwners[index] = player
	local plot = world.plots[index]

	local session: Session = {
		player = player,
		profile = profile,
		canSave = canSave,
		plot = plot,
		passes = passes,
		premium = player.MembershipType == Enum.MembershipType.Premium,
		friendBonus = 0,
		inside = {},
		converterPos = nil,
		orbs = {},
		floorChests = {},
		heldModel = nil,
		display = {},
		displayCounts = "",
		dirty = true,
		chestTimer = 0,
		inTutorial = not profile.tutorialDone,
		chestCertain = false,
		collectBuffer = 0,
		actionBudget = ACTIONS_PER_SECOND,
		lastPickupFlush = 0,
		crateRearmUntil = 0,
		lastToast = {},
		lastPassHint = {},
		alive = true,
	}
	sessions[player] = session

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local unitsStat = Instance.new("StringValue")
	unitsStat.Name = theme.Words.Units
	unitsStat.Parent = leaderstats
	local cashStat = Instance.new("StringValue")
	cashStat.Name = "Cash"
	cashStat.Parent = leaderstats
	leaderstats.Parent = player

	setOwnerSign(plot, player)
	-- Saves from before the unit cap: merge the lowest pairs until they fit.
	local fit = Economy.addUnitsCapped(profile.units, 1, 0)
	if #fit.steps > 0 then
		applyCapped(session, fit)
		discoverAll(session, stepTiers(fit.steps))
	end
	refreshDisplay(session)
	applyOffline(session)

	local function onCharacter(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if not root or not session.alive then
			return
		end
		task.wait(0.1)
		character:PivotTo(plot.spawn)
		-- Tells the loading screen (ReplicatedFirst) the character is on its plot.
		character:SetAttribute("OnPlot", true)
		session.heldModel = nil
		attachHeldModel(session)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	-- Studio-only test hook: a Server script sets the player attribute "DebugGrant" to
	-- "cash,<n>", "units,<total>" (Tier 1..5 spread), "pass,<Name>", "crate" or "pickup".
	if RunService:IsStudio() then
		player:GetAttributeChangedSignal("DebugGrant"):Connect(function()
			local kind, arg = string.match(tostring(player:GetAttribute("DebugGrant")), "^(%a+),?(.*)$")
			local n = tonumber(arg) or 0
			if kind == "cash" then
				Tycoon.grantMoney(session, n)
			elseif kind == "units" then
				local units = table.create(Economy.MAX_TIER, 0)
				for i = 0, n - 1 do
					units[i % 5 + 1] += 1
				end
				session.profile.units = units
				discoverAll(session)
				refreshDisplay(session)
			elseif kind == "pass" then
				Tycoon.setPass(player, arg)
			elseif kind == "crate" then
				spawnFloorChest(session)
			elseif kind == "pickup" and session.floorChests[1] then
				pickUpChest(session, session.floorChests[1])
			end
			markDirty(session)
			flush(session)
		end)
	end

	refreshFriendBonuses()
	markDirty(session)
	flush(session)
	return session
end

function Tycoon.removePlayer(player: Player): Session?
	local session = sessions[player]
	if not session then
		return nil
	end
	session.alive = false
	sessions[player] = nil
	plotOwners[session.plot.index] = nil

	clearOrbs(session)
	for _, chest in session.floorChests do
		chest.model:Destroy()
	end
	for _, slot in session.display do
		slot.model:Destroy()
	end
	Shelves.setRows(session.plot.folder, 1)
	removeHeldModel(session)
	setOwnerSign(session.plot, nil)
	refreshFriendBonuses()
	return session
end

function Tycoon.setPass(player: Player, name: string)
	local session = sessions[player]
	if session then
		session.passes[name] = true
		if name == "AutoMerge" then
			-- Starts ON the moment it is bought.
			session.profile.autoMerge = true
			effect(session, "Upgrade", { pad = "AutoMerge", padPos = padPos(session, "AutoMerge") })
			doMerge(session, false, true)
		end
		Tycoon.hooks.passGranted(session, name)
		markDirty(session)
		flush(session)
	end
end

-- A paid instant crate open (the single "Open Crate" developer product, any rarity).
-- Prompted for a smasher slot (profile.pendingUnlocker), it smashes the crate still in
-- that slot. Otherwise it opens the held crate if there is one; failing both (dropped,
-- discarded, timer ran out, rejoined) the player still gets a crate of the rarity
-- recorded when the prompt was issued (profile.pendingCrate), or a Common one, so a
-- purchase always pays out.
function Tycoon.openCrateProduct(session: Session)
	local p = session.profile
	local slotIndex = p.pendingUnlocker
	local slot = p.unlockers[slotIndex]
	p.pendingUnlocker = 0
	if slot then
		-- A smasher prompt never spends the held crate: the slot's crate, else the prompted rarity.
		local rarity = if Economy.isRarity(slot.rarity) then slot.rarity else p.pendingCrate
		slot.rarity = ""
		slot.endsAt = 0
		p.pendingCrate = ""
		openChest(session, if Economy.isRarity(rarity) then rarity else "Common", "unlocker")
		markDirty(session)
		flush(session)
		return
	end
	local rarity = p.heldChest
	if not Economy.isRarity(rarity) then
		rarity = if Economy.isRarity(p.pendingCrate) then p.pendingCrate else "Common"
	end
	p.pendingCrate = ""
	openCrateNow(session, rarity)
end

-- Pushes a fresh State snapshot (e.g. after a purchase policy lookup finishes).
function Tycoon.refresh(player: Player)
	local session = sessions[player]
	if session then
		markDirty(session)
		flush(session)
	end
end

-- `source` names the "Cash" effect for the client ("Purchase" = a cash pack's celebration,
-- "Daily" = the daily reward).
function Tycoon.grantMoney(session: Session, amount: number, source: string?)
	addMoney(session, amount)
	local root = rootPart(session)
	effect(session, "Cash", { amount = amount, source = source or "Purchase", padPos = root and root.Position })
	markDirty(session)
	flush(session)
end

-- A free crate of `rarity` opened on the spot (daily reward), in two steps so the caller
-- can pay something else when it does not fit: rollCrate returns the tier of its unit, or
-- nil when the rack has no room for that unit (full, and nothing can merge)...
function Tycoon.rollCrate(session: Session, rarity: string): number?
	local tier = Economy.rollChest(rarity, highestTier(session), random)
	return if Economy.addUnitsCapped(session.profile.units, tier, 1).accepted > 0 then tier else nil
end

-- ...and grantCrate gives that unit with the crate reveal.
function Tycoon.grantCrate(session: Session, rarity: string, tier: number)
	awardUnit(session, tier, "unlock")
	effect(session, "ChestOpen", { rarity = rarity, tier = tier })
	markDirty(session)
	flush(session)
end

-- Aura pack: aura straight into the tank, ready for the converter. Not a pickup (no
-- "Pickup" event, so quests and the orb collect counter ignore it); flush refreshes the
-- Deposit pad label (updateBoards) and the HUD tank (State).
function Tycoon.grantAura(session: Session, amount: number)
	session.profile.carried += amount
	toast(session, "+" .. Format.short(amount) .. " " .. string.lower(theme.Words.Orb) .. " in your tank!", "good")
	effect(session, "AuraGrant", { amount = amount })
	markDirty(session)
	flush(session)
end

function Tycoon.init(builtWorld: WorldBuilder.World, themeModule: any)
	world = builtWorld
	theme = themeModule

	NotifyRemote = Net.event("Notify")
	EffectRemote = Net.event("Effect")
	StateRemote = Net.event("State")
	ActionRemote = Net.event("Action")

	rerollDeposit()

	ActionRemote.OnServerEvent:Connect(function(player, data)
		local session = sessions[player]
		if not session or type(data) ~= "table" or type(data.action) ~= "string" then
			return
		end
		if session.actionBudget <= 0 then
			return
		end
		session.actionBudget -= 1
		local handler = actionHandlers[data.action]
		if handler then
			handler(session, data)
			markDirty(session)
			flush(session)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			for _, session in sessions do
				local ok, err = pcall(fastTick, session)
				if not ok then
					warn("[Tycoon] fastTick:", err)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			if serverNow() >= (ReplicatedStorage:GetAttribute("DepositNextAt") or 0) then
				rerollDeposit()
			end
			for _, session in sessions do
				session.actionBudget = ACTIONS_PER_SECOND
				local ok, err = pcall(slowTick, session)
				if not ok then
					warn("[Tycoon] slowTick:", err)
				end
			end
		end
	end)
end

return Tycoon
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="197">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="198">
          <Properties>
            <string name="Name">CardioTrack</string>
            <string name="Source"><![CDATA[--[[
	CardioTrack: the CARDIO keyboard escape out at sea (teleport-only; Modes.Cardio runs it): a
	lobby, then ten THEMED bridge rooms (tall candy walls with orange neon X-truss frames, a
	themed hazard floor, a narrow key bridge, neon-edged key blocks, a doorway in each end
	wall) with a safe zone after each. Everything is placed from Modes.CardioLayout.LAYOUT
	(pure numbers) and Modes.CardioRules; this module only builds parts at their rest pose and
	never moves or toggles anything.

	Instance contract (all anchored, under Workspace.CardioTrack, a Folder):

	  Keys/Stage<n>/Key   one BasePart per LAYOUT.keys entry (decks and blocks included), n =
	                      0..10: the `props/Key_<letter>` MeshPart (`props/KeyBlank` when a
	                      letter mesh is missing), SmoothPlastic, Color = CardioLayout.tintOf(key)
	                      (the baked dark letter stays dark). Keys are visual only (CanCollide,
	                      CanQuery, CanTouch false): see Colliders. Without any key asset "Key"
	                      is a plain tinted Part. Size (cap, KEY.height, cap) scales the mesh; top = layout y.
	                      Tag "CardioKey"; attributes Letter (string), Stage (number), Index
	                      (number, position in LAYOUT.keys), Kind ("deck"|"key"|"blink"|
	                      "mover"|"block"), Group (platform id, 0 for decks and blocks).
	    blink keys        also tag "CardioBlinkKey" + BlinkOn, BlinkPeriod, BlinkPhase (seconds):
	                      Client.Fx.Cardio fades them in sync with their platform's slab.
	    mover keys        also tag "ModeMover" + Mover = "slide", MoveAxis = (0, 0, 1),
	                      MoveDistance = travel, MovePeriod = period, MovePhase (radians) =
	                      2 pi * phase / period: Client.Fx.Modes slides them (parkour contract).
	  Colliders/KeySlab   one invisible anchored slab per LAYOUT.platforms entry, zone deck and
	                      block (its rectangle), top = key tops - PRESS (CardioLayout.PRESS, the
	                      folder's PressDepth attribute: the depth Fx.Cardio sinks pressed keys;
	                      KeyPitch = KEY.size, its lookup grid cell). Blink platform slabs: tag "BlinkPad" + BlinkOn / BlinkPeriod / BlinkPhase;
	                      mover platform slabs: tag "ModeMover" + the keys' slide attributes.
	  Zone<n>             Model per safe zone (n = 0 lobby .. 10), attribute Stage:
	    Deck              the chocolate base slab under the zone's keys (LAYOUT.bases, group 0).
	    Treadmill         Models, tag "CardioTreadmill", attributes Zone (stage), Index (1..);
	                      holds the `props/CardioTreadmill` mesh (or a part-built fallback) and
	                      a flat "Belt" part on the belt rectangle whose LookVector is the
	                      runner's forward (+X) and whose Top face carries a Texture
	                      "BeltTexture" for the client to scroll (OffsetStudsV).
	    UpgradePad        (lobby) tag "CardioUpgradePad" with the "SPEED UP" UpgradeConsole.
	    WinPad            (zones 1..10) the gold WIN pad on LAYOUT zone.winPad, in the game's
	                      pad style (WinRim base, WinGlow Neon border, WinPost corner lights, a
	                      printed "WIN"): tag "CardioWinPad", attributes Stage and ZoneX0 /
	                      ZoneX1 / ZoneZ0 / ZoneZ1 (its safe zone's deck). Its BillboardGui
	                      "WinLabel" holds TextLabels "Title" ("WIN") and "Amount" (default
	                      "CASH OUT"): the client writes what the pad pays that player right
	                      now into Amount (UI.CardioHud). Stepping on it is the server's
	                      position check (Modes.Cardio, CardioLayout.onWinPad).
	    LobbyDecor        (lobby) orange Neon X trusses on its three walls and roof joists, the
	                      back-wall CARDIO title, candy clusters and warm lamps; decor only.
	  Room<n>             Model per bridge room (n = stage), attributes Stage, Theme:
	    Hazard            the hazard slab (top = room floorY over the room's inside), the
	                      theme's colour / material (liquids glossy), tag "CardioHazard",
	                      attributes Stage, Theme. Falling in is the server's killY check; the
	                      slab is solid. "HazardDecor" parts on it (candy tiles, flow streaks,
	                      wave crests, cloud puffs, neon grid, rainbow stripes) never collide.
	    Truss             orange Neon beams of the X frames (collinear beams merged; beams hidden
	                      behind wall props skipped), no collide.
	    Props             candy meshes (`props/Candy*`, vertex coloured, never tinted; a
	                      coloured ball when missing), decor only (fall through them).
	    Base / BlinkRail  chocolate slabs under the static platforms, Neon rails under blinking
	                      ones; Block<k> pillars (theme-tinted, down to the hazard) with Neon
	                      "BlockEdge" strips.
	  Walls               one part per LAYOUT.walls box in the room theme's wall colour, a
	                      dotted Texture on the faces you see, a Neon "WallTrim" on top.
	  Doors/Door<i>       Model per LAYOUT.doors entry (i = index), attributes Stage, Side, Timed:
	    DoorFrame         Neon theme-edge jambs + header through the wall.
	    DoorSlab          (timed doors only) the slab filling the doorway, tag "CardioDoor" and
	                      "BlinkPad" (BlinkPeriod = period, BlinkOn = period - open, BlinkPhase
	                      = (phase - open) mod period: solid exactly while the door is closed,
	                      CardioLayout.doorOpen), attributes DoorIndex, DoorOpen, DoorPeriod,
	                      DoorPhase, Stage.
	    CountdownSign     (timed doors) board above the doorway on its west face, tag
	                      "CardioDoorSign", attribute DoorIndex; its SurfaceGui holds a
	                      TextLabel "Countdown" (default "GO!") the client drives.
	  Signs               StageSign<n> through the west wall of bridge room n, above the
	                      doorway: "STAGE n" / name / "NEED x SPEED" on both faces; the lobby
	                      side of room 1 also carries the giant CARDIO title; FinishSign on the
	                      finish cap wall.
	  FinishPodium        Model on the stage-10 deck (LAYOUT.finish), behind its WIN pad.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Common = require(script.Parent.Common)
local AssetModels = require(ReplicatedStorage.Shared.AssetModels)
local Assets = require(ReplicatedStorage.Shared.Assets)
local Format = require(ReplicatedStorage.Shared.Format)
local Layout = require(script.Parent.Parent.Modes.CardioLayout)
local Rules = require(script.Parent.Parent.Modes.CardioRules)

local theme = Common.theme
local make = Common.make
local UPRIGHT = Common.UPRIGHT
local W = theme.World
local CYLINDER = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local NEON = Enum.Material.Neon

local CardioTrack = {}

export type Built = {
	folder: Folder,
	-- Key parts by LAYOUT.keys index.
	keys: { BasePart },
	-- Safe zone models and their deck base slabs by stage (0 = lobby).
	zones: { [number]: Model },
	decks: { [number]: BasePart },
	upgradePad: BasePart,
	-- WIN pads by safe zone stage (1..10).
	winPads: { [number]: BasePart },
	treadmills: { Model },
	-- Bridge room models and hazard slabs by stage; timed door slabs by LAYOUT.doors index.
	rooms: { [number]: Model },
	hazards: { [number]: BasePart },
	doors: { [number]: BasePart },
}

local LAYOUT = Layout.LAYOUT
local O = Layout.ORIGIN
local TOP = O.y
local KEY = Layout.KEY
-- Keys are visual only: each walkable surface has one invisible collision slab whose top is
-- PRESS below the key tops, and Fx.Cardio sinks the keys under feet by exactly PRESS (the
-- folder's PressDepth attribute), so feet rest on fully pressed keys and never bounce.
local PRESS = Layout.PRESS
local DW = Layout.DOOR_WALL
-- props/CardioTreadmill belt in mesh space (origin = base centre, runner faces -Z).
local BELT = { top = 1.4, chevronTop = 1.435, x0 = -2.15, x1 = 2.15, z0 = -3.236, z1 = 5.364 }
local BELT_W = BELT.x1 - BELT.x0
local BELT_L = BELT.z1 - BELT.z0
local BELT_CZ = (BELT.z0 + BELT.z1) / 2
local BELT_COLOUR = Color3.fromRGB(70, 72, 92)
local BELT_PRINT = Color3.fromRGB(34, 34, 48)
local CHOCOLATE_DARK = Color3.fromRGB(62, 34, 22)
-- PointLights stay under this many.
local MAX_LIGHTS = 38
local lightCount = 0

local function decor(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function add(parent: Instance, props: { [string]: any }): BasePart
	props.Parent = parent
	return make("Part", props)
end

local function glow(parent: Instance, props: { [string]: any }): BasePart
	props.Material = NEON
	props.CastShadow = false
	return decor(add(parent, props))
end

local function disc(parent: Instance, name: string, pos: Vector3, d: number, h: number, colour: Color3): BasePart
	return add(parent, {
		Name = name,
		Shape = CYLINDER,
		Size = Vector3.new(h, d, d),
		CFrame = CFrame.new(pos) * UPRIGHT,
		Color = colour,
	})
end

local function folderIn(parent: Instance, name: string, className: string?): Instance
	local f = Instance.new(className or "Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function c3(c: Layout.RGB): Color3
	return Color3.fromRGB(c.r, c.g, c.b)
end

local function themeOf(stage: number): Layout.Theme
	return Layout.themeOf(math.max(stage, 0))
end

-- Accent colour of a stage (its theme's neon edge).
local function stageColour(stage: number): Color3
	return c3(themeOf(stage).edge)
end

local function light(parent: BasePart, colour: Color3, range: number, brightness: number)
	if lightCount >= MAX_LIGHTS then
		return
	end
	lightCount += 1
	local l = Instance.new("PointLight")
	l.Color = colour
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
end

-- Park-Miller LCG for the decor scatter (deterministic per stage).
local function rng(seed: number): () -> number
	local state = (seed * 7919 + 17) % 2147483647
	return function()
		state = (state * 16807) % 2147483647
		return state / 2147483647
	end
end

-- Signs ----------------------------------------------------------------------------------

-- A SurfaceGui on `face` of p; labels go straight into it (no wrapper frames: instance budget).
local function surface(p: BasePart, face: Enum.NormalId, pixelsPerStud: number): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Parent = p
	return gui
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.TextScaled = true
	l.Font = theme.Fonts.Display
	l.TextColor3 = W.Ink
	l.Size = UDim2.fromScale(1, 1)
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

-- A bubbly outline on a label's glyphs.
local function outline(label: TextLabel, colour: Color3, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = colour
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = label
end

-- Keys -----------------------------------------------------------------------------------

local templates: { [string]: MeshPart | false } = {}

-- A fresh MeshPart of the model `key` (cached template), or nil when it is missing.
local function meshOf(key: string): MeshPart?
	local cached = templates[key]
	if cached == nil then
		cached = false
		local clone = AssetModels.clone(key)
		if clone then
			local found = if clone:IsA("MeshPart") then clone else clone:FindFirstChildWhichIsA("MeshPart", true)
			if found then
				local mesh = found :: MeshPart
				mesh.Parent = nil
				cached = mesh
			end
			if clone ~= found then
				clone:Destroy()
			end
		end
		templates[key] = cached
	end
	if cached then
		local m = (cached :: MeshPart):Clone()
		m.Anchored = true
		return m
	end
	return nil
end

local function keyMesh(letter: string): MeshPart?
	return meshOf("props/Key_" .. letter) or meshOf("props/KeyBlank")
end

local function setKeyAttributes(part: BasePart, key: Layout.Key, index: number)
	part.Name = "Key"
	part:AddTag("CardioKey")
	part:SetAttribute("Letter", key.letter)
	part:SetAttribute("Stage", key.stage)
	part:SetAttribute("Index", index)
	part:SetAttribute("Kind", key.kind)
	part:SetAttribute("Group", key.group)
	if key.kind == "blink" then
		part:SetAttribute("BlinkOn", key.blinkOn)
		part:SetAttribute("BlinkPeriod", key.blinkPeriod)
		part:SetAttribute("BlinkPhase", key.phase or 0)
		-- Not "BlinkPad": keys never collide (the platform's slab blinks); Fx.Cardio fades them.
		part:AddTag("CardioBlinkKey")
	elseif key.kind == "mover" then
		local period = key.period :: number
		part:SetAttribute("Mover", "slide")
		part:SetAttribute("MoveAxis", Vector3.new(0, 0, 1))
		part:SetAttribute("MoveDistance", key.travel)
		part:SetAttribute("MovePeriod", period)
		part:SetAttribute("MovePhase", 2 * math.pi * (key.phase or 0) / period)
		part:AddTag("ModeMover")
	end
end

local function buildKey(parent: Instance, key: Layout.Key, index: number): BasePart
	local gap = KEY.size - KEY.cap
	local size = Vector3.new(key.sx - gap, KEY.height, key.sz - gap)
	local cf = CFrame.new(key.x, key.y - KEY.height / 2, key.z)
	local tint = Layout.tintOf(key)
	local colour = Color3.fromRGB(tint.r, tint.g, tint.b)
	local mesh = keyMesh(key.letter)
	local root: BasePart
	if mesh then
		mesh.Size = size
		mesh.CFrame = cf
		mesh.Color = colour
		mesh.Material = Enum.Material.SmoothPlastic
		-- Visual only: the surface's collision slab (PRESS below the tops) carries feet.
		mesh.CanCollide = false
		mesh.CanQuery = false
		mesh.CanTouch = false
		mesh.CastShadow = true
		mesh.Parent = parent
		root = mesh
	else
		root = add(parent, { Size = size, CFrame = cf, Color = colour, CanCollide = false, CanQuery = false, CanTouch = false })
	end
	setKeyAttributes(root, key, index)
	return root
end

-- Hazard floors -------------------------------------------------------------------------

local RAINBOW = {
	Color3.fromRGB(255, 120, 130),
	Color3.fromRGB(255, 180, 100),
	Color3.fromRGB(255, 236, 120),
	Color3.fromRGB(140, 236, 140),
	Color3.fromRGB(120, 210, 255),
	Color3.fromRGB(150, 150, 255),
	Color3.fromRGB(220, 140, 255),
}

-- A flat decor plate lying on the hazard (top just above floorY).
local function plate(parent: Instance, x: number, z: number, sx: number, sz: number, y: number, props: { [string]: any }): BasePart
	props.Name = props.Name or "HazardDecor"
	props.Size = Vector3.new(sx, 0.4, sz)
	props.CFrame = CFrame.new(x, y - 0.1, z)
	props.CastShadow = false
	return decor(add(parent, props))
end

-- The hazard slab of a bridge room plus its theme's surface pattern.
local function hazard(model: Instance, room: Layout.Room): BasePart
	local look = themeOf(room.stage)
	local hz = look.hazard
	local ix0, ix1 = room.x0 + DW, room.x1 - DW
	local sx, sz = ix1 - ix0, room.z1 - room.z0
	local cx, cz = (ix0 + ix1) / 2, (room.z0 + room.z1) / 2
	local y = room.floorY
	local colour = c3(hz.color)
	local material = (Enum.Material :: any)[hz.material] or Enum.Material.SmoothPlastic
	local slabColour, slabMaterial = colour, material
	if hz.pattern == "grid" then
		slabColour, slabMaterial = Color3.fromRGB(92, 64, 190), Enum.Material.SmoothPlastic
	elseif hz.pattern == "stripes" then
		slabColour, slabMaterial = Color3.fromRGB(255, 248, 255), Enum.Material.SmoothPlastic
	end
	local bottom = Layout.WALL.bottom
	local slab = add(model, {
		Name = "Hazard",
		Size = Vector3.new(sx, y - bottom, sz),
		CFrame = CFrame.new(cx, (y + bottom) / 2, cz),
		Color = slabColour,
		Material = slabMaterial,
		-- Glossy candy: liquids shine, hard candy floors get a light sheen.
		Reflectance = if material == NEON then 0 elseif hz.liquid then 0.2 else 0.08,
		CastShadow = false,
		CanTouch = false,
	})
	slab:AddTag("CardioHazard")
	slab:SetAttribute("Stage", room.stage)
	slab:SetAttribute("Theme", room.theme)

	local rand = rng(room.stage)
	local pattern = hz.pattern
	if pattern == "tiles" then
		-- Glossy hard-candy tiles: a checker of a lighter second shade over the slab.
		local rows = 6
		local cell = sz / rows
		local cols = math.max(1, math.floor(sx / cell + 0.5))
		local cw = sx / cols
		local shade = colour:Lerp(if colour.B > 0.6 then Color3.fromRGB(190, 140, 255) else Color3.fromRGB(255, 214, 220), 0.5)
		for i = 0, cols - 1 do
			for j = 0, rows - 1 do
				if (i + j) % 2 == 0 then
					plate(model, ix0 + (i + 0.5) * cw, room.z0 + (j + 0.5) * cell, cw, cell, y, { Color = shade, Reflectance = 0.12 })
				end
			end
		end
	elseif pattern == "river" then
		-- Glossy flow streaks along the river: creamy swirls in two lighter shades.
		local cream = Color3.fromRGB(255, 236, 205)
		for i = 1, 14 do
			local len = sx * (0.18 + rand() * 0.3)
			plate(model, ix0 + len / 2 + rand() * (sx - len), room.z0 + 5 + rand() * (sz - 10), len, 1.4 + rand() * 2.4, y, {
				Color = colour:Lerp(cream, if i % 2 == 0 then 0.55 else 0.3),
				Material = if material == NEON then NEON else Enum.Material.SmoothPlastic,
				Reflectance = if material == NEON then 0 else 0.3,
				Transparency = 0.15,
			})
		end
	elseif pattern == "waves" then
		-- Pale wave crests across the room.
		local crest = colour:Lerp(Color3.new(1, 1, 1), 0.45)
		local count = math.floor(sx / 18)
		for i = 1, count do
			plate(model, ix0 + (i - 0.5) * sx / count, cz, 1.6, sz, y, {
				Color = crest,
				Material = material,
				Reflectance = 0.2,
				Transparency = 0.35,
			})
		end
	elseif pattern == "clouds" then
		-- Fluffy puffs half-sunk in the cotton candy.
		for _ = 1, 16 do
			local d = 10 + rand() * 10
			decor(add(model, {
				Name = "HazardDecor",
				Shape = BALL,
				Size = Vector3.new(d, d, d),
				CFrame = CFrame.new(ix0 + d / 2 + rand() * (sx - d), y - d * 0.36, room.z0 + d / 2 + rand() * (sz - d)),
				Color = colour:Lerp(if rand() < 0.5 then Color3.new(1, 1, 1) else Color3.fromRGB(200, 215, 255), 0.5),
				CastShadow = false,
			}))
		end
	elseif pattern == "grid" then
		-- A neon grid on a midnight floor.
		local step = 14
		for i = 1, math.floor(sx / step) do
			plate(model, ix0 + i * step, cz, 0.6, sz, y, { Color = colour, Material = NEON })
		end
		for j = 1, math.floor(sz / step) do
			plate(model, cx, room.z0 + j * step, sx, 0.6, y, { Color = colour, Material = NEON })
		end
	elseif pattern == "stripes" then
		-- Rainbow bands across the room with thin neon seams.
		local bands = 14
		local bw = sx / bands
		for i = 0, bands - 1 do
			plate(model, ix0 + (i + 0.5) * bw, cz, bw, sz, y, { Color = RAINBOW[i % #RAINBOW + 1], Reflectance = 0.1 })
			if i > 0 then
				plate(model, ix0 + i * bw, cz, 0.5, sz, y + 0.05, { Color = Color3.new(1, 1, 1), Material = NEON })
			end
		end
	end
	return slab
end

-- Walls ------------------------------------------------------------------------------------

local WALL_FACES: { [string]: { Enum.NormalId } } = {
	south = { Enum.NormalId.Back },
	north = { Enum.NormalId.Front },
	west = { Enum.NormalId.Right },
	east = { Enum.NormalId.Left },
}

-- One part per layout wall box: theme wall colour, a dotted candy texture on the faces you
-- see (both faces of the door walls), a Neon edge-colour trim along the top.
local function buildWalls(parent: Instance)
	local dots = Assets.image("vfx/SoftDot")
	for _, w in LAYOUT.walls do
		local look = themeOf(w.stage)
		local colour = c3(look.wall)
		local p = add(parent, {
			Name = "Wall",
			Size = Vector3.new(w.sx, w.sy, w.sz),
			CFrame = CFrame.new(w.x, w.y, w.z),
			Color = colour,
		})
		p:SetAttribute("Stage", w.stage)
		if w.part == "under" then
			continue
		end
		local faces = if w.part == "full" then WALL_FACES[w.side] else { Enum.NormalId.Left, Enum.NormalId.Right }
		if dots and faces then
			local bright = colour.R + colour.G + colour.B > 1.2
			for _, face in faces do
				local tex = Instance.new("Texture")
				tex.Name = "WallDots"
				tex.Face = face
				tex.Texture = dots
				tex.Color3 = if bright then colour:Lerp(c3(look.edge), 0.35) else colour:Lerp(Color3.new(1, 1, 1), 0.25)
				tex.StudsPerTileU = 7
				tex.StudsPerTileV = 7
				tex.Transparency = 0.25
				tex.Parent = p
			end
		end
		local top = w.y + w.sy / 2
		glow(parent, {
			Name = "WallTrim",
			Size = Vector3.new(w.sx + 0.2, 0.8, w.sz + 0.2),
			CFrame = CFrame.new(w.x, top + 0.4, w.z),
			Color = c3(look.edge),
		})
	end
end

-- Doors ------------------------------------------------------------------------------------

local FRAME = 1.2

-- A doorway: Neon jambs and header through the wall; timed doors also get the closing slab
-- (a BlinkPad solid exactly while the door is closed) and a countdown board above.
local function door(parent: Instance, d: Layout.Door, index: number): BasePart?
	local edge = stageColour(d.stage)
	local model = folderIn(parent, "Door" .. index, "Model")
	model:SetAttribute("Stage", d.stage)
	model:SetAttribute("Side", d.side)
	model:SetAttribute("Timed", d.timed)
	model:SetAttribute("DoorIndex", index)
	local depth = DW + 0.8
	for _, s in { -1, 1 } do
		glow(model, {
			Name = "DoorFrame",
			Size = Vector3.new(depth, d.height + FRAME, FRAME),
			CFrame = CFrame.new(d.x, d.y + (d.height + FRAME) / 2, d.z + s * (d.width + FRAME) / 2),
			Color = edge,
		})
	end
	glow(model, {
		Name = "DoorFrame",
		Size = Vector3.new(depth, FRAME, d.width + 2 * FRAME),
		CFrame = CFrame.new(d.x, d.y + d.height + FRAME / 2, d.z),
		Color = edge,
	})
	if not d.timed then
		return nil
	end
	local slab = add(model, {
		Name = "DoorSlab",
		Size = Vector3.new(0.8, d.height, d.width),
		CFrame = CFrame.new(d.x, d.y + d.height / 2, d.z),
		Color = edge:Lerp(W.White, 0.35),
		Transparency = 0.1,
		CanTouch = false,
		CastShadow = false,
	})
	local dots = Assets.image("vfx/SoftDot")
	if dots then
		for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
			local tex = Instance.new("Texture")
			tex.Face = face
			tex.Texture = dots
			tex.Color3 = edge
			tex.StudsPerTileU = KEY.size
			tex.StudsPerTileV = KEY.size
			tex.Parent = slab
		end
	end
	slab:AddTag("CardioDoor")
	slab:AddTag("BlinkPad")
	slab:SetAttribute("DoorIndex", index)
	slab:SetAttribute("Stage", d.stage)
	slab:SetAttribute("DoorOpen", d.open)
	slab:SetAttribute("DoorPeriod", d.period)
	slab:SetAttribute("DoorPhase", d.phase)
	-- Blink pads are solid while ((t + BlinkPhase) % BlinkPeriod) < BlinkOn; the door is
	-- closed while ((t + phase) % period) >= open.
	slab:SetAttribute("BlinkPeriod", d.period)
	slab:SetAttribute("BlinkOn", d.period - d.open)
	slab:SetAttribute("BlinkPhase", (d.phase - d.open) % d.period)

	-- Countdown board on the wall's west face, above the doorway: a big Ink board in a Neon
	-- frame with one huge, thick-outlined number the client writes.
	local w = math.max(d.width + 8, 22)
	local h = 11
	local x = d.x - DW / 2
	local y = d.y + d.height + FRAME + 1.5 + h / 2
	glow(model, {
		Name = "CountdownGlow",
		Size = Vector3.new(0.4, h + 1.6, w + 1.6),
		CFrame = CFrame.new(x - 0.2, y, d.z),
		Color = edge,
	})
	local board = decor(add(model, {
		Name = "CountdownSign",
		Size = Vector3.new(0.6, h, w),
		CFrame = CFrame.new(x - 0.3, y, d.z),
		Color = W.Ink,
	}))
	board:AddTag("CardioDoorSign")
	board:SetAttribute("DoorIndex", index)
	local label = text(surface(board, Enum.NormalId.Left, 20), {
		Name = "Countdown",
		Text = "GO!",
		TextColor3 = Color3.fromRGB(120, 255, 140),
		Size = UDim2.fromScale(0.94, 0.9),
		Position = UDim2.fromScale(0.03, 0.05),
	})
	outline(label, Color3.new(0, 0, 0), 10)
	light(board, edge, 20, 1.2)
	return slab
end

-- Trusses ------------------------------------------------------------------------------------

-- The layout's beams with collinear axis-aligned runs merged and duplicates dropped; returns
-- { a, b, thick, stage } segments.
local function mergedBeams(): { { a: Vector3, b: Vector3, thick: number, stage: number } }
	local out = {}
	local function r(v: number): string
		return string.format("%.2f", v)
	end
	type Run = { axis: number, lo: number, hi: number, fixed: Vector3, thick: number, stage: number }
	local lines: { [string]: { Run } } = {}
	local seen: { [string]: boolean } = {}
	for _, beam in LAYOUT.trusses do
		local a = Vector3.new(beam.a.x, beam.a.y, beam.a.z)
		local b = Vector3.new(beam.b.x, beam.b.y, beam.b.z)
		local d = b - a
		local axis = 0
		if math.abs(d.Y) < 1e-3 and math.abs(d.Z) < 1e-3 then
			axis = 1
		elseif math.abs(d.X) < 1e-3 and math.abs(d.Z) < 1e-3 then
			axis = 2
		elseif math.abs(d.X) < 1e-3 and math.abs(d.Y) < 1e-3 then
			axis = 3
		end
		if axis == 0 then
			local k1, k2 = r(a.X) .. r(a.Y) .. r(a.Z), r(b.X) .. r(b.Y) .. r(b.Z)
			local id = if k1 < k2 then k1 .. k2 else k2 .. k1
			if not seen[id] then
				seen[id] = true
				table.insert(out, { a = a, b = b, thick = beam.thick, stage = beam.stage })
			end
		else
			local comp = { a.X, a.Y, a.Z }
			local compB = { b.X, b.Y, b.Z }
			local fixed = Vector3.new(if axis == 1 then 0 else a.X, if axis == 2 then 0 else a.Y, if axis == 3 then 0 else a.Z)
			local id = axis .. ":" .. r(fixed.X) .. r(fixed.Y) .. r(fixed.Z) .. ":" .. beam.stage
			local list = lines[id]
			if not list then
				list = {}
				lines[id] = list
			end
			table.insert(list, {
				axis = axis,
				lo = math.min(comp[axis], compB[axis]),
				hi = math.max(comp[axis], compB[axis]),
				fixed = fixed,
				thick = beam.thick,
				stage = beam.stage,
			})
		end
	end
	local ids = {}
	for id in lines do
		table.insert(ids, id)
	end
	table.sort(ids)
	for _, id in ids do
		local list = lines[id]
		table.sort(list, function(p: Run, q: Run)
			return p.lo < q.lo
		end)
		local cur: Run? = nil
		local function flush()
			if cur then
				local c = cur :: Run
				local unit = if c.axis == 1 then Vector3.xAxis elseif c.axis == 2 then Vector3.yAxis else Vector3.zAxis
				table.insert(out, { a = c.fixed + unit * c.lo, b = c.fixed + unit * c.hi, thick = c.thick, stage = c.stage })
			end
		end
		for _, run in list do
			if cur and run.lo <= (cur :: Run).hi + 0.01 then
				(cur :: Run).hi = math.max((cur :: Run).hi, run.hi)
			else
				flush()
				cur = { axis = run.axis, lo = run.lo, hi = run.hi, fixed = run.fixed, thick = run.thick, stage = run.stage }
			end
		end
		flush()
	end
	return out
end

-- Orange Neon X-frame beams into each room's Truss folder; returns the part count.
local function buildTrusses(trussFolders: { [number]: Instance }): number
	-- Wall props hide the beams right behind them: skip those (instance budget).
	local hiders: { [number]: { { pos: Vector3, r: number } } } = {}
	for _, p in LAYOUT.props do
		if p.wall then
			local list = hiders[p.stage] or {}
			hiders[p.stage] = list
			table.insert(list, { pos = Vector3.new(p.x, p.y, p.z), r = p.scale * 0.45 })
		end
	end
	local function hidden(stage: number, mid: Vector3): boolean
		local list = hiders[stage]
		if not list then
			return false
		end
		for _, h in list do
			if math.abs(h.pos.Z - mid.Z) < 3 and Vector2.new(h.pos.X - mid.X, h.pos.Y - mid.Y).Magnitude < h.r then
				return true
			end
		end
		return false
	end
	local count = 0
	for _, beam in mergedBeams() do
		local parent = trussFolders[beam.stage]
		if parent and not hidden(beam.stage, (beam.a + beam.b) / 2) then
			local len = (beam.b - beam.a).Magnitude
			local mid = (beam.a + beam.b) / 2
			local d = beam.b - beam.a
			local vertical = math.abs(d.X) < 1e-3 and math.abs(d.Z) < 1e-3
			glow(parent, {
				Name = "Truss",
				-- Overlap the joints by one beam thickness.
				Size = if vertical
					then Vector3.new(beam.thick, len + beam.thick, beam.thick)
					else Vector3.new(beam.thick, beam.thick, len + beam.thick),
				CFrame = if vertical then CFrame.new(mid) else CFrame.lookAt(mid, beam.b),
				Color = c3(themeOf(beam.stage).truss),
			})
			count += 1
		end
	end
	return count
end

-- Pads, treadmills --------------------------------------------------------------

local function upgradePad(parent: Instance, zone: Layout.Zone): BasePart
	local pad = zone.upgradePad :: Layout.Pad
	local s = pad.size
	decor(add(parent, {
		Name = "UpgradeGlow",
		Size = Vector3.new(s + 1, 0.3, s + 1),
		CFrame = CFrame.new(pad.x, TOP + 0.15, pad.z),
		Color = W.Orange,
		Material = Enum.Material.Neon,
		CastShadow = false,
	}))
	local part = add(parent, {
		Name = "UpgradePad",
		Size = Vector3.new(s, 0.5, s),
		CFrame = CFrame.new(pad.x, TOP + 0.25, pad.z),
		Color = W.Orange:Lerp(W.White, 0.2),
	})
	part:AddTag("CardioUpgradePad")
	-- Console on the pad's outer (-Z) side, its screen facing the corridor's centre line.
	local console = folderIn(parent, "UpgradeConsole", "Model")
	local cz = pad.z - s / 2 - 1.2
	add(console, {
		Name = "ConsolePost",
		Size = Vector3.new(1.4, 4.2, 1.4),
		CFrame = CFrame.new(pad.x, TOP + 2.1, cz),
		Color = W.Teal,
	})
	local screen = add(console, {
		Name = "ConsoleScreen",
		Size = Vector3.new(8, 4.4, 0.8),
		CFrame = CFrame.new(pad.x, TOP + 6, cz) * CFrame.Angles(math.rad(-15), math.pi, 0),
		Color = W.Cream,
	})
	local gui = surface(screen, Enum.NormalId.Front, 40)
	text(gui, {
		Text = "TREADMILL",
		TextColor3 = W.White,
		BackgroundTransparency = 0,
		BackgroundColor3 = W.Orange,
		Size = UDim2.fromScale(1, 0.36),
	})
	text(gui, { Text = "SPEED UP", Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.42) })
	return part
end

-- The WIN pad of a safe zone: a big gold button in the game's pad style (a low rim, a gold
-- top with a printed "WIN" inside a Neon border) with a Neon post on each corner, under a
-- floating label whose "Amount" line the client writes per player.
local function winPad(parent: Instance, zone: Layout.Zone): BasePart
	local pad = zone.winPad :: Layout.Pad
	local s = pad.size
	local gold = W.Sunny
	add(parent, {
		Name = "WinRim",
		Size = Vector3.new(s + 2.4, 0.3, s + 2.4),
		CFrame = CFrame.new(pad.x, TOP + 0.15, pad.z),
		Color = W.PadRim or W.Teal,
	})
	glow(parent, {
		Name = "WinGlow",
		Size = Vector3.new(s + 1.2, 0.36, s + 1.2),
		CFrame = CFrame.new(pad.x, TOP + 0.18, pad.z),
		Color = gold:Lerp(W.White, 0.35),
	})
	local part = add(parent, {
		Name = "WinPad",
		Size = Vector3.new(s, 0.5, s),
		-- Front toward +X so the Top-face print reads for runners arriving from the west.
		CFrame = CFrame.new(pad.x, TOP + 0.25, pad.z) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = gold,
	})
	part:SetAttribute("Stage", zone.stage)
	part:SetAttribute("ZoneX0", zone.x0)
	part:SetAttribute("ZoneX1", zone.x1)
	part:SetAttribute("ZoneZ0", zone.z0)
	part:SetAttribute("ZoneZ1", zone.z1)
	part:AddTag("CardioWinPad")
	light(part, gold, 22, 1.6)
	outline(
		text(surface(part, Enum.NormalId.Top, 20), {
			Text = "WIN",
			TextColor3 = W.White,
			Size = UDim2.fromScale(0.8, 0.5),
			Position = UDim2.fromScale(0.1, 0.25),
		}),
		W.Ink,
		5
	)
	for _, dx in { -1, 1 } do
		for _, dz in { -1, 1 } do
			glow(parent, {
				Name = "WinPost",
				Size = Vector3.new(0.9, 5, 0.9),
				CFrame = CFrame.new(pad.x + dx * (s / 2 + 0.75), TOP + 2.5, pad.z + dz * (s / 2 + 0.75)),
				Color = gold,
			})
		end
	end
	-- Floating label, readable from the zone's doorways.
	local gui = Instance.new("BillboardGui")
	gui.Name = "WinLabel"
	gui.Adornee = part
	gui.Size = UDim2.fromScale(20, 9)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 10.5, 0)
	gui.MaxDistance = 260
	gui.LightInfluence = 0
	gui.Parent = part
	outline(text(gui, { Name = "Title", Text = "WIN", TextColor3 = gold, Size = UDim2.fromScale(1, 0.52) }), W.Ink, 4)
	outline(
		text(gui, {
			Name = "Amount",
			Text = "CASH OUT",
			Font = theme.Fonts.Number,
			TextColor3 = theme.Colors.MoneyText,
			Size = UDim2.fromScale(1, 0.44),
			Position = UDim2.fromScale(0, 0.54),
		}),
		W.Ink,
		3
	)
	return part
end

local function fallbackTreadmill(model: Model, cf: CFrame)
	add(model, {
		Name = "TreadmillBase",
		Size = Vector3.new(BELT_W + 1.6, BELT.top, 12),
		CFrame = cf * CFrame.new(0, BELT.top / 2, 0),
		Color = W.Teal,
	})
	add(model, {
		Name = "TreadmillConsole",
		Size = Vector3.new(BELT_W + 1.6, 1.6, 1),
		CFrame = cf * CFrame.new(0, BELT.top + 4.4, -5) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = W.Coral,
	})
end

local function treadmill(parent: Instance, stage: number, index: number, tm: Layout.Treadmill): Model
	local model = folderIn(parent, "Treadmill", "Model") :: Model
	model:SetAttribute("Zone", stage)
	model:SetAttribute("Index", index)
	model:AddTag("CardioTreadmill")
	local floor = tm.y - Layout.TREADMILL.height
	-- Belt centre on (x, z), the runner facing the yaw's look vector.
	local beltCentre = CFrame.new(tm.x, floor + BELT.top, tm.z) * CFrame.Angles(0, tm.yaw, 0)
	local cf = beltCentre * CFrame.new(0, -BELT.top, -BELT_CZ)
	local mesh = meshOf("props/CardioTreadmill")
	if mesh then
		mesh.Name = "TreadmillMesh"
		mesh.CFrame = cf * CFrame.new(0, mesh.Size.Y / 2, 0)
		mesh.Parent = model
		model.PrimaryPart = mesh
	else
		fallbackTreadmill(model, cf)
	end
	local t = 0.1
	local belt = add(model, {
		Name = "Belt",
		Size = Vector3.new(BELT_W, t, BELT_L),
		CFrame = beltCentre * CFrame.new(0, BELT.chevronTop - BELT.top + 0.02 + t / 2, 0),
		Color = BELT_COLOUR,
		CastShadow = false,
	})
	local tex = Instance.new("Texture")
	tex.Name = "BeltTexture"
	tex.Face = Enum.NormalId.Top
	tex.Texture = Assets.image("vfx/SoftDot") or ""
	tex.Color3 = BELT_PRINT
	tex.StudsPerTileU = 1.4
	tex.StudsPerTileV = 1.4
	tex.Parent = belt
	if not model.PrimaryPart then
		model.PrimaryPart = belt
	end
	return model
end

-- Bases, blocks, props -----------------------------------------------------------------------

local function base(parent: Instance, b: Layout.Base, name: string): BasePart
	local p = add(parent, {
		Name = name,
		Size = Vector3.new(b.sx, b.sy, b.sz),
		CFrame = CFrame.new(b.x, b.y, b.z),
		Color = CHOCOLATE_DARK,
		CastShadow = false,
	})
	p:SetAttribute("Group", b.group)
	return p
end

-- A raised key block's pillar (theme-tinted, down to the hazard) with a Neon edge rim just
-- under the keys.
local function blockPillar(parent: Instance, b: Layout.Base)
	local look = themeOf(b.stage)
	local model = folderIn(parent, "Block" .. (b.block :: number), "Model")
	model:SetAttribute("Block", b.block)
	local pillar = base(model, b, "BlockPillar")
	pillar.Color = c3(look.wall):Lerp(c3(look.keys[1]), 0.5)
	local edge = c3(look.edge)
	local top = b.y + b.sy / 2
	local x0, x1, z0, z1 = b.x - b.sx / 2, b.x + b.sx / 2, b.z - b.sz / 2, b.z + b.sz / 2
	local s = 0.6
	for _, z in { z0, z1 } do
		glow(model, { Name = "BlockEdge", Size = Vector3.new(b.sx + s, s, s), CFrame = CFrame.new(b.x, top - s / 2, z), Color = edge })
	end
	for _, x in { x0, x1 } do
		glow(model, { Name = "BlockEdge", Size = Vector3.new(s, s, b.sz + s), CFrame = CFrame.new(x, top - s / 2, b.z), Color = edge })
	end
end

-- Candy meshes lying this flat (depth / largest side) lie down on the floor.
local FLAT = 0.4

-- One candy prop: the vertex-coloured `props/<kind>` mesh scaled so its largest side is
-- `scale` (never tinted), or a coloured ball when the mesh is missing. Decor only.
local function prop(parent: Instance, p: Layout.Prop)
	local mesh = meshOf("props/" .. p.kind)
	local part: BasePart
	local size: Vector3
	if mesh then
		local s = mesh.Size
		size = s * (p.scale / math.max(s.X, s.Y, s.Z))
		mesh.Size = size
		mesh.Parent = parent
		part = mesh
	else
		size = Vector3.new(p.scale, p.scale * 0.8, p.scale)
		local keys = themeOf(p.stage).keys
		part = add(parent, {
			Shape = BALL,
			Size = size,
			Color = c3(keys[(math.floor(p.x + p.z) % #keys) + 1]),
		})
	end
	part.Name = p.kind
	decor(part)
	if p.wall then
		local nv = p.normal or { x = 0, y = 0, z = 1 }
		local n = Vector3.new(nv.x, nv.y, nv.z)
		local pos = Vector3.new(p.x, p.y, p.z) + n * (size.Z / 2)
		-- Front (-Z) into the room, a playful tilt about the normal.
		part.CFrame = CFrame.lookAt(pos, pos + n) * CFrame.Angles(0, 0, (p.yaw % 1) - 0.5)
	elseif size.Z < FLAT * math.max(size.X, size.Y) then
		-- Lollipops, bars, swirls, cookies: lying on their back, front up.
		local bottom = if p.float then p.y + 0.3 * p.scale - 0.4 * size.Z else p.y
		part.CFrame = CFrame.new(p.x, bottom + size.Z / 2, p.z) * CFrame.Angles(0, p.yaw, 0) * CFrame.Angles(math.pi / 2, 0, 0)
	else
		part.CFrame = CFrame.new(p.x, p.y + size.Y / 2, p.z) * CFrame.Angles(0, p.yaw, 0)
	end
end

-- Signs, finish --------------------------------------------------------------------------------

-- A 3-line stage card: an accent header band ("STAGE n"), the stage name in big outlined
-- accent letters, and an Ink foot band with Sunny text.
local function stageCard(p: BasePart, face: Enum.NormalId, accent: Color3, header: string, title: string, foot: string)
	local gui = surface(p, face, 12)
	outline(
		text(gui, {
			Text = header,
			TextColor3 = W.White,
			BackgroundTransparency = 0,
			BackgroundColor3 = accent,
			Size = UDim2.fromScale(1, 0.28),
		}),
		W.Ink,
		3
	)
	outline(
		text(gui, {
			Text = title,
			TextColor3 = accent,
			Size = UDim2.fromScale(0.94, 0.38),
			Position = UDim2.fromScale(0.03, 0.31),
		}),
		W.Ink,
		5
	)
	text(gui, {
		Text = foot,
		TextColor3 = W.Sunny,
		BackgroundTransparency = 0,
		BackgroundColor3 = W.Ink,
		Size = UDim2.fromScale(1, 0.26),
		Position = UDim2.fromScale(0, 0.74),
	})
end

local function cardioTitle(model: Instance, x: number, y: number, z: number)
	local w, h = 64, 16
	glow(model, { Name = "TitleGlow", Size = Vector3.new(DW + 0.6, h + 2, w + 2), CFrame = CFrame.new(x, y, z), Color = W.Coral })
	local title = decor(add(model, {
		Name = "CardioTitle",
		Size = Vector3.new(DW + 1, h, w),
		CFrame = CFrame.new(x, y, z),
		Color = W.Cream,
	}))
	light(title, W.Coral, 40, 1.5)
	local icon = Assets.image("cardio/Cardio")
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		local gui = surface(title, face, 8)
		if icon then
			local img = Instance.new("ImageLabel")
			img.BackgroundTransparency = 1
			img.Image = icon
			img.ScaleType = Enum.ScaleType.Fit
			img.Size = UDim2.fromScale(0.16, 0.9)
			img.Position = UDim2.fromScale(0.02, 0.05)
			img.Parent = gui
		end
		outline(
			text(gui, { Text = "CARDIO", TextColor3 = W.Coral, Size = UDim2.fromScale(0.62, 0.7), Position = UDim2.fromScale(0.2, 0.04) }),
			W.Ink,
			6
		)
		text(gui, {
			Text = "STEP ON KEYS = +SPEED",
			Font = theme.Fonts.UI,
			Size = UDim2.fromScale(0.6, 0.2),
			Position = UDim2.fromScale(0.21, 0.76),
		})
	end
end

-- Lobby room ----------------------------------------------------------------------------------

local WARM = Color3.fromRGB(255, 196, 140)

-- An orange Neon beam from a to b (square section) into parent.
local function beamPart(parent: Instance, a: Vector3, b: Vector3, thick: number, colour: Color3)
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local d = b - a
	local vertical = math.abs(d.X) < 1e-3 and math.abs(d.Z) < 1e-3
	glow(parent, {
		Name = "Truss",
		Size = if vertical then Vector3.new(thick, len + thick, thick) else Vector3.new(thick, thick, len + thick),
		CFrame = if vertical then CFrame.new(mid) else CFrame.lookAt(mid, b),
		Color = colour,
	})
end

-- X-truss frame on a lobby wall face: `at(u, y)` maps along-wall u and height y to world;
-- `skip(u, y)` drops beams whose midpoint is hidden (behind the title board).
local function lobbyFrame(
	parent: Instance,
	u0: number,
	u1: number,
	y0: number,
	y1: number,
	at: (number, number) -> Vector3,
	skip: (Vector3) -> boolean
)
	local thick = Layout.TRUSS.thick
	local colour = c3(themeOf(0).truss)
	local bays = math.max(1, math.floor((u1 - u0) / 15 + 0.5))
	local bw = (u1 - u0) / bays
	local function put(a: Vector3, b: Vector3)
		if not skip((a + b) / 2) then
			beamPart(parent, a, b, thick, colour)
		end
	end
	put(at(u0, y0), at(u1, y0))
	put(at(u0, y1), at(u1, y1))
	for i = 0, bays do
		put(at(u0 + i * bw, y0), at(u0 + i * bw, y1))
	end
	for i = 0, bays - 1 do
		local ua, ub = u0 + i * bw, u0 + (i + 1) * bw
		put(at(ua, y0), at(ub, y1))
		put(at(ua, y1), at(ub, y0))
	end
end

-- The Warm-Up lobby as a full room: orange X trusses on its three walls, roof joists at wall
-- height, candy clusters on the side walls and in the back corners, a giant CARDIO title on
-- the back (west) wall and a few warm lamps. Decor only.
local function lobbyRoom(model: Instance, zone: Layout.Zone)
	local look = themeOf(0)
	local decorFolder = folderIn(model, "LobbyDecor")
	local thick = Layout.TRUSS.thick
	local top = TOP + Layout.ZONE_WALL_HEIGHT - thick / 2
	local y0 = zone.top + 2
	local x0, x1, z0, z1 = zone.x0, zone.x1, zone.z0, zone.z1
	-- The back-wall title board (west wall, facing the room).
	local titleY, titleW, titleH = TOP + 19, 64, 16
	local function behindTitle(p: Vector3): boolean
		return p.X < x0 + 3 and math.abs(p.Y - titleY) < titleH / 2 + 1 and math.abs(p.Z - O.z) < titleW / 2 + 1
	end
	local function none(_: Vector3): boolean
		return false
	end
	lobbyFrame(decorFolder, x0, x1, y0, top, function(u, y)
		return Vector3.new(u, y, z0 + thick / 2)
	end, none)
	lobbyFrame(decorFolder, x0, x1, y0, top, function(u, y)
		return Vector3.new(u, y, z1 - thick / 2)
	end, none)
	lobbyFrame(decorFolder, z0, z1, y0, top, function(u, y)
		return Vector3.new(x0 + thick / 2, y, u)
	end, behindTitle)
	-- Roof joists across the room at wall height (wall to wall).
	local colour = c3(look.truss)
	for _, f in { 0.25, 0.5, 0.75 } do
		local x = x0 + (x1 - x0) * f
		beamPart(decorFolder, Vector3.new(x, top, z0), Vector3.new(x, top, z1), thick, colour)
	end
	beamPart(decorFolder, Vector3.new(x0, top, O.z), Vector3.new(x1, top, O.z), thick, colour)
	cardioTitle(decorFolder, x0 - Layout.WALL.thick / 2, titleY, O.z)

	-- Candy clusters: three on each side wall, a big pair in each back corner.
	local kinds = look.props
	local rand = rng(4242)
	local function pick(): string
		return kinds[math.floor(rand() * #kinds) + 1]
	end
	for _, north in { false, true } do
		local z = if north then z1 else z0
		local normal = { x = 0, y = 0, z = if north then -1 else 1 }
		for g = 0, 2 do
			local ax = x0 + (g + 0.5) * (x1 - x0) / 3
			local ay = TOP + 15 + rand() * 6
			for c = 1, 3 do
				local scale = if c == 1 then 9 + rand() * 3 else 5 + rand() * 2
				local dx = if c == 1 then 0 else (c - 2.5) * 2 * (scale / 2 + 5)
				prop(
					decorFolder,
					{
						kind = pick(),
						x = ax + dx,
						y = math.clamp(ay + (if c == 1 then 0 else (rand() - 0.5) * 8), TOP + 6, top - scale / 2),
						z = z,
						yaw = rand() * 6.28,
						scale = scale,
						stage = 0,
						wall = true,
						normal = normal,
						float = false,
					} :: any
				)
			end
		end
		for c = 1, 2 do
			local scale = if c == 1 then 8 else 5
			prop(
				decorFolder,
				{
					kind = pick(),
					x = x0 + 1 + scale / 2 + (c - 1) * 7,
					y = zone.top,
					z = if north then z1 - scale / 2 - 1 else z0 + scale / 2 + 1,
					yaw = rand() * 6.28,
					scale = scale,
					stage = 0,
					wall = false,
					normal = nil,
					float = false,
				} :: any
			)
		end
	end

	-- Warm lamps under the roof joists.
	for i, f in { 0.25, 0.75 } do
		for _, s in { -1, 1 } do
			local lamp = glow(decorFolder, {
				Name = "Lamp",
				Shape = BALL,
				Size = Vector3.new(2.4, 2.4, 2.4),
				CFrame = CFrame.new(x0 + (x1 - x0) * f, top - 2, O.z + s * 18),
				Color = WARM,
			})
			light(lamp, WARM, 42, if i == 1 then 1.3 else 1.1)
		end
	end
end

-- The stage banner through bridge room n's west wall, above its doorway (both faces).
local function stageSign(parent: Instance, sign: Layout.Sign, room: Layout.Room)
	local accent = stageColour(sign.stage)
	local model = folderIn(parent, "StageSign" .. sign.stage, "Model")
	model:SetAttribute("Stage", sign.stage)
	local w, h = 40, 15
	local x = room.x0 + DW / 2
	local z = math.clamp(sign.z, room.z0 + w / 2 + 2, room.z1 - w / 2 - 2)
	glow(model, { Name = "SignGlow", Size = Vector3.new(DW + 0.6, h + 1.6, w + 1.6), CFrame = CFrame.new(x, sign.y, z), Color = accent })
	local board = decor(add(model, {
		Name = "StageSign",
		Size = Vector3.new(DW + 1, h, w),
		CFrame = CFrame.new(x, sign.y, z),
		Color = W.Cream,
	}))
	light(board, accent, 30, 1.2)
	local foot = if sign.need > 0 then "NEED " .. Format.commas(sign.need) .. " SPEED" else "NO SPEED NEEDED"
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		stageCard(board, face, accent, "STAGE " .. sign.stage, string.upper(sign.name), foot)
	end
	if sign.stage == 1 then
		-- The lobby's exit wall: the giant CARDIO title above the first banner.
		cardioTitle(model, x, sign.y + h / 2 + 10, z)
	end
end

local function finish(parent: Instance)
	local f = LAYOUT.finish
	local podium = folderIn(parent, "FinishPodium", "Model")
	local tiers = { { 14, W.Teal }, { 10, W.Coral }, { 6, W.Sunny } }
	for i, tier in tiers do
		disc(podium, "PodiumTier", Vector3.new(f.x, f.y + (i - 0.5) * 1.5, f.z), tier[1] :: number, 1.5, tier[2] :: Color3)
	end
	local star = glow(podium, {
		Name = "PodiumStar",
		Shape = BALL,
		Size = Vector3.new(3, 3, 3),
		CFrame = CFrame.new(f.x, f.y + 4.5 + 6, f.z),
		Color = W.Sunny,
	})
	light(star, W.Sunny, 24, 2)
	-- FINISH! board on the cap wall's inner face.
	for _, w in LAYOUT.walls do
		if w.side == "east" and w.part == "full" then
			local x = w.x - w.sx / 2
			local y = TOP + 22
			glow(parent, { Name = "FinishGlow", Size = Vector3.new(0.6, 16, 52), CFrame = CFrame.new(x - 0.3, y, O.z), Color = W.Coral })
			local board = decor(add(parent, {
				Name = "FinishSign",
				Size = Vector3.new(1, 14, 50),
				CFrame = CFrame.new(x - 0.5, y, O.z),
				Color = W.Cream,
			}))
			local gui = surface(board, Enum.NormalId.Left, 12)
			outline(
				text(
					gui,
					{ Text = "FINISH!", TextColor3 = W.Coral, Size = UDim2.fromScale(0.9, 0.62), Position = UDim2.fromScale(0.05, 0.06) }
				),
				W.Ink,
				6
			)
			text(gui, { Text = "KEYBOARD CHAMPION", Size = UDim2.fromScale(0.8, 0.24), Position = UDim2.fromScale(0.1, 0.7) })
		end
	end
end

-- Build ------------------------------------------------------------------------------------

-- One invisible anchored collision slab per walkable key surface (x0..x1, z0..z1, key tops
-- at `top`): its top is PRESS below the key tops, so feet rest where pressed keys
-- bottom out. Blink / mover platforms pass their blink / slide attributes (Fx.Modes toggles
-- the slab's collision / slides it with its keys).
local SLAB_DEPTH = 1
local function collider(parent: Instance, x0: number, x1: number, z0: number, z1: number, top: number, platform: Layout.Platform?): BasePart
	local y = top - PRESS
	local slab = add(parent, {
		Name = "KeySlab",
		Size = Vector3.new(x1 - x0, SLAB_DEPTH, z1 - z0),
		CFrame = CFrame.new((x0 + x1) / 2, y - SLAB_DEPTH / 2, (z0 + z1) / 2),
		Transparency = 1,
		CastShadow = false,
		CanCollide = true,
		CanQuery = true,
		CanTouch = false,
	})
	if platform and platform.kind == "blink" then
		slab:SetAttribute("BlinkOn", platform.blinkOn)
		slab:SetAttribute("BlinkPeriod", platform.blinkPeriod)
		slab:SetAttribute("BlinkPhase", platform.phase or 0)
		slab:AddTag("BlinkPad")
	elseif platform and platform.kind == "mover" then
		local period = platform.period :: number
		slab:SetAttribute("Mover", "slide")
		slab:SetAttribute("MoveAxis", Vector3.new(0, 0, 1))
		slab:SetAttribute("MoveDistance", platform.travel)
		slab:SetAttribute("MovePeriod", period)
		slab:SetAttribute("MovePhase", 2 * math.pi * (platform.phase or 0) / period)
		slab:AddTag("ModeMover")
	end
	return slab
end

function CardioTrack.build(): Built
	lightCount = 0
	local folder = Instance.new("Folder")
	folder.Name = "CardioTrack"
	folder:SetAttribute("Mode", "cardio")
	local keysFolder = folderIn(folder, "Keys")

	local stageFolders: { [number]: Instance } = {}
	for n = 0, Rules.STAGE_COUNT do
		stageFolders[n] = folderIn(keysFolder, "Stage" .. n)
	end

	local keys: { BasePart } = {}
	for i, key in LAYOUT.keys do
		keys[i] = buildKey(stageFolders[key.stage], key, i)
	end
	folder:SetAttribute("PressDepth", PRESS)
	folder:SetAttribute("KeyPitch", KEY.size)
	local slabs = folderIn(folder, "Colliders")
	for _, p in LAYOUT.platforms do
		collider(slabs, p.x0, p.x1, p.z0, p.z1, p.top, p)
	end
	for _, zone in LAYOUT.zones do
		collider(slabs, zone.x0, zone.x1, zone.z0, zone.z1, zone.top, nil)
	end
	for _, b in LAYOUT.blocks do
		collider(slabs, b.x0, b.x1, b.z0, b.z1, b.top, nil)
	end

	-- Bridge rooms: hazard floor, truss and prop folders.
	local rooms: { [number]: Model } = {}
	local hazards: { [number]: BasePart } = {}
	local trussFolders: { [number]: Instance } = {}
	local propFolders: { [number]: Instance } = {}
	local roomOf: { [number]: Layout.Room } = {}
	for _, room in LAYOUT.rooms do
		if room.kind == "bridge" then
			local model = folderIn(folder, "Room" .. room.stage, "Model") :: Model
			model:SetAttribute("Stage", room.stage)
			model:SetAttribute("Theme", room.theme)
			rooms[room.stage] = model
			roomOf[room.stage] = room
			hazards[room.stage] = hazard(model, room)
			trussFolders[room.stage] = folderIn(model, "Truss")
			propFolders[room.stage] = folderIn(model, "Props")
		end
	end
	local trussCount = buildTrusses(trussFolders)
	folder:SetAttribute("TrussParts", trussCount)
	for _, p in LAYOUT.props do
		local parent = propFolders[p.stage]
		if parent then
			prop(parent, p)
		end
	end

	-- Blinking platforms get a Neon rail under their keys (the keys fade; the rail stays).
	for _, p in LAYOUT.platforms do
		if p.kind == "blink" then
			glow(rooms[p.stage], {
				Name = "BlinkRail",
				Size = Vector3.new(p.x1 - p.x0 + 0.6, 0.4, p.z1 - p.z0 + 0.6),
				CFrame = CFrame.new((p.x0 + p.x1) / 2, p.top - KEY.height - 0.6, (p.z0 + p.z1) / 2),
				Color = stageColour(p.stage):Lerp(W.White, 0.3),
			})
		end
	end

	local zones: { [number]: Model } = {}
	local decks: { [number]: BasePart } = {}
	local treadmills: { Model } = {}
	local upgrade: BasePart? = nil
	local winPads: { [number]: BasePart } = {}
	for _, zone in LAYOUT.zones do
		local model = folderIn(folder, "Zone" .. zone.stage, "Model") :: Model
		model:SetAttribute("Stage", zone.stage)
		zones[zone.stage] = model
		for i, tm in zone.treadmills do
			table.insert(treadmills, treadmill(model, zone.stage, i, tm))
		end
		if zone.upgradePad then
			upgrade = upgradePad(model, zone)
		end
		if zone.winPad then
			winPads[zone.stage] = winPad(model, zone)
		end
		if zone.stage == 0 then
			lobbyRoom(model, zone)
		end
	end

	-- Chocolate slabs: decks into their zone models, block pillars and platform bases into
	-- their bridge rooms.
	for _, b in LAYOUT.bases do
		if b.block then
			blockPillar(rooms[b.stage], b)
		elseif b.group == 0 then
			decks[b.stage] = base(zones[b.stage], b, "Deck")
		else
			base(rooms[b.stage], b, "Base")
		end
	end

	buildWalls(folderIn(folder, "Walls"))
	local doorFolder = folderIn(folder, "Doors")
	local doors: { [number]: BasePart } = {}
	for i, d in LAYOUT.doors do
		local slab = door(doorFolder, d, i)
		if slab then
			doors[i] = slab
		end
	end
	local signs = folderIn(folder, "Signs")
	for _, sign in LAYOUT.signs do
		local room = roomOf[sign.stage]
		if room then
			stageSign(signs, sign, room)
		end
	end
	finish(folder)

	folder.Parent = Workspace
	return {
		folder = folder,
		keys = keys,
		zones = zones,
		decks = decks,
		upgradePad = upgrade :: BasePart,
		winPads = winPads,
		treadmills = treadmills,
		rooms = rooms,
		hazards = hazards,
		doors = doors,
	}
end

return CardioTrack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="199">
          <Properties>
            <string name="Name">Common</string>
            <string name="Source"><![CDATA[--[[
	Common: constants, part/label/billboard primitives and shared types for the world modules.
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Layout = require(script.Parent.Parent.PlotLayout)

local Common = {}

-- The theme module and the Map folder every world module builds into.
local theme: any = require(ReplicatedStorage:WaitForChild("Theme"))
local mapFolder = Instance.new("Folder")
mapFolder.Name = "Map"

local PLOT_COUNT = 6
local PLOT_HALF = Layout.PLOT_HALF

-- Rotations for cylinders (a Roblox cylinder's axis is its X axis).
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0)

local WHITE = Color3.new(1, 1, 1)

-- Shared sign style: a cream card with a thin teal border, a red-orange header band with a
-- white title and Ink body text. Small tags (rack row numbers) fade out beyond SIGN_FADE_TAG
-- studs and plot sign cards beyond SIGN_FADE_CARD, so other plots' signs drop out of view.
local SIGN = {
	Card = theme.World.Cream,
	Header = theme.World.RedOrange,
	Title = theme.World.White,
	Text = theme.World.Ink,
	Border = theme.World.Teal,
}
local SIGN_FADE_TAG = 80
local SIGN_FADE_CARD = 120

-- Warm white used to light the display units.
local SHELF_LIGHT = Color3.fromRGB(255, 236, 205)

export type Rect = Layout.Rect

export type Pad = {
	name: string,
	center: Vector3,
	half: Vector2,
	part: BasePart,
	title: TextLabel,
	sub: TextLabel,
	-- What `title` and `sub` say (and sub's tint) on a plot nobody owns: Server.Tycoon puts
	-- them back when the owner leaves.
	defaultTitle: string,
	defaultSub: string,
	defaultTint: Color3,
}
-- Primitives ------------------------------------------------------------------------

local function make(className: string, props: { [string]: any }): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent or mapFolder
	return p
end

local function part(props: { [string]: any }): BasePart
	return make("Part", props)
end

local function stroke(parent: Instance, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2
	s.Color = theme.Colors.Stroke
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = theme.Fonts.Title
	l.TextColor3 = theme.Colors.Text
	l.Size = UDim2.fromScale(1, 0.3)
	for key, value in props do
		(l :: any)[key] = value
	end
	stroke(l, props.StrokeThickness)
	l.Parent = parent
	return l
end

local function billboard(adornee: BasePart, offsetY: number, width: number, height: number): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(width, height)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 60
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

-- Billboards made by other modules (unit name tags, crate labels) are drawn 25% smaller so the
-- plot stays readable; callers can still override MaxDistance.
local EXTERNAL_BILLBOARD_SCALE = 0.75
local function externalBillboard(adornee: BasePart, offsetY: number, width: number, height: number): BillboardGui
	return billboard(adornee, offsetY, width * EXTERNAL_BILLBOARD_SCALE, height * EXTERNAL_BILLBOARD_SCALE)
end

-- Hub ring: two rows of three plots facing a round plaza. Plot centres sit at
-- (col * PLOT_SPACING_X, row * PLOT_ROW_Z) for col = -1..1, row = +-1, so entrances are at
-- |z| = ENTRANCE_Z. The cross avenue runs along |z| = CROSS_Z between the plaza and the plots.
local HUB_RADIUS = 32
local PLOT_SPACING_X = PLOT_HALF * 2 + 10
local CROSS_Z = HUB_RADIUS + 12
local PLOT_ROW_Z = CROSS_Z + 10 + PLOT_HALF
local ENTRANCE_Z = PLOT_ROW_Z - PLOT_HALF

local function plotCFrame(index: number): CFrame
	local row = if index <= 3 then 1 else -1
	local col = ((index - 1) % 3) - 1
	-- Face the hub: the plot's -Z (its entrance) points toward z = 0. Same result
	-- as CFrame.lookAt, but exact everywhere (Lune's lookAt, used by the preview,
	-- flips this case).
	return CFrame.new(col * PLOT_SPACING_X, 0, row * PLOT_ROW_Z) * CFrame.Angles(0, if row == 1 then 0 else math.pi, 0)
end

export type Builder = {
	cf: CFrame,
	folder: Folder,
	c: any,
	L: (x: number, y: number, z: number) -> CFrame,
	P: (props: { [string]: any }) -> BasePart,
	W: (props: { [string]: any }) -> BasePart,
}
-- Colour of a tier's rarity band (matches the client's tier colours).
local function tierBandColor(tier: number): Color3
	return theme.Colors.Rarity[Economy.tierBand(tier)] or theme.Colors.Primary
end

Common.PLOT_COUNT = PLOT_COUNT
Common.PLOT_HALF = PLOT_HALF
Common.UPRIGHT = UPRIGHT
Common.ALONG_Z = ALONG_Z
Common.WHITE = WHITE
Common.SIGN = SIGN
Common.SIGN_FADE_TAG = SIGN_FADE_TAG
Common.SIGN_FADE_CARD = SIGN_FADE_CARD
Common.SHELF_LIGHT = SHELF_LIGHT
Common.make = make
Common.part = part
Common.label = label
Common.externalBillboard = externalBillboard
Common.plotCFrame = plotCFrame
Common.HUB_RADIUS = HUB_RADIUS
Common.PLOT_SPACING_X = PLOT_SPACING_X
Common.PLOT_ROW_Z = PLOT_ROW_Z
Common.CROSS_Z = CROSS_Z
Common.ENTRANCE_Z = ENTRANCE_Z
Common.tierBandColor = tierBandColor
Common.theme = theme
Common.mapFolder = mapFolder

return Common
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="200">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[--[[
	Decor: everything painted on a plot's floor (the courts under each group of pads, the cream
	path from the entrance to the merge court and on to both side courts, its chevrons), the
	sunny gym dressing in the areas the courts leave free (a palm each side of the entrance, a
	palm by each side fence), the interactive props along the front fence and the two fan
	zones beside the display ledge. The plot is kept calm: few props, open floor.
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.

	Gym props are Models named Prop_<Kind> with attribute Mesh = "<Kind>" (and Scale) whose
	PrimaryPart ("PropRoot", invisible) sits at the prop's base centre with the prop's front
	along its -Z. World.Props swaps the chunky part-built body for the uploaded Blender mesh at the
	same size (attribute MeshScale) and keeps it as the fallback when the mesh is missing. Props
	stand only in the free areas PlotLayout leaves (along the fences, between the machines); every
	placement is checked against the layout and warns if it touches a pad, the pen, a machine,
	a crate area, a fan zone or the walkway.

	Interactive props are Models named Interactive_<Kind> with attribute Interactive = "<kind>"
	(trampoline, punchbag, bench, podium) standing on a mat at Layout.INTERACTIVE. Client.Fx.Interactive
	plays them (the bounce, the punches, the reps) and finds its way by the invisible marker
	parts built here, which stand beside the Prop_ models so World.Props never swaps them out:
	  Interactive_Trampoline  "BounceAnchor" at the bounce pad's top centre (attribute Radius)
	  Interactive_PunchBag    "BagPivot" where the bag hangs from the stand's arm; "HitZone", a
	                          walk-through box round the bag holding the "PunchPrompt"
	  Interactive_Bench       "BenchSeat", a Seat lying along the pad (its up axis toward the
	                          rack, its front up) that holds one lifter flat on their back;
	                          "LiftAnchor" over the pad holding the "LiftPrompt"; "StandSpot" on
	                          the floor beside the bench, where the lifter gets up
	The only server behaviour is the bench: its prompt seats the player who triggers it (welded
	exactly onto BenchSeat) and lets its lifter go again. The podium is still only a prop.

	Fan zones: each plot folder gets a "FanSpots" folder with one invisible "FanSpot" part per
	Layout.fanSpots() entry (attribute Order, 1 = filled first) at ground level, its
	LookVector facing the display, and attribute Entrance (world Vector3) at the back of its
	zone column, where Fx.Fans runs that spot's fan in from. The zones are dressed with a small bleacher, a "FAN ZONE"
	card on two posts and heart / star cut-outs; the spots themselves stay clear.
]]

local Layout = require(script.Parent.Parent.PlotLayout)
local Common = require(script.Parent.Common)

type Builder = Common.Builder
type Rect = Layout.Rect

local theme = Common.theme
local UPRIGHT = Common.UPRIGHT
local ALONG_Z = Common.ALONG_Z
local WHITE = Common.WHITE

local Decor = {}

local function color(key: string): Color3
	local palette = theme.World
	return if palette and palette[key] then palette[key] else WHITE
end

-- Parts are added to a kit: a parent (a prop Model or a dressing folder), a plot-local base
-- frame, a uniform scale and whether its parts block the player.
type Kit = {
	B: Builder,
	parent: Instance,
	base: CFrame,
	scale: number,
	solid: boolean,
}

local function add(k: Kit, className: string, props: { [string]: any }, at: CFrame): BasePart
	local s = k.scale
	if s ~= 1 then
		at = CFrame.new(at.Position * s) * (CFrame.new(-at.Position) * at)
		props.Size = props.Size * s
	end
	props.CFrame = k.base * at
	props.Parent = k.parent
	if props.CanCollide == nil then
		props.CanCollide = k.solid
	end
	return if className == "WedgePart" then k.B.W(props) else k.B.P(props)
end

local function block(k: Kit, name: string, size: Vector3, at: CFrame, tint: Color3, material: Enum.Material?): BasePart
	return add(k, "Part", { Name = name, Size = size, Color = tint, Material = material }, at)
end

local function ball(k: Kit, name: string, d: number, at: CFrame, tint: Color3, material: Enum.Material?): BasePart
	return add(k, "Part", {
		Name = name,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(d, d, d),
		Color = tint,
		Material = material,
	}, at)
end

-- A cylinder `length` long along the X axis of `at` (use UPRIGHT / ALONG_Z to turn it).
local function cyl(k: Kit, name: string, length: number, d: number, at: CFrame, tint: Color3, material: Enum.Material?): BasePart
	return add(k, "Part", {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, d, d),
		Color = tint,
		Material = material,
	}, at)
end

local function wedge(k: Kit, name: string, size: Vector3, at: CFrame, tint: Color3): BasePart
	return add(k, "WedgePart", { Name = name, Size = size, Color = tint }, at)
end

-- Frame for a cylinder running from a to b (its X axis along a -> b).
local function between(a: Vector3, b: Vector3): CFrame
	local x = (b - a).Unit
	local up = if math.abs(x.Z) < 0.9 then Vector3.new(0, 0, 1) else Vector3.new(1, 0, 0)
	local y = up:Cross(x).Unit
	return CFrame.fromMatrix((a + b) / 2, x, y, x:Cross(y))
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

-- Layout checks -----------------------------------------------------------------------

type Area = { name: string, rect: Rect }

local blockedCache: { Area }? = nil
local function blockedAreas(): { Area }
	if blockedCache then
		return blockedCache
	end
	local list: { Area } = {
		{ name = "walkway", rect = Layout.WALKWAY },
		{ name = "pen", rect = Layout.POOL },
		{ name = "gutter", rect = Layout.GUTTER.rect },
		{ name = "chute", rect = Layout.CHUTE.rect },
	}
	for name, spot in Layout.PADS do
		table.insert(list, { name = "pad " .. name, rect = Layout.padRect(spot, Layout.PAD_RIM) })
	end
	for _, stair in Layout.PEN_STAIRS do
		table.insert(list, { name = "pen stairs", rect = stair.rect })
	end
	for name, r in Layout.MACHINES do
		table.insert(list, { name = "machine " .. name, rect = r })
	end
	for _, r in Layout.CHEST_AREAS do
		table.insert(list, { name = "crate area", rect = r })
	end
	for i, zone in Layout.FAN_ZONES do
		table.insert(list, { name = "fan zone " .. i, rect = zone.rect })
	end
	blockedCache = list
	return list
end

-- Warns when a plot-local footprint is outside the fences or touches a reserved area.
local function checkClear(label: string, r: Rect, allowFanZones: boolean?)
	local inner = Layout.INNER_HALF
	if r.minX < -inner or r.maxX > inner or r.minZ < -inner or r.maxZ > inner then
		warn(string.format("[Decor] %s at (%.1f, %.1f) pokes past the fences", label, (r.minX + r.maxX) / 2, (r.minZ + r.maxZ) / 2))
	end
	for _, area in blockedAreas() do
		if not (allowFanZones and string.sub(area.name, 1, 8) == "fan zone") and Layout.overlaps(r, area.rect) then
			warn(
				string.format("[Decor] %s at (%.1f, %.1f) overlaps the %s", label, (r.minX + r.maxX) / 2, (r.minZ + r.maxZ) / 2, area.name)
			)
		end
	end
end

-- Props ---------------------------------------------------------------------------------

-- Entrance props keep at least this far off the plot's centre line (x = 0).
local ENTRANCE_CLEAR = 15

-- Half extents (prop-local X, Z) of each prop's floor footprint, at scale 1.
local FOOTPRINT: { [string]: Vector2 } = {
	DumbbellRack = Vector2.new(3.6, 1.3),
	Barbell = Vector2.new(3.5, 1.1),
	Bench = Vector2.new(1.9, 2.9),
	Treadmill = Vector2.new(1.4, 2.7),
	PunchBag = Vector2.new(2.1, 1.2),
	WaterCooler = Vector2.new(0.8, 1.2),
	PalmPlanter = Vector2.new(1.6, 1.6),
	Speaker = Vector2.new(1.0, 0.9),
}

local function dumbbellParts(k: Kit, frame: CFrame, tint: Color3, d: number)
	local length = d * 1.5
	cyl(k, "DumbbellBar", length, d * 0.32, frame, color("Chrome"))
	for _, side in { -1, 1 } do
		cyl(k, "DumbbellHead", d * 0.45, d, frame * CFrame.new(side * length * 0.36, 0, 0), tint)
	end
end

local PROP_BUILDERS: { [string]: (k: Kit, tint: Color3) -> () } = {}

-- Two-tier rack holding six candy dumbbells, front along -Z.
PROP_BUILDERS.DumbbellRack = function(k, tint)
	for _, side in { -1, 1 } do
		block(k, "RackEnd", Vector3.new(0.6, 2.4, 2.4), at(side * 3.2, 1.2, 0), tint)
	end
	block(k, "RackTray", Vector3.new(6, 0.35, 1.15), at(0, 0.9, -0.55), color("White"))
	block(k, "RackTray", Vector3.new(6, 0.35, 1.15), at(0, 1.85, 0.55), color("White"))
	local lower = { color("Pink"), color("Sunny"), color("Mint") }
	local upper = { color("Blue"), color("Grape"), color("Coral") }
	for i, x in { -1.9, 0, 1.9 } do
		dumbbellParts(k, at(x, 1.075 + 0.4, -0.55) * ALONG_Z, lower[i], 0.8)
		dumbbellParts(k, at(x, 2.025 + 0.4, 0.55) * ALONG_Z, upper[i], 0.8)
	end
end

-- Barbell along X; its base centre is under the plates.
PROP_BUILDERS.Barbell = function(k, tint)
	cyl(k, "BarbellBar", 7, 0.3, at(0, 1.1, 0), color("Chrome"))
	for _, side in { -1, 1 } do
		cyl(k, "Plate", 0.45, 2.2, at(side * 2.75, 1.1, 0), tint)
		cyl(k, "Plate", 0.35, 1.6, at(side * 2.35, 1.1, 0), tint:Lerp(WHITE, 0.35))
		cyl(k, "Collar", 0.3, 0.55, at(side * 3.15, 1.1, 0), color("Chrome"))
	end
end

-- Flat bench with a padded top and a barbell rack at its +Z end.
PROP_BUILDERS.Bench = function(k, tint)
	block(k, "BenchPad", Vector3.new(1.6, 0.55, 4.4), at(0, 1.55, -0.3), tint, Enum.Material.Fabric)
	block(k, "BenchLeg", Vector3.new(1.4, 1.3, 0.5), at(0, 0.65, -2), color("White"))
	block(k, "BenchLeg", Vector3.new(1.4, 1.3, 0.5), at(0, 0.65, 1.4), color("White"))
	block(k, "RackBase", Vector3.new(3.8, 0.35, 0.8), at(0, 0.175, 2.4), color("White"))
	for _, side in { -1, 1 } do
		block(k, "RackPost", Vector3.new(0.45, 4, 0.45), at(side * 1.6, 2, 2.4), color("Blue"))
		block(k, "RackHook", Vector3.new(0.45, 0.3, 0.7), at(side * 1.6, 3.4, 2.05), color("Sunny"))
	end
end

-- Treadmill with its console at the -Z end (the runner faces -Z).
PROP_BUILDERS.Treadmill = function(k, tint)
	block(k, "TreadmillDeck", Vector3.new(2.6, 0.5, 5), at(0, 0.25, 0.2), color("White"))
	block(k, "TreadmillBelt", Vector3.new(2, 0.1, 4.2), at(0, 0.55, 0.5), color("Ink"))
	cyl(k, "TreadmillHood", 2.6, 0.9, at(0, 0.45, -2.15), tint)
	for _, side in { -1, 1 } do
		block(k, "TreadmillPost", Vector3.new(0.3, 3, 0.3), at(side * 1.15, 1.9, -2.2), color("White"))
		block(k, "TreadmillRail", Vector3.new(0.3, 0.3, 1.6), at(side * 1.15, 3.1, -1.5), color("White"))
	end
	block(k, "TreadmillConsole", Vector3.new(2.6, 0.9, 0.6), at(0, 3.55, -2.25) * CFrame.Angles(math.rad(-30), 0, 0), tint)
end

-- Free-standing punching bag: the bag hangs at -X, its stand post at +X.
PROP_BUILDERS.PunchBag = function(k, tint)
	cyl(k, "BagStandBase", 0.4, 2.4, at(0.9, 0.2, 0) * UPRIGHT, color("White"))
	block(k, "BagStandPost", Vector3.new(0.5, 6.8, 0.5), at(0.9, 3.6, 0), color("White"))
	block(k, "BagStandArm", Vector3.new(2.3, 0.45, 0.45), at(-0.05, 6.75, 0), color("White"))
	cyl(k, "BagChain", 0.6, 0.2, at(-0.9, 6.25, 0) * UPRIGHT, color("Chrome"))
	ball(k, "BagTop", 2.2, at(-0.9, 4.9, 0), tint, Enum.Material.Fabric)
	cyl(k, "Bag", 2.8, 2.2, at(-0.9, 3.5, 0) * UPRIGHT, tint, Enum.Material.Fabric)
	ball(k, "BagBottom", 2.2, at(-0.9, 2.1, 0), tint, Enum.Material.Fabric)
	cyl(k, "BagBand", 0.5, 2.3, at(-0.9, 4.3, 0) * UPRIGHT, color("Sunny"))
end

-- Water cooler with its taps on the -Z face.
PROP_BUILDERS.WaterCooler = function(k, tint)
	block(k, "CoolerBody", Vector3.new(1.5, 2.6, 1.5), at(0, 1.3, 0), color("White"))
	block(k, "CoolerBand", Vector3.new(1.56, 0.35, 1.56), at(0, 2.35, 0), tint)
	cyl(k, "CoolerTop", 0.2, 1.4, at(0, 2.7, 0) * UPRIGHT, color("White"))
	local bottle = cyl(k, "CoolerBottle", 1.5, 1.3, at(0, 3.55, 0) * UPRIGHT, color("Pool"))
	local dome = ball(k, "CoolerBottle", 1.3, at(0, 4.3, 0), color("Pool"))
	bottle.Transparency = 0.1
	dome.Transparency = 0.1
	block(k, "CoolerTap", Vector3.new(0.3, 0.3, 0.4), at(-0.35, 1.9, -0.85), color("Coral"))
	block(k, "CoolerTap", Vector3.new(0.3, 0.3, 0.4), at(0.35, 1.9, -0.85), color("Blue"))
	block(k, "CoolerTray", Vector3.new(1, 0.15, 0.5), at(0, 1.15, -0.95), color("Steel"))
end

-- Potted palm with a gently curving trunk; only the pot blocks the player.
PROP_BUILDERS.PalmPlanter = function(k, tint)
	cyl(k, "PalmPot", 2, 2.8, at(0, 1, 0) * UPRIGHT, tint)
	cyl(k, "PalmPotRim", 0.5, 3.2, at(0, 2.1, 0) * UPRIGHT, color("White"))
	cyl(k, "PalmSoil", 0.2, 2.6, at(0, 2.3, 0) * UPRIGHT, color("WoodDark"))
	local trunk = {
		Vector3.new(0, 2.2, 0),
		Vector3.new(0.15, 4.1, 0),
		Vector3.new(0.45, 5.9, 0),
		Vector3.new(0.95, 7.6, 0),
	}
	for i = 1, 3 do
		local a, b = trunk[i], trunk[i + 1]
		local d = 0.95 - i * 0.1
		local frame = between(a, b)
		cyl(k, "PalmTrunk", (b - a).Magnitude + 0.25, d, frame, color("Wood")).CanCollide = false
	end
	local top = trunk[4]
	ball(k, "PalmCrown", 1.3, CFrame.new(top), color("GrassDark")).CanCollide = false
	for _, offset in { Vector3.new(0.4, -0.5, -0.35), Vector3.new(-0.35, -0.55, -0.3) } do
		ball(k, "Coconut", 0.65, CFrame.new(top + offset), color("WoodDark")).CanCollide = false
	end
	for i = 1, 7 do
		local yaw = math.rad(i * 360 / 7 + 10)
		local droop = math.rad(if i % 2 == 0 then 34 else 24)
		local frame = CFrame.new(top) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-droop, 0, 0) * CFrame.new(0, 0, -2)
		block(k, "PalmFrond", Vector3.new(1.4, 0.3, 4.4), frame, color(if i % 2 == 0 then "Grass" else "GrassDark")).CanCollide = false
	end
end

-- Party speaker on a low stand, cones on the -Z face.
PROP_BUILDERS.Speaker = function(k, tint)
	block(k, "SpeakerStand", Vector3.new(2, 0.3, 1.7), at(0, 0.15, 0), color("White"))
	block(k, "SpeakerBox", Vector3.new(1.8, 3.2, 1.5), at(0, 1.9, 0), tint)
	cyl(k, "SpeakerRim", 0.2, 1.4, at(0, 1.35, -0.76) * ALONG_Z, color("White"))
	cyl(k, "SpeakerCone", 0.22, 1, at(0, 1.35, -0.78) * ALONG_Z, color("Steel"))
	cyl(k, "SpeakerCap", 0.24, 0.4, at(0, 1.35, -0.8) * ALONG_Z, color("Sunny"))
	cyl(k, "SpeakerRim", 0.2, 0.8, at(0, 2.8, -0.76) * ALONG_Z, color("White"))
	cyl(k, "SpeakerTweeter", 0.22, 0.45, at(0, 2.8, -0.78) * ALONG_Z, color("Sunny"))
end

-- Props that block the player; the rest are small and walk-through.
local SOLID = {
	DumbbellRack = true,
	Bench = true,
	Treadmill = true,
	PunchBag = true,
	WaterCooler = true,
	PalmPlanter = true,
	Speaker = true,
}

export type PropOptions = { y: number?, scale: number?, tint: Color3? }

-- Builds Prop_<kind> standing at plot-local (x, y, z) whose front (-Z) is turned by `yaw`
-- degrees: 0 faces the entrance (-Z), 180 the back fence, 90 faces -X and -90 faces +X.
local function placeProp(B: Builder, parent: Instance, kind: string, x: number, z: number, yaw: number, options: PropOptions?): Model
	local opts: PropOptions = options or {}
	local scale = opts.scale or 1
	local y = opts.y or 0
	local foot = FOOTPRINT[kind] * scale
	local r = math.rad(yaw)
	local ex = math.abs(math.cos(r)) * foot.X + math.abs(math.sin(r)) * foot.Y
	local ez = math.abs(math.sin(r)) * foot.X + math.abs(math.cos(r)) * foot.Y
	checkClear("Prop_" .. kind, Layout.rect(x - ex, x + ex, z - ez, z + ez))

	local model = Instance.new("Model")
	model.Name = "Prop_" .. kind
	model:SetAttribute("Mesh", kind)
	model:SetAttribute("Scale", scale)
	-- The gym meshes are authored at the part-built size (World.Props).
	model:SetAttribute("MeshScale", scale)
	local base = CFrame.new(x, y, z) * CFrame.Angles(0, r, 0)
	local root = B.P({
		Name = "PropRoot",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = B.L(x, y, z) * CFrame.Angles(0, r, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	model.PrimaryPart = root
	local kit: Kit = {
		B = B,
		parent = model,
		base = B.cf * base,
		scale = scale,
		solid = SOLID[kind] == true,
	}
	PROP_BUILDERS[kind](kit, opts.tint or color("Pink"))
	model.Parent = parent
	return model
end

-- Floor paint -------------------------------------------------------------------------------

-- Everything painted on the floor is a thin walk-through part. Each layer has its own height
-- (its top surface above the floor, at most 0.12) so overlapping layers never z-fight; the
-- fence band (World.Shell "FloorBorder") lies at 0.04, between the kerbs and the paths.
local PAINT_THICK = 0.04
local KERB_TOP = 0.02
local PATH_TOP = 0.06
local LINE_TOP = 0.08
local COURT_TOP = 0.1
local MARK_TOP = 0.12

local function paintPart(B: Builder, parent: Instance, props: { [string]: any }): BasePart
	props.Parent = parent
	props.CanCollide = false
	local p = B.P(props)
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

-- A flat strip covering plot-local rect `r` with its top at `top`.
local function paintRect(B: Builder, parent: Instance, name: string, r: Rect, top: number, tint: Color3): BasePart
	return paintPart(B, parent, {
		Name = name,
		Size = Vector3.new(r.maxX - r.minX, PAINT_THICK, r.maxZ - r.minZ),
		CFrame = B.L((r.minX + r.maxX) / 2, top - PAINT_THICK / 2, (r.minZ + r.maxZ) / 2),
		Color = tint,
	})
end

-- A flat disc of `radius` centred on plot-local (x, z).
local function paintDisc(
	B: Builder,
	parent: Instance,
	name: string,
	x: number,
	z: number,
	radius: number,
	top: number,
	tint: Color3
): BasePart
	return paintPart(B, parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(PAINT_THICK, radius * 2, radius * 2),
		CFrame = B.L(x, top - PAINT_THICK / 2, z) * UPRIGHT,
		Color = tint,
	})
end

-- A rounded rectangle: two crossed strips plus a disc in each corner (like a pad's base).
local function paintRounded(B: Builder, parent: Instance, name: string, r: Rect, radius: number, top: number, tint: Color3)
	paintRect(B, parent, name, Layout.rect(r.minX, r.maxX, r.minZ + radius, r.maxZ - radius), top, tint)
	paintRect(B, parent, name, Layout.rect(r.minX + radius, r.maxX - radius, r.minZ, r.maxZ), top, tint)
	for _, x in { r.minX + radius, r.maxX - radius } do
		for _, z in { r.minZ + radius, r.maxZ - radius } do
			paintDisc(B, parent, name, x, z, radius, top, tint)
		end
	end
end

-- Width of the white line round a court or mat, and a court's corner radius.
local COURT_LINE = Layout.COURT_LINE
local COURT_CORNER = 3

-- A painted court covering `r`: a rounded mat with a white border line.
local function paintCourt(B: Builder, parent: Instance, r: Rect, tint: Color3)
	local i = COURT_LINE
	paintRounded(B, parent, "CourtLine", r, COURT_CORNER, LINE_TOP, color("White"))
	paintRounded(B, parent, "Court", Layout.rect(r.minX + i, r.maxX - i, r.minZ + i, r.maxZ - i), COURT_CORNER - i, COURT_TOP, tint)
end

-- A round painted mat of `radius` with the same white border line.
local function paintRoundCourt(B: Builder, parent: Instance, name: string, x: number, z: number, radius: number, tint: Color3)
	paintDisc(B, parent, name .. "Line", x, z, radius, LINE_TOP, color("White"))
	paintDisc(B, parent, name, x, z, radius - COURT_LINE, COURT_TOP, tint)
end

-- One flat chevron with its tip at plot-local (tipX, tipZ), pointing along (dirX, dirZ) (a
-- unit vector), painted on top of everything else.
local function chevron(B: Builder, parent: Instance, tipX: number, tipZ: number, dirX: number, dirZ: number, tint: Color3)
	local spread, depth = 1.7, 1.3
	local y = MARK_TOP - PAINT_THICK / 2
	local tip = Vector3.new(tipX, y, tipZ)
	for _, side in { -1, 1 } do
		local tail = tip - Vector3.new(dirX, 0, dirZ) * depth + Vector3.new(-dirZ, 0, dirX) * side * spread
		local length = (tip - tail).Magnitude + 0.3
		paintPart(B, parent, {
			Name = "PathChevron",
			Size = Vector3.new(0.6, PAINT_THICK, length),
			CFrame = B.cf * CFrame.lookAt((tip + tail) / 2, tip),
			Color = tint,
		})
	end
end

-- A court's fill: a palette colour taken a little toward cream, so it stays clearly coloured
-- against the honey sand while the pads (in their own brighter colours, dark rims) still pop.
local function courtTint(key: string, mix: number): Color3
	return color(key):Lerp(color("Cream"), mix)
end

-- Plot-local Z of the two lines that split a side court into its three station bays: half-way
-- between the pad bases of neighbouring stations on the -X court (the +X stations mirror them).
local function bayLines(): (number, number)
	local pads = Layout.PADS
	local function rim(name: string): Rect
		return Layout.padRect(pads[name], Layout.PAD_RIM)
	end
	return (rim("Deposit").minZ + rim("ProcUp10").maxZ) / 2, (rim("ProcUp1").minZ + rim("Collect").maxZ) / 2
end

-- The painted courts (Layout.COURTS): sunny yellow under the buy row, coral under the crate
-- stations, teal under the aura -> cash stations and a round orange one under the merge pad.
-- White lines across the side courts split them into one bay per station.
local function buildCourts(B: Builder, parent: Instance)
	local courts = Layout.COURTS
	paintCourt(B, parent, courts.Buy, courtTint("Sunny", 0.12))
	paintCourt(B, parent, courts.Crates, courtTint("Coral", 0.3))
	paintCourt(B, parent, courts.Cash, courtTint("Teal", 0.22))
	local merge = Layout.MERGE_COURT
	paintRoundCourt(B, parent, "MergeCourt", merge.x, merge.z, merge.radius, courtTint("Orange", 0.15))

	local backBay, frontBay = bayLines()
	local inset = 2
	for _, r in { courts.Cash, courts.Crates } do
		for _, z in { backBay, frontBay } do
			paintRect(B, parent, "CourtBayLine", Layout.rect(r.minX + inset, r.maxX - inset, z - 0.25, z + 0.25), MARK_TOP, color("White"))
		end
	end
	-- The loop's last leg, down the court to the collect pad: two chevrons either side of the
	-- front bay line.
	for _, tipZ in { frontBay + 1.5, frontBay - 2.1 } do
		chevron(B, parent, Layout.PADS.Collect.x, tipZ, 0, -1, color("White"))
	end
end

-- Paths -------------------------------------------------------------------------------------

-- The cream path with a thin teal kerb: a wide stem from the entrance to the plaza along the
-- pen's front (Layout.PLAZA), which joins both side courts with the merge court on the
-- junction. Chevrons show the way: up the stem to the merge pad, then out along the plaza to
-- the deposit pad (-X) and the crate stations (+X).
local function buildPath(B: Builder, parent: Instance)
	-- Wider than the walkway PlotLayout keeps clear: the floor either side of it is open too.
	local half = Layout.WALKWAY.maxX + 1.5
	local plaza = Layout.PLAZA
	local kerb = 0.45
	-- The plaza's ends run a little way under the side courts' border lines.
	local tuck = 0.3
	local cream, edge = color("Cream"), color("Teal")
	paintRect(B, parent, "PathKerb", Layout.rect(-half - kerb, half + kerb, -Layout.INNER_HALF, plaza.minZ - kerb), KERB_TOP, edge)
	paintRect(B, parent, "PathStrip", Layout.rect(-half, half, -Layout.PLOT_HALF, plaza.minZ), PATH_TOP, cream)
	paintRect(
		B,
		parent,
		"PathKerb",
		Layout.rect(plaza.minX - tuck, plaza.maxX + tuck, plaza.minZ - kerb, plaza.maxZ + kerb),
		KERB_TOP,
		edge
	)
	paintRect(B, parent, "PathStrip", Layout.rect(plaza.minX - tuck, plaza.maxX + tuck, plaza.minZ, plaza.maxZ), PATH_TOP, cream)

	-- Three chevrons up the stem, evenly spaced from the entrance to the merge court.
	local mark = color("TealLight")
	local stemEnd = Layout.MERGE_COURT.z - Layout.MERGE_COURT.radius
	local step = (stemEnd + Layout.INNER_HALF) / 4
	for i = 1, 3 do
		chevron(B, parent, 0, -Layout.INNER_HALF + i * step, 0, 1, mark)
	end
	local plazaZ = (plaza.minZ + plaza.maxZ) / 2
	for _, side in { -1, 1 } do
		for _, reach in { 2, 5.5 } do
			chevron(B, parent, side * (plaza.maxX - reach), plazaZ, side, 0, mark)
		end
	end
end

-- Gym dressing ------------------------------------------------------------------------------

-- A teal floor mat (walk-over, plot-local centre and size).
local function floorMat(B: Builder, parent: Instance, x: number, z: number, sx: number, sz: number, tint: Color3)
	local r = Layout.rect(x - sx / 2, x + sx / 2, z - sz / 2, z + sz / 2)
	checkClear("GymMat", r)
	paintRect(B, parent, "GymMat", r, COURT_TOP, tint)
end

-- A little symmetric dressing in the areas the courts leave free; the Blender meshes
-- (World.Props) carry their own colours, the tints paint the part-built fallbacks.
local function buildGymProps(B: Builder, parent: Instance)
	-- Front fence: a palm each side of the entrance, at least ENTRANCE_CLEAR studs off the
	-- centre line so the view up the path to the pen stays open.
	local fenceZ = -Layout.INNER_HALF + 2.4
	for _, side in { 1, -1 } do
		placeProp(B, parent, "PalmPlanter", side * (ENTRANCE_CLEAR + 3), fenceZ, side * 20, { tint = color("Sunny") })
	end

	-- By each side fence: one palm in the machine line, on the bay line between the back and
	-- middle stations, leaning in toward the pen.
	local backBay = bayLines()
	for _, side in { 1, -1 } do
		placeProp(B, parent, "PalmPlanter", side * 42.5, backBay, 90 + side * 90, { tint = color("Sunny") })
	end
end

-- Interactive props -----------------------------------------------------------------------

-- An invisible walk-through marker for Client.Fx.Interactive at world frame `cframe`.
local function marker(B: Builder, parent: Instance, name: string, cframe: CFrame, size: Vector3?): BasePart
	local p = B.P({
		Name = name,
		Size = size or Vector3.new(0.2, 0.2, 0.2),
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		Parent = parent,
	})
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

-- Prompts reach about a mat's width: tap on touch, E on a keyboard, X on a gamepad.
local PROMPT_RANGE = 8

local function prompt(parent: BasePart, name: string, action: string, object: string): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Name = name
	p.ActionText = action
	p.ObjectText = object
	p.MaxActivationDistance = PROMPT_RANGE
	p.HoldDuration = 0
	-- The markers sit inside the props' colliders.
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.Parent = parent
	return p
end

-- Round trampoline, about 7 studs wide: a teal frame on six short legs round a coral bounce pad.
local function buildTrampoline(k: Kit)
	for i = 1, 6 do
		local a = math.rad(i * 60)
		cyl(k, "TrampolineLeg", 0.8, 0.5, at(math.cos(a) * 3, 0.4, math.sin(a) * 3) * UPRIGHT, color("White"))
	end
	cyl(k, "TrampolineFrame", 0.5, 7, at(0, 1.05, 0) * UPRIGHT, color("Teal"))
	cyl(k, "TrampolineSprings", 0.5, 6, at(0, 1.07, 0) * UPRIGHT, color("Cream"))
	cyl(k, "TrampolinePad", 0.5, 5.2, at(0, 1.09, 0) * UPRIGHT, color("Coral"))
end

-- Winner's podium, front along -Z: three cream steps (1st in the middle, 2nd at -X, 3rd at +X)
-- with coloured tops and their place printed on the front.
local function buildFlexPodium(k: Kit)
	local steps = {
		{ place = "1", x = 0, height = 2.2, tint = color("Sunny") },
		{ place = "2", x = -2.4, height = 1.5, tint = color("TealLight") },
		{ place = "3", x = 2.4, height = 0.9, tint = color("Coral") },
	}
	for _, step in steps do
		local body =
			block(k, "PodiumStep", Vector3.new(2.4, step.height - 0.25, 2.6), at(step.x, (step.height - 0.25) / 2, 0), color("Cream"))
		block(k, "PodiumTop", Vector3.new(2.4, 0.25, 2.6), at(step.x, step.height - 0.125, 0), step.tint)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 1
		gui.MaxDistance = Common.SIGN_FADE_CARD
		gui.Parent = body
		local place = Instance.new("TextLabel")
		place.BackgroundTransparency = 1
		place.Size = UDim2.fromScale(1, 1)
		place.Font = theme.Fonts.Display
		place.TextScaled = true
		place.TextColor3 = color("TealInk")
		place.Text = step.place
		place.Parent = gui
	end
end

-- Starts Interactive_<kind> (attribute Interactive = `use`) at the spot Layout.INTERACTIVE gives
-- it, on a round sunny mat (or, with `mat`, a teal rectangle of that size); the caller adds the
-- prop and its markers. Client.Fx.Interactive brings it to life.
local function interactive(B: Builder, parent: Instance, kind: string, use: string, mat: Vector2?): (Model, number, number)
	local spot = Layout.INTERACTIVE[kind]
	local x, z, radius = spot.x, spot.z, spot.radius
	checkClear("Interactive_" .. kind, Layout.rect(x - radius, x + radius, z - radius, z + radius))
	local model = Instance.new("Model")
	model.Name = "Interactive_" .. kind
	model:SetAttribute("Interactive", use)
	if mat then
		floorMat(B, model, x, z, mat.X, mat.Y, color("Mat"))
	else
		paintRoundCourt(B, model, "InteractiveMat", x, z, radius, color("Sunny"))
	end
	model.Parent = parent
	return model, x, z
end

-- Where a lifter lies, in the bench prop's frame (base centre, rack at +Z): flat on the pad,
-- head toward the rack. The seat's frame is the lifter's root frame: up axis along the bench,
-- front facing the sky.
local BENCH_LIE = CFrame.new(0, 2.4, -0.2) * CFrame.Angles(math.rad(90), 0, 0)

-- Puts the lifter's root exactly onto the bench seat (a Seat's own weld would sit them up on it).
local function lieFlat(seat: Seat)
	local weld = seat:FindFirstChild("SeatWeld")
	if weld and weld:IsA("Weld") then
		weld.C0 = CFrame.identity
		weld.C1 = CFrame.identity
	end
end

-- Lets `humanoid` go from the bench seat it is welded to.
local function releaseSeat(seat: Seat, humanoid: Humanoid)
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Sit = false
end

-- The bench press: one lifter at a time lies on BenchSeat (the client poses and animates them).
-- The prompt seats whoever triggers it while the bench is free and lets its own lifter go.
local function buildBench(B: Builder, model: Model, x: number, z: number)
	-- The rack stands toward the fence, the barbell resting on its hooks.
	local bench = placeProp(B, model, "Bench", x, z + 0.5, 180, { tint = color("Coral") })
	placeProp(B, model, "Barbell", x, z - 1.7, 0, { y = 2.6, tint = color("Sunny") })
	local base = (bench.PrimaryPart :: BasePart).CFrame

	local seat = Common.make("Seat", {
		Name = "BenchSeat",
		Size = Vector3.new(1.6, 0.2, 0.6),
		CFrame = base * BENCH_LIE,
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	}) :: Seat
	-- Nobody sits by walking into it: only the prompt seats.
	seat.CanTouch = false
	seat.CanQuery = false
	seat.CastShadow = false
	marker(B, model, "StandSpot", base * CFrame.new(3, 0.1, -0.3))
	local lift = prompt(marker(B, model, "LiftAnchor", base * CFrame.new(0, 2.6, -0.3)), "LiftPrompt", "Lift", "Bench")

	-- pcall: the offline preview (Lune) has no instance signals.
	pcall(function()
		seat.ChildAdded:Connect(function()
			lieFlat(seat)
			task.defer(lieFlat, seat)
		end)
		lift.Triggered:Connect(function(player: Player)
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then
				return
			end
			local lifter = seat.Occupant
			if lifter == humanoid then
				releaseSeat(seat, humanoid)
			elseif lifter == nil and humanoid.SeatPart == nil then
				seat:Sit(humanoid)
				lieFlat(seat)
			end
		end)
	end)
end

-- The four props along the front fence: a trampoline in the +X corner with a punch bag beside
-- it, a bench press mirroring the bag at -X, and a flex podium in the -X corner turned toward
-- the display rack the fans cheer at.
local function buildInteractive(B: Builder, parent: Instance)
	local trampoline, tx, tz = interactive(B, parent, "Trampoline", "trampoline")
	buildTrampoline({ B = B, parent = trampoline, base = B.L(tx, 0, tz), scale = 1, solid = true })
	-- The bounce pad's top centre; standing a little onto the frame still bounces.
	marker(B, trampoline, "BounceAnchor", B.L(tx, 1.34, tz)):SetAttribute("Radius", 2.9)

	-- The bag hangs on the plot side of its post.
	local punchBag, bx, bz = interactive(B, parent, "PunchBag", "punchbag")
	local bag = placeProp(B, punchBag, "PunchBag", bx, bz - 0.6, 90, { tint = color("RedOrange") })
	local bagBase = (bag.PrimaryPart :: BasePart).CFrame
	marker(B, punchBag, "BagPivot", bagBase * CFrame.new(-0.9, 6.5, 0))
	-- A little wider than the bag's collider, so running into the bag reaches it.
	local hitZone = marker(B, punchBag, "HitZone", bagBase * CFrame.new(-0.9, 3.5, 0), Vector3.new(4.2, 5.4, 4.4))
	prompt(hitZone, "PunchPrompt", "Punch", "Punch bag")

	local bench, benchX, benchZ = interactive(B, parent, "Bench", "bench", Vector2.new(8, 7.4))
	buildBench(B, bench, benchX, benchZ)

	local podium, px, pz = interactive(B, parent, "FlexPodium", "podium")
	local facing = math.atan2(px - Layout.FAN_FOCUS.x, pz - Layout.FAN_FOCUS.z)
	buildFlexPodium({ B = B, parent = podium, base = B.L(px, 0, pz) * CFrame.Angles(0, facing, 0), scale = 1, solid = true })
end

-- Fan zones -------------------------------------------------------------------------------

local function buildFanSpots(B: Builder)
	local folder = Instance.new("Folder")
	folder.Name = "FanSpots"
	for i, spot in Layout.fanSpots() do
		-- The fan runs in from the back of its own zone column (and walks off there), so it
		-- never crosses the rack and joins the crowd from behind the fans already standing.
		local backZ = spot.z
		for _, zone in Layout.FAN_ZONES do
			if Layout.contains(zone.rect, spot.x, spot.z) then
				backZ = math.min(zone.rect.maxZ + 0.5, Layout.INNER_HALF - 0.5)
			end
		end
		local yaw = math.atan2(-spot.faceX, -spot.faceZ)
		local p = B.P({
			Name = "FanSpot",
			Size = Vector3.new(1, 1, 1),
			CFrame = B.L(spot.x, 0, spot.z) * CFrame.Angles(0, yaw, 0),
			Transparency = 1,
			CanCollide = false,
			Parent = folder,
		})
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p:SetAttribute("Order", i)
		p:SetAttribute("Entrance", B.L(spot.x, 0, backZ).Position)
	end
	folder.Parent = B.folder
end

-- A teal post carrying one end of the "FAN ZONE" card, with a sunny knob on top.
local function cardPost(k: Kit, x: number, z: number, height: number)
	cyl(k, "FanCardPost", height, 0.6, at(x, height / 2, z) * UPRIGHT, color("Teal"))
	ball(k, "FanCardKnob", 0.85, at(x, height + 0.15, z), color("Sunny"))
end

local function heartCutout(k: Kit, frame: CFrame, size: number, thick: number, tint: Color3)
	block(k, "Heart", Vector3.new(size, size, thick), frame * CFrame.Angles(0, 0, math.rad(45)), tint)
	local o = size / (2 * math.sqrt(2))
	for _, side in { -1, 1 } do
		cyl(k, "Heart", thick, size, frame * CFrame.new(side * o, o, 0) * ALONG_Z, tint)
	end
end

-- Five-pointed star in the frame's XY plane (tip up): a core disc plus two wedges per point.
local function starCutout(k: Kit, frame: CFrame, outer: number, inner: number, thick: number, tint: Color3)
	cyl(k, "Star", thick, inner * 2, frame * ALONG_Z, tint)
	local c36, s36 = math.cos(math.rad(36)), math.sin(math.rad(36))
	local h, d = outer - inner * c36, inner * s36
	for i = 0, 4 do
		local a = math.rad(90 + i * 72)
		local u = Vector3.new(math.cos(a), math.sin(a), 0)
		local mid = u * inner * c36
		for _, side in { -1, 1 } do
			local p = Vector3.new(-u.Y, u.X, 0) * side
			local zAxis = -p
			wedge(
				k,
				"Star",
				Vector3.new(thick, h, d),
				frame * CFrame.fromMatrix(mid + u * (h / 2) + p * (d / 2), u:Cross(zAxis), u, zAxis),
				tint
			)
		end
	end
end

-- A heart or star cut-out on a stick standing at plot-local (x, baseY, z), facing `yaw`.
local function cutoutSign(B: Builder, parent: Instance, kind: string, x: number, baseY: number, z: number, yaw: number)
	local k: Kit = {
		B = B,
		parent = parent,
		base = B.L(x, baseY, z) * CFrame.Angles(0, yaw, 0),
		scale = 1,
		solid = false,
	}
	local stick = 1.1
	block(k, "SignStick", Vector3.new(0.25, stick + 0.4, 0.25), at(0, (stick + 0.4) / 2, 0), color("White"))
	if kind == "Heart" then
		local size = 1.3
		heartCutout(k, at(0, stick + size / math.sqrt(2), 0), size, 0.3, color("Pink"))
	else
		local outer = 1
		starCutout(k, at(0, stick + outer * 0.81, 0), outer, 0.42, 0.3, color("Sunny"))
	end
end

local function fanCard(B: Builder, parent: Instance, x: number, y: number, z: number, width: number)
	local card = B.P({
		Name = "FanZoneCard",
		Size = Vector3.new(width, 1.9, 0.3),
		CFrame = B.L(x, y, z),
		Color = color("Teal"),
		CanCollide = false,
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.MaxDistance = Common.SIGN_FADE_CARD
	gui.Parent = card
	local face = Instance.new("Frame")
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.new(1, -12, 1, -12)
	face.BackgroundColor3 = color("Cream")
	face.BorderSizePixel = 0
	face.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 18)
	corner.Parent = face
	local border = Instance.new("UIStroke")
	border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	border.Color = color("Teal")
	border.Thickness = 4
	border.Parent = face
	local band = Instance.new("Frame")
	band.Size = UDim2.new(1, 0, 0.2, 0)
	band.BackgroundColor3 = color("Sunny")
	band.BorderSizePixel = 0
	band.Parent = face
	local bandCorner = Instance.new("UICorner")
	bandCorner.CornerRadius = UDim.new(0, 18)
	bandCorner.Parent = band
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.AnchorPoint = Vector2.new(0.5, 0)
	text.Position = UDim2.fromScale(0.5, 0.24)
	text.Size = UDim2.fromScale(0.9, 0.68)
	text.Font = theme.Fonts.Display
	text.TextScaled = true
	text.TextColor3 = color("Ink")
	text.Text = "FAN ZONE"
	text.Parent = face
end

-- Dressing for the fan zone on `side` (+1 = +X, -1 = -X): the "FAN ZONE" card on two teal
-- posts across its front edge, a 2-step bleacher in front of it and two cut-out signs on the
-- bleacher. The display side stays open.
local function dressFanZone(B: Builder, parent: Instance, side: number)
	local zone: Rect? = nil
	for _, fanZone in Layout.FAN_ZONES do
		if fanZone.side == side then
			zone = fanZone.rect
		end
	end
	if not zone then
		return
	end
	local innerX = if side > 0 then zone.minX else zone.maxX
	local frontZ = zone.minZ - 0.1
	local k: Kit = { B = B, parent = parent, base = B.cf, scale = 1, solid = true }

	-- "FAN ZONE" card across the zone's front, between a post just off each of its sides.
	local cardHeight = 6.9
	local cardInnerX = innerX - side * 0.35
	local cardOuterX = (if side > 0 then zone.maxX else zone.minX) + side * 0.35
	for _, px in { cardInnerX, cardOuterX } do
		cardPost(k, px, frontZ, cardHeight)
	end
	checkClear("FanCardPost", Layout.rect(cardInnerX - 0.45, cardInnerX + 0.45, frontZ - 0.45, frontZ + 0.45), true)
	fanCard(B, parent, (cardInnerX + cardOuterX) / 2, 5.95, frontZ, math.abs(cardOuterX - cardInnerX) - 0.6)

	-- Bleacher in front of the zone, rising away from the display.
	local z0, z1 = frontZ - 3.6, frontZ - 0.4
	local stepWidth = 2
	for step = 1, 2 do
		local x0 = innerX + side * (0.3 + (step - 1) * stepWidth)
		local cx = x0 + side * stepWidth / 2
		local top = 0.9 * step
		block(k, "BleacherRiser", Vector3.new(stepWidth, top - 0.15, z1 - z0), at(cx, (top - 0.15) / 2, (z0 + z1) / 2), color("Teal"))
		block(k, "BleacherSeat", Vector3.new(stepWidth + 0.1, 0.15, z1 - z0 + 0.2), at(cx, top - 0.075, (z0 + z1) / 2), color("Sunny"))
	end
	local bx0 = innerX + side * 0.3
	local bx1 = bx0 + side * stepWidth * 2
	checkClear("FanBleacher", Layout.rect(math.min(bx0, bx1), math.max(bx0, bx1), z0, z1))

	-- Cut-out signs planted on the bleacher, turned toward the middle of the plot.
	local function facePlotCentre(x: number, z: number): number
		return math.atan2(x, z + 10)
	end
	local heartX = innerX + side * 1.1
	local starX = innerX + side * 3.4
	local signZ = z0 + 0.5
	cutoutSign(B, parent, "Heart", heartX, 0.9, signZ, facePlotCentre(heartX, signZ))
	cutoutSign(B, parent, "Star", starX, 1.8, signZ, facePlotCentre(starX, signZ))
end

local function buildGymDecor(B: Builder)
	local parent = Instance.new("Folder")
	parent.Name = "Decor"
	parent.Parent = B.folder
	buildCourts(B, parent)
	buildPath(B, parent)
	buildGymProps(B, parent)
	buildInteractive(B, parent)
	for _, side in { 1, -1 } do
		dressFanZone(B, parent, side)
	end
	buildFanSpots(B)
end

Decor.buildGymDecor = buildGymDecor

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="201">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--[[
	Hub: lighting, the island world around the map and the central hub plaza.

	Everything stands on one big sand island in an ocean that runs to the horizon, with a few
	low-poly palm islands out at sea. The round plaza in the middle holds a golden Chad statue on
	a trophy podium, the two ranking scoreboards, benches and planters; a pale plank boardwalk
	ring runs between the plaza and the two plot rows and spurs into every plot entrance.
	Hub colours follow the plots: teal posts and frames, sunny caps and rings, and cream sign
	cards with red-orange header bands.

	Every decorative prop is a Model named Prop_<Kind> (attribute Mesh = "<Kind>") whose
	PrimaryPart sits at the prop's base centre and whose front faces -Z; World.Props swaps in the
	uploaded Blender mesh where there is one (the part-built version is the fallback). Sky clouds
	are "Cloud" models so Client.Fx.Ambient can drift them.
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Common = require(script.Parent.Common)
local Props = require(script.Parent.Props)
local ModesCourse = require(script.Parent.Parent.Modes.Course)

local theme = Common.theme
local mapFolder = Common.mapFolder
local PLOT_HALF = Common.PLOT_HALF
local HUB_RADIUS = Common.HUB_RADIUS
local PLOT_SPACING_X = Common.PLOT_SPACING_X
local PLOT_ROW_Z = Common.PLOT_ROW_Z
local CROSS_Z = Common.CROSS_Z
local ENTRANCE_Z = Common.ENTRANCE_Z
local UPRIGHT = Common.UPRIGHT
local ALONG_Z = Common.ALONG_Z
local make = Common.make
local part = Common.part

local W = theme.World
local CYLINDER = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball

-- Sand island: reaches past the far corners of the outer plots with a wide beach.
local ISLAND_RADIUS = math.ceil(math.sqrt((PLOT_SPACING_X + PLOT_HALF) ^ 2 + (PLOT_ROW_Z + PLOT_HALF) ^ 2)) + 22
local SAND_TOP = -0.1
local OCEAN_TOP = -1.2
local OCEAN_TILE = 2048

-- Plaza surface heights (thin stacked discs, each a hair above the one below).
local PLAZA_RIM_TOP = 0.35
local PLAZA_TOP = 0.38
local PLAZA_RING_TOP = 0.41
local PLAZA_INNER_TOP = 0.44
local PLAZA_INNER_RADIUS = 18

-- Boardwalk ring: rows along |z| = CROSS_Z, sides along |x| = RING_X, spurs into every plot
-- entrance and a wide connector from the plaza to each row.
local DECK_TOP = 0.3
local WALK_HALF = 5
local CONNECTOR_HALF = 6
local RING_X = PLOT_SPACING_X + 19
local RING_OUT = RING_X + WALK_HALF

-- Scoreboards stand on the x axis inside the plaza.
local SCOREBOARD_X = 19.5
local ARCH_Z = HUB_RADIUS + 3

local Hub = {}

-- Lighting ------------------------------------------------------------------------------

local function setupLighting()
	local l = theme.Lighting
	Lighting.ClockTime = l.ClockTime
	Lighting.GeographicLatitude = l.GeographicLatitude
	Lighting.Ambient = l.Ambient
	Lighting.OutdoorAmbient = l.OutdoorAmbient
	Lighting.Brightness = l.Brightness
	Lighting.ExposureCompensation = l.Exposure
	Lighting.EnvironmentDiffuseScale = l.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = l.EnvironmentSpecularScale
	Lighting.GlobalShadows = true
	-- Short, crisp afternoon shadows with a warm tint on sunlit faces.
	Lighting.ShadowSoftness = l.ShadowSoftness
	Lighting.ColorShift_Top = l.ColorShiftTop
	Lighting.ColorShift_Bottom = l.ColorShiftBottom
	Lighting.FogColor = l.FogColor
	Lighting.FogStart = l.FogStart
	Lighting.FogEnd = l.FogEnd

	-- A light pale-azure haze low on the sky with a low offset, so the blue skybox pales toward
	-- a crisp horizon line over the turquoise sea; density stays low so distant plots stay crisp.
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Color = l.AtmosphereColor
	atmosphere.Decay = l.AtmosphereDecay
	atmosphere.Density = l.AtmosphereDensity
	atmosphere.Haze = l.AtmosphereHaze
	atmosphere.Glare = l.AtmosphereGlare
	atmosphere.Offset = l.AtmosphereOffset
	atmosphere.Parent = Lighting

	local s = l.Sky
	local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.SkyboxBk = s.Back
	sky.SkyboxFt = s.Front
	sky.SkyboxLf = s.Left
	sky.SkyboxRt = s.Right
	sky.SkyboxDn = s.Down
	sky.SkyboxUp = s.Up
	sky.SunTextureId = s.Sun
	sky.MoonTextureId = s.Moon
	sky.SunAngularSize = s.SunAngularSize
	sky.StarCount = s.StarCount
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	-- Almost no bloom: colour comes from paint, not glow.
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = l.BloomIntensity
	bloom.Threshold = l.BloomThreshold
	bloom.Size = l.BloomSize
	bloom.Parent = Lighting

	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.TintColor = l.ColorTint
	cc.Saturation = l.Saturation
	cc.Contrast = l.Contrast
	cc.Brightness = l.ColorBrightness
	cc.Parent = Lighting

	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	rays.Intensity = l.SunRaysIntensity
	rays.Spread = l.SunRaysSpread
	rays.Parent = Lighting

	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = l.Clouds.Cover
		clouds.Density = l.Clouds.Density
		clouds.Color = l.Clouds.Color
		clouds.Parent = terrain
	end
end

-- Helpers -------------------------------------------------------------------------------

type Adder = (props: { [string]: any }, className: string?) -> BasePart

-- Yaw (about +Y) that turns a frame's front (-Z) from (fromX, fromZ) toward (toX, toZ).
local function yawToward(fromX: number, fromZ: number, toX: number, toZ: number): number
	return math.atan2(-(toX - fromX), -(toZ - fromZ))
end

-- A uniform size (balls must be uniform).
local function cube(d: number): Vector3
	return Vector3.new(d, d, d)
end

local function ground(x: number, z: number, yaw: number?): CFrame
	return CFrame.new(x, 0, z) * CFrame.Angles(0, yaw or 0, 0)
end

-- A Prop_<kind> model rooted at `base` (its base centre). The returned adder builds parts in
-- the prop's own space (props.CFrame is relative to `base`).
local function newProp(kind: string, base: CFrame, name: string?): (Model, Adder)
	local model = Instance.new("Model")
	model.Name = name or ("Prop_" .. kind)
	model:SetAttribute("Mesh", kind)
	local root = part({
		Name = "PropRoot",
		Size = Vector3.new(1, 0.2, 1),
		CFrame = base,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Parent = model,
	})
	model.PrimaryPart = root
	model.Parent = mapFolder
	local function add(props: { [string]: any }, className: string?): BasePart
		props.CFrame = base * (props.CFrame or CFrame.new())
		props.Parent = model
		return make(className or "Part", props)
	end
	return model, add
end

-- A flat world disc whose top face sits at `top`.
local function disc(
	name: string,
	radius: number,
	top: number,
	thickness: number,
	color: Color3,
	x: number?,
	z: number?,
	material: Enum.Material?
)
	return part({
		Name = name,
		Shape = CYLINDER,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(x or 0, top - thickness / 2, z or 0) * UPRIGHT,
		Color = color,
		Material = material,
	})
end

-- A SurfaceGui on one face of `p`, returning a transparent full-size root frame.
local function surface(p: BasePart, face: Enum.NormalId, pixelsPerStud: number): Frame
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Parent = p
	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Parent = gui
	return root
end

local function panel(parent: Instance, color: Color3, position: UDim2, size: UDim2, corner: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.Position = position
	f.Size = size
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(corner or 0.08, 0)
	c.Parent = f
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = theme.Fonts.Display
	l.TextColor3 = W.Ink
	l.Size = UDim2.fromScale(1, 1)
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

-- Props ---------------------------------------------------------------------------------

-- Chunky palm: stacked ring segments that curve gently, a crown of fronds and coconuts.
-- `detailed` adds a drooping tip to every frond (used near the plaza).
local function palmTree(base: CFrame, height: number, lean: number, detailed: boolean)
	local model, add = newProp("PalmTree", base)
	model:SetAttribute("Height", height)
	-- The palm mesh is authored for Height 16.
	model:SetAttribute("MeshScale", height / 16)
	local s = height / 16
	local segments = 4
	local segLength = height / segments
	local frame = CFrame.new()
	for i = 1, segments do
		frame = frame * CFrame.Angles(lean / segments, 0, 0)
		local d = (1.9 - 0.55 * (i - 1) / (segments - 1)) * s
		add({
			Name = "Trunk",
			Shape = CYLINDER,
			Size = Vector3.new(segLength + 0.3 * s, d, d),
			CFrame = frame * CFrame.new(0, segLength / 2, 0) * UPRIGHT,
			Color = if i % 2 == 0 then W.WoodDark else W.Wood,
		})
		frame = frame * CFrame.new(0, segLength, 0)
	end
	local top = CFrame.new(frame.Position)
	add({ Name = "Crown", Shape = BALL, Size = cube(2.2 * s), CFrame = top, Color = W.GrassDark })
	for k = 1, 3 do
		add({
			Name = "Coconut",
			Shape = BALL,
			Size = cube(1.1 * s),
			CFrame = top * CFrame.Angles(0, k * 2.1, 0) * CFrame.new(0, -0.8 * s, -0.75 * s),
			Color = W.WoodDark,
			CanCollide = false,
		})
	end
	local fronds = 7
	for i = 1, fronds do
		local yaw = (i + 0.3) * 2 * math.pi / fronds
		local length = 6.2 * s
		local color = if i % 2 == 0 then W.Grass else W.GrassDark
		local f = top * CFrame.Angles(0, yaw, 0) * CFrame.Angles(if detailed then 0.12 else -0.3, 0, 0)
		add({
			Name = "Frond",
			Size = Vector3.new(2 * s, 0.35 * s, length),
			CFrame = f * CFrame.new(0, 0, -length / 2),
			Color = color,
			CanCollide = false,
		})
		if detailed then
			local tip = 3.8 * s
			add({
				Name = "Frond",
				Size = Vector3.new(1.4 * s, 0.3 * s, tip),
				CFrame = f * CFrame.new(0, 0, -length + 0.2 * s) * CFrame.Angles(-0.75, 0, 0) * CFrame.new(0, 0, -tip / 2),
				Color = color,
				CanCollide = false,
			})
		end
	end
end

-- Low teal post with a sunny ball cap (boardwalk corners and spur mouths).
local function bollard(x: number, z: number)
	local _, add = newProp("Bollard", ground(x, z))
	add({ Name = "BollardPost", Shape = CYLINDER, Size = Vector3.new(2, 1.1, 1.1), CFrame = CFrame.new(0, 1, 0) * UPRIGHT, Color = W.Teal })
	add({ Name = "BollardCap", Shape = BALL, Size = cube(1.5), CFrame = CFrame.new(0, 2.2, 0), Color = W.Sunny })
end

local function bench(base: CFrame)
	local _, add = newProp("HubBench", base)
	add({ Name = "BenchSeat", Size = Vector3.new(5.2, 0.5, 1.8), CFrame = CFrame.new(0, 1.75, 0), Color = W.Wood })
	add({
		Name = "BenchBack",
		Size = Vector3.new(5.2, 1.4, 0.4),
		CFrame = CFrame.new(0, 2.9, 0.85) * CFrame.Angles(0.2, 0, 0),
		Color = W.Wood,
	})
	for _, sx in { -1, 1 } do
		add({ Name = "BenchLeg", Size = Vector3.new(0.6, 1.6, 1.8), CFrame = CFrame.new(sx * 2, 0.8, 0), Color = W.White })
	end
end

local function planter(base: CFrame)
	local _, add = newProp("Planter", base)
	add({ Name = "PlanterBox", Size = Vector3.new(4.6, 1.4, 2.6), CFrame = CFrame.new(0, 0.7, 0), Color = W.Teal })
	for _, sz in { -1, 1 } do
		add({ Name = "PlanterRim", Size = Vector3.new(5, 0.35, 0.4), CFrame = CFrame.new(0, 1.5, sz * 1.3), Color = W.White })
	end
	for _, sx in { -1, 1 } do
		add({ Name = "PlanterRim", Size = Vector3.new(0.4, 0.35, 2.9), CFrame = CFrame.new(sx * 2.3, 1.5, 0), Color = W.White })
	end
	for i, x in { -1.3, 0, 1.3 } do
		add({
			Name = "Bush",
			Shape = BALL,
			Size = cube(if i == 2 then 1.9 else 1.6),
			CFrame = CFrame.new(x, 1.9, 0),
			Color = W.GrassDark,
			CanCollide = false,
		})
	end
	local flowers =
		{ { -1.6, 0.4, W.Pink }, { -0.7, -0.5, W.Sunny }, { 0.3, 0.45, W.Coral }, { 1.1, -0.4, W.Grape }, { 1.7, 0.35, W.Pink } }
	for _, f in flowers do
		add({
			Name = "Flower",
			Shape = BALL,
			Size = cube(0.85),
			CFrame = CFrame.new(f[1], 2.6, f[2]),
			Color = f[3],
			CanCollide = false,
		})
	end
end

-- White ball with three crossing colour bands.
local function beachBall(x: number, z: number, spin: number)
	local model, add = newProp("BeachBall", ground(x, z, spin))
	model:SetAttribute("MeshScale", 1)
	local d = 2.6
	local center = CFrame.new(0, d / 2, 0) * CFrame.Angles(0.3, 0, 0.2)
	add({ Name = "BeachBall", Shape = BALL, Size = cube(d), CFrame = center, Color = W.White })
	local bands = { { CFrame.new(), W.Coral }, { ALONG_Z, W.Sunny }, { UPRIGHT, W.Blue } }
	for _, b in bands do
		add({
			Name = "BeachBallBand",
			Shape = CYLINDER,
			Size = Vector3.new(0.7, d + 0.05, d + 0.05),
			CFrame = center * b[1],
			Color = b[2],
			CanCollide = false,
		})
	end
end

local function cloud(x: number, y: number, z: number, scale: number)
	local model, add = newProp("Cloud", CFrame.new(x, y, z), "Cloud")
	local puffs =
		{ { 0, 0, 0, 1 }, { -0.75, -0.15, 0.1, 0.72 }, { 0.8, -0.2, -0.1, 0.68 }, { 0.3, 0.35, 0.15, 0.62 }, { -0.35, 0.28, -0.2, 0.55 } }
	for _, p in puffs do
		local d = 40 * scale * p[4]
		add({
			Name = "CloudPuff",
			Shape = BALL,
			Size = cube(d),
			CFrame = CFrame.new(p[1] * 40 * scale, p[2] * 40 * scale, p[3] * 40 * scale),
			Color = W.White,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		})
	end
	model:SetAttribute("Height", y)
end

-- Beach umbrella: a white pole under a round canopy in two rings (`color` outside, white
-- inside), so it reads as a striped parasol from above.
local function umbrella(x: number, z: number, color: Color3)
	local model = Instance.new("Model")
	model.Name = "BeachUmbrella"
	model.Parent = mapFolder
	local poleTop = 7.2
	part({
		Name = "UmbrellaPole",
		Shape = CYLINDER,
		Size = Vector3.new(poleTop - SAND_TOP, 0.45, 0.45),
		CFrame = CFrame.new(x, (SAND_TOP + poleTop) / 2, z) * UPRIGHT,
		Color = W.White,
		Parent = model,
	})
	part({
		Name = "UmbrellaCanopy",
		Shape = CYLINDER,
		Size = Vector3.new(0.7, 9, 9),
		CFrame = CFrame.new(x, poleTop, z) * UPRIGHT,
		Color = color,
		CanCollide = false,
		Parent = model,
	})
	part({
		Name = "UmbrellaCanopy",
		Shape = CYLINDER,
		Size = Vector3.new(0.7, 4.6, 4.6),
		CFrame = CFrame.new(x, poleTop + 0.35, z) * UPRIGHT,
		Color = W.White,
		CanCollide = false,
		Parent = model,
	})
end

-- Beach towel lying on the sand: a colour strip, with a white band across it when `banded`.
local function towel(x: number, z: number, yaw: number, color: Color3, banded: boolean)
	local base = CFrame.new(x, SAND_TOP, z) * CFrame.Angles(0, yaw, 0)
	part({
		Name = "BeachTowel",
		Size = Vector3.new(3.2, 0.16, 6),
		CFrame = base * CFrame.new(0, 0.08, 0),
		Color = color,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	})
	if not banded then
		return
	end
	part({
		Name = "BeachTowelBand",
		Size = Vector3.new(3.2, 0.24, 0.9),
		CFrame = base * CFrame.new(0, 0.12, -1.6),
		Color = W.White,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
	})
end

-- Two smooth beach rocks (blue-grey and sandstone) half sunk in the sand.
local function rocks(x: number, z: number, spin: number)
	local base = CFrame.new(x, SAND_TOP, z) * CFrame.Angles(0, spin, 0)
	part({ Name = "BeachRock", Shape = BALL, Size = cube(3.6), CFrame = base * CFrame.new(0, 0.9, 0), Color = W.Steel })
	part({ Name = "BeachRock", Shape = BALL, Size = cube(2.2), CFrame = base * CFrame.new(2.4, 0.5, 1), Color = W.PathEdge })
end

-- Reach of a beach spot around its parasol (towels, rocks and the palm included).
local BEACH_SPOT_REACH = 12

-- True when a beach spot at (x, z) stays outside every plot's fence.
local function clearOfPlots(x: number, z: number): boolean
	local insideX = math.abs(x) < PLOT_SPACING_X + PLOT_HALF + BEACH_SPOT_REACH
	local insideZ = math.abs(math.abs(z) - PLOT_ROW_Z) < PLOT_HALF + BEACH_SPOT_REACH
	return not (insideX and insideZ)
end

-- A sparse ring of beach spots (parasol and towels, rocks, a palm) in the open sand between
-- the plot rows and the shore, so the island does not read as empty from above. Each spot is
-- skipped where it would land on a plot or on the GAME MODES course.
local function buildBeachSpots()
	local spots = {
		-- { x, z, canopy colour, towel colour, rocks, palm height (0 = none) }
		{ -22, 186, W.Coral, W.Sunny, true, 0 },
		{ 64, 184, W.Sunny, W.Blue, false, 17 },
		{ 18, -186, W.Blue, W.Coral, true, 0 },
		{ -70, -184, W.Pink, W.Mint, false, 16 },
		{ 182, -20, W.Coral, W.Pink, true, 0 },
		{ 192, 70, W.Mint, W.Sunny, false, 0 },
		{ -192, -82, W.Sunny, W.Coral, true, 0 },
	}
	for i, spot in spots do
		local x, z = spot[1], spot[2]
		if not clearOfPlots(x, z) then
			continue
		end
		if not ModesCourse.isClear(x, z) or not ModesCourse.isClear(x + 8, z + 8) or not ModesCourse.isClear(x - 8, z - 8) then
			continue
		end
		-- Face the spot toward the plaza; towels lie in front of the parasol.
		local yaw = yawToward(x, z, 0, 0)
		local frame = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0)
		umbrella(x, z, spot[3])
		for k, side in { -1, 1 } do
			local p = frame * CFrame.new(side * 2.2, 0, -4.5)
			towel(p.X, p.Z, yaw + side * 0.12, if k == 1 then spot[4] else spot[3], k == 1)
		end
		if spot[5] then
			local r = frame * CFrame.new(7, 0, 3)
			rocks(r.X, r.Z, i)
		end
		local height = spot[6] :: number
		if height > 0 then
			local p = frame * CFrame.new(-7, 0, 4)
			palmTree(ground(p.X, p.Z, i * 1.9), height, 0.3 + (i % 3) * 0.08, false)
		end
	end
end

-- Distant island: a sand disc in shallow water with a terraced grassy hill and big palms.
local function farIsland(angle: number, distance: number, radius: number)
	local x, z = math.cos(angle) * distance, math.sin(angle) * distance
	disc("FarShallows", radius + 16, OCEAN_TOP + 0.15, 0.2, W.Shallows, x, z)
	disc("FarIsland", radius, 1.4, 5, W.Sand, x, z)
	disc("FarHill", radius * 0.6, 3.4, 3, W.Grass, x, z)
	disc("FarHillTop", radius * 0.3, 5.4, 3, W.GrassDark, x, z)
	local spots = { { 0.82, 0.4, 1.4 }, { 0.78, 2.5, 1.4 }, { 0.45, 4.3, 3.4 }, { 0.15, 1.2, 5.4 } }
	for i, spot in spots do
		local r = radius * spot[1]
		local a = angle + spot[2]
		palmTree(
			CFrame.new(x + math.cos(a) * r, spot[3], z + math.sin(a) * r) * CFrame.Angles(0, a + i, 0),
			24 + (i % 3) * 4,
			0.25 + 0.08 * i,
			false
		)
	end
end

-- Centre piece ---------------------------------------------------------------------------

-- Three-tier trophy podium; returns the height of its top tier. The mesh version (World.Props)
-- keeps its authored size, 6.9 studs tall, and the plaque card sits on its coral middle tier.
local function trophyPodium(base: CFrame): number
	local model, add = newProp("TrophyPodium", base)
	local meshSize = if Props.has("TrophyPodium") then Props.size("TrophyPodium") else nil
	local function tier(name: string, diameter: number, bottom: number, height: number, color: Color3)
		add({
			Name = name,
			Shape = CYLINDER,
			Size = Vector3.new(height, diameter, diameter),
			CFrame = CFrame.new(0, bottom + height / 2, 0) * UPRIGHT,
			Color = color,
		})
	end
	tier("PodiumLip", 18.8, 0, 0.45, W.White)
	tier("PodiumTier1", 18, 0, 1.2, W.Cream)
	tier("PodiumTier2", 13.4, 1.2, 1.2, W.Coral)
	tier("PodiumTier3", 9, 2.4, 1.2, W.White)
	tier("PodiumBand", 9.4, 2.85, 0.35, W.Sunny)
	local plaque = if meshSize
		then add({ Name = "PodiumPlaque", Size = Vector3.new(4.6, 1.2, 0.9), CFrame = CFrame.new(0, 3.45, -6.5), Color = W.White })
		else add({ Name = "PodiumPlaque", Size = Vector3.new(4.6, 0.9, 0.3), CFrame = CFrame.new(0, 1.8, -6.75), Color = W.White })
	local root = surface(plaque, Enum.NormalId.Front, 40)
	text(root, { Text = "GIGA CHAD", Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	if meshSize then
		model:SetAttribute("MeshScale", 1)
		plaque:SetAttribute("MeshKeep", true)
		return meshSize.Y
	end
	return 3.6
end

-- Chunky golden Chad hitting a double-biceps pose, facing -Z.
local function gigaStatue(base: CFrame)
	local model, add = newProp("GigaStatue", base)
	model:SetAttribute("MeshScale", 1)
	local gold = W.Sunny
	local deep = W.Sunny:Lerp(W.Orange, 0.5)
	local function g(props: { [string]: any }, className: string?): BasePart
		props.Color = props.Color or gold
		props.Reflectance = 0.12
		return add(props, className)
	end
	local function ball(name: string, d: number, x: number, y: number, z: number, color: Color3?)
		g({ Name = name, Shape = BALL, Size = cube(d), CFrame = CFrame.new(x, y, z), Color = color })
	end
	local function column(name: string, length: number, d: number, x: number, y: number, z: number)
		g({ Name = name, Shape = CYLINDER, Size = Vector3.new(length, d, d), CFrame = CFrame.new(x, y, z) * UPRIGHT })
	end

	for _, sx in { -1, 1 } do
		g({ Name = "StatueFoot", Size = Vector3.new(2.4, 1, 3.4), CFrame = CFrame.new(sx * 1.6, 0.5, -0.3), Color = deep })
		g({ Name = "StatueLeg", Size = Vector3.new(2.2, 5.4, 2.4), CFrame = CFrame.new(sx * 1.6, 3.6, 0) })
		ball("StatueCalf", 2.5, sx * 1.6, 2.8, 0.35)
		-- Arms: shoulder, upper arm out to the side, biceps peak, forearm up, fist.
		ball("StatueShoulder", 3.4, sx * 4.5, 13.4, 0)
		g({
			Name = "StatueUpperArm",
			Shape = CYLINDER,
			Size = Vector3.new(3.6, 2.4, 2.4),
			CFrame = CFrame.new(sx * 6.8, 13.6, 0),
		})
		ball("StatueBiceps", 3, sx * 6.6, 14.6, 0)
		ball("StatueElbow", 2.4, sx * 8.6, 13.6, 0)
		column("StatueForearm", 4, 2.2, sx * 8.6, 15.6, 0)
		ball("StatueFist", 2.8, sx * 8.6, 18, 0)
		g({ Name = "StatuePec", Size = Vector3.new(3.7, 2, 0.7), CFrame = CFrame.new(sx * 1.95, 12.4, -1.85) })
		g({ Name = "StatueEar", Size = Vector3.new(0.5, 1, 0.8), CFrame = CFrame.new(sx * 1.95, 16.8, 0) })
		for row = 0, 1 do
			g({ Name = "StatueAbs", Size = Vector3.new(1.4, 0.8, 0.4), CFrame = CFrame.new(sx * 0.8, 8.9 + row * 0.95, -1.6) })
		end
	end
	g({ Name = "StatueShorts", Size = Vector3.new(5.8, 2.6, 3.2), CFrame = CFrame.new(0, 7.2, 0), Color = deep })
	g({ Name = "StatueWaist", Size = Vector3.new(5.2, 1.7, 3), CFrame = CFrame.new(0, 9.25, 0) })
	g({ Name = "StatueChest", Size = Vector3.new(8.4, 3.8, 3.6), CFrame = CFrame.new(0, 11.8, 0) })
	column("StatueNeck", 1.6, 2.6, 0, 14.3, 0)
	g({ Name = "StatueHead", Size = Vector3.new(3.6, 3.6, 3.4), CFrame = CFrame.new(0, 16.7, 0) })
	g({ Name = "StatueJaw", Size = Vector3.new(4, 1.5, 3.6), CFrame = CFrame.new(0, 15.4, -0.1) })
	g({ Name = "StatueHair", Size = Vector3.new(3.8, 1.2, 3.6), CFrame = CFrame.new(0, 18.9, 0.1), Color = deep })
	g({ Name = "StatueQuiff", Size = Vector3.new(3.8, 1, 1.8), CFrame = CFrame.new(0, 19.9, -0.8), Color = deep }, "WedgePart")
	g({ Name = "StatueSmile", Size = Vector3.new(1.6, 0.3, 0.2), CFrame = CFrame.new(0, 15.55, -1.95), Color = deep })
	add({ Name = "StatueShades", Size = Vector3.new(3.8, 0.8, 0.4), CFrame = CFrame.new(0, 17.2, -1.75), Color = W.Ink })
end

-- A thin teal border round a sign card frame.
local function border(frame: Frame, thickness: number)
	local b = Instance.new("UIStroke")
	b.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	b.Color = W.Teal
	b.Thickness = thickness
	b.Parent = frame
end

-- Freestanding ranking card on two teal posts, front facing -Z. The front is a deep teal board
-- under a sunny header pill with the list (returned for Server.Ranking to fill); the back is
-- a cream welcome card with a red-orange header band and the game name.
local function scoreboard(base: CFrame): TextLabel
	local _, add = newProp("Scoreboard", base)
	local w, h, bottom = 16, 17, 3.4
	local top = bottom + h
	local slab = add({ Name = "ScoreCard", Size = Vector3.new(w, h, 1), CFrame = CFrame.new(0, bottom + h / 2, 0), Color = W.Board })
	for _, sx in { -1, 1 } do
		local x = sx * (w / 2 + 0.6)
		add({
			Name = "ScoreFoot",
			Shape = CYLINDER,
			Size = Vector3.new(0.6, 2.6, 2.6),
			CFrame = CFrame.new(x, 0.3, 0) * UPRIGHT,
			Color = W.Cream,
		})
		add({
			Name = "ScorePost",
			Shape = CYLINDER,
			Size = Vector3.new(top + 0.4, 1.4, 1.4),
			CFrame = CFrame.new(x, (top + 0.4) / 2, 0) * UPRIGHT,
			Color = W.Teal,
		})
		add({ Name = "ScorePostCap", Shape = BALL, Size = cube(2.1), CFrame = CFrame.new(x, top + 0.8, 0), Color = W.Sunny })
	end

	local front = surface(slab, Enum.NormalId.Front, 30)
	local card = panel(front, W.Board, UDim2.fromScale(0.035, 0.03), UDim2.fromScale(0.93, 0.94), 0.06)
	border(card, 6)
	local pill = panel(card, W.Sunny, UDim2.fromScale(0.08, 0.035), UDim2.fromScale(0.84, 0.12), 0.5)
	text(pill, {
		Text = "TOP " .. string.upper(theme.Words.Units),
		Size = UDim2.fromScale(0.9, 0.76),
		Position = UDim2.fromScale(0.05, 0.12),
	})
	local list = text(card, {
		Text = "Loading...",
		Font = theme.Fonts.UI,
		TextScaled = false,
		TextSize = 24,
		TextColor3 = W.White,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		Size = UDim2.fromScale(0.86, 0.77),
		Position = UDim2.fromScale(0.07, 0.19),
	})

	local back = surface(slab, Enum.NormalId.Back, 30)
	local backCard = panel(back, W.Cream, UDim2.fromScale(0.035, 0.03), UDim2.fromScale(0.93, 0.94), 0.06)
	border(backCard, 6)
	local welcome = panel(backCard, W.RedOrange, UDim2.fromScale(0.2, 0.08), UDim2.fromScale(0.6, 0.11), 0.5)
	text(welcome, { Text = "WELCOME!", TextColor3 = W.White, Size = UDim2.fromScale(0.9, 0.76), Position = UDim2.fromScale(0.05, 0.12) })
	text(backCard, { Text = theme.GameName, Size = UDim2.fromScale(0.86, 0.42), Position = UDim2.fromScale(0.07, 0.24) })
	text(backCard, {
		Text = theme.Tagline,
		Font = theme.Fonts.UI,
		Size = UDim2.fromScale(0.8, 0.2),
		Position = UDim2.fromScale(0.1, 0.7),
	})
	return list
end

-- Welcome arch over a plaza connector, front facing the plaza (-Z): teal pillars with sunny
-- caps holding a cream sign card on both faces (game name, red-orange band).
local function welcomeArch(base: CFrame, plotsText: string)
	local _, add = newProp("WelcomeArch", base)
	for _, sx in { -1, 1 } do
		local x = sx * 7.6
		add({
			Name = "ArchFoot",
			Shape = CYLINDER,
			Size = Vector3.new(1, 3.2, 3.2),
			CFrame = CFrame.new(x, 0.5, 0) * UPRIGHT,
			Color = W.Teal,
		})
		add({
			Name = "ArchPillar",
			Shape = CYLINDER,
			Size = Vector3.new(10.6, 2.2, 2.2),
			CFrame = CFrame.new(x, 5.3, 0) * UPRIGHT,
			Color = W.Teal,
		})
		add({ Name = "ArchCap", Shape = BALL, Size = cube(3), CFrame = CFrame.new(x, 12.2, 0), Color = W.Sunny })
	end
	local sign = add({ Name = "ArchSign", Size = Vector3.new(14, 3.8, 1), CFrame = CFrame.new(0, 10.2, 0), Color = W.Board })
	for _, f in { { Enum.NormalId.Front, plotsText }, { Enum.NormalId.Back, "WELCOME!" } } do
		local root = surface(sign, f[1], 30)
		local card = panel(root, W.Cream, UDim2.fromScale(0.015, 0.06), UDim2.fromScale(0.97, 0.88), 0.2)
		border(card, 6)
		text(card, { Text = theme.GameName, Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.06) })
		local band = panel(card, W.RedOrange, UDim2.fromScale(0.25, 0.62), UDim2.fromScale(0.5, 0.3), 0.5)
		text(band, { Text = f[2], TextColor3 = W.White, Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	end
end

-- Juice bar hut with a striped awning, front (counter) facing -Z.
local function juiceBar(base: CFrame)
	local _, add = newProp("JuiceBar", base)
	add({
		Name = "JuiceDeck",
		Size = Vector3.new(11, 0.5, 8.6),
		CFrame = CFrame.new(0, 0.25, 0.4),
		Color = W.Wood,
		Material = Enum.Material.WoodPlanks,
	})
	add({ Name = "JuiceCounter", Size = Vector3.new(9.6, 3.2, 1.6), CFrame = CFrame.new(0, 2.1, -2.4), Color = W.Pink })
	add({ Name = "JuiceKick", Size = Vector3.new(9.8, 0.6, 1.7), CFrame = CFrame.new(0, 0.8, -2.4), Color = W.White })
	add({ Name = "JuiceCounterTop", Size = Vector3.new(10.2, 0.45, 2.2), CFrame = CFrame.new(0, 3.9, -2.4), Color = W.Cream })
	add({ Name = "JuiceBack", Size = Vector3.new(10, 5, 0.6), CFrame = CFrame.new(0, 3, 4.2), Color = W.Mint })
	add({ Name = "JuiceShelf", Size = Vector3.new(8.6, 0.4, 1.2), CFrame = CFrame.new(0, 3.6, 3.4), Color = W.White })
	local fruit = { W.Orange, W.Sunny, W.Coral, W.Grass, W.Orange, W.Pink }
	for i, color in fruit do
		add({
			Name = "JuiceFruit",
			Shape = BALL,
			Size = cube(1.1),
			CFrame = CFrame.new(-3.6 + (i - 1) * 1.45, 4.35, 3.4),
			Color = color,
			CanCollide = false,
		})
	end
	-- Posts: the roof slopes down toward the counter.
	local frontY, backY = 7.4, 9.2
	for _, sx in { -1, 1 } do
		for _, p in { { -3.4, frontY }, { 4.2, backY } } do
			local length = p[2] - 0.5
			add({
				Name = "JuicePost",
				Shape = CYLINDER,
				Size = Vector3.new(length, 0.9, 0.9),
				CFrame = CFrame.new(sx * 4.9, 0.5 + length / 2, p[1]) * UPRIGHT,
				Color = W.Wood,
			})
		end
	end
	-- Striped awning (coral and white), with a row of round scallops along the front edge.
	local stripes = 6
	local stripeW = 11.4 / stripes
	local depth = 9.6
	local rise = backY - frontY
	local slope = math.atan2(rise, depth)
	for i = 1, stripes do
		local x = -5.7 + (i - 0.5) * stripeW
		local color = if i % 2 == 1 then W.Coral else W.White
		add({
			Name = "Awning",
			Size = Vector3.new(stripeW, 0.35, math.sqrt(depth * depth + rise * rise)),
			CFrame = CFrame.new(x, (frontY + backY) / 2 + 0.2, 0.2) * CFrame.Angles(-slope, 0, 0),
			Color = color,
		})
		add({
			Name = "AwningScallop",
			Shape = BALL,
			Size = cube(stripeW),
			CFrame = CFrame.new(x, frontY + 0.1, -4.6),
			Color = color,
			CanCollide = false,
		})
	end
	local sign = add({ Name = "JuiceSign", Size = Vector3.new(6.4, 1.8, 0.5), CFrame = CFrame.new(0, frontY + 1.6, -3.2), Color = W.Sunny })
	local root = surface(sign, Enum.NormalId.Front, 30)
	local card = panel(root, W.Cream, UDim2.fromScale(0.03, 0.08), UDim2.fromScale(0.94, 0.84), 0.35)
	text(card, { Text = "JUICE BAR", Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
	-- Smoothie cups with straws on the counter, and stools in front.
	for i, color in { W.Mint, W.Sunny, W.Orange } do
		local x = -3 + (i - 1) * 2.2
		add({
			Name = "JuiceCup",
			Shape = CYLINDER,
			Size = Vector3.new(1.3, 0.95, 0.95),
			CFrame = CFrame.new(x, 4.77, -2.5) * UPRIGHT,
			Color = color,
			CanCollide = false,
		})
		add({
			Name = "JuiceStraw",
			Shape = CYLINDER,
			Size = Vector3.new(1.1, 0.25, 0.25),
			CFrame = CFrame.new(x + 0.15, 5.6, -2.5) * CFrame.Angles(0, 0, 0.25) * UPRIGHT,
			Color = W.White,
			CanCollide = false,
		})
	end
	for _, x in { -3, 0, 3 } do
		add({
			Name = "StoolPole",
			Shape = CYLINDER,
			Size = Vector3.new(2.2, 0.5, 0.5),
			CFrame = CFrame.new(x, 1.1, -4.6) * UPRIGHT,
			Color = W.White,
		})
		add({
			Name = "StoolSeat",
			Shape = CYLINDER,
			Size = Vector3.new(0.45, 1.8, 1.8),
			CFrame = CFrame.new(x, 2.4, -4.6) * UPRIGHT,
			Color = W.Coral,
		})
	end
end

-- World ---------------------------------------------------------------------------------

-- Sand island, beach, shallows and an ocean that reaches the horizon. The island and shore are
-- flat SmoothPlastic: the Sand material's large-scale texture variation reads as dark smudges
-- across a disc this big when seen from above.
local function buildSurroundings()
	disc("Island", ISLAND_RADIUS, SAND_TOP, 6, W.Sand, 0, 0)
	disc("Shore", ISLAND_RADIUS + 8, -0.55, 6, W.SandDark, 0, 0)
	disc("Foam", ISLAND_RADIUS + 11, -0.9, 0.3, W.White)
	disc("Shallows", ISLAND_RADIUS + 34, OCEAN_TOP + 0.2, 0.2, W.Shallows)
	for ix = -1, 1 do
		for iz = -1, 1 do
			part({
				Name = "Ocean",
				Size = Vector3.new(OCEAN_TILE, 2, OCEAN_TILE),
				CFrame = CFrame.new(ix * OCEAN_TILE, OCEAN_TOP - 1, iz * OCEAN_TILE),
				Color = W.Ocean,
				Reflectance = 0.05,
				CastShadow = false,
			})
		end
	end

	-- Palm islands out at sea, all around the horizon.
	local islands = {
		{ 20, 620, 55 },
		{ 78, 860, 42 },
		{ 140, 560, 36 },
		{ 200, 760, 60 },
		{ 255, 600, 44 },
		{ 318, 900, 50 },
	}
	for _, isle in islands do
		farIsland(math.rad(isle[1]), isle[2], isle[3])
	end

	-- A ring of palms along the beach, outside every plot.
	local beachPalms = 12
	for i = 1, beachPalms do
		local a = (i - 0.5) * 2 * math.pi / beachPalms
		local r = ISLAND_RADIUS - 14 + (i % 3) * 3
		-- None on the GAME MODES plaza or the Parkour finish deck (World.Modes).
		if ModesCourse.isClear(math.cos(a) * r, math.sin(a) * r) then
			palmTree(ground(math.cos(a) * r, math.sin(a) * r, a * 1.7), 15 + (i % 4) * 1.5, 0.3 + (i % 3) * 0.1, false)
		end
	end

	-- Beach spots in the open sand between the plots and the shore.
	buildBeachSpots()

	-- Puffy clouds high above the sea.
	local clouds = {
		{ -420, 190, 260, 1.4 },
		{ 360, 220, 420, 1.1 },
		{ 520, 170, -180, 1.3 },
		{ -260, 240, -520, 1.6 },
		{ 120, 260, -760, 1.2 },
		{ -700, 210, -60, 1.5 },
		{ 760, 250, 300, 1.2 },
		{ -80, 230, 820, 1.4 },
	}
	for _, c in clouds do
		cloud(c[1], c[2], c[3], c[4])
	end
end

-- Boardwalk ring between the plaza and the plot rows.
local function buildBoardwalk()
	local function deck(cx: number, cz: number, sx: number, sz: number)
		part({
			Name = "Boardwalk",
			Size = Vector3.new(sx, 0.6, sz),
			CFrame = CFrame.new(cx, DECK_TOP - 0.3, cz),
			Color = W.Wood,
			Material = Enum.Material.WoodPlanks,
		})
	end
	local function edge(cx: number, cz: number, sx: number, sz: number)
		if sx > 0.05 and sz > 0.05 then
			part({
				Name = "BoardwalkEdge",
				Size = Vector3.new(sx, 0.7, sz),
				CFrame = CFrame.new(cx, DECK_TOP + 0.1 - 0.35, cz),
				Color = W.WoodDark,
			})
		end
	end
	-- An edge beam along z = `z` from x0 to x1, open where the given spans cross it.
	local function edgeAlongX(z: number, x0: number, x1: number, gaps: { { number } })
		local x = x0
		for _, gap in gaps do
			edge((x + gap[1]) / 2, z, gap[1] - x, 0.7)
			x = gap[2]
		end
		edge((x + x1) / 2, z, x1 - x, 0.7)
	end

	local spurLength = ENTRANCE_Z - (CROSS_Z + WALK_HALF)
	local connectorStart = HUB_RADIUS - 1
	local connectorLength = CROSS_Z - WALK_HALF - connectorStart
	local spurGaps = {}
	for col = -1, 1 do
		local cx = col * PLOT_SPACING_X
		table.insert(spurGaps, { cx - WALK_HALF, cx + WALK_HALF })
	end
	local edgeIn = WALK_HALF - 0.35
	for _, row in { 1, -1 } do
		local z = row * CROSS_Z
		deck(0, z, RING_OUT * 2, WALK_HALF * 2)
		edgeAlongX(z - row * edgeIn, -(RING_X - WALK_HALF), RING_X - WALK_HALF, { { -CONNECTOR_HALF, CONNECTOR_HALF } })
		edgeAlongX(z + row * edgeIn, -RING_OUT, RING_OUT, spurGaps)
		-- Spurs into the plot entrances.
		local spurZ = row * (CROSS_Z + WALK_HALF + spurLength / 2)
		for col = -1, 1 do
			local cx = col * PLOT_SPACING_X
			deck(cx, spurZ, WALK_HALF * 2, spurLength)
			for _, sx in { -1, 1 } do
				edge(cx + sx * edgeIn, spurZ, 0.7, spurLength)
				bollard(cx + sx * (WALK_HALF + 0.9), row * (CROSS_Z + WALK_HALF + 0.9))
			end
		end
		-- Wide connector from the plaza.
		local connectorZ = row * (connectorStart + connectorLength / 2)
		deck(0, connectorZ, CONNECTOR_HALF * 2, connectorLength)
		for _, sx in { -1, 1 } do
			edge(sx * (CONNECTOR_HALF - 0.35), connectorZ, 0.7, connectorLength)
		end
	end
	for _, side in { 1, -1 } do
		local x = side * RING_X
		local length = (CROSS_Z - WALK_HALF) * 2
		deck(x, 0, WALK_HALF * 2, length)
		edge(x - side * edgeIn, 0, 0.7, length)
		-- Open where a GAME MODES spur leaves the ring (World.Modes builds the spurs): SPUR at
		-- -X, SPUR2 (the mirrored plaza) at +X when it exists.
		local spurSpec = if side == -1 then ModesCourse.SPUR else (ModesCourse :: any).SPUR2
		if spurSpec then
			local outer = CROSS_Z + WALK_HALF
			local spur = spurSpec.half
			for _, sz in { -1, 1 } do
				edge(x + side * edgeIn, sz * (spur + outer) / 2, 0.7, outer - spur)
			end
		else
			edge(x + side * edgeIn, 0, 0.7, (CROSS_Z + WALK_HALF) * 2)
		end
		for _, row in { 1, -1 } do
			bollard(x + side * (WALK_HALF + 0.9), row * (CROSS_Z + WALK_HALF + 0.9))
		end
	end
end

-- Hub -----------------------------------------------------------------------------------

local function buildHub(): { TextLabel }
	buildSurroundings()
	buildBoardwalk()

	-- Plaza: a thin light path-stone rim, warm honey-sand paving, a sunny ring and a light teal
	-- centre round the podium.
	disc("PlazaRim", HUB_RADIUS, PLAZA_RIM_TOP, 0.6, W.Path)
	disc("Plaza", HUB_RADIUS - 1, PLAZA_TOP, 0.6, W.Plaza)
	disc("PlazaRing", PLAZA_INNER_RADIUS + 1, PLAZA_RING_TOP, 0.6, W.Sunny)
	disc("PlazaInner", PLAZA_INNER_RADIUS, PLAZA_INNER_TOP, 0.6, W.TealLight)

	-- Spawn mat in front of the statue, facing it.
	part({
		Name = "HubSpawnRim",
		Size = Vector3.new(9.4, 0.3, 9.4),
		CFrame = CFrame.new(0, PLAZA_INNER_TOP + 0.08 - 0.15, -24),
		Color = W.White,
	})
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(0, PLAZA_INNER_TOP + 0.14 - 0.2, -24) * CFrame.Angles(0, math.pi, 0)
	spawn.Color = W.Mat
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Parent = mapFolder
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	-- Centre piece: the golden statue on its trophy podium, facing the spawn.
	local podiumTop = trophyPodium(CFrame.new(0, PLAZA_INNER_TOP, 0))
	gigaStatue(CFrame.new(0, PLAZA_INNER_TOP + podiumTop, 0))

	-- Ranking scoreboards either side of the statue: one faces each plot row.
	local rankingLabels: { TextLabel } = {
		scoreboard(CFrame.new(-SCOREBOARD_X, PLAZA_INNER_TOP, 0)),
		scoreboard(CFrame.new(SCOREBOARD_X, PLAZA_INNER_TOP, 0) * CFrame.Angles(0, math.pi, 0)),
	}

	-- Benches round the podium, facing the statue; planters near the rim.
	for i = 0, 3 do
		local a = (i + 0.5) * math.pi / 2
		local x, z = math.cos(a) * 14, math.sin(a) * 14
		bench(CFrame.new(x, PLAZA_INNER_TOP, z) * CFrame.Angles(0, yawToward(x, z, 0, 0), 0))
		local px, pz = math.cos(a) * 26.5, math.sin(a) * 26.5
		planter(CFrame.new(px, PLAZA_TOP, pz) * CFrame.Angles(0, yawToward(px, pz, 0, 0), 0))
	end

	-- Welcome arches over the plaza connectors.
	for _, row in { 1, -1 } do
		local first = if row == 1 then 1 else 4
		welcomeArch(
			ground(0, row * ARCH_Z, if row == 1 then 0 else math.pi),
			string.format("PLOTS %d · %d · %d", first, first + 1, first + 2)
		)
	end

	-- Sand between the plaza and the plot rows: palms, grass islands, the juice bar and toys.
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			palmTree(ground(sx * 12.5, sz * (ARCH_Z + 1.5), sx * sz), 17, 0.35, true)
			palmTree(ground(sx * 28, sz * 30, sx * sz * 2), 19, 0.45, true)
		end
	end
	juiceBar(ground(46, -20, yawToward(46, -20, 0, -8)))

	local islands = {
		{ 66, 16, 11, { { 61, 12, 18 }, { 70, 21, 15 } }, { 72, 9 } },
		{ -66, -16, 11, { { -61, -12, 18 }, { -70, -21, 15 } }, { -72, -9 } },
		{ -62, 21, 8, { { -62, 21, 16 } }, nil },
		{ 90, -16, 8, { { 90, -16, 17 } }, nil },
		{ 90, 22, 7, {}, { 90, 22 } },
		{ -92, -2, 9, { { -94, 0, 18 } }, { -89, -6 } },
	}
	for i, isle in islands do
		local x, z, r = isle[1], isle[2], isle[3]
		disc("GrassRim", r + 0.8, 0.12, 0.6, W.GrassDark, x, z)
		disc("GrassIsland", r, 0.22, 0.6, W.Grass, x, z)
		for j, p in isle[4] do
			palmTree(CFrame.new(p[1], 0.22, p[2]) * CFrame.Angles(0, i + j * 2, 0), p[3], 0.3 + 0.1 * j, true)
		end
		local spot = isle[5]
		if spot then
			planter(CFrame.new(spot[1], 0.22, spot[2]) * CFrame.Angles(0, yawToward(spot[1], spot[2], x, z) + math.pi, 0))
		end
	end

	local balls = { { 54, 3 }, { -50, 8 }, { 80, -30 }, { -36, -33 }, { -158, 42 }, { 168, 28 }, { 24, 166 }, { -30, -170 } }
	for i, b in balls do
		-- None on either GAME MODES plaza or spur (World.Modes).
		local x, z = b[1], b[2]
		if ModesCourse.isClear(x, z) and ModesCourse.isClear(x + 3, z + 3) and ModesCourse.isClear(x - 3, z - 3) then
			beachBall(x, z, i * 1.3)
		end
	end

	return rankingLabels
end

Hub.setupLighting = setupLighting
Hub.buildHub = buildHub

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="202">
          <Properties>
            <string name="Name">Machines</string>
            <string name="Source"><![CDATA[--[[
	Machines: the toy-like gym machines on every plot.
	  * Converter: a giant smoothie blender (clear-tint cup, chunky lid, blade disc
	    "ConverterCore" + "ConverterBlade" that the client spins). Orbs drop into
	    "ConverterIntake" on the lid.
	  * Processor: a juice-bar conveyor counter; "ProcessorCup" models ride the belt and the
	    "ProcessorLight" dots on the front show progress (both animated client-side).
	  * Vault: a big friendly piggy bank ("Piggy*" parts) with a coin ("Coin") in its slot.
	  * Unlockers: carnival high-strikers with a soft hammer, a target plinth ("HoloPad"), the
	    empty-slot ghost crate ("HoloCrate"), a puck on a track ("StrikerPuck") and a bell
	    ("StrikerBell" model) on top.
	Everything is painted from Theme.World: SmoothPlastic, teal bodies and kicks, white rims,
	sunny accents, no glow.
	Machine bodies: the uploaded Blender meshes (World.Props: Converter, Vault, CrateCracker,
	CrateCrackerVip) when they are in the place, else the part-built versions below. The crate
smasher meshes get a pastel overlay (pastel teal, VIP sunny; Props.overlay). With a mesh
	the named parts the client animates stay (ConverterCore / Blade / Juice, an invisible
	ConverterIntake on the mesh's fill cap, an invisible PiggySlot and the Coin on the pig's slot,
	HoloCrate, StrikerPuck, and an invisible StrikerBell on the mesh's bell for the ring effect),
	and invisible "PropCollider" parts block the player.
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.
]]

local Layout = require(script.Parent.Parent.PlotLayout)
local Common = require(script.Parent.Common)
local Props = require(script.Parent.Props)

type Builder = Common.Builder
type Rect = Common.Rect

local UPRIGHT = Common.UPRIGHT
local ALONG_Z = Common.ALONG_Z
local WHITE = Common.WHITE
local theme = Common.theme

local Machines = {}

local function worldColor(key: string, fallback: Color3): Color3
	local palette = theme.World
	return if palette and palette[key] then palette[key] else fallback
end

local function padColor(key: string, fallback: Color3): Color3
	local palette = theme.World
	local pads = palette and palette.Pads
	return if pads and pads[key] then pads[key] else fallback
end

local function decor(part: BasePart): BasePart
	part.CanCollide = false
	part.CastShadow = false
	return part
end

-- Converter: smoothie blender ------------------------------------------------------------------

-- Part-built converter body: motor base on a white foot, three candy buttons facing the pad and
-- a light clear-tint cup.
local function buildConverterBody(B: Builder, x: number, z: number, blue: Color3, blueLight: Color3)
	local L, P = B.L, B.P
	-- Motor base: a fat round body on a white foot, with three candy buttons facing the pad.
	P({
		Name = "ConverterFoot",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 6.6, 6.6),
		CFrame = L(x, 0.3, z) * UPRIGHT,
		Color = WHITE,
	})
	P({
		Name = "ConverterBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 6, 6),
		CFrame = L(x, 1.7, z) * UPRIGHT,
		Color = blue,
	})
	P({
		Name = "ConverterBaseRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 6.4, 6.4),
		CFrame = L(x, 2.9, z) * UPRIGHT,
		Color = WHITE,
	})
	for i, key in { "Sunny", "TealLight", "RedOrange" } do
		local dz = (i - 2) * 1.3
		local dx = math.sqrt(9 - dz * dz)
		decor(P({
			Name = "ConverterButton",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 0.95, 0.95),
			CFrame = L(x + dx, 1.7, z + dz) * CFrame.Angles(0, -math.atan2(dz, dx), 0),
			Color = worldColor(key, WHITE),
		}))
	end
	P({
		Name = "ConverterCollar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 5.4, 5.4),
		CFrame = L(x, 3.5, z) * UPRIGHT,
		Color = blueLight,
	})

	-- Cup: a light clear tint with the aura smoothie and the blade disc inside.
	local cup = P({
		Name = "ConverterCup",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5.6, 5, 5),
		CFrame = L(x, 6.65, z) * UPRIGHT,
		Color = worldColor("Pool", blueLight):Lerp(WHITE, 0.55),
		Transparency = 0.5,
	})
	cup.CastShadow = false
end

-- The aura smoothie and the blade disc the client spins (inside the cup in both versions).
local function buildConverterCore(B: Builder, x: number, z: number, chrome: Color3)
	local L, P = B.L, B.P
	decor(P({
		Name = "ConverterJuice",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.2, 4.5, 4.5),
		CFrame = L(x, 4.95, z) * UPRIGHT,
		Color = worldColor("Grape", B.c.Orb):Lerp(WHITE, 0.2),
		Transparency = 0.3,
	}))
	decor(P({
		Name = "ConverterCore",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.5, 1.5),
		CFrame = L(x, 4.4, z) * UPRIGHT,
		Color = chrome,
	}))
	for i = 0, 1 do
		decor(P({
			Name = "ConverterBlade",
			Size = Vector3.new(3.6, 0.3, 0.8),
			CFrame = L(x, 4.55, z) * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.Angles(0.25, 0, 0),
			Color = chrome,
		}))
	end
end

-- Part-built measuring marks, handle and lid with its sunny fill cap (ConverterIntake).
local function buildConverterLid(B: Builder, x: number, z: number, blue: Color3, cream: Color3)
	local L, P = B.L, B.P
	-- Measuring marks on the front of the cup.
	for i, y in { 5.6, 6.8, 8 } do
		decor(P({
			Name = "ConverterTick",
			Size = Vector3.new(0.2, 0.3, if i == 2 then 1.4 else 0.9),
			CFrame = L(x + 2.5, y, z),
			Color = WHITE,
		}))
	end
	-- Chunky handle on the +Z side.
	for _, y in { 5, 8.3 } do
		P({ Name = "ConverterHandle", Size = Vector3.new(0.8, 0.7, 1.4), CFrame = L(x, y, z + 3), Color = WHITE })
	end
	P({
		Name = "ConverterHandle",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, 1, 1),
		CFrame = L(x, 6.65, z + 3.6) * UPRIGHT,
		Color = WHITE,
	})

	-- Lid with a sunny fill cap: deposited orbs drop into the cap (ConverterIntake).
	P({
		Name = "ConverterLidRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 5.5, 5.5),
		CFrame = L(x, 9.7, z) * UPRIGHT,
		Color = WHITE,
	})
	P({
		Name = "ConverterLid",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 5.2, 5.2),
		CFrame = L(x, 10.45, z) * UPRIGHT,
		Color = blue,
	})
	P({
		Name = "ConverterIntake",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.9, 2.4, 2.4),
		CFrame = L(x + 0.6, 11.4, z) * UPRIGHT,
		Color = worldColor("Sunny", B.c.Primary),
	})
	decor(P({
		Name = "ConverterIntakeTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, 1.6, 1.6),
		CFrame = L(x + 0.6, 11.86, z) * UPRIGHT,
		Color = cream,
	}))
end

-- Converter mesh: its cup axis (mesh units, from the bounding-box base centre); the blade
-- disc spins on that axis just above the cup floor (y = 4).
local CONVERTER_CUP_AXIS = Vector3.new(-0.67, 0, 0.13)

local function buildConverter(B: Builder, x: number, z: number)
	local L, P = B.L, B.P
	local blue = padColor("Deposit", worldColor("Blue", B.c.Secondary))
	local blueLight = blue:Lerp(WHITE, 0.3)
	local chrome = worldColor("Chrome", WHITE)
	local cream = worldColor("Cream", WHITE)

	-- Mesh body (cup, motor base, buttons, handle, lid) with its front toward the deposit pad
	-- (+X) and its handle on the +Z side.
	local facing = L(x, 0, z) * CFrame.Angles(0, -math.pi / 2, 0)
	local body = Props.mesh("Converter", facing * CFrame.new(-CONVERTER_CUP_AXIS), 1, B.folder)
	if body then
		Props.collider(B.folder, L(x, 5.7, z), Vector3.new(11.4, 6.6, 6.6), true)
	else
		buildConverterBody(B, x, z, blue, blueLight)
	end
	buildConverterCore(B, x, z, chrome)
	if body then
		-- Deposited orbs drop into the mesh's fill cap (0.6 toward the pad).
		decor(P({
			Name = "ConverterIntake",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.9, 2.4, 2.4),
			CFrame = L(x + 0.6, 11, z) * UPRIGHT,
			Transparency = 1,
			CanQuery = false,
		}))
	else
		buildConverterLid(B, x, z, blue, cream)
	end
end

-- Processor: juice-bar conveyor -------------------------------------------------------------------

local function buildProcessor(B: Builder)
	local L, P = B.L, B.P
	local r = Layout.MACHINES.Processor
	local x = (r.minX + r.maxX) / 2
	local z = (r.minZ + r.maxZ) / 2
	local w = r.maxX - r.minX
	local d = r.maxZ - r.minZ
	local front = r.maxX
	local sunny = padColor("Process", worldColor("Sunny", B.c.Primary))
	local cream = worldColor("Cream", WHITE)
	local teal = worldColor("Teal", B.c.Secondary)
	local tealLight = worldColor("TealLight", WHITE)
	local coral = worldColor("Coral", B.c.Accent)
	local pink = worldColor("Pink", coral)

	-- Counter body: teal down to its kick strip, a sunny front panel of progress dots, white top.
	P({ Name = "ProcessorKick", Size = Vector3.new(w, 0.6, d), CFrame = L(x, 0.3, z), Color = teal })
	P({ Name = "Processor", Size = Vector3.new(w - 0.2, 3, d - 0.2), CFrame = L(x, 2.1, z), Color = teal })
	P({ Name = "ProcessorPanel", Size = Vector3.new(0.2, 1.4, d - 1.6), CFrame = L(front, 2.1, z), Color = sunny })
	local dots = 5
	for i = 1, dots do
		decor(P({
			Name = "ProcessorLight",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 0.9, 0.9),
			CFrame = L(front + 0.12, 2.1, z - (d - 4) / 2 + (i - 1) * (d - 4) / (dots - 1)),
			Color = cream,
		}))
	end
	P({ Name = "ProcessorTop", Size = Vector3.new(w + 0.2, 0.5, d + 0.2), CFrame = L(x, 3.85, z), Color = WHITE })

	-- Conveyor belt with rollers and low side rails.
	local beltX = x + 0.3
	local beltLen = d - 2.4
	P({ Name = "ProcessorBelt", Size = Vector3.new(2.6, 0.3, beltLen), CFrame = L(beltX, 4.25, z), Color = worldColor("Steel", cream) })
	for _, side in { -1, 1 } do
		P({ Name = "ProcessorRail", Size = Vector3.new(0.4, 0.6, beltLen + 0.4), CFrame = L(beltX + side * 1.5, 4.4, z), Color = WHITE })
		P({
			Name = "ProcessorRoller",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3.4, 1, 1),
			CFrame = L(beltX, 4.25, z + side * beltLen / 2),
			Color = sunny,
		})
	end

	-- Juice jug at the start of the belt.
	local jugZ = r.minZ + 2.6
	P({
		Name = "ProcessorJug",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 2.6, 2.6),
		CFrame = L(beltX, 5.3, jugZ) * UPRIGHT,
		Color = sunny,
	})
	P({
		Name = "ProcessorJugLid",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2.9, 2.9),
		CFrame = L(beltX, 6.7, jugZ) * UPRIGHT,
		Color = WHITE,
	})
	decor(P({
		Name = "ProcessorSpout",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 0.7, 0.7),
		CFrame = L(beltX, 5, jugZ + 1.6) * ALONG_Z,
		Color = WHITE,
	}))

	-- Smoothie cups riding the belt (the client slides them while the processor works).
	local spacing = 2.4
	local firstZ = jugZ + 2.4
	for i = 0, 3 do
		local cz = firstZ + i * spacing
		local model = Instance.new("Model")
		model.Name = "ProcessorCup"
		model.Parent = B.folder
		decor(P({
			Name = "Cup",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.5, 1.3, 1.3),
			CFrame = L(beltX, 5.15, cz) * UPRIGHT,
			Color = WHITE,
			Parent = model,
		}))
		decor(P({
			Name = "CupBand",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 1.4, 1.4),
			CFrame = L(beltX, 5, cz) * UPRIGHT,
			Color = if i % 2 == 0 then sunny else coral,
			Parent = model,
		}))
		decor(P({
			Name = "CupJuice",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 1.1, 1.1),
			CFrame = L(beltX, 5.82, cz) * UPRIGHT,
			Color = tealLight,
			Parent = model,
		}))
		decor(P({
			Name = "CupStraw",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.3, 0.3, 0.3),
			CFrame = L(beltX + 0.2, 6.2, cz) * CFrame.Angles(0, 0, math.rad(78)),
			Color = pink,
			Parent = model,
		}))
	end
end

-- Vault: piggy bank -----------------------------------------------------------------------------

-- Part-built pig ("Piggy*" parts) facing +X; returns the plot-local x and top of its coin slot.
local function buildPiggy(B: Builder, x: number, z: number, pink: Color3, ink: Color3): (number, number)
	local L, P = B.L, B.P
	local pinkLight = pink:Lerp(WHITE, 0.3)
	local pinkDeep = pink:Lerp(worldColor("Coral", pink), 0.45)
	local by = 2.9
	local fx = x + 0.6
	for _, dx in { -1, 1 } do
		for _, dz in { -1, 1 } do
			P({
				Name = "PiggyLeg",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.1, 1, 1),
				CFrame = L(x + dx * 1, 1.25, z + dz * 0.95) * UPRIGHT,
				Color = pinkDeep,
			})
		end
	end
	P({ Name = "PiggyBody", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 3.6, 3.6), CFrame = L(x, by, z), Color = pink })
	for _, dx in { -0.6, 0.6 } do
		P({ Name = "PiggyBody", Shape = Enum.PartType.Ball, Size = Vector3.new(3.6, 3.6, 3.6), CFrame = L(x + dx, by, z), Color = pink })
	end
	P({
		Name = "PiggySnout",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 1.4, 1.4),
		CFrame = L(fx + 1.85, by - 0.2, z),
		Color = pinkLight,
	})
	for _, dz in { -0.27, 0.27 } do
		decor(P({
			Name = "PiggyNostril",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 0.35, 0.35),
			CFrame = L(fx + 2.17, by - 0.2, z + dz),
			Color = pinkDeep,
		}))
	end
	for _, dz in { -0.75, 0.75 } do
		decor(P({
			Name = "PiggyEye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.5, 0.5, 0.5),
			CFrame = L(fx + 1.4, by + 0.75, z + dz),
			Color = ink,
		}))
		decor(P({
			Name = "PiggyEyeShine",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.18, 0.18, 0.18),
			CFrame = L(fx + 1.62, by + 0.86, z + dz * 0.94),
			Color = WHITE,
		}))
		decor(P({
			Name = "PiggyCheek",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.6, 0.6, 0.6),
			CFrame = L(fx + 1.25, by - 0.35, z + dz * 1.35),
			Color = pinkDeep:Lerp(WHITE, 0.25),
		}))
		-- Round ears: a pink disc with a coral inner disc, leaning back a little.
		local ear = L(x + 0.3, by + 1.65, z + dz * 1.33) * CFrame.Angles(dz * 0.4, 0, -0.3)
		decor(P({ Name = "PiggyEar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.1, 1.1), CFrame = ear, Color = pink }))
		decor(P({
			Name = "PiggyEar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 0.6, 0.6),
			CFrame = ear * CFrame.new(0.05, 0, 0),
			Color = pinkDeep,
		}))
	end

	-- Coin slot on the back.
	local slotX = x - 0.2
	local top = by + 1.8
	P({ Name = "PiggySlotRim", Size = Vector3.new(0.9, 0.2, 2), CFrame = L(slotX, top + 0.02, z), Color = WHITE })
	decor(P({ Name = "PiggySlot", Size = Vector3.new(0.36, 0.22, 1.6), CFrame = L(slotX, top + 0.04, z), Color = ink }))
	return slotX, top
end

-- Vault mesh: the middle of its coin slot opening (mesh units from the bounding-box base
-- centre, +Z = the pig's back); the slot runs across the pig.
local VAULT_SLOT = Vector3.new(0, 4.08, 0.28)

local function buildVault(B: Builder)
	local L, P = B.L, B.P
	local r = Layout.MACHINES.Vault
	local x = (r.minX + r.maxX) / 2
	local z = (r.minZ + r.maxZ) / 2
	local pink = worldColor("Pink", B.c.Accent)
	local ink = worldColor("Ink", B.c.PanelDark)
	local sunny = worldColor("Sunny", B.c.Primary)

	-- Teal plinth with a white rim.
	P({
		Name = "VaultBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 4.8, 4.8),
		CFrame = L(x, 0.3, z) * UPRIGHT,
		Color = worldColor("Teal", B.c.Good),
	})
	P({ Name = "VaultRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 5, 5), CFrame = L(x, 0.65, z) * UPRIGHT, Color = WHITE })

	-- The pig faces +X (toward the Collect pad); its profile faces the entrance. The mesh pig
	-- stands on the ring; its coin slot runs across its back (VAULT_SLOT).
	local slotX: number, top: number
	local pig = Props.mesh("Vault", L(x, 0.8, z) * CFrame.Angles(0, -math.pi / 2, 0), 1, B.folder)
	if pig then
		pig.Name = "PiggyMesh"
		Props.collider(B.folder, pig.CFrame, pig.Size)
		slotX, top = x - VAULT_SLOT.Z, 0.8 + VAULT_SLOT.Y
		-- The client sends coins into the slot and wobbles every "Piggy*" part.
		decor(P({
			Name = "PiggySlot",
			Size = Vector3.new(0.36, 0.22, 1.6),
			CFrame = L(slotX, top + 0.04, z),
			Transparency = 1,
			CanQuery = false,
		}))
	else
		slotX, top = buildPiggy(B, x, z, pink, ink)
	end

	-- A big sunny coin half-way in the slot.
	decor(P({
		Name = "CoinRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2.7, 2.7),
		CFrame = L(slotX, top + 0.7, z),
		Color = WHITE,
	}))
	local coin = decor(P({
		Name = "Coin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2.4, 2.4),
		CFrame = L(slotX, top + 0.7, z),
		Color = sunny,
	}))
	for _, face in { Enum.NormalId.Right, Enum.NormalId.Left } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.LightInfluence = 0.4
		gui.Parent = coin
		local mark = Instance.new("TextLabel")
		mark.BackgroundTransparency = 1
		mark.Size = UDim2.fromScale(1, 1)
		mark.Font = theme.Fonts.Title
		mark.TextScaled = true
		mark.Text = "$"
		mark.TextColor3 = ink
		mark.Parent = gui
	end

	-- Two little coin stacks at the pig's feet.
	for i, spot in { Vector3.new(1.9, 0.45, -1.95), Vector3.new(1.75, 0.7, 2) } do
		local h = spot.Y * 2
		P({
			Name = "CoinStack",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h, 1.2, 1.2),
			CFrame = L(x + spot.X, h / 2, z + spot.Z) * UPRIGHT,
			Color = sunny:Lerp(worldColor("Orange", sunny), if i == 1 then 0.15 else 0.05),
		})
		decor(P({
			Name = "CoinStackTop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.12, 0.8, 0.8),
			CFrame = L(x + spot.X, h + 0.04, z + spot.Z) * UPRIGHT,
			Color = WHITE,
		}))
	end
end

-- Unlockers: carnival high-strikers -------------------------------------------------------------

-- CrateCracker mesh: distance from the rect front (minX) to the mesh's bounding-box base centre.
-- Its plinth, puck track and bell then stand where the part-built ones do.
local CRACKER_FRONT = 2.88

local function buildUnlocker(B: Builder, rect: Rect, fallback: Color3)
	local L, P = B.L, B.P
	local vip = rect == Layout.MACHINES.Unlocker2
	-- Pastel teal booth; the VIP one is sunny.
	local color = if vip then worldColor("Sunny", fallback) else worldColor("PoolDeep", fallback)
	local tint = color:Lerp(WHITE, 0.55)
	local cream = worldColor("Cream", WHITE)
	local z = (rect.minZ + rect.maxZ) / 2
	local depth = rect.maxZ - rect.minZ
	local front = rect.minX
	local bodyMinX = rect.minX + 2.5
	local bodyX = (bodyMinX + rect.maxX) / 2
	local bodyW = rect.maxX - bodyMinX

	local booth = Props.mesh(
		if vip then "CrateCrackerVip" else "CrateCracker",
		L(front + CRACKER_FRONT, 0, z) * CFrame.Angles(0, math.pi / 2, 0),
		1,
		B.folder
	)
	if booth then
		-- The mesh's baked candy colours under a pastel wash (teal, VIP sunny).
		if vip then
			Props.overlay(booth, worldColor("Sunny", fallback), 0.45)
		else
			Props.overlay(booth, worldColor("Pool", fallback), 0.3)
		end
	end
	-- Plot-local spots the client animates: the ghost crate on the plinth, the puck's rest spot
	-- on the track and the bell (hidden with the mesh: its own bell stays put and the client's
	-- ring effect plays at the same spot).
	local holoY: number, puckX: number, bellX: number, bellY: number, bellD: number, bellTransparency: number
	if booth then
		holoY, puckX = 2.2, front + 2.15
		bellX, bellY, bellD, bellTransparency = front + 3, 16, 2.84, 1
		-- Booth and striker tower; the plinth and awning in front stay open.
		Props.collider(B.folder, L(front + 4.25, 7.6, z), Vector3.new(3.5, 15.2, 10.6))
	else
		holoY, puckX = 2.25, bodyMinX - 0.2
		bellX, bellY, bellD, bellTransparency = bodyMinX + 0.5, 15.7, 2, 0
		-- Soft white bumper and mat in front of the booth.
		P({
			Name = "Bumper",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(depth - 1.4, 0.9, 0.9),
			CFrame = L(front + 0.45, 0.45, z) * ALONG_Z,
			Color = WHITE,
		})
		for _, dz in { -1, 1 } do
			P({
				Name = "Bumper",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.9, 0.9, 0.9),
				CFrame = L(front + 0.45, 0.45, z + dz * (depth - 1.4) / 2),
				Color = WHITE,
			})
		end
		P({ Name = "ChamberFloor", Size = Vector3.new(2.6, 0.3, depth - 0.6), CFrame = L(front + 1.3, 0.15, z), Color = tint })

		-- Striker plinth with a bullseye top; the crate sits on it (HoloCrate = empty-slot ghost).
		P({
			Name = "HoloPad",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.9, 2.8, 2.8),
			CFrame = L(front + 1.3, 0.75, z) * UPRIGHT,
			Color = color,
		})
		P({
			Name = "HoloPadRim",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 3.1, 3.1),
			CFrame = L(front + 1.3, 1.1, z) * UPRIGHT,
			Color = WHITE,
		})
		decor(P({
			Name = "HoloPadEye",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 1.2, 1.2),
			CFrame = L(front + 1.3, 1.27, z) * UPRIGHT,
			Color = color,
		}))
	end

	decor(P({
		Name = "HoloCrate",
		Size = Vector3.new(1.8, 1.8, 2.4),
		CFrame = L(front + 1.3, holoY, z) * CFrame.Angles(0, math.rad(20), 0),
		Color = worldColor("Butter", tint),
		Transparency = 0.55,
	}))

	if not booth then
		-- Booth: cream body, teal kick band, white rim, bullseye target behind the crate.
		P({ Name = "Machine", Size = Vector3.new(bodyW, 7, depth - 0.6), CFrame = L(bodyX, 3.5, z), Color = cream })
		P({
			Name = "MachineKick",
			Size = Vector3.new(bodyW + 0.1, 0.8, depth - 0.5),
			CFrame = L(bodyX, 0.4, z),
			Color = worldColor("Teal", color),
		})
		P({ Name = "MachineRim", Size = Vector3.new(bodyW + 0.3, 0.4, depth - 0.2), CFrame = L(bodyX, 7.1, z), Color = WHITE })
		for i, ring in { { 4.2, color }, { 3, WHITE }, { 1.6, color } } do
			decor(P({
				Name = "Target",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.2 + i * 0.02, ring[1], ring[1]),
				CFrame = L(bodyMinX - 0.1 - i * 0.02, 3.8, z),
				Color = ring[2],
			}))
		end

		-- Sunny awning over the plinth with scalloped balls on the front edge.
		local stripes = 6
		local stripeW = (depth - 0.4) / stripes
		local slope = math.atan2(0.8, bodyMinX - front)
		local awningLen = (bodyMinX - front) / math.cos(slope) + 0.2
		for i = 1, stripes do
			local sz = z - (depth - 0.4) / 2 + (i - 0.5) * stripeW
			local stripeColor = worldColor("Sunny", color)
			P({
				Name = "Awning",
				Size = Vector3.new(awningLen, 0.3, stripeW),
				CFrame = L((front + bodyMinX) / 2, 6.7, sz) * CFrame.Angles(0, 0, slope),
				Color = stripeColor,
			})
			decor(P({
				Name = "AwningScallop",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.8, 0.8, 0.8),
				CFrame = L(front + 0.05, 6.25, sz),
				Color = stripeColor,
			}))
		end

		-- Striker tower: a tinted board with a white track and candy height ticks.
		P({ Name = "Backboard", Size = Vector3.new(1, 6.4, 8.6), CFrame = L(bodyMinX + 0.85, 10.4, z), Color = tint })
		local trackX = bodyMinX + 0.25
		P({ Name = "StrikerTrack", Size = Vector3.new(0.2, 5.6, 1.3), CFrame = L(trackX, 10.6, z), Color = WHITE })
		for i, key in { "TealLight", "Sunny", "Orange", "RedOrange" } do
			decor(P({
				Name = "StrikerTick",
				Size = Vector3.new(0.24, 0.3, 2.4),
				CFrame = L(trackX - 0.02, 9.1 + i * 1.05, z),
				Color = worldColor(key, color),
			}))
		end
	end
	-- The puck ("StrikerPuck", attribute Rise = studs to the top) the client sends up to the bell.
	local puckY = 9.3
	local puck = decor(P({
		Name = "StrikerPuck",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.1, 1.1, 1.1),
		CFrame = L(puckX, puckY, z),
		Color = worldColor("Sunny", color),
	}))
	puck:SetAttribute("Rise", 13.1 - puckY)

	if not booth then
		-- Candy-striped pillars and a marquee bar with bulbs.
		local pillarX = bodyMinX + 0.5
		local pillarZ = depth / 2 + 0.1
		for _, dz in { -1, 1 } do
			local pz = z + dz * pillarZ
			P({
				Name = "StrikerPillar",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(14, 1, 1),
				CFrame = L(pillarX, 7, pz) * UPRIGHT,
				Color = WHITE,
			})
			for y = 1.2, 13, 1.6 do
				decor(P({
					Name = "StrikerStripe",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.7, 1.08, 1.08),
					CFrame = L(pillarX, y, pz) * UPRIGHT,
					Color = color,
				}))
			end
			decor(P({
				Name = "StrikerKnob",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.4, 1.4, 1.4),
				CFrame = L(pillarX, 14.3, pz),
				Color = WHITE,
			}))
		end
		decor(P({
			Name = "StrikerMarquee",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(pillarZ * 2, 1.3, 1.3),
			CFrame = L(pillarX, 14, z) * ALONG_Z,
			Color = color,
		}))
		for i = -2, 2 do
			decor(P({
				Name = "StrikerBulb",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.55, 0.55, 0.55),
				CFrame = L(pillarX - 0.62, 14, z + i * 1.6),
				Color = cream,
			}))
		end
		-- A soft foam hammer leaning against the booth.
		local hz = z + 3.3
		local from = Vector3.new(front + 0.5, 0.3, hz)
		local to = Vector3.new(front + 1.6, 4, hz)
		local tilt = CFrame.Angles(0, 0, math.atan2(to.Y - from.Y, to.X - from.X))
		local mid = (from + to) / 2
		local len = (to - from).Magnitude
		decor(P({
			Name = "HammerHandle",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(len, 0.45, 0.45),
			CFrame = L(mid.X, mid.Y, mid.Z) * tilt,
			Color = worldColor("Wood", cream),
		}))
		decor(P({
			Name = "HammerGrip",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.1, 0.6, 0.6),
			CFrame = L(mid.X, mid.Y, mid.Z) * tilt * CFrame.new(-len / 2 + 0.7, 0, 0),
			Color = worldColor("RedOrange", color),
		}))
		local head = L(to.X, to.Y, to.Z) * tilt * CFrame.new(0.3, 0, 0)
		decor(P({
			Name = "HammerHead",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2.2, 1.6, 1.6),
			CFrame = head * ALONG_Z,
			Color = color,
		}))
		for _, dz in { -1.1, 1.1 } do
			decor(P({
				Name = "HammerCap",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.35, 1.72, 1.72),
				CFrame = head * CFrame.new(0, 0, dz) * ALONG_Z,
				Color = WHITE,
			}))
		end
	end

	-- The bell on top ("StrikerBell" model) swings when the puck reaches it.
	local bell = Instance.new("Model")
	bell.Name = "StrikerBell"
	bell.Parent = B.folder
	local sunny = worldColor("Sunny", B.c.Primary)
	decor(P({
		Name = "Bell",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(bellD, bellD, bellD),
		CFrame = L(bellX, bellY, z),
		Color = sunny,
		Transparency = bellTransparency,
		Parent = bell,
	}))
	decor(P({
		Name = "BellLip",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.45, bellD + 0.3, bellD + 0.3),
		CFrame = L(bellX, bellY - 0.65, z) * UPRIGHT,
		Color = sunny:Lerp(worldColor("Orange", sunny), 0.35),
		Transparency = bellTransparency,
		Parent = bell,
	}))
	decor(P({
		Name = "BellKnob",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		CFrame = L(bellX, bellY + bellD / 2 + 0.1, z),
		Color = WHITE,
		Transparency = bellTransparency,
		Parent = bell,
	}))
end

Machines.buildConverter = buildConverter
Machines.buildProcessor = buildProcessor
Machines.buildVault = buildVault
Machines.buildUnlocker = buildUnlocker

return Machines
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="203">
          <Properties>
            <string name="Name">MapDecor</string>
            <string name="Source"><![CDATA[--[[
	MapDecor: the sky scenery of a Parkour map, drawn from `level.PROPS` (Server.Modes.Course;
	contracts in docs/sky-obby.md and docs/parkour-maps.md). Every prop is a handful of chunky
	candy parts standing with its base at (x, y, z), front (-Z) turned `yaw` radians about Y,
	uniformly scaled by `scale` (islands use `r` instead). Kinds: `island` (floating grass disc,
	grass top at y), `lighthouse`, `windmill`, `tree` (standing on an island top), `balloon`
	(basket at y), `cloud` and `star` (centred at y), `rainbowarch` (feet at y), the anchor set
	pieces `loop` (a vertical rainbow ring on cloud puffs at y) and `spiral` (a rainbow stair
	round a pole, its cloud at y), and `landmark`
	(the map's one big themed set piece, 110-145 studs tall at Course.LANDMARK_SCALE[theme],
	drawn by LANDMARKS[theme] on top of its island). Decor never collides, queries or touches.

	Tags / attributes the client animates (Client.Fx.Modes):
	  MapBob        a hot-air balloon's envelope (root; the rest of the balloon is parented to it)
	  MapGlow       Neon lava of the volcano landmark and the lighthouse lamp
	  ModeMover     invisible spin roots with Mover = "spin", MoveSpeed, MovePhase (see
	                World.Modes): the shark landmark's fins stand `r` studs out along the root's
	                RightVector; a windmill's hub also has SpinAxis = "Z" (it turns about its
	                look vector, the axle) with the blades along its right/up vectors
	  Spin          (Model attribute, Client.Fx.Ambient) the gold stars turn slowly
	Part of the world generator; see Server.WorldBuilder for the overview.
]]

local Common = require(script.Parent.Common)
local Props = require(script.Parent.Props)
local Course = require(script.Parent.Parent.Modes.Course)

local make = Common.make
local UPRIGHT = Common.UPRIGHT
local W = Common.theme.World

local CYLINDER = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local NEON = Enum.Material.Neon

-- Warn when a map's scenery grows past this many parts.
local PART_BUDGET = 700

local ROCK = W.Steel:Lerp(W.WoodDark, 0.35)
-- One hue family per map (Server.Modes.Course PALETTES): volcano basalt + lava, storm slate +
-- volt yellow, shark deep teal, giga real gold.
local DARK_ROCK = W.Basalt:Lerp(W.Steel, 0.18)
local STORM_ROCK = W.Slate:Lerp(W.Ink, 0.2)
-- The storm cloud: light grey puffs (a dark one reads as a blob against the sky).
local STORM = W.StormCloud
local LAVA = W.Lava
local LAVA_HOT = W.Sunny:Lerp(W.Lava, 0.35)
local GOLD = W.Gold
local FIN = W.TealDeep:Lerp(W.Ink, 0.35)
-- Sky islands: bright candy grass, a dark-sand rim, brown trunks and wood.
local GRASS = W.Grass:Lerp(W.RainbowGreen, 0.45)
local RIM_SAND = W.SandDark:Lerp(W.WoodDark, 0.5):Lerp(W.Terracotta, 0.15)
local TRUNK = W.Terracotta:Lerp(W.Ink, 0.45)

type Prop = { kind: string, x: number, y: number, z: number, yaw: number?, scale: number?, r: number?, speed: number? }

-- A part maker in a prop's frame: positions in `cf` and sizes are in unscaled prop units.
type Kit = {
	base: CFrame,
	s: number,
	parent: Instance,
	theme: string,
	block: (name: string, size: Vector3, cf: CFrame, col: Color3, extra: { [string]: any }?) -> BasePart,
	cyl: (name: string, length: number, diameter: number, cf: CFrame, col: Color3, extra: { [string]: any }?) -> BasePart,
	ball: (name: string, d: number, cf: CFrame, col: Color3, extra: { [string]: any }?) -> BasePart,
	wedge: (name: string, size: Vector3, cf: CFrame, col: Color3, extra: { [string]: any }?) -> BasePart,
}

local MapDecor = {}

-- Helpers -------------------------------------------------------------------------------

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function up(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z) * UPRIGHT
end

-- Frame at the midpoint of a..b with X (a cylinder's axis) along a -> b.
local function between(a: Vector3, b: Vector3): CFrame
	local x = (b - a).Unit
	local u = if math.abs(x.Z) < 0.9 then Vector3.new(0, 0, 1) else Vector3.new(1, 0, 0)
	local y = u:Cross(x).Unit
	return CFrame.fromMatrix((a + b) / 2, x, y, x:Cross(y))
end

local function kit(base: CFrame, s: number, parent: Instance, theme: string): Kit
	local function put(className: string, name: string, size: Vector3, cf: CFrame, col: Color3, extra: { [string]: any }?): BasePart
		local props: { [string]: any } = {
			Name = name,
			Size = size * s,
			CFrame = base * CFrame.new(cf.Position * s) * cf.Rotation,
			Color = col,
			CastShadow = true,
			Parent = parent,
		}
		if extra then
			for key, value in extra do
				props[key] = value
			end
		end
		local p = make(className, props)
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		return p
	end
	local function shaped(shape: Enum.PartType, extra: { [string]: any }?): { [string]: any }
		local props: { [string]: any } = { Shape = shape }
		if extra then
			for key, value in extra do
				props[key] = value
			end
		end
		return props
	end
	return {
		base = base,
		s = s,
		parent = parent,
		theme = theme,
		block = function(name, size, cf, col, extra)
			return put("Part", name, size, cf, col, extra)
		end,
		cyl = function(name, length, diameter, cf, col, extra)
			return put("Part", name, Vector3.new(length, diameter, diameter), cf, col, shaped(CYLINDER, extra))
		end,
		ball = function(name, d, cf, col, extra)
			return put("Part", name, Vector3.new(d, d, d), cf, col, shaped(BALL, extra))
		end,
		wedge = function(name, size, cf, col, extra)
			return put("WedgePart", name, size, cf, col, extra)
		end,
	}
end

-- Deterministic per-prop randomness (the same map always looks the same).
local function rng(p: Prop): Random
	return Random.new(math.floor(p.x * 7 + p.z * 13 + p.y * 3))
end

local function rockColor(theme: string): Color3
	return if theme == "volcano" then DARK_ROCK elseif theme == "storm" then STORM_ROCK else ROCK
end

-- Prop builders -------------------------------------------------------------------------

local BUILDERS: { [string]: (k: Kit, p: Prop) -> () } = {}
-- Pieces the landmarks reuse (never drawn straight from level.PROPS).
local PIECES: { [string]: (k: Kit, p: Prop) -> () } = {}

-- A tall palm leaning toward its front-right with drooping fronds and coconuts (11 parts).
PIECES.palm = function(k, _p)
	local trunk = {
		Vector3.new(0, -0.5, 0),
		Vector3.new(0.5, 4, 0),
		Vector3.new(1.5, 8, 0),
		Vector3.new(3, 11.5, 0),
	}
	for i = 1, 3 do
		local a, b = trunk[i], trunk[i + 1]
		k.cyl("PalmTrunk", (b - a).Magnitude + 0.4, 1.7 - i * 0.2, between(a, b), if i == 2 then W.WoodDark else W.Wood)
	end
	local top = trunk[4]
	k.ball("PalmCrown", 1.8, CFrame.new(top), W.GrassDark)
	for _, offset in { Vector3.new(0.6, -0.8, -0.5), Vector3.new(-0.5, -0.9, 0.4) } do
		k.ball("Coconut", 1, CFrame.new(top + offset), W.WoodDark)
	end
	for i = 1, 5 do
		local yaw = math.rad(i * 72 + 15)
		local droop = math.rad(if i % 2 == 0 then 36 else 24)
		local frame = CFrame.new(top) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-droop, 0, 0) * CFrame.new(0, 0, -3)
		k.block("PalmFrond", Vector3.new(2.2, 0.4, 6.6), frame, if i % 2 == 0 then W.Grass else W.GrassDark)
	end
end

-- A red-and-white striped lighthouse on a rock base with a glowing lamp (15 parts).
BUILDERS.lighthouse = function(k, _p)
	k.cyl("LighthouseRock", 3, 11, up(0, 0.5, 0), rockColor(k.theme))
	local y, d = 2, 6.4
	for i = 1, 5 do
		local h = 3.4
		k.cyl("LighthouseTower", h, d, up(0, y + h / 2, 0), if i % 2 == 1 then W.White else W.Coral)
		y += h
		d -= 0.45
	end
	k.block("LighthouseDoor", Vector3.new(1.8, 2.8, 0.4), at(0, 3.4, -3.05), W.TealDeep)
	k.cyl("LighthouseWindow", 0.3, 1.1, at(0, 10.5, -2.75) * CFrame.Angles(0, math.rad(90), 0), W.TealLight)
	k.cyl("LighthouseWindow", 0.3, 1.1, at(0, 17.3, -2.3) * CFrame.Angles(0, math.rad(90), 0), W.TealLight)
	k.cyl("LighthouseGallery", 0.7, d + 2.2, up(0, y + 0.35, 0), W.Steel)
	local lamp = k.cyl("LighthouseLamp", 3, d - 0.6, up(0, y + 2.2, 0), W.Butter, { Material = NEON })
	lamp:AddTag("MapGlow")
	k.cyl("LighthouseLampBand", 0.4, d - 0.3, up(0, y + 2.2, 0), W.Steel)
	k.cyl("LighthouseRoof", 1.2, d + 0.6, up(0, y + 4.2, 0), W.Coral)
	k.cyl("LighthouseRoof", 1, d - 1.2, up(0, y + 5.2, 0), W.Coral)
	k.ball("LighthouseTip", 1.2, at(0, y + 6.2, 0), W.Sunny)
end

-- A shark fin circling the prop's spot (4 parts): an invisible ModeMover spin root at the
-- centre, the fin `r` studs out along the root's RightVector and its shadow and wake.
PIECES.fin = function(k, p)
	local r = p.r or 10
	local speed = p.speed or 0.6
	local root = make("Part", {
		Name = "SharkFinRoot",
		Size = Vector3.new(1, 1, 1),
		CFrame = k.base,
		Transparency = 1,
		CastShadow = false,
		Parent = k.parent,
	})
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root:SetAttribute("Mover", "spin")
	root:SetAttribute("MoveSpeed", speed)
	root:SetAttribute("MovePhase", tonumber((p :: any).phase) or 0)
	root:AddTag("ModeMover")
	-- Positive spin carries +X toward -Z: the wedge's low front (-Z) leads.
	local heading = if speed < 0 then CFrame.Angles(0, math.pi, 0) else CFrame.identity
	local at0 = CFrame.new(r, 0, 0) * heading
	local s = k.s
	local function child(name: string, className: string, size: Vector3, cf: CFrame, col: Color3, extra: { [string]: any })
		local props: { [string]: any } = { Name = name, Size = size * s, CFrame = k.base * at0 * cf, Color = col, Parent = root }
		for key, value in extra do
			props[key] = value
		end
		local part = make(className, props)
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end
	child("SharkFin", "WedgePart", Vector3.new(0.5, 3.4, 3.4), CFrame.new(0, 1.6 * s, 0.4 * s), FIN, {})
	child(
		"SharkShadow",
		"Part",
		Vector3.new(2.2, 0.1, 7.5),
		CFrame.new(0, 0.08, 1.2 * s),
		W.Ink,
		{ Transparency = 0.6, CastShadow = false }
	)
	child("SharkWake", "Part", Vector3.new(1.4, 0.12, 4.5), CFrame.new(0, 0.12, 4 * s), W.White, { CastShadow = false })
end

-- The gold Giga statue on a cream pedestal: the uploaded mesh when it is available, else a
-- clear chunky figure cheering with both arms up: gold torso and head, deeper gold limbs,
-- belt and hair, ink eyes and smile (2 or 21 parts).
local GOLD_DEEP = W.GoldDeep
PIECES.statue = function(k, _p)
	local pedestal = 2.4
	k.block("StatuePedestal", Vector3.new(8, pedestal, 8), at(0, pedestal / 2, 0), W.Cream)
	local gold = { Reflectance = 0.12, Material = Enum.Material.SmoothPlastic }
	if Props.has("GigaStatue") and Props.mesh("GigaStatue", k.base * CFrame.new(0, pedestal * k.s, 0), k.s, k.parent) then
		return
	end
	local y = pedestal
	for _, sx in { -1, 1 } do
		k.block("StatueFoot", Vector3.new(2.4, 1, 3.2), at(sx * 1.5, y + 0.5, -0.3), GOLD_DEEP, gold)
		k.block("StatueLeg", Vector3.new(2.2, 5.4, 2.4), at(sx * 1.5, y + 3.6, 0), GOLD_DEEP, gold)
	end
	k.block("StatueBelt", Vector3.new(6, 1.2, 3.2), at(0, y + 6.8, 0), GOLD_DEEP, gold)
	k.block("StatueTorso", Vector3.new(5.6, 4.6, 3), at(0, y + 9.6, 0), GOLD, gold)
	k.block("StatueChest", Vector3.new(7, 2.4, 3.2), at(0, y + 11.6, 0), GOLD, gold)
	k.block("StatueNeck", Vector3.new(1.6, 0.8, 1.6), at(0, y + 13.2, 0), GOLD_DEEP, gold)
	local head = y + 15.2
	k.block("StatueHead", Vector3.new(3.8, 3.6, 3.6), at(0, head, 0), GOLD, gold)
	k.block("StatueHair", Vector3.new(4, 1, 4), at(0, head + 2.1, 0.1), GOLD_DEEP, gold)
	for _, sx in { -1, 1 } do
		k.block("StatueEye", Vector3.new(0.6, 0.9, 0.2), at(sx * 0.8, head + 0.4, -1.85), W.Ink)
	end
	k.block("StatueSmile", Vector3.new(1.6, 0.3, 0.2), at(0, head - 0.8, -1.85), W.Ink)
	-- Arms up in a V: shoulder -> elbow -> fist.
	for _, sx in { -1, 1 } do
		local shoulder = Vector3.new(sx * 3.7, y + 12, 0)
		local elbow = Vector3.new(sx * 5.6, y + 15.4, 0)
		local fist = Vector3.new(sx * 6.4, y + 19, 0)
		k.block(
			"StatueUpperArm",
			Vector3.new(1.9, (elbow - shoulder).Magnitude + 1, 1.9),
			CFrame.lookAt((shoulder + elbow) / 2, elbow, Vector3.zAxis) * CFrame.Angles(math.pi / 2, 0, 0),
			GOLD_DEEP,
			gold
		)
		k.block(
			"StatueForearm",
			Vector3.new(1.8, (fist - elbow).Magnitude + 0.8, 1.8),
			CFrame.lookAt((elbow + fist) / 2, fist, Vector3.zAxis) * CFrame.Angles(math.pi / 2, 0, 0),
			GOLD_DEEP,
			gold
		)
		k.ball("StatueFist", 2.4, CFrame.new(fist), GOLD, gold)
	end
end

-- Bunting: two posts with a sagging rope of pennants (11 parts). `r` = half the span.
PIECES.flagline = function(k, p)
	local half = p.r or 7
	local postH = 8
	for _, sx in { -1, 1 } do
		k.cyl("BuntingPost", postH, 0.6, up(sx * half, postH / 2, 0), W.White)
		k.ball("BuntingCap", 1, at(sx * half, postH + 0.3, 0), W.Sunny)
	end
	local sag = postH - 1.2
	local left, mid, right = Vector3.new(-half, postH - 0.3, 0), Vector3.new(0, sag, 0), Vector3.new(half, postH - 0.3, 0)
	k.cyl("BuntingRope", (mid - left).Magnitude, 0.15, between(left, mid), W.White)
	k.cyl("BuntingRope", (right - mid).Magnitude, 0.15, between(mid, right), W.White)
	local colors = { W.Coral, W.Sunny, W.Mint, W.Blue, W.Pink }
	for i = 1, 5 do
		local x = -half + 2 * half * i / 6
		local ropeY = sag + (postH - 0.3 - sag) * math.abs(x) / half
		-- A wedge flipped upside down: horizontal top edge under the rope, point hanging.
		local frame = at(x, ropeY - 1, 0) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, math.pi)
		k.wedge("BuntingFlag", Vector3.new(0.12, 2, 1.6), frame, colors[i])
	end
end

-- Sky props ---------------------------------------------------------------------------------

-- A floating green island, `r` = radius, grass top at the prop's y: a grass disc, a dark-sand
-- rim band, a tapering rock cone hanging below and bushes on the edge (8-10 parts).
BUILDERS.island = function(k, p)
	local r = p.r or 12
	k.cyl("IslandGrass", 1.2, r * 2, up(0, -0.6, 0), GRASS)
	k.cyl("IslandRim", 1.8, r * 2 + 0.8, up(0, -1.9, 0), RIM_SAND)
	local y = -2.8
	for i, f in { 0.92, 0.7, 0.46, 0.22 } do
		local h = r * (0.32 - i * 0.03)
		k.cyl("IslandRock", h + 0.2, r * 2 * f, up(0, y - h / 2, 0), if i % 2 == 0 then ROCK else ROCK:Lerp(RIM_SAND, 0.25))
		y -= h
	end
	local rand = rng(p)
	for i = 1, if r >= 30 then 4 else 2 do
		local a = rand:NextNumber(0, 2 * math.pi)
		local d = math.min(r * 0.12 + 2, 7)
		k.ball(
			"IslandBush",
			d,
			at(math.cos(a) * (r - d * 0.6), d * 0.2, math.sin(a) * (r - d * 0.6)),
			if i == 1 then W.GrassDark else GRASS:Lerp(W.GrassDark, 0.4)
		)
	end
end

-- A round cartoon tree: brown trunk and three green canopy balls (4 parts).
BUILDERS.tree = function(k, _p)
	k.cyl("TreeTrunk", 6, 1.3, up(0, 3, 0), TRUNK)
	k.ball("TreeCanopy", 7.5, at(0, 8, 0), GRASS)
	k.ball("TreeCanopy", 5, at(-2.4, 6.6, 0.8), GRASS:Lerp(W.GrassDark, 0.35))
	k.ball("TreeCanopy", 4.6, at(2.2, 7, -0.9), GRASS:Lerp(W.White, 0.15))
end

-- A white windmill with a red cap and three sail blades on an invisible ModeMover spin root
-- (Mover = "spin", SpinAxis = "Z": the client turns it about its look vector, the axle).
-- Blades lie along the root's right/up vectors (13 parts).
BUILDERS.windmill = function(k, p)
	local y, d = 0, 6
	for i = 1, 3 do
		local h = 4.5
		k.cyl("WindmillTower", h, d, up(0, y + h / 2, 0), if i == 2 then W.Cream else W.White)
		y += h
		d -= 0.9
	end
	k.cyl("WindmillCap", 1.6, d + 1.2, up(0, y + 0.8, 0), W.RainbowRed)
	k.ball("WindmillCap", d + 0.6, at(0, y + 1.6, 0), W.RainbowRed)
	k.block("WindmillDoor", Vector3.new(1.8, 2.8, 0.4), at(0, 1.4, -2.95), TRUNK)
	local hub = at(0, y - 0.6, -(d / 2 + 1.2))
	local root = k.block("WindmillHub", Vector3.new(1, 1, 1), hub, W.White, { Transparency = 1, CastShadow = false })
	root:SetAttribute("Mover", "spin")
	root:SetAttribute("MoveSpeed", p.speed or 0.9)
	root:SetAttribute("MovePhase", 0)
	root:SetAttribute("SpinAxis", "Z")
	root:AddTag("ModeMover")
	k.cyl("WindmillAxle", 1.6, 0.7, hub * at(0, 0, 0.8) * CFrame.Angles(0, math.pi / 2, 0), TRUNK).Parent = root
	k.ball("WindmillBoss", 1.6, hub, W.RainbowYellow).Parent = root
	for i = 0, 2 do
		local blade = hub * CFrame.Angles(0, 0, math.pi / 2 + i * 2 * math.pi / 3)
		k.block("WindmillSpar", Vector3.new(8.5, 0.5, 0.4), blade * at(4.6, 0, 0), TRUNK).Parent = root
		k.block("WindmillSail", Vector3.new(6.5, 2.2, 0.2), blade * at(5.2, 1.2, 0.15), if i == 0 then W.RainbowRed else W.White).Parent =
			root
	end
end

-- A hot-air balloon with its basket at the prop's y: a red envelope ball wrapped in rainbow
-- bands, a pink skirt, four ropes and a wicker basket. The envelope is the MapBob root and
-- everything else rides on it (13 parts).
BUILDERS.balloon = function(k, _p)
	local cy, rr = 15, 6.5
	local root = k.ball("BalloonEnvelope", rr * 2, at(0, cy, 0), W.RainbowRed)
	root:AddTag("MapBob")
	local bands = { W.RainbowOrange, W.RainbowYellow, W.RainbowGreen, W.RainbowBlue, W.RainbowPurple }
	for i, col in bands do
		local h = (i - 3) * 2.3
		local d = 2 * math.sqrt(rr * rr - h * h) + 0.15
		k.cyl("BalloonBand", 1.1, d, up(0, cy + h, 0), col).Parent = root
	end
	k.cyl("BalloonSkirt", 2.4, 4.6, up(0, cy - rr - 0.2, 0), W.RainbowPink).Parent = root
	k.block("BalloonBasket", Vector3.new(3, 2.2, 3), at(0, 1.1, 0), TRUNK, { Material = Enum.Material.WoodPlanks }).Parent = root
	k.block("BalloonBasketRim", Vector3.new(3.3, 0.4, 3.3), at(0, 2.3, 0), W.Cream).Parent = root
	for _, v in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local a = Vector3.new(v[1] * 1.4, 2.4, v[2] * 1.4)
		local b = Vector3.new(v[1] * 1.8, cy - rr - 1.2, v[2] * 1.8)
		k.cyl("BalloonRope", (b - a).Magnitude, 0.18, between(a, b), W.WoodDark).Parent = root
	end
end

-- A soft white cloud of 3-5 overlapping balls centred on the prop's y.
BUILDERS.cloud = function(k, p)
	local puffs = {
		{ 0, 0, 0, 11 },
		{ -6.5, -1.2, 0.6, 8 },
		{ 6.8, -1.4, -0.4, 8.4 },
		{ -2.6, 2.8, -0.6, 7.2 },
		{ 3.2, 2.4, 0.8, 6.6 },
	}
	local n = rng(p):NextInteger(3, 5)
	for i = 1, n do
		local v = puffs[i]
		k.ball("CloudPuff", v[4], at(v[1], v[2], v[3]), W.Cloud, {
			Material = Enum.Material.SmoothPlastic,
			CastShadow = false,
		})
	end
end

-- A gold 5-point star standing upright, centred on the prop's y: a hub disc and five diamond
-- blocks whose outer halves form the points, in a Model that slowly spins (6 parts).
BUILDERS.star = function(k, _p)
	local model = Instance.new("Model")
	model.Name = "Star"
	model:SetAttribute("Spin", 0.6)
	local sk = kit(k.base, k.s, model, k.theme)
	local gold = { Material = Enum.Material.SmoothPlastic, Reflectance = 0.15 }
	model.PrimaryPart = sk.cyl("StarHub", 1, 4.2, CFrame.Angles(0, math.pi / 2, 0), GOLD, gold)
	for i = 0, 4 do
		local a = math.pi / 2 + i * 2 * math.pi / 5
		sk.block(
			"StarPoint",
			Vector3.new(2.7, 2.7, 0.8),
			CFrame.Angles(0, 0, a) * at(2.3, 0, 0) * CFrame.Angles(0, 0, math.pi / 4),
			GOLD,
			gold
		)
	end
	model.Parent = k.parent
end

-- A rainbow arch standing on its feet at the prop's y: seven concentric half-circle bands
-- (red outside to purple inside) of four segments each (six when scaled up big), and a cloud
-- puff on each foot (30-44 parts). Course.ARCH_FEET mirrors the feet.
local ARCH_COLORS = { "RainbowRed", "RainbowOrange", "RainbowYellow", "RainbowGreen", "RainbowCyan", "RainbowBlue", "RainbowPurple" }
BUILDERS.rainbowarch = function(k, _p)
	local outer, band, segments = 20, 1.6, if k.s > 1.5 then 6 else 4
	for i, key in ARCH_COLORS do
		local r = outer - (i - 1) * band
		local chord = 2 * r * math.sin(math.pi / (2 * segments)) + 0.5
		for j = 0, segments - 1 do
			local m = math.pi * (j + 0.5) / segments
			k.block(
				"RainbowBand",
				Vector3.new(chord, band + 0.05, 1.4 + (i % 2) * 0.1 + (j % 2) * 0.2),
				at(r * math.cos(m), r * math.sin(m), 0) * CFrame.Angles(0, 0, m + math.pi / 2),
				W[key]
			)
		end
	end
	for _, sx in { -1, 1 } do
		k.ball("RainbowCloud", 9, at(sx * (outer - 3 * band), 1.5, 0), W.Cloud, { CastShadow = false })
	end
end

-- A vertical rainbow loop standing on two cloud puffs at the prop's y, facing its front: seven
-- concentric full rings (red outside to purple inside, outer radius 20) of eight segments
-- each (58 parts).
BUILDERS.loop = function(k, _p)
	local outer, band, segments = 20, 1.6, 8
	local cy = outer + 1
	for i, key in ARCH_COLORS do
		local r = outer - (i - 1) * band
		local chord = 2 * r * math.sin(math.pi / segments) + 0.5
		for j = 0, segments - 1 do
			local m = 2 * math.pi * (j + 0.5) / segments
			k.block(
				"RainbowLoop",
				Vector3.new(chord, band + 0.05, 1.6 + (i % 2) * 0.1 + (j % 2) * 0.2),
				at(r * math.cos(m), cy + r * math.sin(m), 0) * CFrame.Angles(0, 0, m + math.pi / 2),
				W[key]
			)
		end
	end
	for _, sx in { -1, 1 } do
		k.ball("LoopCloud", 9, at(sx * 4, 1.5, 0), W.Cloud, { CastShadow = false })
	end
end

-- A spiral rainbow stair: 24 thin candy steps climbing 30 units in two turns around a white
-- pole on a cloud puff, a gold ball on top (28 parts).
local SPIRAL_COLORS =
	{ "RainbowRed", "RainbowOrange", "RainbowYellow", "RainbowGreen", "RainbowCyan", "RainbowBlue", "RainbowPurple", "RainbowPink" }
BUILDERS.spiral = function(k, _p)
	local steps, rise = 24, 30
	k.ball("SpiralCloud", 12, at(0, 0, 0), W.Cloud, { CastShadow = false })
	k.cyl("SpiralPole", rise + 4, 1.6, up(0, (rise + 4) / 2 + 1, 0), W.White)
	for i = 1, steps do
		local a = (i - 1) * 4 * math.pi / steps
		local y = 2 + (i - 1) * rise / (steps - 1)
		k.block(
			"SpiralStep",
			Vector3.new(8, 0.6, 2.8),
			CFrame.Angles(0, a, 0) * at(4.6, y, 0) * CFrame.Angles(0, math.rad(-8), 0),
			W[SPIRAL_COLORS[(i - 1) % #SPIRAL_COLORS + 1]]
		)
	end
	k.ball("SpiralTop", 3, at(0, rise + 6, 0), GOLD, { Reflectance = 0.12 })
end

-- Landmarks ------------------------------------------------------------------------------
-- Sizes below are prop units at scale 1; Course.LANDMARK_SCALE[theme] scales each to 110-145 studs.

-- A kit for a sub-prop standing at `cf` (prop units) in `k`'s frame, scaled by `scale`.
local function sub(k: Kit, cf: CFrame, scale: number): Kit
	return kit(k.base * CFrame.new(cf.Position * k.s) * cf.Rotation, k.s * scale, k.parent, k.theme)
end

-- Prop units the landmark's foundation sinks into the island it stands on.
local function sink(_k: Kit): number
	return 1.5
end

-- An upright disc sunk a little into the island up to `top` (prop units), `d` wide.
local function foundation(k: Kit, d: number, top: number, col: Color3, name: string?): BasePart
	local bottom = -sink(k)
	return k.cyl(name or "LandmarkFoot", top - bottom, d, up(0, (top + bottom) / 2, 0), col)
end

local function glow(part: BasePart): BasePart
	part:AddTag("MapGlow")
	return part
end

local LANDMARKS: { [string]: (k: Kit, p: Prop) -> () } = {}

-- A giant striped beach umbrella beside a tower of beach balls, a towel and a sandcastle (38 parts).
LANDMARKS.beach = function(k, _p)
	foundation(k, 30, 0.4, W.Sand)
	local pole = at(-1, 0, 1) * CFrame.Angles(math.rad(-2), 0, math.rad(2))
	k.cyl("GiantUmbrellaPole", 42, 1.4, pole * up(0, 21, 0), W.White)
	for i = 1, 3 do
		k.cyl("GiantUmbrellaPoleBand", 1.6, 1.6, pole * up(0, 6 + i * 7, 0), W.Coral)
	end
	for i, c in { { 26, W.Coral }, { 21, W.White }, { 15.5, W.Coral }, { 9.5, W.White } } do
		k.cyl("GiantUmbrellaCanopy", 1.3, c[1], pole * up(0, 36 + i * 1.1, 0), c[2] :: Color3)
	end
	k.ball("GiantUmbrellaTop", 3.2, pole * at(0, 42.4, 0), W.Sunny)
	for i = 0, 7 do
		local a = i * math.pi / 4
		k.ball("GiantUmbrellaFringe", 2.2, pole * at(math.cos(a) * 12.2, 36.3, math.sin(a) * 12.2), if i % 2 == 0 then W.Sunny else W.Coral)
	end
	local y = 0
	for i, d in { 11, 8.5, 6 } do
		local centre = at(7, y + d / 2, -6) * CFrame.Angles(0, math.rad(i * 25), 0)
		k.ball("BallTower", d, centre, W.White)
		for j, col in { W.Coral, W.Sunny, W.Blue } do
			k.cyl("BallTowerBand", d * 0.25, d + 0.1 + j * 0.15, centre * CFrame.Angles(0, math.rad(j * 60), 0), col)
		end
		y += d - 1
	end
	local towel = at(-8, 0.55, -7) * CFrame.Angles(0, math.rad(20), 0)
	k.block("GiantTowel", Vector3.new(5.5, 0.3, 10), towel, W.Blue)
	for _, z in { -2.8, 2.8 } do
		k.block("GiantTowelStripe", Vector3.new(5.6, 0.4, 1.2), towel * at(0, 0, z), W.White)
	end
	k.block("SandCastle", Vector3.new(6, 3, 6), at(8, 1.9, 8), W.SandDark)
	for _, v in { { 5.6, 5.6 }, { 10.4, 10.4 }, { 10.4, 5.6 } } do
		k.cyl("SandCastleTower", 5, 2.6, up(v[1], 2.9, v[2]), W.Sand)
	end
	k.wedge("SandCastleFlag", Vector3.new(0.2, 1.6, 2), at(10.4, 6.4, 10.4), W.Coral)
end

-- A tall rock arch of stacked blocks with two palms on its grassy top (38 parts).
LANDMARKS.cove = function(k, p)
	local col = rockColor(k.theme)
	local light = col:Lerp(W.Sand, 0.25)
	foundation(k, 30, 0.6, light)
	for _, sx in { -1, 1 } do
		local stack = { { 8, 10, 8, 5, -4 }, { 7, 9.5, 7.4, 14.5, 3 }, { 7.6, 9, 7, 23.5, -2 } }
		for i, b in stack do
			k.block(
				"GiantArchPillar",
				Vector3.new(b[1], b[2], b[3]),
				at(sx * (8 + (i % 2) * 0.4), b[4], (i - 2) * 0.3) * CFrame.Angles(0, 0, math.rad(b[5] * sx)),
				if (i + (sx + 1) / 2) % 2 == 0 then col else light
			)
		end
		k.ball("GiantArchBoulder", 5.6, at(sx * 12.5, 1.6, -4), light)
		k.ball("GiantArchBoulder", 4.4, at(sx * 12, 1.2, 5), col)
	end
	k.block("GiantArchLintel", Vector3.new(25, 6.5, 8.5), at(0, 30.5, 0) * CFrame.Angles(0, 0, math.rad(2)), col)
	k.block("GiantArchGrass", Vector3.new(21, 1.6, 7), at(0, 34.4, 0), W.Grass)
	for _, x in { -3, 4 } do
		k.block("GiantArchVine", Vector3.new(1.2, 7, 0.6), at(x, 25, -4.3), W.GrassDark)
	end
	PIECES.palm(sub(k, at(-6, 35, 0) * CFrame.Angles(0, 0.6, 0), 1.35), p)
	PIECES.palm(sub(k, at(6.5, 35, 0.5) * CFrame.Angles(0, 3.4, 0), 1.2), p)
end

-- A 46-unit navy-and-white lighthouse on a rock with a glowing lamp, its beam and a ring of
-- bobbing buoys (43 parts).
LANDMARKS.bay = function(k, _p)
	local rock = rockColor(k.theme)
	foundation(k, 22, 2, rock)
	for i = 0, 1 do
		local a = math.rad(i * 150 + 40)
		k.ball("LighthouseBoulder", 5, at(math.cos(a) * 9, 1.5, math.sin(a) * 9), rock:Lerp(W.Sand, 0.2))
	end
	local y, d = 2, 11
	for i = 1, 7 do
		k.cyl("GiantLighthouseTower", 5, d, up(0, y + 2.5, 0), if i % 2 == 1 then W.White else W.Navy)
		y += 5
		d -= 0.6
	end
	k.block("GiantLighthouseDoor", Vector3.new(3, 4.5, 0.6), at(0, 4.25, -5.5), W.Sunny)
	for i, wy in { 14.5, 24.5, 34.5 } do
		local r = (11 - 0.6 * math.floor((wy - 2) / 5)) / 2
		k.cyl(
			"GiantLighthouseWindow",
			0.4,
			1.8,
			at(0, wy, -r - 0.05) * CFrame.Angles(0, math.rad(90), 0),
			if i == 2 then W.Sunny else W.TealLight
		)
	end
	k.cyl("GiantLighthouseGallery", 1, 11.5, up(0, y + 0.5, 0), W.Steel)
	glow(k.cyl("GiantLighthouseLamp", 4.5, 6.4, up(0, y + 3.25, 0), W.Butter, { Material = NEON }))
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		k.block("GiantLighthouseFrame", Vector3.new(0.5, 4.6, 0.5), at(math.cos(a) * 3.3, y + 3.25, math.sin(a) * 3.3), W.Steel)
	end
	k.block("GiantLighthouseBeam", Vector3.new(2.6, 2.6, 12), at(0, y + 3.25, -9.3), W.Butter, {
		Material = NEON,
		Transparency = 0.6,
		CastShadow = false,
	})
	for i, c in { { 1.4, 8.4 }, { 1.2, 5.6 }, { 1, 3 } } do
		k.cyl("GiantLighthouseRoof", c[1], c[2], up(0, y + 5.5 + i * 1.2, 0), W.Navy)
	end
	k.ball("GiantLighthouseTip", 1.6, at(0, y + 10, 0), W.Sunny)
	for i = 0, 5 do
		local a = i * math.pi / 3 + 0.3
		local root =
			k.cyl("LighthouseBuoy", 1.6, 3, up(math.cos(a) * 12.5, 0.8, math.sin(a) * 12.5), if i % 2 == 0 then W.Navy else W.Sunny)
		root:AddTag("MapBob")
		k.cyl("LighthouseBuoyBand", 0.5, 3.1, up(math.cos(a) * 12.5, 0.9, math.sin(a) * 12.5), W.White).Parent = root
		k.ball("LighthouseBuoyLight", 1, at(math.cos(a) * 12.5, 2.1, math.sin(a) * 12.5), W.Sunny, { Material = NEON }).Parent = root
	end
end

-- A hot-pink coral tower: stacked tubes with branching teal/pink arms, fans and anemones (30 parts).
LANDMARKS.reef = function(k, _p)
	foundation(k, 26, 0.6, W.Pink:Lerp(W.Sand, 0.6))
	for i = 0, 2 do
		local a = math.rad(i * 120 + 30)
		k.ball("CoralTowerRock", 7 - i, at(math.cos(a) * 7, 1.2, math.sin(a) * 7), W.SandDark:Lerp(W.Steel, 0.2))
	end
	local y = 0
	for i, t in { { 7, 12, W.HotPink, 0 }, { 6, 11, W.Pink, 0.6 }, { 5, 10, W.HotPink, -0.4 }, { 4, 9, W.Pink, 0.5 } } do
		k.cyl("CoralTowerTube", t[2] + 0.6, t[1], up(t[4], y + t[2] / 2, 0), t[3])
		y += t[2]
		if i == 4 then
			k.ball("CoralTowerTip", 5, at(t[4], y + 0.5, 0), W.HotPink:Lerp(W.White, 0.25))
		end
	end
	local arms = { W.Teal, W.HotPink, W.TealLight, W.Teal, W.Pink, W.TealLight }
	for i, col in arms do
		local a = math.rad(i * 137.5)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local h = 3 + i * 5.5
		local from, to = dir * 2 + Vector3.new(0, h, 0), dir * 9 + Vector3.new(0, h + 6, 0)
		k.cyl("CoralTowerArm", (to - from).Magnitude, 2.4, between(from, to), col)
		k.ball("CoralTowerArmTip", 3.2, CFrame.new(to), col:Lerp(W.White, 0.3))
	end
	for i, f in { { 6, 11, W.Teal }, { 16, 10, W.Pink }, { 24, 9, W.TealLight }, { 30, 8, W.HotPink }, { 12, 9, W.TealLight } } do
		local a = math.rad(i * 72 + 15)
		k.cyl("CoralTowerFan", 0.4, f[2], at(math.cos(a) * 6.5, f[1], math.sin(a) * 6.5) * CFrame.Angles(0, -a, 0), f[3])
	end
	for i = 0, 3 do
		local a = math.rad(i * 90 + 60)
		k.cyl("CoralTowerAnemone", 2.5, 1.6, up(math.cos(a) * 10.5, 1.6, math.sin(a) * 10.5), if i % 2 == 0 then W.HotPink else W.Teal)
	end
end

-- A giant sky-blue open shell with a pearl, shooting a tall jet of MapBubble bubbles (30 parts).
LANDMARKS.bubble = function(k, p)
	foundation(k, 26, 0.5, W.SkyBlue:Lerp(W.White, 0.3))
	k.cyl("BubbleFountainFoam", 0.1, 24, up(0, 0.6, 0), W.White, { CastShadow = false })
	local shellCol = W.SkyBlue:Lerp(W.White, 0.2)
	k.cyl("GiantShell", 1.6, 18, up(0, 1.3, -1), shellCol)
	local hinge = at(0, 2, 7) * CFrame.Angles(math.rad(110), 0, 0)
	k.cyl("GiantShellLid", 1.2, 18, hinge * at(0, 0, -9) * UPRIGHT, shellCol)
	for i = -2, 2 do
		k.block("GiantShellRib", Vector3.new(0.9, 0.7, 9), hinge * CFrame.Angles(0, math.rad(i * 22), 0) * at(0, 0.8, -4.8), W.Blue)
	end
	k.ball("GiantPearl", 4, at(0, 3.8, -1), W.White, { Reflectance = 0.3 })
	k.cyl("BubbleJet", 38, 3.2, up(0, 24, -1), W.SkyBlue:Lerp(W.White, 0.35), { CastShadow = false })
	for i = 0, 6 do
		local a = i * math.pi / 3
		local r = if i == 6 then 0 else 3
		k.ball("BubbleCrown", if i == 6 then 5 else 4, at(math.cos(a) * r, if i == 6 then 44 else 42, math.sin(a) * r - 1), W.White, {
			CastShadow = false,
		})
	end
	local rand = rng(p)
	-- See-through bubbles each rise in their own lane round the jet, spaced so two never touch
	-- (even swaying): overlapping translucent parts flicker as the camera moves.
	local lanes = 12
	for i = 1, lanes do
		local a = i * 2 * math.pi / lanes
		local bubble = k.ball(
			"Bubble",
			rand:NextNumber(1.4, 1.8),
			at(math.cos(a) * 4.6, 3 + i * 3.2, math.sin(a) * 4.6 - 1),
			if i % 3 == 0 then W.Blue else if i % 3 == 1 then W.SkyBlue else W.White,
			{ Transparency = 0.45, Reflectance = 0.15, CastShadow = false }
		)
		bubble:SetAttribute("Rise", rand:NextNumber(4, 7))
		bubble:SetAttribute("Top", k.base.Y + (44 + rand:NextNumber(0, 4)) * k.s)
		bubble:AddTag("MapBubble")
	end
end

-- A tapering terracotta/orange coral spire with polyp bumps, staghorn branches and mint mounds (33 parts).
LANDMARKS.coral = function(k, _p)
	foundation(k, 28, 0.6, W.Terracotta:Lerp(W.Ink, 0.25))
	local y = 0
	local tierCols = { W.Terracotta, W.Orange, W.Apricot }
	for i, d in { 16, 13.5, 11.5, 9.5, 8, 6.5, 5, 3.6 } do
		k.cyl("CoralSpireTier", 6.4, d, up(0, y + 3, 0), tierCols[(i - 1) % 3 + 1])
		if i <= 8 then
			local a = math.rad(i * 100)
			k.ball(
				"CoralSpirePolyp",
				3,
				at(math.cos(a) * d / 2, y + 5.5, math.sin(a) * d / 2),
				({ W.Sunny, W.Mint, W.White })[(i - 1) % 3 + 1]
			)
		end
		y += 6
	end
	k.ball("CoralSpireTip", 3.2, at(0, y + 0.6, 0), W.Sunny)
	for i, h in { 10, 20, 30, 38 } do
		local a = math.rad(i * 90 + 45)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local r0 = (16 - h * 0.27) / 2
		local col = ({ W.Mint, W.Apricot, W.Sunny, W.Mint })[i]
		local p0, p1 = dir * (r0 - 0.5) + Vector3.new(0, h, 0), dir * (r0 + 4) + Vector3.new(0, h + 3, 0)
		local p2 = p1 + Vector3.new(0, 4.5, 0) + dir * 0.6
		k.cyl("CoralSpireBranch", (p1 - p0).Magnitude + 0.6, 1.6, between(p0, p1), col)
		k.cyl("CoralSpireBranch", (p2 - p1).Magnitude + 0.6, 1.4, between(p1, p2), col)
		k.ball("CoralSpireBranchTip", 2, CFrame.new(p2), col:Lerp(W.White, 0.3))
	end
	for i = 0, 2 do
		local a = math.rad(i * 120 + 10)
		k.ball("CoralSpireMound", 4.5, at(math.cos(a) * 10.5, 0.6, math.sin(a) * 10.5), W.Mint)
	end
end

-- Two giant shark fins leaning together into an arch over a dark swirl, splashes at their
-- feet and three fins circling it (ModeMover spin roots) (34 parts).
LANDMARKS.shark = function(k, p)
	foundation(k, 30, 0.3, W.Ocean:Lerp(W.Ink, 0.4))
	k.cyl("FinArchFoam", 0.1, 26, up(0, 0.4, 0), W.White, { CastShadow = false })
	for _, sx in { -1, 1 } do
		local frame = at(sx * 8, 0, 0) * CFrame.Angles(0, 0, sx * math.rad(11.5))
		k.wedge("GiantFin", Vector3.new(2.6, 41, 14), frame * at(0, 20.5, -7), FIN)
		k.wedge("GiantFin", Vector3.new(2.6, 41, 7), frame * at(0, 20.5, 3.5) * CFrame.Angles(0, math.pi, 0), W.TealDeep)
		k.block("GiantFinBelly", Vector3.new(2.8, 3, 18), frame * at(0, 1.5, -2), W.White:Lerp(W.Steel, 0.2))
		for j = 0, 2 do
			k.ball("FinArchSplash", 3 + j, at(sx * (9 + j * 1.5), 0.8, -6 + j * 5), W.White, { CastShadow = false })
		end
	end
	for i = 0, 2 do
		local fin = sub(k, at(0, 0.4, 0) * CFrame.Angles(0, i * 2 * math.pi / 3, 0), 1.3)
		PIECES.fin(fin, { kind = "fin", x = p.x, y = p.y, z = p.z, r = 10.5, speed = 0.45 })
	end
end

-- A rock spire with a lightning rod under a huge stacked storm cloud, a softly glowing
-- volt-yellow rod and cloud trim (MapGlow), and rain (27 parts).
LANDMARKS.storm = function(k, _p)
	foundation(k, 24, 0.5, STORM_ROCK)
	k.cyl("StormPuddle", 0.2, 20, up(0, 0.6, 0), W.Slate:Lerp(W.Ink, 0.3), { Reflectance = 0.25 })
	for i, b in { { 8, 7, 8, 3.5 }, { 6, 6, 6, 10 }, { 4, 5, 4, 15.5 } } do
		k.block(
			"StormSpire",
			Vector3.new(b[1], b[2], b[3]),
			at(0, b[4], 0) * CFrame.Angles(0, math.rad(i * 20), math.rad((i - 2) * 4)),
			STORM_ROCK:Lerp(W.Steel, 0.1 * i),
			{
				Material = Enum.Material.Slate,
			}
		)
	end
	k.cyl("StormRod", 7, 0.7, up(0, 21, 0), W.Volt, { Material = NEON }):AddTag("MapGlow")
	local puffs = {
		{ 0, 34, 0, 14 },
		{ -8, 33.5, 1, 10 },
		{ 8, 33, -1, 10 },
		{ -12, 32.5, 0, 7 },
		{ 12, 32.5, 1, 7 },
		{ -4, 40, 0, 12 },
		{ 5, 40, 1, 11 },
		{ -10, 38.5, -1, 7 },
		{ 10, 38.5, 0, 7.5 },
		{ 0, 46, 0, 10 },
		{ -5, 45, 1, 7 },
		{ 5, 45.5, -1, 7 },
	}
	for i, v in puffs do
		local col = if i % 3 == 0 then STORM:Lerp(W.Steel, 0.18) elseif i % 2 == 0 then STORM else STORM:Lerp(W.White, 0.3)
		k.ball("GiantStormPuff", v[4], at(v[1], v[2], v[3]), col, { Material = Enum.Material.SmoothPlastic })
	end
	k.block("GiantStormBase", Vector3.new(26, 2, 9), at(0, 31.5, 0), STORM:Lerp(W.Steel, 0.25), { Material = Enum.Material.SmoothPlastic })
	k.block("GiantStormTrim", Vector3.new(26.4, 0.6, 9.4), at(0, 30.6, 0), W.Volt, { Material = NEON, CastShadow = false })
		:AddTag("MapGlow")
	for i = 0, 5 do
		k.block(
			"GiantStormRain",
			Vector3.new(0.2, 20, 0.2),
			at(-10 + i * 4, 20, (i % 2) * 2 - 1) * CFrame.Angles(0, 0, math.rad(8)),
			W.Chrome,
			{
				Transparency = 0.6,
				CastShadow = false,
			}
		)
	end
end

-- A 40-unit stepped basalt volcano with a glowing crater, lava drips, rim rocks, smoke and a lava
-- moat (32 parts).
LANDMARKS.volcano = function(k, _p)
	local bottom = -sink(k)
	local tiers = { 30, 28, 24.5, 21, 18, 15.5, 13, 11 }
	for i, d in tiers do
		local y0 = if i == 1 then bottom else (i - 1) * 5
		local y1 = i * 5
		k.cyl("GiantVolcanoCone", y1 - y0, d, up(0, (y0 + y1) / 2, 0), if i % 2 == 0 then DARK_ROCK:Lerp(W.WoodDark, 0.2) else DARK_ROCK)
	end
	glow(k.cyl("GiantVolcanoMoat", 0.3, 31.5, up(0, 0.5, 0), LAVA, { Material = NEON }))
	glow(k.cyl("GiantVolcanoCrater", 0.6, 8.5, up(0, 40.1, 0), LAVA, { Material = NEON }))
	glow(k.cyl("GiantVolcanoCore", 0.6, 4.5, up(0, 40.25, 0), LAVA_HOT, { Material = NEON }))
	for i = 0, 4 do
		local a = math.rad(i * 72 + 20)
		k.ball("GiantVolcanoRim", 3, at(math.cos(a) * 5.2, 40.3, math.sin(a) * 5.2), DARK_ROCK:Lerp(W.Ink, 0.3))
	end
	for i = 0, 3 do
		local a = math.rad(i * 90 + 55)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local p0, p1, p2 = dir * 5.6 + Vector3.new(0, 40, 0), dir * 8 + Vector3.new(0, 30, 0), dir * 12.6 + Vector3.new(0, 15, 0)
		glow(k.cyl("GiantVolcanoDrip", (p1 - p0).Magnitude + 0.8, 1.8, between(p0, p1), LAVA_HOT, { Material = NEON }))
		glow(k.cyl("GiantVolcanoDrip", (p2 - p1).Magnitude + 0.8, 1.6, between(p1, p2), LAVA, { Material = NEON }))
		glow(k.ball("GiantVolcanoBlob", 2.4, CFrame.new(p2), LAVA, { Material = NEON }))
	end
	for i, v in { { 0, 45, 0, 6 }, { 2, 50.5, -1, 5 }, { -1, 54.5, 1, 4 }, { 1.5, 58, 0, 3 } } do
		k.ball("GiantVolcanoSmoke", v[4], at(v[1], v[2], v[3]), W.Steel:Lerp(W.White, 0.15 * i), {
			Transparency = 0.2 + 0.15 * i,
			CastShadow = false,
		})
	end
end

-- A stepped cream plinth with a gold trim and a giant gold Giga (the uploaded mesh scaled to ~34
-- studs when available, else the part-built figure doubled) and bunting front and back (26-36 parts).
LANDMARKS.giga = function(k, p)
	local bottom = -sink(k)
	k.block("GigaPlinth", Vector3.new(26, 3 - bottom, 26), at(0, (3 + bottom) / 2, 0), W.Cream:Lerp(W.Butter, 0.25))
	k.block("GigaPlinth", Vector3.new(21, 3, 21), at(0, 4.5, 0), W.Cream)
	k.block("GigaPlinth", Vector3.new(16, 2, 16), at(0, 7, 0), W.Cream:Lerp(W.White, 0.4))
	k.block("GigaPlinthTrim", Vector3.new(21.4, 0.5, 21.4), at(0, 6.1, 0), GOLD, { Reflectance = 0.12 })
	local size = if Props.has("GigaStatue") then Props.size("GigaStatue") else nil
	local mesh = size and Props.mesh("GigaStatue", k.base * CFrame.new(0, 8 * k.s, 0), k.s * 34 / size.Y, k.parent)
	if not mesh then
		PIECES.statue(sub(k, at(0, 8, 0), 2), p)
	end
	for _, z in { -10, 10 } do
		PIECES.flagline(
			sub(k, at(0, 3, z) * CFrame.Angles(0, if z > 0 then math.pi else 0, 0), 1.1),
			{ kind = "flagline", x = p.x, y = p.y, z = p.z, r = 10 }
		)
	end
end

-- The map's big landmark, drawn by theme (beach when the theme has no builder).
BUILDERS.landmark = function(k, p)
	local build = LANDMARKS[k.theme] or LANDMARKS.beach
	build(k, p)
end

-- Build -----------------------------------------------------------------------------------

-- Kinds sized by `r` (never scaled).
local BY_RADIUS = { island = true }
local warned: { [string]: boolean } = {}

-- Draws every `level.PROPS` entry into a "Scenery" folder under `folder`.
function MapDecor.build(level: Course.Level, folder: Instance)
	local props: { Prop } = (level :: any).PROPS or {}
	if #props == 0 then
		return
	end
	local theme: string = (level :: any).theme or "beach"
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	for _, p in props do
		local build = BUILDERS[p.kind]
		if build == nil then
			if not warned[p.kind] then
				warned[p.kind] = true
				warn(`[MapDecor] unknown prop kind "{p.kind}" skipped`)
			end
			continue
		end
		local base = CFrame.new(p.x, p.y, p.z) * CFrame.Angles(0, p.yaw or 0, 0)
		build(kit(base, if BY_RADIUS[p.kind] then 1 else p.scale or 1, scenery, theme), p)
	end
	local count = 0
	for _, d in scenery:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	if count > PART_BUDGET then
		warn(`[MapDecor] level {level.index} scenery has {count} parts (budget {PART_BUDGET})`)
	end
	scenery.Parent = folder
end

return MapDecor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="204">
          <Properties>
            <string name="Name">Modes</string>
            <string name="Source"><![CDATA[--[[
	Modes: the GAME MODES plaza on the hub's -X side (and its mirror, "Plaza2" on +X, when
	Course.PLAZA2 exists) and the Parkour sky obby high above the clouds (docs/sky-obby.md).

	Everything is placed from Server.Modes.Course (layout numbers) and Server.Modes.Catalog
	(one gate per mode slot). The server builds every part at its rest pose and never moves
	it; moving obstacles only carry attributes and Client code animates them:

	  Moving parts (tag "ModeMover"), anchored, attributes on the root part:
	    Mover        "slide" | "bob" | "spin"
	    MoveAxis     Vector3, unit world axis (slide/bob; bob is always 0, 1, 0)
	    MoveDistance studs: slide/bob travel +-MoveDistance from the rest position
	    MovePeriod   seconds per full back-and-forth cycle (slide/bob)
	    MoveSpeed    rad/s about the world up axis through the rest position (spin)
	    MovePhase    radians
	  With t = workspace:GetServerTimeNow() and rest = the part's CFrame as built:
	    slide/bob: CFrame = rest + MoveAxis * MoveDistance * sin(2*pi*t / MovePeriod + MovePhase)
	    spin:      CFrame = CFrame.new(rest.Position) * CFrame.Angles(0, MoveSpeed*t + MovePhase, 0) * rest.Rotation
	  Every BasePart descendant of the root moves rigidly with it. Spinner bars are
	  "SpinnerBar" roots with CanCollide = false and attribute Hazard = "bump": touching one
	  should give the local player a gentle push away and a small hop.
	  Bounce pads: parts named "BouncePad" (tag "BouncePad"), attribute Bounce = upward launch
	  speed in studs/s for the local player.

	  Blink pads: "BlinkPad" slabs (tag "BlinkPad"; the only part that fades, with four Neon
	  "BlinkGlow" bars round it as descendants), attributes BlinkOn, BlinkPeriod, BlinkPhase
	  (seconds): solid when ((t + BlinkPhase) % BlinkPeriod) < BlinkOn. The server never
	  toggles them; Client.Fx.Modes sets CanCollide and the look locally.

	  Kill bricks: "KillBrick" parts (tag "KillBrick", attribute Hazard = "kill"), a Neon Lava
	  core with black diagonal stripe bars as children, CanCollide/CanQuery/CanTouch false (the
	  server checks feet against Course.inKill). Sliding ones are the child of a "KillSlider"
	  ModeMover slide root (same attributes as moving platforms).

	Every level of Server.Modes.Course is built into Parkour/Level<i> (attributes Mode,
	Level, Title, LevelName, StageFirst, StageLast, and the map's Theme, Blurb,
	Icon, Accent). Platforms are bright SmoothPlastic candy slabs in their element's colour
	with a lighter lip and a thin white underside; Course.BRIDGES[i] (the rainbow stairs to the
	next map) go into Level<i>/Bridge, the cloud floor far below (Course.cloudLayer) into
	Level<i>/CloudFloor and the scenery (level.PROPS) is drawn by World.MapDecor into
	Level<i>/Scenery. Named parts the game looks up: "ParkourStart" (trigger in gate 1's
	opening; other open gates hold "ModeStart"), per level "ParkourFinish" (trigger over the
	finish deck) and "ParkourWater" (the catch volume at Course.FLOOR_Y), both with
	attribute Level. There are no checkpoints (a fall goes back to the map's start deck): the
	wide "RestDeck" pads where they stood are plain platforms. Every level is reached by teleport through gate 1's
	portal and gets a start arch on its start deck (map 1: the CHAD OBBY lobby); nothing of the
	course stands next to the plaza.
	Client hints (Client.Fx.Modes): each open gate's "GateArrow" root (tag "ModeHintArrow",
	attribute HintBob = bob height in studs, children move with it).

	Sign text is TextScaled; every sign face's PixelsPerStud is picked so its biggest label
	lands near 100 px tall (TextScaled's ceiling), which keeps it crisp without wasting texture.
	Part of the world generator; see Server.WorldBuilder for the overview.
]]

local Common = require(script.Parent.Common)
local MapDecor = require(script.Parent.MapDecor)
local Course = require(script.Parent.Parent.Modes.Course)
local Catalog = require(script.Parent.Parent.Modes.Catalog)

local theme = Common.theme
local mapFolder = Common.mapFolder
local make = Common.make
local UPRIGHT = Common.UPRIGHT
local ALONG_Z = Common.ALONG_Z

local W = theme.World
local CYLINDER = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
-- Yaw that turns a frame's front (-Z) toward +X (the hub).
local FACE_HUB = -math.pi / 2

local FLAG_COLORS = { W.Coral, W.Sunny, W.Mint, W.Blue, W.Pink, W.Grape }
-- Locked gates: desaturated blue-grey, and the mid grey card behind their white text.
local LOCKED = W.Steel
local LOCKED_CARD = W.Steel:Lerp(W.Ink, 0.3)
-- Half the bar-filled opening of a locked gate (the open gate uses Course.GATE_HALF).
local LOCKED_HALF = 4
-- Sky obby look (docs/sky-obby.md): platform lips are their top's colour this much lighter,
-- and map 1's lobby deck is a candy green checkerboard.
local SMOOTH = Enum.Material.SmoothPlastic
local LIP_TINT = 0.4
local LOBBY_GREEN = W.RainbowGreen:Lerp(W.Grass, 0.35)

export type Built = {
	folder: Folder,
	-- Rich-text list on the best-times board (Server.GameModes fills it).
	bestList: TextLabel,
}

local Modes = {}

-- Helpers -------------------------------------------------------------------------------

local function cube(d: number): Vector3
	return Vector3.new(d, d, d)
end

local function color(key: string?): Color3
	return (key and W[key]) or W.White
end

local function decor(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

-- An invisible trigger volume (touch only).
local function trigger(name: string, cframe: CFrame, size: Vector3, parent: Instance): BasePart
	local p = make("Part", {
		Name = name,
		Size = size,
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = parent,
	})
	p.CanTouch = true
	return p
end

local function surface(p: BasePart, face: Enum.NormalId, pixelsPerStud: number): Frame
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Parent = p
	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Parent = gui
	return root
end

local function panel(parent: Instance, fill: Color3, position: UDim2, size: UDim2, corner: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = fill
	f.BorderSizePixel = 0
	f.Position = position
	f.Size = size
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(corner or 0.08, 0)
	c.Parent = f
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = theme.Fonts.Display
	l.TextColor3 = W.Ink
	l.Size = UDim2.fromScale(1, 1)
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

-- A sign card face: cream/white card, coloured header band with `header` text and a big
-- Ink `title` below.
local function cardFace(
	p: BasePart,
	face: Enum.NormalId,
	pps: number,
	fill: Color3,
	band: Color3,
	header: string,
	title: string,
	faded: boolean?
)
	local root = surface(p, face, pps)
	local card = panel(root, fill, UDim2.fromScale(0.02, 0.04), UDim2.fromScale(0.96, 0.92), 0.1)
	local head = panel(card, band, UDim2.fromScale(0.04, 0.06), UDim2.fromScale(0.92, 0.3), 0.5)
	text(head, { Text = header, TextColor3 = W.White, Size = UDim2.fromScale(0.92, 0.76), Position = UDim2.fromScale(0.04, 0.12) })
	text(card, {
		Text = title,
		TextTransparency = if faded then 0.35 else 0,
		Size = UDim2.fromScale(0.92, 0.54),
		Position = UDim2.fromScale(0.04, 0.4),
	})
end

-- A locked gate's card face: `title` in white on the mid grey card, with a soft Ink outline
-- so it stays clear from across the plaza.
local function lockedFace(p: BasePart, face: Enum.NormalId, pps: number, title: string)
	local root = surface(p, face, pps)
	local card = panel(root, LOCKED_CARD, UDim2.fromScale(0.02, 0.04), UDim2.fromScale(0.96, 0.92), 0.14)
	local label = text(card, {
		Text = title,
		TextColor3 = W.White,
		Size = UDim2.fromScale(0.88, 0.8),
		Position = UDim2.fromScale(0.06, 0.1),
	})
	local outline = Instance.new("UIStroke")
	outline.Color = W.Ink
	outline.Thickness = 2
	outline.Transparency = 0.45
	outline.Parent = label
end

-- An invisible flat carrier part for a crisp text layer laid over a sign card.
local function carrier(add: (props: { [string]: any }) -> BasePart, name: string, cframe: CFrame, size: Vector3): BasePart
	return decor(add({ Name = name, Size = size, CFrame = cframe, Transparency = 1, CastShadow = false }))
end

-- Builder for parts in a local frame: props.CFrame is relative to `base`.
local function adder(base: CFrame, parent: Instance): (props: { [string]: any }, className: string?) -> BasePart
	return function(props: { [string]: any }, className: string?): BasePart
		props.CFrame = base * (props.CFrame or CFrame.new())
		props.Parent = props.Parent or parent
		return make(className or "Part", props)
	end
end

-- A flag pole with a "Flag" card (swayed by Client.Fx.Ambient) showing `label`. `big` makes
-- the chunky checkpoint flag (cloth 3.1x, number readable from a few platforms back).
local function flagPole(
	x: number,
	y: number,
	z: number,
	height: number,
	flagColor: Color3,
	label: string?,
	along: number,
	parent: Instance,
	big: boolean?
): BasePart
	local scale = if big then 3.1 else 1
	make("Part", {
		Name = "FlagPole",
		Shape = CYLINDER,
		Size = Vector3.new(height, 0.7 * scale, 0.7 * scale),
		CFrame = CFrame.new(x, y + height / 2, z) * UPRIGHT,
		Color = W.White,
		Parent = parent,
	})
	local cap = decor(make("Part", {
		Name = "FlagCap",
		Shape = BALL,
		Size = cube(1.3 * scale),
		CFrame = CFrame.new(x, y + height + 0.3 * scale, z),
		Color = W.Sunny,
		Parent = parent,
	}))
	local clothSize = Vector3.new(3.8, 2.8, 0.25) * Vector3.new(scale, scale, 1)
	local hingeCF = CFrame.new(x, y + height - 0.4 * scale, z) * CFrame.Angles(0, along, 0)
	local flag = Instance.new("Model")
	flag.Name = "Flag"
	local hinge = make("Part", {
		Name = "FlagHinge",
		Size = cube(0.2),
		CFrame = hingeCF,
		Transparency = 1,
		CastShadow = false,
		Parent = flag,
	})
	decor(hinge)
	flag.PrimaryPart = hinge
	local card = decor(make("Part", {
		Name = "FlagCloth",
		Size = clothSize,
		CFrame = hingeCF * CFrame.new(clothSize.X / 2 + 0.3 * scale, -clothSize.Y / 2, 0),
		Color = flagColor,
		CastShadow = false,
		Parent = flag,
	}))
	if label then
		-- A white disc filling most of the cloth with a big Ink number (label ~100 px tall).
		local pps = if big then 16 else 40
		local dotW = clothSize.Y * 0.88 / clothSize.X
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local root = surface(card, face, pps)
			local dot = panel(root, W.White, UDim2.fromScale((1 - dotW) / 2, 0.06), UDim2.fromScale(dotW, 0.88), 0.5)
			text(dot, { Text = label, Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.12) })
		end
	end
	flag.Parent = parent
	return cap
end

-- Platforms -----------------------------------------------------------------------------

-- A bright candy slab: the SmoothPlastic top in the element's colour (or `fill`), a 0.3-stud
-- lighter lip just under it and a thin white underside. Returns the top part (named `name`);
-- lip and underside are parented to it when `rimInTop` (movers carry them).
local TOP_H = 1.2
local LIP_H, LIP_OUT = 0.3, 0.3
local UNDER_H, UNDER_IN = 0.5, 0.4
local function platform(e: Course.Element, name: string, parent: Instance, rimInTop: boolean, fill: Color3?): BasePart
	local col = fill or color(e.color)
	local material = if e.color == "Wood" then Enum.Material.WoodPlanks else SMOOTH
	local lipY = e.y - TOP_H - LIP_H / 2 + 0.05
	local underY = e.y - TOP_H - LIP_H - UNDER_H / 2 + 0.1
	local under = if rimInTop then nil else parent
	local top: BasePart = nil :: any
	if e.shape == "disc" then
		local r = e.r :: number
		top = make("Part", {
			Name = name,
			Shape = CYLINDER,
			Size = Vector3.new(TOP_H, r * 2, r * 2),
			CFrame = CFrame.new(e.x, e.y - TOP_H / 2, e.z) * UPRIGHT,
			Color = col,
			Material = material,
			Parent = parent,
		})
		decor(make("Part", {
			Name = "PlatformRim",
			Shape = CYLINDER,
			Size = Vector3.new(LIP_H, r * 2 + LIP_OUT * 2, r * 2 + LIP_OUT * 2),
			CFrame = CFrame.new(e.x, lipY, e.z) * UPRIGHT,
			Color = col:Lerp(W.White, LIP_TINT),
			Material = SMOOTH,
			Parent = under or top,
		}))
		decor(make("Part", {
			Name = "PlatformBase",
			Shape = CYLINDER,
			Size = Vector3.new(UNDER_H, r * 2 - UNDER_IN * 2, r * 2 - UNDER_IN * 2),
			CFrame = CFrame.new(e.x, underY, e.z) * UPRIGHT,
			Color = W.White,
			Material = SMOOTH,
			Parent = under or top,
		}))
	elseif e.shape == "ring" or e.shape == "hex" then
		-- A hollow square (four frame bars) or a hexagon (three boxes turned 60 degrees
		-- apart, a corner along X), each piece with its white underside.
		local pieces: { { any } } = {}
		if e.shape == "ring" then
			local sx, sz = e.sx :: number, e.sz :: number
			local w = math.min(e.width or 3, sx / 2, sz / 2)
			for _, side in { -1, 1 } do
				table.insert(pieces, { Vector3.new(sx, 0, w), CFrame.new(0, 0, side * (sz - w) / 2) })
				table.insert(pieces, { Vector3.new(w, 0, sz - 2 * w), CFrame.new(side * (sx - w) / 2, 0, 0) })
			end
		else
			local r = e.r :: number
			for k = 0, 2 do
				-- Each piece 0.05 lower than the last so the overlapping tops never share a plane.
				table.insert(
					pieces,
					{ Vector3.new(r, 0, r * math.sqrt(3)), CFrame.new(0, -0.05 * k, 0) * CFrame.Angles(0, k * math.pi / 3, 0) }
				)
			end
		end
		for _, piece in pieces do
			local size, offset = piece[1] :: Vector3, piece[2] :: CFrame
			local at = CFrame.new(e.x, 0, e.z) * offset
			local bar = make("Part", {
				Name = name,
				Size = Vector3.new(size.X, TOP_H, size.Z),
				CFrame = at + Vector3.new(0, e.y - TOP_H / 2, 0),
				Color = col,
				Material = material,
				Parent = parent,
			})
			top = top or bar
			decor(make("Part", {
				Name = "PlatformBase",
				Size = Vector3.new(math.max(size.X - UNDER_IN, 1), UNDER_H + LIP_H, math.max(size.Z - UNDER_IN, 1)),
				CFrame = at + Vector3.new(0, underY + LIP_H / 2, 0),
				Color = col:Lerp(W.White, 0.7),
				Material = SMOOTH,
				Parent = under or bar,
			}))
		end
	else
		local sx, sz = e.sx :: number, e.sz :: number
		top = make("Part", {
			Name = name,
			Size = Vector3.new(sx, TOP_H, sz),
			CFrame = CFrame.new(e.x, e.y - TOP_H / 2, e.z),
			Color = col,
			Material = material,
			Parent = parent,
		})
		decor(make("Part", {
			Name = "PlatformRim",
			Size = Vector3.new(sx + LIP_OUT * 2, LIP_H, sz + LIP_OUT * 2),
			CFrame = CFrame.new(e.x, lipY, e.z),
			Color = col:Lerp(W.White, LIP_TINT),
			Material = SMOOTH,
			Parent = under or top,
		}))
		decor(make("Part", {
			Name = "PlatformBase",
			Size = Vector3.new(math.max(sx - UNDER_IN * 2, 1), UNDER_H, math.max(sz - UNDER_IN * 2, 1)),
			CFrame = CFrame.new(e.x, underY, e.z),
			Color = W.White,
			Material = SMOOTH,
			Parent = under or top,
		}))
	end
	return top
end

-- A flat teal chevron painted on a platform top near its exit edge, pointing at the next path
-- element, so the route reads as one continuous line. Parented to `parent` (the mover's top
-- for moving platforms, so it rides along).
local CHEVRON_ARM = 1.4
local function chevron(e: Course.Element, nextE: Course.Element, parent: Instance)
	local dx, dz = nextE.x - e.x, nextE.z - e.z
	local length = math.sqrt(dx * dx + dz * dz)
	if length < 1e-3 then
		return
	end
	dx, dz = dx / length, dz / length
	local edge: number
	if e.shape == "disc" then
		edge = e.r :: number
	elseif e.shape == "hex" then
		edge = (e.r :: number) * math.sqrt(3) / 2
	else
		local hx, hz = (e.sx :: number) / 2, (e.sz :: number) / 2
		edge = math.min(if dx ~= 0 then hx / math.abs(dx) else math.huge, if dz ~= 0 then hz / math.abs(dz) else math.huge)
	end
	local reach = math.max(edge - 1.6, 0)
	-- Bottom 0.05 above the top (no coplanar faces); the two arms differ by 0.02 in height.
	local at = Vector3.new(e.x + dx * reach, e.y + 0.11, e.z + dz * reach)
	local frame = CFrame.lookAt(at, at + Vector3.new(dx, 0, dz))
	local a = CHEVRON_ARM
	local arm = a * math.sqrt(2) + 0.35
	-- Apex forward (-Z), arms trailing back to either side.
	for _, side in { -1, 1 } do
		decor(make("Part", {
			Name = "Chevron",
			Size = Vector3.new(arm, 0.12, 0.7),
			CFrame = frame * CFrame.new(side * a / 2, (side + 1) * 0.01, -0.8 + a / 2) * CFrame.Angles(0, -side * math.pi / 4, 0),
			Color = W.Teal,
			CastShadow = false,
			Parent = parent,
		}))
	end
end

-- A pad that is solid only part of the time (Client.Fx.Modes toggles it locally): one thick
-- slab in the palette's blink colour (the only part whose Transparency fades, so no two
-- translucent parts ever overlap) ringed by four thin glowing Neon "BlinkGlow" bars just
-- outside its sides (the client dims them separately) so it reads as "this one blinks".
local BLINK_H = TOP_H + 0.6
local GLOW_W, GLOW_GAP = 0.3, 0.05
local function blink(e: Course.Element, parent: Instance): BasePart
	local sx, sz = e.sx :: number, e.sz :: number
	local top = make("Part", {
		Name = "BlinkPad",
		Size = Vector3.new(sx, BLINK_H, sz),
		CFrame = CFrame.new(e.x, e.y - BLINK_H / 2, e.z),
		Color = color(e.color),
		Material = SMOOTH,
		Parent = parent,
	})
	local glow = color(e.color):Lerp(W.White, 0.35)
	local off = GLOW_GAP + GLOW_W / 2
	-- Long bars along X cover the corners; the Z bars fit between them (no overlap).
	for _, side in { -1, 1 } do
		for _, bar in
			{
				{ Vector3.new(sx + 2 * (GLOW_GAP + GLOW_W), 0.3, GLOW_W), Vector3.new(0, 0, side * (sz / 2 + off)) },
				{ Vector3.new(GLOW_W, 0.3, sz + 2 * GLOW_GAP), Vector3.new(side * (sx / 2 + off), 0, 0) },
			}
		do
			decor(make("Part", {
				Name = "BlinkGlow",
				Size = bar[1],
				CFrame = CFrame.new(e.x, e.y - 0.35, e.z) + bar[2],
				Color = glow,
				Material = Enum.Material.Neon,
				CastShadow = false,
				Parent = top,
			}))
		end
	end
	top:SetAttribute("BlinkOn", e.on)
	top:SetAttribute("BlinkPeriod", e.period)
	top:SetAttribute("BlinkPhase", e.phase or 0)
	top:AddTag("BlinkPad")
	return top
end

local function mover(e: Course.Element, parent: Instance): BasePart
	local top = platform(e, "MovingPlatform", parent, true)
	local axis = e.axis :: { number }
	top:SetAttribute("Mover", e.motion)
	top:SetAttribute("MoveAxis", Vector3.new(axis[1], axis[2], axis[3]))
	top:SetAttribute("MoveDistance", e.distance)
	top:SetAttribute("MovePeriod", e.period)
	top:SetAttribute("MovePhase", e.phase or 0)
	top:AddTag("ModeMover")
	-- Arrow stripes on top hint the direction of travel.
	local along = if axis[3] ~= 0 then ALONG_Z else CFrame.new()
	if e.motion == "bob" then
		make("Part", {
			Name = "MoverStripe",
			Shape = CYLINDER,
			Size = Vector3.new(0.1, 4, 4),
			CFrame = CFrame.new(e.x, e.y + 0.02, e.z) * UPRIGHT,
			Color = W.White,
			Parent = top,
		})
	else
		make("Part", {
			Name = "MoverStripe",
			Size = Vector3.new((e.sx :: number) - 1.6, 0.1, 1.2),
			CFrame = CFrame.new(e.x, e.y + 0.02, e.z) * along,
			Color = W.White,
			Parent = top,
		})
	end
	return top
end

-- A lava kill strip lying on a pad top (docs/sky-obby.md round 3): a Neon core box from the
-- pad top up `h`, with 3-5 thin black bars at 45 degrees across its top (each trimmed so it
-- stays inside the box), 0.03 proud of the core's top face. Sliding ones hang under an
-- invisible ModeMover slide root at the rest centre.
local KILL_STRIPE_W = 0.45
local function killBrick(e: Course.Element, parent: Instance)
	local sx, sz = e.sx :: number, e.sz :: number
	if not sx or not sz then
		return
	end
	local h = e.h or 0.6
	local holder: Instance = parent
	if e.motion == "slide" and e.axis then
		local axis = e.axis :: { number }
		local root = decor(make("Part", {
			Name = "KillSlider",
			Size = cube(0.2),
			CFrame = CFrame.new(e.x, e.y + h / 2, e.z),
			Transparency = 1,
			CastShadow = false,
			Parent = parent,
		}))
		root:SetAttribute("Mover", "slide")
		root:SetAttribute("MoveAxis", Vector3.new(axis[1], axis[2], axis[3]))
		root:SetAttribute("MoveDistance", e.distance or 0)
		root:SetAttribute("MovePeriod", e.period or 4)
		root:SetAttribute("MovePhase", e.phase or 0)
		root:SetAttribute("Hazard", "kill")
		root:AddTag("ModeMover")
		holder = root
	end
	local brick = decor(make("Part", {
		Name = "KillBrick",
		Size = Vector3.new(sx, h, sz),
		CFrame = CFrame.new(e.x, e.y + h / 2, e.z),
		Color = color(e.color or "Lava"),
		Material = Enum.Material.Neon,
		CastShadow = false,
		Parent = holder,
	}))
	brick:SetAttribute("Hazard", "kill")
	brick:AddTag("KillBrick")
	-- Stripes along u = x - z (45 degrees): chord of the line u = c through the box, shortened
	-- by the stripe width so the bar's corners stay inside.
	local a, b = sx / 2, sz / 2
	-- Spread over |c| <= max(a, b), where every chord is full length on a long strip.
	local span = math.max(a, b)
	local n = math.clamp(math.floor(2 * span / 2.8 + 0.5), 3, 5)
	local stripeY = e.y + h + 0.03
	for k = 1, n do
		local c = -span + (k - 0.5) * 2 * span / n
		-- Points (x, x - c) with x in [-a, a] and x - c in [-b, b].
		local lo, hi = math.max(-a, c - b), math.min(a, c + b)
		local length = (hi - lo) * math.sqrt(2) - KILL_STRIPE_W
		if length > 0.4 then
			local mid = (lo + hi) / 2
			decor(make("Part", {
				Name = "KillStripe",
				Size = Vector3.new(length, 0.1, KILL_STRIPE_W),
				CFrame = CFrame.new(e.x + mid, stripeY, e.z + mid - c) * CFrame.Angles(0, -math.pi / 4, 0),
				Color = W.Ink:Lerp(Color3.new(0, 0, 0), 0.6),
				Material = SMOOTH,
				CastShadow = false,
				Parent = brick,
			}))
		end
	end
end

local function spinner(e: Course.Element, parent: Instance)
	local length = e.length :: number
	make("Part", {
		Name = "SpinnerPost",
		Shape = CYLINDER,
		Size = Vector3.new(1.2, 1.6, 1.6),
		CFrame = CFrame.new(e.x, e.y + 0.6, e.z) * UPRIGHT,
		Color = W.White,
		Parent = parent,
	})
	local bar = make("Part", {
		Name = "SpinnerBar",
		Shape = CYLINDER,
		Size = Vector3.new(length, 1.1, 1.1),
		CFrame = CFrame.new(e.x, e.y + 1.75, e.z),
		Color = W.Coral,
		CanCollide = false,
		Parent = parent,
	})
	bar.CanQuery = false
	bar:SetAttribute("Mover", "spin")
	bar:SetAttribute("MoveSpeed", e.speed)
	bar:SetAttribute("MovePhase", e.phase or 0)
	bar:SetAttribute("Hazard", "bump")
	bar:AddTag("ModeMover")
	decor(
		make(
			"Part",
			{ Name = "SpinnerHub", Shape = BALL, Size = cube(2), CFrame = CFrame.new(e.x, e.y + 1.75, e.z), Color = W.Sunny, Parent = bar }
		)
	)
	for _, sx in { -1, 1 } do
		decor(make("Part", {
			Name = "SpinnerEnd",
			Shape = BALL,
			Size = cube(1.7),
			CFrame = CFrame.new(e.x + sx * length / 2, e.y + 1.75, e.z),
			Color = W.White,
			Parent = bar,
		}))
	end
end

local function bounce(e: Course.Element, parent: Instance)
	local r = e.r :: number
	make("Part", {
		Name = "BounceRing",
		Shape = CYLINDER,
		Size = Vector3.new(0.5, r * 2 + 1, r * 2 + 1),
		CFrame = CFrame.new(e.x, e.y + 0.2, e.z) * UPRIGHT,
		Color = W.White,
		Parent = parent,
	})
	local pad = make("Part", {
		Name = "BouncePad",
		Shape = CYLINDER,
		Size = Vector3.new(0.7, r * 2, r * 2),
		CFrame = CFrame.new(e.x, e.y + 0.35, e.z) * UPRIGHT,
		Color = W.Coral,
		Parent = parent,
	})
	pad:SetAttribute("Bounce", e.power)
	pad:AddTag("BouncePad")
end

local function wall(e: Course.Element, parent: Instance)
	local h, sx, sz = e.h :: number, e.sx :: number, e.sz :: number
	make("Part", {
		Name = "HopWall",
		Size = Vector3.new(sx, h - sx / 2, sz),
		CFrame = CFrame.new(e.x, e.y + (h - sx / 2) / 2, e.z),
		Color = color(e.color),
		Parent = parent,
	})
	-- Rounded white cap.
	make("Part", {
		Name = "HopWallCap",
		Shape = CYLINDER,
		Size = Vector3.new(sz, sx + 0.3, sx + 0.3),
		CFrame = CFrame.new(e.x, e.y + h - sx / 2, e.z) * ALONG_Z,
		Color = W.White,
		Parent = parent,
	})
end

-- The finish slide: a ramp between two top-surface points with low guard rails and legs.
local function slide(e: Course.Element, parent: Instance)
	local from, to = e.from :: { number }, e.to :: { number }
	local a = Vector3.new(from[1], from[2], from[3])
	local b = Vector3.new(to[1], to[2], to[3])
	local d = b - a
	local flat = math.sqrt(d.X * d.X + d.Z * d.Z)
	local yaw = math.atan2(-d.Z, d.X)
	local pitch = math.atan2(d.Y, flat)
	local frame = CFrame.new((a + b) / 2) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, pitch)
	local width = e.width :: number
	local ramp = make("Part", {
		Name = "Slide",
		Size = Vector3.new(d.Magnitude, 1, width),
		CFrame = frame * CFrame.new(0, -0.5, 0),
		Color = color(e.color),
		Parent = parent,
	})
	ramp:SetAttribute("Slide", true)
	for _, sz in { -1, 1 } do
		make("Part", {
			Name = "SlideRail",
			Shape = CYLINDER,
			Size = Vector3.new(d.Magnitude, 1.4, 1.4),
			CFrame = frame * CFrame.new(0, 0.9, sz * (width / 2 + 0.5)),
			Color = W.White,
			Parent = parent,
		})
	end
	for _, t in { 0.3, 0.7 } do
		local p = a:Lerp(b, t)
		local height = 6
		make("Part", {
			Name = "SlideLeg",
			Shape = CYLINDER,
			Size = Vector3.new(height, 1.6, 1.6),
			CFrame = CFrame.new(p.X, p.Y - 1 - height / 2, p.Z) * UPRIGHT,
			Color = W.Teal,
			Parent = parent,
		})
	end
end

-- Gates and signs -------------------------------------------------------------------------

-- The open gate's hint arrow: a chunky coral arrow pointing down into the opening. The shaft
-- is the root (tag "ModeHintArrow", HintBob = bob height); Client.Fx.Modes bobs it, with the
-- arms and tip parented to it, while the player is near the plaza and not on a run.
local function gateArrow(add: (props: { [string]: any }) -> BasePart, tipY: number, tint: Color3)
	local a, thick = 1.9, 1.3
	local root = decor(add({
		Name = "GateArrow",
		Size = Vector3.new(thick, 4.2, 1),
		CFrame = CFrame.new(0, tipY + 2.5, 0),
		Color = tint,
	}))
	root:SetAttribute("HintBob", 0.8)
	root:AddTag("ModeHintArrow")
	for _, side in { -1, 1 } do
		decor(add({
			Name = "GateArrowArm",
			Size = Vector3.new(a * math.sqrt(2) + 0.5, thick, 1),
			CFrame = CFrame.new(side * a / 2, tipY + a / 2, 0) * CFrame.Angles(0, 0, side * math.pi / 4),
			Color = tint,
			Parent = root,
		}))
	end
	decor(add({
		Name = "GateArrowTip",
		Shape = BALL,
		Size = cube(thick * 1.1),
		CFrame = CFrame.new(0, tipY + 0.2, 0),
		Color = tint,
		Parent = root,
	}))
end

-- Portal colours per open mode (ring colour, alternate segment colour).
local PORTAL_COLORS: { [string]: { Color3 } } = {
	parkour = { W.Coral, W.Sunny },
	mog = { W.Grape, W.Pink },
}

-- A swirling portal standing upright in an open gate's opening (gate frame `base`, front
-- facing -Z): a faint Neon disc and three concentric rings of Neon segments, each ring its
-- own model spinning about the gate's through-axis (Client.Fx.Ambient turns models with a
-- Spin attribute about their pivot's up axis, which here points through the opening).
local PORTAL_RINGS = {
	{ r = 5.2, n = 10, spin = 1.2, transparency = 0.3 },
	{ r = 3.9, n = 8, spin = -1.8, transparency = 0.45 },
	{ r = 2.6, n = 6, spin = 2.6, transparency = 0.6 },
}
local function portal(base: CFrame, centreY: number, colors: { Color3 }, parent: Instance)
	local axisFrame = base * CFrame.new(0, centreY, 0.9) * CFrame.Angles(math.pi / 2, 0, 0)
	decor(make("Part", {
		Name = "PortalVeil",
		Shape = CYLINDER,
		Size = Vector3.new(0.2, 11, 11),
		CFrame = base * CFrame.new(0, centreY, 1.1) * CFrame.Angles(0, math.pi / 2, 0),
		Color = colors[1]:Lerp(W.White, 0.5),
		Material = Enum.Material.Neon,
		Transparency = 0.82,
		CastShadow = false,
		Parent = parent,
	}))
	for i, ring in PORTAL_RINGS do
		local model = Instance.new("Model")
		model.Name = "PortalRing"
		model:SetAttribute("Spin", ring.spin)
		local hub = decor(make("Part", {
			Name = "PortalHub",
			Size = cube(0.2),
			CFrame = axisFrame,
			Transparency = 1,
			CastShadow = false,
			Parent = model,
		}))
		model.PrimaryPart = hub
		local arc = 2 * ring.r * math.sin(math.pi / ring.n) * 0.72
		for k = 0, ring.n - 1 do
			local a = 2 * math.pi * k / ring.n + i * 0.4
			decor(make("Part", {
				Name = "PortalSegment",
				Size = Vector3.new(0.55, 0.3, arc),
				CFrame = axisFrame * CFrame.new(ring.r * math.cos(a), 0, ring.r * math.sin(a)) * CFrame.Angles(0, -a, 0),
				Color = colors[(k + i) % 2 + 1],
				Material = Enum.Material.Neon,
				Transparency = ring.transparency,
				CastShadow = false,
				Parent = model,
			}))
		end
		model.Parent = parent
	end
end

-- One GAME MODES plaza: its deck, spur, gate row and big sign, and `mirror` (1: the plaza on
-- the hub's -X side, fronts facing +X; -1: the mirrored plaza on +X, fronts facing -X).
-- `portal` is the plaza's number (attribute Portal on its ParkourStart trigger).
type PlazaSpec = {
	plaza: { x0: number, x1: number, z0: number, z1: number, top: number },
	spur: { x0: number, x1: number, half: number, top: number },
	gates: { [number]: { z: number } },
	gateX: number,
	sign: { x: number, z: number, width: number, height: number, bottom: number },
	mirror: number,
	portal: number,
}

-- A gate on the plaza's outer edge, front facing the hub. Every enabled entry is a big open
-- gate in its catalog colour (gate 1 PARKOUR stays sunny) holding its start trigger, the
-- hint arrow and a swirling portal (walking through teleports; the server handles it); locked gates are
-- smaller, blue-grey, closed with bars and a friendly padlock under a COMING SOON card.
local function gate(entry: Catalog.Entry, parent: Instance, spec: PlazaSpec)
	local spot = spec.gates[entry.slot]
	if spot == nil then
		return
	end
	local folder = Instance.new("Model")
	folder.Name = "Gate" .. entry.slot
	folder:SetAttribute("Mode", entry.id)
	folder:SetAttribute("Enabled", entry.enabled)
	folder.Parent = parent
	local base = CFrame.new(spec.gateX, spec.plaza.top, spot.z) * CFrame.Angles(0, FACE_HUB * spec.mirror, 0)
	local add = adder(base, folder)
	local open = entry.enabled
	local tint = color(entry.color)
	local body = if not open then LOCKED elseif entry.id == "parkour" then W.Sunny else tint:Lerp(W.White, 0.2)
	local trim = if open then W.White else W.Chrome
	-- Gate 1 is the biggest; other open gates are a little smaller so the signs of
	-- neighbouring open gates never touch.
	local main = entry.slot == 1
	local height = if not open then 13 elseif main then 16 else 15
	local thick = if open then 3.6 else 3
	local half = (if open then Course.GATE_HALF else LOCKED_HALF) + thick / 2
	for _, sx in { -1, 1 } do
		local x = sx * half
		add({
			Name = "GateFoot",
			Shape = CYLINDER,
			Size = Vector3.new(1.2, thick + 1.2, thick + 1.2),
			CFrame = CFrame.new(x, 0.6, 0) * UPRIGHT,
			Color = trim,
		})
		add({
			Name = "GatePillar",
			Shape = CYLINDER,
			Size = Vector3.new(height, thick, thick),
			CFrame = CFrame.new(x, height / 2, 0) * UPRIGHT,
			Color = body,
		})
		for _, y in { height * 0.28, height * 0.6 } do
			add({
				Name = "GateRing",
				Shape = CYLINDER,
				Size = Vector3.new(0.9, thick + 0.6, thick + 0.6),
				CFrame = CFrame.new(x, y, 0) * UPRIGHT,
				Color = trim,
			})
		end
	end
	local beamH = if open then 2.4 else 2
	add({
		Name = "GateBeam",
		Size = Vector3.new(half * 2 + thick, beamH, thick - 0.6),
		CFrame = CFrame.new(0, height - beamH / 2, 0),
		Color = body,
	})
	-- The name card sits on the beam, framed by a trim-coloured backing.
	local sw, sh = if not open then 12 elseif main then 20 else 15, if not open then 6.5 elseif main then 8.5 else 7.5
	local sy = height + 0.3 + sh / 2
	decor(add({ Name = "GateSignBack", Size = Vector3.new(sw + 1.4, sh + 1.4, 0.8), CFrame = CFrame.new(0, sy, 0.5), Color = trim }))
	local card = decor(add({
		Name = "GateSign",
		Size = Vector3.new(sw, sh, 0.8),
		CFrame = CFrame.new(0, sy, 0),
		Color = if open then W.Cream else LOCKED_CARD,
	}))
	if open then
		cardFace(card, Enum.NormalId.Front, 30, W.Cream, tint, "OPEN!", entry.title)
		cardFace(card, Enum.NormalId.Back, 30, W.Cream, tint, "GOOD LUCK!", entry.title)
		add({ Name = "StartLine", Size = Vector3.new(Course.GATE_HALF * 2, 0.12, 1.6), CFrame = CFrame.new(0, 0.06, 0), Color = W.Sunny })
		gateArrow(add, 8.6, tint)
		portal(base, 6.2, PORTAL_COLORS[entry.id] or { tint, W.White }, folder)
		local start = trigger(
			entry.id == "parkour" and "ParkourStart" or "ModeStart",
			base * CFrame.new(0, 5, 0),
			Vector3.new(Course.GATE_HALF * 2, 10, 1),
			folder
		)
		start:SetAttribute("Portal", spec.portal)
		return
	end
	local title = string.gsub(entry.title, " ", "\n")
	lockedFace(card, Enum.NormalId.Front, 40, title)
	lockedFace(card, Enum.NormalId.Back, 40, title)
	-- Closed bars with a friendly padlock in the middle.
	local barTop = height - beamH
	for i = -2, 2 do
		add({
			Name = "GateBar",
			Shape = CYLINDER,
			Size = Vector3.new(barTop - 0.2, 0.8, 0.8),
			CFrame = CFrame.new(i * 1.6, 0.2 + (barTop - 0.2) / 2, 0) * UPRIGHT,
			Color = W.Chrome,
		})
	end
	for _, y in { 2.2, barTop - 1.8 } do
		add({
			Name = "GateRail",
			Shape = CYLINDER,
			Size = Vector3.new(half * 2 - 1, 0.9, 0.9),
			CFrame = CFrame.new(0, y, 0),
			Color = W.Chrome,
		})
	end
	add({ Name = "Padlock", Size = Vector3.new(3.8, 3.2, 1.4), CFrame = CFrame.new(0, 5.2, -1), Color = W.Sunny })
	for _, sx in { -1, 1 } do
		-- Rounded padlock sides, little eyes and the shackle.
		decor(add({
			Name = "PadlockSide",
			Shape = CYLINDER,
			Size = Vector3.new(1.4, 3.2, 3.2),
			CFrame = CFrame.new(sx * 1.9, 5.2, -1) * ALONG_Z,
			Color = W.Sunny,
		}))
		decor(add({ Name = "PadlockEye", Shape = BALL, Size = cube(0.6), CFrame = CFrame.new(sx * 0.85, 6, -1.7), Color = W.Ink }))
		add({
			Name = "PadlockShackle",
			Shape = CYLINDER,
			Size = Vector3.new(1.8, 0.8, 0.8),
			CFrame = CFrame.new(sx * 1.2, 7.6, -1) * UPRIGHT,
			Color = W.Chrome,
		})
		decor(add({ Name = "PadlockShackle", Shape = BALL, Size = cube(0.8), CFrame = CFrame.new(sx * 1.2, 8.5, -1), Color = W.Chrome }))
	end
	add({
		Name = "PadlockShackle",
		Shape = CYLINDER,
		Size = Vector3.new(2.4, 0.8, 0.8),
		CFrame = CFrame.new(0, 8.5, -1),
		Color = W.Chrome,
	})
	decor(add({
		Name = "PadlockHole",
		Shape = CYLINDER,
		Size = Vector3.new(0.2, 0.9, 0.9),
		CFrame = CFrame.new(0, 4.9, -1.75) * ALONG_Z,
		Color = W.Ink,
	}))
	decor(add({ Name = "PadlockHole", Size = Vector3.new(0.4, 0.9, 0.2), CFrame = CFrame.new(0, 4.35, -1.75), Color = W.Ink }))
end

-- The big GAME MODES landmark high behind the gates: a cream card in a chunky sunny frame of
-- rounded rails, on two teal posts. The coral header and the Ink title are separate text
-- layers, each with its own resolution, so both stay crisp from the hub centre.
local function bigSign(parent: Instance, spec: PlazaSpec)
	local s = spec.sign
	local base = CFrame.new(s.x, 0, s.z) * CFrame.Angles(0, FACE_HUB * spec.mirror, 0)
	local add = adder(base, parent)
	local w, h = s.width, s.height
	local cy = s.bottom + h / 2
	local railX, railY = w / 2 + 1.6, h / 2 + 1.6
	local postX = railX + 3.3
	local top = s.bottom + h + 3.2
	for _, sx in { -1, 1 } do
		add({
			Name = "BigSignFoot",
			Shape = CYLINDER,
			Size = Vector3.new(1.2, 5, 5),
			CFrame = CFrame.new(sx * postX, 0.3, 0) * UPRIGHT,
			Color = W.White,
		})
		add({
			Name = "BigSignPost",
			Shape = CYLINDER,
			Size = Vector3.new(top, 3.2, 3.2),
			CFrame = CFrame.new(sx * postX, top / 2, 0) * UPRIGHT,
			Color = W.Teal,
		})
		for _, y in { 6, 14, 22 } do
			decor(add({
				Name = "BigSignRing",
				Shape = CYLINDER,
				Size = Vector3.new(0.9, 3.8, 3.8),
				CFrame = CFrame.new(sx * postX, y, 0) * UPRIGHT,
				Color = W.White,
			}))
		end
		decor(add({ Name = "BigSignCap", Shape = BALL, Size = cube(4.4), CFrame = CFrame.new(sx * postX, top + 1.6, 0), Color = W.Sunny }))
		for _, dy in { -4.5, 4.5 } do
			decor(add({
				Name = "BigSignBracket",
				Shape = CYLINDER,
				Size = Vector3.new(3, 1.4, 1.4),
				CFrame = CFrame.new(sx * (railX + 1.6), cy + dy, 0.2),
				Color = W.Sunny,
			}))
		end
		-- Side rails and corner balls of the frame.
		decor(add({
			Name = "BigSignRail",
			Shape = CYLINDER,
			Size = Vector3.new(h + 3.2, 2.6, 2.6),
			CFrame = CFrame.new(sx * railX, cy, 0.2) * UPRIGHT,
			Color = W.Sunny,
		}))
		for _, sy in { -1, 1 } do
			decor(add({
				Name = "BigSignCorner",
				Shape = BALL,
				Size = cube(3.4),
				CFrame = CFrame.new(sx * railX, cy + sy * railY, 0.2),
				Color = W.Sunny,
			}))
			if sx == 1 then
				decor(add({
					Name = "BigSignRail",
					Shape = CYLINDER,
					Size = Vector3.new(w + 3.2, 2.6, 2.6),
					CFrame = CFrame.new(0, cy + sy * railY, 0.2),
					Color = W.Sunny,
				}))
			end
		end
	end
	-- Sunny backing (its back carries the sign for the course side) and the cream card.
	local frame = decor(add({
		Name = "BigSignFrame",
		Size = Vector3.new(w + 3.2, h + 3.2, 1.2),
		CFrame = CFrame.new(0, cy, 0.7),
		Color = W.Sunny,
	}))
	decor(add({ Name = "BigSign", Size = Vector3.new(w, h, 0.8), CFrame = CFrame.new(0, cy, 0), Color = W.Cream }))
	cardFace(frame, Enum.NormalId.Back, 12, W.Cream, W.Coral, "PARKOUR", "GAME MODES")
	-- Coral header pill (white text ~95 px) and the Ink title (~95 px, width-limited).
	local headH = 3.8
	local head = carrier(add, "BigSignHeader", CFrame.new(0, cy + h / 2 - 0.5 - headH / 2, -0.45), Vector3.new(w - 3, headH, 0.05))
	local pill = panel(surface(head, Enum.NormalId.Front, 34), W.Coral, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 0.5)
	text(
		pill,
		{ Text = "PARKOUR OPEN NOW!", TextColor3 = W.White, Size = UDim2.fromScale(0.9, 0.74), Position = UDim2.fromScale(0.05, 0.14) }
	)
	local titleH = h - headH - 1.4
	local title = carrier(add, "BigSignTitle", CFrame.new(0, s.bottom + 0.5 + titleH / 2, -0.45), Vector3.new(w - 2, titleH, 0.05))
	text(
		surface(title, Enum.NormalId.Front, 14),
		{ Text = "GAME MODES", Size = UDim2.fromScale(0.98, 0.96), Position = UDim2.fromScale(0.01, 0.02) }
	)
end

-- Freestanding best-times card; returns the list label.
local function bestBoard(parent: Instance, spec: PlazaSpec): TextLabel
	local b = Course.BOARD
	local yaw = math.atan2(-(b.faceX - b.x), -(b.faceZ - b.z))
	local base = CFrame.new(b.x, spec.plaza.top, b.z) * CFrame.Angles(0, yaw, 0)
	local add = adder(base, parent)
	-- Tall enough for one line per level (Modes.Parkour writes LEVEL_COUNT lines).
	local w, h, bottom = 15, 16, 2.5
	for _, sx in { -1, 1 } do
		local x = sx * (w / 2 + 0.6)
		add({
			Name = "BoardFoot",
			Shape = CYLINDER,
			Size = Vector3.new(0.6, 2.4, 2.4),
			CFrame = CFrame.new(x, 0.3, 0) * UPRIGHT,
			Color = W.Cream,
		})
		add({
			Name = "BoardPost",
			Shape = CYLINDER,
			Size = Vector3.new(bottom + h + 0.4, 1.3, 1.3),
			CFrame = CFrame.new(x, (bottom + h + 0.4) / 2, 0) * UPRIGHT,
			Color = W.Mint,
		})
		decor(add({ Name = "BoardCap", Shape = BALL, Size = cube(2), CFrame = CFrame.new(x, bottom + h + 0.8, 0), Color = W.Sunny }))
	end
	local slab =
		decor(add({ Name = "BestBoard", Size = Vector3.new(w, h, 0.8), CFrame = CFrame.new(0, bottom + h / 2, 0), Color = W.White }))
	local root = surface(slab, Enum.NormalId.Front, 30)
	local card = panel(root, W.Cream, UDim2.fromScale(0.03, 0.025), UDim2.fromScale(0.94, 0.95), 0.06)
	local pill = panel(card, W.Coral, UDim2.fromScale(0.1, 0.025), UDim2.fromScale(0.8, 0.1), 0.5)
	text(pill, { Text = "PARKOUR BEST", TextColor3 = W.White, Size = UDim2.fromScale(0.9, 0.74), Position = UDim2.fromScale(0.05, 0.13) })
	text(card, {
		Text = "SERVER TOP TIMES",
		Font = theme.Fonts.Bold,
		Size = UDim2.fromScale(0.8, 0.05),
		Position = UDim2.fromScale(0.1, 0.135),
	})
	local list = text(card, {
		Text = "Be the first to finish!",
		Font = theme.Fonts.Bold,
		TextScaled = false,
		TextSize = 25,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.fromScale(0.9, 0.78),
		Position = UDim2.fromScale(0.05, 0.2),
	})
	local back = surface(slab, Enum.NormalId.Back, 30)
	local backCard = panel(back, W.Cream, UDim2.fromScale(0.03, 0.025), UDim2.fromScale(0.94, 0.95), 0.06)
	text(backCard, { Text = "GAME MODES", Size = UDim2.fromScale(0.86, 0.3), Position = UDim2.fromScale(0.07, 0.35) })
	return list
end

-- A small arch over the spur where it leaves the hub ring (the spur end nearer x = 0).
local function spurArch(parent: Instance, spec: PlazaSpec)
	local s = spec.spur
	local hubX = if math.abs(s.x0) < math.abs(s.x1) then s.x0 else s.x1
	local x = hubX - 5 * spec.mirror
	local base = CFrame.new(x, s.top, 0) * CFrame.Angles(0, FACE_HUB * spec.mirror, 0)
	local add = adder(base, parent)
	local half = s.half + 1.4
	for _, sx in { -1, 1 } do
		add({
			Name = "ArchFoot",
			Shape = CYLINDER,
			Size = Vector3.new(1, 3, 3),
			CFrame = CFrame.new(sx * half, 0.5, 0) * UPRIGHT,
			Color = W.Grape,
		})
		add({
			Name = "ArchPillar",
			Shape = CYLINDER,
			Size = Vector3.new(10.4, 2, 2),
			CFrame = CFrame.new(sx * half, 5.2, 0) * UPRIGHT,
			Color = W.White,
		})
		add({ Name = "ArchCap", Shape = BALL, Size = cube(2.8), CFrame = CFrame.new(sx * half, 11.4, 0), Color = W.Sunny })
	end
	local sign =
		decor(add({ Name = "ArchSign", Size = Vector3.new(half * 2 - 1.5, 3.8, 0.9), CFrame = CFrame.new(0, 9.6, 0), Color = W.White }))
	cardFace(sign, Enum.NormalId.Front, 30, W.Cream, W.Grape, "THIS WAY!", "GAME MODES")
	cardFace(sign, Enum.NormalId.Back, 30, W.Cream, W.Grape, "BACK TO", "THE GYMS")
end

-- Plaza ---------------------------------------------------------------------------------

local function buildPlaza(parent: Instance, spec: PlazaSpec)
	local p, s = spec.plaza, spec.spur
	local cx, cz = (p.x0 + p.x1) / 2, (p.z0 + p.z1) / 2
	local sx, sz = p.x1 - p.x0, p.z1 - p.z0
	make("Part", {
		Name = "ModesPlaza",
		Size = Vector3.new(sx, 0.8, sz),
		CFrame = CFrame.new(cx, p.top - 0.4, cz),
		Color = W.Wood,
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	make("Part", {
		Name = "ModesPlazaRim",
		Size = Vector3.new(sx + 1.4, 0.8, sz + 1.4),
		CFrame = CFrame.new(cx, p.top - 0.5, cz),
		Color = W.White,
		Parent = parent,
	})
	for i, ring in { { 13, W.Coral }, { 11.6, W.Cream }, { 4, W.Sunny } } do
		make("Part", {
			Name = "PlazaInlay",
			Shape = CYLINDER,
			Size = Vector3.new(0.2, ring[1] * 2, ring[1] * 2),
			CFrame = CFrame.new(cx, p.top + 0.05 * i, cz) * UPRIGHT,
			Color = ring[2],
			Parent = parent,
		})
	end
	-- Spur from the hub ring.
	local length = s.x1 - s.x0
	make("Part", {
		Name = "Boardwalk",
		Size = Vector3.new(length, 0.6, s.half * 2),
		CFrame = CFrame.new((s.x0 + s.x1) / 2, s.top - 0.3, 0),
		Color = W.Wood,
		Material = Enum.Material.WoodPlanks,
		Parent = parent,
	})
	for _, side in { -1, 1 } do
		-- 0.05 shorter at each end, 0.05 proud of the side and 0.05 above the bottom, so no
		-- face shares the boardwalk's planes.
		make("Part", {
			Name = "BoardwalkEdge",
			Size = Vector3.new(length - 0.1, 0.7, 0.7),
			CFrame = CFrame.new((s.x0 + s.x1) / 2, s.top - 0.2, side * (s.half - 0.3)),
			Color = W.WoodDark,
			Parent = parent,
		})
		for k, x in { s.x0 + 1, s.x1 - 1 } do
			local z = side * (s.half + 1)
			make("Part", {
				Name = "BollardPost",
				Shape = CYLINDER,
				Size = Vector3.new(2, 1.1, 1.1),
				CFrame = CFrame.new(x, 1, z) * UPRIGHT,
				Color = W.Wood,
				Parent = parent,
			})
			make("Part", {
				Name = "BollardCap",
				Shape = BALL,
				Size = cube(1.5),
				CFrame = CFrame.new(x, 2.2, z),
				Color = FLAG_COLORS[k + side + 2],
				Parent = parent,
			})
		end
	end
	spurArch(parent, spec)
	-- Flag posts on the plaza corners.
	for i, corner in { { p.x1 - 2, p.z0 + 2 }, { p.x1 - 2, p.z1 - 2 }, { p.x0 + 2, p.z0 + 2 }, { p.x0 + 2, p.z1 - 2 } } do
		flagPole(corner[1], p.top, corner[2], 10, FLAG_COLORS[i], nil, if corner[2] < 0 then 0 else math.pi, parent)
	end
end

-- Sky -------------------------------------------------------------------------------------

-- The cloud floor far under the map (Course.cloudLayer): 40-80 thin, wide, overlapping opaque
-- white puffs (opaque: overlapping translucent parts flicker) with gaps of blue sky between them, never colliding (the ParkourWater catch volume at
-- Course.FLOOR_Y handles falls).
local function cloudFloor(level: Course.Level, parent: Instance)
	local layer = (Course :: any).cloudLayer
	if layer == nil then
		return
	end
	local holder = Instance.new("Folder")
	holder.Name = "CloudFloor"
	for i, puff in layer(level) do
		decor(make("Part", {
			Name = "CloudPuff",
			Shape = CYLINDER,
			Size = Vector3.new(puff.h, puff.d, puff.d),
			CFrame = CFrame.new(puff.x, puff.y, puff.z) * UPRIGHT,
			Color = if i % 3 == 0 then W.Cloud:Lerp(W.Checkpoint, 0.06) else W.Cloud,
			Material = SMOOTH,
			Transparency = 0,
			CastShadow = false,
			Parent = holder,
		}))
	end
	holder.Parent = parent
end

-- Terrain clouds high overhead (wrapped: Lune's preview export has no Terrain).
local function skyClouds()
	pcall(function()
		local terrain = (workspace :: any).Terrain
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.7
		clouds.Density = 0.3
		clouds.Parent = terrain
	end)
end

-- The rainbow stairs from map n's finish deck to map n+1's start deck (Course.BRIDGES[n]),
-- drawn into Level<n>/Bridge.
local function buildBridge(n: number, parent: Instance)
	local steps: { Course.Element }? = ((Course :: any).BRIDGES or {})[n]
	if steps == nil or #steps == 0 then
		return
	end
	local holder = Instance.new("Folder")
	holder.Name = "Bridge"
	for _, e in steps do
		platform(e, e.name or "Platform", holder, false)
	end
	holder.Parent = parent
end

-- Course --------------------------------------------------------------------------------

local ARCH_SPRING = 10
local ARCH_SEGMENTS = 7

-- Two candy pillars and a rounded half-circle of `body`-coloured segments, built through
-- `add` (frame: front facing -Z, x across the deck, y up from the deck top), with white
-- feet, rings and joints.
local function archFrame(add: (props: { [string]: any }) -> BasePart, half: number, body: Color3)
	local spring = ARCH_SPRING
	local trim = W.White
	for _, sx in { -1, 1 } do
		add({
			Name = "FinishFoot",
			Shape = CYLINDER,
			Size = Vector3.new(1, 4.2, 4.2),
			CFrame = CFrame.new(sx * half, 0.5, 0) * UPRIGHT,
			Color = W.White,
		})
		add({
			Name = "FinishPillar",
			Shape = CYLINDER,
			Size = Vector3.new(spring, 3, 3),
			CFrame = CFrame.new(sx * half, spring / 2, 0) * UPRIGHT,
			Color = body,
		})
		for _, y in { 2.5, 5.5 } do
			add({
				Name = "FinishRing",
				Shape = CYLINDER,
				Size = Vector3.new(0.8, 3.5, 3.5),
				CFrame = CFrame.new(sx * half, y, 0) * UPRIGHT,
				Color = trim,
			})
		end
	end
	local segments = ARCH_SEGMENTS
	for i = 0, segments do
		local a = math.pi * i / segments
		decor(add({
			Name = "FinishArchJoint",
			Shape = BALL,
			Size = cube(3.4),
			CFrame = CFrame.new(half * math.cos(a), spring + half * math.sin(a), 0),
			Color = trim,
		}))
		if i < segments then
			local m = math.pi * (i + 0.5) / segments
			decor(add({
				Name = "FinishArch",
				Shape = CYLINDER,
				Size = Vector3.new(2 * half * math.sin(math.pi / (2 * segments)) + 0.4, 3, 3),
				CFrame = CFrame.new(half * math.cos(m), spring + half * math.sin(m), 0) * CFrame.Angles(0, 0, m + math.pi / 2),
				Color = body,
			}))
		end
	end
end

-- Frame at (x, y, z) whose front (-Z) faces the horizontal direction (faceX, faceZ).
local function facing(x: number, y: number, z: number, faceX: number, faceZ: number): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(0, math.atan2(-faceX, -faceZ), 0)
end

-- Half the arch span across a deck box (x0..x1, z0..z1) for an arch facing along X or Z.
local function spanHalf(b: Course.Box, faceX: number): number
	return (if faceX ~= 0 then b.z1 - b.z0 else b.x1 - b.x0) / 2 + 0.6
end

-- Block letters for the lobby sign: per letter, cell rectangles { c0, r0, c1, r1 } on a 3x5
-- grid (columns left to right, rows bottom to top).
local GLYPHS: { [string]: { { number } } } = {
	C = { { 0, 0, 0, 4 }, { 1, 4, 2, 4 }, { 1, 0, 2, 0 } },
	H = { { 0, 0, 0, 4 }, { 2, 0, 2, 4 }, { 1, 2, 1, 2 } },
	A = { { 0, 0, 0, 3 }, { 2, 0, 2, 3 }, { 1, 4, 1, 4 }, { 1, 2, 1, 2 } },
	D = { { 0, 0, 0, 4 }, { 1, 4, 1, 4 }, { 1, 0, 1, 0 }, { 2, 1, 2, 3 } },
	O = { { 0, 1, 0, 3 }, { 2, 1, 2, 3 }, { 1, 4, 1, 4 }, { 1, 0, 1, 0 } },
	B = { { 0, 0, 0, 4 }, { 1, 4, 1, 4 }, { 1, 2, 1, 2 }, { 1, 0, 1, 0 }, { 2, 3, 2, 3 }, { 2, 1, 2, 1 } },
	Y = { { 0, 3, 0, 4 }, { 2, 3, 2, 4 }, { 1, 0, 1, 2 } },
}
local LETTER_COLORS =
	{ "RainbowRed", "RainbowOrange", "RainbowYellow", "RainbowGreen", "RainbowCyan", "RainbowBlue", "RainbowPurple", "RainbowPink" }
local LETTER_CELL = 1.6

-- "CHAD OBBY" in chunky rainbow block letters standing on a white plinth bar per word, built
-- in `base` (front -Z faces the reader; letters run toward the reader's right, local -X).
-- One Model "Letters" (35 parts).
local function blockLetters(word: string, base: CFrame, parent: Instance)
	local model = Instance.new("Model")
	model.Name = "Letters"
	local cell = LETTER_CELL
	local width = 0
	for i = 1, #word do
		width += if string.sub(word, i, i) == " " then 2 else (if i < #word then 4 else 3)
	end
	local col0 = -width / 2
	local colour = 0
	local wordStart = col0
	local function plinth(c0: number, c1: number)
		decor(make("Part", {
			Name = "LettersBase",
			Size = Vector3.new((c1 - c0 + 1) * cell, cell * 0.6, cell * 2.2),
			CFrame = base * CFrame.new(-((c0 + c1) / 2 + 0.5) * cell, -cell * 0.3, 0),
			Color = W.White,
			Material = SMOOTH,
			Parent = model,
		}))
	end
	local c = col0
	for i = 1, #word do
		local ch = string.sub(word, i, i)
		if ch == " " then
			plinth(wordStart - 0.5, c - 1.5)
			c += 2
			wordStart = c
			continue
		end
		colour += 1
		local tint = W[LETTER_COLORS[(colour - 1) % #LETTER_COLORS + 1]]
		local glyph: { { number } } = GLYPHS[ch] or {}
		for _, rect in glyph do
			local cx = c + (rect[1] + rect[3]) / 2 + 0.5
			local cy = (rect[2] + rect[4]) / 2 + 0.5
			decor(make("Part", {
				Name = "Letter",
				Size = Vector3.new((rect[3] - rect[1] + 1) * cell, (rect[4] - rect[2] + 1) * cell, cell),
				CFrame = base * CFrame.new(-cx * cell, cy * cell, 0),
				Color = tint,
				Material = SMOOTH,
				Parent = model,
			}))
		end
		c += 4
	end
	plinth(wordStart - 0.5, c - 1.5)
	model.Parent = parent
end

-- A soft green checkerboard painted on a lobby deck's top.
local function checker(top: BasePart, sx: number, sz: number)
	local tile = 4
	local nx, nz = math.max(1, math.floor(sx / tile + 0.5)), math.max(1, math.floor(sz / tile + 0.5))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 4
	gui.Parent = top
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			if (i + j) % 2 == 0 then
				local cell = Instance.new("Frame")
				cell.BackgroundColor3 = LOBBY_GREEN:Lerp(W.White, 0.3)
				cell.BorderSizePixel = 0
				cell.Position = UDim2.fromScale(i / nx, j / nz)
				cell.Size = UDim2.fromScale(1 / nx, 1 / nz)
				cell.Parent = gui
			end
		end
	end
end

-- A map's entrance: an arch over the start deck's leading edge, ahead of the spawn spot,
-- with a marquee card standing on its crown: "STAGE <first stage>" / GO GO GO! toward the
-- runner on the deck, the map name over "STAGE <first stage>" toward the course (map 1:
-- CHAD OBBY / START), and five small rainbow flag poles along the deck's sides. The card
-- stays above the arch: across the opening the pillars cut through its text. Map 1's deck
-- is the green checkered lobby with "CHAD OBBY" block letters floating high behind the
-- arch.
local function startArch(level: Course.Level, deck: Course.Element, top: BasePart?, parent: Instance)
	local s = level.START
	local sx, sz = deck.sx :: number, deck.sz :: number
	local box = { x0 = deck.x - sx / 2, x1 = deck.x + sx / 2, z0 = deck.z - sz / 2, z1 = deck.z + sz / 2, y0 = 0, y1 = 0 }
	local half = spanHalf(box, s.faceX)
	local lobby = level.index == 1
	-- Ahead of the spawn, at the deck's leading edge: the runner starts looking through the
	-- gate (behind the spawn its pillars and card filled the camera).
	local ahead = (if s.faceX ~= 0 then sx else sz) / 2 - 1.6
	local base = facing(deck.x + s.faceX * ahead, deck.y, deck.z + s.faceZ * ahead, s.faceX, s.faceZ)
	local add = adder(base, parent)
	local accent = color((level :: any).accent or "RainbowBlue")
	archFrame(add, half, if lobby then W.RainbowRed else accent)
	-- The big GO GO GO! marquee (1.4x the old 4.2-stud banner, text to match): as wide as
	-- the arch, its bottom edge sunk into the crown, on a white ledge.
	local signScale = 1.4
	local signW, signH = half * 2 + 4.6, 4.2 * signScale
	local signY = ARCH_SPRING + half + signH / 2
	decor(add({
		Name = "StartSignLedge",
		Size = Vector3.new(signW + 1, 0.8, 2.2),
		CFrame = CFrame.new(0, signY - signH / 2 + 0.4, 0),
		Color = W.White,
	}))
	local sign = decor(add({
		Name = "StartSign",
		Size = Vector3.new(signW, signH, 1),
		CFrame = CFrame.new(0, signY, 0),
		Color = W.Cream,
	}))
	local pps = math.floor(44 / signScale + 0.5)
	-- The card's Front face (-Z) looks along the course.
	local first = (level :: any).STAGE_FIRST or 1
	if lobby then
		cardFace(sign, Enum.NormalId.Front, pps, W.Cream, W.RainbowGreen, "CHAD OBBY", "START")
		cardFace(sign, Enum.NormalId.Back, pps, W.Cream, W.RainbowRed, "STAGE " .. first, "GO GO GO!")
		if top then
			checker(top, sx, sz)
		end
		blockLetters("CHAD OBBY", base * CFrame.new(0, signY + signH / 2 + 2.5, 4), parent)
	else
		cardFace(sign, Enum.NormalId.Front, pps, W.Cream, accent, string.upper(level.name), "STAGE " .. first)
		cardFace(sign, Enum.NormalId.Back, pps, W.Cream, W.Coral, "STAGE " .. first, "GO GO GO!")
	end
	local keys = { "RainbowRed", "RainbowYellow", "RainbowGreen", "RainbowBlue", "RainbowPurple" }
	for i, key in keys do
		-- Spread along the deck's two side edges (parallel to the course direction).
		local t = 0.5 - 1.5 * (i - 1) / (#keys - 1) -- clear of the arch pillars ahead
		local side = if i % 2 == 0 then 1 else -1
		local along, across = t * ((if s.faceX ~= 0 then sx else sz) / 2 - 1.2), side * ((if s.faceX ~= 0 then sz else sx) / 2 - 0.8)
		local px = deck.x + (if s.faceX ~= 0 then along else across)
		local pz = deck.z + (if s.faceX ~= 0 then across else along)
		flagPole(px, deck.y, pz, 7, color(key), nil, math.atan2(-s.faceX, -s.faceZ) + math.pi / 2, parent)
	end
end

-- Level `level`'s parts into `parent`.
local function buildCourse(level: Course.Level, parent: Instance)
	local tops: { [Course.Element]: BasePart } = {}
	local deck = level.PATH[1]
	local lobby = level.index == 1
	for _, e in level.ELEMENTS do
		if e.kind == "pad" then
			local top = platform(e, e.name or "Platform", parent, false, if lobby and e == deck then LOBBY_GREEN else nil)
			if e == deck then
				tops[e] = top
			end
		elseif e.kind == "mover" then
			tops[e] = mover(e, parent)
		elseif e.kind == "blink" then
			tops[e] = blink(e, parent)
		elseif e.kind == "spinner" then
			spinner(e, parent)
		elseif e.kind == "bounce" then
			bounce(e, parent)
		elseif e.kind == "wall" then
			wall(e, parent)
		elseif e.kind == "slide" then
			slide(e, parent)
		elseif e.kind == "kill" then
			killBrick(e, parent)
		end
	end
	-- Kill strips kept outside ELEMENTS (if Course lists them separately).
	for _, e in ((level :: any).KILLS or {}) :: { Course.Element } do
		if not table.find(level.ELEMENTS, e) then
			killBrick(e, parent)
		end
	end
	-- A chevron on each top toward the next one (none on the bounce deck: its pad is the hint;
	-- the rest decks where checkpoints used to be are plain pads and get one too).
	for i, e in level.PATH do
		-- (none on blink pads either: their slab is the only part that fades.)
		if e.kind ~= "slide" and e.kind ~= "blink" then
			local nextE = level.PATH[i + 1]
			if nextE and e.name ~= "BounceDeck" then
				chevron(e, nextE, if e == deck then parent else tops[e] or parent)
			end
		end
	end
	if deck then
		startArch(level, deck, tops[deck], parent)
	end

	-- Finish: a sunny trophy arch over the finish deck, front facing the incoming runner: two
	-- pillars, a rounded half-circle of candy segments, a FINISH banner between the pillars
	-- and the spinning trophy standing on the banner inside the arch.
	local f = level.FINISH
	local fa = level.FINISH_ARCH
	local base = facing(fa.x, fa.y, fa.z, fa.faceX, fa.faceZ)
	local add = adder(base, parent)
	local half = spanHalf(f, fa.faceX)
	archFrame(add, half, W.Sunny)
	-- The FINISH banner, 1.4x the old 4.2-stud card (text to match).
	local bannerScale = 1.4
	local bannerY, bannerH = 9.5, 4.2 * bannerScale
	local sign = decor(add({
		Name = "FinishSign",
		Size = Vector3.new((half * 2 + 3.4) * bannerScale, bannerH, 1),
		CFrame = CFrame.new(0, bannerY, 0),
		Color = W.Cream,
	}))
	local bannerPps = math.floor(44 / bannerScale + 0.5)
	cardFace(sign, Enum.NormalId.Front, bannerPps, W.Cream, W.Teal, "YOU DID IT!", "FINISH")
	cardFace(sign, Enum.NormalId.Back, bannerPps, W.Cream, W.Coral, "WELL DONE!", "WORLD " .. level.index .. " CLEAR")
	-- Chequered finish line on the deck, its bottom 0.05 above the deck top.
	local line = add({ Name = "FinishLine", Size = Vector3.new(half * 2 - 1, 0.12, 2.4), CFrame = CFrame.new(0, 0.11, 0), Color = W.White })
	local cols = 12
	local grid = surface(line, Enum.NormalId.Top, 10)
	for row = 0, 1 do
		for col = 0, cols - 1 do
			if (row + col) % 2 == 0 then
				local cell = Instance.new("Frame")
				cell.BackgroundColor3 = W.Ink
				cell.BorderSizePixel = 0
				cell.Position = UDim2.fromScale(col / cols, row / 2)
				cell.Size = UDim2.fromScale(1 / cols, 0.5)
				cell.Parent = grid
			end
		end
	end
	-- Spinning gold trophy (Client.Fx.Ambient turns models with a Spin attribute).
	local trophy = Instance.new("Model")
	trophy.Name = "Trophy"
	trophy:SetAttribute("Spin", 0.8)
	local tBase = base * CFrame.new(0, bannerY + bannerH / 2, 0)
	local root = decor(make("Part", {
		Name = "TrophyBase",
		Size = Vector3.new(2.6, 0.9, 2.6),
		CFrame = tBase * CFrame.new(0, 0.45, 0),
		Color = W.Cream,
		Parent = trophy,
	}))
	trophy.PrimaryPart = root
	decor(make("Part", {
		Name = "TrophyStem",
		Shape = CYLINDER,
		Size = Vector3.new(1.4, 0.8, 0.8),
		CFrame = tBase * CFrame.new(0, 1.6, 0) * UPRIGHT,
		Color = W.Sunny,
		Parent = trophy,
	}))
	decor(make("Part", {
		Name = "TrophyCup",
		Shape = CYLINDER,
		Size = Vector3.new(2.4, 3, 3),
		CFrame = tBase * CFrame.new(0, 3.3, 0) * UPRIGHT,
		Color = W.Sunny,
		Parent = trophy,
	}))
	decor(
		make(
			"Part",
			{ Name = "TrophyBowl", Shape = BALL, Size = cube(3), CFrame = tBase * CFrame.new(0, 2.4, 0), Color = W.Sunny, Parent = trophy }
		)
	)
	for _, sx in { -1, 1 } do
		decor(make("Part", {
			Name = "TrophyHandle",
			Shape = BALL,
			Size = cube(1.2),
			CFrame = tBase * CFrame.new(sx * 1.8, 3.3, 0),
			Color = W.Orange,
			Parent = trophy,
		}))
	end
	trophy.Parent = parent

	local finish = trigger(
		"ParkourFinish",
		CFrame.new((f.x0 + f.x1) / 2, (f.y0 + f.y1) / 2, (f.z0 + f.z1) / 2),
		Vector3.new(f.x1 - f.x0, f.y1 - f.y0, f.z1 - f.z0),
		parent
	)
	finish:SetAttribute("Level", level.index)
	local w = level.WATER_BOX
	local water = trigger(
		"ParkourWater",
		CFrame.new((w.x0 + w.x1) / 2, (w.y0 + w.y1) / 2, (w.z0 + w.z1) / 2),
		Vector3.new(w.x1 - w.x0, w.y1 - w.y0, w.z1 - w.z0),
		parent
	)
	water:SetAttribute("Level", level.index)

	cloudFloor(level, parent)
	MapDecor.build(level, parent)
end

-- The plaza specs: the GAME MODES plaza on -X and, when Course has it, the mirrored one on +X
-- (Course.PLAZA2 / SPUR2 / GATES2 / GATE2_X; the big sign is mirrored from BIG_SIGN).
local function sorted<T>(box: T): T
	local b = table.clone(box :: any)
	b.x0, b.x1 = math.min(b.x0, b.x1), math.max(b.x0, b.x1)
	if b.z0 and b.z1 then
		b.z0, b.z1 = math.min(b.z0, b.z1), math.max(b.z0, b.z1)
	end
	return b :: any
end

local function plazaSpecs(): { PlazaSpec }
	local specs: { PlazaSpec } = {
		{
			plaza = sorted(Course.PLAZA),
			spur = sorted(Course.SPUR),
			gates = Course.GATES,
			gateX = Course.GATE_X,
			sign = Course.BIG_SIGN,
			mirror = 1,
			portal = 1,
		},
	}
	local c = Course :: any
	if c.PLAZA2 and c.SPUR2 then
		local sign = table.clone(Course.BIG_SIGN)
		sign.x = -sign.x
		table.insert(specs, {
			plaza = sorted(c.PLAZA2),
			spur = sorted(c.SPUR2),
			gates = c.GATES2 or Course.GATES,
			gateX = c.GATE2_X or -Course.GATE_X,
			sign = sign,
			mirror = -1,
			portal = 2,
		})
	end
	return specs
end

function Modes.build(): Built
	local folder = Instance.new("Folder")
	folder.Name = "GameModes"
	folder.Parent = mapFolder
	local parkour = Instance.new("Folder")
	parkour.Name = "Parkour"
	parkour:SetAttribute("Mode", "parkour")
	parkour:SetAttribute("Levels", Course.LEVEL_COUNT)
	parkour.Parent = folder

	-- Plaza (and Plaza2, mirrored on the hub's +X side); one best-times board, on Plaza.
	local list: TextLabel = nil :: any
	for i, spec in plazaSpecs() do
		local plaza = Instance.new("Folder")
		plaza.Name = if i == 1 then "Plaza" else "Plaza" .. i
		plaza:SetAttribute("Portal", spec.portal)
		plaza.Parent = folder
		buildPlaza(plaza, spec)
		for _, entry in Catalog do
			gate(entry, plaza, spec)
		end
		bigSign(plaza, spec)
		if i == 1 then
			list = bestBoard(plaza, spec)
		end
	end
	skyClouds()
	for i, level in Course.LEVELS do
		local levelFolder = Instance.new("Folder")
		levelFolder.Name = "Level" .. i
		levelFolder:SetAttribute("Mode", "parkour")
		levelFolder:SetAttribute("Level", i)
		levelFolder:SetAttribute("Title", level.name)
		levelFolder:SetAttribute("LevelName", level.name)
		local map: any = level
		levelFolder:SetAttribute("Theme", map.theme or "beach")
		levelFolder:SetAttribute("Blurb", map.blurb or "")
		levelFolder:SetAttribute("Icon", map.icon or "")
		levelFolder:SetAttribute("Accent", map.accent or "Sunny")
		local first = map.STAGE_FIRST or 1
		levelFolder:SetAttribute("StageFirst", first)
		levelFolder:SetAttribute("StageLast", map.STAGE_LAST or first + 1)
		buildCourse(level, levelFolder)
		buildBridge(i, levelFolder)
		levelFolder.Parent = parkour
	end
	return { folder = folder, bestList = list }
end

return Modes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="205">
          <Properties>
            <string name="Name">MogStage</string>
            <string name="Source"><![CDATA[--[[
	MogStage: the MOG TEST stage, a round "toy" boxing ring floating out at sea on pontoons
	(teleport-only; Modes.Mog brings players here). Numbers live in Modes.MogLayout.

	- A thick Teal disc with a Cream top, a ring of Sunny/Coral bumpers on the rim and a Grape
	  skirt underneath, on six pontoon floats with foam at sea level.
	- Posts with glowing caps (dim PointLights) and two rows of ropes, like a boxing ring.
	- SPOT_COUNT duel spots: a Sunny pad for the player and a Grape pad for the rival, each on
	  a glowing Neon ring.
	- A central tower with a 4-sided "MOG TEST" sign (2-line card faces like the plaza gates)
	  and a "TOP MOGGERS" board near the rim (its list label is returned as bestList).
]]

local Common = require(script.Parent.Common)
local MogLayout = require(script.Parent.Parent.Modes.MogLayout)

local theme = Common.theme
local make = Common.make
local UPRIGHT = Common.UPRIGHT
local W = theme.World
local CYLINDER = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball

local MogStage = {}

export type Built = {
	folder: Model,
	bestList: TextLabel,
}

local C = MogLayout.CENTER
local TOP = C.y
local FOAM_Y = MogLayout.SEA_Y + 0.4
local LAMP = Color3.fromRGB(255, 236, 205)

local function decor(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function add(parent: Instance, props: { [string]: any }): BasePart
	props.Parent = parent
	return make("Part", props)
end

-- An upright cylinder (disc) of diameter `d` and height `h` whose centre is at `pos`.
local function disc(parent: Instance, name: string, pos: Vector3, d: number, h: number, colour: Color3): BasePart
	return add(parent, {
		Name = name,
		Shape = CYLINDER,
		Size = Vector3.new(h, d, d),
		CFrame = CFrame.new(pos) * UPRIGHT,
		Color = colour,
	})
end

local function vec(p: MogLayout.Point): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function light(p: BasePart, brightness: number, range: number, colour: Color3?)
	local l = Instance.new("PointLight")
	l.Brightness = brightness
	l.Range = range
	l.Color = colour or LAMP
	l.Shadows = false
	l.Parent = p
end

local function surface(p: BasePart, face: Enum.NormalId, pixelsPerStud: number): Frame
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Parent = p
	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Parent = gui
	return root
end

local function panel(parent: Instance, fill: Color3, position: UDim2, size: UDim2, corner: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = fill
	f.BorderSizePixel = 0
	f.Position = position
	f.Size = size
	f.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(corner or 0.08, 0)
	c.Parent = f
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = theme.Fonts.Display
	l.TextColor3 = W.Ink
	l.Size = UDim2.fromScale(1, 1)
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

-- A 2-line sign card: a coloured header band with `header` and a big Ink `title` below.
local function cardFace(p: BasePart, face: Enum.NormalId, pps: number, band: Color3, header: string, title: string)
	local root = surface(p, face, pps)
	local card = panel(root, W.Cream, UDim2.fromScale(0.02, 0.04), UDim2.fromScale(0.96, 0.92), 0.1)
	local head = panel(card, band, UDim2.fromScale(0.04, 0.06), UDim2.fromScale(0.92, 0.3), 0.5)
	text(head, { Text = header, TextColor3 = W.White, Size = UDim2.fromScale(0.92, 0.76), Position = UDim2.fromScale(0.04, 0.12) })
	text(card, { Text = title, Size = UDim2.fromScale(0.92, 0.54), Position = UDim2.fromScale(0.04, 0.4) })
end

-- The floating disc: Teal body, Cream top, rim bumpers, Grape skirt, pontoons and foam.
local function buildDisc(parent: Instance)
	local r, t = MogLayout.RADIUS, MogLayout.THICKNESS
	disc(parent, "StageBody", Vector3.new(C.x, TOP - 0.2 - t / 2, C.z), r * 2, t, W.Teal)
	disc(parent, "StageTop", Vector3.new(C.x, TOP - 0.5, C.z), r * 2 - 4, 1, W.Cream)
	disc(parent, "StageInlay", Vector3.new(C.x, TOP - 0.45, C.z), 30, 1, W.Sunny)
	disc(parent, "StageCore", Vector3.new(C.x, TOP - 0.4, C.z), 24, 1, W.Cream)
	disc(parent, "StageSkirt", Vector3.new(C.x, TOP - t - 1.2, C.z), r * 2 - 6, 2, W.Grape)
	-- Rim bumpers: alternating Sunny / Coral blocks around the edge.
	local bumpers = 24
	local seg = 2 * math.pi * r / bumpers
	for i = 1, bumpers do
		local a = (i - 0.5) * 2 * math.pi / bumpers
		local p = MogLayout.at(a, r - 0.6, TOP - 0.1)
		decor(add(parent, {
			Name = "RimBumper",
			Size = Vector3.new(seg * 0.82, 1.4, 1.6),
			CFrame = CFrame.lookAt(vec(p), Vector3.new(C.x, p.y, C.z)),
			Color = if i % 2 == 0 then W.Sunny else W.Coral,
		}))
	end
	-- Pontoon floats from below sea level up to the skirt, with foam rings.
	local skirtBottom = TOP - t - 2.2
	local floatBottom = MogLayout.SEA_Y - 2.5
	local h = skirtBottom - floatBottom
	for i = 1, 6 do
		local a = (i - 0.5) * math.pi / 3
		local p = MogLayout.at(a, r - 14, floatBottom + h / 2)
		local float = decor(disc(parent, "PontoonFloat", vec(p), 9, h, if i % 2 == 0 then W.Coral else W.White))
		float.CanCollide = true
		decor(disc(parent, "PontoonBand", Vector3.new(p.x, MogLayout.SEA_Y + 1.2, p.z), 9.4, 0.8, W.Sunny))
		local foam = decor(disc(parent, "PontoonFoam", Vector3.new(p.x, FOAM_Y, p.z), 13, 0.1, W.White))
		foam.Transparency = 0.35
		foam.CastShadow = false
	end
	local ring = decor(disc(parent, "StageFoam", Vector3.new(C.x, FOAM_Y - 0.05, C.z), r * 2 - 10, 0.1, W.White))
	ring.Transparency = 0.6
	ring.CastShadow = false
end

-- Ring posts with glowing caps and two rows of ropes between them.
local function buildRopes(parent: Instance)
	local posts = 8
	local postH = 6.5
	local points = {}
	for i = 1, posts do
		local a = (i - 0.5) * 2 * math.pi / posts
		local p = MogLayout.at(a, MogLayout.POST_RING, TOP)
		table.insert(points, p)
		add(parent, {
			Name = "RingPost",
			Shape = CYLINDER,
			Size = Vector3.new(postH, 1.4, 1.4),
			CFrame = CFrame.new(p.x, TOP + postH / 2, p.z) * UPRIGHT,
			Color = W.White,
		})
		local cap = decor(add(parent, {
			Name = "PostLamp",
			Shape = BALL,
			Size = Vector3.new(2.2, 2.2, 2.2),
			CFrame = CFrame.new(p.x, TOP + postH + 0.7, p.z),
			Color = if i % 2 == 0 then W.Sunny else W.Grape,
			Material = Enum.Material.Neon,
		}))
		light(cap, 0.6, 18)
	end
	for i = 1, posts do
		local a, b = points[i], points[i % posts + 1]
		for row, y in { 2.6, 4.8 } do
			local pa = Vector3.new(a.x, TOP + y, a.z)
			local pb = Vector3.new(b.x, TOP + y, b.z)
			local len = (pb - pa).Magnitude
			add(parent, {
				Name = "Rope",
				Shape = CYLINDER,
				Size = Vector3.new(len, 0.5, 0.5),
				CFrame = CFrame.lookAt((pa + pb) / 2, pb) * CFrame.Angles(0, math.rad(90), 0),
				Color = if row == 1 then W.Coral else W.Teal,
			})
		end
	end
end

-- Duel pads: a Sunny pad (player) and a Grape pad (rival) per spot, each on a glowing ring.
local function buildPads(parent: Instance)
	local h = MogLayout.PAD_HEIGHT
	local d = MogLayout.PAD_RADIUS * 2
	for _, spot in MogLayout.SPOTS do
		for _, which in { "player", "rival" } do
			local p = (spot :: any)[which] :: MogLayout.Point
			local colour = if which == "player" then W.Sunny else W.Grape
			local glow = decor(disc(parent, "DuelGlow", Vector3.new(p.x, TOP + h / 2 - 0.05, p.z), d + 1.6, h - 0.1, colour))
			glow.Material = Enum.Material.Neon
			glow.Transparency = 0.2
			local pad = disc(parent, "DuelPad", Vector3.new(p.x, TOP + h / 2, p.z), d, h, colour:Lerp(W.White, 0.15))
			pad:SetAttribute("Spot", spot.index)
			pad:SetAttribute("Side", which)
			light(pad, 0.5, 10, colour)
		end
	end
end

-- The central tower with the 4-sided MOG TEST sign above everyone's heads.
local function buildTower(parent: Instance)
	local r = MogLayout.TOWER_RADIUS
	disc(parent, "TowerFoot", Vector3.new(C.x, TOP + 0.5, C.z), r * 2 + 2, 1, W.Teal)
	local colH = 14
	disc(parent, "TowerColumn", Vector3.new(C.x, TOP + 1 + colH / 2, C.z), 3, colH, W.White)
	local size = 13
	local signY = TOP + 1 + colH + 3.5
	local box = add(parent, {
		Name = "MogSign",
		Size = Vector3.new(size, 7, size),
		CFrame = CFrame.new(C.x, signY, C.z),
		Color = W.Grape,
	})
	local faces = {
		{ Enum.NormalId.Front, W.Coral, "MOG TEST" },
		{ Enum.NormalId.Back, W.Coral, "MOG TEST" },
		{ Enum.NormalId.Left, W.Teal, "MOG TEST" },
		{ Enum.NormalId.Right, W.Teal, "MOG TEST" },
	}
	for _, f in faces do
		cardFace(box, f[1], 24, f[2], f[3], "MOG 3 RIVALS!")
	end
	for _, y in { signY - 3.9, signY + 3.9 } do
		decor(add(parent, {
			Name = "SignTrim",
			Size = Vector3.new(size + 0.8, 0.8, size + 0.8),
			CFrame = CFrame.new(C.x, y, C.z),
			Color = W.Sunny,
		}))
	end
	local crown = decor(add(parent, {
		Name = "SignCrown",
		Shape = BALL,
		Size = Vector3.new(3.4, 3.4, 3.4),
		CFrame = CFrame.new(C.x, signY + 6, C.z),
		Color = W.Sunny,
		Material = Enum.Material.Neon,
	}))
	light(crown, 0.8, 30)
end

-- The TOP MOGGERS board near the rim, facing the centre. Returns its list label.
local function buildBoard(parent: Instance): TextLabel
	local p = MogLayout.at(MogLayout.BOARD_ANGLE, MogLayout.BOARD_RING, TOP)
	local base = CFrame.lookAt(Vector3.new(p.x, TOP, p.z), Vector3.new(C.x, TOP, C.z))
	local w, h, bottom = 11, 12, 2.5
	for _, sx in { -1, 1 } do
		local x = sx * (w / 2 + 0.6)
		add(parent, {
			Name = "BoardPost",
			Shape = CYLINDER,
			Size = Vector3.new(bottom + h + 0.4, 1.3, 1.3),
			CFrame = base * CFrame.new(x, (bottom + h + 0.4) / 2, 0) * UPRIGHT,
			Color = W.Teal,
		})
		decor(add(parent, {
			Name = "BoardCap",
			Shape = BALL,
			Size = Vector3.new(2, 2, 2),
			CFrame = base * CFrame.new(x, bottom + h + 0.8, 0),
			Color = W.Sunny,
		}))
	end
	local slab = decor(add(parent, {
		Name = "MogBestBoard",
		Size = Vector3.new(w, h, 0.8),
		CFrame = base * CFrame.new(0, bottom + h / 2, 0),
		Color = W.White,
	}))
	local root = surface(slab, Enum.NormalId.Front, 30)
	local card = panel(root, W.Cream, UDim2.fromScale(0.03, 0.025), UDim2.fromScale(0.94, 0.95), 0.06)
	local pill = panel(card, W.Grape, UDim2.fromScale(0.06, 0.03), UDim2.fromScale(0.88, 0.13), 0.5)
	text(pill, { Text = "TOP MOGGERS", TextColor3 = W.White, Size = UDim2.fromScale(0.9, 0.74), Position = UDim2.fromScale(0.05, 0.13) })
	text(card, {
		Text = "SERVER HIGH SCORES",
		Font = theme.Fonts.Bold,
		Size = UDim2.fromScale(0.8, 0.06),
		Position = UDim2.fromScale(0.1, 0.17),
	})
	local list = text(card, {
		Text = "Be the first to pass!",
		Font = theme.Fonts.Bold,
		TextScaled = false,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.fromScale(0.86, 0.72),
		Position = UDim2.fromScale(0.07, 0.25),
	})
	local back = surface(slab, Enum.NormalId.Back, 30)
	local backCard = panel(back, W.Cream, UDim2.fromScale(0.03, 0.025), UDim2.fromScale(0.94, 0.95), 0.06)
	text(backCard, { Text = "MOG TEST", Size = UDim2.fromScale(0.86, 0.3), Position = UDim2.fromScale(0.07, 0.35) })
	return list
end

function MogStage.build(): Built
	local folder = Instance.new("Model")
	folder.Name = "MogStage"
	folder.Parent = Common.mapFolder
	buildDisc(folder)
	buildRopes(folder)
	buildPads(folder)
	buildTower(folder)
	local list = buildBoard(folder)
	return { folder = folder, bestList = list }
end

return MogStage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="206">
          <Properties>
            <string name="Name">Pads</string>
            <string name="Source"><![CDATA[--[[
	Pads: the step-on pads and their floating labels.
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.

	Every pad is a small flat button: a coloured top (one colour per job, Theme.World.Pads:
	butter buys, sunny-orange merge, blue deposit, warm special pads) on a thin, low rounded base
	in Theme.World.PadRim reaching Layout.PAD_RIM past it. The top carries a small printed icon
	("+5", "$", a gift) in Theme.World.PadPrint. Above each pad floats its label (a
	BillboardGui): the name (`title`) in white and, under it, the price or status Tycoon writes
	into `sub`, in white on a small rounded plate (Theme.World.PadPlate: green when Tycoon
	tints `sub` Good, soft red when Bad, dark otherwise), both with an Ink outline so they read
	on every pad colour. Merge shows only its name in sunny yellow, bigger and over the pad's
	far edge; Deposit's label floats above head height. On a plot nobody owns the names are
	dimmed (setClaimed). A disabled pad turns soft grey (Theme.Colors.PadDisabled).
]]

local Layout = require(script.Parent.Parent.PlotLayout)
local Common = require(script.Parent.Common)

type Builder = Common.Builder
type Pad = Common.Pad

local UPRIGHT = Common.UPRIGHT
local theme = Common.theme
local World = theme.World
local RIM = World.PadRim or World.Teal

local Pads = {}

-- Rim (base) height; the painted top stands a hair proud of it.
local RIM_TOP = 0.35
-- The deposit pad's frame stands a little taller.
local RIM_TOP_BIG = 0.6
local TOP_THICK = 0.3
-- Height of the coloured top above the base.
local TOP_RISE = 0.15
-- The trigger reaches this far past the coloured top (still on the base), so a character whose
-- root is over the top's edge counts as standing on it.
local TRIGGER_GROW = 0.4
-- Floating label: height of its bottom above the pad top, width in studs (wider for big pads),
-- and the camera distance it stops drawing at.
local LABEL_LIFT = 2.6
local LABEL_W = 6
local LABEL_W_MAX = 8
local LABEL_MAX_DISTANCE = 90
-- Pads whose label sits at another height. The deposit label floats over the head of a player
-- standing on its big pad (lower, the character and its dumbbell hid half of it) and clears the
-- Auto Merge label behind it in the spawn view; the bulk speed upgrade's clears the single
-- upgrade's; the merge label stays under the best unit's pedestal in the spawn view.
local LABEL_LIFTS: { [string]: number } = { Deposit = 6.4, ProcUp10 = 4.2, Merge = 3.2 }
-- Pads whose label is wider or narrower than their size gives: the merge name is 1.5x larger,
-- the deposit label a shorter line that fits in front of the converter's jar.
local LABEL_GROW: { [string]: number } = { Merge = 1.5, Deposit = 0.8 }
-- Pads whose label stands over the far edge (see farDir) instead of the centre, so a
-- character on the pad is in front of it, not inside it.
local LABEL_AT_FAR_EDGE: { [string]: boolean } = { Merge = true }
-- Share of the stud width that scales with distance, and the fixed pixel part added to it.
local LABEL_SCALE = 0.8
local LABEL_PX = 24
-- Price plate: its share of the label's height, and its width as a share of the label's: a
-- fixed padding plus a part per character, so a short price gets a short plate.
local PLATE_H = 0.52
local PLATE_PAD = 0.14
local PLATE_CHAR = 0.09
local PLATE_MIN = 0.32
-- Transparency of the name (and its outline) on a plot nobody owns.
local UNCLAIMED_DIM = 0.55

-- Pads that show a fixed label (their action) instead of a name and a price.
local STATIC: { [string]: boolean } = { Merge = true }

-- Which Theme.World.Pads colour each pad wears.
local JOB_KEYS: { [string]: string } = { Unlock1 = "Unlock", Unlock2 = "UnlockVip" }
local function jobKey(name: string): string
	if string.sub(name, 1, 3) == "Buy" then
		return "Buy"
	elseif string.sub(name, 1, 6) == "ProcUp" then
		return "Process"
	end
	return JOB_KEYS[name] or name
end

-- The big printed mark on each pad's top.
local function iconText(name: string): string
	local icons = theme.Icons
	if string.sub(name, 1, 3) == "Buy" then
		return "+" .. string.sub(name, 4)
	end
	local fixed = {
		AutoMerge = "AUTO",
		Merge = icons.Unit .. "+" .. icons.Unit,
		Deposit = icons.Orb,
		ProcUp1 = "⬆️",
		ProcUp10 = "⬆️x10",
		Collect = "$",
		Unlock1 = icons.Chest,
		Unlock2 = icons.Premium,
		Free = icons.Free,
	}
	return fixed[name] or ""
end

-- Plot-local direction from the pad toward its far edge, i.e. away from where the player walks
-- up. The top icon reads upright that way.
local function farDir(name: string): Vector2
	if name == "Deposit" or name == "Collect" or string.sub(name, 1, 6) == "ProcUp" then
		return Vector2.new(-1, 0)
	elseif string.sub(name, 1, 6) == "Unlock" or name == "Free" then
		return Vector2.new(1, 0)
	end
	return Vector2.new(0, 1)
end

-- Each pad's job colour, print colour and top icon, so setEnabled can repaint them, and its
-- shown name with its outline, so setClaimed can dim them.
type Painted = { color: Color3, print: Color3, icon: TextLabel, title: TextLabel, titleStroke: UIStroke }
local painted: { [BasePart]: Painted } = setmetatable({}, { __mode = "k" }) :: any

local function corner(parent: Instance, scale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, 0)
	c.Parent = parent
end

local function outline(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = parent
	return s
end

local function sameColor(a: Color3, b: Color3): boolean
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.01
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.TextWrapped = true
	l.Font = theme.Fonts.Display
	l.TextColor3 = World.Ink
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

-- Thin rounded base: two crossed slabs plus a cylinder in each corner, so the outline is a
-- rounded rectangle Layout.PAD_RIM wider than the top on every side, `height` tall.
local function buildRim(B: Builder, x: number, z: number, sx: number, sz: number, height: number)
	local L, P = B.L, B.P
	local r = Layout.PAD_RIM
	local y = height / 2
	P({ Name = "PadBase", Size = Vector3.new(sx + 2 * r, height, sz), CFrame = L(x, y, z), Color = RIM })
	P({ Name = "PadBase", Size = Vector3.new(sx, height, sz + 2 * r), CFrame = L(x, y, z), Color = RIM })
	for _, dx in { -1, 1 } do
		for _, dz in { -1, 1 } do
			P({
				Name = "PadBase",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(height, 2 * r, 2 * r),
				CFrame = L(x + dx * sx / 2, y, z + dz * sz / 2) * UPRIGHT,
				Color = RIM,
			})
		end
	end
end

-- The printed mark on the pad top: a rim-coloured inner border and a big unstroked icon in
-- `printColor`, drawn on `face`. Returns the icon.
local function buildTopPrint(padPart: BasePart, face: Enum.NormalId, round: boolean, name: string, printColor: Color3): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PadPrint"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.Parent = padPart
	local border = Instance.new("Frame")
	border.Name = "Border"
	border.AnchorPoint = Vector2.new(0.5, 0.5)
	border.Position = UDim2.fromScale(0.5, 0.5)
	border.Size = UDim2.fromScale(0.86, 0.86)
	border.BackgroundTransparency = 1
	border.Parent = gui
	corner(border, if round then 0.5 else 0.18)
	local ring = Instance.new("UIStroke")
	ring.Color = RIM
	ring.Thickness = 4
	ring.Transparency = 0
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = border
	local icon = text(gui, {
		Name = "PadIcon",
		Text = iconText(name),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(if round then 0.5 else 0.6, if round then 0.36 else 0.46),
		TextColor3 = printColor,
	})
	return icon
end

-- The floating label above a pad: a BillboardGui `offset` (world space) from the pad top with
-- the name on top and the price plate under it, the name and the price in white with an Ink
-- outline. `width` is in studs; part of the size is fixed pixels, so the label shrinks less
-- than the world with distance and does not fill the screen when the camera is beside the pad.
-- Returns (name, its outline, plate, price).
local function buildLabel(padPart: BasePart, offset: Vector3, width: number): (TextLabel, UIStroke, Frame, TextLabel)
	local h = width * 0.34
	local white = World.White or Color3.new(1, 1, 1)
	local gui = Instance.new("BillboardGui")
	gui.Name = "PadLabel"
	gui.Adornee = padPart
	gui.Size = UDim2.new(width * LABEL_SCALE, LABEL_PX, h * LABEL_SCALE, LABEL_PX * 0.34)
	gui.StudsOffsetWorldSpace = offset + Vector3.new(0, h / 2, 0)
	gui.MaxDistance = LABEL_MAX_DISTANCE
	gui.LightInfluence = 0
	gui.Parent = padPart
	local title = text(gui, {
		Name = "Title",
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(1, 0.44),
		TextColor3 = white,
	})
	local titleStroke = outline(title, World.Ink, 2)
	local plate = Instance.new("Frame")
	plate.Name = "Main"
	plate.AnchorPoint = Vector2.new(0.5, 0)
	plate.Position = UDim2.fromScale(0.5, 0.46)
	plate.Size = UDim2.fromScale(1, PLATE_H)
	plate.BorderSizePixel = 0
	plate.Visible = false
	plate.Parent = gui
	corner(plate, 0.35)
	outline(plate, World.Ink, 1.5)
	local price = text(plate, {
		Name = "Price",
		Text = "",
		Font = theme.Fonts.Number,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.88, 0.84),
		TextColor3 = white,
	})
	outline(price, World.Ink, 2)
	return title, titleStroke, plate, price
end

-- Shows what Server.Tycoon writes into the hidden `sub` label: its text as the white price,
-- its Good / Bad tint as the plate's colour. No text, no plate.
local function bindPrice(sub: TextLabel, plate: Frame, price: TextLabel)
	local plates = World.PadPlate or {}
	local plain = plates.Plain or World.Ink
	local function show()
		local shown = sub.Text
		local tint = sub.TextColor3
		price.Text = shown
		plate.Visible = shown ~= ""
		plate.Size = UDim2.fromScale(math.clamp(PLATE_PAD + PLATE_CHAR * (utf8.len(shown) or #shown), PLATE_MIN, 1), PLATE_H)
		if sameColor(tint, theme.Colors.Good) then
			plate.BackgroundColor3 = plates.Good or plain
		elseif sameColor(tint, theme.Colors.Bad) then
			plate.BackgroundColor3 = plates.Bad or plain
		else
			plate.BackgroundColor3 = plain
		end
	end
	sub:GetPropertyChangedSignal("Text"):Connect(show)
	sub:GetPropertyChangedSignal("TextColor3"):Connect(show)
	show()
end

local function buildPad(B: Builder, name: string, color: Color3, title: string, sub: string): Pad
	local L, P = B.L, B.P
	local spot = Layout.PADS[name]
	assert(spot, "no layout for pad " .. name)
	local x, z, sx, sz = spot.x, spot.z, spot.sizeX, spot.sizeZ
	local job = jobKey(name)
	color = World.Pads[job] or color
	local printColor = (World.PadPrint and World.PadPrint[job]) or World.TealInk or World.Ink
	local far = farDir(name)
	local r = Layout.PAD_RIM
	local base = if name == "Deposit" then RIM_TOP_BIG else RIM_TOP
	local topY = base + TOP_RISE
	local padPart: BasePart
	local icon: TextLabel
	if spot.round then
		P({
			Name = "PadBase",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(base, sx + 2 * r, sx + 2 * r),
			CFrame = L(x, base / 2, z) * UPRIGHT,
			Color = RIM,
		})
		-- The cylinder's top cap is its Right face, whose GUI "up" is the part's +Y; the yaw turns
		-- that toward the far edge.
		padPart = P({
			Name = "Pad_" .. name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(TOP_THICK, sx, sz),
			CFrame = L(x, topY - TOP_THICK / 2, z) * CFrame.Angles(0, math.atan2(far.Y, -far.X), 0) * UPRIGHT,
			Color = color,
		})
		icon = buildTopPrint(padPart, Enum.NormalId.Right, true, name, printColor)
	else
		buildRim(B, x, z, sx, sz, base)
		-- A Top-face GUI reads upright toward the part's -Z, so the top is turned to point -Z at
		-- the far edge (swapping its size when that is sideways).
		local sideways = far.X ~= 0
		padPart = P({
			Name = "Pad_" .. name,
			Size = if sideways then Vector3.new(sz, TOP_THICK, sx) else Vector3.new(sx, TOP_THICK, sz),
			CFrame = L(x, topY - TOP_THICK / 2, z) * CFrame.Angles(0, math.atan2(-far.X, -far.Y), 0),
			Color = color,
		})
		icon = buildTopPrint(padPart, Enum.NormalId.Top, false, name, printColor)
	end

	local width = math.clamp(math.max(sx, sz) * 1.1, LABEL_W, LABEL_W_MAX) * (LABEL_GROW[name] or 1)
	local offset = Vector3.new(0, LABEL_LIFTS[name] or LABEL_LIFT, 0)
	if LABEL_AT_FAR_EDGE[name] then
		offset += B.cf:VectorToWorldSpace(Vector3.new(far.X * sx / 2, 0, far.Y * sz / 2))
	end
	local titleLine, titleStroke, plate, price = buildLabel(padPart, offset, width)
	painted[padPart] = { color = color, print = printColor, icon = icon, title = titleLine, titleStroke = titleStroke }
	-- Server.Tycoon writes the pad's name into `title` and the price / status into `sub` (and
	-- tints it); `sub` stays hidden and the plate shows it (bindPrice). Pads it never prices
	-- (Merge) show their action as one big sunny line; the labels it may clear stay hidden so
	-- the label keeps its fixed text.
	local titleLabel = titleLine
	local subLabel = text(titleLine, { Name = "Sub", Text = sub, Visible = false })
	if STATIC[name] then
		titleLine.Size = UDim2.fromScale(1, 1)
		titleLine.Text = string.upper(title)
		titleLine.TextColor3 = World.Sunny or color
		titleLabel = text(titleLine, { Name = "Title", Text = title, Visible = false })
	else
		titleLabel.Text = title
		bindPrice(subLabel, plate, price)
	end

	return {
		name = name,
		center = Vector3.new(x, 0, z),
		half = Vector2.new(sx / 2 + TRIGGER_GROW, sz / 2 + TRIGGER_GROW),
		part = padPart,
		title = titleLabel,
		sub = subLabel,
		defaultTitle = titleLabel.Text,
		defaultSub = sub,
		defaultTint = subLabel.TextColor3,
	}
end

-- Greys a pad out (soft Theme PadDisabled grey, never dark, with dark print) or restores its
-- job colour and print.
local function setEnabled(pad: Pad, enabled: boolean)
	local entry = painted[pad.part]
	if not entry then
		return
	end
	local fill = if enabled then entry.color else theme.Colors.PadDisabled
	local print = if enabled then entry.print else (World.TealInk or World.Ink)
	pad.part.Color = fill
	entry.icon.TextColor3 = print
end

-- Dims a pad's name on a plot nobody owns, or shows it in full once the plot has an owner.
local function setClaimed(pad: Pad, claimed: boolean)
	local entry = painted[pad.part]
	if not entry then
		return
	end
	local transparency = if claimed then 0 else UNCLAIMED_DIM
	entry.title.TextTransparency = transparency
	entry.titleStroke.Transparency = transparency
end

Pads.buildPad = buildPad
Pads.setEnabled = setEnabled
Pads.setClaimed = setClaimed

return Pads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="207">
          <Properties>
            <string name="Name">Pen</string>
            <string name="Source"><![CDATA[--[[
	Pen: the walled orb pen in front of the display ledge, its two side stairs, the gutter
	along the foot of the ledge and the chute that feeds the pen. All geometry comes from
	PlotLayout (PEN, POOL, PEN_STAIRS, GUTTER, CHUTE).

	Look: a light aqua floor (so orbs and crates pop) inside teal padded walls with cream caps,
	chunky teal corner posts topped by sunny round caps, a butter lip along the front, teal step
	blocks with cream edges, and a gutter and chute in one solid sunny yellow (butter round rail
	tops) so the slope reads against the teal and sand.
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.
]]

local Layout = require(script.Parent.Parent.PlotLayout)
local Common = require(script.Parent.Common)

type Builder = Common.Builder

local theme = Common.theme
local WHITE = Common.WHITE
local UPRIGHT = Common.UPRIGHT

local Pen = {}

local function worldColor(key: string, fallback: Color3): Color3
	local palette = theme.World
	return if palette and palette[key] then palette[key] else fallback
end

-- Purely decorative: never blocks the player, orbs or the camera.
local function decorative(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

-- The frame of a slope whose top surface runs from `from` to `to` along one horizontal axis
-- (X when the z's match, otherwise Z), centred on that surface line. Returns the frame and
-- whether the run is along X.
local function slopeFrame(B: Builder, from: Vector3, to: Vector3): (CFrame, boolean, number)
	local mid = (from + to) / 2
	local delta = to - from
	local alongX = math.abs(delta.X) >= math.abs(delta.Z)
	local tilt = if alongX
		-- Angles(0, 0, a) turns the part's X axis to (cos a, sin a, 0).
		then CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X))
		-- Angles(a, 0, 0) turns the part's Z axis to (0, -sin a, cos a).
		else CFrame.Angles(-math.atan2(delta.Y, delta.Z), 0, 0)
	return B.L(mid.X, mid.Y, mid.Z) * tilt, alongX, delta.Magnitude
end

-- A slab whose top surface runs from `from` to `to`, `width` across it and `thick` deep.
local function slope(B: Builder, name: string, from: Vector3, to: Vector3, width: number, thick: number, color: Color3): BasePart
	local frame, alongX, length = slopeFrame(B, from, to)
	return B.P({
		Name = name,
		Size = if alongX then Vector3.new(length, thick, width) else Vector3.new(width, thick, length),
		CFrame = frame * CFrame.new(0, -thick / 2, 0),
		Color = color,
	})
end

-- A round rod whose axis runs from `from` to `to`.
local function rod(B: Builder, name: string, from: Vector3, to: Vector3, diameter: number, color: Color3): BasePart
	local frame, alongX, length = slopeFrame(B, from, to)
	-- A cylinder's axis is its X axis; along Z, turn it a quarter about Y.
	return B.P({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, diameter, diameter),
		CFrame = if alongX then frame else frame * CFrame.Angles(0, math.pi / 2, 0),
		Color = color,
	})
end

local function buildWallsAndFloor(B: Builder): BasePart
	local L, P = B.L, B.P
	local pen = Layout.PEN
	local inner = pen.interior
	local outer = Layout.POOL
	local h, t = pen.wallHeight, pen.wallThick
	local cx = (inner.minX + inner.maxX) / 2
	local cz = (inner.minZ + inner.maxZ) / 2
	local w = inner.maxX - inner.minX
	local d = inner.maxZ - inner.minZ
	local wallColor = worldColor("Teal", B.c.WallTrim)
	local capColor = worldColor("Cream", WHITE)
	local topColor = worldColor("Sunny", B.c.Primary)
	local capH = 0.38

	local field = P({
		Name = "Field",
		Size = Vector3.new(w, 0.5, d),
		CFrame = L(cx, pen.floorY - 0.25, cz),
		Color = worldColor("Pool", B.c.Floor),
	})

	-- Padded walls: front and back span the full outer width; the sides fit between them.
	-- Each wall gets a cap slab a little wider than the wall (the front one is the butter lip).
	local frontZ, backZ = outer.minZ + t / 2, outer.maxZ - t / 2
	local leftX, rightX = outer.maxX - t / 2, outer.minX + t / 2
	for _, z in { frontZ, backZ } do
		P({
			Name = "PenWall",
			Size = Vector3.new(outer.maxX - outer.minX, h, t),
			CFrame = L(cx, h / 2, z),
			Color = wallColor,
		})
		if z == backZ then
			P({
				Name = "PenCap",
				Size = Vector3.new(outer.maxX - outer.minX, capH, t + 0.2),
				CFrame = L(cx, h - capH / 2 + 0.02, z),
				Color = capColor,
			})
		end
	end
	for _, x in { leftX, rightX } do
		P({
			Name = "PenWall",
			Size = Vector3.new(t, h, d),
			CFrame = L(x, h / 2, cz),
			Color = wallColor,
		})
		P({
			Name = "PenCap",
			Size = Vector3.new(t + 0.2, capH, d),
			CFrame = L(x, h - capH / 2 + 0.02, cz),
			Color = capColor,
		})
	end

	local ps = pen.postSize

	-- Chunky square corner posts, a little taller than the walls, each with a round sunny cap.
	for _, x in { leftX, rightX } do
		for _, z in { frontZ, backZ } do
			P({
				Name = "PenPost",
				Size = Vector3.new(ps, pen.postHeight, ps),
				CFrame = L(x, pen.postHeight / 2, z),
				Color = wallColor,
			})
			-- Collar just under the top, flush with the post's teal.
			P({
				Name = "PenPostBand",
				Size = Vector3.new(ps + 0.12, capH, ps + 0.12),
				CFrame = L(x, pen.postHeight - capH / 2 - 0.12, z),
				Color = wallColor,
			})
			P({
				Name = "PenPostCap",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.42, ps + 0.2, ps + 0.2),
				CFrame = L(x, pen.postHeight + 0.21, z) * UPRIGHT,
				Color = topColor,
			})
			decorative(P({
				Name = "PenPostKnob",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.3, 1.3, 1.3),
				CFrame = L(x, pen.postHeight + 0.42 + 0.5, z),
				Color = topColor,
			}))
		end
	end

	-- One warm butter lip capping the front wall between the posts.
	local lipStart = rightX + ps / 2
	local lipEnd = leftX - ps / 2
	decorative(P({
		Name = "PenLip",
		Size = Vector3.new(lipEnd - lipStart, capH, t + 0.2),
		CFrame = L((lipStart + lipEnd) / 2, h - capH / 2 + 0.02, frontZ),
		Color = worldColor("Butter", B.c.Secondary),
	}))
	return field
end

-- Walkable stairs over both side walls: three teal step blocks outside, one inside, each with
-- a cream edge strip along its open edge.
local function buildStairs(B: Builder)
	local stepColor = worldColor("Teal", B.c.WallTrim)
	local edgeColor = worldColor("Cream", WHITE)
	local wallInner = Layout.PEN.interior.maxX
	for _, stair in Layout.PEN_STAIRS do
		local side = stair.side
		for _, step in stair.steps do
			local r = step.rect
			local depth = r.maxZ - r.minZ
			B.P({
				Name = "PenStep",
				Size = Vector3.new(r.maxX - r.minX, step.top, depth),
				CFrame = B.L((r.minX + r.maxX) / 2, step.top / 2, (r.minZ + r.maxZ) / 2),
				Color = stepColor,
			})
			-- The open edge: away from the wall for outside steps, toward the pen for the inside one.
			local inside = math.abs((r.minX + r.maxX) / 2) < wallInner
			local edgeX = if inside
				then (if side > 0 then r.minX + 0.18 else r.maxX - 0.18)
				else (if side > 0 then r.maxX - 0.18 else r.minX + 0.18)
			decorative(B.P({
				Name = "PenStepEdge",
				Size = Vector3.new(0.36, 0.14, depth + 0.04),
				CFrame = B.L(edgeX, step.top - 0.05, (r.minZ + r.maxZ) / 2),
				Color = edgeColor,
			}))
		end
	end
end

-- The gutter at the foot of the ledge (draining to x = 0) and the slide-like chute into the pen.
local function buildGutterAndChute(B: Builder)
	local L, P = B.L, B.P
	local g = Layout.GUTTER
	local ch = Layout.CHUTE
	local r = g.rect
	local depth = r.maxZ - r.minZ
	-- One solid sunny yellow for the whole run so the slope reads; butter round rail tops.
	local slideColor = worldColor("Sunny", B.c.Primary)
	local rodColor = worldColor("Butter", B.c.Primary)

	-- Solid base up to the lowest point of the rolling surface.
	local baseTop = g.centerY - 0.3
	P({
		Name = "GutterBase",
		Size = Vector3.new(r.maxX - r.minX, baseTop, depth),
		CFrame = L((r.minX + r.maxX) / 2, baseTop / 2, g.z),
		Color = slideColor,
	})
	-- Sloped bed: each half falls from endY at its end to centerY at x = 0, with a wedge
	-- filling the gap below it.
	for _, side in { -1, 1 } do
		local endX = if side > 0 then r.maxX else r.minX
		slope(B, "GutterBed", Vector3.new(endX, g.endY, g.z), Vector3.new(0, g.centerY, g.z), depth, 0.3, slideColor)
		local fill = g.endY - g.centerY
		B.W({
			Name = "GutterFill",
			Size = Vector3.new(depth, fill, math.abs(endX)),
			-- A wedge's high end is its +Z face: turn it to face the gutter's end.
			CFrame = L(endX / 2, baseTop + fill / 2, g.z) * CFrame.Angles(0, side * math.pi / 2, 0),
			Color = slideColor,
		})
	end
	-- Front lip (with a round butter rail on top), open where the chute leaves.
	local lipTop = g.endY + g.lipHeight
	local lipBottom = baseTop - 0.3
	local gap = ch.width / 2
	for _, side in { -1, 1 } do
		local endX = if side > 0 then r.maxX else r.minX
		local len = math.abs(endX) - gap
		P({
			Name = "GutterLip",
			Size = Vector3.new(len, lipTop - lipBottom, 0.4),
			CFrame = L(side * (gap + len / 2), (lipTop + lipBottom) / 2, r.minZ + 0.2),
			Color = slideColor,
		})
		rod(B, "GutterRail", Vector3.new(side * gap, lipTop, r.minZ + 0.2), Vector3.new(endX, lipTop, r.minZ + 0.2), 0.55, rodColor)
	end
	-- End caps with a round knob.
	for _, side in { -1, 1 } do
		local x = side * (r.maxX - 0.3)
		P({
			Name = "GutterLip",
			Size = Vector3.new(0.6, lipTop, depth),
			CFrame = L(x, lipTop / 2, g.z),
			Color = slideColor,
		})
		decorative(P({
			Name = "GutterKnob",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			CFrame = L(x, lipTop + 0.35, r.minZ + 0.3),
			Color = rodColor,
		}))
	end

	-- Chute: a smooth sunny slide bed with raised sunny side walls and butter round rails,
	-- resting on the pen's back wall.
	local top = Vector3.new(ch.x, ch.topY, ch.topZ)
	local bottom = Vector3.new(ch.x, ch.bottomY, ch.bottomZ)
	slope(B, "Chute", top, bottom, ch.width, 0.4, slideColor)
	-- The side walls start at the gutter's front edge so orbs turning into the chute stay clear.
	local railRise = 0.6
	local railStart = bottom:Lerp(top, (r.minZ - ch.bottomZ) / (ch.topZ - ch.bottomZ))
	for _, side in { -1, 1 } do
		local offset = Vector3.new(side * (ch.width / 2 + 0.2), railRise, 0)
		slope(B, "ChuteRail", railStart + offset, bottom + offset, 0.4, railRise + 0.4, slideColor)
		rod(B, "ChuteRailTop", railStart + offset, bottom + offset, 0.5, rodColor)
	end
	-- Support under the chute between the gutter and the pen wall.
	local wallZ = Layout.POOL.maxZ
	local supportDepth = r.minZ - wallZ
	if supportDepth > 0.2 then
		local supportTop = ch.bottomY + (ch.topY - ch.bottomY) * (((wallZ + r.minZ) / 2 - ch.bottomZ) / (ch.topZ - ch.bottomZ)) - 0.5
		P({
			Name = "ChuteSupport",
			Size = Vector3.new(ch.width - 0.6, supportTop, supportDepth),
			CFrame = L(ch.x, supportTop / 2, (wallZ + r.minZ) / 2),
			Color = worldColor("Teal", B.c.WallTrim),
		})
	end
end

-- Builds the pen, its stairs, the gutter and the chute. Returns the pen floor ("Field").
function Pen.build(B: Builder): BasePart
	local field = buildWallsAndFloor(B)
	buildStairs(B)
	buildGutterAndChute(B)
	return field
end

return Pen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="208">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Props: puts the Blender-made meshes (ReplicatedStorage.AssetModels, see docs/assets.md) where
	the world has a part-built prop with an uploaded counterpart. When a model is missing
	(moderation, loading) nothing changes and the part-built version stays.

	Mesh frame: every uploaded model holds one MeshPart whose bounding box has its base centre
	at the model origin, front along -Z (Blender -Y), Y up, 1 stud per Blender unit. A MeshPart's
	CFrame is its bounding-box centre, so a mesh stands on a frame `base` at
	base * (0, Size.Y / 2, 0). ANCHOR lists the meshes whose contact point (pot, trunk, bench
	frame) is not under the bounding-box centre.

	Props.apply(root) swaps every Model under `root` with attribute Mesh = "<Kind>" (the
	Prop_<Kind> models of World.Decor and World.Hub):
	  * the mesh stands on the model's PrimaryPart ("PropRoot", base centre, front -Z);
	  * uniform scale: attribute MeshScale when set, else the part-built version's height;
	  * the part-built parts are removed, except PropRoot and parts with attribute
	    MeshKeep = true (signs the mesh leaves to the game);
	  * the mesh never collides, queries or touches (the camera does not pop on decor); when
	    the part-built version blocked the player, invisible "PropCollider" parts do (COLLIDERS,
	    or one box round the mesh);
	  * the model keeps its name (Client.Fx.Ambient finds Prop_PalmTree by name); the mesh is
	    named "<Kind>Mesh", tagged MESH_TAG and carries attribute MeshKey.
	World.Machines and Tycoon's crate builder place their meshes directly with Props.mesh;
Props.overlay gives a mesh a pastel colour wash (the crate smashers).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetModels = require(ReplicatedStorage.Shared.AssetModels)

local Props = {}

Props.MESH_TAG = "PropMeshPart"

local KEY_PREFIX = "props/"
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)
local WHITE = Color3.new(1, 1, 1)

-- Point (mesh units, from the bounding-box base centre) that stands on the prop's root.
local ANCHOR: { [string]: Vector3 } = {
	-- The bounding box includes the barbell rack at the bench's +Z end.
	Bench = Vector3.new(0, 0, -0.575),
	-- The crown leans away from the pot / trunk base.
	PalmPlanter = Vector3.new(0.7, 0, 0),
	PalmTree = Vector3.new(0, 0, -1.4),
}

-- Invisible colliders (mesh units, centres from the bounding-box base centre) for meshes whose
-- bounding box would block far more than the part-built version did. Other solid props get
-- one box round the mesh.
type Collider = { size: Vector3, center: Vector3, cylinder: boolean? }
local COLLIDERS: { [string]: { Collider } } = {
	PalmTree = { { size = Vector3.new(2, 10, 2), center = Vector3.new(0, 5, -1) } },
	PalmPlanter = { { size = Vector3.new(3, 2.6, 3), center = Vector3.new(0.7, 1.3, 0) } },
	JuiceBar = {
		{ size = Vector3.new(11, 0.65, 8.6), center = Vector3.new(0, 0.33, 0.2) },
		{ size = Vector3.new(9.8, 3.2, 2), center = Vector3.new(0, 1.6, -2.25) },
		{ size = Vector3.new(9.6, 4.6, 0.8), center = Vector3.new(0, 3, 4.58) },
	},
	-- Tiers: size = (height, diameter, diameter) of an upright cylinder.
	TrophyPodium = {
		{ size = Vector3.new(2.3, 18.2, 18.2), center = Vector3.new(0, 1.15, 0), cylinder = true },
		{ size = Vector3.new(2.3, 13.4, 13.4), center = Vector3.new(0, 3.45, 0), cylinder = true },
		{ size = Vector3.new(2.3, 9, 9), center = Vector3.new(0, 5.75, 0), cylinder = true },
	},
	-- Body and legs only: the flexed arms reach far past the pedestal.
	GigaStatue = { { size = Vector3.new(8.3, 21, 8.3), center = Vector3.new(0, 10.5, 0) } },
}

local function keyOf(kind: string): string
	return KEY_PREFIX .. kind
end

-- True when the mesh for `kind` is in the place.
function Props.has(kind: string): boolean
	return AssetModels.has(keyOf(kind))
end

-- A fresh MeshPart for `kind` (unscaled, unparented), or nil when the model is missing.
local function cloneMesh(kind: string): MeshPart?
	local clone = AssetModels.clone(keyOf(kind))
	if clone == nil then
		return nil
	end
	local found = if clone:IsA("MeshPart") then clone else clone:FindFirstChildWhichIsA("MeshPart", true)
	if found == nil then
		clone:Destroy()
		return nil
	end
	local mesh = found :: MeshPart
	if mesh ~= clone then
		mesh.Parent = nil
		clone:Destroy()
	end
	return mesh
end

-- Authored size (studs) of the mesh for `kind`, or nil when the model is missing.
function Props.size(kind: string): Vector3?
	local mesh = cloneMesh(kind)
	if mesh == nil then
		return nil
	end
	local size = mesh.Size
	mesh:Destroy()
	return size
end

-- Mesh-frame contact point of `kind` (see ANCHOR), in mesh units.
function Props.anchor(kind: string): Vector3
	return ANCHOR[kind] or Vector3.zero
end

-- Stands `mesh` with its bounding-box base centre on `base` (front along base's -Z), scaled
-- uniformly by `scale`: anchored, white (vertex colours), SmoothPlastic, never colliding or queried.
local function dress(mesh: MeshPart, kind: string, base: CFrame, scale: number, parent: Instance?): MeshPart
	local size = mesh.Size * scale
	mesh.Name = kind .. "Mesh"
	mesh.Size = size
	mesh.CFrame = base * CFrame.new(0, size.Y / 2, 0)
	mesh.Anchored = true
	mesh.CanCollide = false
	mesh.CanQuery = false
	mesh.CanTouch = false
	mesh.Color = WHITE
	mesh.Material = Enum.Material.SmoothPlastic
	mesh:SetAttribute("MeshKey", keyOf(kind))
	mesh:AddTag(Props.MESH_TAG)
	mesh.Parent = parent
	return mesh
end

-- The mesh for `kind` standing on `base` (see dress) and parented to `parent`, or nil when the
-- model is missing.
function Props.mesh(kind: string, base: CFrame, scale: number?, parent: Instance?): MeshPart?
	local mesh = cloneMesh(kind)
	if mesh == nil then
		return nil
	end
	return dress(mesh, kind, base, scale or 1, parent)
end

-- Washes `mesh`'s baked vertex colours toward `color` (a part Color would only darken them):
-- an occluded Highlight fill with no outline, `transparency` 0 = solid colour, 1 = none.
function Props.overlay(mesh: MeshPart, color: Color3, transparency: number): Highlight
	local h = Instance.new("Highlight")
	h.Name = "PastelOverlay"
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.FillColor = color
	h.FillTransparency = transparency
	h.OutlineTransparency = 1
	h.Adornee = mesh
	h.Parent = mesh
	return h
end

-- An invisible collider: a box, or an upright cylinder (size = height, diameter, diameter).
function Props.collider(parent: Instance, cframe: CFrame, size: Vector3, cylinder: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = "PropCollider"
	if cylinder then
		p.Shape = Enum.PartType.Cylinder
		cframe *= UPRIGHT
	end
	p.Size = size
	p.CFrame = cframe
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- Lowest and highest point of `part` along the up axis of `frame` (balls and cylinders by
-- their round shape, everything else by its box).
local function verticalSpan(frame: CFrame, part: BasePart): (number, number)
	local cf = frame:ToObjectSpace(part.CFrame)
	local up = cf:VectorToObjectSpace(Vector3.yAxis)
	local half = part.Size / 2
	local shape = if part:IsA("Part") then (part :: Part).Shape else nil
	local reach
	if shape == Enum.PartType.Ball then
		reach = half.X
	elseif shape == Enum.PartType.Cylinder then
		local radius = math.min(half.Y, half.Z)
		reach = math.abs(up.X) * half.X + math.sqrt(math.max(0, 1 - up.X * up.X)) * radius
	else
		reach = math.abs(up.X) * half.X + math.abs(up.Y) * half.Y + math.abs(up.Z) * half.Z
	end
	return cf.Position.Y - reach, cf.Position.Y + reach
end

-- Swaps one Prop_<Kind> model; returns true when its mesh went in.
local function applyModel(model: Model): boolean
	local kind = model:GetAttribute("Mesh")
	if type(kind) ~= "string" or model:GetAttribute("MeshApplied") or not Props.has(kind) then
		return false
	end
	local root = model.PrimaryPart or model:FindFirstChild("PropRoot")
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local frame = root.CFrame

	-- The part-built version: its parts, its height and whether it blocked the player.
	local fallback: { BasePart } = {}
	local bottom, top = math.huge, -math.huge
	local solid = false
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root and d:GetAttribute("MeshKeep") ~= true then
			table.insert(fallback, d)
			if d.Transparency < 1 then
				local low, high = verticalSpan(frame, d)
				bottom = math.min(bottom, low)
				top = math.max(top, high)
			end
			solid = solid or d.CanCollide
		end
	end

	local mesh = cloneMesh(kind)
	if mesh == nil then
		return false
	end
	local scale = model:GetAttribute("MeshScale")
	if type(scale) ~= "number" then
		scale = if top > bottom then (top - bottom) / mesh.Size.Y else 1
	end
	local s = math.clamp(scale :: number, 0.2, 5)
	local base = frame * CFrame.new(-Props.anchor(kind) * s)
	dress(mesh, kind, base, s, model)
	for _, p in fallback do
		p:Destroy()
	end
	if solid then
		local list = COLLIDERS[kind]
		if list then
			for _, c in list do
				Props.collider(model, base * CFrame.new(c.center * s), c.size * s, c.cylinder)
			end
		else
			local size = mesh.Size
			Props.collider(model, base * CFrame.new(0, size.Y / 2, 0), size)
		end
	end
	model:SetAttribute("MeshApplied", true)
	return true
end

-- Swaps every Prop_<Kind> model under `root` that has an uploaded mesh; returns how many.
function Props.apply(root: Instance): number
	local count = 0
	for _, d in root:GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("Mesh") ~= nil and applyModel(d) then
			count += 1
		end
	end
	return count
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="209">
          <Properties>
            <string name="Name">Shell</string>
            <string name="Source"><![CDATA[--[[
	Shell: a plot's ground, boundary and entrance, plus the cream sign cards its boards use.
	The orb pen is built by World.Pen. Part of the world generator; see Server.WorldBuilder for
	the overview and plot axes.

	- Ground: a warm honey-sand floor with teal rubber mats under the work areas (the cream
	  path from the entrance to the pen is built by World.Decor).
	- Boundary: low fences of cream panels on teal kick rails and posts under sunny caps, with
	  chunky teal corner posts. Behind the unit display stands a low stage wall in the calm
	  Backdrop teal between two teal towers; the rack above it stands free against the sky.
	  Neighbouring plots stay in view.
	- Entrance: a teal arch with a sunny beam and awning carrying the owner card.

	Sign cards (`card`, `standingCard`) share Common.SIGN: a cream card with a thin teal border on
	a teal edge, a red-orange header band with a white title, and Ink body text. They fade out
	beyond Common.SIGN_FADE_CARD studs.

	Everything above knee height is decorative and camera-safe (no collision, CanQuery = false),
	so the camera never pops in against it. Only the low fence panels and the floor collide.
]]

local Layout = require(script.Parent.Parent.PlotLayout)
local Common = require(script.Parent.Common)

type Builder = Common.Builder
type Rect = Common.Rect

local theme = Common.theme
local World = theme.World
local SIGN = Common.SIGN
local PLOT_HALF = Common.PLOT_HALF
local UPRIGHT = Common.UPRIGHT
local ALONG_Z = Common.ALONG_Z

local Shell = {}

-- Centre line of the fences, between the inner faces (Layout.INNER_HALF) and the plot edge.
local FENCE_LINE = PLOT_HALF - 0.8
-- Target length of one fence panel between posts.
local FENCE_SEGMENT = 10
-- Arch pillars stand either side of the walkway at this |x|.
local ARCH_X = 8.2

-- Decorative part: never collides and never pulls the camera in (Poppercam ignores
-- CanQuery = false parts).
local function soft(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

-- Sign cards ------------------------------------------------------------------------

local CARD_PPS = 32

-- A sign label: heavy Ink text, scaled to fit, unstroked. `Outline = true` adds an Ink outline
-- for the few labels whose colour Server.Tycoon sets live (rarity, cash green, white), so they
-- stay readable on the cream card.
local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = theme.Fonts.UI
	l.TextColor3 = SIGN.Text
	l.Size = UDim2.fromScale(1, 0.3)
	for key, value in props do
		if key ~= "Outline" then
			(l :: any)[key] = value
		end
	end
	if props.Outline then
		local s = Instance.new("UIStroke")
		s.Color = World.Ink
		s.Thickness = 2.5
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		s.Parent = l
	end
	l.Parent = parent
	return l
end

local function corner(parent: Instance, px: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px)
	c.Parent = parent
end

-- A sign card at `cframe` (its front, -Z, carries the sign): a teal slab holding a rounded
-- cream card with a thin teal border and a rounded red-orange header band carrying `title` in
-- white. `headerFrac` is the header's share of the height. Returns the card part, the body
-- frame below the header (lay labels out in its scale space) and the header's title label.
local function card(B: Builder, cframe: CFrame, size: Vector2, title: string, headerFrac: number?): (BasePart, Frame, TextLabel)
	local part = soft(B.P({
		Name = "SignCard",
		Size = Vector3.new(size.X, size.Y, 0.4),
		CFrame = cframe,
		Color = SIGN.Border,
	}))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = CARD_PPS
	gui.LightInfluence = 0.5
	gui.MaxDistance = Common.SIGN_FADE_CARD
	gui.Parent = part
	local inset = math.floor(CARD_PPS * 0.25)
	local face = Instance.new("Frame")
	face.Name = "Card"
	face.Position = UDim2.fromOffset(inset, inset)
	face.Size = UDim2.new(1, -inset * 2, 1, -inset * 2)
	face.BackgroundColor3 = SIGN.Card
	face.BorderSizePixel = 0
	face.Parent = gui
	corner(face, math.floor(CARD_PPS * 0.6))
	local border = Instance.new("UIStroke")
	border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	border.Color = SIGN.Border
	border.Thickness = 4
	border.Parent = face
	local frac = headerFrac or 0.24
	local pad = inset
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Position = UDim2.fromOffset(pad, pad)
	header.Size = UDim2.new(1, -pad * 2, frac, -pad)
	header.BackgroundColor3 = SIGN.Header
	header.BorderSizePixel = 0
	header.Parent = face
	corner(header, math.floor(CARD_PPS * 0.45))
	local titleLabel = text(header, {
		Name = "Title",
		Text = title,
		Font = theme.Fonts.Display,
		TextColor3 = SIGN.Title,
		Size = UDim2.fromScale(0.92, 0.78),
		Position = UDim2.fromScale(0.04, 0.12),
	})
	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Position = UDim2.new(0, pad, frac, pad)
	body.Size = UDim2.new(1, -pad * 2, 1 - frac, -pad * 2)
	body.Parent = face
	return part, body, titleLabel
end

-- A freestanding sign card on two teal legs, standing on the floor at (x, z), its face turned
-- by `yaw` (0 faces the entrance, -Z) with its bottom edge at `bottomY`. `feet` adds round
-- sunny feet (leave them off where the legs stand against a machine).
local function standingCard(
	B: Builder,
	x: number,
	z: number,
	yaw: number,
	size: Vector2,
	bottomY: number,
	title: string,
	feet: boolean?
): (Frame, TextLabel)
	local base = B.L(x, 0, z) * CFrame.Angles(0, yaw, 0)
	local centerY = bottomY + size.Y / 2
	local _, body, titleLabel = card(B, base * CFrame.new(0, centerY, 0), size, title)
	for _, dx in { -1, 1 } do
		local lx = dx * (size.X / 2 - 0.8)
		soft(B.P({
			Name = "SignLeg",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(centerY, 0.7, 0.7),
			CFrame = base * CFrame.new(lx, centerY / 2, 0.45) * UPRIGHT,
			Color = World.Teal,
		}))
		if feet ~= false then
			soft(B.P({
				Name = "SignFoot",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.4, 1.5, 1.5),
				CFrame = base * CFrame.new(lx, 0.2, 0.45) * UPRIGHT,
				Color = World.Sunny,
			}))
		end
	end
	return body, titleLabel
end

-- Ground ------------------------------------------------------------------------

-- A flat floor decal (mat, border) whose top surface is at `top`.
local function floorPiece(B: Builder, name: string, r: Rect, top: number, thick: number, color: Color3): BasePart
	local p = soft(B.P({
		Name = name,
		Size = Vector3.new(r.maxX - r.minX, thick, r.maxZ - r.minZ),
		CFrame = B.L((r.minX + r.maxX) / 2, top - thick / 2, (r.minZ + r.maxZ) / 2),
		Color = color,
	}))
	p.CastShadow = false
	return p
end

-- Floor slab and the path-stone border band. The courts, paths and mats painted on it are
-- World.Decor's (each paint layer has its own height above this band).
local function buildFloor(B: Builder)
	B.P({
		Name = "Floor",
		Size = Vector3.new(PLOT_HALF * 2, 1, PLOT_HALF * 2),
		CFrame = B.L(0, -0.5, 0),
		Color = World.Honey,
	})

	-- A light path-stone band along the fences.
	local inner = Layout.INNER_HALF
	local band = 1.6
	floorPiece(B, "FloorBorder", Layout.rect(-PLOT_HALF, PLOT_HALF, inner - band, PLOT_HALF), 0.04, 0.04, World.Path)
	floorPiece(B, "FloorBorder", Layout.rect(-PLOT_HALF, PLOT_HALF, -PLOT_HALF, -inner + band), 0.04, 0.04, World.Path)
	for _, side in { -1, 1 } do
		local x0, x1 = side * (inner - band), side * PLOT_HALF
		floorPiece(B, "FloorBorder", Layout.rect(math.min(x0, x1), math.max(x0, x1), -inner + band, inner - band), 0.04, 0.04, World.Path)
	end
end

-- A teal round post with a sunny ball knob on top.
local function roundPost(B: Builder, name: string, x: number, z: number, height: number, diameter: number)
	soft(B.P({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = B.L(x, height / 2, z) * UPRIGHT,
		Color = World.Teal,
	}))
	local knob = diameter + 0.2
	soft(B.P({
		Name = name .. "Knob",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(knob, knob, knob),
		CFrame = B.L(x, height + knob * 0.3, z),
		Color = World.Sunny,
	}))
end

-- One straight run of fence from (x0, z0) to (x1, z1) along X or Z: a teal kick rail, cream
-- panels (the only colliding parts, 3.1 high) under rounded sunny caps, and small teal round
-- posts between panels.
local function fenceRun(B: Builder, x0: number, z0: number, x1: number, z1: number)
	local alongZ = math.abs(z1 - z0) > math.abs(x1 - x0)
	local length = if alongZ then math.abs(z1 - z0) else math.abs(x1 - x0)
	-- Run-local frame: X runs along the fence.
	local base = B.L((x0 + x1) / 2, 0, (z0 + z1) / 2) * (if alongZ then CFrame.Angles(0, math.pi / 2, 0) else CFrame.identity)
	local segments = math.max(1, math.floor(length / FENCE_SEGMENT + 0.5))
	local seg = length / segments
	soft(B.P({
		Name = "FenceBase",
		Size = Vector3.new(length, 0.5, 1.6),
		CFrame = base * CFrame.new(0, 0.25, 0),
		Color = World.Teal,
	}))
	for i = 0, segments - 1 do
		local cx = -length / 2 + seg * (i + 0.5)
		B.P({
			Name = "FencePanel",
			Size = Vector3.new(seg, 2.6, 1),
			CFrame = base * CFrame.new(cx, 1.8, 0),
			Color = World.Cream,
		})
		soft(B.P({
			Name = "FenceCap",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(seg - 0.6, 1.3, 1.3),
			CFrame = base * CFrame.new(cx, 3.35, 0),
			Color = World.Sunny,
		}))
		if i > 0 then
			local p = base * CFrame.new(-length / 2 + seg * i, 0, 0)
			soft(B.P({
				Name = "FencePost",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(3.8, 1.6, 1.6),
				CFrame = p * CFrame.new(0, 1.9, 0) * UPRIGHT,
				Color = World.Teal,
			}))
			soft(B.P({
				Name = "FenceKnob",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.5, 1.5, 1.5),
				CFrame = p * CFrame.new(0, 4.1, 0),
				Color = World.Sunny,
			}))
		end
	end
end

-- Behind the display rack: a low stage wall in the calm Backdrop teal, about as tall as the
-- first two shelves, under a round cream cap and between two teal towers. The rack above it
-- stands free against the sky, so from outside the plot it reads as an object, not a
-- billboard; its own topper sign names the display. Returns the towers' |x|.
local function buildStage(B: Builder): number
	local L, P = B.L, B.P
	local shelves = Layout.MACHINES.Shelves
	local half = shelves.maxX + 1.8
	local z = Layout.INNER_HALF + 0.1
	local height = math.floor(Layout.rowTop(3))
	-- No shadow: it would fall across the lower shelves.
	local backdrop = soft(P({
		Name = "Backdrop",
		Size = Vector3.new(half * 2, height, 0.6),
		CFrame = L(0, height / 2, z),
		Color = World.Backdrop,
	}))
	backdrop.CastShadow = false
	local cap = 1.6
	soft(P({
		Name = "BackdropCap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(half * 2, cap, cap),
		CFrame = L(0, height + cap * 0.3, z),
		Color = World.Cream,
	})).CastShadow =
		false
	-- Towers either side, a little taller than the wall.
	local towerX = half + 1.8
	for _, side in { -1, 1 } do
		roundPost(B, "StageTower", side * towerX, z + 0.3, height + 3, 3.6)
	end
	-- Invisible low collider closing the back between the towers (the backdrop lets the camera
	-- through).
	local back = P({
		Name = "StageFence",
		Size = Vector3.new(towerX * 2, 3.1, 1),
		CFrame = L(0, 1.55, FENCE_LINE),
		Transparency = 1,
	})
	back.CastShadow = false
	return towerX
end

-- Fences around the plot: the sides, the back either side of the stage, and the front either
-- side of the entrance arch, with chunky teal posts at the corners.
local function buildWalls(B: Builder)
	local towerX = buildStage(B)
	local f = FENCE_LINE
	for _, side in { 1, -1 } do
		fenceRun(B, side * f, -f, side * f, f)
		fenceRun(B, side * towerX, f, side * f, f)
		fenceRun(B, side * ARCH_X, -f, side * f, -f)
		for _, z in { -f, f } do
			roundPost(B, "CornerPost", side * f, z, 5.2, 3.2)
		end
	end
end

-- The entrance arch: teal pillars on teal plinths, a sunny beam and a sunny awning with a
-- scalloped edge, and the owner card on top. Returns the owner label and avatar image that
-- Tycoon updates.
local function buildEntrance(B: Builder, index: number): (TextLabel, ImageLabel)
	local L, P = B.L, B.P
	local z = FENCE_LINE
	local pillarH = 11
	for _, side in { -1, 1 } do
		soft(P({
			Name = "ArchPlinth",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1, 4.4, 4.4),
			CFrame = L(side * ARCH_X, 0.5, -z) * UPRIGHT,
			Color = World.Teal,
		}))
		roundPost(B, "ArchPillar", side * ARCH_X, -z, pillarH, 3.2)
	end
	-- Beam between the pillar tops.
	soft(P({
		Name = "ArchBeam",
		Size = Vector3.new(ARCH_X * 2, 1.4, 1.8),
		CFrame = L(0, pillarH - 0.7, -z),
		Color = World.Sunny,
	}))
	-- Awning sloping down toward the hub, with half-disc scallops along its edge.
	local scallops = 9
	local awningHalf = ARCH_X + 1.7
	local w = awningHalf * 2 / scallops
	local backZ, backY = -z - 0.9, pillarH + 0.4
	local frontZ, frontY = -z - 4.2, pillarH - 1.2
	local dy, dz = backY - frontY, backZ - frontZ
	local length = math.sqrt(dy * dy + dz * dz)
	local tilt = CFrame.Angles(-math.atan2(dy, dz), 0, 0)
	soft(P({
		Name = "Awning",
		Size = Vector3.new(awningHalf * 2, 0.3, length),
		CFrame = L(0, (backY + frontY) / 2, (backZ + frontZ) / 2) * tilt,
		Color = World.Sunny,
	}))
	for i = 1, scallops do
		soft(P({
			Name = "AwningScallop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, w, w),
			CFrame = L(-awningHalf + w * (i - 0.5), frontY, frontZ) * ALONG_Z,
			Color = World.Sunny,
		}))
	end

	-- Owner card above the awning: "PLOT n" header, avatar on the left, owner name on the right.
	local size = Vector2.new(12, 4.8)
	local ownerCard, body = card(B, L(0, pillarH + 0.2 + size.Y / 2, -z), size, "PLOT " .. index, 0.3)
	local ownerImage = Instance.new("ImageLabel")
	ownerImage.Name = "OwnerImage"
	ownerImage.BackgroundTransparency = 1
	ownerImage.Size = UDim2.fromScale(0.24, 0.94)
	ownerImage.Position = UDim2.fromScale(0.01, 0.03)
	ownerImage.ScaleType = Enum.ScaleType.Fit
	ownerImage.Image = ""
	ownerImage.Parent = body
	local ownerLabel = text(body, {
		Name = "Owner",
		Text = "FREE PLOT",
		Font = theme.Fonts.Display,
		Size = UDim2.fromScale(0.72, 0.8),
		Position = UDim2.fromScale(0.27, 0.1),
	})
	-- The card's teal back (seen from inside the plot) shows the plot number in white.
	local backGui = Instance.new("SurfaceGui")
	backGui.Face = Enum.NormalId.Back
	backGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	backGui.PixelsPerStud = 24
	backGui.LightInfluence = 0.5
	backGui.MaxDistance = Common.SIGN_FADE_CARD
	backGui.Parent = ownerCard
	text(backGui, {
		Text = "PLOT " .. index,
		Font = theme.Fonts.Display,
		TextColor3 = World.White,
		Size = UDim2.fromScale(0.8, 0.6),
		Position = UDim2.fromScale(0.1, 0.2),
	})
	return ownerLabel, ownerImage
end

Shell.soft = soft
Shell.text = text
Shell.card = card
Shell.standingCard = standingCard
Shell.buildFloor = buildFloor
Shell.buildWalls = buildWalls
Shell.buildEntrance = buildEntrance

return Shell
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="210">
          <Properties>
            <string name="Name">Shelves</string>
            <string name="Source"><![CDATA[--[[
	Shelves: the Chads' display rack on the back ledge, one model per unit (Layout.SHELF,
	Layout.shelfSlots). Up to ten shelves stack upward, each a little behind the one below:
	a cream board with a round white rim and a front band alternating sunny and butter, a pale
	sky back panel (World.RackBack) every Chad reads against as a clear silhouette, skinned on
	its rear with teal so the unit seen from behind is a tidy stepped teal panel trimmed by the
	cream board edges, chunky teal side posts with white knobs at every step and a little
	numbered cream tag on the left post. The rim and band are the shelf lip
	the client's name plates hang from (Fx.Plates), so nothing else is built there. Slot 1, at
	the front shelf's centre, is a raised champion pedestal with gold rims and a gold star
	plaque whose ring and top disc follow the best unit's tier colour. A sunny roof board
	tops the highest shelf and holds the small "YOUR CHADS" marquee (cream card, red-orange
	header) on two posts, high enough to stay out of the pen view.
	Two soft warm lights (one wash over the lower shelves, one spot on the champion) keep the
	units the best-lit thing on the plot.

	Shelves appear as the owner's units need them (Shelves.setRows, called by Tycoon):
	  * Shelf 1 is always built into the plot folder.
	  * Shelves 2..10 are Models named "RackRow" with attribute Row = n. A shown shelf is
	    parented to the plot folder; a hidden one is parented to nil (kept here), so clients
	    see a revealed shelf arrive with ChildAdded and can animate it in.
	  * The roof + sign is the Model "RackTopper"; the server pivots it onto the highest shown
	    shelf.
	  * The plot folder's attribute "Rows" is the number of shelves shown (1 for an empty plot).
	Part of the world generator; see Server.WorldBuilder for the overview and plot axes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Layout = require(script.Parent.Parent.PlotLayout)
local Common = require(script.Parent.Common)

type Builder = Common.Builder

local theme = Common.theme
local UPRIGHT = Common.UPRIGHT
local WHITE = Common.WHITE
local SHELF_LIGHT = Common.SHELF_LIGHT
local tierBandColor = Common.tierBandColor

local Shelves = {}

local function worldColor(key: string, fallback: Color3): Color3
	local palette = theme.World
	return if palette and palette[key] then palette[key] else fallback
end

local INK = worldColor("Ink", Color3.fromRGB(58, 48, 96))
local SIGN = Common.SIGN

-- Front band colours, alternating shelf by shelf from the bottom up.
local BAND_KEYS = { "Sunny", "Butter" }

-- Back panels stand this thick behind each shelf board: a pale face (BACK_FACE thick) in
-- front of a teal rear skin.
local BACK_THICK = 0.4
local BACK_FACE = 0.25
-- Diameter of the white knobs on the side posts.
local KNOB = 1.9

-- Purely decorative: never blocks the player or pulls the camera in.
local function decorative(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = theme.Fonts.Display or theme.Fonts.Title
	l.TextColor3 = INK
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

-- The thin teal border round a sign card.
local function border(frame: Frame)
	local stroke = Instance.new("UIStroke")
	stroke.Color = SIGN.Border
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
end

-- A SurfaceGui on the part's front (-Z) face.
local function surface(p: BasePart): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.3
	gui.Parent = p
	return gui
end

-- The raised "best unit" pedestal at slot 1: a gold-rimmed cream drum with a tier-coloured band
-- and top disc, a gold star plaque on its front and a soft warm spotlight. It stays within the
-- front shelf's depth so it never overhangs the gutter. Returns the parts that follow the best
-- tier's colour.
local function buildChampionPedestal(B: Builder, x: number, deckTop: number, z: number, standY: number): { Instance }
	local L, P = B.L, B.P
	local tinted: { Instance } = {}
	local start = B.c.Primary
	local gold = worldColor("Sunny", start)
	local footH, rimH = 0.25, 0.3
	local bodyR = 1.5
	P({
		Name = "ChampionFoot",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(footH, 3.6, 3.6),
		CFrame = L(x, deckTop + footH / 2, z) * UPRIGHT,
		Color = gold,
	})
	local bodyBottom, bodyTop = deckTop + footH, standY - rimH
	P({
		Name = "ChampionPedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(bodyTop - bodyBottom, bodyR * 2, bodyR * 2),
		CFrame = L(x, (bodyBottom + bodyTop) / 2, z) * UPRIGHT,
		Color = worldColor("Cream", WHITE),
	})
	P({
		Name = "ChampionTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(rimH, 3.4, 3.4),
		CFrame = L(x, standY - rimH / 2, z) * UPRIGHT,
		Color = gold,
	})
	local ring = decorative(P({
		Name = "ChampionRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.22, bodyR * 2 + 0.16, bodyR * 2 + 0.16),
		CFrame = L(x, bodyBottom + 0.18, z) * UPRIGHT,
		Color = start,
	}))
	table.insert(tinted, ring)
	local disc = decorative(P({
		Name = "ChampionDisc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.06, 2.7, 2.7),
		CFrame = L(x, standY - 0.02, z) * UPRIGHT,
		Color = start,
	}))
	disc.CastShadow = false
	table.insert(tinted, disc)

	-- Gold star plaque on the drum's front (-Z) face.
	local plaqueW, plaqueH = 1.3, (bodyTop - bodyBottom) - 0.3
	local plaque = decorative(P({
		Name = "ChampionPlaque",
		Size = Vector3.new(plaqueW, plaqueH, 0.4),
		CFrame = L(x, (bodyBottom + bodyTop) / 2 + 0.08, z - bodyR + 0.06),
		Color = gold,
	}))
	text(surface(plaque), {
		Text = "★",
		Size = UDim2.fromScale(1, 1),
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBlack,
	})

	-- Soft warm spot in front of and above the pedestal, aimed down and back at it.
	local rig = decorative(P({
		Name = "ChampionSpot",
		Size = Vector3.new(1, 0.2, 1),
		CFrame = L(x, standY + 12, z - 6) * CFrame.Angles(math.rad(-26), 0, 0),
		Transparency = 1,
	}))
	rig.CastShadow = false
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Angle = 38
	spot.Range = 20
	spot.Brightness = 1.4
	spot.Color = SHELF_LIGHT
	spot.Shadows = false
	spot.Parent = rig
	return tinted
end

-- Recolours the champion pedestal's ring and disc to the highest tier standing on the shelf.
local function watchChampion(unitFolder: Folder, tinted: { Instance })
	local current: Color3? = nil
	local function refresh()
		local best = 0
		for _, child in unitFolder:GetChildren() do
			local tier = child:GetAttribute("Tier")
			if type(tier) == "number" and tier > best then
				best = tier
			end
		end
		local color = if best > 0 then tierBandColor(best) else theme.Colors.Primary
		if current == color then
			return
		end
		current = color
		for _, inst in tinted do
			(inst :: any).Color = color
		end
	end
	refresh()
	-- pcall: the offline preview (Lune) has no instance signals.
	pcall(function()
		unitFolder.ChildAdded:Connect(function(child)
			refresh()
			child:GetAttributeChangedSignal("Tier"):Connect(refresh)
		end)
		unitFolder.ChildRemoved:Connect(refresh)
	end)
end

-- A dumbbell drawn in UI frames, filling `parent` (a square frame): a teal bar with a coral
-- and a sunny plate at each end.
local function dumbbellIcon(parent: GuiObject)
	local function piece(color: Color3, x: number, w: number, h: number)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(x, 0.5)
		f.Size = UDim2.fromScale(w, h)
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.Parent = parent
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.35, 0)
		corner.Parent = f
	end
	piece(worldColor("Teal", WHITE), 0.5, 0.7, 0.1)
	for _, side in { -1, 1 } do
		piece(worldColor("Coral", WHITE), 0.5 + side * 0.24, 0.12, 0.52)
		piece(worldColor("Sunny", WHITE), 0.5 + side * 0.35, 0.09, 0.36)
	end
end

-- The gym emblem on the back of the rack sign, crowning the rack seen from behind the plot:
-- a cream card with a sunny border, a dumbbell between two coral stars and the gym's name.
local function signBack(board: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "RackEmblem"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 1
	gui.Parent = board
	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromScale(0.96, 0.9)
	card.BackgroundColor3 = worldColor("Cream", WHITE)
	card.BorderSizePixel = 0
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.25, 0)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = worldColor("Sunny", WHITE)
	stroke.Thickness = 8
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = card
	local icon = Instance.new("Frame")
	icon.BackgroundTransparency = 1
	icon.AnchorPoint = Vector2.new(0.5, 0)
	icon.Position = UDim2.fromScale(0.5, 0.04)
	icon.Size = UDim2.fromScale(0.58, 0.58)
	icon.SizeConstraint = Enum.SizeConstraint.RelativeYY
	icon.Parent = card
	dumbbellIcon(icon)
	for _, x in { 0.3, 0.7 } do
		text(card, {
			Text = "★",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(x, 0.08),
			Size = UDim2.fromScale(0.5, 0.5),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			TextColor3 = worldColor("Coral", WHITE),
		})
	end
	text(card, {
		Text = string.upper(theme.Words.Unit) .. " GYM",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromScale(0.8, 0.32),
		TextColor3 = INK,
	})
end

-- The rack sign in the shared sign style (Common.SIGN): a cream card with a teal border and a
-- red-orange header band, framed by a teal board on two teal posts, standing on the roof at
-- plot-local (0, base, z). It is a small marquee held SIGN_CLEAR above the roof: from the pen
-- (default camera, 15 studs behind the character and looking 20 degrees down) a sign sitting
-- on the roof filled the top-centre of the screen, right behind the HUD's rows; this high it is
-- past the top edge there, and from the walkway it is a small plate above the rack.
local SIGN_W, SIGN_H = 16, 3.4
local SIGN_CLEAR = 6.4
local function buildSign(B: Builder, parent: Instance, z: number, base: number)
	local L, P = B.L, B.P
	local w, h = SIGN_W, SIGN_H
	local cy = base + SIGN_CLEAR + (h + 0.5) / 2
	for _, side in { -1, 1 } do
		decorative(P({
			Name = "SignPost",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(cy - base, 0.8, 0.8),
			CFrame = L(side * (w / 2 - 1.5), (base + cy) / 2, z + 0.5) * UPRIGHT,
			Color = SIGN.Border,
			Parent = parent,
		}))
	end
	-- Rounded teal frame: a slab with round ends.
	local board = decorative(P({
		Name = "Board",
		Size = Vector3.new(w - h, h + 0.5, 0.4),
		CFrame = L(0, cy, z + 0.2),
		Color = SIGN.Border,
		Parent = parent,
	}))
	signBack(board)
	for _, side in { -1, 1 } do
		decorative(P({
			Name = "Board",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, h + 0.5, h + 0.5),
			CFrame = L(side * (w - h) / 2, cy, z + 0.2) * CFrame.Angles(0, math.pi / 2, 0),
			Color = SIGN.Border,
			Parent = parent,
		}))
	end
	local card = decorative(P({
		Name = "Screen",
		Size = Vector3.new(w - 0.6, h - 0.3, 0.2),
		CFrame = L(0, cy, z),
		Color = SIGN.Card,
		Parent = parent,
	}))
	local gui = surface(card)
	gui.MaxDistance = Common.SIGN_FADE_CARD
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = SIGN.Card
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.2, 0)
	corner.Parent = frame
	border(frame)
	local band = Instance.new("Frame")
	band.Size = UDim2.fromScale(1, 0.58)
	band.BackgroundColor3 = SIGN.Header
	band.BorderSizePixel = 0
	band.Parent = frame
	local bandCorner = Instance.new("UICorner")
	bandCorner.CornerRadius = UDim.new(0.3, 0)
	bandCorner.Parent = band
	text(band, {
		Text = "YOUR " .. string.upper(theme.Words.Units) .. "  ★",
		Size = UDim2.fromScale(0.9, 0.78),
		Position = UDim2.fromScale(0.05, 0.12),
		TextColor3 = SIGN.Title,
	})
	text(frame, {
		Text = "Every " .. theme.Words.Unit .. " drops " .. theme.Words.Orb .. " into the pen",
		Font = theme.Fonts.UI or theme.Fonts.Bold or theme.Fonts.Body,
		Size = UDim2.fromScale(0.86, 0.3),
		Position = UDim2.fromScale(0.07, 0.64),
		TextColor3 = SIGN.Text,
	})
end

-- The shelf's number on a small round cream card with a teal border on the front of the +X
-- (left) post.
local function rowTag(B: Builder, parent: Instance, row: number, y: number, z: number)
	local s = Layout.SHELF
	local tag = decorative(B.P({
		Name = "RackTag",
		Size = Vector3.new(1.3, 1.3, 0.1),
		CFrame = B.L(s.width / 2 + s.postWidth / 2, y, z - 0.06),
		Transparency = 1,
		Parent = parent,
	}))
	tag.CastShadow = false
	local gui = surface(tag)
	gui.MaxDistance = Common.SIGN_FADE_TAG
	local card = Instance.new("Frame")
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = SIGN.Card
	card.BorderSizePixel = 0
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = card
	border(card)
	text(card, {
		Text = tostring(row),
		Size = UDim2.fromScale(0.7, 0.7),
		Position = UDim2.fromScale(0.15, 0.15),
		TextColor3 = SIGN.Text,
	})
end

-- Paint on a shelf's teal rear skin (seen from behind the plot): two cream trim bands across
-- the panel, a cream medallion in the middle (a dumbbell on odd shelves, a coral star on even
-- ones) and two small cream stars on the bands, so the stepped back of the rack reads as a
-- friendly gym banner rather than a blank slab. Drawn in a SurfaceGui: no extra parts.
local function rearArt(rear: BasePart, row: number)
	local cream = worldColor("Cream", WHITE)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "RackRearArt"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 16
	-- Lit like the paint around it, never glowing.
	gui.LightInfluence = 1
	gui.Parent = rear
	for _, y in { 0.16, 0.84 } do
		local band = Instance.new("Frame")
		band.Name = "Trim"
		band.AnchorPoint = Vector2.new(0.5, 0.5)
		band.Position = UDim2.fromScale(0.5, y)
		band.Size = UDim2.fromScale(0.96, 0.07)
		band.BackgroundColor3 = cream
		band.BorderSizePixel = 0
		band.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = band
	end
	for _, x in { 0.25, 0.75 } do
		text(gui, {
			Text = "★",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, 0.5),
			Size = UDim2.fromScale(0.5, 0.5),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			TextColor3 = cream,
		})
	end
	local medal = Instance.new("Frame")
	medal.Name = "Emblem"
	medal.AnchorPoint = Vector2.new(0.5, 0.5)
	medal.Position = UDim2.fromScale(0.5, 0.5)
	medal.Size = UDim2.fromScale(0.86, 0.86)
	medal.SizeConstraint = Enum.SizeConstraint.RelativeYY
	medal.BackgroundColor3 = cream
	medal.BorderSizePixel = 0
	medal.Parent = gui
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.5, 0)
	round.Parent = medal
	local ring = Instance.new("UIStroke")
	ring.Color = worldColor("Sunny", WHITE)
	ring.Thickness = 6
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = medal
	if row % 2 == 1 then
		dumbbellIcon(medal)
	else
		text(medal, {
			Text = "★",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.52),
			Size = UDim2.fromScale(0.78, 0.78),
			TextColor3 = worldColor("Coral", WHITE),
		})
	end
end

-- One shelf of the rack: board, rim, front band, back panel (pale face, teal rear skin), the
-- two post segments that carry it (up to the next shelf's board) and its number tag; shelves
-- above the first also get the post knobs where the posts step back. Shelf 1's board and
-- posts are solid (the ledge); everything above is decorative so players never climb the rack.
local function buildRow(B: Builder, parent: Instance, row: number)
	local L, P = B.L, B.P
	local s = Layout.SHELF
	local top = Layout.rowTop(row)
	local nextBottom = Layout.rowTop(row + 1) - s.boardThick
	local front = Layout.rowFrontZ(row)
	local back = front + s.depth
	local solid = row == 1
	local function part(props: { [string]: any }): BasePart
		props.Parent = parent
		local p = P(props)
		return if solid then p else decorative(p)
	end

	part({
		Name = "ShelfBoard",
		Size = Vector3.new(s.width, s.boardThick, s.depth),
		CFrame = L(0, top - s.boardThick / 2, front + s.depth / 2),
		Color = worldColor("Cream", WHITE),
	})
	decorative(P({
		Name = "ShelfBand",
		Size = Vector3.new(s.width, s.boardThick + 0.04, 0.16),
		CFrame = L(0, top - s.boardThick / 2, front - 0.08),
		Color = worldColor(BAND_KEYS[(row - 1) % #BAND_KEYS + 1], B.c.Primary),
		Parent = parent,
	}))
	decorative(P({
		Name = "ShelfRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(s.width, 0.36, 0.36),
		CFrame = L(0, top - 0.06, front - s.frontReach + 0.18),
		Color = WHITE,
		Parent = parent,
	})).CastShadow =
		false
	-- Matte, so the sun and the display wash never put a white hot spot behind the units.
	part({
		Name = "ShelfBack",
		Size = Vector3.new(s.width, nextBottom - top, BACK_FACE),
		CFrame = L(0, (top + nextBottom) / 2, back + BACK_FACE / 2),
		Color = worldColor("RackBack", WHITE),
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0,
	})
	local rearThick = BACK_THICK - BACK_FACE
	local rear = part({
		Name = "ShelfBackRear",
		Size = Vector3.new(s.width, nextBottom - top, rearThick),
		CFrame = L(0, (top + nextBottom) / 2, back + BACK_FACE + rearThick / 2),
		Color = worldColor("Teal", B.c.WallTrim),
	})
	rearArt(rear, row)

	local postBottom = if row == 1 then 0 else top - s.boardThick
	local postDepth = s.depth + BACK_THICK
	for _, side in { -1, 1 } do
		local x = side * (s.width / 2 + s.postWidth / 2)
		part({
			Name = "RackPost",
			Size = Vector3.new(s.postWidth, nextBottom - postBottom, postDepth),
			CFrame = L(x, (postBottom + nextBottom) / 2, front + postDepth / 2),
			Color = worldColor("Teal", B.c.WallTrim),
		})
		if row > 1 then
			-- A knob on the step where this post segment sits back from the one below.
			decorative(P({
				Name = "RackKnob",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(KNOB, KNOB, KNOB),
				CFrame = L(x, postBottom, front - s.stepBack / 2),
				Color = WHITE,
				Parent = parent,
			}))
		end
	end
	rowTag(B, parent, row, (top + nextBottom) / 2, front)
end

-- The sunny roof board over the top shelf with its sign, built over shelf 1 (setRows
-- moves it up). Returns the model; its PrimaryPart is the roof board.
local function buildTopper(B: Builder): Model
	local L, P = B.L, B.P
	local s = Layout.SHELF
	local model = Instance.new("Model")
	model.Name = "RackTopper"
	local roofTop = Layout.rowTop(2)
	local front = Layout.rowFrontZ(1)
	local roofW = s.width + s.postWidth * 2 + 0.6
	local roofD = s.depth + BACK_THICK + 0.6
	local roof = decorative(P({
		Name = "RackRoof",
		Size = Vector3.new(roofW, s.boardThick, roofD),
		CFrame = L(0, roofTop - s.boardThick / 2, front - 0.3 + roofD / 2),
		Color = worldColor("Sunny", B.c.Primary),
		Parent = model,
	}))
	decorative(P({
		Name = "RackRoofBand",
		Size = Vector3.new(roofW, s.boardThick + 0.04, 0.16),
		CFrame = L(0, roofTop - s.boardThick / 2, front - 0.38),
		Color = worldColor("Sunny", B.c.Primary),
		Parent = model,
	}))
	local knobY = roofTop + KNOB / 2 - 0.2
	local knobX = s.width / 2 + s.postWidth / 2
	for _, side in { -1, 1 } do
		decorative(P({
			Name = "RackKnob",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(KNOB, KNOB, KNOB),
			CFrame = L(side * knobX, knobY, front + 0.6),
			Color = WHITE,
			Parent = model,
		}))
	end
	local signZ = front + s.depth - 1
	buildSign(B, model, signZ, roofTop)
	model.PrimaryPart = roof
	return model
end

type Rack = {
	folder: Instance,
	rows: { Model },
	topper: Model,
	topperBase: CFrame,
	cframe: CFrame,
	shown: number,
}

-- Racks by plot folder (plots live for the whole server, so this never needs cleaning).
local racks: { [Instance]: Rack } = {}

-- Shows shelves 1..rows of the rack in `folder` (a plot folder) and moves the roof onto the
-- highest one; see the header for the contract. Safe to call every refresh.
local function setRows(folder: Instance, rows: number)
	local rack = racks[folder]
	if not rack then
		return
	end
	local shown = math.clamp(math.floor(rows), 1, Layout.SHELF.rows)
	if rack.shown == shown then
		return
	end
	rack.shown = shown
	for _, model in rack.rows do
		local row = model:GetAttribute("Row") :: number
		local parent: Instance? = if row <= shown then folder else nil
		if model.Parent ~= parent then
			model.Parent = parent
		end
	end
	local lift = Layout.rowTop(shown + 1) - Layout.rowTop(2)
	local back = Layout.rowFrontZ(shown) - Layout.rowFrontZ(1)
	rack.topper:PivotTo(rack.topperBase + rack.cframe:VectorToWorldSpace(Vector3.new(0, lift, back)))
	folder:SetAttribute("Rows", shown)
end

-- Builds the rack (see the header). Returns the slots in fill order (bottom shelf first,
-- centre-out) so the best units are the most visible, plus the champion pedestal's tinted
-- parts. Only shelf 1 is shown until Shelves.setRows asks for more.
local function buildShelves(B: Builder): ({ CFrame }, { Instance })
	local L, P = B.L, B.P
	local s = Layout.SHELF

	-- Solid plinth under the front shelf (the ledge face behind the gutter).
	P({
		Name = "Shelf",
		Size = Vector3.new(s.width, Layout.rowTop(1) - s.boardThick, s.depth + BACK_THICK),
		CFrame = L(0, (Layout.rowTop(1) - s.boardThick) / 2, Layout.rowFrontZ(1) + (s.depth + BACK_THICK) / 2),
		Color = worldColor("Teal", B.c.WallTrim),
	})
	buildRow(B, B.folder, 1)
	local rowModels: { Model } = {}
	for row = 2, s.rows do
		local model = Instance.new("Model")
		model.Name = "RackRow"
		model:SetAttribute("Row", row)
		buildRow(B, model, row)
		model.Parent = B.folder
		table.insert(rowModels, model)
	end

	-- Slots, in fill order (slot 1 = front-centre champion pedestal).
	local slots: { CFrame } = {}
	local champion: { Instance } = {}
	for _, slot in Layout.shelfSlots() do
		if slot.best then
			champion = buildChampionPedestal(B, slot.x, Layout.rowTop(1), slot.z, slot.y)
		end
		table.insert(slots, L(slot.x, slot.y, slot.z))
	end
	assert(#slots == Economy.DISPLAY_SLOTS, "display slot count mismatch")

	-- Display lighting: one soft warm wash from an invisible bar above and in front of the
	-- rack, angled down and back over the lower shelves.
	local bar = decorative(P({
		Name = "ShelfLightBar",
		Size = Vector3.new(s.width - 8, 0.3, 1),
		CFrame = L(0, Layout.rowTop(2) + 6, s.frontZ - 9) * CFrame.Angles(math.rad(-38), 0, 0),
		Transparency = 1,
	}))
	bar.CastShadow = false
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 85
	light.Range = 28
	light.Brightness = 1.6
	light.Color = SHELF_LIGHT
	light.Shadows = false
	light.Parent = bar

	local topper = buildTopper(B)
	topper.Parent = B.folder
	racks[B.folder] = {
		folder = B.folder,
		rows = rowModels,
		topper = topper,
		topperBase = topper:GetPivot(),
		cframe = B.cf,
		shown = s.rows,
	}
	setRows(B.folder, 1)

	return slots, champion
end

Shelves.watchChampion = watchChampion
Shelves.buildShelves = buildShelves
Shelves.setRows = setRows

return Shelves
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--[[
	WorldBuilder: generates the whole map from parts when the server starts.

	Six plots sit around a central hub plaza with a ranking tower. Every plot
	uses the plot-local geometry in PlotLayout (see the diagram there): a stepped
	display ledge at the back, a gutter and chute feeding a walled orb pen right in
	front of it, buy pads either side of the pen and the stations on a painted court down each
	side, every machine right behind its own pad(s).
	World.Shell builds the ground, the low fences, the low stage wall behind the rack and the
	entrance arch; the boards are freestanding cream sign cards (Shell.standingCard) with one
	main line each. Labels Server.Tycoon still writes but the cards no longer show are kept
	hidden (hiddenLabel).

	Plot-local axes: Z = toward the back fence, Y = up, and +X is on the left of
	a player walking in from the hub (Roblox is right-handed).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Layout = require(script.Parent.PlotLayout)

local World = script.Parent.World
local Common = require(World.Common)
local Hub = require(World.Hub)
local Shell = require(World.Shell)
local Shelves = require(World.Shelves)
local Machines = require(World.Machines)
local Decor = require(World.Decor)
local Pads = require(World.Pads)
local Pen = require(World.Pen)
local Props = require(World.Props)
local Modes = require(World.Modes)
local MogStage = require(World.MogStage)
local CardioTrack = require(World.CardioTrack)

local WorldBuilder = {}

export type Rect = Common.Rect
export type Pad = Common.Pad
type Builder = Common.Builder

export type Plot = {
	index: number,
	cframe: CFrame,
	folder: Folder,
	unitFolder: Folder,
	orbFolder: Folder,
	chestFolder: Folder,
	spawn: CFrame,
	slots: { CFrame },
	-- Plot-local rectangle on the pen floor where dropped orbs land.
	orbArea: Rect,
	-- Plot-local Y of the pen floor's walkable surface (orbs rest on it).
	orbFloorY: number,
	-- Plot-local footprint of the orb pen, walls included.
	pool: Rect,
	-- Plot-local rectangles (front half of the pen) where dropped crates land.
	chestAreas: { Rect },
	pads: { Pad },
	padByName: { [string]: Pad },
	labels: { [string]: TextLabel },
	ownerImage: ImageLabel,
	unlockerScreens: { { frame: Frame, title: TextLabel, status: TextLabel, timer: TextLabel } },
}

export type World = {
	plots: { Plot },
	ranking: { TextLabel },
	-- The GAME MODES plaza and Parkour course (World.Modes).
	modes: Modes.Built,
	-- The MOG TEST stage out at sea (World.MogStage).
	mog: MogStage.Built,
	-- The CARDIO keyboard runway out at sea (World.CardioTrack).
	cardio: CardioTrack.Built,
}

local theme = Common.theme
local Paint = theme.World
local mapFolder = Common.mapFolder
local make = Common.make
local plotCFrame = Common.plotCFrame
local soft = Shell.soft
local text = Shell.text
local standingCard = Shell.standingCard
local buildFloor = Shell.buildFloor
local buildWalls = Shell.buildWalls
local buildEntrance = Shell.buildEntrance
local watchChampion = Shelves.watchChampion
local buildShelves = Shelves.buildShelves
local buildConverter = Machines.buildConverter
local buildProcessor = Machines.buildProcessor
local buildVault = Machines.buildVault
local buildUnlocker = Machines.buildUnlocker
local buildGymDecor = Decor.buildGymDecor
local buildPad = Pads.buildPad
local setPadClaimed = Pads.setClaimed

local PLOT_COUNT = Common.PLOT_COUNT

-- Purely decorative parts (rails, trim, posts, signs, lights) that must never block the player
-- or pull the camera in: Roblox's Poppercam ignores CanQuery = false parts. Shell marks its own
-- decor this way as it builds it; this list covers the other world modules. Floors, the low
-- fence panels, pen walls/stairs, the gutter and chute, and pad tops/bases stay solid.
local CAMERA_SAFE = {
	PenLip = true,
	ShelfLightBar = true,
	ChampionSpot = true,
	ChampionRing = true,
	ChampionDisc = true,
	Board = true,
	Screen = true,
}

local function makeCameraSafe(root: Instance)
	for _, inst in root:GetDescendants() do
		if inst:IsA("BasePart") and CAMERA_SAFE[inst.Name] then
			inst.CanCollide = false
			inst.CanQuery = false
			inst.CanTouch = false
		end
	end
end

-- Faces for freestanding sign cards (yaw 0 faces the entrance, -Z).
local FACE_MINUS_X = math.pi / 2
local FACE_PLUS_X = -math.pi / 2
-- Bottom edge of the processor's board: above the smoothie cups riding its belt.
local BOARD_BOTTOM = 7.2
-- Bottom edge of the cards at the +X stations (crate crackers, free gift): above the crate
-- plinth and the gift box in front of them.
local STATION_SIGN_BOTTOM = 4

-- The owner card's text on a plot nobody owns.
local FREE_PLOT = "FREE PLOT"

-- A label Server.Tycoon still writes to that its card no longer shows.
local function hiddenLabel(parent: Instance): TextLabel
	return text(parent, { Text = "", Visible = false })
end

local function buildPlot(index: number): Plot
	local c = theme.Colors
	local w = theme.Words
	local padColors = Paint.Pads
	local cf = plotCFrame(index)
	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. index
	folder.Parent = mapFolder

	local function L(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local function P(props: { [string]: any }): BasePart
		props.Parent = props.Parent or folder
		return make("Part", props)
	end
	local function W(props: { [string]: any }): BasePart
		props.Parent = props.Parent or folder
		return make("WedgePart", props)
	end
	local B: Builder = { cf = cf, folder = folder, c = c, L = L, P = P, W = W }

	buildFloor(B)
	buildWalls(B)
	Pen.build(B)
	local slots, championParts = buildShelves(B)
	local ownerLabel, ownerImage = buildEntrance(B, index)
	ownerLabel.Text = FREE_PLOT

	local pads: { Pad } = {}
	local padByName: { [string]: Pad } = {}
	local labels: { [string]: TextLabel } = {}
	local function pad(name: string, color: Color3, title: string, sub: string): Pad
		local record = buildPad(B, name, color, title, sub)
		table.insert(pads, record)
		padByName[name] = record
		return record
	end

	-- Until a player owns the plot (Server.Tycoon then writes every price and status), the pads
	-- show their name only, with no price: a "$0" reads as a live offer.

	-- Buy pads either side of the pen, named after the unit they sell like on an owned plot.
	local firstTier = theme.Tiers[1]
	local unitName = if firstTier then firstTier.Name else w.Unit
	for _, amount in Economy.BUY_AMOUNTS do
		pad("Buy" .. amount, padColors.Buy, "Buy " .. amount .. " " .. unitName, "")
	end
	pad("AutoMerge", padColors.AutoMerge, "Auto Merge", "Game pass")

	-- Merge pad centred in front of the pen, at the end of the walkway.
	pad("Merge", padColors.Merge, w.Merge, "Pairs merge into the next tier")

	-- Deposit station (-X court, level with the plaza): pad + converter machine. The pad's floating label already shows the
	-- multiplier, so the multiplier labels Tycoon writes stay hidden on the pad.
	local depositPad = pad("Deposit", padColors.Deposit, "DEPOSIT", "")
	do
		local conv = Layout.MACHINES.Converter
		buildConverter(B, (conv.minX + conv.maxX) / 2, (conv.minZ + conv.maxZ) / 2)
		labels.DepositMult = hiddenLabel(depositPad.part)
		labels.DepositNext = hiddenLabel(depositPad.part)
	end

	-- Processing machine (-X court, middle station) with its upgrade pads in front of it. Its
	-- board stands behind the counter, above the belt, facing the pads and the path (+X).
	do
		buildProcessor(B)
		local proc = Layout.MACHINES.Processor
		local body, title = standingCard(
			B,
			proc.minX - 0.4,
			(proc.minZ + proc.maxZ) / 2,
			FACE_PLUS_X,
			Vector2.new(7, 5.6),
			BOARD_BOTTOM,
			"⚡ " .. w.Process .. " ⚡",
			false
		)
		labels.ProcessTitle = title
		-- Main line: the aura waiting to be converted.
		labels.ProcessQueue =
			text(body, { Text = "", Font = theme.Fonts.Display, Size = UDim2.fromScale(0.9, 0.8), Position = UDim2.fromScale(0.05, 0.1) })
		labels.ProcessRate = hiddenLabel(body)
		labels.ProcessSpeed = hiddenLabel(body)
	end
	pad("ProcUp1", padColors.Process, "UPGRADE", "")
	pad("ProcUp10", padColors.Process, "UPGRADE x" .. Economy.PROCESS_BULK, "")

	-- Collect cash pad + coin vault (-X court, front station).
	pad("Collect", padColors.Collect, w.Collect, "")
	buildVault(B)

	-- Crate unlockers (+X court), each with a sign card standing at the machine's front.
	local unlockerScreens = {}
	for i = 1, 2 do
		local name = if i == 1 then w.Unlocker else w.PremiumUnlocker
		local color = if i == 1 then padColors.Unlock else padColors.UnlockVip
		pad("Unlock" .. i, color, name, "")
		local rect = Layout.MACHINES["Unlocker" .. i]
		buildUnlocker(B, rect, color)
		local body, titleLabel = standingCard(
			B,
			rect.minX - 0.4,
			(rect.minZ + rect.maxZ) / 2,
			FACE_MINUS_X,
			Vector2.new(6.2, 4.6),
			STATION_SIGN_BOTTOM,
			name,
			false
		)
		-- Tycoon tints the status in the crate's rarity colour, so it keeps an Ink outline.
		local statusLabel = text(body, {
			Text = "",
			Size = UDim2.fromScale(0.96, 0.36),
			Position = UDim2.fromScale(0.02, 0.02),
			TextColor3 = Paint.White,
			Outline = true,
		})
		local timerLabel = text(body, {
			Text = "",
			Font = theme.Fonts.Number,
			Size = UDim2.fromScale(0.9, 0.5),
			Position = UDim2.fromScale(0.05, 0.46),
		})
		table.insert(unlockerScreens, { frame = body, title = titleLabel, status = statusLabel, timer = timerLabel })
	end

	-- Free reward (+X court, front station): the pad, the gift box behind it and the sign card
	-- over the gift, facing the pad like the crackers' cards.
	local freeSpot = Layout.PADS.Free
	local gx, gz = freeSpot.x + freeSpot.sizeX / 2 + Layout.PAD_RIM + 2.65, freeSpot.z
	pad("Free", padColors.Free, w.Free, "")
	do
		local body = standingCard(B, gx + 2.2, gz, FACE_MINUS_X, Vector2.new(5.4, 4.6), STATION_SIGN_BOTTOM + 0.4, "🎁 " .. w.Free)
		-- Tycoon writes the countdown or "READY!" in white / green, so it keeps an Ink outline.
		labels.FreeStatus = text(body, {
			Text = "",
			Font = theme.Fonts.Display,
			Size = UDim2.fromScale(0.94, 0.8),
			Position = UDim2.fromScale(0.03, 0.1),
			Outline = true,
			TextColor3 = Paint.White,
		})
		-- Gift box between the pad and the card's legs.
		P({ Name = "Gift", Size = Vector3.new(2.8, 2.6, 2.8), CFrame = L(gx, 1.3, gz), Color = Paint.Coral })
		for _, size in { Vector3.new(2.9, 2.7, 0.6), Vector3.new(0.6, 2.7, 2.9) } do
			soft(P({ Name = "GiftRibbon", Size = size, CFrame = L(gx, 1.3, gz), Color = Paint.White }))
		end
		for _, dx in { -0.45, 0.45 } do
			soft(P({
				Name = "GiftBow",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.1, 1.1, 1.1),
				CFrame = L(gx + dx, 2.95, gz),
				Color = Paint.Sunny,
			}))
		end
	end

	if theme.Decor == "gym" then
		buildGymDecor(B)
	end

	labels.Owner = ownerLabel

	-- Server.Tycoon puts the owner's avatar on the entrance card and clears it when they leave:
	-- with no avatar the plot is free, so its pad names are dimmed and its card says so.
	local function showClaimed()
		local claimed = ownerImage.Image ~= ""
		for _, record in pads do
			setPadClaimed(record, claimed)
		end
		if not claimed then
			ownerLabel.Text = FREE_PLOT
		end
	end
	ownerImage:GetPropertyChangedSignal("Image"):Connect(showClaimed)
	showClaimed()

	makeCameraSafe(folder)

	local unitFolder = Instance.new("Folder")
	unitFolder.Name = "Units"
	watchChampion(unitFolder, championParts)
	unitFolder.Parent = folder
	local orbFolder = Instance.new("Folder")
	orbFolder.Name = "Orbs"
	orbFolder.Parent = folder
	local chestFolder = Instance.new("Folder")
	chestFolder.Name = "Chests"
	chestFolder.Parent = folder

	local orbArea = Layout.ORB_AREA
	local poolRect = Layout.POOL
	local chestAreas: { Rect } = {}
	for _, area in Layout.CHEST_AREAS do
		table.insert(chestAreas, Layout.rect(area.minX, area.maxX, area.minZ, area.maxZ))
	end
	return {
		index = index,
		cframe = cf,
		folder = folder,
		unitFolder = unitFolder,
		orbFolder = orbFolder,
		chestFolder = chestFolder,
		spawn = L(Layout.SPAWN.x, 4, Layout.SPAWN.z) * CFrame.Angles(0, math.pi, 0),
		slots = slots,
		orbArea = Layout.rect(orbArea.minX, orbArea.maxX, orbArea.minZ, orbArea.maxZ),
		orbFloorY = Layout.POOL_FLOOR_Y,
		pool = Layout.rect(poolRect.minX, poolRect.maxX, poolRect.minZ, poolRect.maxZ),
		chestAreas = chestAreas,
		pads = pads,
		padByName = padByName,
		labels = labels,
		ownerImage = ownerImage,
		unlockerScreens = unlockerScreens,
	}
end

function WorldBuilder.build(_themeModule: any): World
	mapFolder.Parent = Workspace

	Hub.setupLighting()
	local ranking = Hub.buildHub()
	local modes = Modes.build()
	local mog = MogStage.build()
	local cardio = CardioTrack.build()
	local plots = {}
	for i = 1, PLOT_COUNT do
		table.insert(plots, buildPlot(i))
	end
	-- Blender meshes replace the part-built props that have one (World.Props).
	Props.apply(mapFolder)
	return { plots = plots, ranking = ranking, modes = modes, mog = mog, cardio = cardio }
end

WorldBuilder.label = Common.label
WorldBuilder.billboard = Common.externalBillboard

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="212">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="213">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">120</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="214">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="215">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="216">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--[[
	Animator: plays the procedural unit animations (Shared.Poses) on the client.

	World units: every model tagged "AnimatedUnit" under Workspace is picked up
	automatically. The server builds them static; each client poses them
	locally (nothing replicates). A plot's rack can hold 100 jointed rigs, so
	posing is budgeted every frame:
	  * Units further than FAR studs from the camera, behind it or outside the
	    view cone (a cheap dot-product test, no engine calls) are skipped and
	    hold their last pose.
	  * Of the visible ones, the OWN_FULL nearest on the player's own plot
	    (Animator.setOwnPlot) and the OTHER_FULL nearest on other plots are
	    posed every frame (16 and 4). The hero and units playing a one-off pose
	    jump the queue.
	  * Every other visible unit is refreshed round-robin, OWN_TRICKLE (own
	    plot) and OTHER_TRICKLE (other plots) per frame, so none stays frozen
	    for long (about 6 Hz for a full own rack at 60 fps). At most 24 own and
	    8 other rigs are posed per frame.
	All world parts are moved with one BulkMoveTo call per frame. The hot path
	reuses its tables (no table allocations per frame); only CFrame values are
	created. Animator.stats() reports the last frame's counts.
	On "mid" / "low" devices (Fx.Budget) the full / trickle counts scale with
	Budget.count and on low units past LOW_FAR studs hold their pose.

	Viewport units (Index cards, reward popup): call Animator.attach(model)
	after building the model; they animate while their ViewportFrame is
	visible. Animator.detach(model) stops it (also automatic once the model is
	destroyed).

	Tier flavour (world units with a "Tier" attribute): idle tempo and float
	bob rise with tier, tiers >= 10 now and then hop into a showy pose, and
	every 6-10 s one random fully animated unit flexes.
	Animator.setHero(model, on) marks the shelf's best unit: a slower, prouder
	idle (deep chest breathing, a slight lift) and a power pose every ~8 s.
	Animator.isHeld(model) tells Fx code a unit is mid drop-in.
	Animator.show(model, pose?, duration?, hop?) plays a one-off pose (used by
	Fx.Shelf for the landing power pose). Animator.hold(model) freezes a unit
	in its rest pose (so it can be rescaled); Animator.release(model) re-captures
	its rest pose and resumes.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Poses = require(Shared:WaitForChild("Poses"))
local RigPose = require(Shared:WaitForChild("RigPose"))
local Budget = require(script.Parent.Fx.Budget)

local Animator = {}

local FAR = 140 -- studs: beyond this units hold their pose
local LOW_FAR = 100 -- the same on a "low" budget device
local OWN_FULL = 16 -- own-plot rigs posed every frame (nearest visible first)
local OTHER_FULL = 4 -- other plots' rigs posed every frame
local OWN_TRICKLE = 8 -- further visible own-plot rigs refreshed per frame, round-robin
local OTHER_TRICKLE = 4 -- the same for other plots
local POS_REFRESH = 30 -- frames between position re-reads of a unit that is not posed
local VIEW_MARGIN = 1.6 -- unit heights of slack around the view cone
local VIEWPORT_INTERVAL = 1 / 30 -- viewport units animate at 30 fps
local PRUNE_AFTER = 3 -- seconds an attached model may sit without a parent
local SHOW_FADE = 0.25 -- seconds to blend into / out of a one-off pose
local SHOW_PRIORITY = 0.3 -- distance factor for units playing a one-off pose
local FLEX_EVERY = { 6, 10 } -- seconds between random flexes
local FLEX_POSES = { "DoubleBiceps", "MostMuscular", "LatSpread", "SideChest" }
local SHOWY_POSES = { "DoubleBiceps", "MostMuscular", "Point", "SmugTurn" }
local IDENTITY = CFrame.new()

type Entry = {
	model: Model,
	rig: RigPose.Rig?,
	viewport: boolean,
	slot: number,
	index: number, -- position in `list`
	height: number,
	orphanSince: number?,
	nextViewportUpdate: number,
	connections: { RBXScriptConnection },
	plot: Instance?, -- the plot folder holding the unit (Units' parent)
	pos: Vector3?, -- cached root position
	world: { [string]: CFrame }, -- per-limb world frames (reused)
	visibleFrame: number,
	fullFrame: number,
	-- Tier flavour (world units only).
	tier: number,
	tempo: number,
	bob: number,
	clock: number,
	held: boolean,
	showPose: string?,
	showStart: number,
	showLength: number,
	showHop: number,
	nextShowy: number,
	seenFrame: number,
}

local entries: { [Model]: Entry } = {}
local list: { Entry } = {}
local heroes: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local HERO_POSES = { "MostMuscular", "DoubleBiceps", "LatSpread", "SideChest" }
local slotCounter = 0
local started = false
local ownPlot: Instance? = nil

local function newSeed(): number
	return math.random(0, 99999)
end

local function tryCapture(entry: Entry): RigPose.Rig?
	if entry.rig then
		return entry.rig
	end
	local model = entry.model
	local okScale, modelScale = pcall(function()
		return model:GetScale()
	end)
	local rig = RigPose.capture(model, newSeed())
	if rig and okScale and type(modelScale) == "number" and modelScale ~= 1 then
		-- Someone rescaled the model after it was built: scale the pivots too.
		rig.scale *= modelScale
		for limb, pivot in rig.pivots do
			rig.pivots[limb] = pivot * modelScale
		end
		table.clear(rig.parts)
		table.clear(rig.limbs)
		table.clear(rig.offsets)
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				RigPose.addPart(rig, d)
			end
		end
	end
	if rig then
		entry.rig = rig
		local height = model:GetAttribute("Height")
		entry.height = if type(height) == "number" then height else 6
		entry.pos = rig.root.Position
	end
	return rig
end

local function register(model: Model, viewport: boolean)
	local existing = entries[model]
	if existing then
		existing.viewport = existing.viewport or viewport
		return
	end
	slotCounter += 1
	local entry: Entry = {
		model = model,
		rig = nil,
		viewport = viewport,
		slot = slotCounter,
		index = #list + 1,
		height = 6,
		orphanSince = nil,
		nextViewportUpdate = 0,
		connections = {},
		plot = nil,
		pos = nil,
		world = {},
		visibleFrame = 0,
		fullFrame = 0,
		tier = 1,
		tempo = 1,
		bob = 0,
		clock = os.clock(),
		held = false,
		showPose = nil,
		showStart = 0,
		showLength = 0,
		showHop = 0,
		nextShowy = os.clock() + 8 + math.random() * 12,
		seenFrame = 0,
	}
	entries[model] = entry
	list[entry.index] = entry
end

-- Reads the unit's tier and derives its idle tempo and float bob.
local function readTier(entry: Entry)
	local value = entry.model:GetAttribute("Tier")
	local tier = if type(value) == "number" then value else 1
	entry.tier = tier
	entry.tempo = 1 + math.clamp(tier - 1, 0, 24) * 0.025 -- 1.0x .. 1.6x
	entry.bob = math.max(0, tier - 9) * 0.012 -- unscaled studs, 0 .. ~0.19
	if heroes[entry.model] then
		entry.tempo *= 0.8 -- the champion takes its time
	end
end

local function readPlot(entry: Entry)
	local units = entry.model.Parent
	entry.plot = if units then units.Parent else nil
end

-- Hooked up on the first frame a unit is processed (keeps attach() free of
-- side effects, so tools that load the UI without a frame loop stay happy).
local function connect(entry: Entry)
	local model = entry.model
	readTier(entry)
	readPlot(entry)
	table.insert(
		entry.connections,
		model:GetAttributeChangedSignal("Tier"):Connect(function()
			readTier(entry)
		end)
	)
	table.insert(
		entry.connections,
		model.AncestryChanged:Connect(function()
			readPlot(entry)
		end)
	)
	-- Parts that stream in later arrive in their rest pose; parts that leave are dropped.
	table.insert(
		entry.connections,
		model.DescendantAdded:Connect(function(d)
			local rig = entry.rig
			if rig and d:IsA("BasePart") then
				RigPose.addPart(rig, d)
			end
		end)
	)
	table.insert(
		entry.connections,
		model.DescendantRemoving:Connect(function(d)
			local rig = entry.rig
			if rig and d:IsA("BasePart") then
				if d == rig.root then
					-- Streamed out: forget it; it re-registers when it streams back in.
					task.defer(Animator.detach, entry.model)
				else
					RigPose.removePart(rig, d)
				end
			end
		end)
	)
end

local function unregister(model: Model)
	local entry = entries[model]
	if not entry then
		return
	end
	entries[model] = nil
	-- Swap-remove from the list, keeping indices right.
	local last = list[#list]
	list[entry.index] = last
	last.index = entry.index
	list[#list] = nil
	for _, connection in entry.connections do
		connection:Disconnect()
	end
end

-- Animate a model that lives outside Workspace (e.g. in a ViewportFrame).
function Animator.attach(model: Model)
	register(model, true)
end

function Animator.detach(model: Model)
	unregister(model)
end

-- The local player's plot folder: its units get the bigger budgets.
function Animator.setOwnPlot(plot: Instance?)
	ownPlot = plot
end

-- Plays a one-off pose on a world unit (blends in and out); `hop` lifts the
-- root in a small arc (unscaled studs).
function Animator.show(model: Model, pose: string?, duration: number?, hop: number?)
	local entry = entries[model]
	if not entry or entry.held then
		return
	end
	local poses = Poses.poseNames((model:GetAttribute(Poses.SET_ATTRIBUTE) :: string?) or "Chad")
	local name = pose
	if not name or not table.find(poses, name) then
		name = poses[math.random(2, math.max(2, #poses))] or poses[1]
	end
	entry.showPose = name
	entry.showStart = os.clock()
	entry.showLength = duration or 1.6
	entry.showHop = hop or 0
end

-- Marks (or clears) the shelf's hero unit: slower, prouder idle and regular power poses.
function Animator.setHero(model: Model, on: boolean)
	if (heroes[model] == true) == on then
		return
	end
	heroes[model] = (if on then true else nil) :: any
	local entry = entries[model]
	if entry and #entry.connections > 0 then
		readTier(entry)
		if on then
			entry.nextShowy = os.clock() + 1.5
		end
	end
end

function Animator.isHeld(model: Model): boolean
	local entry = entries[model]
	return entry ~= nil and entry.held
end

-- Freezes a world unit in its rest pose (for client-side rescaling).
function Animator.hold(model: Model)
	if not entries[model] then
		register(model, false)
	end
	local entry = entries[model] :: Entry
	entry.held = true
	entry.showPose = nil
	if entry.rig then
		RigPose.reset(entry.rig)
	end
end

-- Resumes a held unit, re-capturing its rest pose (it may have been rescaled).
function Animator.release(model: Model)
	local entry = entries[model]
	if not entry then
		return
	end
	entry.held = false
	entry.rig = nil
end

-- Is the ViewportFrame (or other GUI) holding this model actually on screen?
local function guiVisible(model: Model): boolean
	local node: Instance? = model.Parent
	while node do
		if node:IsA("GuiObject") then
			if not node.Visible then
				return false
			end
		elseif node:IsA("LayerCollector") then
			return node.Enabled and node:FindFirstAncestorWhichIsA("PlayerGui") ~= nil
		end
		node = node.Parent
	end
	return false
end

local worldParts: { BasePart } = {}
local worldCFrames: { CFrame } = {}
local frameCount = 0
local lastStep = os.clock()
local nextFlex = os.clock() + FLEX_EVERY[1]
local showBuffer: { [string]: CFrame } = {}
local showTarget: { [string]: CFrame } = {}
local flexCandidates: { Entry } = {}

-- Nearest-first selections (reused every frame).
local ownPick: { Entry } = {}
local ownKeys: { number } = {}
local otherPick: { Entry } = {}
local otherKeys: { number } = {}
local ownCursor = 1
local otherCursor = 1

local stats = { units = 0, visible = 0, full = 0, trickle = 0, parts = 0 }

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Inserts `item` into the ascending `keys`/`picks` arrays holding `n` items, keeping at
-- most `cap` (the largest key drops out). Returns the new count.
local function insertNearest<T>(picks: { T }, keys: { number }, n: number, cap: number, item: T, key: number): number
	if n >= cap then
		if cap <= 0 or key >= keys[n] then
			return n
		end
	else
		n += 1
	end
	local j = n
	while j > 1 and keys[j - 1] > key do
		picks[j] = picks[j - 1]
		keys[j] = keys[j - 1]
		j -= 1
	end
	picks[j] = item
	keys[j] = key
	return n
end

-- Is a sphere of `radius` around `rel` (relative to the camera) inside the view cone?
-- `look`, `right`, `up` are the camera axes; tanX / tanY the half-angle tangents.
local function inView(rel: Vector3, radius: number, look: Vector3, right: Vector3, up: Vector3, tanX: number, tanY: number): boolean
	local z = rel:Dot(look)
	if z < -radius then
		return false
	end
	local slackX = radius * math.sqrt(1 + tanX * tanX)
	local slackY = radius * math.sqrt(1 + tanY * tanY)
	return math.abs(rel:Dot(right)) <= z * tanX + slackX and math.abs(rel:Dot(up)) <= z * tanY + slackY
end

Animator.insertNearest = insertNearest
Animator.inView = inView

-- Joint transforms for a world unit: tier tempo, float bob and any one-off pose.
local function worldTransforms(entry: Entry, rig: RigPose.Rig, now: number): { [string]: CFrame }
	local transforms = Poses.sampleInto(rig.transforms, rig.animSet, entry.clock, rig.seed)
	local lift = 0
	if entry.bob > 0 then
		lift += entry.bob * (1 + math.sin(entry.clock * 1.7 + rig.seed))
	end
	local hero = heroes[entry.model]
	if hero then
		-- Deep, slow chest breathing: rise on the inhale, hold, settle.
		local breath = math.sin(now * 1.3)
		lift += 0.08 + 0.06 * breath * math.abs(breath)
	end
	local pose = entry.showPose
	if pose then
		local t = now - entry.showStart
		if t >= entry.showLength then
			entry.showPose = nil
		else
			local w = smooth(t / SHOW_FADE) * smooth((entry.showLength - t) / SHOW_FADE)
			local target = Poses.samplePoseInto(showTarget, rig.animSet, pose, entry.clock, rig.seed)
			for limb, cf in transforms do
				local goal = target[limb]
				if goal then
					showBuffer[limb] = cf:Lerp(goal, w)
				end
			end
			for limb, cf in showBuffer do
				transforms[limb] = cf
			end
			table.clear(showBuffer)
			if entry.showHop > 0 then
				local p = math.clamp(t / math.min(0.6, entry.showLength), 0, 1)
				lift += entry.showHop * 4 * p * (1 - p)
			end
		end
	end
	if lift ~= 0 then
		transforms.LowerTorso = CFrame.new(0, lift, 0) * (transforms.LowerTorso or IDENTITY)
	end
	return transforms
end

-- Poses one world unit and queues its parts for this frame's BulkMoveTo: one root * limb
-- multiply per limb, then one multiply per part.
local function pose(entry: Entry, rig: RigPose.Rig, now: number)
	local frames = Poses.solve(rig.pivots, worldTransforms(entry, rig, now), rig.scale, rig.frames)
	local root = rig.root.CFrame
	entry.pos = root.Position
	local world = entry.world
	for limb, frame in frames do
		world[limb] = root * frame
	end
	local parts, limbs, offsets = rig.parts, rig.limbs, rig.offsets
	local n = #worldParts
	for i = 1, #parts do
		n += 1
		worldParts[n] = parts[i]
		worldCFrames[n] = world[limbs[i]] * offsets[i]
	end
end

-- Every few seconds a random fully animated unit flexes; high tiers show off on their own.
local function pickFlex(now: number)
	if now < nextFlex then
		return
	end
	nextFlex = now + FLEX_EVERY[1] + math.random() * (FLEX_EVERY[2] - FLEX_EVERY[1])
	table.clear(flexCandidates)
	for _, entry in list do
		if not entry.viewport and not entry.held and not entry.showPose and entry.seenFrame >= frameCount - 2 then
			table.insert(flexCandidates, entry)
		end
	end
	if #flexCandidates > 0 then
		local entry = flexCandidates[math.random(1, #flexCandidates)]
		Animator.show(entry.model, FLEX_POSES[math.random(1, #FLEX_POSES)], 1.8, 0)
	end
	table.clear(flexCandidates)
end

-- A unit in the every-frame set: may start a showy / hero pose, then is posed.
local function poseFull(entry: Entry, now: number)
	local rig = entry.rig
	if not rig or not entry.model:IsDescendantOf(Workspace) then
		return
	end
	entry.fullFrame = frameCount
	entry.seenFrame = frameCount
	if heroes[entry.model] and not entry.showPose and now >= entry.nextShowy then
		-- Hero: a held, proud power pose every ~8 s (no hop: grounded and confident).
		entry.nextShowy = now + 7 + math.random() * 3
		Animator.show(entry.model, HERO_POSES[math.random(1, #HERO_POSES)], 2.6, 0)
	elseif entry.tier >= 10 and not entry.showPose and now >= entry.nextShowy then
		entry.nextShowy = now + 14 + math.random() * 16 - entry.tier * 0.3
		Animator.show(entry.model, SHOWY_POSES[math.random(1, #SHOWY_POSES)], 2, 0.6 + entry.tier * 0.02)
	end
	pose(entry, rig, now)
end

-- Refreshes up to `budget` visible units of one group (own plot or not) that were not in
-- the every-frame set, continuing round-robin from `cursor`. Returns the next cursor.
local function trickle(cursor: number, own: boolean, budget: number, waiting: number, now: number): number
	local count = #list
	local todo = math.min(budget, waiting)
	if todo <= 0 or count == 0 then
		return cursor
	end
	for _ = 1, count do
		if cursor > count then
			cursor = 1
		end
		local entry = list[cursor]
		cursor += 1
		if entry.visibleFrame == frameCount and entry.fullFrame ~= frameCount and (ownPlot == nil or entry.plot == ownPlot) == own then
			local rig = entry.rig
			if rig and entry.model:IsDescendantOf(Workspace) then
				pose(entry, rig, now)
				stats.trickle += 1
			end
			todo -= 1
			if todo <= 0 then
				break
			end
		end
	end
	return cursor
end

local function step()
	frameCount += 1
	local now = os.clock()
	local dt = math.min(now - lastStep, 0.1)
	lastStep = now
	pickFlex(now)
	local camera = Workspace.CurrentCamera
	local camCFrame = if camera then camera.CFrame else IDENTITY
	local camPos = camCFrame.Position
	local look, right, up = camCFrame.LookVector, camCFrame.RightVector, camCFrame.UpVector
	local viewSize = if camera then camera.ViewportSize else Vector2.new(1920, 1080)
	local tanY = math.tan(math.rad((if camera then camera.FieldOfView else 70) / 2))
	local tanX = tanY * viewSize.X / math.max(viewSize.Y, 1)
	table.clear(worldParts)
	table.clear(worldCFrames)
	stats.units, stats.visible, stats.full, stats.trickle = 0, 0, 0, 0
	local far = if Budget.low() then LOW_FAR else FAR
	local ownFull, otherFull = Budget.count(OWN_FULL), Budget.count(OTHER_FULL)

	local ownN, otherN = 0, 0
	local ownVisible, otherVisible = 0, 0
	local i = 1
	while i <= #list do
		local entry = list[i]
		local model = entry.model
		if not model.Parent then
			entry.orphanSince = entry.orphanSince or now
			if now - (entry.orphanSince :: number) > PRUNE_AFTER then
				unregister(model) -- swaps the last entry into slot i
				continue
			end
			i += 1
			continue
		end
		i += 1
		entry.orphanSince = nil
		if #entry.connections == 0 then
			connect(entry)
		end
		if entry.held then
			continue
		end
		local rig = tryCapture(entry)
		if not rig then
			continue
		end

		if entry.viewport then
			if now >= entry.nextViewportUpdate and guiVisible(model) then
				entry.nextViewportUpdate = now + VIEWPORT_INTERVAL
				RigPose.apply(rig, now)
			end
			continue
		end

		stats.units += 1
		entry.clock += dt * entry.tempo
		if (frameCount + entry.slot) % POS_REFRESH == 0 or not entry.pos then
			entry.pos = rig.root.Position
		end
		local half = entry.height * 0.5
		local rel = (entry.pos :: Vector3) + Vector3.new(0, half, 0) - camPos
		local distance = rel.Magnitude
		if distance > far then
			continue
		end
		if distance > entry.height * 1.5 and not inView(rel, half * VIEW_MARGIN, look, right, up, tanX, tanY) then
			continue
		end
		entry.visibleFrame = frameCount
		local key = distance
		if heroes[model] then
			key = 0
		elseif entry.showPose then
			key *= SHOW_PRIORITY
		end
		if ownPlot == nil or entry.plot == ownPlot then
			ownVisible += 1
			ownN = insertNearest(ownPick, ownKeys, ownN, ownFull, entry, key)
		else
			otherVisible += 1
			otherN = insertNearest(otherPick, otherKeys, otherN, otherFull, entry, key)
		end
	end

	for k = 1, ownN do
		poseFull(ownPick[k], now)
	end
	for k = 1, otherN do
		poseFull(otherPick[k], now)
	end
	stats.full = ownN + otherN
	stats.visible = ownVisible + otherVisible
	ownCursor = trickle(ownCursor, true, Budget.count(OWN_TRICKLE), ownVisible - ownN, now)
	otherCursor = trickle(otherCursor, false, Budget.count(OTHER_TRICKLE), otherVisible - otherN, now)
	-- Drop the references so destroyed models can be collected.
	table.clear(ownPick)
	table.clear(otherPick)

	stats.parts = #worldParts
	if #worldParts > 0 then
		Workspace:BulkMoveTo(worldParts, worldCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Last frame's counts: world units tracked, visible, posed in full, refreshed round-robin,
-- parts moved. For profiling in Studio.
function Animator.stats(): { units: number, visible: number, full: number, trickle: number, parts: number }
	return table.clone(stats)
end

local function onTagged(instance: Instance)
	if instance:IsA("Model") and instance:IsDescendantOf(Workspace) then
		register(instance, false)
	end
end

function Animator.start()
	if started then
		return
	end
	started = true
	CollectionService:GetInstanceAddedSignal(Poses.TAG):Connect(onTagged)
	CollectionService:GetInstanceRemovedSignal(Poses.TAG):Connect(function(instance)
		local entry = entries[instance :: Model]
		if entry and not entry.viewport then
			unregister(instance :: Model)
		end
	end)
	for _, instance in CollectionService:GetTagged(Poses.TAG) do
		onTagged(instance)
	end
	RunService.RenderStepped:Connect(step)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="217">
          <Properties>
            <string name="Name">Fx</string>
          </Properties>
          <Item class="ModuleScript" referent="218">
            <Properties>
              <string name="Name">Ambient</string>
              <string name="Source"><![CDATA[--[[
	Fx.Ambient: gentle idle life for the whole map (client-side only).

	Picks up anchored world parts and models by name or attribute, at load and
	whenever they stream or get built in:
	  "Flag" / "Bunting"   sway about their top edge (a part's optional
	                       Vector3 attribute "SwayPivot", in part space, moves
	                       the hinge; models sway about their pivot). All
	                       sway shares one wind axis, phased along the wind
	                       so pennants on a cord swing together
	  "Prop_PalmTree"      sways very slightly about the trunk base
	  "Cloud"              drifts slowly back and forth across the sky
	  attribute Spin       (number, rad/s) turns about its own up axis
	  attribute Bob        (number, studs) bobs up and down
	A model that matches moves as one piece; its parts are not matched again.

	One Heartbeat loop moves everything with a single BulkMoveTo. Things far
	from the camera (clouds excepted) hold still, mid-range ones update every
	few frames, and every motion is a function of time, so nothing drifts.
	On "mid" / "low" devices (Fx.Budget) the moving radius shrinks and updates
	thin out further (low: nothing past 120 studs, near things every 2nd frame).
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Budget = require(script.Parent.Budget)

local Ambient = {}

local FAR = 220 -- studs: beyond this nothing moves (clouds excepted)
local NEAR = 90 -- studs: closer than this things update every frame
local MID_RATE = 3 -- frames between updates beyond NEAR
local CLOUD_RATE = 4 -- frames between cloud updates
local BEHIND = -40 -- studs behind the camera plane still updated
-- Per device tier: { far, near, near rate, mid rate, cloud rate } ("high" is the values above).
local TIERS: { [string]: { number } } = {
	high = { FAR, NEAR, 1, MID_RATE, CLOUD_RATE },
	mid = { 170, 70, 1, MID_RATE, 6 },
	low = { 120, 50, 2, 4, 8 },
}
local MODEL_DELAY = 0.5 -- seconds to let a model's parts arrive before capturing it

local FLAG_SWAY = math.rad(6)
local FLAG_SPEED = { 1.6, 2.3 }
local PALM_SWAY = math.rad(1.2)
local PALM_SPEED = { 0.55, 0.8 }
local CLOUD_DRIFT = 26 -- studs either side of the rest position
local CLOUD_SPEED = 2 * math.pi / 240 -- one back-and-forth every 4 minutes
local WIND = Vector3.new(1, 0, 0.35).Unit
-- Swaying things all tip about the same world axes (X across the wind), so pennants on one
-- cord swing together; WAVE turns position into phase, sending a gentle ripple downwind.
local WIND_FRAME = CFrame.lookAt(Vector3.zero, WIND)
local WAVE = 0.12 -- radians of phase per stud along the wind
local BOB_SPEED = 1.8

type Target = {
	owner: Instance,
	parts: { BasePart },
	offsets: { CFrame },
	hinge: CFrame,
	sway: number, -- radians about the hinge's X axis (Z gets half)
	swaySpeed: number,
	spin: number,
	bob: number,
	drift: number,
	phase: number,
	sky: boolean,
	slot: number,
}

local targets: { Target } = {}
local byOwner: { [Instance]: Target } = {}
local claimed: { [BasePart]: Target } = {}
local bulkParts: { BasePart } = {}
local bulkCFrames: { CFrame } = {}
local frameCount = 0
local slotCounter = 0
local clockStart = os.clock()
local started = false

-- The motion of a target at time t, as a CFrame applied to its hinge.
local function motion(target: Target, t: number): CFrame
	local p = target.phase
	local x, y, z = 0, 0, 0
	if target.drift ~= 0 then
		local d = target.drift * math.sin(t * CLOUD_SPEED + p)
		x, z = WIND.X * d, WIND.Z * d
	end
	if target.bob ~= 0 then
		y = target.bob * math.sin(t * BOB_SPEED + p)
	end
	local rx, ry, rz = 0, 0, 0
	if target.sway ~= 0 then
		local s = target.swaySpeed
		rx = target.sway * math.sin(t * s + p)
		rz = target.sway * 0.5 * math.sin(t * s * 0.73 + p * 1.7)
	end
	if target.spin ~= 0 then
		ry = (t * target.spin) % (2 * math.pi)
	end
	return CFrame.new(x, y, z) * target.hinge * CFrame.fromEulerAnglesYXZ(rx, ry, rz)
end

-- Puts a target's parts back where they were captured.
local function rest(target: Target)
	for i, part in target.parts do
		if part.Parent then
			part.CFrame = target.hinge * target.offsets[i]
		end
	end
end

local function removeTarget(target: Target, restore: boolean)
	local index = table.find(targets, target)
	if not index then
		return
	end
	targets[index] = targets[#targets]
	targets[#targets] = nil
	byOwner[target.owner] = nil
	for _, part in target.parts do
		if claimed[part] == target then
			claimed[part] = nil
		end
	end
	if restore then
		rest(target)
	end
end

local function claim(target: Target, part: BasePart)
	if not part.Anchored then
		return
	end
	local previous = claimed[part]
	if previous and previous ~= target then
		removeTarget(previous, true)
	end
	claimed[part] = target
	table.insert(target.parts, part)
	table.insert(target.offsets, target.hinge:ToObjectSpace(part.CFrame))
end

local function randomIn(range: { number }): number
	return range[1] + math.random() * (range[2] - range[1])
end

-- A sway hinge at `position`: world-aligned to the wind, phased by where it stands.
local function swayHinge(target: Target, position: Vector3)
	target.hinge = CFrame.new(position) * WIND_FRAME
	target.phase = position:Dot(WIND) * WAVE
end

-- The middle of a part's highest face (pennants hang from it, even when built upside down).
local function topOf(part: BasePart): Vector3
	local cf = part.CFrame
	local half = part.Size / 2
	local best, bestY = cf.Position, -math.huge
	for _, offset in { cf.UpVector * half.Y, cf.RightVector * half.X, cf.LookVector * half.Z } do
		for _, sign in { 1, -1 } do
			local y = offset.Y * sign
			if y > bestY then
				best, bestY = cf.Position + offset * sign, y
			end
		end
	end
	return best
end

local function matches(instance: Instance): boolean
	local name = instance.Name
	return name == "Flag"
		or name == "Bunting"
		or name == "Prop_PalmTree"
		or name == "Cloud"
		or type(instance:GetAttribute("Spin")) == "number"
		or type(instance:GetAttribute("Bob")) == "number"
end

-- The moving target that already owns `instance` through one of its ancestors.
local function ownerAbove(instance: Instance): Target?
	local node = instance.Parent
	while node and node ~= Workspace do
		local target = byOwner[node]
		if target then
			return target
		end
		node = node.Parent
	end
	return nil
end

-- What `instance` should do, or nil when it is not ambient scenery.
local function describe(instance: Instance): Target?
	if not matches(instance) then
		return nil
	end
	local name = instance.Name
	local spin = instance:GetAttribute("Spin")
	local bob = instance:GetAttribute("Bob")
	local isFlag = name == "Flag" or name == "Bunting"
	local isPalm = name == "Prop_PalmTree"
	local isCloud = name == "Cloud"
	slotCounter += 1
	local target: Target = {
		owner = instance,
		parts = {},
		offsets = {},
		hinge = CFrame.identity,
		sway = 0,
		swaySpeed = 0,
		spin = if type(spin) == "number" then spin else 0,
		bob = if type(bob) == "number" then bob else 0,
		drift = 0,
		phase = math.random() * 2 * math.pi,
		sky = isCloud,
		slot = slotCounter,
	}
	if isFlag then
		target.sway = FLAG_SWAY
		target.swaySpeed = randomIn(FLAG_SPEED)
	elseif isPalm then
		target.sway = PALM_SWAY
		target.swaySpeed = randomIn(PALM_SPEED)
	elseif isCloud then
		target.drift = CLOUD_DRIFT
	end
	return target
end

local function capture(instance: Instance)
	if byOwner[instance] or not instance:IsDescendantOf(Workspace) or ownerAbove(instance) then
		return
	end
	local target = describe(instance)
	if not target then
		return
	end
	if instance:IsA("BasePart") then
		if claimed[instance] or not instance.Anchored then
			return
		end
		local pivot = instance:GetAttribute("SwayPivot")
		if target.sway ~= 0 then
			swayHinge(target, if typeof(pivot) == "Vector3" then instance.CFrame * pivot else topOf(instance))
		else
			target.hinge = instance.CFrame
		end
		claim(target, instance)
	elseif instance:IsA("Model") then
		if instance.Name == "Prop_PalmTree" then
			local box, size = instance:GetBoundingBox()
			swayHinge(target, box.Position - Vector3.new(0, size.Y / 2, 0))
		elseif target.sway ~= 0 then
			swayHinge(target, instance:GetPivot().Position)
		else
			target.hinge = instance:GetPivot()
		end
		for _, d in instance:GetDescendants() do
			if d:IsA("BasePart") then
				claim(target, d)
			end
		end
	else
		return
	end
	if #target.parts == 0 then
		return
	end
	table.insert(targets, target)
	byOwner[instance] = target
end

local function consider(instance: Instance)
	if instance:IsA("BasePart") then
		if claimed[instance] then
			return
		end
		-- A part arriving inside a model that is already moving: re-capture the model.
		local above = ownerAbove(instance)
		if above then
			local owner = above.owner
			removeTarget(above, true)
			task.delay(MODEL_DELAY, capture, owner)
			return
		end
		capture(instance)
	elseif instance:IsA("Model") and matches(instance) then
		-- Give the model's parts a moment to arrive (building / streaming).
		task.delay(MODEL_DELAY, capture, instance)
	end
end

local function onRemoving(instance: Instance)
	local target = byOwner[instance]
	if target then
		removeTarget(target, false)
		return
	end
	if instance:IsA("BasePart") then
		local owner = claimed[instance]
		if owner then
			local index = table.find(owner.parts, instance)
			if index then
				table.remove(owner.parts, index)
				table.remove(owner.offsets, index)
			end
			claimed[instance] = nil
		end
	end
end

local function step()
	local count = #targets
	if count == 0 then
		return
	end
	frameCount += 1
	local t = os.clock() - clockStart
	local camera = Workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	local camLook = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
	local tier = TIERS[Budget.tier()]
	local far, near, nearRate, midRate, cloudRate = tier[1], tier[2], tier[3], tier[4], tier[5]
	table.clear(bulkParts)
	table.clear(bulkCFrames)
	local n = 0
	for i = 1, count do
		local target = targets[i]
		if target.sky then
			if (frameCount + target.slot) % cloudRate ~= 0 then
				continue
			end
		else
			local offset = target.hinge.Position - camPos
			local distance = offset.Magnitude
			if distance > far or offset:Dot(camLook) < BEHIND then
				continue
			end
			local rate = if distance > near then midRate else nearRate
			if rate > 1 and (frameCount + target.slot) % rate ~= 0 then
				continue
			end
		end
		local frame = motion(target, t)
		local offsets = target.offsets
		for k, part in target.parts do
			n += 1
			bulkParts[n] = part
			bulkCFrames[n] = frame * offsets[k]
		end
	end
	if n > 0 then
		Workspace:BulkMoveTo(bulkParts, bulkCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function Ambient.init()
	if started then
		return
	end
	started = true
	for _, d in Workspace:GetDescendants() do
		if d:IsA("Model") or d:IsA("BasePart") then
			capture(d)
		end
	end
	Workspace.DescendantAdded:Connect(consider)
	Workspace.DescendantRemoving:Connect(onRemoving)
	RunService.Heartbeat:Connect(step)
end

return Ambient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="219">
            <Properties>
              <string name="Name">Budget</string>
              <string name="Source"><![CDATA[--[[
	Fx.Budget: how much effect work this device gets, so phones stay smooth.

	  Budget.tier()      "low" | "mid" | "high"
	  Budget.scale()     particle / count multiplier (low 0.4, mid 0.7, high 1)
	  Budget.count(n)    max(1, round(n * scale)): emitter rates, burst sizes, caps
	  Budget.low()       shorthand for tier() == "low"
	  Budget.onChange(fn) runs fn(tier) whenever the tier changes; returns a disconnect

	Tier:
	  low   touch input with Automatic or <= 4 graphics quality, or a touch device
	        whose screen's shorter side is under 500 px (a phone)
	  mid   touch otherwise, or graphics quality <= 6
	  high  everything else (desktop / console at quality 7+ or Automatic)

	Re-evaluated when the input mode changes (Kit.onInput), when the player moves
	the graphics slider and when the viewport resizes. Every engine call is in a
	pcall so the Lune preview (stubbed engine) lands on "high". Kit is required
	lazily (deferred) because Kit itself requires Animator and Fx.Sprites, which
	use this module.
]]

local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

export type Tier = "low" | "mid" | "high"

local Budget = {}

local SCALE: { [Tier]: number } = { low = 0.4, mid = 0.7, high = 1 }
local PHONE_SIDE = 500 -- px: a touch screen whose shorter side is under this is a phone

local current: Tier = "high"
local listeners: { (Tier) -> () } = {}
local kit: any = nil

local function touchInput(): boolean
	if kit then
		return kit.touch == true
	end
	local ok, touch = pcall(function()
		return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end)
	return ok and touch == true
end

-- SavedQualityLevel as a number: 0 = Automatic, 1-10 = the slider; nil when unknown.
local function quality(): number?
	local ok, level = pcall(function()
		local settings = UserSettings():GetService("UserGameSettings")
		return settings.SavedQualityLevel.Value
	end)
	if ok and type(level) == "number" then
		return level
	end
	return nil
end

local function smallTouchScreen(): boolean
	local ok, small = pcall(function()
		if not UserInputService.TouchEnabled then
			return false
		end
		local camera = Workspace.CurrentCamera
		if not camera then
			return false
		end
		local size = camera.ViewportSize
		local side = math.min(size.X, size.Y)
		return side > 1 and side < PHONE_SIDE
	end)
	return ok and small == true
end

local function evaluate(): Tier
	local level = quality()
	local touch = touchInput()
	if touch and (level == 0 or (level ~= nil and level <= 4)) then
		return "low"
	end
	if smallTouchScreen() then
		return "low"
	end
	if touch or (level ~= nil and level >= 1 and level <= 6) then
		return "mid"
	end
	return "high"
end

local function refresh()
	local tier = evaluate()
	if tier == current then
		return
	end
	current = tier
	for _, fn in table.clone(listeners) do
		task.spawn(fn, tier)
	end
end

function Budget.tier(): Tier
	return current
end

function Budget.low(): boolean
	return current == "low"
end

function Budget.scale(): number
	return SCALE[current]
end

function Budget.count(n: number): number
	return math.max(1, math.floor(n * SCALE[current] + 0.5))
end

-- Runs fn(tier) on every change (not now); returns a disconnect function.
function Budget.onChange(fn: (Tier) -> ()): () -> ()
	table.insert(listeners, fn)
	return function()
		local i = table.find(listeners, fn)
		if i then
			table.remove(listeners, i)
		end
	end
end

current = evaluate()

pcall(function()
	local settings = UserSettings():GetService("UserGameSettings")
	settings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(refresh)
end)

local viewportConn: RBXScriptConnection? = nil
local function watchCamera()
	pcall(function()
		if viewportConn then
			viewportConn:Disconnect()
			viewportConn = nil
		end
		local camera = Workspace.CurrentCamera
		if camera then
			viewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
		end
		refresh()
	end)
end
watchCamera()
pcall(function()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
end)

-- Kit requires modules that require this one: hook its input mode once loading settles.
pcall(function()
	task.defer(function()
		pcall(function()
			local module = script.Parent.Parent:FindFirstChild("UI")
			module = module and module:FindFirstChild("Kit")
			if not module then
				return
			end
			kit = require(module :: any)
			kit.onInput(function()
				refresh()
			end)
		end)
	end)
end)

return Budget
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="220">
            <Properties>
              <string name="Name">Camera</string>
              <string name="Source"><![CDATA[--[[
	Fx.Camera: spawn framing, camera punch / shake and the pad signs' near lines.

	- On every spawn, whenever the character is teleported (e.g. Home) and when the intro
	  cutscene hands the camera back (CameraType returns to Custom), the Custom camera is
	  placed FRAME_DISTANCE studs behind the character's head, raised so it looks FRAME_PITCH
	  down the way the character faces. Spawning on a plot (facing the pen) that puts the pen
	  and the rack's lower shelves in the upper middle of the screen with the buy pads either
	  side. The follow camera keeps that angle; its zoom is set to FRAME_DISTANCE once.
	  Camera.spawnShot(root) returns the same eye / focus for other camera code.
	- Camera.punch(intensity): FOV kick plus a tiny shake (intensity ~0.2..1.5).
	- Camera.shake(intensity, duration): positional shake only (no rotation,
	  so the default camera scripts never drift).
	- Camera.reducedMotion = true turns punches/shakes into no-ops.
	- Pad sign near lines (SurfaceGuis tagged "PadSignNear" by World.Pads, attribute
	  NearDistance): faded in when the character is within NearDistance studs and out
	  past it, tweened, scanned every NEAR_SCAN seconds.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.Parent.State)

local Camera = {}

Camera.reducedMotion = false

local TELEPORT_DISTANCE = 12 -- studs moved in one frame that count as a teleport
local FRAME_DISTANCE = 15 -- studs from the camera to the character's head
local FRAME_PITCH = math.rad(20) -- how far the camera looks down
local HEAD_OFFSET = Vector3.new(0, 1.5, 0) -- the follow camera's focus above the root
local MAX_FOV_KICK = 9

local NEAR_TAG = "PadSignNear"
local NEAR_SCAN = 0.15
local NEAR_BAND = 4 -- studs over which a near line fades
local NEAR_TWEEN = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local fovKick = 0 -- current extra FOV (decays)
local baseFov: number? = nil -- FOV before the punch started
local shakeAmp = 0
local shakeUntil = 0
local shakeLength = 0
local started = false
local zoomBusy = false

local function reduced(): boolean
	if Camera.reducedMotion then
		return true
	end
	local data = State.data
	return data ~= nil and data.settings ~= nil and data.settings.reducedMotion == true
end

-- The spawn shot for `root`: the camera's eye and the focus it looks at (the character's
-- head), behind the character and looking FRAME_PITCH down the way it faces.
function Camera.spawnShot(root: BasePart): (Vector3?, Vector3?)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		return nil, nil
	end
	flat = flat.Unit
	local focus = root.Position + HEAD_OFFSET
	local back = flat * (FRAME_DISTANCE * math.cos(FRAME_PITCH))
	local up = Vector3.new(0, FRAME_DISTANCE * math.sin(FRAME_PITCH), 0)
	return focus - back + up, focus
end

-- Sets the follow camera's zoom to `distance` by pinning the player's zoom limits to it for
-- a frame (the camera scripts clamp their zoom to the limits), then restoring them.
local function setZoom(distance: number)
	local player = Players.LocalPlayer
	local lo, hi = player.CameraMinZoomDistance, player.CameraMaxZoomDistance
	if zoomBusy or distance < lo or distance > hi then
		return
	end
	zoomBusy = true
	task.spawn(function()
		player.CameraMaxZoomDistance = distance
		player.CameraMinZoomDistance = distance
		RunService.RenderStepped:Wait()
		RunService.RenderStepped:Wait()
		if player.CameraMinZoomDistance == distance then
			player.CameraMinZoomDistance = lo
		end
		if player.CameraMaxZoomDistance == distance then
			player.CameraMaxZoomDistance = hi
		end
		zoomBusy = false
	end)
end

-- Places the Custom camera on the spawn shot for `root`.
local function frameBehind(root: BasePart)
	local camera = Workspace.CurrentCamera
	if not camera or camera.CameraType ~= Enum.CameraType.Custom then
		return
	end
	local eye, focus = Camera.spawnShot(root)
	if not eye or not focus then
		return
	end
	camera.CFrame = CFrame.lookAt(eye, focus)
	setZoom(FRAME_DISTANCE)
end

local function onCharacter(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not root then
		return
	end
	-- Wait for the camera scripts to adopt the new humanoid, then frame once.
	local deadline = os.clock() + 2
	while os.clock() < deadline do
		local camera = Workspace.CurrentCamera
		local subject = camera and camera.CameraSubject
		if subject and subject:IsDescendantOf(character) then
			break
		end
		RunService.RenderStepped:Wait()
	end
	RunService.RenderStepped:Wait()
	frameBehind(root)
	-- Re-frame after teleports (Home button, plot changes).
	local last = root.Position
	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not root.Parent or character.Parent == nil then
			connection:Disconnect()
			return
		end
		local pos = root.Position
		if (pos - last).Magnitude > TELEPORT_DISTANCE then
			task.defer(function()
				RunService.RenderStepped:Wait()
				frameBehind(root)
			end)
		end
		last = pos
	end)
end

-- Re-frames when a scripted camera (the intro cutscene) hands back the follow camera, so
-- the first follow frame is the spawn shot.
local function watchCameraType(camera: Camera)
	local was = camera.CameraType
	camera:GetPropertyChangedSignal("CameraType"):Connect(function()
		local now = camera.CameraType
		if now == Enum.CameraType.Custom and was == Enum.CameraType.Scriptable then
			local character = Players.LocalPlayer.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				frameBehind(root)
			end
		end
		was = now
	end)
end

-- Pad sign near lines -------------------------------------------------------------------

type NearItem = { inst: Instance, prop: string, base: number }
type NearEntry = { part: BasePart, distance: number, items: { NearItem }, shown: number }
local nearEntries: { [SurfaceGui]: NearEntry } = {}

-- The faded properties of a near line's pill, label and strokes, each hidden to start with.
local function collectNear(gui: SurfaceGui): { NearItem }
	local items: { NearItem } = {}
	for _, inst in gui:GetDescendants() do
		if inst:IsA("TextLabel") and inst.Visible then
			table.insert(items, { inst = inst, prop = "TextTransparency", base = inst.TextTransparency })
		elseif inst:IsA("Frame") then
			table.insert(items, { inst = inst, prop = "BackgroundTransparency", base = inst.BackgroundTransparency })
		elseif inst:IsA("UIStroke") then
			table.insert(items, { inst = inst, prop = "Transparency", base = inst.Transparency })
		end
	end
	for _, item in items do
		(item.inst :: any)[item.prop] = 1
	end
	return items
end

local function addNear(gui: Instance)
	if not gui:IsA("SurfaceGui") or nearEntries[gui] then
		return
	end
	local part = gui.Parent
	if not part or not part:IsA("BasePart") then
		return
	end
	local distance = gui:GetAttribute("NearDistance")
	nearEntries[gui] = {
		part = part,
		distance = if type(distance) == "number" then distance else 20,
		-- Collected on the first scan, once the GUI's children have replicated.
		items = {},
		shown = 0,
	}
end

local function scanNear()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local from: Vector3? = if root and root:IsA("BasePart") then root.Position else nil
	for gui, entry in nearEntries do
		if not gui.Parent then
			nearEntries[gui] = nil
			continue
		end
		if #entry.items == 0 then
			entry.items = collectNear(gui)
			if #entry.items == 0 then
				continue
			end
		end
		local shown = 0
		if from then
			local d = (entry.part.Position - from).Magnitude
			shown = math.clamp((entry.distance - d) / NEAR_BAND, 0, 1)
		end
		if math.abs(shown - entry.shown) > 0.05 or (shown ~= entry.shown and (shown == 0 or shown == 1)) then
			entry.shown = shown
			for _, item in entry.items do
				local target = 1 - (1 - item.base) * shown
				TweenService:Create(item.inst, NEAR_TWEEN, { [item.prop] = target }):Play()
			end
		end
	end
end

-- FOV kick plus a small shake. Intensity ~0.2 (light) .. 1.5 (huge).
function Camera.punch(intensity: number?)
	if reduced() then
		return
	end
	local k = math.clamp(intensity or 1, 0, 2)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if not baseFov then
		baseFov = camera.FieldOfView
	end
	fovKick = math.min(MAX_FOV_KICK, fovKick + 5 * k)
	Camera.shake(0.18 * k, 0.25 + 0.1 * k)
end

-- Positional shake (studs) that fades out over `duration` seconds.
function Camera.shake(intensity: number?, duration: number?)
	if reduced() then
		return
	end
	local now = os.clock()
	local amp = math.clamp(intensity or 0.3, 0, 1.5)
	local length = math.max(duration or 0.3, 0.05)
	local remaining = if now < shakeUntil then shakeAmp * (shakeUntil - now) / shakeLength else 0
	shakeAmp = math.max(amp, remaining)
	shakeLength = length
	shakeUntil = now + length
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if baseFov then
		if fovKick > 0.01 then
			-- Fast spring back toward the base FOV.
			fovKick *= math.exp(-dt * 7)
			camera.FieldOfView = baseFov + fovKick
		else
			camera.FieldOfView = baseFov
			baseFov = nil
			fovKick = 0
		end
	end
	local now = os.clock()
	if now < shakeUntil then
		local fade = (shakeUntil - now) / shakeLength
		local a = shakeAmp * fade * fade
		local t = now * 38
		local offset = Vector3.new(math.noise(t, 1.3) * a, math.noise(t, 7.1) * a, math.noise(t, 13.7) * a) * 2
		camera.CFrame += offset
	end
end

function Camera.init()
	if started then
		return
	end
	started = true
	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService:BindToRenderStep("FxCamera", Enum.RenderPriority.Camera.Value + 1, step)
	if Workspace.CurrentCamera then
		watchCameraType(Workspace.CurrentCamera)
	end
	CollectionService:GetInstanceAddedSignal(NEAR_TAG):Connect(addNear)
	for _, gui in CollectionService:GetTagged(NEAR_TAG) do
		addNear(gui)
	end
	task.spawn(function()
		while true do
			task.wait(NEAR_SCAN)
			scanNear()
		end
	end)
end

return Camera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="221">
            <Properties>
              <string name="Name">Cardio</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.Cardio: the 3D side of CARDIO, the keyboard runner (UI.CardioHud draws the screen).
	Runs only while the local player is in a run (snapshot modes.cardio.running or a
	"start" Notify); everything is restored on "stop" / "finish".

	  Key presses   the floor is ~12,000 keycap MeshParts (tag "CardioKey", attrs Letter, Stage,
	                Index, Kind "space" for spacebars; the letter is baked into the mesh).
	                Keys never collide: an invisible slab per surface (CardioTrack/Colliders)
	                sits the CardioTrack folder's PressDepth attribute below the key tops.
	                Keys are indexed once into a KeyPitch grid hash, so the key under a foot is
	                one bucket lookup, never a scan. The key under the local player and the
	                nearest other players (Budget.count(6) within 90 studs) sinks exactly
	                PressDepth (onto the slab, so feet rest on the pressed key), stays down
	                while a foot is on it, then springs back with a small Back overshoot
	                (one BulkMoveTo per frame, rest CFrames cached); nothing glows. Sliding keys (tag "ModeMover")
	                belong to Fx.Modes and never move here. Blinking keys (tag
	                "CardioBlinkKey", attrs BlinkOn / BlinkPeriod / BlinkPhase) fade here in
	                sync with their platform's slab (a "BlinkPad" Fx.Modes toggles): faded
	                while ((t + phase) % period) >= on, flashing in the last BLINK_WARN s.
	  Step pops     the "CardioSteps" effect (gained) floats a purple "+N" with the Speedy
	                Sneakers icon up off the character (a pool of POP_POOL BillboardGuis);
	                on a treadmill an "x{multiplier} SPEED" tag rides above the head.
	  Treadmills    the Texture(s) on each "Belt" (inside models tagged "CardioTreadmill")
	                scroll backwards under the runner (OffsetStudsV); the belt under the
	                local player scrolls at their WalkSpeed. While standing on a belt the
	                character turns to the belt's LookVector and plays its own run
	                animation in place (Animate.run.RunAnim) at WalkSpeed / 16 speed, with dust puffs and the odd sweat drop.
	  Speed         radial speed lines (a pooled ScreenGui under the HUD) and a gentle FOV
	                kick, both scaling with the horizontal speed above ~50 studs/s; reduced
	                motion skips the FOV and halves the lines.
	  Bursts        safe zone reached: stars and confetti; WIN pad claimed: a bigger ring of
	                both (largest on the last pad); fall: a landing ring + puff,
	                upgrade: sparkles over the upgrade pad (Fx.Sprites, budgeted).
	  Doors         timed exit doors (parts tagged "CardioDoor", attrs DoorOpen, DoorPeriod,
	                DoorPhase: open while ((t + phase) % period) < open, t = server time) drive
	                the TextLabel "Countdown" on their sign (searched in the door's parent):
	                green "GO! 2.1" (seconds left open) / red "1.34" (seconds until it opens),
	                DOOR_RATE times a second, only within DOOR_RADIUS studs of the camera.
	  Sound         Sounds.play("KeyClick") each time the local player's foot
	                lands on a new key, at most CLICK_RATE per second (Sounds has no volume
	                control, so other players' steps stay silent).
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Client = script.Parent.Parent
local State = require(Client.State) :: any
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)
local Sounds = require(Client.Sounds) :: any
local Assets = require(ReplicatedStorage.Shared.Assets) :: any

local CardioFx = {}

local player = Players.LocalPlayer
local W = Theme.World
local C = Theme.Colors

local KEY_TAG = "CardioKey"
local TREADMILL_TAG = "CardioTreadmill"
local PAD_TAG = "CardioUpgradePad"

local PRESS_DEFAULT = 1 -- studs a pressed key sinks when the track has no PressDepth attribute
local BLINK_TAG = "CardioBlinkKey"
local BLINK_WARN = 0.5 -- seconds of warning flashes before a blinking key fades (as Fx.Modes)
local BLINK_FLASH_HZ = 6
local BLINK_DIM = 0.4 -- key transparency on a warning flash frame
local BLINK_OFF = 0.75 -- ... while its platform is off
local BLINK_RADIUS = 250 -- studs from the camera
local DOOR_TAG = "CardioDoor"
local DOOR_RATE = 10 -- countdown label updates per second
local DOOR_RADIUS = 250 -- studs from the camera
local DOOR_RETRY = 2 -- seconds between searches for a door's missing Countdown label
local DOOR_GO = Color3.fromRGB(70, 235, 110)
local DOOR_WAIT = Color3.fromRGB(255, 60, 60)
local PRESS_UP = 0.18 -- seconds to spring back (after the last foot leaves it)
local BUCKET_DEFAULT = 2.8 -- studs per spatial-hash cell without the track's KeyPitch (one keycap)
local OTHER_RADIUS = 90 -- other players' presses within this many studs
local OTHER_MAX = 6 -- at most this many other players (scaled by Budget.count)
local LINE_COUNT = 28
local LINES_FROM = 50 -- studs/s: speed lines and FOV start above this
local LINES_FULL = 110 -- studs/s: full effect
local FOV_MAX = 12
local CLICK_RATE = 12 -- local key clicks per second at most
local POP_POOL = 8
local POP_LIFE = 0.9
local POP_COLOR = Color3.fromRGB(176, 92, 255)
local SNEAKER_COLOR = Color3.fromRGB(255, 70, 80)
local BELT_SPEED = 6 -- studs/s for treadmills nobody local is on
local RUN_ANIM_MAX = 4 -- fastest run-in-place playback (x the 16 studs/s pace)
local TAU = math.pi * 2

local RAINBOW: { Color3 } = {
	W.Pink or Color3.fromRGB(255, 138, 190),
	W.Orange or Color3.fromRGB(255, 170, 70),
	W.Sunny or Color3.fromRGB(255, 220, 80),
	W.Mint or Color3.fromRGB(98, 224, 160),
	W.Blue or Color3.fromRGB(90, 170, 255),
	W.Grape or Color3.fromRGB(170, 132, 255),
}
local WHITE = Color3.new(1, 1, 1)
local INK: Color3 = C.Ink or Color3.fromRGB(30, 34, 60)

export type Key = {
	part: BasePart,
	parts: { BasePart },
	rest: { CFrame },
	frame: CFrame, -- the key part's rest CFrame
	hx: number,
	hz: number,
	top: number,
	fixed: boolean, -- blink / mover keys: never moved here
	cells: { number },
}

type Treadmill = { model: Instance, belt: BasePart, textures: { Texture }, dir: number, phase: number }
type Line = { frame: Frame, angle: number, r: number, speed: number }

local keys: { [BasePart]: Key } = {}
-- Grid cell size (studs): the track's KeyPitch, read when the keys are indexed.
local bucket = BUCKET_DEFAULT
local buckets: { [number]: { Key } } = {}
local pressed: { [Key]: number } = {}
-- Studs each pressed key sinks (the track's PressDepth when it was pressed).
local pressShare: { [Key]: number } = {}
type Door = { part: BasePart, label: TextLabel?, lookedAt: number, scaled: boolean? }
local doors: { [BasePart]: Door } = {}
local doorAt = 0
local treadmills: { [Instance]: Treadmill } = {}
local lines: { Line } = {}
local otherLast: { [Player]: Key? } = {}

local active = false
local startedAt = 0
local snap: { [string]: any } = {}
local stepConn: RBXScriptConnection? = nil
local folder: Folder? = nil
local linesGui: ScreenGui? = nil
local lastClick = 0
local localKey: Key? = nil
-- Keys under other players' feet this frame (kept pressed down).
local heldOther: { Key } = {}
local speedK = 0
local fovBase: number? = nil
local runTrack: AnimationTrack? = nil
local runTrackOwner: Humanoid? = nil
local puffAt = 0
local sweatAt = 0
local indexed = false

-- Reused per-frame buffers (no allocations in the hot path beyond CFrames).
local moveParts: { BasePart } = {}
local moveFrames: { CFrame } = {}

local function num(value: any, default: number): number
	return if type(value) == "number" and value == value then value else default
end

local function cellId(bx: number, bz: number): number
	return (bx + 4096) * 8192 + (bz + 4096)
end

local function reducedMotion(): boolean
	local data = State.data
	return type(data) == "table" and type(data.settings) == "table" and data.settings.reducedMotion == true
end

local function character(): (Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

local function feetY(humanoid: Humanoid, root: BasePart): number
	local legs = if humanoid.RigType == Enum.HumanoidRigType.R6 then 2 else humanoid.HipHeight
	return root.Position.Y - root.Size.Y / 2 - legs
end

local function fxFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local made = Instance.new("Folder")
	made.Name = "CardioFx"
	made.Parent = Workspace
	folder = made
	return made
end

-- Key index -----------------------------------------------------------------------------------

local function tagged(inst: Instance, tag: string): boolean
	return CollectionService:HasTag(inst, tag) or (inst.Parent ~= nil and CollectionService:HasTag(inst.Parent :: Instance, tag))
end

local function addKey(inst: Instance)
	if not inst:IsA("BasePart") or keys[inst] then
		return
	end
	local part = inst :: BasePart
	local mover = tagged(part, "ModeMover") or part:GetAttribute("Mover") ~= nil
	local parts: { BasePart } = { part }
	local rest: { CFrame } = { part.CFrame }
	for _, d in part:GetDescendants() do
		if d:IsA("BasePart") and d.Anchored then
			table.insert(parts, d)
			table.insert(rest, d.CFrame)
		end
	end
	local key: Key = {
		part = part,
		parts = parts,
		rest = rest,
		frame = part.CFrame,
		hx = part.Size.X / 2,
		hz = part.Size.Z / 2,
		top = part.Position.Y + part.Size.Y / 2,
		fixed = mover,
		cells = {},
	}
	keys[part] = key
	-- Every cell the key's footprint covers (wide keys span several).
	local reach = math.max(key.hx, key.hz) + 0.5
	local p = part.Position
	for bx = math.floor((p.X - reach) / bucket), math.floor((p.X + reach) / bucket) do
		for bz = math.floor((p.Z - reach) / bucket), math.floor((p.Z + reach) / bucket) do
			local id = cellId(bx, bz)
			local list = buckets[id]
			if not list then
				list = {}
				buckets[id] = list
			end
			table.insert(list, key)
			table.insert(key.cells, id)
		end
	end
end

local function restore(key: Key)
	if key.part.Parent then
		Workspace:BulkMoveTo(key.parts, key.rest, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function removeKey(inst: Instance)
	local key = keys[inst :: BasePart]
	if not key then
		return
	end
	keys[inst :: BasePart] = nil
	pressed[key] = nil
	pressShare[key] = nil
	for _, id in key.cells do
		local list = buckets[id]
		if list then
			local i = table.find(list, key)
			if i then
				table.remove(list, i)
			end
		end
	end
	if localKey == key then
		localKey = nil
	end
end

local function indexKeys()
	if indexed then
		return
	end
	indexed = true
	local track = Workspace:FindFirstChild("CardioTrack")
	bucket = math.max(num(track and track:GetAttribute("KeyPitch"), BUCKET_DEFAULT), 0.5)
	for _, inst in CollectionService:GetTagged(KEY_TAG) do
		addKey(inst)
	end
	CollectionService:GetInstanceAddedSignal(KEY_TAG):Connect(addKey)
	CollectionService:GetInstanceRemovedSignal(KEY_TAG):Connect(removeKey)
end

-- The key whose cap is under (x, z) with the feet at `feet` (nil when airborne / off keys).
local function keyAt(pos: Vector3, feet: number, below: number, above: number): Key?
	local list = buckets[cellId(math.floor(pos.X / bucket), math.floor(pos.Z / bucket))]
	if not list then
		return nil
	end
	for _, key in list do
		local rise = feet - key.top
		if rise >= below and rise <= above then
			local lp = key.frame:PointToObjectSpace(pos)
			if math.abs(lp.X) <= key.hx + 0.3 and math.abs(lp.Z) <= key.hz + 0.3 then
				return key
			end
		end
	end
	return nil
end

-- Presses -------------------------------------------------------------------------------------

local function click(_key: Key)
	local now = os.clock()
	if now - lastClick < 1 / CLICK_RATE then
		return
	end
	lastClick = now
	Sounds.play("KeyClick", 0.08)
end

-- Studs a pressed key sinks: the track's PressDepth (its collision slabs sit that far below
-- the key tops), the same at every WalkSpeed.
local function pressTravel(): number
	local track = Workspace:FindFirstChild("CardioTrack")
	return num(track and track:GetAttribute("PressDepth"), PRESS_DEFAULT)
end

local function press(key: Key, mine: boolean, _walk: number)
	if mine then
		click(key)
	end
	if key.fixed then
		return
	end
	pressed[key] = os.clock()
	pressShare[key] = pressTravel()
end

-- Depth `elapsed` seconds after the last foot left: fully down (the feet already stand on the
-- slab at that level, so there is no sink animation), then the spring back.
local function pressDepth(elapsed: number, travel: number): number?
	local u = elapsed / PRESS_UP
	if u >= 1 then
		return nil
	end
	-- Back-out return: a little pop above the rest height before settling.
	local s = 1.4
	local v = u - 1
	local back = 1 + (s + 1) * v * v * v + s * v * v
	return travel * (1 - back)
end

local function stepKeys(now: number)
	table.clear(moveParts)
	table.clear(moveFrames)
	for key, t0 in pressed do
		-- Held fully down while a foot is still on it; the return starts on release.
		if key == localKey or table.find(heldOther, key) then
			t0 = now
			pressed[key] = t0
		end
		local depth = pressDepth(now - t0, pressShare[key] or PRESS_DEFAULT)
		if depth == nil then
			pressed[key] = nil
			pressShare[key] = nil
			depth = 0
		end
		if key.part.Parent then
			local offset = Vector3.new(0, -(depth :: number), 0)
			for i, part in key.parts do
				table.insert(moveParts, part)
				table.insert(moveFrames, key.rest[i] + offset)
			end
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function stepPlayers(humanoid: Humanoid?, root: BasePart?)
	-- Local player: a new key under the feet while on the ground.
	if humanoid and root then
		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		local key = if grounded then keyAt(root.Position, feetY(humanoid, root), -2, 1.6) else nil
		if key and key ~= localKey then
			press(key, true, humanoid.WalkSpeed)
		end
		localKey = key
	end
	-- Other players nearby (budgeted, nearest first is not needed: the cap is small).
	table.clear(heldOther)
	local cap = Budget.count(OTHER_MAX)
	local done = 0
	local from = if root then root.Position else nil
	for _, other in Players:GetPlayers() do
		if other ~= player and done < cap then
			local char = other.Character
			local oRoot = char and char:FindFirstChild("HumanoidRootPart")
			local oHum = char and char:FindFirstChildOfClass("Humanoid")
			if oRoot and oRoot:IsA("BasePart") and oHum and from and (oRoot.Position - from).Magnitude <= OTHER_RADIUS then
				done += 1
				local key = keyAt(oRoot.Position, feetY(oHum, oRoot), -2, 1.2)
				if key and key ~= otherLast[other] then
					press(key, false, oHum.WalkSpeed)
				end
				otherLast[other] = key
				if key then
					table.insert(heldOther, key)
				end
			else
				otherLast[other] = nil
			end
		end
	end
end

-- Treadmills ----------------------------------------------------------------------------------

local function addTreadmill(model: Instance)
	if treadmills[model] then
		return
	end
	local belt = if model:IsA("BasePart") and model.Name == "Belt" then model else model:FindFirstChild("Belt", true)
	if not belt or not belt:IsA("BasePart") then
		-- Streaming may deliver the belt later.
		task.delay(2, function()
			if model.Parent and not treadmills[model] and CollectionService:HasTag(model, TREADMILL_TAG) then
				local late = model:FindFirstChild("Belt", true)
				if late and late:IsA("BasePart") then
					addTreadmill(model)
				end
			end
		end)
		return
	end
	local textures: { Texture } = {}
	for _, d in belt:GetChildren() do
		if d:IsA("Texture") then
			table.insert(textures, d)
		end
	end
	treadmills[model] = {
		model = model,
		belt = belt :: BasePart,
		textures = textures,
		dir = num(belt:GetAttribute("BeltDir"), num(model:GetAttribute("BeltDir"), 1)),
		phase = 0,
	}
end

local function removeTreadmill(model: Instance)
	treadmills[model] = nil
end

-- The treadmill whose belt the local player stands on, if any.
local function beltUnder(humanoid: Humanoid, root: BasePart): Treadmill?
	local feet = feetY(humanoid, root)
	for _, t in treadmills do
		local belt = t.belt
		if belt.Parent then
			local lp = belt.CFrame:PointToObjectSpace(root.Position)
			local half = belt.Size / 2
			local top = belt.Position.Y + half.Y
			local rise = feet - top
			if math.abs(lp.X) <= half.X + 0.5 and math.abs(lp.Z) <= half.Z + 0.5 and rise > -1.2 and rise < 2.5 then
				return t
			end
		end
	end
	return nil
end

local function runAnimation(humanoid: Humanoid): AnimationTrack?
	if runTrack and runTrackOwner == humanoid then
		return runTrack
	end
	runTrack, runTrackOwner = nil, nil
	local animator = humanoid:FindFirstChildOfClass("Animator")
	local char = humanoid.Parent
	if not animator or not char then
		return nil
	end
	local animate = char:FindFirstChild("Animate")
	local run = animate and animate:FindFirstChild("run")
	local source = run and run:FindFirstChildOfClass("Animation")
	local id = if source then source.AnimationId else ""
	if id == "" then
		id = if humanoid.RigType == Enum.HumanoidRigType.R6 then "rbxassetid://180426354" else "rbxassetid://913376220"
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if not ok or not track then
		return nil
	end
	track.Priority = Enum.AnimationPriority.Movement
	track.Looped = true
	runTrack, runTrackOwner = track, humanoid
	return track
end

local function stopRun()
	local track = runTrack
	if track and track.IsPlaying then
		track:Stop(0.2)
	end
end

local function anchorAt(position: Vector3, life: number): BasePart
	local part = Instance.new("Part")
	part.Name = "CardioFxAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.CFrame = CFrame.new(position)
	part.Parent = fxFolder()
	task.delay(life, function()
		part:Destroy()
	end)
	return part
end

local function stepTreadmills(dt: number, now: number, humanoid: Humanoid?, root: BasePart?)
	local on: Treadmill? = nil
	if humanoid and root then
		on = beltUnder(humanoid, root)
	end
	local camera = Workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else Vector3.zero
	-- The belt under you scrolls at your own WalkSpeed, so faster runners visibly run faster.
	local walk = if humanoid then math.max(humanoid.WalkSpeed, BELT_SPEED) else BELT_SPEED
	for _, t in treadmills do
		if #t.textures > 0 and t.belt.Parent and (t.belt.Position - eye).Magnitude < 180 then
			local speed = if t == on then walk else BELT_SPEED
			t.phase += dt * speed * t.dir
			for _, texture in t.textures do
				local tile = math.max(texture.StudsPerTileV, 0.1)
				texture.OffsetStudsV = t.phase % tile
			end
		end
	end
	if not (humanoid and root) then
		stopRun()
		return
	end
	local h = humanoid :: Humanoid
	local r = root :: BasePart
	local idle = h.MoveDirection.Magnitude < 0.2 and h.FloorMaterial ~= Enum.Material.Air
	if on and idle then
		local track = runAnimation(h)
		if track then
			if not track.IsPlaying then
				track:Play(0.2)
			end
			-- The run cycle is paced for 16 studs/s (as Animate does): match the WalkSpeed.
			track:AdjustSpeed(math.clamp(walk / 16, 1, RUN_ANIM_MAX))
		end
		-- Turn to face along the belt.
		local fwd = on.belt.CFrame.LookVector
		local flat = Vector3.new(fwd.X, 0, fwd.Z)
		if flat.Magnitude > 0.1 then
			local look = r.CFrame.LookVector
			local want = flat.Unit
			if look:Dot(want) < 0.999 then
				local goal = CFrame.lookAt(r.Position, r.Position + want)
				r.CFrame = r.CFrame:Lerp(goal, math.min(1, dt * 8))
			end
		end
		-- Dust puffs behind the feet and the odd sweat drop.
		if now - puffAt > (if Budget.low() then 0.7 else 0.35) and Sprites.room() then
			puffAt = now
			local feet = Vector3.new(r.Position.X, feetY(h, r) + 0.4, r.Position.Z) - flat.Unit * 2
			local anchor = anchorAt(feet, 1.5)
			Sprites.billboard(anchor, "Puff", {
				position = feet,
				size = 1.6,
				life = 0.7,
				rise = Vector3.new(0, 1.2, 0) - flat.Unit * 2.5,
				color = Color3.fromRGB(235, 240, 255),
			})
		end
		if now - sweatAt > 1.3 and Sprites.room() then
			sweatAt = now
			local head = r.Position + Vector3.new((math.random() - 0.5) * 1.5, 2.6, 0)
			local anchor = anchorAt(head, 1.5)
			Sprites.billboard(anchor, "Sweat", {
				position = head,
				size = 0.9,
				life = 0.8,
				rise = Vector3.new((math.random() - 0.5) * 2, -1.6, 0),
			})
		end
	else
		stopRun()
	end
end

-- Speed lines and FOV -------------------------------------------------------------------------

local function resetLine(line: Line, fresh: boolean)
	line.angle = math.random() * TAU
	line.r = if fresh then 0.3 + math.random() * 0.8 else 0.35 + math.random() * 0.25
	line.speed = 1.6 + math.random() * 1.4
	line.frame.Rotation = math.deg(line.angle)
end

local function ensureLines()
	if linesGui and linesGui.Parent then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "CardioSpeedLines"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = -1
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	linesGui = gui
	table.clear(lines)
	for _ = 1, Budget.count(LINE_COUNT) do
		local frame = Instance.new("Frame")
		frame.Name = "Line"
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = WHITE
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.BackgroundTransparency = 1
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 0.2),
			NumberSequenceKeypoint.new(1, 0.9),
		})
		gradient.Parent = frame
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = frame
		frame.Parent = gui
		local line: Line = { frame = frame, angle = 0, r = 0, speed = 1 }
		resetLine(line, true)
		table.insert(lines, line)
	end
end

local function applyFov(delta: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if delta > 0.01 then
		if not fovBase then
			fovBase = camera.FieldOfView
		end
		camera.FieldOfView = (fovBase :: number) + delta
	elseif fovBase then
		camera.FieldOfView = fovBase :: number
		fovBase = nil
	end
end

local function stepSpeed(dt: number, root: BasePart?)
	local hv = 0
	if root then
		local v = root.AssemblyLinearVelocity
		hv = Vector3.new(v.X, 0, v.Z).Magnitude
	end
	local goal = math.clamp((hv - LINES_FROM) / (LINES_FULL - LINES_FROM), 0, 1)
	speedK += (goal - speedK) * math.min(1, dt * 4)
	if speedK < 0.005 then
		speedK = 0
	end
	local reduced = reducedMotion()
	applyFov(if reduced then 0 else FOV_MAX * speedK)
	if speedK <= 0 then
		if linesGui then
			linesGui.Enabled = false
		end
		return
	end
	ensureLines()
	local gui = linesGui :: ScreenGui
	gui.Enabled = true
	local camera = Workspace.CurrentCamera
	local view = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local centre = view / 2
	local reach = centre.Magnitude
	local strength = speedK * (if reduced then 0.5 else 1)
	for _, line in lines do
		line.r += dt * line.speed * (0.6 + strength)
		if line.r > 1.15 then
			resetLine(line, false)
		end
		local dir = Vector2.new(math.cos(line.angle), math.sin(line.angle))
		local pos = centre + dir * line.r * reach
		local len = (40 + 140 * strength) * (0.5 + line.r)
		line.frame.Position = UDim2.fromOffset(pos.X, pos.Y)
		line.frame.Size = UDim2.fromOffset(len, 2 + 2 * strength)
		-- Fade in from the centre, strongest near the edges.
		local edge = math.clamp((line.r - 0.35) / 0.4, 0, 1)
		line.frame.BackgroundTransparency = 1 - 0.55 * strength * edge
	end
end

-- Bursts --------------------------------------------------------------------------------------

local function burst(position: Vector3, count: number, spread: number, big: boolean)
	local anchor = anchorAt(position, 3)
	Sprites.billboard(anchor, "StarPop", {
		position = position + Vector3.new(0, 2, 0),
		size = if big then 4 else 2.6,
		life = 1,
		rise = Vector3.new(0, 3, 0),
		spin = 60,
	})
	local n = Budget.count(count)
	for i = 1, n do
		if not Sprites.room() then
			break -- decorative: the device's sprite budget is full
		end
		local a = i / n * TAU
		local star = big and i % 3 == 0
		Sprites.billboard(anchor, if star then "StarPop" else "Confetti", {
			position = position + Vector3.new(0, 2, 0),
			size = if star then 1.8 else 1,
			life = 1.4,
			delay = 0.025 * i,
			rise = Vector3.new(math.cos(a) * spread, 5 + (i % 3), math.sin(a) * spread),
			color = if star then nil else RAINBOW[(i % #RAINBOW) + 1],
			spin = 220,
		})
	end
end

local function sparkle(position: Vector3, count: number, color: Color3)
	local anchor = anchorAt(position, 3)
	local n = Budget.count(count)
	for i = 1, n do
		if not Sprites.room() then
			break
		end
		local a = i / n * TAU
		Sprites.billboard(anchor, "Sparkle", {
			position = position,
			size = 1.2,
			life = 0.8,
			delay = 0.03 * i,
			rise = Vector3.new(math.cos(a) * 3, 3, math.sin(a) * 3),
			color = color,
			spin = 90,
		})
	end
end

local function playerPos(): Vector3?
	local _, root = character()
	return if root then root.Position else nil
end

-- Step pops ------------------------------------------------------------------------------------

type Pop = { gui: BillboardGui, text: TextLabel, icon: GuiObject, scale: UIScale, token: number }

local pops: { Pop } = {}
local popIndex = 0
local popFolder: Folder? = nil
local speedTag: BillboardGui? = nil
local speedTagText: TextLabel? = nil

local function guiFolder(): Folder
	local f = popFolder
	if f and f.Parent then
		return f
	end
	local made = Instance.new("Folder")
	made.Name = "CardioPops"
	made.Parent = player:WaitForChild("PlayerGui")
	popFolder = made
	table.clear(pops)
	speedTag = nil
	return made
end

local function outlined(parent: Instance, size: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextSize = size
	label.TextColor3 = color
	label.Text = ""
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, size + 4)
	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = math.max(2, size / 10)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- The Speedy Sneakers icon (atlas "CosSpeed"), or a text glyph when the atlas is missing.
local function sneaker(parent: Instance, size: number): GuiObject
	local cell = Assets.icon and Assets.icon("CosSpeed")
	if type(cell) == "table" and type(cell.image) == "string" then
		local image = Instance.new("ImageLabel")
		image.Name = "Sneaker"
		image.BackgroundTransparency = 1
		image.Image = cell.image
		image.ImageRectOffset = Vector2.new(num(cell.x, 0), num(cell.y, 0))
		image.ImageRectSize = Vector2.new(num(cell.w, 0), num(cell.h, 0))
		image.ScaleType = Enum.ScaleType.Fit
		image.Size = UDim2.fromOffset(size, size)
		image.Parent = parent
		return image
	end
	local glyph = outlined(parent, size - 4, SNEAKER_COLOR)
	glyph.Name = "Sneaker"
	glyph.Text = utf8.char(0x1F45F)
	return glyph
end

local function makePop(): Pop
	local gui = Instance.new("BillboardGui")
	gui.Name = "StepPop"
	gui.Size = UDim2.fromOffset(170, 44)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.ResetOnSpawn = false
	gui.Enabled = false
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromScale(1, 1)
	row.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = row
	local icon = sneaker(row, 34)
	icon.LayoutOrder = 1
	local text = outlined(row, 32, POP_COLOR)
	text.Name = "Amount"
	text.LayoutOrder = 2
	local scale = Instance.new("UIScale")
	scale.Parent = row
	gui.Parent = guiFolder()
	return { gui = gui, text = text, icon = icon, scale = scale, token = 0 }
end

local function hidePops()
	for _, pop in pops do
		pop.token += 1
		pop.gui.Enabled = false
		(pop.gui :: any).Adornee = nil
	end
	if speedTag then
		speedTag.Enabled = false
	end
end

local function popStep(gained: number)
	local _, root = character()
	if not root then
		return
	end
	guiFolder()
	if #pops < Budget.count(POP_POOL) then
		table.insert(pops, makePop())
	end
	popIndex = popIndex % #pops + 1
	local pop = pops[popIndex]
	pop.token += 1
	local mine = pop.token
	local whole = math.max(1, math.floor(gained + 0.5))
	pop.text.Text = "+" .. (if whole < 1e4 then tostring(whole) else string.format("%.1fK", whole / 1000))
	pop.text.TextTransparency = 0
	local start = Vector3.new((math.random() - 0.5) * 3, 1.6 + math.random() * 0.8, (math.random() - 0.5) * 1.5)
	pop.gui.StudsOffsetWorldSpace = start
	pop.gui.Adornee = root
	pop.gui.Enabled = true
	pop.scale.Scale = 0.3
	local big = whole >= 10
	TweenService:Create(pop.scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = if big then 1.2 else 1 })
		:Play()
	TweenService:Create(pop.gui, TweenInfo.new(POP_LIFE, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffsetWorldSpace = start + Vector3.new(0, 3.2, 0),
	}):Play()
	local fade = TweenInfo.new(POP_LIFE * 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, POP_LIFE * 0.55)
	TweenService:Create(pop.text, fade, { TextTransparency = 1 }):Play()
	local stroke = pop.text:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
		TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
	end
	if pop.icon:IsA("ImageLabel") then
		pop.icon.ImageTransparency = 0
		TweenService:Create(pop.icon, fade, { ImageTransparency = 1 }):Play()
	elseif pop.icon:IsA("TextLabel") then
		pop.icon.TextTransparency = 0
		TweenService:Create(pop.icon, fade, { TextTransparency = 1 }):Play()
	end
	task.delay(POP_LIFE + 0.05, function()
		if pop.token == mine then
			pop.gui.Enabled = false
		end
	end)
end

local function multText(m: number): string
	return if m == math.floor(m) then tostring(m) else string.format("%.2f", m):gsub("0$", "")
end

-- "x{multiplier} SPEED" above the head while on a treadmill.
local function paintSpeedTag(on: boolean)
	local _, root = character()
	if not on or not root then
		if speedTag then
			speedTag.Enabled = false
		end
		return
	end
	local folder = guiFolder()
	local tag = speedTag
	if not tag then
		local gui = Instance.new("BillboardGui")
		gui.Name = "TreadmillSpeed"
		gui.Size = UDim2.fromOffset(200, 40)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 4.6, 0)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 120
		gui.ResetOnSpawn = false
		local text = outlined(gui, 30, Color3.fromRGB(255, 226, 92))
		text.AutomaticSize = Enum.AutomaticSize.None
		text.Size = UDim2.fromScale(1, 1)
		gui.Parent = folder
		speedTag, speedTagText = gui, text
		tag = gui
	end
	local gui = tag :: BillboardGui
	local m = num(snap.treadmillMult, num(snap.multiplier, 1))
	local label = speedTagText :: TextLabel
	label.Text = "x" .. multText(m) .. " SPEED"
	gui.Adornee = root
	gui.Enabled = true
end

function CardioFx.onSteps(data: any)
	if not active or type(data) ~= "table" then
		return
	end
	if type(data.treadmill) == "boolean" then
		snap.onTreadmill = data.treadmill
	end
	paintSpeedTag(snap.onTreadmill == true)
	local gained = num(data.gained, 0)
	if gained > 0 then
		popStep(gained)
	end
end

-- Activation ----------------------------------------------------------------------------------

local function restoreAll()
	for key in pressed do
		restore(key)
	end
	table.clear(pressed)
	table.clear(pressShare)
	hidePops()
	localKey = nil
	table.clear(otherLast)
end

-- Doors --------------------------------------------------------------------------------------

local function addDoor(inst: Instance)
	if inst:IsA("BasePart") then
		doors[inst] = { part = inst, label = nil, lookedAt = -math.huge }
	end
end

local function removeDoor(inst: Instance)
	doors[inst :: BasePart] = nil
end

-- The door's sign label: "Countdown" inside the door, else inside its parent model.
local function doorLabel(door: Door, now: number): TextLabel?
	local label = door.label
	if label and label.Parent then
		return label
	end
	door.label = nil
	if now - door.lookedAt < DOOR_RETRY then
		return nil
	end
	door.lookedAt = now
	local found = door.part:FindFirstChild("Countdown", true)
	local parent = door.part.Parent
	if not (found and found:IsA("TextLabel")) and parent and parent ~= Workspace then
		found = parent:FindFirstChild("Countdown", true)
	end
	if found and found:IsA("TextLabel") then
		door.label = found
		return found
	end
	return nil
end

-- Blinking keys --------------------------------------------------------------------------------

type BlinkKey = { part: BasePart, rest: number, on: number, period: number, phase: number, state: string }
local blinkKeys: { [BasePart]: BlinkKey } = {}

local function addBlinkKey(inst: Instance)
	if inst:IsA("BasePart") and not blinkKeys[inst] then
		blinkKeys[inst] = {
			part = inst,
			rest = inst.Transparency,
			on = num(inst:GetAttribute("BlinkOn"), 2),
			period = math.max(num(inst:GetAttribute("BlinkPeriod"), 3), 0.2),
			phase = num(inst:GetAttribute("BlinkPhase"), 0),
			state = "",
		}
	end
end

local function setBlinkKey(b: BlinkKey, state: string)
	if b.state == state then
		return
	end
	b.state = state
	b.part.Transparency = if state == "off" then BLINK_OFF elseif state == "dim" then math.max(b.rest, BLINK_DIM) else b.rest
end

-- Same formula as Fx.Modes' blink pads (the platform's slab): off while
-- ((t + phase) % period) >= on, a flash frame every 1 / (2 BLINK_FLASH_HZ) s in the last BLINK_WARN s.
local function stepBlinkKeys()
	local camera = Workspace.CurrentCamera
	if not camera or next(blinkKeys) == nil then
		return
	end
	local eye = camera.CFrame.Position
	local t = Workspace:GetServerTimeNow()
	for part, b in blinkKeys do
		if not part.Parent then
			blinkKeys[part] = nil
		elseif (part.Position - eye).Magnitude <= BLINK_RADIUS then
			local into = (t + b.phase) % b.period
			local state = "on"
			if into >= b.on then
				state = "off"
			else
				local left = b.on - into
				if left < BLINK_WARN and math.floor(left * BLINK_FLASH_HZ * 2) % 2 == 0 then
					state = "dim"
				end
			end
			setBlinkKey(b, state)
		end
	end
end

local function stepDoors(now: number)
	if now - doorAt < 1 / DOOR_RATE then
		return
	end
	doorAt = now
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local eye = camera.CFrame.Position
	local t = Workspace:GetServerTimeNow()
	for part, door in doors do
		if part.Parent and (part.Position - eye).Magnitude <= DOOR_RADIUS then
			local label = doorLabel(door, now)
			if label then
				local open = num(part:GetAttribute("DoorOpen"), 0)
				local period = num(part:GetAttribute("DoorPeriod"), 0)
				local phase = num(part:GetAttribute("DoorPhase"), 0)
				local text, color
				local closed = false
				if period <= 0 or open >= period then
					text, color = "GO!", DOOR_GO
				else
					local at = (t + phase) % period
					if at < open then
						text, color = string.format("GO! %.1f", open - at), DOOR_GO
					else
						text, color = string.format("%.2f", period - at), DOOR_WAIT
						closed = true
					end
				end
				-- Closed: the number with a smaller "Wait..." line under it (rich text at
				-- sizes fitted to the sign); open: the label's own scaled text.
				if door.scaled == nil then
					door.scaled = label.TextScaled
				end
				if closed then
					local box = label.AbsoluteSize
					local big = math.floor(math.min(box.Y * 0.62, box.X / (#text * 0.62)))
					if big >= 8 then
						text = string.format('%s<br/><font size="%d">Wait...</font>', text, math.max(6, math.floor(big * 0.45)))
						label.RichText = true
						label.TextScaled = false
						if label.TextSize ~= big then
							label.TextSize = big
						end
					end
				elseif label.TextScaled ~= door.scaled then
					label.TextScaled = door.scaled == true
				end
				if label.Text ~= text then
					label.Text = text
				end
				if label.TextColor3 ~= color then
					label.TextColor3 = color
				end
			end
		end
	end
end

local function step(dt: number)
	local now = os.clock()
	local humanoid, root = character()
	stepPlayers(humanoid, root)
	stepKeys(now)
	stepTreadmills(dt, now, humanoid, root)
	stepSpeed(dt, root)
	stepDoors(now)
	stepBlinkKeys()
end

-- Run glow: our own bloom + a touch more saturation so the neon trusses glow (Fx.Surge
-- keeps its own SurgeBloom / SurgeGrade; these are separate instances, removed on stop).
local runBloom: BloomEffect? = nil
local runGrade: ColorCorrectionEffect? = nil
local function setGlow(on: boolean)
	if runBloom then
		runBloom:Destroy()
		runBloom = nil
	end
	if runGrade then
		runGrade:Destroy()
		runGrade = nil
	end
	if not on then
		return
	end
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CardioBloom"
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
	runBloom = bloom
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "CardioGrade"
	grade.Saturation = 0.1
	grade.Parent = Lighting
	runGrade = grade
end

local function activate()
	if active then
		return
	end
	active = true
	setGlow(true)
	startedAt = os.clock()
	indexKeys()
	if not stepConn then
		stepConn = RunService.RenderStepped:Connect(step)
	end
end

local function deactivate()
	if not active then
		return
	end
	active = false
	setGlow(false)
	if stepConn then
		stepConn:Disconnect()
		stepConn = nil
	end
	restoreAll()
	stopRun()
	speedK = 0
	applyFov(0)
	if linesGui then
		linesGui.Enabled = false
	end
end

function CardioFx.onNotify(p: any)
	local event = p.event
	if event == "start" then
		activate()
		startedAt = os.clock()
	elseif event == "zone" then
		local pos = playerPos()
		if pos then
			burst(pos, 7, 4, false)
		end
	elseif event == "win" then
		-- Cashed out on a WIN pad (the last one is the finish); the run goes on in the lobby.
		local pos = playerPos()
		if pos then
			local final = p.final == true
			burst(pos, if final then 20 else 14, if final then 8 else 6, true)
		end
	elseif event == "fall" then
		task.delay(0.35, function()
			local pos = playerPos()
			if pos and active then
				local anchor = anchorAt(pos, 3)
				Sprites.billboard(anchor, "Ring", { position = pos - Vector3.new(0, 2.5, 0), size = 6, life = 0.7, rise = Vector3.zero })
				Sprites.billboard(anchor, "Puff", { position = pos, size = 3.5, life = 0.8, rise = Vector3.new(0, 2.5, 0) })
			end
		end)
	elseif event == "upgrade" then
		if p.reason == nil and p.ok ~= false then
			local pos = playerPos()
			for _, pad in CollectionService:GetTagged(PAD_TAG) do
				local at = if pad:IsA("BasePart") then pad.Position elseif pad:IsA("Model") then pad:GetPivot().Position else nil
				if at and pos and (at - pos).Magnitude < 30 then
					pos = at + Vector3.new(0, 2, 0)
					break
				end
			end
			if pos then
				sparkle(pos, 10, W.Sunny or WHITE)
			end
		end
	elseif event == "stop" then
		deactivate()
	end
end

local function onState(data: any)
	if type(data) ~= "table" or type(data.modes) ~= "table" then
		return
	end
	local s = data.modes.cardio
	if type(s) ~= "table" then
		return
	end
	snap = s
	if s.running == true then
		activate()
		paintSpeedTag(s.onTreadmill == true)
	elseif s.running == false and active and os.clock() - startedAt > 2 then
		deactivate()
	end
end

function CardioFx.init()
	for _, model in CollectionService:GetTagged(TREADMILL_TAG) do
		addTreadmill(model)
	end
	CollectionService:GetInstanceAddedSignal(TREADMILL_TAG):Connect(addTreadmill)
	CollectionService:GetInstanceRemovedSignal(TREADMILL_TAG):Connect(removeTreadmill)
	for _, door in CollectionService:GetTagged(DOOR_TAG) do
		addDoor(door)
	end
	for _, k in CollectionService:GetTagged(BLINK_TAG) do
		addBlinkKey(k)
	end
	CollectionService:GetInstanceAddedSignal(BLINK_TAG):Connect(addBlinkKey)
	CollectionService:GetInstanceAddedSignal(DOOR_TAG):Connect(addDoor)
	CollectionService:GetInstanceRemovedSignal(DOOR_TAG):Connect(removeDoor)
	Net.event("Notify").OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and payload.kind == "Mode" and payload.mode == "cardio" then
			CardioFx.onNotify(payload)
		end
	end)
	Net.event("Effect").OnClientEvent:Connect(function(kind, data)
		if kind == "CardioSteps" then
			CardioFx.onSteps(data)
		end
	end)
	State.changed.Event:Connect(onState)
	if State.data then
		onState(State.data)
	end
	Players.PlayerRemoving:Connect(function(other)
		otherLast[other] = nil
	end)
	player.CharacterAdded:Connect(function()
		runTrack, runTrackOwner = nil, nil
		localKey = nil
		hidePops()
	end)
	Budget.onChange(function()
		-- Rebuild the speed lines at the new count next time they show.
		if linesGui then
			linesGui:Destroy()
			linesGui = nil
		end
	end)
end

return CardioFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="222">
            <Properties>
              <string name="Name">CardioChase</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.CardioChase: the CHASER CHADS of CARDIO (stages 3, 6, 9; server side in
	Modes.CardioChase). Listens to Notify (kind "Mode", mode "cardio") on its own:
	  chase     { stage, tier, scale, speed, startX, startZ, startS, stopS, startAt, endX,
	              zMin, zMax, laneEase, path = { { x0, x1, top, z0, z1 } },
	              line = { { s, x, z, half } } }  (the bridge path's centre line)
	  caught    { stage }            "MOGGED!" splash, the chaser flexes over you and leaves
	  chaseEnd  { stage, reason }    "escaped": it stops, roars / flexes and gives up
	  stop                           run ended: everything goes

	Chad      built locally (only this client sees its own chaser) with CharacterFactory from
	          Theme.Tiers[tier].Look at `scale`, angry face, a bright red always-on-top outline
	          (Highlight). It is NOT tagged for the Animator: this module poses it itself
	          (RigPose "Run" with gaitTime from the distance run, so the feet stay planted).
	Position  the same deterministic formula as the server (Modes.CardioChase.position):
	            s = min(stopS, startS + speed * run), run = max(0, t - startAt),
	            t = GetServerTimeNow(); x, pz, half = the centre line at s;
	            z = clamp(pz + clamp(playerZ - pz, -half, half) * min(1, run / laneEase), zMin, zMax)
	          feet on the path surfaces, with a jump arc over gaps.
	Warning   a red "!" over its head, an alarm sting, a "CHAD IS COMING!" banner; then a
	          distance meter and a red screen-edge vignette that grow as it closes in.
	Dust      a puff at its feet on every footfall (Sprites budget permitting).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local CharacterFactory = require(ReplicatedStorage.Shared:WaitForChild("CharacterFactory")) :: any
local Poses = require(ReplicatedStorage.Shared:WaitForChild("Poses")) :: any
local RigPose = require(ReplicatedStorage.Shared:WaitForChild("RigPose")) :: any
local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Client = script.Parent.Parent
local Sounds = require(Client.Sounds) :: any
local Sprites = require(script.Parent.Sprites)

local ChaseFx = {}

local player = Players.LocalPlayer
local RED = Color3.fromRGB(255, 40, 40)
-- The chaser reads tiny next to the wide track, so it is drawn 1.5x the server's scale
-- (CharacterFactory takes any scale; the server's catch maths doesn't use the size).
local SIZE_BOOST = 1.5
-- One reusable red outline (Roblox renders at most 31 Highlights at once).
local outline: Highlight? = nil
local DANGER = 45 -- studs: the meter and vignette start reacting inside this
local BIND = "FxCardioChase"

type Surface = { number }
-- Centre line vertex { s, x, z, half }.
type Vertex = { number }
type Chase = {
	stage: number,
	speed: number,
	startX: number,
	startZ: number,
	startAt: number,
	endX: number,
	zMin: number,
	zMax: number,
	laneEase: number,
	path: { Surface },
	line: { Vertex },
	startS: number,
	stopS: number,
	scale: number,
	-- Set when it gave up: it stays at (x, z).
	frozen: { number }?,
}

local folder: Folder? = nil
local chad: Model? = nil
local rig: any = nil
local rootOffset = CFrame.identity
local chase: Chase? = nil
-- "chase" (running after you) | "flex" (gave up / caught you: posing in place) | nil
local mode: string? = nil
local flexPose = "MostMuscular"
local flexStart = 0
local lastStep = 0
local gui: ScreenGui? = nil
local meter: TextLabel? = nil
local edges: { Frame } = {}
local token = 0

local function num(value: any, default: number): number
	return if type(value) == "number" and value == value then value else default
end

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function playerRoot(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Feet height along the path at x (surface top, or a jump arc over a gap).
local function groundY(path: { Surface }, x: number, hop: number): number
	local prev: Surface? = nil
	for _, s in path do
		if x < s[1] then
			if not prev then
				return s[3]
			end
			local u = (x - prev[2]) / math.max(0.01, s[1] - prev[2])
			return prev[3] + (s[3] - prev[3]) * u + 4 * hop * u * (1 - u)
		elseif x <= s[2] then
			return s[3]
		end
		prev = s
	end
	return if prev then prev[3] else 0
end

-- The centre line at distance s: x, z, half width (Modes.CardioChase.lineAt).
local function lineAt(line: { Vertex }, s: number): (number, number, number)
	local first = line[1]
	if not first then
		return 0, 0, 0
	end
	if s <= first[1] then
		return first[2], first[3], first[4]
	end
	for i = 2, #line do
		local b = line[i]
		if s <= b[1] then
			local a = line[i - 1]
			local u = if b[1] > a[1] then (s - a[1]) / (b[1] - a[1]) else 1
			return a[2] + (b[2] - a[2]) * u, a[3] + (b[3] - a[3]) * u, a[4] + (b[4] - a[4]) * u
		end
	end
	local last = line[#line]
	return last[2], last[3], last[4]
end

-- Same formula as Modes.CardioChase.position (plus run time).
local function position(c: Chase, t: number, playerZ: number): (number, number, number)
	local run = math.max(0, t - c.startAt)
	local frozen = c.frozen
	if frozen then
		return frozen[1], frozen[2], run
	end
	if #c.line == 0 then
		return c.startX, c.startZ, run
	end
	local s = math.min(c.stopS, c.startS + c.speed * run)
	local x, pz, half = lineAt(c.line, s)
	local pull = math.clamp(playerZ - pz, -half, half) * math.min(1, run / math.max(0.01, c.laneEase))
	return x, math.clamp(pz + pull, c.zMin, c.zMax), run
end

-- Screen ------------------------------------------------------------------------------------

local function ensureGui(): ScreenGui
	if gui then
		return gui
	end
	local g = Instance.new("ScreenGui")
	g.Name = "CardioChase"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 6
	g.Parent = player:WaitForChild("PlayerGui")
	-- Red vignette: four edge bands fading inward.
	edges = {}
	local specs: { { size: UDim2, pos: UDim2, rot: number } } = {
		{ size = UDim2.new(1, 0, 0.22, 0), pos = UDim2.new(0, 0, 0, 0), rot = 90 },
		{ size = UDim2.new(1, 0, 0.22, 0), pos = UDim2.new(0, 0, 0.78, 0), rot = -90 },
		{ size = UDim2.new(0.16, 0, 1, 0), pos = UDim2.new(0, 0, 0, 0), rot = 0 },
		{ size = UDim2.new(0.16, 0, 1, 0), pos = UDim2.new(0.84, 0, 0, 0), rot = 180 },
	}
	for i, spec in specs do
		local f = Instance.new("Frame")
		f.Name = "Edge" .. i
		f.BorderSizePixel = 0
		f.BackgroundColor3 = RED
		f.BackgroundTransparency = 1
		f.Size = spec.size
		f.Position = spec.pos
		local grad = Instance.new("UIGradient")
		grad.Rotation = spec.rot
		grad.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		grad.Parent = f
		f.Parent = g
		table.insert(edges, f)
	end
	local m = Instance.new("TextLabel")
	m.Name = "Meter"
	m.AnchorPoint = Vector2.new(0.5, 0)
	m.Position = UDim2.new(0.5, 0, 0.13, 0)
	m.Size = UDim2.new(0, 420, 0, 44)
	m.BackgroundTransparency = 1
	m.Font = Theme.Fonts.Display
	m.TextScaled = true
	m.TextColor3 = Color3.new(1, 1, 1)
	m.Text = ""
	m.Visible = false
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(120, 0, 0)
	stroke.Thickness = 3
	stroke.Parent = m
	m.Parent = g
	meter = m
	gui = g
	return g
end

local function setDanger(alpha: number)
	for _, f in edges do
		f.BackgroundTransparency = 1 - 0.55 * alpha
	end
end

-- A big popping word in the middle of the screen.
local function splash(text: string, color: Color3, life: number)
	local g = ensureGui()
	local label = Instance.new("TextLabel")
	label.Name = "Splash"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.new(0.5, 0, 0.36, 0)
	label.Size = UDim2.new(0.7, 0, 0.16, 0)
	label.BackgroundTransparency = 1
	label.Font = Theme.Fonts.Display
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.Rotation = -6
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(40, 0, 0)
	stroke.Thickness = 5
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.2
	scale.Parent = label
	label.Parent = g
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Rotation = 0 }):Play()
	task.delay(life, function()
		local fade = TweenInfo.new(0.35)
		TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
		TweenService:Create(scale, fade, { Scale = 1.3 }):Play()
		task.delay(0.4, function()
			label:Destroy()
		end)
	end)
end

-- Chad --------------------------------------------------------------------------------------

local function tierLook(tier: number): any
	local tiers = Theme.Tiers
	local entry = tiers[math.clamp(math.floor(tier), 1, #tiers)]
	return entry and entry.Look
end

local function anchorAt(position: Vector3, life: number): BasePart
	local part = Instance.new("Part")
	part.Name = "ChaseFxAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.CFrame = CFrame.new(position)
	part.Parent = folder or Workspace
	task.delay(life, function()
		part:Destroy()
	end)
	return part
end

local function sprite(name: string, position: Vector3, opts: { [string]: any })
	if not Sprites.room() then
		return
	end
	local o = table.clone(opts) :: any
	o.position = position
	Sprites.billboard(anchorAt(position, 2.2), name, o)
end

local function removeChad()
	token += 1
	if chad then
		chad:Destroy()
	end
	chad, rig = nil, nil
	if outline then
		outline.Enabled = false
		outline.Adornee = nil
	end
end

local function clear()
	removeChad()
	chase = nil
	mode = nil
	RunService:UnbindFromRenderStep(BIND)
	if meter then
		meter.Visible = false
	end
	setDanger(0)
end

local function warnMark(model: Model, height: number)
	local head = model.PrimaryPart
	if not head then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "ChaseWarn"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.new(0, 90, 0, 90)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height - rootOffset.Y + 2.5, 0)
	bb.MaxDistance = 400
	bb.Adornee = head
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Theme.Fonts.Display
	label.TextScaled = true
	label.Text = "!"
	label.TextColor3 = RED
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Thickness = 4
	stroke.Parent = label
	label.Parent = bb
	bb.Parent = model
	local scale = Instance.new("UIScale")
	scale.Parent = label
	local pulse = TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 5, true)
	scale.Scale = 0.6
	TweenService:Create(scale, pulse, { Scale = 1.25 }):Play()
	task.delay(2.6, function()
		bb:Destroy()
	end)
end

local function outlineOf(): Highlight
	local h = outline
	if h and h.Parent then
		return h
	end
	local made = Instance.new("Highlight")
	made.Name = "CardioChaseOutline"
	made.OutlineColor = Color3.new(1, 0.1, 0.1)
	made.OutlineTransparency = 0
	made.FillColor = Color3.new(1, 0.1, 0.1)
	made.FillTransparency = 0.85
	made.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	made.Enabled = false
	made.Parent = Workspace
	outline = made
	return made
end

local function buildChad(p: any, scale: number): Model?
	local base = tierLook(num(p.tier, 10))
	if not base or not folder then
		return nil
	end
	local look = table.clone(base)
	look.scale = scale
	look.exprs = { "Angry", "Smug", "Determined" }
	look.expr = "Angry"
	local ok, model = pcall(CharacterFactory.build, look, "ChaserChad")
	if not ok or not model then
		warn("[Fx.CardioChase] build failed: " .. tostring(model))
		return nil
	end
	local m = model :: Model
	-- Posed here, not by the Animator.
	m:RemoveTag(Poses.TAG)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = true
		end
	end
	CharacterFactory.setExpression(m, "Angry")
	local root = m.PrimaryPart
	if root then
		rootOffset = m:GetPivot():ToObjectSpace(root.CFrame)
	end
	rig = RigPose.capture(m, 7)
	m.Parent = folder
	local h = outlineOf()
	h.Adornee = m
	h.Enabled = true
	return m
end

-- Puts the Chad's feet at `feet` facing +X and poses it.
local function place(feet: Vector3, pose: string, time: number, fromPose: string?, alpha: number?)
	local m = chad
	if not m then
		return
	end
	local pivot = CFrame.lookAt(feet, feet + Vector3.new(1, 0, 0))
	local root = m.PrimaryPart
	if rig and root then
		root.CFrame = pivot * rootOffset
		local parts, cframes = RigPose.computePose(rig, pose, time, fromPose, alpha)
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	else
		m:PivotTo(pivot)
	end
end

local function step()
	local c = chase
	if not c or not chad then
		return
	end
	local t = now()
	local root = playerRoot()
	local pz = if root then root.Position.Z else c.startZ
	local x, z, run = position(c, t, pz)
	local hop = 2.5 * c.scale
	local feet = Vector3.new(x, groundY(c.path, x, hop), z)
	local height = num(chad:GetAttribute("Height"), 5.6 * c.scale)
	if mode == "flex" then
		local k = os.clock() - flexStart
		place(feet, flexPose, k, "Run", math.min(1, k / 0.25))
		return
	end
	if t < c.startAt then
		-- Head start: a roaring flex at the starting line.
		place(feet, "MostMuscular", t, nil, nil)
	else
		-- Distance run along the path (the jog's sideways stretch included).
		local dist = math.max(0, math.min(c.stopS, c.startS + c.speed * run) - c.startS)
		local cadence = Poses.gaitTime("Run", dist, c.scale)
		place(feet, "Run", cadence, "MostMuscular", math.min(1, run / 0.3))
		-- A dust puff on every footfall (two per Run cycle).
		local period = Poses.GAIT.Run and Poses.GAIT.Run.period or 0.64
		local footfall = math.floor(cadence / (period / 2))
		if footfall ~= lastStep then
			lastStep = footfall
			if x < c.endX and math.abs(feet.Y - groundY(c.path, x + 0.01, 0)) < 0.2 then
				sprite("Puff", feet + Vector3.new(-1, 0.5, 0), {
					size = 2.2 * c.scale,
					life = 0.6,
					rise = Vector3.new(-2, 1.5, 0),
					color = Color3.fromRGB(235, 225, 210),
				})
			end
		end
	end
	-- Distance meter and vignette.
	if root and meter then
		local gap = math.max(0, root.Position.X - x - height * 0.1)
		local close = math.clamp(1 - gap / DANGER, 0, 1)
		meter.Visible = true
		meter.Text = if t < c.startAt then "CHAD IS COMING!" else string.format("CHAD %d STUDS BEHIND!", math.floor(gap))
		meter.TextColor3 = Color3.new(1, 1, 1):Lerp(RED, close)
		local pulse = if close > 0 then 0.75 + 0.25 * math.sin(os.clock() * (8 + 10 * close)) else 1
		setDanger(close * pulse)
	end
end

-- Stop chasing, flex / roar where it stands, then shrink away with a puff.
local function giveUp(pose: string, hold: number)
	local m = chad
	if not m or not chase then
		clear()
		return
	end
	-- Freeze it where it is (the formula would keep it running).
	local c0 = chase :: Chase
	local fx, fz = position(c0, now(), c0.startZ)
	local root = playerRoot()
	if root then
		fx, fz = position(c0, now(), root.Position.Z)
	end
	c0.frozen = { fx, fz }
	c0.startX, c0.endX = fx, fx
	mode = "flex"
	flexPose = pose
	flexStart = os.clock()
	if meter then
		meter.Visible = false
	end
	setDanger(0)
	local mine = token
	task.delay(hold, function()
		if token ~= mine or not chad then
			return
		end
		local pivot = m:GetPivot()
		sprite("Puff", pivot.Position + Vector3.new(0, 2, 0), { size = 8, life = 0.8, rise = Vector3.new(0, 3, 0) })
		clear()
	end)
end

local function onChase(p: any)
	clear()
	ensureGui()
	folder = folder or Instance.new("Folder")
	local f = folder :: Folder
	f.Name = "CardioChaseFx"
	f.Parent = Workspace
	local path: { Surface } = {}
	if type(p.path) == "table" then
		for _, s in p.path do
			if type(s) == "table" and #s >= 3 then
				table.insert(path, { num(s[1], 0), num(s[2], 0), num(s[3], 0) })
			end
		end
	end
	local line: { Vertex } = {}
	if type(p.line) == "table" then
		for _, v in p.line do
			if type(v) == "table" and #v >= 4 then
				table.insert(line, { num(v[1], 0), num(v[2], 0), num(v[3], 0), num(v[4], 0) })
			end
		end
	end
	local c: Chase = {
		stage = num(p.stage, 0),
		speed = num(p.speed, 0),
		startX = num(p.startX, 0),
		startZ = num(p.startZ, 0),
		startAt = num(p.startAt, now()),
		endX = num(p.endX, 0),
		zMin = num(p.zMin, -math.huge),
		zMax = num(p.zMax, math.huge),
		laneEase = num(p.laneEase, 1),
		path = path,
		line = line,
		startS = num(p.startS, 0),
		stopS = num(p.stopS, 0),
		scale = num(p.scale, 2) * SIZE_BOOST,
	}
	local m = buildChad(p, c.scale)
	if not m then
		return
	end
	chad = m
	chase = c
	mode = "chase"
	lastStep = 0
	RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 2, step)
	step()
	local height = num(m:GetAttribute("Height"), 5.6 * c.scale)
	warnMark(m, height)
	local x = c.startX
	sprite("Puff", Vector3.new(x, groundY(c.path, x, 0) + 1, c.startZ), { size = 10, life = 0.8, rise = Vector3.new(0, 3, 0) })
	-- Alarm sting.
	Sounds.play("SurgeStart", 0, 0.7)
	Sounds.play("Error", 0, 0.8)
	task.delay(0.25, function()
		if chase == c then
			Sounds.play("Error", 0, 0.8)
		end
	end)
	splash("RUN!", RED, 0.9)
end

local function onCaught()
	if not chase then
		return
	end
	splash("MOGGED!", RED, 1.3)
	Sounds.play("Error", 0, 0.6)
	local root = playerRoot()
	if root then
		sprite("Puff", root.Position, { size = 7, life = 0.8, rise = Vector3.new(0, 3, 0), color = RED })
	end
	if chad then
		CharacterFactory.setExpression(chad, "Smug")
	end
	giveUp("DoubleBiceps", 1.2)
end

local function onEnd(p: any)
	if not chase then
		return
	end
	if p.reason == "escaped" then
		splash("ESCAPED!", Theme.Colors.Gold or Color3.fromRGB(255, 212, 64), 1.1)
		Sounds.play("Celebrate")
		if chad then
			CharacterFactory.setExpression(chad, "Angry")
		end
		-- The defeated roar: a flex at the edge of the safe zone.
		giveUp("MostMuscular", 1.6)
	elseif p.reason == "retreat" then
		giveUp("HandsOnHips", 1.0)
	else
		clear()
	end
end

function ChaseFx.onNotify(p: any)
	if type(p) ~= "table" then
		return
	end
	local event = p.event
	if event == "chase" then
		onChase(p)
	elseif event == "caught" then
		onCaught()
	elseif event == "chaseEnd" then
		onEnd(p)
	elseif event == "stop" then
		clear()
	end
end

function ChaseFx.init()
	Net.event("Notify").OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and payload.kind == "Mode" and payload.mode == "cardio" then
			ChaseFx.onNotify(payload)
		end
	end)
	player.CharacterRemoving:Connect(clear)
end

return ChaseFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="223">
            <Properties>
              <string name="Name">Cosmetics</string>
              <string name="Source"><![CDATA[--[[
	Fx.Cosmetics: the local player's own cosmetic effects (client-side only).

	The server (Server.Cosmetics) sets two Player attributes:
	  CosDoubleJump   owned and switched on: a second jump in mid-air
	  CosSpeed        Speedy Sneakers on: little speed puffs at the feet while running
	Trails, aura and crown are server-made on the character, so everyone sees them.

	Double jump listens to UserInputService.JumpRequest (keyboard, gamepad and the
	mobile jump button all raise it). Holding jump repeats the request every frame,
	so only a request after a short gap counts as a new press. One air jump per
	flight, reset on landing; never while the intro cutscene plays.

	Nothing runs per frame: every connection is event-driven and only exists while
	its cosmetic is on.

	Device budget (Fx.Budget): on "mid" / "low" devices every character's
	server-made trail stars and aura particles (CosTrailStars, CosAura*) emit at
	Budget.scale() of their rate locally, the speed puffs follow Sprites.emitter's
	scaling, and the double-jump burst throws fewer puffs.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)

local CosmeticsFx = {}

-- A JumpRequest this long after the previous one is a new press, not a held key.
local PRESS_GAP = 0.12
-- Seconds in the air before the second jump is allowed (keeps one press from doing both).
local MIN_AIR_TIME = 0.12
-- Running faster than this (studs/s) shows the speed puffs.
local PUFF_SPEED = 10

local player = Players.LocalPlayer
local jumpConns: { RBXScriptConnection } = {}
local speedConns: { RBXScriptConnection } = {}
local puffEmitter: ParticleEmitter? = nil

local function disconnect(list: { RBXScriptConnection })
	for _, conn in list do
		conn:Disconnect()
	end
	table.clear(list)
end

local function characterParts(): (Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	return humanoid, if root and root:IsA("BasePart") then root else nil
end

local function jumpVelocity(humanoid: Humanoid): number
	if humanoid.UseJumpPower then
		return humanoid.JumpPower
	end
	return math.sqrt(2 * Workspace.Gravity * humanoid.JumpHeight)
end

-- Star burst under the feet (sprites; a plain puff when they are missing).
local function burst(root: BasePart, humanoid: Humanoid)
	local feet = root.Position - Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)
	local shown = Sprites.billboard(root, "StarPop", {
		position = feet,
		size = 2.2,
		rise = Vector3.new(0, -0.6, 0),
		life = 0.45,
		spin = 90,
		maxDistance = 60,
	})
	local puffs = Budget.count(3)
	for i = 1, puffs do
		if not Sprites.room() then
			break
		end
		local angle = (i / puffs + math.random() * 0.2) * math.pi * 2
		Sprites.billboard(root, "Puff", {
			position = feet,
			size = 1.3,
			rise = Vector3.new(math.cos(angle) * 1.6, -0.3, math.sin(angle) * 1.6),
			life = 0.5,
			color = Color3.new(1, 1, 1),
			maxDistance = 60,
		})
	end
	if not shown then
		Sprites.billboard(root, "Sparkle", { position = feet, size = 1.6, life = 0.4 })
	end
end

-- Double jump -----------------------------------------------------------------------------

local function hookJump(humanoid: Humanoid)
	disconnect(jumpConns)
	local airborneAt: number? = nil
	local used = false
	local lastRequest = 0

	table.insert(
		jumpConns,
		humanoid.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
				airborneAt = nil
				used = false
			elseif (new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall) and airborneAt == nil then
				airborneAt = os.clock()
			end
		end)
	)
	table.insert(
		jumpConns,
		UserInputService.JumpRequest:Connect(function()
			local now = os.clock()
			local newPress = now - lastRequest > PRESS_GAP
			lastRequest = now
			if not newPress or used or airborneAt == nil or now - (airborneAt :: number) < MIN_AIR_TIME then
				return
			end
			if player:GetAttribute("IntroPlaying") == true or humanoid.Health <= 0 then
				return
			end
			local state = humanoid:GetState()
			if state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping then
				return
			end
			local _, root = characterParts()
			if not root then
				return
			end
			used = true
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, jumpVelocity(humanoid), v.Z)
			burst(root, humanoid)
		end)
	)
end

-- Speed puffs -----------------------------------------------------------------------------

local function hookSpeed(humanoid: Humanoid, root: BasePart)
	disconnect(speedConns)
	if puffEmitter then
		puffEmitter:Destroy()
		puffEmitter = nil
	end
	local feet = Instance.new("Attachment")
	feet.Name = "CosSpeedPuffs"
	feet.Position = Vector3.new(0, -(humanoid.HipHeight + root.Size.Y / 2) + 0.3, 0.4)
	feet.Parent = root
	local emitter = Sprites.emitter(feet, "Puff", {
		Rate = 9,
		Enabled = false,
		EmissionDirection = Enum.NormalId.Back,
		Speed = NumberRange.new(3, 5),
		Drag = 4,
		SpreadAngle = Vector2.new(20, 10),
		Lifetime = NumberRange.new(0.35, 0.55),
		Acceleration = Vector3.new(0, 1.5, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(0.3, 0.7),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.6, 0.4),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	if not emitter then
		feet:Destroy()
		return
	end
	puffEmitter = emitter
	local running = false
	local onGround = true
	local function update()
		emitter.Enabled = running and onGround
	end
	table.insert(
		speedConns,
		humanoid.Running:Connect(function(speed)
			running = speed > PUFF_SPEED
			update()
		end)
	)
	table.insert(
		speedConns,
		humanoid.StateChanged:Connect(function(_, new)
			onGround = new == Enum.HumanoidStateType.Running or new == Enum.HumanoidStateType.RunningNoPhysics
			update()
		end)
	)
	table.insert(
		speedConns,
		feet.Destroying:Connect(function()
			if puffEmitter == emitter then
				puffEmitter = nil
			end
		end)
	)
end

local function clearSpeed()
	disconnect(speedConns)
	if puffEmitter then
		local attachment = puffEmitter.Parent
		puffEmitter = nil
		if attachment then
			attachment:Destroy()
		end
	end
end

-- Everyone's trail / aura particles on a budget ------------------------------------------

local fullRate: { [ParticleEmitter]: number } = setmetatable({}, { __mode = "k" }) :: any

local function budgetEmitter(emitter: Instance)
	if not emitter:IsA("ParticleEmitter") then
		return
	end
	local name = emitter.Name
	if name ~= "CosTrailStars" and string.sub(name, 1, 6) ~= "CosAura" then
		return
	end
	local full = fullRate[emitter]
	if not full then
		full = emitter.Rate
		fullRate[emitter] = full
	end
	emitter.Rate = full * Budget.scale()
end

local function watchCharacter(character: Model)
	for _, d in character:GetDescendants() do
		budgetEmitter(d)
	end
	character.DescendantAdded:Connect(budgetEmitter)
end

local function watchPlayer(other: Player)
	if other.Character then
		watchCharacter(other.Character)
	end
	other.CharacterAdded:Connect(watchCharacter)
end

local function budgetCosmetics()
	pcall(function()
		for _, other in Players:GetPlayers() do
			watchPlayer(other)
		end
		Players.PlayerAdded:Connect(watchPlayer)
	end)
	Budget.onChange(function()
		for emitter in fullRate do
			if emitter.Parent then
				budgetEmitter(emitter)
			end
		end
	end)
end

-- Wiring ----------------------------------------------------------------------------------

local function refresh()
	local humanoid, root = characterParts()
	if humanoid and player:GetAttribute("CosDoubleJump") == true then
		hookJump(humanoid)
	else
		disconnect(jumpConns)
	end
	if humanoid and root and player:GetAttribute("CosSpeed") == true then
		if not puffEmitter or not puffEmitter:IsDescendantOf(root) then
			hookSpeed(humanoid, root)
		end
	else
		clearSpeed()
	end
end

function CosmeticsFx.init()
	budgetCosmetics()
	if not player then
		return
	end
	player:GetAttributeChangedSignal("CosDoubleJump"):Connect(refresh)
	player:GetAttributeChangedSignal("CosSpeed"):Connect(refresh)
	player.CharacterAdded:Connect(function(character)
		disconnect(jumpConns)
		clearSpeed()
		character:WaitForChild("Humanoid", 10)
		character:WaitForChild("HumanoidRootPart", 10)
		if player.Character == character then
			refresh()
		end
	end)
	refresh()
end

return CosmeticsFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="224">
            <Properties>
              <string name="Name">Crates</string>
              <string name="Source"><![CDATA[--[[
	Fx.Crates: client-side juice for the crates on the local player's plot
	(workspace.Map.PlotN.Chests, server-built anchored models).

	- Arrival: a Chad on the display ledge drops the crate. The server places it
	  on its landing spot in the pen and stores the route as world-space
	  attributes Path1..PathN + PathCount + PathKinds (crate-pivot waypoints:
	  unit feet, drop point in front of the rack, gutter, chute top, chute
	  bottom, landing; read by Orbs.readRoute) and Origin (the unit's feet).
	  The crate pops out in front of the Chad with a puff, hops low off its
	  shelf to the drop point, falls into the gutter (turned along it) with a
	  bounce, slides along it and down the chute with a wobble and quarter-turn tumbles
	  (shrunk to fit the trough), bounces twice into the pen growing back to
	  full size, then squashes and settles. Its sparkles stay hidden until it lands.
	- Idle: gentle bob, slow spin and a slight sway over a soft rarity-coloured
	  ground disc whose size scales with rarity.
	- Pickup is automatic (the server's fast tick, CratePickup rules): walking up to a
	  landed crate picks it up. While the player already holds a crate and stands in
	  pickup range, the crate gives a small "can't" wiggle at most every WIGGLE_GAP s.
	- Rarity label: the rarity word ("Common", ...) floats over every landed crate as
	  bold rarity-coloured text with an Ink outline, visible within CHIP_RANGE studs of
	  the camera and hidden while the held-crate panel is open (TycoonUI CratePanelOpen).
	- Pickup (model removed): a sparkle puff where it stood.

	Crates that already exist when the plot is bound just appear in place.
	All movement is local (BulkMoveTo on the server's anchored parts) and a pure
	function of time since the crate appeared, so it is frame-rate independent.
	On "low" devices (Fx.Budget) idle crates past their intro move every 2nd frame
	and only within 110 studs; dust puffs scale with Budget.count.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local CratePickup = require(Shared:WaitForChild("CratePickup"))
local Theme = require(ReplicatedStorage:WaitForChild("Theme"))

local Client = script.Parent.Parent
local Animator = require(Client.Animator)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local Camera = require(script.Parent.Camera)
local Orbs = require(script.Parent.Orbs)
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)

local Crates = {}

local WHITE = Color3.new(1, 1, 1)
local HIDDEN = CFrame.new(0, -10000, 0)
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)
local UP = Vector3.yAxis
local PUFF = Sprites.image("Puff") -- the Blender dust cloud; the built-in smoke without it
local SMOKE = PUFF or "rbxasset://textures/particles/smoke_main.dds"

local TRAVEL_SCALE = 0.72 -- crates shrink to fit the gutter and chute
local POP = 0.2 -- pop-in behind the Chad
local POP_FORWARD, POP_UP = 1.2, 0.3 -- pop-in spot: just in front of the Chad's feet
local HOP_MIN, HOP_MAX, HOP_APEX = 0.35, 0.6, 1 -- low hop: the shelf above is overhead
local FALL_G, FALL_MAX = 70, 0.75 -- fall into the gutter (the top shelf's fall is capped)
local GUTTER_V0, GUTTER_ACCEL, GUTTER_VMAX = 4, 11, 13
local CHUTE_ACCEL, CHUTE_VMAX = 14, 13
local BOUNCE1, BOUNCE1_APEX, BOUNCE1_SHARE = 0.44, 1.9, 0.72
local BOUNCE2, BOUNCE2_APEX = 0.26, 0.6
local SQUASH = 0.6
local FALLBACK_DROP = 7 -- no route: drop from this high above the landing spot
local CULL = 170 -- studs from the camera: beyond this crates stay still
local LOW_CULL = 110 -- the same on a "low" budget device
local idleFrame = 0
local MAX_CRATES = 8
local CHIP_RANGE = 70 -- camera distance cap of the rarity labels (BillboardGui.MaxDistance)
local CHIP_HEIGHT = 1.6 -- studs
-- Share of the chip's stud size that scales with distance; fixed pixels per letter and in
-- height keep it readable far away without it covering the pile up close.
local CHIP_SCALE = 0.55
local CHIP_PX_PER_LETTER = 6
local CHIP_PX_HEIGHT = 8
local CHIP_SCAN = 0.15 -- seconds between chip range checks
local WIGGLE = 0.45 -- seconds of one "can't" wiggle
local INK = (Theme :: any).World and (Theme :: any).World.Ink or Color3.fromRGB(58, 48, 96)

-- One leg of the arrival. kind: "pop" | "hop" | "fall" | "slide" | "arc".
type Leg = {
	kind: string,
	from: Vector3,
	to: Vector3,
	t0: number,
	dur: number,
	apex: number,
	v0: number,
	accel: number,
	vmax: number,
	tumbles: number, -- quarter turns during this leg
	turned: number, -- quarter turns completed before it
	face: CFrame, -- facing during the leg (long side along the travel direction)
	faceFrom: CFrame, -- the previous leg's facing, turned from over the leg's start
}

type Crate = {
	model: Model,
	base: CFrame,
	parts: { BasePart },
	offsets: { CFrame },
	sizes: { Vector3 },
	bottom: number, -- lowest point relative to the pivot (negative)
	half: Vector3, -- half extents of the crate's box
	mid: number, -- height of the box's middle above the pivot
	rarity: string,
	rank: number,
	color: Color3,
	born: number, -- os.clock() of the arrival start (or long ago for no arrival)
	land: number, -- seconds from born to touchdown
	legs: { Leg },
	bounced: boolean,
	source: Model?,
	wiggleAt: number, -- os.clock() of the last "can't" wiggle start
	phase: number,
	disc: Part,
	chip: BillboardGui,
	chipOn: boolean,
	chipToken: number,
	shown: boolean,
	landed: boolean,
	restored: boolean,
	broken: boolean,
}

local crates: { [Model]: Crate } = {}
local crateCount = 0
local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}
local started = false

-- Helpers -------------------------------------------------------------------------------

local function fxPart(shape: Enum.PartType, name: string, color: Color3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = Vector3.one
	p.CFrame = HIDDEN
	p.Parent = Orbs.getFolder()
	return p
end

local function rarityOf(model: Model): string
	local attr = model:GetAttribute("Rarity")
	if type(attr) == "string" and attr ~= "" then
		return attr
	end
	for _, name in Economy.CHEST_RARITIES do
		if string.find(model.Name, name, 1, true) == 1 then
			return name
		end
	end
	return "Common"
end

local function rankOf(rarity: string): number
	local index = table.find(Economy.CHEST_RARITIES, rarity)
	if index then
		return index - 1
	end
	return if rarity == "Mythic" then 5 else 1
end

local function backOut(x: number): number
	local c1 = 1.9
	local c3 = c1 + 1
	local y = x - 1
	return 1 + c3 * y * y * y + c1 * y * y
end

local function smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

local function nearCamera(pos: Vector3, range: number): boolean
	local camera = Workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - pos).Magnitude <= range
end

local function localRoot(): BasePart?
	local character = Players.LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function playerNear(pos: Vector3, range: number): boolean
	local root = localRoot()
	return root ~= nil and (root.Position - pos).Magnitude <= range
end

local function holdingCrate(): boolean
	local held = State.data and State.data.heldChest
	return type(held) == "string" and held ~= ""
end

-- Body visibility, and the label / sparkles (only live once landed).
local function setShown(crate: Crate, body: boolean, extras: boolean)
	for _, part in crate.parts do
		part.LocalTransparencyModifier = if body then 0 else 1
	end
	for _, d in crate.model:GetDescendants() do
		if d:IsA("BillboardGui") or d:IsA("Sparkles") then
			d.Enabled = extras
		end
	end
end

local function smokePuff(pos: Vector3, count: number, speed: number)
	local holder = fxPart(Enum.PartType.Block, "CrateDust", WHITE)
	holder.Size = Vector3.one * 0.2
	holder.Transparency = 1
	holder.CFrame = CFrame.new(pos)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SMOKE
	emitter.Color = ColorSequence.new(Color3.fromRGB(225, 215, 200))
	emitter.LightEmission = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 2.6),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.4, 0.7)
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(85, 85)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Drag = 6
	if PUFF then
		emitter.Rotation = NumberRange.new(-180, 180)
		emitter.RotSpeed = NumberRange.new(-30, 30)
	end
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(Budget.count(count))
	task.delay(1.2, function()
		holder:Destroy()
	end)
end

-- Rarity label ------------------------------------------------------------------------

-- The rarity word ("Common", ...) as floating bold text in the rarity colour with a dark Ink
-- outline, parented to the client-only ground disc and adorned to the crate's primary part so
-- it follows the bob.
local function makeChip(rarity: string, color: Color3, adornee: BasePart, above: number, parent: Instance): BillboardGui
	local word = string.upper(string.sub(rarity, 1, 1)) .. string.lower(string.sub(rarity, 2))
	local gui = Instance.new("BillboardGui")
	gui.Name = "RarityChip"
	gui.Adornee = adornee
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = CHIP_RANGE
	gui.Size = UDim2.new((0.6 + #word * 0.82) * CHIP_SCALE, #word * CHIP_PX_PER_LETTER, CHIP_HEIGHT * CHIP_SCALE, CHIP_PX_HEIGHT)
	gui.StudsOffset = Vector3.new(0, above + 0.3, 0)
	gui.Enabled = false
	gui.Parent = parent
	local pill = Instance.new("Frame")
	pill.Name = "Pill"
	pill.AnchorPoint = Vector2.new(0.5, 0.5)
	pill.Position = UDim2.fromScale(0.5, 0.5)
	pill.Size = UDim2.fromScale(1, 1)
	pill.BackgroundTransparency = 1
	pill.BorderSizePixel = 0
	pill.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 0.7
	scale.Parent = pill
	local text = Instance.new("TextLabel")
	text.Name = "Word"
	text.BackgroundTransparency = 1
	text.AnchorPoint = Vector2.new(0.5, 0.5)
	text.Position = UDim2.fromScale(0.5, 0.5)
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Theme.Fonts.Title
	text.TextScaled = true
	text.Text = word
	text.TextColor3 = color
	text.TextTransparency = 1
	text.Parent = pill
	local outline = Instance.new("UIStroke")
	outline.Color = INK
	outline.Thickness = 2.5
	outline.LineJoinMode = Enum.LineJoinMode.Round
	outline.Transparency = 1
	outline.Parent = text
	return gui
end

-- Fades the crate's label in (small grow) or out (then disables it).
local function fadeChip(crate: Crate, on: boolean)
	if crate.chipOn == on then
		return
	end
	crate.chipOn = on
	crate.chipToken += 1
	local token = crate.chipToken
	local gui = crate.chip
	local pill = gui:FindFirstChild("Pill") :: Frame?
	local text = pill and pill:FindFirstChild("Word") :: TextLabel?
	if not pill or not text then
		return
	end
	local outline = text:FindFirstChildOfClass("UIStroke") :: UIStroke
	local scale = pill:FindFirstChildOfClass("UIScale") :: UIScale
	local info = if on
		then TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	if on then
		gui.Enabled = true
	end
	TweenService:Create(outline, info, { Transparency = if on then 0 else 1 }):Play()
	local grow = if on then TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out) else info
	TweenService:Create(scale, grow, { Scale = if on then 1 else 0.7 }):Play()
	local fade = TweenService:Create(text, info, { TextTransparency = if on then 0 else 1 })
	if not on then
		fade.Completed:Once(function()
			if crate.chipToken == token then
				gui.Enabled = false
			end
		end)
	end
	fade:Play()
end

-- True while the held-crate panel is open (PlayerGui.TycoonUI's CratePanelOpen attribute).
local function cratePanelOpen(): boolean
	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local ui = playerGui and playerGui:FindFirstChild("TycoonUI")
	return ui ~= nil and ui:GetAttribute("CratePanelOpen") == true
end

local lastChipScan = 0

-- Labels show over every landed crate (BillboardGui.MaxDistance limits the range), except
-- while the held-crate panel is open.
local function scanChips(now: number)
	if now - lastChipScan < CHIP_SCAN then
		return
	end
	lastChipScan = now
	local hidden = cratePanelOpen()
	for model, crate in crates do
		local want = crate.landed and model.Parent ~= nil and not hidden
		fadeChip(crate, want)
	end
end

-- Places every part: `cf` is the animated pivot; (sx, sy) scale around the crate bottom.
local function place(crate: Crate, cf: CFrame, sx: number, sy: number)
	local scaled = sx ~= 1 or sy ~= 1
	local scale = Vector3.new(sx, sy, sx)
	local bottom = Vector3.new(0, crate.bottom, 0)
	for i, part in crate.parts do
		local offset = crate.offsets[i]
		if scaled then
			local p = (offset.Position - bottom) * scale + bottom
			offset = CFrame.new(p) * offset.Rotation
			part.Size = crate.sizes[i] * scale
		elseif not crate.restored then
			part.Size = crate.sizes[i]
		end
		table.insert(moveParts, part)
		table.insert(moveCFrames, cf * offset)
	end
	crate.restored = not scaled
end

-- Arrival route ---------------------------------------------------------------------------

-- Distance covered after t seconds starting at v0, accelerating at `a` up to vmax.
local function accelDist(t: number, v0: number, a: number, vmax: number): number
	local tCap = math.max((vmax - v0) / a, 0)
	if t <= tCap then
		return v0 * t + 0.5 * a * t * t
	end
	return v0 * tCap + 0.5 * a * tCap * tCap + vmax * (t - tCap)
end

-- Time to cover `len`, and the speed at the end.
local function accelTime(len: number, v0: number, a: number, vmax: number): (number, number)
	local tCap = math.max((vmax - v0) / a, 0)
	local dCap = v0 * tCap + 0.5 * a * tCap * tCap
	if len <= dCap then
		local t = (-v0 + math.sqrt(v0 * v0 + 2 * a * len)) / a
		return t, v0 + a * t
	end
	return tCap + (len - dCap) / vmax, vmax
end

local function readRoute(model: Model): Orbs.Route?
	return Orbs.readRoute(model, "Path")
end

local function flatDir(v: Vector3): Vector3?
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else nil
end

-- Builds the arrival legs; returns them and the touchdown time.
local function buildLegs(route: Orbs.Route?, landing: Vector3): ({ Leg }, number)
	local legs: { Leg } = {}
	local t, turned = 0, 0
	local function add(kind: string, from: Vector3, to: Vector3, dur: number, tumbles: number, apex: number?)
		table.insert(legs, {
			kind = kind,
			from = from,
			to = to,
			t0 = t,
			dur = dur,
			apex = apex or 0,
			v0 = 0,
			accel = 0,
			vmax = 0,
			tumbles = tumbles,
			turned = turned,
			face = CFrame.identity,
			faceFrom = CFrame.identity,
		})
		t += dur
		turned += tumbles
		return legs[#legs]
	end
	local chuteEnd: Vector3
	-- Facing for the fall: along the gutter, so the crate's long side never points into the rack.
	local fallFace: Vector3? = nil
	if route then
		local feet, drop, gutter, top, bottom = route.feet, route.drop, route.gutter, route.chuteTop, route.chuteBottom
		-- Pops out just in front of the Chad, hops low (under the shelf above) to the drop point.
		local out = flatDir(drop - feet) or flatDir(gutter - feet) or Vector3.new(0, 0, -1)
		local start = feet + out * POP_FORWARD + UP * POP_UP
		add("pop", start, start, POP, 0)
		local hopLen = Vector3.new(drop.X - start.X, 0, drop.Z - start.Z).Magnitude
		add("hop", start, drop, math.clamp(0.3 + hopLen * 0.025, HOP_MIN, HOP_MAX), 1, HOP_APEX)
		-- Falls with gravity-like easing (capped so the top shelf stays snappy) and bounces.
		local fall = drop.Y - gutter.Y
		if fall > 0.05 or (drop - gutter).Magnitude > 0.05 then
			local dur = math.clamp(math.sqrt(2 * math.max(fall, 0) / FALL_G), 0.12, FALL_MAX)
			add("fall", drop, gutter, dur, if fall > 12 then 1 else 0)
			fallFace = flatDir(top - gutter) or Vector3.xAxis
		end
		local gDir = flatDir(top - gutter)
		local gLen = (top - gutter).Magnitude
		local bounce = math.clamp(fall * 0.03, 0.25, 0.9)
		local hop = if gDir then math.min(gLen * 0.3, 1.2) else 0
		local landed = gutter + (if gDir then gDir * hop else Vector3.zero)
		add("arc", gutter, landed, 0.12 + bounce * 0.2, 0, bounce)
		local sLen = (top - landed).Magnitude
		local vEnd = GUTTER_V0
		if sLen > 0.05 then
			local dur, v = accelTime(sLen, GUTTER_V0, GUTTER_ACCEL, GUTTER_VMAX)
			local leg = add("slide", landed, top, dur, if sLen > 6 then 1 else 0)
			leg.v0, leg.accel, leg.vmax = GUTTER_V0, GUTTER_ACCEL, GUTTER_VMAX
			vEnd = v
		end
		local cLen = (bottom - top).Magnitude
		if cLen > 0.05 then
			local v0 = math.clamp(vEnd * 0.8, 3, CHUTE_VMAX)
			local dur = accelTime(cLen, v0, CHUTE_ACCEL, CHUTE_VMAX)
			local leg = add("slide", top, bottom, dur, 1)
			leg.v0, leg.accel, leg.vmax = v0, CHUTE_ACCEL, CHUTE_VMAX
		end
		chuteEnd = bottom
	else
		chuteEnd = landing + UP * FALLBACK_DROP
		add("pop", chuteEnd, chuteEnd, POP, 0)
	end
	local mid = chuteEnd:Lerp(landing, BOUNCE1_SHARE)
	mid = Vector3.new(mid.X, landing.Y, mid.Z)
	add("arc", chuteEnd, mid, BOUNCE1, 1, BOUNCE1_APEX)
	add("arc", mid, landing, BOUNCE2, 0, BOUNCE2_APEX)

	-- Facing per leg (long side along the travel direction), turning smoothly from the
	-- previous leg's. Legs without horizontal travel keep the facing they inherit.
	local dirs: { Vector3? } = {}
	for i, leg in legs do
		dirs[i] = if leg.kind == "fall" then fallFace else flatDir(leg.to - leg.from)
	end
	local prev: Vector3? = nil
	for i = 1, #legs do
		prev = dirs[i] or prev
		if not prev then
			for j = i + 1, #legs do
				prev = prev or dirs[j]
			end
		end
		dirs[i] = prev
	end
	local last = CFrame.identity
	for i, leg in legs do
		local d = dirs[i]
		leg.face = if d then CFrame.fromMatrix(Vector3.zero, d, UP) else CFrame.identity
		leg.faceFrom = if i == 1 then leg.face else last
		last = leg.face
	end
	return legs, t
end

-- Pivot CFrame and uniform scale at `t` seconds into the arrival (t < crate.land).
local function sampleArrival(crate: Crate, t: number): (CFrame, number)
	local legs = crate.legs
	local leg = legs[#legs]
	for _, l in legs do
		if t < l.t0 + l.dur then
			leg = l
			break
		end
	end
	local u = math.clamp((t - leg.t0) / math.max(leg.dur, 1e-3), 0, 1)
	local pos: Vector3
	if leg.kind == "slide" then
		local len = (leg.to - leg.from).Magnitude
		local s = math.min(accelDist(t - leg.t0, leg.v0, leg.accel, leg.vmax), len)
		pos = leg.from:Lerp(leg.to, if len > 0 then s / len else 1)
	elseif leg.kind == "pop" then
		pos = leg.from
	elseif leg.kind == "fall" then
		pos = leg.from:Lerp(leg.to, u * u)
	else
		pos = leg.from:Lerp(leg.to, u) + UP * (leg.apex * 4 * u * (1 - u))
	end

	-- Facing: the long side along the direction of travel, turning in over the leg's start.
	local facing = leg.faceFrom:Lerp(leg.face, smooth(u / 0.35))

	-- Quarter-turn tumbles, centred in the leg, rising onto an edge mid-turn.
	local spin = leg.turned
	if leg.tumbles > 0 then
		spin += leg.tumbles * smooth((u - 0.3) / 0.4)
	end
	local wobble = 0
	if leg.kind == "slide" then
		wobble = 1
	end
	local wob = CFrame.Angles(math.sin(t * 13) * 0.12 * wobble, math.sin(t * 7.5) * 0.08 * wobble, 0)
	local rot = facing * wob * CFrame.Angles(0, 0, -spin * math.pi / 2)

	-- Grow back to full size and turn to the resting angle over the two bounces.
	local scale = TRAVEL_SCALE
	if leg.kind == "pop" then
		scale = TRAVEL_SCALE * backOut(u)
	end
	local bounceStart = legs[#legs - 1].t0
	if t >= bounceStart then
		local g = smooth((t - bounceStart) / (crate.land - bounceStart))
		scale = TRAVEL_SCALE + (1 - TRAVEL_SCALE) * g
		rot = rot:Lerp(crate.base.Rotation, smooth((t - bounceStart) / (crate.land - bounceStart) * 1.3 - 0.3))
	end
	scale = math.max(scale, 0.02)

	-- Turn about the (scaled) box's middle and rest it on the surface below the path point,
	-- so it rises onto an edge mid-tumble and lies flat on any face.
	local half = crate.half
	local upLocal = rot:VectorToObjectSpace(UP)
	local support = scale * (math.abs(upLocal.X) * half.X + math.abs(upLocal.Y) * half.Y + math.abs(upLocal.Z) * half.Z)
	local surfaceY = pos.Y + crate.bottom
	local midLocal = (crate.mid - crate.bottom) * scale + crate.bottom
	local centre = Vector3.new(pos.X, surfaceY + support, pos.Z)
	return CFrame.new(centre) * rot * CFrame.new(0, -midLocal, 0), scale
end

-- The Chad standing at the crate's Origin, if it is one of this plot's units.
local function sourceUnit(model: Model): Model?
	local origin = model:GetAttribute("Origin")
	local plot = model.Parent and model.Parent.Parent
	local units = plot and plot:FindFirstChild("Units")
	if typeof(origin) ~= "Vector3" or not units then
		return nil
	end
	local best, bestDist = nil, 2
	for _, unit in units:GetChildren() do
		if unit:IsA("Model") then
			local d = (unit:GetPivot().Position - origin).Magnitude
			if d < bestDist then
				best, bestDist = unit, d
			end
		end
	end
	return best
end

-- Spawn / idle --------------------------------------------------------------------------

local function thud(crate: Crate, floor: Vector3, k: number)
	local size = (1 + crate.rank * 0.25) * k
	Orbs.ring(floor + Vector3.new(0, 0.12, 0), Color3.fromRGB(235, 225, 210), 4.5 * size, 0.45, 0.3)
	Orbs.ring(floor + Vector3.new(0, 0.18, 0), crate.color, 3 * size, 0.5, 0.1)
	smokePuff(floor + Vector3.new(0, 0.3, 0), math.floor((8 + crate.rank * 2) * k), 9 * k)
	if k >= 1 then
		Orbs.sparkle(floor + Vector3.new(0, 1.5, 0), crate.color, 10 + crate.rank * 3, 0.9 + crate.rank * 0.1)
		if crate.rank >= 2 then
			if playerNear(floor, 70) then
				Camera.shake(0.04 + crate.rank * 0.04, 0.2)
			end
		end
	end
end

local function stepCrate(crate: Crate, now: number)
	local base = crate.base
	local t = now - crate.born
	local floor = base.Position + Vector3.new(0, crate.bottom, 0)
	local rank = crate.rank

	if t < crate.land then
		if not crate.shown then
			crate.shown = true
			setShown(crate, true, false)
			local start = crate.legs[1].from
			smokePuff(start, 6, 6)
			Sounds.play("Tick", 0.1, 0.6 + rank * 0.1)
			if crate.source then
				Animator.show(crate.source, nil, 0.8, 0.6)
			end
		end
		local last = crate.legs[#crate.legs]
		if not crate.bounced and t >= last.t0 then
			crate.bounced = true
			thud(crate, last.from + Vector3.new(0, crate.bottom, 0), 0.5)
		end
		local cf, s = sampleArrival(crate, t)
		place(crate, cf, s, s)
		return
	end
	if not crate.landed then
		crate.landed = true
		setShown(crate, true, true)
		thud(crate, floor, 1)
	end
	local q = t - crate.land
	local idleT = now + crate.phase
	-- Idle motion fades in after the landing so the two blend.
	local blend = smooth((q - SQUASH * 0.5) / 0.6)
	local amp = 0.15 + rank * 0.07
	local lift = amp * (0.5 - 0.5 * math.cos(idleT * 2.2)) * blend
	local yaw = (idleT * (0.3 + rank * 0.08)) % (math.pi * 2)
	local sway = math.sin(idleT * 1.6) * (0.03 + rank * 0.01) * blend
	-- "Can't" wiggle: the player stands in pickup range but already holds a crate.
	if q > SQUASH and now - crate.wiggleAt >= CratePickup.WIGGLE_GAP and holdingCrate() then
		local root = localRoot()
		local offset = root and base.Position - root.Position
		if offset and CratePickup.inRange(offset.X, offset.Y, offset.Z) then
			crate.wiggleAt = now
			Sounds.play("Tick", 0.06, 0.45)
		end
	end
	local w = now - crate.wiggleAt
	local wiggle = if w < WIGGLE then math.sin(w / WIGGLE * math.pi * 4) * 0.14 * (1 - w / WIGGLE) else 0
	local cf = base * CFrame.new(0, lift, 0) * CFrame.Angles(0, yaw * blend, 0) * CFrame.Angles(sway, 0, sway * 0.6 + wiggle)
	if q < SQUASH then
		-- Damped spring: squash flat on impact, overshoot tall, settle.
		local sy = 1 - 0.34 * math.exp(-6 * q) * math.cos(q * 16)
		place(crate, cf, 1 / math.sqrt(sy), sy)
	else
		place(crate, cf, 1, 1)
	end

	-- Soft ground disc, gently pulsing, sized by rarity.
	local pulse = 0.5 + 0.5 * math.sin(now * (1.6 + rank * 0.35) + crate.phase)
	local landIn = math.clamp(q / 0.3, 0, 1)
	local radius = (2.2 + rank * 0.35) * (1 + 0.08 * pulse - lift * 0.15) * backOut(landIn)
	crate.disc.Size = Vector3.new(0.05, math.max(radius * 2, 0.05), math.max(radius * 2, 0.05))
	crate.disc.CFrame = CFrame.new(floor + Vector3.new(0, 0.07, 0)) * UPRIGHT
	local quiet = if rank == 0 then 0.82 else 0.7 - rank * 0.06
	crate.disc.Transparency = math.clamp(quiet - 0.12 * pulse, 0.35, 0.95)
end

local function step()
	if crateCount == 0 then
		return
	end
	local now = os.clock()
	table.clear(moveParts)
	table.clear(moveCFrames)
	idleFrame += 1
	local low = Budget.low()
	local cull = if low then LOW_CULL else CULL
	local skipIdle = low and idleFrame % 2 == 0
	for model, crate in crates do
		if not model.Parent or crate.broken then
			continue
		end
		local intro = now - crate.born < crate.land + SQUASH + 0.6
		if not intro and (skipIdle or not nearCamera(crate.base.Position, cull)) then
			continue
		end
		local ok, err = pcall(stepCrate, crate, now)
		if not ok then
			warn("[Fx.Crates] " .. tostring(err))
			crate.broken = true
			-- Leave it in place: back on its spot, full size, label live.
			table.clear(moveParts)
			table.clear(moveCFrames)
			crate.restored = false
			place(crate, crate.base, 1, 1)
			setShown(crate, true, true)
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	scanChips(now)
end

-- Tracking ------------------------------------------------------------------------------

local function track(model: Instance, intro: boolean)
	if not model:IsA("Model") or crates[model] or crateCount >= MAX_CRATES then
		return
	end
	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not primary then
		return
	end
	local base = model:GetPivot()
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local sizes: { Vector3 } = {}
	local bottom = 0
	local hx, hz, top = 0, 0, 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			local offset = base:ToObjectSpace(d.CFrame)
			table.insert(offsets, offset)
			table.insert(sizes, d.Size)
			bottom = math.min(bottom, offset.Y - d.Size.Y / 2)
			top = math.max(top, offset.Y + d.Size.Y / 2)
			hx = math.max(hx, math.abs(offset.X) + d.Size.X / 2)
			hz = math.max(hz, math.abs(offset.Z) + d.Size.Z / 2)
		end
	end
	if #parts == 0 then
		return
	end
	local rarity = rarityOf(model)
	local rank = rankOf(rarity)
	local color = (Theme.Colors.Rarity and Theme.Colors.Rarity[rarity]) or WHITE
	local disc = fxPart(Enum.PartType.Cylinder, "CrateGlow", color)
	disc.Transparency = 1
	local primaryY = base:ToObjectSpace(primary.CFrame).Y
	local chip = makeChip(rarity, color, primary, top - primaryY + 0.75, disc)
	local legs, land = buildLegs(readRoute(model), base.Position)
	local crate: Crate = {
		model = model,
		base = base,
		parts = parts,
		offsets = offsets,
		sizes = sizes,
		bottom = bottom,
		half = Vector3.new(hx, (top - bottom) / 2, hz),
		mid = (top + bottom) / 2,
		rarity = rarity,
		rank = rank,
		color = color,
		born = if intro then os.clock() else os.clock() - land - 10,
		land = land,
		legs = legs,
		bounced = not intro,
		source = if intro then sourceUnit(model) else nil,
		wiggleAt = -math.huge,
		phase = math.random() * 10,
		disc = disc,
		chip = chip,
		chipOn = false,
		chipToken = 0,
		shown = not intro,
		landed = not intro,
		restored = true,
		broken = false,
	}
	if intro then
		setShown(crate, false, false)
	end
	crates[model] = crate
	crateCount += 1
end

local function untrack(model: Instance)
	local crate = crates[model :: Model]
	if not crate then
		return
	end
	crates[model :: Model] = nil
	crateCount -= 1
	local floor = crate.base.Position + Vector3.new(0, crate.bottom, 0)
	fadeChip(crate, false)
	-- Pickup puff where it stood; the disc shrinks away.
	Orbs.sparkle(floor + Vector3.new(0, 1.5, 0), crate.color, 14, 0.8)
	Orbs.ring(floor + Vector3.new(0, 0.15, 0), crate.color, 3, 0.35, 0.2)
	local disc = crate.disc
	TweenService:Create(disc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
		Size = Vector3.new(0.05, 0.05, 0.05),
		Transparency = 1,
	}):Play()
	task.delay(0.3, function()
		disc:Destroy()
	end)
end

local boundFolder: Instance? = nil
local folderConns: { RBXScriptConnection } = {}

local function bindFolder(f: Instance)
	if f == boundFolder then
		return
	end
	boundFolder = f
	for _, conn in folderConns do
		conn:Disconnect()
	end
	table.clear(folderConns)
	for model in crates do
		untrack(model)
	end
	for _, child in f:GetChildren() do
		track(child, false)
	end
	table.insert(
		folderConns,
		f.ChildAdded:Connect(function(child)
			-- Let the whole model replicate before capturing its parts.
			task.defer(track, child, true)
		end)
	)
	table.insert(folderConns, f.ChildRemoved:Connect(untrack))
end

local function refresh()
	local data = State.data
	local map = Workspace:FindFirstChild("Map")
	if not data or not map or not data.plotIndex then
		return
	end
	local plot = map:FindFirstChild("Plot" .. tostring(data.plotIndex))
	if not plot then
		return
	end
	local f = plot:FindFirstChild("Chests")
	if f then
		bindFolder(f)
	end
end

function Crates.init()
	if started then
		return
	end
	started = true
	RunService.Heartbeat:Connect(step)
	State.changed.Event:Connect(refresh)
	refresh()
end

return Crates
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="225">
            <Properties>
              <string name="Name">Fans</string>
              <string name="Source"><![CDATA[--[[
	Fx.Fans: the fan club around every plot (client-side only).

	World contract: workspace.Map.Plot<n>.FanSpots holds invisible parts named
	"FanSpot" (attribute Order, 1 = filled first; CFrame at ground level with
	LookVector toward the unit display; optional Vector3 attribute Entrance =
	the world point that spot's fan runs in from and walks off to: the back of
	its own zone column, so fans never cross the rack). Without it, an optional
	part "FanEntrance" in the same folder (ground level) is used, else a point
	behind the fan zone. The folder may be missing or arrive late: plots without
	it simply have no fans.

	- Count: clamp(Base + floor(bestTier * PerTier), 1, Max) fans on the local
	  player's plot, at most MaxOther on other plots within ~150 studs of the
	  camera; plots without units have none (Theme.Fans).
	- Looks are picked per plot + spot, so a plot's crowd never reshuffles.
	- New fans run in from the entrance, fade in, and settle with a little hop;
	  when the count drops the extra fans wave and walk off.
	- Idle: a slow mix of Idle / Clap / Wave / SignUp with random offsets.
	- The owner's Buy / Merge effects make the nearest fans Cheer or Jump with
	  hearts and stars floating up and, at most every BUBBLE_GAP seconds, one
	  speech bubble (Theme.Fans.Cheers). A new-tier reward makes the whole zone
	  cheer for 2 seconds.

	Fans are built with CharacterFactory (manual rigs, not the Animator) and
	posed here with RigPose: one RenderStepped loop, at most MAX_ANIMATED fans
	near the camera (the rest hold still, re-placed once per state change),
	everything written with one BulkMoveTo. On "mid" / "low" devices (Fx.Budget)
	fewer fans are posed (MAX_ANIMATED and MAX_PARTICLES scaled by Budget.count)
	and on low the posed ones update every 2nd frame (every 3rd past NEAR).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CharacterFactory = require(Shared:WaitForChild("CharacterFactory"))
local Net = require(Shared:WaitForChild("Net"))
local Poses = require(Shared:WaitForChild("Poses"))
local RigPose = require(Shared:WaitForChild("RigPose"))
local Theme = require(ReplicatedStorage:WaitForChild("Theme"))

local State = require(script.Parent.Parent.State)
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)

local Fans = {}

local W = Theme.World
local CFG = Theme.Fans

local MAX_ANIMATED = 16 -- fans posed per frame (the nearest to the camera)
local ANIM_RANGE = 160 -- studs: beyond this fans hold still
local NEAR = 60 -- studs: closer than this fans update every frame (else every 2nd)
local SHOW_OTHER = 150 -- studs: other plots' fans appear inside this range ...
local HIDE_OTHER = 170 -- ... and vanish outside this one
local POLL = 0.5 -- seconds between plot scans
local RANK_EVERY = 0.25 -- seconds between nearest-fan picks
local SPAWN_STAGGER = 0.35 -- seconds between fans of one plot starting their run
local ENTRANCE_BACK = 24 -- studs behind the fan zone when there is no FanEntrance
local LANE = 1.6 -- studs between the running lanes of neighbouring spots
local FADE = 0.35 -- seconds to fade in at the entrance / out at the exit
local SETTLE = 0.5 -- seconds of the arrival hop
local HOP = 0.6 -- arrival hop height (unscaled studs)
local TURN = 0.35 -- seconds to turn from waving to walking off
local LEAVE_WAVE = 1.1 -- seconds of goodbye wave before walking off
local POSE_BLEND = 0.4
local CHEER_GAP = 0.8 -- seconds between Buy / Merge cheers
local CHEER_LENGTH = 1.5
local REWARD_LENGTH = 2
local BUBBLE_GAP = 6
local BUBBLE_LIFE = 2.2
local MAX_PARTICLES = 24

local IDLE_POSES = { "Idle", "Idle", "Clap", "Wave", "SignUp" }
local CHEER_POSES = { "Cheer", "Jump", "Cheer" }
-- Text glyph, its colour, and the sprite drawn instead when uploaded.
local GLYPHS = {
	{ "♥", W.Pink, "Heart" },
	{ "♥", W.Coral, "Heart" },
	{ "★", W.Sunny, "StarPop" },
	{ "★", W.Orange, "StarPop" },
}
local RUN_SPEED = Poses.GAIT.Run.speed
local WALK_SPEED = Poses.GAIT.Walk.speed

type Spot = { order: number, cf: CFrame, entrance: Vector3? }

type PlotRec = {
	index: number,
	folder: Instance,
	group: Folder,
	spots: { Spot },
	fans: { [number]: Fan }, -- by spot index
	pending: { [number]: boolean },
	entrance: Vector3,
	center: Vector3,
	right: Vector3,
	want: number,
	shown: boolean,
	lastBubble: number,
}

-- state: "enter" (running to the spot) | "settle" (hop) | "idle" | "leave"
-- (goodbye wave) | "exit" (walking off) | "dead"
type Fan = {
	model: Model,
	rig: RigPose.Rig,
	plot: PlotRec,
	exit: Vector3, -- where it walks off to (its spot's entrance)
	slot: number,
	scale: number,
	height: number,
	random: Random,
	state: string,
	stateStart: number,
	from: Vector3,
	to: Vector3,
	length: number,
	moveYaw: number,
	spotYaw: number,
	clockBase: number, -- pose time = now - clockBase while standing
	gaitEnd: number,
	-- Current frame (written by advance, read by draw).
	pos: Vector3,
	yaw: number,
	lift: number,
	pose: string,
	prevPose: string?,
	poseStart: number,
	poseEnd: number,
	poseTime: number,
	alpha: number,
	fade: number,
	fadeShown: number,
	fadeParts: { BasePart },
	guis: { LayerCollector },
	dist: number,
	animated: boolean,
	drawnState: string, -- state of the last draw (fans that are not animated draw once per state)
}

local plots: { [number]: PlotRec } = {}
local allFans: { Fan } = {}
local ranked: { Fan } = {}
local spawnQueue: { { rec: PlotRec, spot: number, at: number } } = {}
local bulkParts: { BasePart } = {}
local bulkCFrames: { CFrame } = {}
local root: Folder? = nil
local fxAnchor: Part? = nil
local slotCounter = 0
local frameCount = 0
local nextRank = 0
local lastCheer = 0
local particles = 0
local started = false
local warned = false

local function smooth(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- Yaw (about +Y) that turns a -Z-facing model to face `dir`.
local function yawOf(dir: Vector3): number
	return math.atan2(-dir.X, -dir.Z)
end

local function lerpAngle(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

local function cameraPos(): Vector3
	local camera = Workspace.CurrentCamera
	return if camera then camera.CFrame.Position else Vector3.zero
end

local function folder(): Folder
	local existing = root
	if existing and existing.Parent then
		return existing
	end
	local made = Instance.new("Folder")
	made.Name = "FanClub"
	made.Parent = Workspace
	root = made
	return made
end

-- Spots -------------------------------------------------------------------------------

-- Reads the plot's FanSpots (sorted by Order) and derives the entrance and zone frame.
local function readSpots(rec: PlotRec)
	local spotsFolder = rec.folder:FindFirstChild("FanSpots")
	local list: { BasePart } = {}
	local entrancePart: BasePart? = nil
	if spotsFolder then
		for _, child in spotsFolder:GetChildren() do
			if child:IsA("BasePart") then
				if child.Name == "FanSpot" then
					table.insert(list, child)
				elseif child.Name == "FanEntrance" then
					entrancePart = child
				end
			end
		end
	end
	local function orderOf(part: BasePart): number
		local value = part:GetAttribute("Order")
		return if type(value) == "number" then value else math.huge
	end
	table.sort(list, function(a, b)
		local oa, ob = orderOf(a), orderOf(b)
		if oa ~= ob then
			return oa < ob
		end
		return a.Name < b.Name
	end)
	local spots: { Spot } = {}
	local sum, look = Vector3.zero, Vector3.zero
	for i, part in list do
		local order = orderOf(part)
		local entrance = part:GetAttribute("Entrance")
		spots[i] = {
			order = if order == math.huge then i else order,
			cf = part.CFrame,
			entrance = if typeof(entrance) == "Vector3" then entrance else nil,
		}
		sum += part.CFrame.Position
		local flat = part.CFrame.LookVector * Vector3.new(1, 0, 1)
		if flat.Magnitude > 1e-3 then
			look += flat.Unit
		end
	end
	rec.spots = spots
	if #list == 0 then
		return
	end
	rec.center = sum / #list
	local forward = if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)
	rec.right = forward:Cross(Vector3.yAxis)
	if entrancePart then
		rec.entrance = entrancePart.CFrame.Position
	else
		rec.entrance = rec.center - forward * ENTRANCE_BACK
	end
end

local function bestTier(rec: PlotRec): number
	local units = rec.folder:FindFirstChild("Units")
	local best = 0
	if units then
		for _, unit in units:GetChildren() do
			local tier = unit:GetAttribute("Tier")
			if type(tier) == "number" and tier > best then
				best = tier
			end
		end
	end
	return best
end

-- Fans --------------------------------------------------------------------------------

local function setState(fan: Fan, state: string, now: number)
	fan.state = state
	fan.stateStart = now
end

-- Starts a run from where the fan stands now to `target` (used after a spot moves).
local function moveTo(fan: Fan, target: CFrame, now: number)
	fan.prevPose = fan.pose
	fan.from = fan.pos
	fan.to = target.Position
	fan.spotYaw = yawOf(target.LookVector)
	local delta = (fan.to - fan.from) * Vector3.new(1, 0, 1)
	fan.length = delta.Magnitude
	fan.moveYaw = if fan.length > 1e-3 then yawOf(delta) else fan.spotYaw
	setState(fan, "enter", now)
end

local function startLeave(fan: Fan, now: number)
	if fan.state == "leave" or fan.state == "exit" or fan.state == "dead" then
		return
	end
	if fan.state == "idle" or fan.state == "settle" then
		fan.prevPose = fan.pose
		fan.pose = "Wave"
		fan.poseStart = now
		setState(fan, "leave", now)
	else
		-- Still running in: turn round and walk straight off.
		fan.prevPose = "Run"
		fan.clockBase = now - fan.gaitEnd
		fan.from = fan.pos
		local delta = (fan.exit - fan.pos) * Vector3.new(1, 0, 1)
		fan.to = fan.pos + delta
		fan.length = delta.Magnitude
		fan.spotYaw = fan.yaw
		fan.moveYaw = if fan.length > 1e-3 then yawOf(delta) else fan.yaw
		setState(fan, "exit", now)
	end
end

local function nextIdlePose(fan: Fan, now: number)
	local previous = fan.pose
	local name = previous
	for _ = 1, 4 do
		name = IDLE_POSES[fan.random:NextInteger(1, #IDLE_POSES)]
		if name ~= previous then
			break
		end
	end
	fan.prevPose = previous
	fan.pose = name
	fan.poseStart = now
	local hold = if name == "Idle" then fan.random:NextNumber(2.4, 4.5) else fan.random:NextNumber(1.8, 3.2)
	fan.poseEnd = now + hold
end

local function spawnFan(rec: PlotRec, index: number, now: number)
	local spot = rec.spots[index]
	if not spot or rec.fans[index] then
		return
	end
	local looks = CFG.Looks
	local look = table.clone(looks[(rec.index * 3 + spot.order * 5) % #looks + 1])
	look.manual = true
	local signs = CFG.Signs
	if look.prop == "FanSign" and signs and #signs > 0 then
		look.signText = signs[(rec.index + spot.order * 3) % #signs + 1]
	end
	local ok, built = pcall(CharacterFactory.build, look, "Fan")
	if not ok then
		if not warned then
			warned = true
			warn("[Fans] could not build a fan: " .. tostring(built))
		end
		return
	end
	local model = built :: Model
	local seed = rec.index * 131 + spot.order * 17
	local rig = RigPose.capture(model, seed)
	if not rig then
		model:Destroy()
		return
	end
	slotCounter += 1
	-- The spot's own entrance, else the shared one with a lane per spot.
	local lane = ((spot.order % 5) - 2) * LANE
	local shared = rec.entrance + rec.right * lane
	local start: Vector3 = spot.entrance or Vector3.new(shared.X, rec.entrance.Y, shared.Z)
	local exit = start
	local target = spot.cf.Position
	local delta = (target - start) * Vector3.new(1, 0, 1)
	local spotYaw = yawOf(spot.cf.LookVector)
	local height = model:GetAttribute("Height")
	local fan: Fan = {
		model = model,
		rig = rig,
		plot = rec,
		exit = exit,
		slot = slotCounter,
		scale = rig.scale,
		height = if type(height) == "number" then height else 5,
		random = Random.new(seed + slotCounter),
		state = "enter",
		stateStart = now,
		from = start,
		to = target,
		length = delta.Magnitude,
		moveYaw = if delta.Magnitude > 1e-3 then yawOf(delta) else spotYaw,
		spotYaw = spotYaw,
		clockBase = now,
		gaitEnd = 0,
		pos = start,
		yaw = 0,
		lift = 0,
		pose = "Run",
		prevPose = nil,
		poseStart = now,
		poseEnd = now,
		poseTime = 0,
		alpha = 1,
		fade = 1,
		fadeShown = 1,
		fadeParts = {},
		guis = {},
		dist = 0,
		animated = false,
		drawnState = "",
	}
	fan.yaw = fan.moveYaw
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d ~= rig.root then
				d.LocalTransparencyModifier = 1
				table.insert(fan.fadeParts, d)
			end
		elseif d:IsA("LayerCollector") then
			d.Enabled = false
			table.insert(fan.guis, d)
		end
	end
	-- Place it at the entrance, mid-stride and invisible, before it enters the world.
	rig.root.CFrame = CFrame.new(start) * CFrame.Angles(0, fan.yaw, 0)
	local parts, cframes = RigPose.computePose(rig, "Run", 0)
	for i, part in parts do
		part.CFrame = cframes[i]
	end
	model.Parent = rec.group
	rec.fans[index] = fan
	table.insert(allFans, fan)
end

-- Works out where the fan is and which pose it shows this frame (cheap; runs for every fan).
-- Returns false once the fan has finished leaving.
local function advance(fan: Fan, now: number): boolean
	local state = fan.state
	local t = now - fan.stateStart
	fan.lift = 0
	fan.alpha = 1
	if state == "enter" then
		local speed = RUN_SPEED * fan.scale
		local d = math.min(t * speed, fan.length)
		fan.pos = if fan.length > 0 then fan.from:Lerp(fan.to, d / fan.length) else fan.to
		fan.yaw = fan.moveYaw
		fan.pose = "Run"
		fan.gaitEnd = Poses.gaitTime("Run", d, fan.scale)
		fan.poseTime = fan.gaitEnd
		if fan.prevPose then
			fan.alpha = smooth(t / 0.3)
			if fan.alpha >= 1 then
				fan.prevPose = nil
			end
		end
		if fan.fade > 0 then
			fan.fade = 1 - math.clamp(t / FADE, 0, 1)
		end
		if d >= fan.length then
			fan.clockBase = now - fan.gaitEnd
			fan.prevPose = "Run"
			fan.pose = "Idle"
			setState(fan, "settle", now)
		end
	elseif state == "settle" then
		local u = math.clamp(t / SETTLE, 0, 1)
		fan.pos = fan.to
		fan.yaw = lerpAngle(fan.moveYaw, fan.spotYaw, smooth(u))
		fan.lift = HOP * fan.scale * 4 * u * (1 - u)
		fan.alpha = u
		fan.poseTime = now - fan.clockBase
		fan.fade = 0
		if u >= 1 then
			fan.prevPose = nil
			fan.pose = "Idle"
			fan.poseStart = now
			fan.poseEnd = now + fan.random:NextNumber(0.5, 3.5)
			setState(fan, "idle", now)
		end
	elseif state == "idle" or state == "leave" then
		fan.pos = fan.to
		fan.yaw = fan.spotYaw
		fan.poseTime = now - fan.clockBase
		if state == "idle" and now >= fan.poseEnd then
			nextIdlePose(fan, now)
		end
		if fan.prevPose then
			fan.alpha = smooth((now - fan.poseStart) / POSE_BLEND)
		end
		if state == "leave" and t >= LEAVE_WAVE then
			fan.from = fan.to
			local delta = (fan.exit - fan.to) * Vector3.new(1, 0, 1)
			fan.to = fan.from + delta
			fan.length = delta.Magnitude
			fan.moveYaw = if fan.length > 1e-3 then yawOf(delta) else fan.spotYaw
			fan.prevPose = fan.pose
			fan.clockBase = now - fan.poseTime
			setState(fan, "exit", now)
		end
	elseif state == "exit" then
		local speed = WALK_SPEED * fan.scale
		local duration = fan.length / speed
		local d = math.min(t * speed, fan.length)
		fan.pos = if fan.length > 0 then fan.from:Lerp(fan.to, d / fan.length) else fan.to
		local turn = smooth(t / TURN)
		fan.yaw = lerpAngle(fan.spotYaw, fan.moveYaw, turn)
		fan.pose = "Walk"
		fan.poseTime = (now - t - fan.clockBase) + Poses.gaitTime("Walk", d, fan.scale)
		if fan.prevPose then
			fan.alpha = turn
		end
		fan.fade = math.clamp((t - (duration - FADE)) / FADE, 0, 1)
		if t >= duration + 0.05 then
			return false
		end
	else
		return false
	end
	return true
end

-- Poses one fan and queues its parts for the frame's BulkMoveTo.
local function draw(fan: Fan)
	fan.drawnState = fan.state
	local rig = fan.rig
	local pos = fan.pos
	rig.root.CFrame = CFrame.new(pos.X, pos.Y + fan.lift, pos.Z) * CFrame.Angles(0, fan.yaw, 0)
	local from = if fan.alpha < 1 then fan.prevPose else nil
	local parts, cframes = RigPose.computePose(rig, fan.pose, fan.poseTime, from, if from then fan.alpha else nil)
	local n = #bulkParts
	for i = 1, #parts do
		bulkParts[n + i] = parts[i]
		bulkCFrames[n + i] = cframes[i]
	end
	if fan.fade ~= fan.fadeShown then
		fan.fadeShown = fan.fade
		for _, part in fan.fadeParts do
			part.LocalTransparencyModifier = fan.fade
		end
		local visible = fan.fade < 0.5
		for _, gui in fan.guis do
			gui.Enabled = visible
		end
	end
end

local function removeFan(index: number)
	local fan = allFans[index]
	allFans[index] = allFans[#allFans]
	allFans[#allFans] = nil
	fan.state = "dead"
	local rec = fan.plot
	for spot, other in rec.fans do
		if other == fan then
			rec.fans[spot] = nil
		end
	end
	fan.model:Destroy()
end

local function closer(a: Fan, b: Fan): boolean
	return a.dist < b.dist
end

-- Picks the fans that get posed: the nearest MAX_ANIMATED in front of the camera.
local function rank()
	local camera = Workspace.CurrentCamera
	local camPos = cameraPos()
	local camLook = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
	table.clear(ranked)
	for _, fan in allFans do
		fan.animated = false
		local offset = fan.pos - camPos
		fan.dist = offset.Magnitude
		if fan.dist <= ANIM_RANGE and offset:Dot(camLook) > -fan.height * 2 then
			table.insert(ranked, fan)
		end
	end
	local most = Budget.count(MAX_ANIMATED)
	if #ranked > most then
		table.sort(ranked, closer)
	end
	for i = 1, math.min(#ranked, most) do
		ranked[i].animated = true
	end
end

local function processQueue(now: number)
	local item = spawnQueue[1]
	if not item or item.at > now then
		return
	end
	table.remove(spawnQueue, 1)
	local rec = item.rec
	rec.pending[item.spot] = nil
	if plots[rec.index] == rec and item.spot <= rec.want and not rec.fans[item.spot] then
		spawnFan(rec, item.spot, now)
	end
end

local function step()
	frameCount += 1
	local now = os.clock()
	processQueue(now)
	if now >= nextRank then
		nextRank = now + RANK_EVERY
		rank()
	end
	table.clear(bulkParts)
	table.clear(bulkCFrames)
	local low = Budget.low()
	local i = 1
	while i <= #allFans do
		local fan = allFans[i]
		if advance(fan, now) then
			if fan.animated then
				local rate = if fan.dist < NEAR then (if low then 2 else 1) else (if low then 3 else 2)
				if rate == 1 or (frameCount + fan.slot) % rate == 0 then
					draw(fan)
				end
			elseif fan.drawnState ~= fan.state then
				-- Beyond the animated few: still put it where its new state belongs, once.
				draw(fan)
			end
			i += 1
		else
			removeFan(i)
		end
	end
	if #bulkParts > 0 then
		Workspace:BulkMoveTo(bulkParts, bulkCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Cheering ----------------------------------------------------------------------------

local function burst(position: Vector3, count: number)
	local anchor = fxAnchor
	if not anchor or not anchor.Parent then
		local part = Instance.new("Part")
		part.Name = "FanFx"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = Vector3.one * 0.2
		part.CFrame = CFrame.new()
		part.Parent = folder()
		fxAnchor = part
		anchor = part
	end
	local cap = Budget.count(MAX_PARTICLES)
	for _ = 1, Budget.count(count) do
		if particles >= cap then
			return
		end
		particles += 1
		local glyph = GLYPHS[math.random(1, #GLYPHS)]
		local delay = math.random() * 0.3
		local start = position + Vector3.new((math.random() - 0.5) * 1.6, math.random() * 0.4, (math.random() - 0.5) * 1.6)
		local rise = 2.6 + math.random() * 1.4
		local drift = Vector3.new((math.random() - 0.5) * 1.2, rise, (math.random() - 0.5) * 1.2)
		local sprite = Sprites.billboard(anchor, glyph[3], {
			position = start,
			size = 0.9 + math.random() * 0.4,
			rise = drift,
			life = 1.5,
			delay = delay,
			spin = (math.random() - 0.5) * 40,
		})
		if sprite then
			task.delay(delay + 1.6, function()
				particles -= 1
			end)
			continue
		end
		local attachment = Instance.new("Attachment")
		attachment.Name = "FanSpark"
		attachment.Position = start
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromScale(1.1, 1.1)
		gui.LightInfluence = 0
		gui.MaxDistance = 80
		gui.Adornee = attachment
		gui.Parent = attachment
		local scale = Instance.new("UIScale")
		scale.Scale = 0
		scale.Parent = gui
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Theme.Fonts.Number
		label.TextScaled = true
		label.Text = glyph[1]
		label.TextColor3 = glyph[2]
		label.TextStrokeColor3 = W.White
		label.TextStrokeTransparency = 0.15
		label.Parent = gui
		attachment.Parent = anchor
		TweenService:Create(scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delay), { Scale = 1 })
			:Play()
		TweenService:Create(
			attachment,
			TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay),
			{ Position = start + drift }
		):Play()
		TweenService:Create(
			label,
			TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, delay + 0.9),
			{ TextTransparency = 1, TextStrokeTransparency = 1 }
		):Play()
		task.delay(delay + 1.6, function()
			particles -= 1
			attachment:Destroy()
		end)
	end
end

local function showBubble(fan: Fan, now: number)
	local rec = fan.plot
	local cheers = CFG.Cheers
	if now - rec.lastBubble < BUBBLE_GAP or not cheers or #cheers == 0 or not fan.model.Parent then
		return
	end
	rec.lastBubble = now
	local text = cheers[math.random(1, #cheers)]
	local width = math.clamp(1.4 + #text * 0.34, 3.6, 7)
	local top = fan.height + 1.2

	local gui = Instance.new("BillboardGui")
	gui.Name = "FanBubble"
	gui.Size = UDim2.fromScale(width, 1.6)
	gui.StudsOffsetWorldSpace = Vector3.new(0, top - 0.4, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 45
	gui.Adornee = fan.rig.root
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = gui

	local function stroke(parent: GuiObject): UIStroke
		local s = Instance.new("UIStroke")
		s.Color = W.Ink
		s.Transparency = 0.7
		s.Thickness = 1.5
		s.Parent = parent
		return s
	end
	local tail = Instance.new("Frame")
	tail.Name = "Tail"
	tail.AnchorPoint = Vector2.new(0.5, 0.5)
	tail.Position = UDim2.fromScale(0.5, 0.74)
	tail.SizeConstraint = Enum.SizeConstraint.RelativeYY
	tail.Size = UDim2.fromScale(0.3, 0.3)
	tail.Rotation = 45
	tail.BackgroundColor3 = W.White
	tail.BorderSizePixel = 0
	tail.ZIndex = 1
	tail.Parent = gui
	local tailStroke = stroke(tail)
	local bubble = Instance.new("Frame")
	bubble.Name = "Bubble"
	bubble.Size = UDim2.fromScale(1, 0.78)
	bubble.BackgroundColor3 = W.White
	bubble.BorderSizePixel = 0
	bubble.ZIndex = 2
	bubble.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = bubble
	local bubbleStroke = stroke(bubble)
	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(0.84, 0.7)
	label.BackgroundTransparency = 1
	label.Font = Theme.Fonts.UI
	label.TextScaled = true
	label.TextColor3 = W.Ink
	label.Text = text
	label.ZIndex = 3
	label.Parent = bubble
	gui.Parent = fan.rig.root

	local popIn = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(scale, popIn, { Scale = 1 }):Play()
	TweenService:Create(gui, popIn, { StudsOffsetWorldSpace = Vector3.new(0, top, 0) }):Play()
	task.delay(BUBBLE_LIFE, function()
		if not gui.Parent then
			return
		end
		local out = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(scale, out, { Scale = 0.85 }):Play()
		TweenService:Create(bubble, out, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(tail, out, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, out, { TextTransparency = 1 }):Play()
		TweenService:Create(bubbleStroke, out, { Transparency = 1 }):Play()
		TweenService:Create(tailStroke, out, { Transparency = 1 }):Play()
		task.delay(0.32, function()
			gui:Destroy()
		end)
	end)
end

local function ownPlot(): PlotRec?
	local data = State.data
	local index = data and data.plotIndex
	return if type(index) == "number" then plots[index] else nil
end

-- Makes up to `count` standing fans of the local player's plot cheer (the nearest to
-- `near`, else the front rows) with hearts, stars and maybe a speech bubble.
local function cheer(count: number, duration: number, near: Vector3?)
	local rec = ownPlot()
	if not rec then
		return
	end
	local now = os.clock()
	local pick: { Fan } = {}
	for spot, fan in rec.fans do
		if fan.state == "idle" then
			fan.dist = if near then (fan.pos - near).Magnitude else spot
			table.insert(pick, fan)
		end
	end
	if #pick == 0 then
		return
	end
	table.sort(pick, closer)
	local n = math.min(count, #pick)
	for k = 1, n do
		local fan = pick[k]
		local start = now + (k - 1) * 0.07
		fan.prevPose = fan.pose
		fan.pose = CHEER_POSES[fan.random:NextInteger(1, #CHEER_POSES)]
		fan.poseStart = start
		fan.poseEnd = start + duration + fan.random:NextNumber(0, 0.3)
		if k <= 4 then
			burst(fan.pos + Vector3.new(0, fan.height + 0.3, 0), if n > 4 then 2 else 3)
		end
	end
	showBubble(pick[math.random(1, math.min(n, 3))], now)
end

-- Plot scan ---------------------------------------------------------------------------

local function dropPlot(rec: PlotRec)
	for _, fan in allFans do
		if fan.plot == rec then
			fan.state = "dead"
		end
	end
	table.clear(rec.fans)
	rec.group:Destroy()
end

local function newPlot(index: number, plotFolder: Instance): PlotRec
	local group = Instance.new("Folder")
	group.Name = "Plot" .. index
	group.Parent = folder()
	return {
		index = index,
		folder = plotFolder,
		group = group,
		spots = {},
		fans = {},
		pending = {},
		entrance = Vector3.zero,
		center = Vector3.zero,
		right = Vector3.xAxis,
		want = 0,
		shown = false,
		lastBubble = 0,
	}
end

local function syncPlot(rec: PlotRec, own: boolean, camPos: Vector3, now: number)
	local oldSpots = rec.spots
	readSpots(rec)
	local spots = rec.spots
	local want = 0
	local best = if #spots > 0 then bestTier(rec) else 0
	if best > 0 then
		want = math.clamp(CFG.Base + math.floor(best * CFG.PerTier), 1, CFG.Max)
		if not own then
			want = math.min(want, CFG.MaxOther)
			local range = if rec.shown then HIDE_OTHER else SHOW_OTHER
			rec.shown = (rec.center - camPos).Magnitude <= range
			if not rec.shown then
				want = 0
			end
		end
		want = math.min(want, #spots)
	end
	rec.want = want
	local far = not own and not rec.shown
	local queued = 0
	for i = 1, math.max(#spots, #oldSpots) do
		local fan = rec.fans[i]
		if i <= want then
			local spot = spots[i]
			if not fan then
				if not rec.pending[i] then
					rec.pending[i] = true
					table.insert(spawnQueue, { rec = rec, spot = i, at = now + queued * SPAWN_STAGGER })
					queued += 1
				end
			elseif fan.state ~= "dead" and (spot.cf.Position - fan.to).Magnitude > 0.5 then
				fan.exit = spot.entrance or fan.exit
				moveTo(fan, spot.cf, now)
			end
		elseif fan then
			rec.fans[i] = nil
			if far then
				-- Out of range: nobody is watching, just tidy up.
				fan.state = "dead"
			else
				startLeave(fan, now)
			end
		end
	end
end

local function poll()
	local map = Workspace:FindFirstChild("Map")
	local data = State.data
	local ownIndex = if data then data.plotIndex else nil
	local camPos = cameraPos()
	local now = os.clock()
	if map then
		for _, child in map:GetChildren() do
			local index = tonumber(string.match(child.Name, "^Plot(%d+)$"))
			if index then
				local rec = plots[index]
				if rec and rec.folder ~= child then
					dropPlot(rec)
					rec = nil
				end
				if not rec then
					rec = newPlot(index, child)
					plots[index] = rec
				end
				syncPlot(rec :: PlotRec, index == ownIndex, camPos, now)
			end
		end
	end
	for index, rec in plots do
		if not map or rec.folder.Parent ~= map then
			dropPlot(rec)
			plots[index] = nil
		end
	end
end

function Fans.init()
	if started then
		return
	end
	started = true
	local startedAt = os.clock()
	task.spawn(function()
		while true do
			-- Wait for the first snapshot (it names our plot) before filling crowds.
			if State.data or os.clock() - startedAt > 8 then
				local ok, err = pcall(poll)
				if not ok and not warned then
					warned = true
					warn("[Fans] " .. tostring(err))
				end
			end
			task.wait(POLL)
		end
	end)
	RunService.RenderStepped:Connect(step)

	Net.event("Effect").OnClientEvent:Connect(function(kind: string, data: any)
		if kind ~= "Buy" and kind ~= "Merge" then
			return
		end
		local now = os.clock()
		if now - lastCheer < CHEER_GAP then
			return
		end
		lastCheer = now
		local near: Vector3? = nil
		if type(data) == "table" then
			if typeof(data.to) == "Vector3" then
				near = data.to
			elseif typeof(data.padPos) == "Vector3" then
				near = data.padPos
			end
		end
		cheer(3, CHEER_LENGTH, near)
	end)
	Net.event("Notify").OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" and payload.kind == "Reward" and payload.new == true then
			lastCheer = os.clock()
			cheer(math.huge, REWARD_LENGTH, nil)
		end
	end)
end

return Fans
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="226">
            <Properties>
              <string name="Name">Interactive</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.Interactive: brings the interactive gym props on every plot to life (World.Decor builds
	them as Interactive_<Kind> models under Workspace.Map, with attribute Interactive and the
	invisible marker parts named below). Cosmetic fun only: no remotes, no economy.

	  trampoline  Standing or landing on the bounce pad ("BounceAnchor", attribute Radius)
	              launches the local character 3-4 jumps high (InteractiveRules: higher out
	              of a bounce and while jump is held), almost straight up. The pad squashes
	              and springs back, with a puff and a pop.
	  punchbag    The "PunchPrompt" (tap / E / gamepad X) or simply running into the bag
	              ("HitZone") is a hit, at most 4 a second: the bag swings away from the
	              player and settles like a damped pendulum, the local avatar throws a quick
	              punch (alternating fists) and a combo counter pops over the bag. A part-built
	              bag hangs from "BagPivot"; the one-piece Blender mesh (bag and stand in one)
	              rocks on its base instead, more gently.
	  bench       The "LiftPrompt" lies the player down on "BenchSeat" (the server seats
	              them: one lifter at a time, seen by everyone). Every client poses whoever
	              lies there in a bench press, moves a barbell with their hands and counts
	              the reps. Jumping, moving or the prompt (now "Stop") ends it, and the lifter
	              gets up on "StandSpot" beside the bench.

	Avatars are posed like Fx.PlayerPose does it: Motor6D transforms overridden after the
	avatar's own animations have run, from the gym poses in Shared.Poses (R15 only; an R6
	avatar still bounces, hits and lifts, just without the pose).

	Each client writes what it plays onto the Interactive_ model (local attributes, for
	playtests): trampoline Bounces, BounceHeight (in jumps); punchbag Hits, Combo; bench
	Lifting (the lifter's name, or nil) and Reps.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rules = require(Shared:WaitForChild("InteractiveRules"))
local Poses = require(Shared:WaitForChild("Poses")) :: any
local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Sounds = require(script.Parent.Parent.Sounds) :: any
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)

local Interactive = {}

local player = Players.LocalPlayer
local W = Theme.World
local INK: Color3 = Theme.Colors.Stroke

local MODEL_DELAY = 0.5 -- seconds to let a model's parts arrive before setting it up
local MARKER_WAIT = 5 -- seconds to wait for a marker part before giving up on a model
local COUNTER_RANGE = 70 -- studs: the combo / rep counters fade out beyond this
local NEAR = 14 -- studs from a prop within which the local character is checked every frame

local PAD_SQUASH = 0.45 -- studs the bounce pad dips
local BOUNCE_REACH = 8 -- studs above the pad a character's root still counts as on it
local WALK_GAP = 0.5 -- seconds between hits while the player keeps pushing into the bag
local MESH_ROCK = 0.3 -- share of the swing a one-piece bag-and-stand mesh rocks on its base
local BLEND_IN = 0.25 -- seconds for a lifter to settle into the bench press
local STAND_WAIT = 1.5 -- seconds to wait for the seat to let go before giving up on standing

local UPPER_BODY = { "UpperTorso", "Head", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand" }

-- The local character ------------------------------------------------------------------------

type Joint = { motor: Motor6D, rot: CFrame, rotInv: CFrame }
type Rig = { joints: { [string]: Joint }, scale: number }
type Me = { model: Model, humanoid: Humanoid, root: BasePart }

type Handler = {
	destroy: () -> (),
	step: ((now: number, dt: number) -> ())?,
	pose: ((now: number) -> ())?,
	jumped: ((me: Me) -> ())?,
}

local live: { [Instance]: Handler } = {}
local pending: { [Instance]: boolean } = {}
local me: Me? = nil
local meConns: { RBXScriptConnection } = {}
local lastJumpRequest = -math.huge
local started = false

local function dropMe()
	for _, conn in meConns do
		conn:Disconnect()
	end
	table.clear(meConns)
	me = nil
end

-- The local character's humanoid and root, or nil while it is missing or still loading.
local function localChar(): Me?
	local character = player.Character
	local current = me
	if current and current.model == character and current.root.Parent and current.humanoid.Parent then
		return current
	end
	dropMe()
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return nil
	end
	local fresh: Me = { model = character, humanoid = humanoid, root = root }
	me = fresh
	-- Landing with jump held jumps before any frame sees the character on the ground.
	table.insert(
		meConns,
		humanoid.StateChanged:Connect(function(_old, new)
			if new == Enum.HumanoidStateType.Jumping then
				for _, handler in live do
					if handler.jumped then
						handler.jumped(fresh)
					end
				end
			end
		end)
	)
	return fresh
end

local function holdingJump(humanoid: Humanoid): boolean
	return humanoid.Jump or os.clock() - lastJumpRequest < 0.2
end

-- Normal take-off speed of the avatar's jump.
local function jumpSpeed(humanoid: Humanoid): number
	local speed = if humanoid.UseJumpPower then humanoid.JumpPower else Rules.jumpSpeed(Workspace.Gravity, humanoid.JumpHeight)
	-- A mode may have switched jumping off: the pad still bounces like a default avatar.
	return if speed >= 10 then speed else 50
end

-- Posing --------------------------------------------------------------------------------------

local POSE: { [string]: { [string]: CFrame } } = {}
local rigs: { [Model]: { rig: Rig?, at: number } } = setmetatable({}, { __mode = "k" }) :: any

local function collectRig(character: Model): Rig?
	local joints: { [string]: Joint } = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and d.Part1 then
			local limb = d.Part1.Name
			if not joints[limb] and table.find(Poses.LIMBS, limb) then
				local rot = d.C0.Rotation
				joints[limb] = { motor = d, rot = rot, rotInv = rot:Inverse() }
			end
		end
	end
	if not joints.LowerTorso or not joints.UpperTorso then
		return nil
	end
	return { joints = joints, scale = character:GetScale() }
end

-- The R15 joints of `character`, looked up again (at most once a second) when the avatar was
-- rebuilt or had not finished loading; nil for an R6 or missing avatar.
local function rigFor(character: Model, now: number): Rig?
	local entry = rigs[character]
	if entry then
		local rig = entry.rig
		if rig and rig.joints.UpperTorso.motor.Parent then
			return rig
		end
		if now - entry.at < 1 then
			return nil
		end
	end
	local rig = collectRig(character)
	rigs[character] = { rig = rig, at = now }
	return rig
end

-- Poses `limbs` part way (alpha) from pose `a` to pose `b`, mixed over the avatar's own
-- animation by `weight`. Call from PreSimulation, after the animations have run.
local function poseRig(rig: Rig, a: { [string]: CFrame }, b: { [string]: CFrame }, alpha: number, weight: number, limbs: { string })
	for _, limb in limbs do
		local joint = rig.joints[limb]
		if not joint or not joint.motor.Parent then
			continue
		end
		local cf = a[limb]:Lerp(b[limb], alpha)
		local transform = joint.rotInv * cf.Rotation * joint.rot
		if limb == "LowerTorso" then
			transform = CFrame.new(joint.rotInv * Vector3.new(0, cf.Y * rig.scale, 0)) * transform
		end
		joint.motor.Transform = if weight >= 1 then transform else joint.motor.Transform:Lerp(transform, weight)
	end
end

-- Hands `limbs` back to the avatar's own animations.
local function restRig(rig: Rig, limbs: { string })
	for _, limb in limbs do
		local joint = rig.joints[limb]
		if joint and joint.motor.Parent then
			joint.motor.Transform = CFrame.identity
		end
	end
end

-- The local avatar's punch: one at a time, alternating fists.
local punchAt = -math.huge
local punchSide = "Left"
local punchRig: Rig? = nil

local function throwPunch(who: Me, toward: Vector3?)
	punchSide = if punchSide == "Right" then "Left" else "Right"
	punchAt = os.clock()
	-- A punch from the prompt while standing about: turn to face the bag first.
	if toward and who.humanoid.MoveDirection.Magnitude < 0.1 and who.humanoid.SeatPart == nil then
		local at = who.root.Position
		who.root.CFrame = CFrame.lookAt(at, at + toward)
	end
end

local function posePunch(now: number)
	local t = now - punchAt
	local who = if t < Rules.PUNCH_TIME then localChar() else nil
	local rig = if who and who.humanoid.SeatPart == nil then rigFor(who.model, now) else nil
	if not rig then
		if punchRig then
			restRig(punchRig, UPPER_BODY)
			punchRig = nil
		end
		return
	end
	local reach, weight = Rules.punch(t)
	poseRig(rig, POSE.PunchGuard, POSE["Punch" .. punchSide], reach, weight, UPPER_BODY)
	punchRig = rig
end

-- Small pieces ----------------------------------------------------------------------------------

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function marker(model: Instance, name: string): BasePart?
	local found = model:WaitForChild(name, MARKER_WAIT)
	return if found and found:IsA("BasePart") then found else nil
end

type Counter = {
	show: (text: string, color: Color3, size: number) -> (),
	hide: () -> (),
	destroy: () -> (),
}

-- A number that pops over a prop: Display type in `color` with the world signs' ink outline.
local function counter(adornee: BasePart, name: string, above: number): Counter
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Adornee = adornee
	gui.Size = UDim2.fromScale(11, 3.8)
	gui.StudsOffset = Vector3.new(0, above, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = COUNTER_RANGE
	gui.Enabled = false
	gui.Parent = adornee
	-- Half the board at size 1, so the milestone sizes still fit inside it.
	local label = Instance.new("TextLabel")
	label.Name = "Count"
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(0.5, 0.5)
	label.Font = Theme.Fonts.Display
	label.TextScaled = true
	label.Text = ""
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = 3
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Parent = label
	local token = 0

	local self = {} :: Counter
	function self.show(text: string, color: Color3, size: number)
		token += 1
		gui.Enabled = true
		label.Text = text
		label.TextColor3 = color
		label.TextTransparency = 0
		stroke.Transparency = 0
		scale.Scale = size * 0.55
		TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = size }):Play()
	end
	function self.hide()
		if not gui.Enabled then
			return
		end
		token += 1
		local mine = token
		local fade = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
		task.delay(0.32, function()
			if token == mine then
				gui.Enabled = false
			end
		end)
	end
	function self.destroy()
		token += 1
		gui:Destroy()
	end
	return self
end

-- A burst of stars for a milestone; decorative, so it gives way on busy or small devices.
local function starBurst(anchor: BasePart, at: Vector3, count: number)
	for i = 1, Budget.count(count) do
		if not Sprites.room() then
			return
		end
		local a = (i / count) * 2 * math.pi + math.random()
		Sprites.billboard(anchor, "StarPop", {
			position = at,
			size = 1 + math.random() * 0.5,
			rise = Vector3.new(math.cos(a) * 2.2, 1.4 + math.random() * 1.6, math.sin(a) * 2.2),
			life = 0.9,
			spin = (math.random() - 0.5) * 120,
		})
	end
end

-- Trampoline ------------------------------------------------------------------------------------

local function trampoline(model: Model): Handler?
	local anchor = marker(model, "BounceAnchor")
	if not anchor then
		return nil
	end
	local top = anchor.Position
	local radiusValue = anchor:GetAttribute("Radius")
	local radius: number = if type(radiusValue) == "number" then radiusValue else 2.9

	-- The part-built pad and the springs under it dip on a bounce (absent is fine).
	local pads: { { part: BasePart, rest: CFrame, give: number } } = {}
	for name, give in { TrampolinePad = 1, TrampolineSprings = 0.5 } :: { [string]: number } do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(pads, { part = part, rest = part.CFrame, give = give })
		end
	end

	local lastBounce = -math.huge
	local bounceSpeed = 0
	local bounces = 0
	local fallSpeed = 0 -- fastest the character has fallen since it last stood on something
	local squashToken = 0
	local emitter: ParticleEmitter? = nil
	local triedEmitter = false

	local function squash()
		squashToken += 1
		local mine = squashToken
		local down = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, pad in pads do
			if pad.part.Parent then
				TweenService:Create(pad.part, down, { CFrame = pad.rest - Vector3.new(0, PAD_SQUASH * pad.give, 0) }):Play()
			end
		end
		task.delay(0.06, function()
			if mine ~= squashToken then
				return
			end
			local back = TweenInfo.new(0.55, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
			for _, pad in pads do
				if pad.part.Parent then
					TweenService:Create(pad.part, back, { CFrame = pad.rest }):Play()
				end
			end
		end)
	end

	local function puff()
		if not triedEmitter then
			triedEmitter = true
			emitter = Sprites.emitter(anchor, "Puff", {
				Color = ColorSequence.new(W.Cream),
				EmissionDirection = Enum.NormalId.Top,
				SpreadAngle = Vector2.new(75, 75),
				Speed = NumberRange.new(5, 9),
				Lifetime = NumberRange.new(0.35, 0.6),
				Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.3),
					NumberSequenceKeypoint.new(0.3, 1.2),
					NumberSequenceKeypoint.new(1, 0),
				}),
			})
		end
		if emitter then
			emitter:Emit(Budget.count(8))
		end
	end

	-- Over the pad: within its radius and no more than a jump's start above it.
	local function over(root: BasePart): boolean
		local d = root.Position - top
		return d.X * d.X + d.Z * d.Z <= radius * radius and d.Y > 0.5 and d.Y < BOUNCE_REACH
	end

	local function launch(who: Me)
		local v = who.root.AssemblyLinearVelocity
		local x, z = Rules.drift(v.X, v.Z)
		who.humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		who.root.AssemblyLinearVelocity = Vector3.new(x, bounceSpeed, z)
	end

	local function bounce(who: Me, holding: boolean)
		local now = os.clock()
		if now - lastBounce < Rules.BOUNCE_GAP or who.humanoid.Health <= 0 or who.humanoid.SeatPart ~= nil then
			return
		end
		lastBounce = now
		local jump = jumpSpeed(who.humanoid)
		local height = Rules.bounceHeight(jump, fallSpeed, holding)
		bounceSpeed = Rules.bounceSpeed(jump, fallSpeed, holding)
		fallSpeed = 0
		launch(who)
		squash()
		puff()
		Sounds.play("Pickup", 0.05, 0.85 + 0.3 * (height - Rules.BOUNCE_BASE))
		bounces += 1
		model:SetAttribute("Bounces", bounces)
		model:SetAttribute("BounceHeight", height)
	end

	local handler: Handler = {
		destroy = function()
			squashToken += 1
			if emitter then
				emitter:Destroy()
			end
		end,
		step = function(now: number)
			local who = localChar()
			if not who then
				return
			end
			local root = who.root
			if flat(root.Position - top).Magnitude > radius + NEAR then
				fallSpeed = 0
				return
			end
			local vy = root.AssemblyLinearVelocity.Y
			-- The humanoid's landing or jump can swallow the launch on the frame it happens:
			-- give it again while the character is clearly slower than the bounce.
			local since = now - lastBounce
			if since < 0.1 and vy < bounceSpeed - Workspace.Gravity * since - 15 then
				launch(who)
				return
			end
			local grounded = who.humanoid.FloorMaterial ~= Enum.Material.Air
			if not grounded then
				fallSpeed = math.max(fallSpeed, -vy)
			elseif over(root) and vy < 1 then
				bounce(who, holdingJump(who.humanoid))
			else
				fallSpeed = 0
			end
		end,
		jumped = function(who: Me)
			if over(who.root) then
				bounce(who, true)
			end
		end,
	}
	return handler
end

-- Punch bag -------------------------------------------------------------------------------------

local function punchBag(model: Model): Handler?
	local pivot = marker(model, "BagPivot")
	local zone = marker(model, "HitZone")
	if not pivot or not zone then
		return nil
	end
	local found = zone:WaitForChild("PunchPrompt", MARKER_WAIT)
	local prompt = if found and found:IsA("ProximityPrompt") then found else nil

	-- What swings: the part-built bag about the hook it hangs from, or (bag and stand in one
	-- mesh) the whole body rocking on its base.
	local parts: { BasePart } = {}
	local rests: { CFrame } = {}
	local cframes: { CFrame } = {}
	local hinge = pivot.Position
	local gain = 1
	local tiltX, tiltZ = 0, 0 -- the swing, as a lean (radians) along world X and Z
	local speedX, speedZ = 0, 0
	local swinging = false
	local captureToken = 0

	local function settle()
		tiltX, tiltZ, speedX, speedZ = 0, 0, 0, 0
		swinging = false
		for i, part in parts do
			if part.Parent then
				part.CFrame = rests[i]
			end
		end
	end

	local function capture()
		settle()
		table.clear(parts)
		table.clear(rests)
		table.clear(cframes)
		local prop = model:FindFirstChild("Prop_PunchBag")
		if not prop then
			return
		end
		local bag: { BasePart } = {}
		local body: { BasePart } = {}
		for _, d in prop:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "PropRoot" and d.Name ~= "PropCollider" then
				table.insert(body, d)
				if string.sub(d.Name, 1, 3) == "Bag" and string.sub(d.Name, 1, 8) ~= "BagStand" then
					table.insert(bag, d)
				end
			end
		end
		if #bag > 0 then
			parts, hinge, gain = bag, pivot.Position, 1
		else
			local base = prop:FindFirstChild("PropRoot")
			parts = body
			hinge = if base and base:IsA("BasePart")
				then base.Position
				else Vector3.new(pivot.Position.X, zone.Position.Y - zone.Size.Y / 2, pivot.Position.Z)
			gain = -MESH_ROCK
		end
		for i, part in parts do
			rests[i] = part.CFrame
		end
	end

	-- The body changed under us (its mesh arrived, a part streamed): start again from rest.
	local function recapture(d: Instance)
		if not d:IsA("BasePart") then
			return
		end
		captureToken += 1
		local mine = captureToken
		settle()
		task.delay(MODEL_DELAY, function()
			if mine == captureToken and model.Parent then
				capture()
			end
		end)
	end

	local function swing(dt: number)
		tiltX, speedX = Rules.swingStep(tiltX, speedX, dt)
		tiltZ, speedZ = Rules.swingStep(tiltZ, speedZ, dt)
		local angle = math.sqrt(tiltX * tiltX + tiltZ * tiltZ)
		if angle > Rules.SWING_MAX then
			local k = Rules.SWING_MAX / angle
			tiltX, tiltZ, angle = tiltX * k, tiltZ * k, Rules.SWING_MAX
		end
		if Rules.swingStill(tiltX, speedX) and Rules.swingStill(tiltZ, speedZ) then
			settle()
			return
		end
		-- Leaning toward (tiltX, tiltZ) is a turn about the level axis across it.
		local turn = if angle > 1e-5
			then CFrame.fromAxisAngle(Vector3.new(-tiltZ, 0, tiltX) * gain, angle * math.abs(gain))
			else CFrame.identity
		local frame = CFrame.new(hinge) * turn * CFrame.new(-hinge)
		local n = 0
		for i, part in parts do
			if part.Parent then
				n += 1
				cframes[i] = frame * rests[i]
			end
		end
		if n == #parts and n > 0 then
			Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end

	local combo = 0
	local hits = 0
	local lastHit: number? = nil
	local inside = false
	local board = counter(pivot, "ComboCounter", 2.4)

	local function hit(who: Me, viaPrompt: boolean)
		local now = os.clock()
		if not Rules.canHit(lastHit, now) or who.humanoid.Health <= 0 or who.humanoid.SeatPart ~= nil then
			return
		end
		local away = flat(zone.Position - who.root.Position)
		away = if away.Magnitude > 0.05 then away.Unit else flat(who.root.CFrame.LookVector).Unit
		combo = Rules.combo(combo, lastHit, now)
		lastHit = now
		hits += 1
		local kick = Rules.kick(combo)
		speedX += away.X * kick
		speedZ += away.Z * kick
		swinging = true

		throwPunch(who, if viaPrompt then away else nil)
		local big = Rules.milestone(combo)
		board.show("x" .. combo, if big then W.Sunny else W.White, Rules.comboScale(combo))
		Sounds.play("Deposit", 0.06, 0.9 + 0.4 * math.clamp((combo - 1) / 24, 0, 1))
		if big then
			Sounds.play("Step")
			starBurst(pivot, pivot.Position + Vector3.new(0, 2.4, 0), 8)
		end
		model:SetAttribute("Hits", hits)
		model:SetAttribute("Combo", combo)
	end

	local conns: { RBXScriptConnection } = {}
	if prompt then
		table.insert(
			conns,
			prompt.Triggered:Connect(function(who: Player)
				local mine = localChar()
				if who == player and mine then
					hit(mine, true)
				end
			end)
		)
	end
	table.insert(conns, model.DescendantAdded:Connect(recapture))
	table.insert(conns, model.DescendantRemoving:Connect(recapture))
	capture()

	local handler: Handler = {
		destroy = function()
			captureToken += 1
			for _, conn in conns do
				conn:Disconnect()
			end
			settle()
			board.destroy()
		end,
		step = function(now: number, dt: number)
			if swinging then
				swing(dt)
			end
			if combo > 0 and not Rules.comboAlive(lastHit, now) then
				combo = 0
				board.hide()
				model:SetAttribute("Combo", 0)
			end
			local who = localChar()
			if not who or flat(who.root.Position - zone.Position).Magnitude > NEAR then
				inside = false
				return
			end
			-- Running into the bag: a hit on the way in, and again while pushing on into it.
			local p = zone.CFrame:PointToObjectSpace(who.root.Position)
			local half = zone.Size / 2
			local nowInside = math.abs(p.X) <= half.X + 0.5 and math.abs(p.Z) <= half.Z + 0.5 and math.abs(p.Y) <= half.Y + 3
			if nowInside then
				local toward = flat(zone.Position - who.root.Position)
				local pushing = toward.Magnitude > 0.05 and who.humanoid.MoveDirection:Dot(toward.Unit) > 0.3
				if not inside or (pushing and now - (lastHit or -math.huge) >= WALK_GAP) then
					hit(who, false)
				end
			end
			inside = nowInside
		end,
	}
	return handler
end

-- Bench press -----------------------------------------------------------------------------------

type Lift = {
	humanoid: Humanoid,
	character: Model?,
	mine: boolean,
	startedAt: number,
	reps: number,
	bar: Model,
	barParts: { BasePart },
	barOffsets: { CFrame },
}

local function barPart(parent: Instance, name: string, length: number, diameter: number, tint: Color3): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.Color = tint
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Parent = parent
	return p
end

-- The barbell a lifter presses: a chrome bar along X with sunny plates outside the hands.
local function buildBar(parent: Instance): (Model, { BasePart }, { CFrame })
	local bar = Instance.new("Model")
	bar.Name = "RepBarbell"
	local parts: { BasePart } = { barPart(bar, "RepBar", 8, 0.3, W.Chrome) }
	local offsets: { CFrame } = { CFrame.identity }
	for _, side in { -1, 1 } do
		for _, piece in
			{
				{ name = "RepPlate", x = 3.25, length = 0.4, diameter = 2.1, tint = W.Sunny },
				{ name = "RepPlate", x = 3.62, length = 0.32, diameter = 1.5, tint = W.Sunny:Lerp(W.White, 0.35) },
				{ name = "RepCollar", x = 3.88, length = 0.2, diameter = 0.55, tint = W.Chrome },
			}
		do
			table.insert(parts, barPart(bar, piece.name, piece.length, piece.diameter, piece.tint))
			table.insert(offsets, CFrame.new(side * piece.x, 0, 0))
		end
	end
	bar.Parent = parent
	return bar, parts, offsets
end

local function bench(model: Model): Handler?
	local seatPart = marker(model, "BenchSeat")
	local standSpot = marker(model, "StandSpot")
	local liftAnchor = marker(model, "LiftAnchor")
	if not seatPart or not seatPart:IsA("Seat") or not standSpot or not liftAnchor then
		return nil
	end
	local seat: Seat = seatPart
	local found = liftAnchor:WaitForChild("LiftPrompt", MARKER_WAIT)
	local prompt = if found and found:IsA("ProximityPrompt") then found else nil
	local board = counter(liftAnchor, "RepCounter", 4.2)

	local lift: Lift? = nil
	local armed = false -- the local lifter has let go of the stick since lying down
	local leavingAt = -math.huge
	local standBy: number? = nil -- the local lifter gets up once the seat has let go, until then

	-- The barbell resting in the rack hides while somebody presses theirs.
	local function showRack(shown: boolean)
		local rack = model:FindFirstChild("Prop_Barbell")
		if rack then
			for _, d in rack:GetDescendants() do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = if shown then 0 else 1
				end
			end
		end
	end

	local function finish()
		local current = lift
		if not current then
			return
		end
		lift = nil
		local rig = if current.character then rigs[current.character] else nil
		if rig and rig.rig then
			restRig(rig.rig, Poses.LIMBS)
		end
		current.bar:Destroy()
		showRack(true)
		board.hide()
		model:SetAttribute("Lifting", nil)
		if current.mine then
			standBy = os.clock() + STAND_WAIT
		end
	end

	local function start(humanoid: Humanoid)
		local character = humanoid.Parent
		local bar, barParts, barOffsets = buildBar(model)
		local now = os.clock()
		local current: Lift = {
			humanoid = humanoid,
			character = if character and character:IsA("Model") then character else nil,
			mine = character ~= nil and character == player.Character,
			startedAt = now,
			reps = 0,
			bar = bar,
			barParts = barParts,
			barOffsets = barOffsets,
		}
		lift = current
		showRack(false)
		board.show("0 REPS", W.White, 1)
		model:SetAttribute("Lifting", if character then character.Name else humanoid.Name)
		model:SetAttribute("Reps", 0)
		if current.mine then
			armed = false
			leavingAt = -math.huge
			standBy = nil
		end
	end

	local function refresh()
		local who = seat.Occupant
		local current = lift
		if current and current.humanoid ~= who then
			finish()
		end
		if who and not lift then
			start(who)
		end
		if prompt then
			local mine = lift ~= nil and lift.mine
			prompt.ActionText = if mine then "Stop" else "Lift"
			prompt.Enabled = mine or who == nil
		end
	end

	-- Asks the seat to let the local lifter go; jumping is the fallback that always works.
	local function leave(who: Me, now: number)
		if now - leavingAt < 0.4 then
			return
		end
		if leavingAt > -math.huge then
			who.humanoid.Jump = true
		end
		leavingAt = now
		who.humanoid.Sit = false
	end

	-- Stands the local lifter up beside the bench (never after the server has moved them away).
	local function standUp(who: Me)
		if who.humanoid.Health <= 0 or (who.root.Position - seat.Position).Magnitude > 6 then
			return
		end
		local hip = if who.humanoid.RigType == Enum.HumanoidRigType.R15 then who.humanoid.HipHeight else 2
		local at = standSpot.Position + Vector3.new(0, hip + who.root.Size.Y / 2 + 0.1, 0)
		local look = flat(standSpot.CFrame.LookVector)
		who.root.CFrame = CFrame.lookAt(at, at + (if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)))
		who.root.AssemblyLinearVelocity = Vector3.zero
		who.root.AssemblyAngularVelocity = Vector3.zero
		who.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	local conns: { RBXScriptConnection } = {
		seat:GetPropertyChangedSignal("Occupant"):Connect(refresh),
	}
	if prompt then
		table.insert(
			conns,
			prompt.Triggered:Connect(function(who: Player)
				-- The server seats a new lifter and lets its own one go; this only hurries the "Stop".
				local mine = localChar()
				if who == player and mine and lift and lift.mine then
					leave(mine, os.clock())
				end
			end)
		)
	end
	refresh()

	local handler: Handler = {
		destroy = function()
			for _, conn in conns do
				conn:Disconnect()
			end
			finish()
			standBy = nil
			board.destroy()
		end,
		step = function(now: number)
			local who = localChar()
			local deadline = standBy
			if deadline then
				if not who or now > deadline then
					standBy = nil
				elseif who.humanoid.SeatPart == nil and seat:FindFirstChild("SeatWeld") == nil then
					standBy = nil
					standUp(who)
				end
			end
			local current = lift
			if not current then
				return
			end
			-- A lifter who is gone, dead or no longer on this seat (a missed signal) is done.
			if seat.Occupant ~= current.humanoid or current.humanoid.Health <= 0 or current.humanoid.Parent == nil then
				refresh()
				current = lift
				if not current then
					return
				end
			end
			local t = now - current.startedAt
			if current.mine and who then
				-- Moving ends the lift, once the stick has been let go after lying down.
				local moving = who.humanoid.MoveDirection.Magnitude
				if not armed then
					armed = moving < 0.1 and t > 0.3
				elseif moving > 0.3 then
					leave(who, now)
				end
			end

			-- The bar rides between the hands; without hands (R6) it moves over the chest.
			local character = current.character
			local left = character and character:FindFirstChild("LeftHand")
			local right = character and character:FindFirstChild("RightHand")
			local frame = seat.CFrame
			local centre
			if left and right and left:IsA("BasePart") and right:IsA("BasePart") then
				centre = (left.Position + right.Position) / 2
			else
				centre = frame * Vector3.new(0, 0.4, -(1 + 1.2 * Rules.press(t)))
			end
			local base = CFrame.fromMatrix(centre, frame.RightVector, frame.UpVector)
			for i, part in current.barParts do
				part.CFrame = base * current.barOffsets[i]
			end

			local reps = Rules.reps(t)
			if reps ~= current.reps then
				current.reps = reps
				board.show(reps .. (if reps == 1 then " REP" else " REPS"), if reps % 10 == 0 then W.Sunny else W.White, 1)
				model:SetAttribute("Reps", reps)
				if current.mine then
					Sounds.play("Tick", 0.04)
					if reps % 10 == 0 then
						Sounds.play("Step")
						starBurst(liftAnchor, liftAnchor.Position + Vector3.new(0, 4.2, 0), 6)
					end
				end
			end
		end,
		pose = function(now: number)
			local current = lift
			local character = current and current.character
			if not current or not character then
				return
			end
			local rig = rigFor(character, now)
			if rig then
				local t = now - current.startedAt
				poseRig(rig, POSE.BenchDown, POSE.BenchUp, Rules.press(t), math.min(1, t / BLEND_IN), Poses.LIMBS)
			end
		end,
	}
	return handler
end

-- Models -----------------------------------------------------------------------------------------

local BUILDERS: { [string]: (Model) -> Handler? } = {
	trampoline = trampoline,
	punchbag = punchBag,
	bench = bench,
}

-- Sets `model` up (this waits for its marker parts, so it runs in its own thread).
local function setup(model: Model)
	pending[model] = nil
	local kind = model:GetAttribute("Interactive")
	local build = if type(kind) == "string" then BUILDERS[kind] else nil
	if not build or live[model] or not model:IsDescendantOf(Workspace) then
		return
	end
	local ok, result = pcall(build, model)
	if not ok then
		warn("[Fx.Interactive] " .. model.Name .. " failed: " .. tostring(result))
		return
	end
	local handler = result :: Handler?
	if not handler then
		return
	end
	if live[model] or not model:IsDescendantOf(Workspace) then
		handler.destroy()
		return
	end
	live[model] = handler
end

local function consider(instance: Instance)
	if instance:IsA("Model") and instance:GetAttribute("Interactive") ~= nil and not live[instance] and not pending[instance] then
		pending[instance] = true
		-- Give the model's parts a moment to arrive (building / streaming).
		task.delay(MODEL_DELAY, setup, instance)
	end
end

local function onRemoving(instance: Instance)
	pending[instance] = nil
	local handler = live[instance]
	if handler then
		live[instance] = nil
		handler.destroy()
	end
end

-- One warning per prop: a broken one must not flood the output every frame.
local warned: { [string]: boolean } = {}
local function report(name: string, err: any)
	if not warned[name] then
		warned[name] = true
		warn("[Fx.Interactive] " .. name .. ": " .. tostring(err))
	end
end

function Interactive.init()
	if started then
		return
	end
	started = true
	for _, name in { "PunchGuard", "PunchRight", "PunchLeft", "BenchUp", "BenchDown" } do
		POSE[name] = Poses.samplePose("Story", name, 0, 0)
	end

	UserInputService.JumpRequest:Connect(function()
		lastJumpRequest = os.clock()
	end)
	-- A new character starts clean: its connections go with the old one.
	player.CharacterRemoving:Connect(function()
		dropMe()
		punchAt = -math.huge
		punchRig = nil
	end)
	RunService.Heartbeat:Connect(function(dt: number)
		local now = os.clock()
		for instance, handler in live do
			if handler.step then
				local ok, err = pcall(handler.step :: any, now, dt)
				if not ok then
					report(instance.Name, err)
				end
			end
		end
	end)
	-- After the avatars' own animations, like Fx.PlayerPose.
	RunService.PreSimulation:Connect(function()
		local now = os.clock()
		local ok, err = pcall(posePunch :: any, now)
		if not ok then
			report("punch", err)
		end
		for instance, handler in live do
			if handler.pose then
				ok, err = pcall(handler.pose :: any, now)
				if not ok then
					report(instance.Name, err)
				end
			end
		end
	end)

	task.spawn(function()
		local map = Workspace:WaitForChild("Map", 60)
		if not map then
			return
		end
		map.DescendantAdded:Connect(consider)
		map.DescendantRemoving:Connect(onRemoving)
		for _, d in map:GetDescendants() do
			consider(d)
		end
	end)
end

return Interactive
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="227">
            <Properties>
              <string name="Name">Machines</string>
              <string name="Source"><![CDATA[-- Client-side machine juice for the local player's own plot, painted from Theme.World (no glow):
--   * Deposit: aura orbs stream into the blender's lid, which hops on a soft spring.
--   * Blender blades spin up while the queue has orbs; the smoothie swirls and coins hop from
--     the blender to the Collect pad. The processor's cups ride the belt and its dots fill up.
--   * A coin stack on the Collect pad grows with pending cash; collecting hops the coins into
--     the piggy bank, which bounces.
--   * Pads you can use right now (affordable / ready) breathe slowly brighter and back.
--   * Upgrade / buy / deny feedback: dust puffs, confetti, stars, coins and a gentle wobble.
--   * Crate Smasher: a local crate rattles as its timer runs out; when ready the striker puck
--     rides up its track, the bell rings and a READY! card pops up.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Format"))
local Economy = require(Shared:WaitForChild("Economy"))

local Client = script.Parent.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local Orbs = require(script.Parent.Orbs)
local Camera = require(script.Parent.Camera)
local Budget = require(script.Parent.Budget)

local player = Players.LocalPlayer
local C = Theme.Colors
local WORLD = (Theme :: any).World or {}
local WHITE = Color3.new(1, 1, 1)
local FAR = CFrame.new(0, -10000, 0)
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)
local UP = Vector3.yAxis

local function worldColor(key: string, fallback: Color3): Color3
	return WORLD[key] or fallback
end

-- Palette: teal/blue dominant, sunny the accent, coral the sparing pop; grape is the aura
-- colour (orbs going into the converter).
local INK = worldColor("Ink", Color3.fromRGB(58, 48, 96))
local CREAM = worldColor("Cream", WHITE)
local SUNNY = worldColor("Sunny", C.Primary)
local TEAL = worldColor("Teal", C.Good)
local TEAL_LIGHT = worldColor("TealLight", C.Good)
local CORAL = worldColor("Coral", C.Bad)
local BLUE = worldColor("Blue", C.Secondary)
local GRAPE = worldColor("Grape", C.Orb)
local CONFETTI_COLORS = { SUNNY, TEAL_LIGHT, BLUE, SUNNY, WHITE, CORAL }

local Machines = {}

local fxFolder: Instance = nil :: any

local function newPart(shape: Enum.PartType, name: string, color: Color3, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color
	p.Size = size
	p.CFrame = FAR
	p.Parent = fxFolder
	return p
end

local function play(name: string, jitter: number?, mult: number?)
	(Sounds.play :: any)(name, jitter, mult)
end

-- Easing and springs ----------------------------------------------------------------------------

local function easeOutQuad(t: number): number
	return 1 - (1 - t) * (1 - t)
end

local function easeOutBack(t: number): number
	local c1 = 1.70158
	local u = t - 1
	return 1 + (c1 + 1) * u * u * u + c1 * u * u
end

type Spring = { x: number, v: number }

-- Damped spring toward 0, sub-stepped so a long frame cannot blow it up.
local function stepSpring(s: Spring, dt: number, stiffness: number, damping: number)
	local steps = math.clamp(math.ceil(dt * 120), 1, 8)
	local h = dt / steps
	for _ = 1, steps do
		s.v += (-stiffness * s.x - damping * s.v) * h
		s.x += s.v * h
	end
end

-- Particles: confetti, hopping coins, stars and dust puffs ------------------------------------

type Confetto = {
	part: Part,
	pos: Vector3,
	vel: Vector3,
	rot: CFrame,
	spin: Vector3,
	t0: number,
	life: number,
}

local MAX_CONFETTI = 90
local confetti: { Confetto } = {}
local confettiPool: { Part } = {}

local function confettiBurst(pos: Vector3, count: number, power: number?, colors: { Color3 }?)
	local palette = colors or CONFETTI_COLORS
	local k = power or 1
	local now = os.clock()
	local cap = Budget.count(MAX_CONFETTI) -- fewer on phones (Fx.Budget)
	for i = 1, Budget.count(count) do
		if #confetti >= cap then
			break
		end
		local part = table.remove(confettiPool) or newPart(Enum.PartType.Block, "Confetti", WHITE, Vector3.new(0.34, 0.07, 0.24))
		part.Color = palette[(i - 1) % #palette + 1]
		part.Transparency = 0
		local a = math.random() * math.pi * 2
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		table.insert(confetti, {
			part = part,
			pos = pos,
			vel = out * (2.5 + math.random() * 4.5) * k + UP * (8 + math.random() * 6) * k,
			rot = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
			spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14,
			t0 = now,
			life = 1.1 + math.random() * 0.6,
		})
	end
end

local function stepConfetti(dt: number, now: number)
	if #confetti == 0 then
		return
	end
	local parts, cframes = {}, {}
	local drag = math.exp(-dt * 2.4)
	for i = #confetti, 1, -1 do
		local c = confetti[i]
		local age = now - c.t0
		if age >= c.life then
			c.part.CFrame = FAR
			table.insert(confettiPool, c.part)
			table.remove(confetti, i)
			continue
		end
		-- Drag, gravity and a capped, swaying fall so pieces flutter down.
		local vy = math.max(c.vel.Y * drag - 24 * dt, -4.5)
		c.vel = Vector3.new(c.vel.X * drag, vy, c.vel.Z * drag)
		c.pos += c.vel * dt + Vector3.new(math.sin(now * 5 + i) * 0.8 * dt, 0, 0)
		c.rot *= CFrame.Angles(c.spin.X * dt, c.spin.Y * dt, c.spin.Z * dt)
		c.part.Transparency = math.clamp((age - c.life * 0.65) / (c.life * 0.35), 0, 1)
		table.insert(parts, c.part)
		table.insert(cframes, CFrame.new(c.pos) * c.rot)
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

type Hop = {
	part: Part,
	from: Vector3,
	ctrl: Vector3,
	to: Vector3,
	t0: number,
	dur: number,
	s0: number,
	s1: number,
	turn: number,
	onDone: (() -> ())?,
}

type HopOptions = {
	from: Vector3,
	to: Vector3,
	delay: number?,
	duration: number?,
	arc: number?,
	size: number?,
	endSize: number?,
	color: Color3?,
	onDone: (() -> ())?,
}

local MAX_HOPS = 40
local hops: { Hop } = {}
local hopPool: { Part } = {}

-- A small coin that hops along an arc (spinning on its edge) and calls onDone on landing.
local function hop(opts: HopOptions)
	if #hops >= MAX_HOPS then
		if opts.onDone then
			opts.onDone()
		end
		return
	end
	local part = table.remove(hopPool) or newPart(Enum.PartType.Cylinder, "CoinHop", SUNNY, Vector3.new(0.18, 1, 1))
	part.Color = opts.color or SUNNY
	part.Transparency = 0
	local mid = opts.from:Lerp(opts.to, 0.5)
	table.insert(hops, {
		part = part,
		from = opts.from,
		ctrl = Vector3.new(mid.X, math.max(opts.from.Y, opts.to.Y) + (opts.arc or 3), mid.Z),
		to = opts.to,
		t0 = os.clock() + (opts.delay or 0),
		dur = opts.duration or 0.6,
		s0 = opts.size or 0.9,
		s1 = opts.endSize or opts.size or 0.9,
		turn = (math.random() * 2 - 1) * 4 + 8,
		onDone = opts.onDone,
	})
end

local function stepHops(now: number)
	for i = #hops, 1, -1 do
		local h = hops[i]
		local t = (now - h.t0) / h.dur
		if t < 0 then
			continue
		end
		if t >= 1 then
			h.part.CFrame = FAR
			table.insert(hopPool, h.part)
			table.remove(hops, i)
			if h.onDone then
				task.spawn(h.onDone)
			end
			continue
		end
		local u = 1 - t
		local pos = h.from * (u * u) + h.ctrl * (2 * u * t) + h.to * (t * t)
		local s = h.s0 + (h.s1 - h.s0) * t
		h.part.Size = Vector3.new(0.18, s, s)
		h.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, (now - h.t0) * h.turn, 0)
	end
end

type Star = {
	anchor: Part,
	gui: BillboardGui,
	label: TextLabel,
	stroke: UIStroke,
	from: Vector3,
	drift: Vector3,
	t0: number,
	life: number,
	size: number,
	turn: number,
}

local MAX_STARS = 14
local stars: { Star } = {}
local starPool: { Star } = {}

local function newStar(): Star
	local anchor = newPart(Enum.PartType.Block, "StarAnchor", WHITE, Vector3.new(0.1, 0.1, 0.1))
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Name = "Star"
	gui.LightInfluence = 0
	gui.MaxDistance = 45
	gui.Size = UDim2.fromScale(1, 1)
	gui.Enabled = false
	gui.Adornee = anchor
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Font = Theme.Fonts.UI
	label.TextScaled = true
	label.Text = "★"
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = WHITE
	stroke.Thickness = 2
	stroke.Parent = label
	return {
		anchor = anchor,
		gui = gui,
		label = label,
		stroke = stroke,
		from = Vector3.zero,
		drift = Vector3.zero,
		t0 = 0,
		life = 1,
		size = 1,
		turn = 0,
	}
end

-- A few stars pop out (Back ease), float up and fade.
local function starBurst(pos: Vector3, count: number, color: Color3?)
	local now = os.clock()
	local cap = Budget.count(MAX_STARS)
	for i = 1, Budget.count(count) do
		if #stars >= cap then
			break
		end
		local star = table.remove(starPool) or newStar()
		local a = math.random() * math.pi * 2
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		star.from = pos + out * 0.4
		star.drift = out * (1.2 + math.random() * 1.5) + UP * (2.2 + math.random() * 1.6)
		star.t0 = now + (i - 1) * 0.06
		star.life = 0.85 + math.random() * 0.3
		star.size = 0.9 + math.random() * 0.5
		star.turn = (math.random() * 2 - 1) * 90
		star.label.TextColor3 = color or CONFETTI_COLORS[(i - 1) % 3 + 1]
		star.anchor.CFrame = CFrame.new(star.from)
		table.insert(stars, star)
	end
end

local function stepStars(now: number)
	for i = #stars, 1, -1 do
		local star = stars[i]
		local age = now - star.t0
		if age < 0 then
			continue
		end
		local t = age / star.life
		if t >= 1 then
			star.gui.Enabled = false
			star.anchor.CFrame = FAR
			table.insert(starPool, star)
			table.remove(stars, i)
			continue
		end
		local grow = easeOutBack(math.min(1, t / 0.25))
		local fade = math.clamp((t - 0.6) / 0.4, 0, 1)
		local s = star.size * grow
		star.gui.Enabled = true
		star.gui.Size = UDim2.fromScale(s, s)
		star.anchor.CFrame = CFrame.new(star.from + star.drift * easeOutQuad(t))
		star.label.Rotation = star.turn * t
		star.label.TextTransparency = fade
		star.stroke.Transparency = fade
	end
end

local puffPool: { Part } = {}

-- A soft ring of cartoon dust balls that spread out, grow and fade.
local function puff(pos: Vector3, color: Color3?, radius: number?, count: number?)
	local n = count or 10
	local r = radius or 3
	local tint = (color or CREAM):Lerp(WHITE, 0.4)
	local size = math.clamp(r * 0.22, 0.5, 1.4)
	for i = 1, n do
		local ball = table.remove(puffPool) or newPart(Enum.PartType.Ball, "Puff", WHITE, Vector3.one)
		local a = (i / n) * math.pi * 2 + math.random() * 0.3
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local s = size * (0.8 + math.random() * 0.4)
		ball.Color = tint
		ball.Transparency = 0.15
		ball.Size = Vector3.one * s * 0.4
		ball.CFrame = CFrame.new(pos + dir * r * 0.2)
		local tween = TweenService:Create(
			ball,
			TweenInfo.new(0.4 + math.random() * 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = CFrame.new(pos + dir * r + UP * (0.3 + math.random() * 0.4)), Size = Vector3.one * s, Transparency = 1 }
		)
		tween.Completed:Once(function()
			ball.CFrame = FAR
			table.insert(puffPool, ball)
		end)
		tween:Play()
	end
end

-- Plot parts --------------------------------------------------------------------------------

local plot: Instance? = nil
local collectPad: BasePart? = nil
local pads: { BasePart } = {}
local holos: { [number]: BasePart } = {}

local function padTop(pad: BasePart): Vector3
	local thickness = if (pad :: Part).Shape == Enum.PartType.Cylinder then pad.Size.X else pad.Size.Y
	return pad.Position + Vector3.new(0, thickness / 2, 0)
end

local function childrenNamed(p: Instance, name: string): { BasePart }
	local out = {}
	for _, child in p:GetChildren() do
		if child:IsA("BasePart") and child.Name == name then
			table.insert(out, child)
		end
	end
	return out
end

local function modelParts(model: Instance): ({ BasePart }, { CFrame })
	local parts, bases = {}, {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(bases, d.CFrame)
		end
	end
	return parts, bases
end

local function converterActive(): boolean
	local data = State.data
	return data ~= nil and (tonumber(data.queue) or 0) > 0
end

-- Converter (blender) -------------------------------------------------------------------------

local core: BasePart? = nil
local spinParts: { BasePart } = {}
local spinBase: { CFrame } = {}
local spinAxis = Vector3.zero
local lidParts: { BasePart } = {}
local lidBase: { CFrame } = {}
local juice: BasePart? = nil
local juiceCF = CFrame.identity
local juiceSize = Vector3.one
local intake: BasePart? = nil

local spin = 0
local spinSpeed = 0.4
local glow = 0
local lid: Spring = { x = 0, v = 0 }
local nextCoinHop = 0

local function bindConverter(p: Instance)
	table.clear(spinParts)
	table.clear(spinBase)
	table.clear(lidParts)
	table.clear(lidBase)
	local c = p:FindFirstChild("ConverterCore") :: BasePart?
	core = c
	if c then
		spinAxis = c.CFrame.Position
		table.insert(spinParts, c)
		for _, blade in childrenNamed(p, "ConverterBlade") do
			table.insert(spinParts, blade)
		end
		for i, part in spinParts do
			spinBase[i] = part.CFrame
		end
	end
	for _, name in { "ConverterLid", "ConverterLidRim", "ConverterIntake", "ConverterIntakeTop" } do
		for _, part in childrenNamed(p, name) do
			table.insert(lidParts, part)
			table.insert(lidBase, part.CFrame)
		end
	end
	intake = p:FindFirstChild("ConverterIntake") :: BasePart?
	juice = p:FindFirstChild("ConverterJuice") :: BasePart?
	if juice then
		juiceCF = juice.CFrame
		juiceSize = juice.Size
	end
end

local function stepConverter(dt: number, now: number)
	local c = core
	if not c or not c.Parent then
		return
	end
	local active = converterActive()
	spinSpeed += ((if active then 10 else 0.4) - spinSpeed) * math.min(1, dt * 2)
	spin = (spin + spinSpeed * dt) % (math.pi * 2)
	glow += ((if active then 1 else 0) - glow) * math.min(1, dt * 3)
	stepSpring(lid, dt, 260, 14)

	local parts, cframes = {}, {}
	local rot = CFrame.new(spinAxis) * CFrame.Angles(0, spin, 0) * CFrame.new(-spinAxis)
	for i, part in spinParts do
		table.insert(parts, part)
		table.insert(cframes, rot * spinBase[i])
	end
	-- The lid rattles softly while blending and hops on the spring after deposits.
	local lift = lid.x + glow * 0.035 * math.sin(now * 23)
	for i, part in lidParts do
		table.insert(parts, part)
		table.insert(cframes, lidBase[i] + UP * lift)
	end
	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)

	-- The smoothie rises and swirls while blending.
	local j = juice
	if j and j.Parent then
		local h = juiceSize.X * (1 + glow * (0.14 + math.sin(now * 3.2) * 0.04) + math.max(0, lid.x) * 0.3)
		j.Size = Vector3.new(h, juiceSize.Y, juiceSize.Z)
		j.CFrame = juiceCF + UP * ((h - juiceSize.X) / 2)
	end

	-- Fresh coins hop from the blender to the Collect pad while it works.
	if active and collectPad and now >= nextCoinHop then
		nextCoinHop = now + 1.3
		hop({
			from = spinAxis + UP * 2,
			to = padTop(collectPad) + UP * 0.6,
			duration = 1,
			arc = 5,
			size = 0.9,
			endSize = 0.6,
		})
	end
end

local function onDeposit(data: any)
	local to: Vector3? = if typeof(data.to) == "Vector3"
		then data.to
		elseif intake then intake.Position
		elseif core then core.Position
		else nil
	if not to then
		return
	end
	local from: Vector3 = if typeof(data.from) == "Vector3" then data.from else to + Vector3.new(0, 6, 6)
	local amount = tonumber(data.amount) or 0
	local count = math.clamp(8 + math.floor(math.log10(math.max(1, amount)) * 2), 8, 16)
	local first = true
	for i = 1, count do
		local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.2
		Orbs.fly({
			from = from + jitter,
			to = to,
			color = if i % 4 == 0 then C.OrbBig else C.Orb,
			size = 0.7,
			endSize = 0.35,
			duration = 0.4,
			delay = (i - 1) * (0.6 / count),
			arc = 3 + math.random() * 2,
			onDone = function()
				lid.v = math.min(lid.v + 1.6, 6)
				if first then
					first = false
					puff(to, GRAPE, 1.6, 6)
				end
			end,
		})
	end
	task.delay(1, function()
		lid.v += 4
		confettiBurst(to + UP * 0.5, 10, 0.8, { GRAPE, SUNNY, WHITE })
		starBurst(to + UP, 2, GRAPE)
	end)
end

-- Processor (juice-bar conveyor) ----------------------------------------------------------------

type Cup = { parts: { BasePart }, base: { CFrame }, z0: number }

local belt: BasePart? = nil
local cups: { Cup } = {}
local cupStart = 0
local cupCycle = 1
local beltEnd = 0
local lights: { BasePart } = {}
local lightBase: { Color3 } = {}
local beltOffset = 0
local beltSpeed = 0
local cupHop: Spring = { x = 0, v = 0 }
local lightFlash = 0

local function bindProcessor(p: Instance)
	table.clear(cups)
	table.clear(lights)
	table.clear(lightBase)
	local b = p:FindFirstChild("ProcessorBelt") :: BasePart?
	belt = b
	if not b then
		return
	end
	for _, child in p:GetChildren() do
		if child.Name == "ProcessorCup" then
			local parts, bases = modelParts(child)
			if #parts > 0 then
				table.insert(cups, { parts = parts, base = bases, z0 = b.CFrame:PointToObjectSpace(bases[1].Position).Z })
			end
		end
	end
	table.sort(cups, function(a, c)
		return a.z0 < c.z0
	end)
	if #cups >= 2 then
		cupStart = cups[1].z0
		cupCycle = (cups[#cups].z0 - cupStart) / (#cups - 1) * #cups
	end
	beltEnd = b.Size.Z / 2 - 0.5
	lights = childrenNamed(p, "ProcessorLight")
	table.sort(lights, function(a, c)
		return b.CFrame:PointToObjectSpace(a.Position).Z < b.CFrame:PointToObjectSpace(c.Position).Z
	end)
	for i, light in lights do
		lightBase[i] = light.Color
	end
end

local function stepProcessor(dt: number, now: number)
	local b = belt
	if not b or not b.Parent then
		return
	end
	local active = converterActive()
	beltSpeed += ((if active then 1.6 else 0) - beltSpeed) * math.min(1, dt * 2.5)
	beltOffset = (beltOffset + beltSpeed * dt) % cupCycle
	stepSpring(cupHop, dt, 240, 12)
	lightFlash = math.max(0, lightFlash - dt)

	if #cups >= 2 then
		local parts, cframes = {}, {}
		local along = b.CFrame:VectorToWorldSpace(Vector3.zAxis)
		for i, cup in cups do
			local z = cupStart + (cup.z0 - cupStart + beltOffset) % cupCycle
			-- Cups fade in under the jug and fade out at the end of the belt.
			local vis = math.clamp(math.min((z - cupStart) / 0.6, (beltEnd - z) / 0.6), 0, 1)
			local wobble = math.sin(now * 9 + i) * 0.03 * (beltSpeed / 1.6)
			local offset = along * (z - cup.z0) + UP * (cupHop.x + wobble)
			for k, part in cup.parts do
				part.LocalTransparencyModifier = 1 - vis
				table.insert(parts, part)
				table.insert(cframes, cup.base[k] + offset)
			end
		end
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	-- Progress dots fill up one by one while processing.
	local n = #lights
	local lit = if active then math.floor(((now * 0.9) % 1) * (n + 1)) else 0
	for i, light in lights do
		local on = lightFlash > 0 or i <= lit
		local target = if on then TEAL else lightBase[i]
		light.Color = light.Color:Lerp(target, math.min(1, dt * 10))
	end
end

-- Vault (piggy bank) ------------------------------------------------------------------------------

local pigParts: { BasePart } = {}
local pigBase: { CFrame } = {}
local vaultCoins: { BasePart } = {}
local vaultCoinBase: { CFrame } = {}
local slotPos: Vector3? = nil
local pigHop: Spring = { x = 0, v = 0 }
local coinDip: Spring = { x = 0, v = 0 }

local function bindVault(p: Instance)
	table.clear(pigParts)
	table.clear(pigBase)
	table.clear(vaultCoins)
	table.clear(vaultCoinBase)
	slotPos = nil
	for _, child in p:GetChildren() do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 5) == "Piggy" then
			table.insert(pigParts, child)
			table.insert(pigBase, child.CFrame)
			if child.Name == "PiggySlot" then
				slotPos = child.Position
			end
		end
	end
	for _, name in { "Coin", "CoinRim" } do
		local part = p:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(vaultCoins, part)
			table.insert(vaultCoinBase, part.CFrame)
		end
	end
end

local function stepVault(dt: number, now: number)
	if #pigParts == 0 then
		return
	end
	stepSpring(pigHop, dt, 200, 11)
	stepSpring(coinDip, dt, 260, 13)
	local parts, cframes = {}, {}
	-- The pig breathes gently and bounces when it gets coins.
	local lift = math.sin(now * 1.7) * 0.04 + pigHop.x
	for i, part in pigParts do
		table.insert(parts, part)
		table.insert(cframes, pigBase[i] + UP * lift)
	end
	local sway = math.sin(now * 0.9) * 0.12
	for i, part in vaultCoins do
		local base = vaultCoinBase[i]
		local pos = base.Position + UP * (lift + coinDip.x + math.sin(now * 1.2) * 0.08)
		table.insert(parts, part)
		table.insert(cframes, CFrame.new(pos) * CFrame.Angles(0, sway, 0) * base.Rotation)
	end
	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Collect pad coin stack ----------------------------------------------------------------------

local MAX_COINS = 24
local coins: { Part } = {}
local coinHomes: { CFrame } = {}
local shownCoins = 0
local burstAt = 0

local function coinTarget(): number
	local data = State.data
	local pending = if data then tonumber(data.pending) or 0 else 0
	if pending < 1 or os.clock() - burstAt < 1 then
		return 0
	end
	return math.clamp(math.floor(math.log10(pending) * 5) + 1, 1, MAX_COINS)
end

local function coinHome(i: number, pad: BasePart): CFrame
	local col = (i - 1) % 3
	local layer = math.floor((i - 1) / 3)
	local offsets = { Vector3.new(-0.6, 0, -0.35), Vector3.new(0.6, 0, -0.35), Vector3.new(0, 0, 0.6) }
	local base = padTop(pad) + offsets[col + 1] + Vector3.new(0, 0.14 + layer * 0.26, 0)
	return CFrame.new(base) * CFrame.Angles(0, math.rad((i * 47) % 360), 0) * UPRIGHT
end

local function syncCoins()
	local pad = collectPad
	if not pad then
		return
	end
	local target = coinTarget()
	if target == shownCoins then
		return
	end
	if #coins == 0 then
		for i = 1, MAX_COINS do
			coins[i] = newPart(Enum.PartType.Cylinder, "Coin", SUNNY, Vector3.new(0.22, 1.05, 1.05))
			coinHomes[i] = FAR
		end
	end
	if target > shownCoins then
		for i = shownCoins + 1, target do
			local home = coinHome(i, pad)
			coinHomes[i] = home
			local coin = coins[i]
			coin.CFrame = home + Vector3.new(0, 1.6, 0)
			coin.Transparency = 1
			TweenService:Create(
				coin,
				TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, (i - shownCoins - 1) * 0.04),
				{ CFrame = home, Transparency = 0 }
			):Play()
		end
	else
		for i = target + 1, shownCoins do
			coins[i].CFrame = FAR
			coinHomes[i] = FAR
		end
	end
	shownCoins = target
end

local lastShower = 0

-- Coin shower around the player: big for a purchased cash pack, modest otherwise.
local function cashShower(amount: number, big: boolean)
	local now = os.clock()
	if not big and now - lastShower < 2 then
		return
	end
	lastShower = now
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local pos = root.Position
	local floor = pos.Y - 2.8
	local magnitude = math.log10(math.max(amount, 1))
	local feet = Vector3.new(pos.X, floor + 0.3, pos.Z)
	if big then
		puff(feet, SUNNY, 5, 14)
		starBurst(pos + UP * 2, 5, SUNNY)
		Camera.punch(0.5)
		play("CelebrateLegendary")
		Orbs.text(pos + Vector3.new(0, 5, 0), "+" .. Format.money(amount), SUNNY, { scale = 2.2, rise = 4, life = 1.8 })
		for wave = 0, 3 do
			task.delay(wave * 0.25, function()
				Orbs.coins(pos, {
					count = 10,
					speed = 6,
					spread = 8,
					height = 12 + wave * 2,
					floor = floor,
					life = 1.7,
					toWallet = true,
					stagger = 0.03,
				})
				play("Coin", 0.05, 1 + wave * 0.12)
			end)
		end
		-- Bills and confetti fluttering down from above.
		confettiBurst(pos + UP * 9, 30, 0.6, { TEAL_LIGHT, SUNNY, BLUE, SUNNY })
	else
		Orbs.coins(pos + Vector3.new(0, 1, 0), {
			count = math.clamp(4 + math.floor(magnitude * 1.5), 4, 12),
			speed = 18,
			spread = 1,
			floor = floor,
			life = 1.1,
			toWallet = true,
		})
		puff(feet, SUNNY, 2.5, 8)
	end
end

local function onCash(data: any)
	-- Auto Cash payouts are silent: no coin shower around the player.
	if data.source == "Auto" then
		return
	end
	local amount = tonumber(data.amount) or 0
	if data.source == "Purchase" or typeof(data.padPos) ~= "Vector3" then
		cashShower(amount, data.source == "Purchase")
		return
	end
	local pos: Vector3 = data.padPos
	local n = math.min(math.max(shownCoins, 6), 12)
	local target = slotPos
	for i = 1, n do
		local from = if i <= shownCoins then coinHomes[i].Position else pos + UP * 0.5
		if target then
			-- Coins hop off the stack into the piggy bank's slot.
			hop({
				from = from,
				to = target + UP * 0.4,
				delay = (i - 1) * 0.05,
				duration = 0.55,
				arc = 4,
				size = 1,
				endSize = 0.6,
				onDone = function()
					pigHop.v = math.min(pigHop.v + (if i == 1 then 5 else 1.2), 9)
					coinDip.v -= 1.5
					if i == n then
						confettiBurst(target + UP * 1.5, 14, 0.8, { SUNNY, TEAL_LIGHT, BLUE })
						starBurst(target + UP * 1.5, 3, SUNNY)
					end
				end,
			})
		else
			local dir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit * (1.5 + math.random() * 2)
			hop({ from = from, to = pos + dir + UP * 0.3, delay = i * 0.03, duration = 0.5, arc = 3 })
		end
	end
	for i = 1, shownCoins do
		coins[i].CFrame = FAR
	end
	shownCoins = 0
	burstAt = os.clock()
	puff(pos + UP * 0.4, TEAL_LIGHT, 3, 10)
end

-- Buy: "-$cost" float and a coin puff at the pad ----------------------------------------------

local function onBuy(data: any)
	if typeof(data.padPos) ~= "Vector3" then
		return
	end
	local pos: Vector3 = data.padPos + Vector3.new(0, 0.5, 0)
	local cost = tonumber(data.cost)
	local magnitude = if cost then math.log10(math.max(cost, 1)) else 1
	local k = math.clamp(0.9 + magnitude * 0.08, 0.9, 1.5)
	if cost and cost > 0 then
		Orbs.text(pos + Vector3.new(0, 3, 0), "-" .. Format.money(cost), CORAL, { scale = k, rise = 3 })
	end
	Orbs.coins(pos, { count = math.clamp(3 + math.floor(magnitude), 4, 8), speed = 14 * k, spread = 0.6, life = 0.8 })
	puff(pos, SUNNY, 2.4 * k, 8)
end

-- Pad deny: soft coral tint and a damped wobble ------------------------------------------------

local denyBase: { [BasePart]: CFrame } = {}
local denyFlash: { [BasePart]: Part } = {}
local denyToken: { [BasePart]: number } = {}
local hudModule: any = nil

local function shakeWallet()
	if hudModule == nil then
		local ok, mod = pcall(function()
			return require(Client:WaitForChild("UI"):WaitForChild("Hud") :: ModuleScript) :: any
		end)
		hudModule = if ok then mod else false
	end
	if hudModule and type(hudModule.shakeWallet) == "function" then
		pcall(hudModule.shakeWallet)
	end
end

local function findPad(data: any): BasePart?
	local p = plot
	if not p then
		return nil
	end
	if type(data.name) == "string" then
		local named = p:FindFirstChild("Pad_" .. data.name) or p:FindFirstChild(data.name)
		if named and named:IsA("BasePart") then
			return named
		end
	end
	if typeof(data.padPos) == "Vector3" then
		local best, bestDist = nil, 6
		for _, pad in pads do
			local d = (pad.Position - data.padPos).Magnitude
			if d < bestDist then
				best, bestDist = pad, d
			end
		end
		return best
	end
	return nil
end

local function onPadDeny(data: any)
	if data.ok ~= false then
		return
	end
	play("Error")
	if data.reason == "money" then
		shakeWallet()
	end
	local pad = findPad(data)
	local top = if pad then padTop(pad) elseif typeof(data.padPos) == "Vector3" then data.padPos else nil
	if top then
		local word = if data.reason == "money" then "NEED CASH!" elseif data.reason == "locked" then "LOCKED" else "NOPE"
		Orbs.text(top + Vector3.new(0, 3, 0), word, CORAL, { scale = 0.85, rise = 1.8, life = 0.9 })
	end
	if not pad then
		return
	end
	local base = denyBase[pad] or pad.CFrame
	denyBase[pad] = base
	-- Coral overlay that fades out while the pad wobbles side to side.
	local flash = denyFlash[pad]
	if not flash then
		local f = newPart((pad :: Part).Shape, "DenyFlash", CORAL, pad.Size + Vector3.new(0.06, 0.06, 0.06))
		denyFlash[pad] = f
		flash = f
	end
	local slab = flash :: Part
	slab.Transparency = 0.35
	local start = os.clock()
	denyToken[pad] = start
	local length = 0.42
	local right = base.RightVector
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		if denyToken[pad] ~= start then
			conn:Disconnect() -- a newer deny took over this pad
			return
		end
		local t = (os.clock() - start) / length
		if t >= 1 or not pad.Parent then
			conn:Disconnect()
			if pad.Parent then
				pad.CFrame = base
			end
			denyBase[pad] = nil
			denyToken[pad] = nil
			slab.CFrame = FAR
			return
		end
		local offset = right * math.sin(t * math.pi * 5) * 0.28 * (1 - t) ^ 2
		pad.CFrame = base + offset
		slab.CFrame = base + offset + Vector3.new(0, 0.03, 0)
		slab.Transparency = 0.35 + 0.65 * easeOutQuad(t)
	end)
end

-- Idle breathing on pads the player can use right now --------------------------------------------

local padBase: { [BasePart]: Color3 } = {}
local padGlow: { [BasePart]: number } = {}
local padReady: { [string]: boolean } = {}
local nextReadyCheck = 0

local function computeReady(data: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	local money = tonumber(data.money) or 0
	local bought = tonumber(data.bought) or 0
	for _, amount in Economy.BUY_AMOUNTS do
		out["Buy" .. amount] = money >= Economy.bulkPrice(bought, amount) - 1e-6
	end
	-- Auto Merge is a game pass: the pad invites a tap until it is owned.
	out.AutoMerge = not data.autoMergeOwned
	local level = tonumber(data.processLevel)
	if level then
		out.ProcUp1 = money >= Economy.processUpgradeCost(level)
		out.ProcUp10 = money >= Economy.processBulkCost(level, Economy.PROCESS_BULK)
	end
	out.Collect = (tonumber(data.pending) or 0) >= 1
	out.Deposit = (tonumber(data.carried) or 0) > 0
	out.Free = (tonumber(data.freeIn) or 1) - State.age() <= 0
	local slots = data.unlockers
	local held = type(data.heldChest) == "string" and data.heldChest ~= ""
	for i = 1, 2 do
		local slot = if type(slots) == "table" then slots[i] else nil
		local locked = i == 2 and not (type(data.passes) == "table" and data.passes.PremiumUnlocker)
		if not locked and type(slot) == "table" then
			if slot.rarity == "" then
				out["Unlock" .. i] = held
			else
				out["Unlock" .. i] = (tonumber(slot.secondsLeft) or 0) - State.age() <= 0
			end
		end
	end
	return out
end

local function stepPads(dt: number, now: number)
	if now >= nextReadyCheck then
		nextReadyCheck = now + 0.3
		local data = State.data
		local ok, result = pcall(computeReady, data or {})
		padReady = if ok and data then result else {}
	end
	for i, pad in pads do
		local base = padBase[pad]
		if not base or not pad.Parent then
			continue
		end
		local name = string.sub(pad.Name, 5)
		local g = padGlow[pad] or 0
		local target = if padReady[name] then 1 else 0
		if g == target and g == 0 then
			continue
		end
		g += (target - g) * math.min(1, dt * 3)
		if math.abs(g - target) < 0.002 then
			g = target
		end
		padGlow[pad] = g
		-- A very slow (about 4 s) brighten-and-back, 1.5-3% toward white.
		local breath = 0.5 + 0.5 * math.sin(now * 1.6 + i * 0.7)
		pad.Color = base:Lerp(WHITE, g * (0.015 + 0.015 * breath))
	end
end

-- Upgrade burst -------------------------------------------------------------------------------

local function onUpgrade(data: any)
	if typeof(data.padPos) ~= "Vector3" then
		return
	end
	local pos: Vector3 = data.padPos + Vector3.new(0, 0.5, 0)
	puff(pos, TEAL_LIGHT, 4.5, 12)
	task.delay(0.1, function()
		confettiBurst(pos + UP * 0.6, 18, 1)
		starBurst(pos + UP * 1.5, 4)
	end)
	if type(data.pad) == "string" and string.find(data.pad, "ProcUp") then
		lid.v += 5
		cupHop.v += 5
		lightFlash = 0.6
	end
end

-- Crate Smasher -----------------------------------------------------------------------------

type Bell = {
	parts: { BasePart },
	base: { CFrame },
	pivot: Vector3,
	swing: Spring,
	nextRing: number,
	-- The striker puck: it rides up the track, the bell swings when it arrives, then it drops.
	puck: BasePart?,
	puckBase: CFrame,
	puckRise: number,
	puckT0: number,
	pendingSwing: number,
}

local PUCK_UP = 0.3
local PUCK_HOLD = 0.12
local PUCK_DOWN = 0.45

type Cracker = {
	model: Model?,
	body: Part?,
	parts: { Part },
	offsets: { CFrame },
	gui: BillboardGui?,
	card: Frame?,
	rarity: string,
	ready: boolean,
	shakeUntil: number,
	nextShake: number,
}

local crackers: { [number]: Cracker } = {}
local bells: { [number]: Bell } = {}

local function rarityColor(rarity: string): Color3
	return (C.Rarity and C.Rarity[rarity]) or SUNNY
end

local function bindCrackers(p: Instance)
	table.clear(holos)
	table.clear(bells)
	-- Match each HoloCrate and striker bell to the nearest Crate Smasher pad.
	local crates = childrenNamed(p, "HoloCrate")
	for i = 1, 2 do
		local pad = p:FindFirstChild("Pad_Unlock" .. i) :: BasePart?
		local best, bestDist = nil, math.huge
		for _, holo in crates do
			local d = if pad then (holo.Position - pad.Position).Magnitude else 0
			if d < bestDist and not table.find(holos, holo) then
				best, bestDist = holo, d
			end
		end
		if best then
			holos[i] = best
		end
	end
	local used: { [Instance]: boolean } = {}
	for i, holo in holos do
		local best: Bell?, bestDist = nil, math.huge
		local bestModel: Instance? = nil
		for _, child in p:GetChildren() do
			if child.Name ~= "StrikerBell" or used[child] then
				continue
			end
			local parts, bases = modelParts(child)
			if #parts == 0 then
				continue
			end
			local top = parts[1].Position
			for _, part in parts do
				if part.Position.Y > top.Y then
					top = part.Position
				end
			end
			local flat = Vector3.new(top.X - holo.Position.X, 0, top.Z - holo.Position.Z)
			if flat.Magnitude < bestDist then
				bestDist = flat.Magnitude
				best = {
					parts = parts,
					base = bases,
					pivot = top,
					swing = { x = 0, v = 0 },
					nextRing = 0,
					puckBase = CFrame.identity,
					puckRise = 0,
					puckT0 = -math.huge,
					pendingSwing = 0,
				}
				bestModel = child
			end
		end
		if best and bestModel then
			used[bestModel] = true
			bells[i] = best
		end
	end
	-- Each bell gets the striker puck nearest to it.
	local pucks = childrenNamed(p, "StrikerPuck")
	for _, bell in bells do
		local nearest: BasePart?, nearestDist = nil, math.huge
		for _, puck in pucks do
			local d = Vector3.new(puck.Position.X - bell.pivot.X, 0, puck.Position.Z - bell.pivot.Z).Magnitude
			if d < nearestDist then
				nearest, nearestDist = puck, d
			end
		end
		if nearest then
			bell.puck = nearest
			bell.puckBase = nearest.CFrame
			bell.puckRise = tonumber(nearest:GetAttribute("Rise")) or 3.5
		end
	end
end

local function swingBell(bell: Bell, strength: number)
	bell.swing.v += strength
	starBurst(bell.pivot + UP * 0.3, 2, SUNNY)
end

-- Sends the puck up the track; the bell swings when it gets there (straight away if there is
-- no puck).
local function ringBell(i: number, strength: number)
	local bell = bells[i]
	if not bell then
		return
	end
	if bell.puck and bell.puck.Parent then
		bell.puckT0 = os.clock()
		bell.pendingSwing = strength
	else
		swingBell(bell, strength)
	end
end

-- Puck height above its rest spot at time t since launch: eased up, a short hold, then a
-- drop with one small bounce at the bottom.
local function puckLift(t: number, rise: number): number
	if t < 0 then
		return 0
	elseif t < PUCK_UP then
		return rise * easeOutQuad(t / PUCK_UP)
	elseif t < PUCK_UP + PUCK_HOLD then
		return rise
	end
	local u = (t - PUCK_UP - PUCK_HOLD) / PUCK_DOWN
	if u >= 1 then
		return 0
	elseif u < 0.75 then
		local f = u / 0.75
		return rise * (1 - f * f)
	end
	local b = (u - 0.75) / 0.25
	return rise * 0.06 * math.sin(b * math.pi)
end

local function destroyCrate(cr: Cracker, burst: boolean)
	if burst and cr.body then
		local pos = cr.body.Position
		local color = rarityColor(cr.rarity)
		puff(pos - UP * 0.6, color, 3, 10)
		confettiBurst(pos, 20, 1, { color, SUNNY, WHITE, TEAL_LIGHT })
		starBurst(pos + UP, 4, color)
	end
	if cr.model then
		cr.model:Destroy()
	end
	cr.model, cr.body, cr.gui, cr.card = nil, nil, nil, nil
	table.clear(cr.parts)
	table.clear(cr.offsets)
	cr.rarity = ""
	cr.ready = false
end

local function buildCrate(cr: Cracker, rarity: string)
	local color = rarityColor(rarity)
	local model = Instance.new("Model")
	model.Name = "CrackerCrate"
	-- Sunny crate (like the pen's chests) strapped in the rarity colour.
	local body = newPart(Enum.PartType.Block, "Body", SUNNY, Vector3.new(1.7, 1.5, 2.1))
	body.Parent = model
	local bandA = newPart(Enum.PartType.Block, "Band", color, Vector3.new(1.76, 0.28, 2.16))
	bandA.Parent = model
	local bandB = newPart(Enum.PartType.Block, "Band", color, Vector3.new(1.76, 1.56, 0.28))
	bandB.Parent = model

	-- READY! card: cream pill with a rarity-coloured outline and Ink text.
	local gui = Instance.new("BillboardGui")
	gui.Name = "Ready"
	gui.LightInfluence = 0
	gui.MaxDistance = 45
	gui.Size = UDim2.fromOffset(120, 44)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.Enabled = false
	gui.Parent = body
	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = CREAM
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = card
	local outline = Instance.new("UIStroke")
	outline.Thickness = 3
	outline.Color = color
	outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	outline.Parent = card
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(0.86, 0.72)
	label.Font = Theme.Fonts.Title
	label.TextScaled = true
	label.Text = "READY!"
	label.TextColor3 = INK
	label.Parent = card

	model.Parent = fxFolder
	cr.model = model
	cr.body = body
	cr.parts = { body, bandA, bandB }
	cr.offsets = { CFrame.identity, CFrame.identity, CFrame.identity }
	cr.gui = gui
	cr.card = card
	cr.rarity = rarity
	cr.ready = false
	cr.shakeUntil = 0
	cr.nextShake = 0
end

local function syncCrackers(fromSnapshot: boolean)
	local data = State.data
	local slots = data and data.unlockers
	for i = 1, 2 do
		local cr = crackers[i]
		if not cr then
			cr = {
				parts = {},
				offsets = {},
				rarity = "",
				ready = false,
				shakeUntil = 0,
				nextShake = 0,
			}
			crackers[i] = cr
		end
		local slot = slots and slots[i]
		local rarity = if type(slot) == "table" and type(slot.rarity) == "string" then slot.rarity else ""
		if rarity ~= cr.rarity then
			destroyCrate(cr, fromSnapshot and cr.rarity ~= "" and rarity == "")
			if rarity ~= "" and holos[i] then
				buildCrate(cr, rarity)
			end
		end
		local holo = holos[i]
		if holo then
			holo.LocalTransparencyModifier = if cr.model then 1 else 0
		end
	end
end

local function stepBells(dt: number, now: number)
	local parts, cframes = {}, {}
	for i, bell in bells do
		local cr = crackers[i]
		if cr and cr.ready and now >= bell.nextRing then
			bell.nextRing = now + 2.6
			ringBell(i, 2.2)
		end
		local puck = bell.puck
		if puck and puck.Parent then
			local t = now - bell.puckT0
			if bell.pendingSwing > 0 and t >= PUCK_UP then
				swingBell(bell, bell.pendingSwing)
				bell.pendingSwing = 0
			end
			table.insert(parts, puck)
			table.insert(cframes, bell.puckBase + UP * puckLift(t, bell.puckRise))
		end
		stepSpring(bell.swing, dt, 70, 3.5)
		local angle = math.clamp(bell.swing.x, -0.5, 0.5)
		local rot = CFrame.new(bell.pivot) * CFrame.fromAxisAngle(Vector3.xAxis, angle) * CFrame.new(-bell.pivot)
		for k, part in bell.parts do
			table.insert(parts, part)
			table.insert(cframes, rot * bell.base[k])
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function stepCrackers(now: number)
	local data = State.data
	local slots = data and data.unlockers
	for i, cr in crackers do
		local holo = holos[i]
		if not cr.model or not holo then
			continue
		end
		local slot = slots and slots[i]
		local left = if type(slot) == "table" then tonumber(slot.secondsLeft) or 0 else 0
		left = math.max(0, left - State.age())
		local ready = left <= 0
		if ready ~= cr.ready then
			cr.ready = ready
			local gui, card = cr.gui, cr.card
			if gui then
				gui.Enabled = ready
			end
			if ready and card then
				card.Size = UDim2.fromScale(0.2, 0.2)
				TweenService
					:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(1, 1) })
					:Play()
			end
			if ready then
				local color = rarityColor(cr.rarity)
				confettiBurst(holo.Position + UP, 16, 0.9, { color, SUNNY, WHITE })
				ringBell(i, 4)
				if bells[i] then
					bells[i].nextRing = now + 2.6
				end
				play("Ready")
			end
		end

		local urgency = 1 - math.clamp(left / 300, 0, 1)
		local base = CFrame.new(holo.Position + Vector3.new(0, -0.2, 0)) * CFrame.Angles(0, math.rad(20), 0)
		local shake = CFrame.identity
		if ready then
			-- Calm happy hop and a slow turn.
			local hopY = math.abs(math.sin(now * 3)) * 0.3
			shake = CFrame.new(0, hopY, 0) * CFrame.Angles(0, now * 0.8, math.sin(now * 6) * 0.05)
			if cr.gui then
				cr.gui.StudsOffset = Vector3.new(0, 2.6 + math.sin(now * 2.5) * 0.15, 0)
			end
		else
			if now >= cr.nextShake then
				cr.shakeUntil = now + 0.25 + urgency * 0.2
				cr.nextShake = now + math.clamp(left / 30, 0.4, 2.5)
			end
			if now < cr.shakeUntil then
				local amp = 0.03 + urgency * 0.08
				shake = CFrame.new(0, math.abs(math.sin(now * 30)) * amp, 0)
					* CFrame.Angles(math.sin(now * 37) * amp, math.sin(now * 23) * amp * 0.5, math.sin(now * 41) * amp)
			end
		end
		local cf = base * shake
		local cframes = {}
		for j in cr.parts do
			cframes[j] = cf * cr.offsets[j]
		end
		Workspace:BulkMoveTo(cr.parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Wiring --------------------------------------------------------------------------------------

local function bindPlot(p: Instance)
	plot = p
	table.clear(pads)
	table.clear(padBase)
	table.clear(padGlow)
	for _, child in p:GetChildren() do
		if child:IsA("BasePart") and string.sub(child.Name, 1, 4) == "Pad_" then
			table.insert(pads, child)
			padBase[child] = child.Color
		end
	end
	collectPad = p:FindFirstChild("Pad_Collect") :: BasePart?
	bindConverter(p)
	bindProcessor(p)
	bindVault(p)
	bindCrackers(p)
end

local started = false

function Machines.init()
	if started then
		return
	end
	started = true
	fxFolder = Orbs.getFolder()

	local function refresh(fromSnapshot: boolean)
		local data = State.data
		if not data or not data.plotIndex then
			return
		end
		local map = Workspace:FindFirstChild("Map")
		local p = map and map:FindFirstChild("Plot" .. tostring(data.plotIndex))
		if p and p ~= plot then
			bindPlot(p)
		end
		if plot then
			syncCrackers(fromSnapshot)
			syncCoins()
		end
	end
	State.changed.Event:Connect(function()
		refresh(true)
	end)
	refresh(false)

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		stepConfetti(dt, now)
		stepHops(now)
		stepStars(now)
		if not plot then
			return
		end
		stepConverter(dt, now)
		stepProcessor(dt, now)
		stepVault(dt, now)
		stepPads(dt, now)
		stepCrackers(now)
		stepBells(dt, now)
		if shownCoins ~= coinTarget() then
			syncCoins()
		end
	end)

	Net.event("Effect").OnClientEvent:Connect(function(kind, data)
		if not plot or type(data) ~= "table" then
			return
		end
		if kind == "Deposit" then
			onDeposit(data)
		elseif kind == "Cash" then
			onCash(data)
		elseif kind == "Upgrade" then
			onUpgrade(data)
		elseif kind == "Buy" then
			onBuy(data)
		elseif kind == "Pad" then
			onPadDeny(data)
		end
	end)
end

return Machines
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="228">
            <Properties>
              <string name="Name">Modes</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.Modes: the client side of the GAME MODES plaza and the Parkour course.

	  Movers       every "ModeMover" root (and its descendant parts) is posed each frame
	               from its attributes and workspace:GetServerTimeNow(), so all clients
	               agree (contract in Server.World.Modes). Only movers near the local
	               player animate; nothing runs while the player is far from the course.
	  Carry        while the character stands on a moving part (short downward raycast
	               against mover parts), the part's frame-to-frame motion (delta CFrame,
	               rotation included) is applied to the character's root before physics.
	  Spinners     "SpinnerBar" (Hazard = "bump"): a gentle push away plus a small hop.
	  Blink pads   tag "BlinkPad": solid when ((t + BlinkPhase) % BlinkPeriod) < BlinkOn
	               (server clock). Near the player, CanCollide and the look are set locally
	               (character physics is client-owned): faded when off, with a few quick
	               flashes in the last BLINK_WARN seconds before switching off.
	  Bounce pads  tag "BouncePad": once per contact, launch upward at the pad's Bounce
	               speed (double jump still works in the air), squash the pad, Puff sprite.
	  Effects      ModeSplash (fell through
	               the cloud floor: a white cloud poof and a short camera dip), ModeFinish
	               (stars and confetti), ModeKill (touched a kill brick: a red/black
	               burst and a short red screen flash). Spin movers with SpinAxis = "Z" (windmill blades)
	               turn about the root's look vector instead of world up.
	  Levels       a parkour run's start payload carries its level; hints and flags look in
	               Map.GameModes.Parkour.Level<level>. Mode notifications of other modes
	               (Mog Test) are ignored.
	  Hint         standing still for 4 s during a run: a short dotted trail of soft dots
	               toward the map's finish deck (there are no checkpoints).
	  Gate arrow   each open gate's "GateArrow" (tag "ModeHintArrow", attribute HintBob)
	               bobs gently while the player is near the plaza and not on a run; it
	               eases in and out and settles back at its rest pose.
	  Budget       on "low" devices (Fx.Budget) movers farther than LOW_FAR studs from
	               the player pose every 2nd frame; celebration confetti / splash dots
	               scale with Budget.count. Hints, pads and nearby movers never thin out.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)

local ModesFx = {}

local player = Players.LocalPlayer
local W = (require(ReplicatedStorage:WaitForChild("Theme")) :: any).World

-- Movers further than this from the player stay put; nothing runs beyond FAR of every mover.
local NEAR = 220
local LOW_FAR = 80 -- studs: on a "low" device movers past this pose every 2nd frame
local stepFrame = 0
local TAU = 2 * math.pi
local BUMP_COOLDOWN = 0.7
local STILL_FOR = 4
local HINT_EVERY = 8
-- Gate arrow: bobs within ARROW_NEAR studs, ARROW_SPEED rad/s, fading in/out over ARROW_FADE s.
local ARROW_NEAR = 90
local ARROW_SPEED = 2.6
local ARROW_FADE = 0.4
-- Blink pads: seconds of warning flashes before switching off, and flashes per second.
local BLINK_WARN = 0.5
local BLINK_FLASH_HZ = 6
local BLINK_OFF_TOP = 0.75
local BLINK_OFF_PART = 0.85

type Mover = {
	root: BasePart,
	rest: CFrame,
	parts: { BasePart },
	offsets: { CFrame }, -- each part relative to the root at rest
	kind: string,
	axis: Vector3,
	distance: number,
	period: number,
	speed: number,
	phase: number,
	current: CFrame,
	live: boolean, -- posed last frame (its delta is safe to carry)
	hazard: boolean,
	length: number,
	spinZ: boolean, -- SpinAxis = "Z": spins about the root's look vector, not world up
}

local movers: { Mover } = {}
local byPart: { [BasePart]: Mover } = {}
local floorParts: { Instance } = {}
local pads: { BasePart } = {}
local padRest: { [BasePart]: CFrame } = {}
local padContact: { [BasePart]: boolean } = {}
local bounds: { min: Vector3, max: Vector3 }? = nil

type Blink = {
	root: BasePart,
	centre: Vector3,
	on: number,
	period: number,
	phase: number,
	solid: { BasePart }, -- parts that collide while the pad is on
	looks: { BasePart }, -- every visible part, with its built transparency
	rest: { number },
	glow: { BasePart },
	state: string, -- "on" | "dim" (warning flash) | "off" | "" (not applied yet)
}
local blinks: { Blink } = {}
local blinkByPart: { [BasePart]: boolean } = {}

type Arrow = {
	root: BasePart,
	parts: { BasePart },
	rest: { CFrame },
	bob: number,
	fade: number, -- 0..1, eased into the bob amplitude
}
local arrows: { Arrow } = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function num(value: any, default: number): number
	return if type(value) == "number" then value else default
end

local function grow(point: Vector3)
	local b = bounds
	if b then
		b.min = b.min:Min(point)
		b.max = b.max:Max(point)
	else
		bounds = { min = point, max = point }
	end
end

local function poseAt(m: Mover, t: number): CFrame
	if m.kind == "spin" then
		-- Wrapped in double precision first: CFrame.Angles works in float32, and t is ~1.7e9.
		local angle = (m.speed * t + m.phase) % TAU
		if m.spinZ then
			-- SpinAxis "Z" (windmill blades): about the root's own look vector.
			return m.rest * CFrame.Angles(0, 0, angle)
		end
		return CFrame.new(m.rest.Position) * CFrame.Angles(0, angle, 0) * m.rest.Rotation
	end
	return m.rest + m.axis * (m.distance * math.sin(TAU * t / m.period + m.phase))
end

local function addMover(root: Instance)
	if not root:IsA("BasePart") or byPart[root] then
		return
	end
	local axis = root:GetAttribute("MoveAxis")
	local m: Mover = {
		root = root,
		rest = root.CFrame,
		parts = { root },
		offsets = { CFrame.identity },
		kind = tostring(root:GetAttribute("Mover") or "slide"),
		axis = if typeof(axis) == "Vector3" and axis.Magnitude > 0 then axis.Unit else Vector3.yAxis,
		distance = num(root:GetAttribute("MoveDistance"), 0),
		period = math.max(num(root:GetAttribute("MovePeriod"), 4), 0.2),
		speed = num(root:GetAttribute("MoveSpeed"), 0),
		phase = num(root:GetAttribute("MovePhase"), 0),
		current = root.CFrame,
		live = false,
		hazard = root:GetAttribute("Hazard") == "bump",
		length = root.Size.X,
		spinZ = root:GetAttribute("SpinAxis") == "Z",
	}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(m.parts, d)
			table.insert(m.offsets, m.rest:ToObjectSpace(d.CFrame))
		end
	end
	for _, part in m.parts do
		byPart[part] = m
		if part.CanCollide and part.CanQuery then
			table.insert(floorParts, part)
		end
	end
	rayParams.FilterDescendantsInstances = floorParts
	table.insert(movers, m)
	grow(m.rest.Position)
end

local function addPad(pad: Instance)
	if pad:IsA("BasePart") and not padRest[pad] then
		padRest[pad] = pad.CFrame
		table.insert(pads, pad)
		grow(pad.Position)
	end
end

local function addBlink(root: Instance)
	if not root:IsA("BasePart") or blinkByPart[root] then
		return
	end
	blinkByPart[root] = true
	local b: Blink = {
		root = root,
		centre = root.Position,
		on = num(root:GetAttribute("BlinkOn"), 2),
		period = math.max(num(root:GetAttribute("BlinkPeriod"), 3), 0.2),
		phase = num(root:GetAttribute("BlinkPhase"), 0),
		solid = {},
		looks = {},
		rest = {},
		glow = {},
		state = "",
	}
	local all = root:GetDescendants()
	table.insert(all, root)
	for _, d in all do
		if d:IsA("BasePart") then
			if d.CanCollide then
				table.insert(b.solid, d)
			end
			if d.Name == "BlinkGlow" then
				table.insert(b.glow, d)
			elseif d.Transparency < 1 then
				table.insert(b.looks, d)
				table.insert(b.rest, d.Transparency)
			end
		end
	end
	table.insert(blinks, b)
	grow(root.Position)
end

-- Applies a blink pad's state: "on" (solid, full colour), "dim" (solid, warning flash
-- frame) or "off" (non-collidable and faded, glow dim).
local function setBlink(b: Blink, state: string)
	if b.state == state then
		return
	end
	b.state = state
	local collide = state ~= "off"
	for _, part in b.solid do
		part.CanCollide = collide
	end
	for i, part in b.looks do
		part.Transparency = if state == "off"
			then (if part == b.root then BLINK_OFF_TOP else BLINK_OFF_PART)
			elseif state == "dim" then math.max(b.rest[i], 0.4)
			else b.rest[i]
	end
	for _, glow in b.glow do
		glow.Transparency = if state == "on" then 0 elseif state == "dim" then 0.6 else 0.85
	end
end

local function blinkState(b: Blink, t: number): string
	local into = (t + b.phase) % b.period
	if into >= b.on then
		return "off"
	end
	local left = b.on - into
	if left < BLINK_WARN and math.floor(left * BLINK_FLASH_HZ * 2) % 2 == 0 then
		return "dim"
	end
	return "on"
end

local function addArrow(root: Instance)
	if not root:IsA("BasePart") then
		return
	end
	for _, a in arrows do
		if a.root == root then
			return
		end
	end
	local arrow: Arrow = { root = root, parts = { root }, rest = { root.CFrame }, bob = num(root:GetAttribute("HintBob"), 0.8), fade = 0 }
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(arrow.parts, d)
			table.insert(arrow.rest, d.CFrame)
		end
	end
	table.insert(arrows, arrow)
end

-- A throwaway invisible anchor for world sprites.
local function anchorAt(position: Vector3, life: number): BasePart
	local part = Instance.new("Part")
	part.Name = "ModesFxAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.CFrame = CFrame.new(position)
	part.Parent = Workspace
	task.delay(life, function()
		part:Destroy()
	end)
	return part
end

local function character(): (Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

local function feetY(humanoid: Humanoid, root: BasePart): number
	return root.Position.Y - root.Size.Y / 2 - humanoid.HipHeight
end

-- Spinner bump: away from the bar, along its sweep, and a small hop. Never a fling.
local lastBump = 0
local function bump(m: Mover, humanoid: Humanoid, root: BasePart, closest: Vector3)
	local now = os.clock()
	if now - lastBump < BUMP_COOLDOWN then
		return
	end
	lastBump = now
	local away = root.Position - closest
	away = Vector3.new(away.X, 0, away.Z)
	local radial = Vector3.new(closest.X - m.rest.Position.X, 0, closest.Z - m.rest.Position.Z)
	local sweep = if radial.Magnitude > 0.01 then Vector3.yAxis:Cross(radial).Unit * math.sign(m.speed) else Vector3.zero
	local push = (if away.Magnitude > 0.01 then away.Unit else sweep) + sweep * 0.6
	push = if push.Magnitude > 0.01 then push.Unit else Vector3.xAxis
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	root.AssemblyLinearVelocity = push * 26 + Vector3.new(0, 24, 0)
	Sprites.billboard(anchorAt(closest, 2), "Puff", { position = closest, size = 2.2, life = 0.6, rise = Vector3.new(0, 1, 0) })
end

local function launch(pad: BasePart, humanoid: Humanoid, root: BasePart)
	local speed = num(pad:GetAttribute("Bounce"), 78)
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, speed, v.Z)
	local rest = padRest[pad]
	pad.CFrame = rest - Vector3.new(0, 0.35, 0)
	TweenService:Create(pad, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = rest }):Play()
	local top = rest.Position + Vector3.new(0, 0.6, 0)
	Sprites.billboard(anchorAt(top, 2), "Puff", { position = top, size = 3.5, life = 0.7, rise = Vector3.new(0, 0.6, 0) })
	Sprites.billboard(anchorAt(top, 2), "Ring", { position = top, size = 4, life = 0.5, rise = Vector3.zero, color = W.Sunny })
end

-- Run state (from the "Mode" notifies) for the still-player hint.
local running = false
local stillSince = os.clock()
local stillAt = Vector3.zero
local lastHint = 0
local currentLevel = 1

-- The current (or last) run's level folder, Map.GameModes.Parkour.Level<currentLevel>.
local function courseFolder(): Instance?
	local map = Workspace:FindFirstChild("Map")
	local modes = map and map:FindFirstChild("GameModes")
	local parkour = modes and modes:FindFirstChild("Parkour")
	return parkour and parkour:FindFirstChild("Level" .. currentLevel)
end

-- The run's finish trigger (the hint's target).
local function finishPart(): BasePart?
	local folder = courseFolder()
	if not folder then
		return nil
	end
	for _, d in folder:GetDescendants() do
		if d.Name == "ParkourFinish" and d:IsA("BasePart") and d:GetAttribute("Level") == currentLevel then
			return d
		end
	end
	return nil
end

local function showHint(root: BasePart)
	local target = finishPart()
	if not target then
		return
	end
	local from = root.Position - Vector3.new(0, 1.5, 0)
	local to = target.Position + Vector3.new(0, 1.5, 0)
	local offset = to - from
	local steps = 7
	local reach = math.min(offset.Magnitude, 18)
	if reach < 3 then
		return
	end
	local anchor = anchorAt(from, 4)
	for i = 1, steps do
		local point = from + offset.Unit * (reach * i / steps)
		Sprites.billboard(anchor, "SoftDot", {
			position = point,
			size = 0.9,
			life = 1.6,
			delay = i * 0.09,
			rise = Vector3.new(0, 0.4, 0),
			color = W.Sunny,
		})
	end
end

-- The open gate's arrow bobs near the plaza while no run is on; it eases to rest otherwise.
local function bobArrows(pos: Vector3, dt: number)
	local t = os.clock()
	local parts: { BasePart } = {}
	local frames: { CFrame } = {}
	for i = #arrows, 1, -1 do
		local a = arrows[i]
		if not a.root:IsDescendantOf(Workspace) then
			table.remove(arrows, i)
			continue
		end
		local want = not running and (a.rest[1].Position - pos).Magnitude < ARROW_NEAR
		local before = a.fade
		a.fade = math.clamp(a.fade + (if want then dt else -dt) / ARROW_FADE, 0, 1)
		if a.fade > 0 or before > 0 then
			local eased = a.fade * a.fade * (3 - 2 * a.fade)
			local lift = Vector3.new(0, a.bob * eased * math.sin(t * ARROW_SPEED), 0)
			for k, part in a.parts do
				table.insert(parts, part)
				table.insert(frames, a.rest[k] + lift)
			end
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Map scenery and themed ambience -------------------------------------------------------
--
-- Scenery tags from the world builder (docs/parkour-maps.md), animated locally with
-- os.clock() (pure decoration, so clients need not agree) and only within MAP_NEAR studs:
--   MapBubble     rises at its Rise studs/s with a soft sway, fades out near Top and back in
--                 at its rest y.
--   MapBob        a buoy root: bobs BOB_HEIGHT studs and tilts a few degrees; every
--                 descendant part moves rigidly with it (BulkMoveTo, like the movers).
--   MapGlow       a neon part whose colour slowly breathes between dimmer and brighter.
--   KillBrick     a lava bar / strip: its Neon colour pulses between Lava red and a darker
--                 red, a bit faster than a glow (same near-player lists, no embers).
-- Which items are near is refreshed MAP_REFRESH times a second into reused lists; items
-- that drift out of range go back to their rest look. Nothing runs when none are near.
--
-- Ambience: on a run's start the Level folder's Theme attribute picks a look, eased in over
-- AMBIENCE_FADE s and out again on finish / invalid / stop, on respawn, and after OUT_GRACE s
-- outside the level's bounds (the folder's extents padded LEVEL_PAD_SIDE sideways and
-- LEVEL_PAD_BELOW below, so a fall to the cloud floor and the respawn keep the look).
-- A start while a look is up cross-fades to the new one.
--   every theme  a bright sunny midday sky (sky obby): a saturated cool-blue ParkourGrade,
--            thin pale Atmosphere (low density, horizon haze, a little glare), brighter
--            Lighting and exposure, ClockTime 13 when the scene is outside 10-15, and a
--            light ParkourBloom (made lazily, enabled only during runs).
--   storm    the same but a little cooler and dimmer.
--   volcano  a touch warmer, plus ember emitters (ParkourEmbers, made lazily) on the
--            level's MapGlow parts, enabled only during the run.
--   giga     the sunny look plus soft gold sparkles around the player's root
--            (attachment ParkourSparkles).
-- ParkourGrade / ParkourBloom are our own instances: Fx.Surge's SurgeGrade / SurgeBloom are
-- separate and stack. Every Lighting / Atmosphere value is saved when a look starts and
-- written back exactly.

local Lighting = game:GetService("Lighting")

local MAP_NEAR = 250
local MAP_REFRESH = 0.25
local BOB_HEIGHT = 0.6
local BOB_TILT = math.rad(4)
local BUBBLE_SWAY = 0.5
local BUBBLE_FADE = 1.5 -- studs at each end of the climb over which a bubble fades
local GLOW_STEP = 1 / 15 -- glow colour updates per second cap
local AMBIENCE_FADE = 1
local OUT_GRACE = 3
local LEVEL_PAD_SIDE = 60 -- studs the level's bounds reach past its parts sideways
local LEVEL_PAD_BELOW = 400 -- ... and below (the cloud floor and the fall to it)
local LEVEL_PAD_ABOVE = 80
local BLOOM_INTENSITY = 0.35
local BLOOM_SIZE = 24
local BLOOM_THRESHOLD = 1.2
local SUNNY_CLOCK = 13 -- ClockTime during a run when the scene's is outside CLOCK_MIN-CLOCK_MAX
local CLOCK_MIN = 10
local CLOCK_MAX = 15
local EMBER_RATE = 4
local SPARKLE_RATE = 6
local WHITE = Color3.new(1, 1, 1)

type Bubble = {
	part: BasePart,
	rest: Vector3,
	rot: CFrame,
	alpha: number, -- built transparency
	rise: number,
	span: number,
	phase: number, -- studs into the climb at t = 0
	live: boolean,
}
type Bob = {
	part: BasePart,
	rest: CFrame,
	parts: { BasePart }?, -- root first, gathered the first time it comes near
	offsets: { CFrame },
	phase: number,
	speed: number,
	live: boolean,
}
type Glow = { part: BasePart, base: Color3, dim: Color3, bright: Color3, phase: number, speed: number, live: boolean }

local bubbles: { Bubble } = {}
local bobs: { Bob } = {}
local glows: { Glow } = {}
local kills: { Glow } = {}
local nearBubbles: { Bubble } = {}
local nearBobs: { Bob } = {}
local nearGlows: { Glow } = {}
local nearKills: { Glow } = {}
local mapTracked: { [Instance]: boolean } = {}
local moveParts: { BasePart } = {}
local moveFrames: { CFrame } = {}
local nextRefresh = 0
local nextGlow = 0

local function addBubble(part: Instance)
	if not part:IsA("BasePart") or mapTracked[part] then
		return
	end
	local rise = num(part:GetAttribute("Rise"), 2)
	local span = num(part:GetAttribute("Top"), part.Position.Y + 12) - part.Position.Y
	if rise <= 0 or span < 1 then
		return
	end
	mapTracked[part] = true
	table.insert(bubbles, {
		part = part,
		rest = part.Position,
		rot = part.CFrame.Rotation,
		alpha = part.Transparency,
		rise = rise,
		span = span,
		phase = math.random() * span,
		live = false,
	})
end

local function addBob(part: Instance)
	if not part:IsA("BasePart") or mapTracked[part] then
		return
	end
	mapTracked[part] = true
	table.insert(bobs, {
		part = part,
		rest = part.CFrame,
		parts = nil,
		offsets = {},
		phase = math.random() * TAU,
		speed = 1.1 + math.random() * 0.5,
		live = false,
	})
end

local function addGlow(part: Instance)
	if not part:IsA("BasePart") or mapTracked[part] then
		return
	end
	mapTracked[part] = true
	local base = part.Color
	local h, s, v = base:ToHSV()
	table.insert(glows, {
		part = part,
		base = base,
		dim = Color3.fromHSV(h, s, v * 0.62),
		bright = Color3.fromHSV(h, s * 0.8, math.min(1, v * 1.15)),
		phase = math.random() * TAU,
		speed = TAU / (2.6 + math.random() * 1.6),
		live = false,
	})
end

local LAVA = if typeof(W.Lava) == "Color3" then W.Lava else Color3.fromRGB(255, 60, 40)
local LAVA_DARK = Color3.fromRGB(120, 16, 10)

local function addKill(part: Instance)
	if not part:IsA("BasePart") or mapTracked[part] then
		return
	end
	mapTracked[part] = true
	table.insert(kills, {
		part = part,
		base = part.Color,
		dim = LAVA_DARK,
		bright = LAVA,
		phase = math.random() * TAU,
		speed = TAU / (0.9 + math.random() * 0.3),
		live = false,
	})
end

-- Drops a removed (or streamed-out) instance from a scenery list and its near list.
local function dropFrom(list: { any }, near: { any }, inst: Instance)
	if not mapTracked[inst] then
		return
	end
	for i = #list, 1, -1 do
		if list[i].part == inst then
			table.remove(list, i)
		end
	end
	for i = #near, 1, -1 do
		if near[i].part == inst then
			table.remove(near, i)
		end
	end
	mapTracked[inst] = nil
end

-- Back to the built look when an item leaves the player's range.
local function restBubble(b: Bubble)
	b.part.CFrame = CFrame.new(b.rest) * b.rot
	b.part.Transparency = b.alpha
end

local function restBob(b: Bob)
	local parts = b.parts
	if parts then
		for i, part in parts do
			table.insert(moveParts, part)
			table.insert(moveFrames, b.rest * b.offsets[i])
		end
	end
end

local function refreshNear(pos: Vector3)
	table.clear(nearBubbles)
	table.clear(nearBobs)
	table.clear(nearGlows)
	table.clear(nearKills)
	for _, b in bubbles do
		local near = (b.rest - pos).Magnitude <= MAP_NEAR
		if near then
			table.insert(nearBubbles, b)
		elseif b.live then
			restBubble(b)
		end
		b.live = near
	end
	for _, b in bobs do
		local near = (b.rest.Position - pos).Magnitude <= MAP_NEAR
		if near then
			if not b.parts then
				local parts = { b.part }
				b.offsets = { CFrame.identity }
				for _, d in b.part:GetDescendants() do
					if d:IsA("BasePart") then
						table.insert(parts, d)
						table.insert(b.offsets, b.rest:ToObjectSpace(d.CFrame))
					end
				end
				b.parts = parts
			end
			table.insert(nearBobs, b)
		elseif b.live then
			restBob(b)
		end
		b.live = near
	end
	for _, g in glows do
		local near = (g.part.Position - pos).Magnitude <= MAP_NEAR
		if near then
			table.insert(nearGlows, g)
		elseif g.live then
			g.part.Color = g.base
		end
		g.live = near
	end
	for _, g in kills do
		local near = (g.part.Position - pos).Magnitude <= MAP_NEAR
		if near then
			table.insert(nearKills, g)
		elseif g.live then
			g.part.Color = g.base
		end
		g.live = near
	end
end

local function stepScenery(pos: Vector3)
	local now = os.clock()
	if now >= nextRefresh then
		nextRefresh = now + MAP_REFRESH
		refreshNear(pos)
	end
	for _, b in nearBubbles do
		local travel = (now * b.rise + b.phase) % b.span
		local sway = now * 1.3 + b.phase
		b.part.Transparency = 1 - (1 - b.alpha) * math.clamp(math.min(travel, b.span - travel) / BUBBLE_FADE, 0, 1)
		table.insert(moveParts, b.part)
		table.insert(
			moveFrames,
			CFrame.new(b.rest.X + BUBBLE_SWAY * math.sin(sway), b.rest.Y + travel, b.rest.Z + BUBBLE_SWAY * math.cos(sway * 0.8)) * b.rot
		)
	end
	for _, b in nearBobs do
		local parts = b.parts
		if parts then
			local a = now * b.speed + b.phase
			local p = b.rest.Position
			local pose = CFrame.new(p.X, p.Y + BOB_HEIGHT * math.sin(a), p.Z)
				* CFrame.Angles(BOB_TILT * math.sin(a * 0.8 + 1), 0, BOB_TILT * math.cos(a * 0.7))
				* b.rest.Rotation
			for i, part in parts do
				table.insert(moveParts, part)
				table.insert(moveFrames, pose * b.offsets[i])
			end
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveFrames, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(moveParts)
		table.clear(moveFrames)
	end
	if (#nearGlows > 0 or #nearKills > 0) and now >= nextGlow then
		nextGlow = now + GLOW_STEP
		for _, g in nearGlows do
			g.part.Color = g.dim:Lerp(g.bright, 0.5 + 0.5 * math.sin(now * g.speed + g.phase))
		end
		for _, g in nearKills do
			g.part.Color = g.dim:Lerp(g.bright, 0.5 + 0.5 * math.sin(now * g.speed + g.phase))
		end
	end
end

type Look = {
	tint: Color3,
	brightness: number,
	contrast: number,
	saturation: number,
	ambient: Color3,
	ambientMix: number,
	fog: Color3,
	fogMix: number,
	fogEnd: number, -- fog never ends further than this while the look is up
	atmosphere: Color3, -- Atmosphere Color and Decay are mixed toward these
	decay: Color3,
	atmosphereMix: number,
	density: number, -- the Atmosphere's density while the look is up
	haze: number, -- its haze
	glare: number, -- its glare
	light: number, -- added to Lighting.Brightness
	exposure: number, -- added to Lighting.ExposureCompensation
	bloom: number, -- ParkourBloom intensity
}

-- The sky obby: one bright sunny midday look for every map (saturated cobalt sky, pale
-- haze at the horizon, light bloom); storm keeps a slight cool dim and volcano a slight
-- warm offset on top. Tints stay within ~0.9-1 per channel so the pastel art never muddies.
local SUNNY: Look = {
	tint = Color3.fromRGB(235, 245, 255),
	brightness = 0.02,
	contrast = 0.03,
	saturation = 0.25,
	ambient = Color3.fromRGB(235, 245, 255),
	ambientMix = 0.08,
	fog = Color3.fromRGB(215, 235, 255),
	fogMix = 0.2,
	fogEnd = 100000,
	atmosphere = Color3.fromRGB(225, 240, 255),
	decay = Color3.fromRGB(200, 225, 255),
	atmosphereMix = 0.75,
	density = 0.25,
	haze = 1.5,
	glare = 0.3,
	light = 0.6,
	exposure = 0.15,
	bloom = BLOOM_INTENSITY,
	flash = 0,
}
local LOOKS: { [string]: Look } = {
	beach = SUNNY,
	cove = SUNNY,
	bay = SUNNY,
	reef = SUNNY,
	bubble = SUNNY,
	coral = SUNNY,
	shark = SUNNY,
	giga = SUNNY,
	storm = { -- the sunny sky, a little cooler and dimmer
		tint = Color3.fromRGB(226, 238, 255),
		brightness = -0.01,
		contrast = 0.04,
		saturation = 0.15,
		ambient = Color3.fromRGB(190, 205, 235),
		ambientMix = 0.12,
		fog = Color3.fromRGB(200, 215, 238),
		fogMix = 0.25,
		fogEnd = 100000,
		atmosphere = Color3.fromRGB(210, 222, 242),
		decay = Color3.fromRGB(185, 205, 240),
		atmosphereMix = 0.75,
		density = 0.28,
		haze = 1.8,
		glare = 0.2,
		light = 0.4,
		exposure = 0.05,
		bloom = BLOOM_INTENSITY * 0.8,
	},
	volcano = { -- the sunny sky, a touch warmer
		tint = Color3.fromRGB(250, 243, 236),
		brightness = 0.02,
		contrast = 0.04,
		saturation = 0.25,
		ambient = Color3.fromRGB(255, 220, 190),
		ambientMix = 0.1,
		fog = Color3.fromRGB(240, 232, 225),
		fogMix = 0.2,
		fogEnd = 100000,
		atmosphere = Color3.fromRGB(240, 236, 235),
		decay = Color3.fromRGB(235, 220, 215),
		atmosphereMix = 0.75,
		density = 0.25,
		haze = 1.6,
		glare = 0.3,
		light = 0.6,
		exposure = 0.15,
		bloom = BLOOM_INTENSITY,
	},
}

-- Absolute Lighting / Atmosphere / grade values; what is on screen is a blend of two.
type Grade = {
	tint: Color3,
	brightness: number,
	contrast: number,
	saturation: number,
	ambient: Color3,
	outdoor: Color3,
	fogColor: Color3,
	fogEnd: number,
	atmoColor: Color3,
	decay: Color3,
	density: number,
	haze: number,
	glare: number,
	light: number, -- Lighting.Brightness
	clock: number, -- Lighting.ClockTime
	exposure: number, -- Lighting.ExposureCompensation
	bloom: number, -- ParkourBloom intensity (0 in the untouched scene)
}

-- Ambience state. ambTheme is set from a run's start until the look has faded out again.
-- The screen shows ambFrom blended toward ambTo by the eased ambWeight. ambFrom is the
-- untouched scene (`saved`, ambFromBase true) except during a cross-fade between maps,
-- when it is a snapshot of what was on screen; it returns to the scene once that ends.
local ambTheme: string? = nil
local ambLevel = 0
local ambFolder: Instance? = nil
local ambTarget = 0
local ambWeight = 0
local ambExtra = 0 -- separate ramp for the embers / sparkles (restarts on a cross-fade)
local ambOutSince: number? = nil
local ambFrom: Grade? = nil
local ambTo: Grade? = nil
local ambFromBase = true
local grade: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local atmosphere: Atmosphere? = nil
local sparkles: ParticleEmitter? = nil
local embers: { [BasePart]: ParticleEmitter } = {}
local liveEmbers: { ParticleEmitter } = {}
local saved: Grade = {
	tint = WHITE,
	brightness = 0,
	contrast = 0,
	saturation = 0,
	ambient = Color3.new(),
	outdoor = Color3.new(),
	fogColor = Color3.new(),
	fogEnd = 0,
	atmoColor = Color3.new(),
	decay = Color3.new(),
	density = 0,
	haze = 0,
	glare = 0,
	light = 0,
	clock = 0,
	exposure = 0,
	bloom = 0,
}
local levelBounds: { [Instance]: { min: Vector3, max: Vector3 } } = {}

local function levelFolder(level: number): Instance?
	local map = Workspace:FindFirstChild("Map")
	local modes = map and map:FindFirstChild("GameModes")
	local parkour = modes and modes:FindFirstChild("Parkour")
	return parkour and parkour:FindFirstChild("Level" .. level)
end

-- The level folder's extents (from its parts, cached), padded for jumps and the long fall
-- to the cloud floor far below the course.
local function boundsOf(folder: Instance): { min: Vector3, max: Vector3 }?
	local cached = levelBounds[folder]
	if cached then
		return cached
	end
	local lo, hi = nil :: Vector3?, nil :: Vector3?
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			local half = d.Size.Magnitude / 2
			local a, b = d.Position - Vector3.one * half, d.Position + Vector3.one * half
			lo = if lo then lo:Min(a) else a
			hi = if hi then hi:Max(b) else b
		end
	end
	if not lo or not hi then
		return nil
	end
	local box = {
		min = lo - Vector3.new(LEVEL_PAD_SIDE, LEVEL_PAD_BELOW, LEVEL_PAD_SIDE),
		max = hi + Vector3.new(LEVEL_PAD_SIDE, LEVEL_PAD_ABOVE, LEVEL_PAD_SIDE),
	}
	levelBounds[folder] = box
	return box
end

-- A ParticleEmitter with sprite `name`, or a plain one when the sprite is missing.
local function emitter(parent: Instance, name: string, props: { [string]: any }): ParticleEmitter
	local made = Sprites.emitter(parent, name, props)
	if made then
		return made
	end
	local plain = Instance.new("ParticleEmitter")
	for key, value in props do
		(plain :: any)[key] = value
	end
	plain.Parent = parent
	return plain
end

local function emberFor(part: BasePart): ParticleEmitter
	local cached = embers[part]
	if cached and cached.Parent then
		return cached
	end
	local orange = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(255, 90, 40))
	local e = emitter(part, "SoftDot", {
		Rate = 0,
		Color = orange,
		LightEmission = 1,
		Lifetime = NumberRange.new(1.6, 2.8),
		Speed = NumberRange.new(3, 7),
		Drag = 0.6,
		Acceleration = Vector3.new(0, 1.5, 0),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(25, 25),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(0.3, 0.4),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.7, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	e.Name = "ParkourEmbers"
	embers[part] = e
	return e
end

local function makeSparkles(root: BasePart): ParticleEmitter
	local attachment = Instance.new("Attachment")
	attachment.Name = "ParkourSparkles"
	attachment.Parent = root
	return emitter(attachment, "Sparkle", {
		Rate = 0,
		Color = ColorSequence.new(Color3.fromRGB(255, 214, 120), Color3.fromRGB(255, 240, 205)),
		LightEmission = 0.5,
		Lifetime = NumberRange.new(0.9, 1.5),
		Speed = NumberRange.new(1.5, 3),
		Drag = 1.5,
		Acceleration = Vector3.new(0, 1, 0),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, 0.55),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
end

-- The scene's values with `theme`'s look fully applied (an unknown theme: the scene).
local function gradeFor(theme: string): Grade
	local look = LOOKS[theme]
	if not look then
		return table.clone(saved)
	end
	return {
		tint = look.tint,
		brightness = look.brightness,
		contrast = look.contrast,
		saturation = look.saturation,
		ambient = saved.ambient:Lerp(look.ambient, look.ambientMix),
		outdoor = saved.outdoor:Lerp(look.ambient, look.ambientMix),
		fogColor = saved.fogColor:Lerp(look.fog, look.fogMix),
		fogEnd = math.min(saved.fogEnd, look.fogEnd),
		atmoColor = saved.atmoColor:Lerp(look.atmosphere, look.atmosphereMix),
		decay = saved.decay:Lerp(look.decay, look.atmosphereMix),
		density = look.density,
		haze = look.haze,
		glare = look.glare,
		light = saved.light + look.light,
		clock = if saved.clock < CLOCK_MIN or saved.clock > CLOCK_MAX then SUNNY_CLOCK else saved.clock,
		exposure = saved.exposure + look.exposure,
		bloom = look.bloom,
	}
end

local function blend(a: Grade, b: Grade, t: number): Grade
	return {
		tint = a.tint:Lerp(b.tint, t),
		brightness = a.brightness + (b.brightness - a.brightness) * t,
		contrast = a.contrast + (b.contrast - a.contrast) * t,
		saturation = a.saturation + (b.saturation - a.saturation) * t,
		ambient = a.ambient:Lerp(b.ambient, t),
		outdoor = a.outdoor:Lerp(b.outdoor, t),
		fogColor = a.fogColor:Lerp(b.fogColor, t),
		fogEnd = a.fogEnd + (b.fogEnd - a.fogEnd) * t,
		atmoColor = a.atmoColor:Lerp(b.atmoColor, t),
		decay = a.decay:Lerp(b.decay, t),
		density = a.density + (b.density - a.density) * t,
		haze = a.haze + (b.haze - a.haze) * t,
		glare = a.glare + (b.glare - a.glare) * t,
		light = a.light + (b.light - a.light) * t,
		clock = a.clock + (b.clock - a.clock) * t,
		exposure = a.exposure + (b.exposure - a.exposure) * t,
		bloom = a.bloom + (b.bloom - a.bloom) * t,
	}
end

local function ease(w: number): number
	return w * w * (3 - 2 * w)
end

-- What is on screen right now.
local function shownGrade(): Grade
	local from, to = ambFrom or saved, ambTo or saved
	return blend(from, to, ease(ambWeight))
end

-- Writes the current blend.
local function applyLook()
	local g = shownGrade()
	local cc = grade
	if not cc then
		local made = Instance.new("ColorCorrectionEffect")
		made.Name = "ParkourGrade"
		made.Parent = Lighting
		cc = made
		grade = made
	end
	if cc then
		cc.TintColor = g.tint
		cc.Brightness = g.brightness
		cc.Contrast = g.contrast
		cc.Saturation = g.saturation
	end
	Lighting.Ambient = g.ambient
	Lighting.OutdoorAmbient = g.outdoor
	Lighting.FogColor = g.fogColor
	Lighting.FogEnd = g.fogEnd
	Lighting.Brightness = g.light
	Lighting.ClockTime = g.clock
	Lighting.ExposureCompensation = g.exposure
	local atmo = atmosphere
	if atmo then
		atmo.Color = g.atmoColor
		atmo.Decay = g.decay
		atmo.Density = g.density
		atmo.Haze = g.haze
		atmo.Glare = g.glare
	end
	local bl = bloom
	if not bl or not bl.Parent then
		local made = Instance.new("BloomEffect")
		made.Name = "ParkourBloom"
		made.Size = BLOOM_SIZE
		made.Threshold = BLOOM_THRESHOLD
		made.Parent = Lighting
		bl = made
		bloom = made
	end
	if bl then
		bl.Intensity = g.bloom
		bl.Enabled = true
	end
	local x = ease(ambExtra)
	for _, e in liveEmbers do
		e.Rate = EMBER_RATE * x
	end
	local s = sparkles
	if s then
		s.Rate = SPARKLE_RATE * x
	end
end

-- Stops the theme's extras: embers off, sparkles left to die out then removed.
local function dropExtras()
	for _, e in liveEmbers do
		e.Rate = 0
		e.Enabled = false
	end
	table.clear(liveEmbers)
	local s = sparkles
	if s then
		local attachment = s.Parent
		s.Rate = 0
		task.delay(2, function()
			if attachment then
				attachment:Destroy()
			end
		end)
	end
	sparkles = nil
end

-- Starts `theme`'s extras for the level `folder` (their rate follows ambExtra).
local function startExtras(theme: string, folder: Instance)
	if theme == "volcano" then
		for _, g in glows do
			if g.part:IsDescendantOf(folder) then
				local e = emberFor(g.part)
				e.Enabled = true
				table.insert(liveEmbers, e)
			end
		end
	elseif theme == "giga" then
		local _, root = character()
		if root then
			sparkles = makeSparkles(root)
		end
	end
end

-- Puts every Lighting value back exactly and removes (or disables) what the look added.
local function clearAmbience()
	if ambTheme then
		Lighting.Ambient = saved.ambient
		Lighting.OutdoorAmbient = saved.outdoor
		Lighting.FogColor = saved.fogColor
		Lighting.FogEnd = saved.fogEnd
		Lighting.Brightness = saved.light
		Lighting.ClockTime = saved.clock
		Lighting.ExposureCompensation = saved.exposure
		local atmo = atmosphere
		if atmo and atmo.Parent then
			atmo.Color = saved.atmoColor
			atmo.Decay = saved.decay
			atmo.Density = saved.density
			atmo.Haze = saved.haze
			atmo.Glare = saved.glare
		end
	end
	if grade then
		grade:Destroy()
	end
	local bl = bloom
	if bl then
		bl.Intensity = 0
		bl.Enabled = false
	end
	dropExtras()
	grade, atmosphere, ambFolder, ambFrom, ambTo, ambFromBase = nil, nil, nil, nil, nil, true
	ambTheme, ambTarget, ambWeight, ambExtra, ambOutSince = nil, 0, 0, 0, nil
end

local function startAmbience(level: number)
	local folder = levelFolder(level)
	local theme = if folder then folder:GetAttribute("Theme") else nil
	if not folder or type(theme) ~= "string" or (not LOOKS[theme] and theme ~= "giga") then
		if ambTheme then
			clearAmbience()
		end
		return
	end
	if ambTheme then
		-- Already showing a look: cross-fade from what is on screen to this map's look
		-- (the scene's own values in `saved` stay as they were first captured).
		local same = ambTheme == theme and ambLevel == level and ambFolder == folder
		local target = gradeFor(theme)
		ambFrom, ambTo, ambFromBase = shownGrade(), target, false
		ambWeight = 0
		if not same then
			dropExtras()
			ambExtra = 0
			startExtras(theme, folder)
		end
		ambTheme, ambLevel, ambFolder, ambTarget, ambOutSince = theme, level, folder, 1, nil
		applyLook()
		return
	end
	ambTheme, ambLevel, ambFolder, ambTarget, ambWeight, ambExtra = theme, level, folder, 1, 0, 0
	saved.ambient = Lighting.Ambient
	saved.outdoor = Lighting.OutdoorAmbient
	saved.fogColor = Lighting.FogColor
	saved.fogEnd = Lighting.FogEnd
	saved.light = Lighting.Brightness
	saved.clock = Lighting.ClockTime
	saved.exposure = Lighting.ExposureCompensation
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
	atmosphere = atmo
	if atmo then
		saved.atmoColor = atmo.Color
		saved.decay = atmo.Decay
		saved.density = atmo.Density
		saved.haze = atmo.Haze
		saved.glare = atmo.Glare
	end
	ambFrom, ambTo, ambFromBase = saved, gradeFor(theme), true
	startExtras(theme, folder)
	applyLook()
end

-- Eases the look out (it is cleared once fully faded). Mid cross-fade, what is on screen
-- becomes the look to fade from, so the fade ends on the untouched scene.
local function endAmbience()
	if ambTheme and not ambFromBase then
		ambFrom, ambTo, ambFromBase, ambWeight = saved, shownGrade(), true, 1
	end
	ambTarget, ambOutSince = 0, nil
end

local function stepAmbience(dt: number, pos: Vector3?)
	if not ambTheme then
		return
	end
	local folder = ambFolder
	if ambTarget > 0 and folder and pos then
		local box = if folder.Parent then boundsOf(folder) else nil
		local inside = box ~= nil and pos == pos:Max(box.min):Min(box.max)
		local now = os.clock()
		if inside then
			ambOutSince = nil
		elseif not ambOutSince then
			ambOutSince = now
		elseif now - (ambOutSince :: number) > OUT_GRACE then
			endAmbience()
		end
	end
	local before, beforeExtra = ambWeight, ambExtra
	local stepW = (if ambTarget > 0 then dt else -dt) / AMBIENCE_FADE
	ambWeight = math.clamp(ambWeight + stepW, 0, 1)
	ambExtra = math.clamp(ambExtra + stepW, 0, 1)
	if ambWeight == 1 and not ambFromBase then
		-- The cross-fade is done: the screen is ambTo, so fade later from the scene.
		ambFrom, ambFromBase = saved, true
	end
	if ambWeight ~= before or ambExtra ~= beforeExtra then
		applyLook()
	end
	if ambWeight == 0 and ambTarget == 0 then
		clearAmbience()
	end
end

local moverParts: { BasePart } = {}
local moverFrames: { CFrame } = {}

local function step(dt: number)
	local humanoid, root = character()
	if not humanoid or not root then
		stepAmbience(dt, nil)
		return
	end
	stepScenery(root.Position)
	stepAmbience(dt, root.Position)
	bobArrows(root.Position, dt)
	local b = bounds
	if not b then
		return
	end
	local pos = root.Position
	local clamped = pos:Max(b.min):Min(b.max)
	if (pos - clamped).Magnitude > NEAR then
		return
	end

	-- Which mover is underfoot (before this frame's move)?
	local reach = root.Size.Y / 2 + humanoid.HipHeight + 1.6
	local hit = Workspace:Raycast(pos, Vector3.new(0, -reach, 0), rayParams)
	local under = if hit then byPart[hit.Instance :: BasePart] else nil

	local t = Workspace:GetServerTimeNow()
	for _, blinkPad in blinks do
		if (blinkPad.centre - pos).Magnitude <= NEAR then
			setBlink(blinkPad, blinkState(blinkPad, t))
		end
	end
	-- (Reused every frame: the mover lists are cleared after the BulkMoveTo.)
	local parts, frames = moverParts, moverFrames
	local carry: CFrame? = nil
	stepFrame += 1
	local thin = Budget.low() and stepFrame % 2 == 0
	for _, m in movers do
		local distance = (m.rest.Position - pos).Magnitude
		if distance <= NEAR then
			if thin and distance > LOW_FAR and m ~= under then
				continue
			end
			local pose = poseAt(m, t)
			if m == under and m.live then
				carry = pose * m.current:Inverse()
			end
			m.current = pose
			m.live = true
			for i, part in m.parts do
				table.insert(parts, part)
				table.insert(frames, pose * m.offsets[i])
			end
		else
			m.live = false
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(parts)
		table.clear(frames)
	end
	if carry then
		root.CFrame = carry * root.CFrame
		pos = root.Position
	end

	-- Spinner bars and bounce pads near the player.
	local feet = feetY(humanoid, root)
	for _, m in movers do
		if m.hazard and (m.rest.Position - pos).Magnitude < m.length / 2 + 4 then
			local cf = m.current
			local half = cf.RightVector * (m.length / 2)
			local a, segment = cf.Position - half, half * 2
			local along = math.clamp((pos - a):Dot(segment) / segment:Dot(segment), 0, 1)
			local closest = a + segment * along
			local flat = Vector3.new(pos.X - closest.X, 0, pos.Z - closest.Z).Magnitude
			if flat < 1.9 and closest.Y > feet - 0.4 and closest.Y < pos.Y + 1.2 then
				bump(m, humanoid, root, closest)
			end
		end
	end
	for _, pad in pads do
		local center = padRest[pad].Position
		local radius = pad.Size.Y / 2
		local flat = Vector3.new(pos.X - center.X, 0, pos.Z - center.Z).Magnitude
		local height = feet - (center.Y + pad.Size.X / 2)
		local touching = flat < radius + 0.4 and height > -0.6 and height < 1.4
		if touching and not padContact[pad] and root.AssemblyLinearVelocity.Y < 5 then
			launch(pad, humanoid, root)
		end
		padContact[pad] = touching
	end

	-- Still-player hint during a run.
	if running then
		local now = os.clock()
		if (pos - stillAt).Magnitude > 1 then
			stillAt = pos
			stillSince = now
		elseif now - stillSince > STILL_FOR and now - lastHint > HINT_EVERY then
			lastHint = now
			showHint(root)
		end
	end
end

-- Effects -------------------------------------------------------------------------------

-- Fell through the cloud floor: a white cloud poof (Puff particles plus a few soft white balls
-- that swell and fade, so it reads even without the sprite art) and a short camera dip.
local CLOUD_WHITE = Color3.fromRGB(250, 250, 255)
local function splash(position: Vector3)
	local anchor = anchorAt(position, 3)
	local cloud = if typeof(W.Cloud) == "Color3" then W.Cloud else CLOUD_WHITE
	local emitter = Sprites.emitter(anchor, "Puff", {
		Color = ColorSequence.new(cloud),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.5),
			NumberSequenceKeypoint.new(0.3, 4),
			NumberSequenceKeypoint.new(1, 5),
		}),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(80, 80),
		Drag = 4,
		Lifetime = NumberRange.new(0.7, 1.1),
		Acceleration = Vector3.new(0, 3, 0),
	})
	if emitter then
		emitter:Emit(Budget.count(14))
	end
	Sprites.billboard(anchor, "Ring", { position = position, size = 8, life = 0.7, rise = Vector3.zero, color = cloud })
	local balls = Budget.count(6)
	for i = 1, balls do
		local a = i / balls * TAU + math.random() * 0.6
		local ball = Instance.new("Part")
		ball.Name = "CloudPoof"
		ball.Shape = Enum.PartType.Ball
		ball.Anchored = true
		ball.CanCollide = false
		ball.CanQuery = false
		ball.CanTouch = false
		ball.CastShadow = false
		ball.Material = Enum.Material.SmoothPlastic
		ball.Color = cloud
		ball.Transparency = 0.15
		ball.Size = Vector3.one * (1.5 + math.random() * 1.5)
		ball.CFrame = CFrame.new(position + Vector3.new(math.cos(a) * 1.2, 0, math.sin(a) * 1.2))
		ball.Parent = anchor
		local reach = 3 + math.random() * 2.5
		TweenService:Create(ball, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.one * (4.5 + math.random() * 2.5),
			CFrame = CFrame.new(position + Vector3.new(math.cos(a) * reach, 1.5 + math.random() * 2, math.sin(a) * reach)),
			Transparency = 1,
		}):Play()
	end
	local humanoid = character()
	if humanoid then
		humanoid.CameraOffset = Vector3.new(0, -1.2, 0)
		TweenService:Create(humanoid, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CameraOffset = Vector3.zero })
			:Play()
	end
end

local KILL_LIFE = 0.6
local FLASH_FROM = 0.35
local FLASH_TIME = 0.35
local flashFrame: Frame? = nil

-- The full-screen red flash frame, made lazily on its own ScreenGui.
local function flash()
	local frame = flashFrame
	if not frame or not frame.Parent then
		local gui = Instance.new("ScreenGui")
		gui.Name = "ModeKillFlash"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 50
		local f = Instance.new("Frame")
		f.Name = "Flash"
		f.Size = UDim2.fromScale(1, 1)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = LAVA
		f.BackgroundTransparency = 1
		f.Active = false
		f.Parent = gui
		gui.Parent = player:WaitForChild("PlayerGui")
		flashFrame = f
		frame = f
	end
	local f = frame :: Frame
	f.BackgroundTransparency = FLASH_FROM
	TweenService:Create(f, TweenInfo.new(FLASH_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

-- Touched a kill brick: red and black shards burst out and shrink away, plus the flash.
local function kill(position: Vector3)
	local anchor = anchorAt(position, KILL_LIFE + 0.4)
	local shards = Budget.count(10)
	for i = 1, shards do
		local a = i / shards * TAU + math.random() * 0.5
		local shard = Instance.new("Part")
		shard.Name = "KillShard"
		shard.Anchored = true
		shard.CanCollide = false
		shard.CanQuery = false
		shard.CanTouch = false
		shard.CastShadow = false
		shard.Material = if i % 3 == 0 then Enum.Material.SmoothPlastic else Enum.Material.Neon
		shard.Color = if i % 3 == 0 then Color3.fromRGB(25, 20, 20) else LAVA
		shard.Size = Vector3.one * (0.8 + math.random() * 0.7)
		local spin = CFrame.Angles(math.random() * TAU, math.random() * TAU, 0)
		shard.CFrame = CFrame.new(position) * spin
		shard.Parent = anchor
		local reach = 4 + math.random() * 3
		local to = position + Vector3.new(math.cos(a) * reach, 1 + math.random() * 4, math.sin(a) * reach)
		TweenService:Create(shard, TweenInfo.new(KILL_LIFE, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(to) * spin * CFrame.Angles(math.pi, math.pi / 2, 0),
			Size = Vector3.one * 0.1,
			Transparency = 1,
		}):Play()
	end
	Sprites.billboard(anchor, "Ring", { position = position, size = 7, life = KILL_LIFE, rise = Vector3.zero, color = LAVA })
	flash()
end

local function finish(position: Vector3)
	local anchor = anchorAt(position, 3)
	local pops = Budget.count(8)
	for i = 1, pops do
		if not Sprites.room() then
			break -- decorative: the device's sprite budget is full
		end
		local a = i / pops * TAU
		Sprites.billboard(anchor, if i % 2 == 0 then "StarPop" else "Confetti", {
			position = position + Vector3.new(0, 2, 0),
			size = if i % 2 == 0 then 2 else 1,
			life = 1.4,
			delay = 0.03 * i,
			rise = Vector3.new(math.cos(a) * 5, 6, math.sin(a) * 5),
			color = if i % 2 == 0 then nil else ({ W.Sunny, W.Pink, W.Mint, W.Blue })[i // 2 + 1],
			spin = 200,
		})
	end
end

function ModesFx.init()
	for _, root in CollectionService:GetTagged("ModeMover") do
		addMover(root)
	end
	CollectionService:GetInstanceAddedSignal("ModeMover"):Connect(addMover)
	for _, pad in CollectionService:GetTagged("BouncePad") do
		addPad(pad)
	end
	CollectionService:GetInstanceAddedSignal("BouncePad"):Connect(addPad)
	for _, pad in CollectionService:GetTagged("BlinkPad") do
		addBlink(pad)
	end
	CollectionService:GetInstanceAddedSignal("BlinkPad"):Connect(addBlink)
	for _, arrow in CollectionService:GetTagged("ModeHintArrow") do
		addArrow(arrow)
	end
	CollectionService:GetInstanceAddedSignal("ModeHintArrow"):Connect(addArrow)
	for tag, add in { MapBubble = addBubble, MapBob = addBob, MapGlow = addGlow, KillBrick = addKill } :: { [string]: (Instance) -> () } do
		for _, part in CollectionService:GetTagged(tag) do
			add(part)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	end
	CollectionService:GetInstanceRemovedSignal("MapBubble"):Connect(function(inst)
		dropFrom(bubbles, nearBubbles, inst)
	end)
	CollectionService:GetInstanceRemovedSignal("MapBob"):Connect(function(inst)
		dropFrom(bobs, nearBobs, inst)
	end)
	CollectionService:GetInstanceRemovedSignal("MapGlow"):Connect(function(inst)
		dropFrom(glows, nearGlows, inst)
		embers[inst :: BasePart] = nil
	end)
	CollectionService:GetInstanceRemovedSignal("KillBrick"):Connect(function(inst)
		dropFrom(kills, nearKills, inst)
	end)
	-- A respawn ends the themed look (the old root's sparkles go with the old character).
	player.CharacterAdded:Connect(endAmbience)

	RunService.PreSimulation:Connect(step)

	Net.event("Notify").OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" or payload.kind ~= "Mode" or payload.mode ~= "parkour" then
			return
		end
		local event = payload.event
		if event == "start" then
			currentLevel = math.floor(num(payload.level, 1))
			running = true
			stillSince, lastHint = os.clock(), os.clock()
			startAmbience(currentLevel)
		elseif event == "finish" or event == "invalid" or event == "stop" then
			running = false
			endAmbience()
		end
	end)

	Net.event("Effect").OnClientEvent:Connect(function(kind, data)
		if type(data) ~= "table" or typeof(data.pos) ~= "Vector3" then
			return
		end
		if kind == "ModeSplash" then
			splash(data.pos)
		elseif kind == "ModeKill" then
			kill(data.pos)
		elseif kind == "ModeFinish" then
			finish(data.pos)
		end
	end)
end

return ModesFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="229">
            <Properties>
              <string name="Name">Mog</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.Mog: the 3D side of the MOG TEST (MogHud draws the skill-check ring), vs rivals or
	in a 1v1 duel (start / round / finish carry vs = "pvp").

	  Rival        built locally with CharacterFactory from the rival's tier look (so only
	               this client sees its own rival), standing at rivalPos facing the player.
	               Hit: a shocked flinch back; perfect adds a star pop. Miss: an angry
	               flex pose with a hop and a red ring at the player's feet. Mogged:
	               sad face, it shrinks and pops with stars, confetti and a puff, and the
	               next rival walks in after a beat with its own puff.
	  Aura         a glowing neon disc and light at the player's feet that grows with the
	               combo and pulses on every hit (gold), flickers red on a miss.
	  Camera       Scriptable duel framing over the player's shoulder looking at the
	               rival, with a slow sideways drift; on finish / stop the camera goes back
	               to Custom on the humanoid (Fx.Camera then frames it behind the player).
	  Poses        the player's own avatar strikes a new pose on every hit or perfect (a hop on
	               a perfect; Fx.PlayerPose), reels in Shock on a miss and throws a Victory
	               when a rival is mogged. In a duel the opponent's avatar is posed the same
	               way from their result, so both players see the pose-off.
	  Duel         no rival model: the opponent is the real character of
	               Players:GetPlayerByUserId(opponent.userId), followed live (rivalPos is
	               the fallback) and sized from its extents. On "round": a star pop (your
	               perfect) or a cream ring (your hit) over their head, a red ring at your
	               feet when you got hurt, the aura pulsing from your own result. On the
	               finish: stars and confetti over the loser when you won, a red puff over
	               you when you lost.
	  Sounds       Celebrate when a rival is mogged; the UI sounds belong to MogHud.

	Listens to Notify (kind "Mode", mode "mog") on its own; everything it makes is
	removed on finish and stop.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)
local CharacterFactory = require(ReplicatedStorage.Shared:WaitForChild("CharacterFactory")) :: any
local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Client = script.Parent.Parent
local Sounds = require(Client.Sounds) :: any
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)
local Animator = require(Client.Animator) :: any
local PlayerPose = require(script.Parent.PlayerPose)

local MogFx = {}

local player = Players.LocalPlayer
local W = Theme.World
local C = Theme.Colors

local CAMERA_BIND = "FxMogCamera"
local AURA_BASE = 4.5 -- aura disc diameter at combo 0 (studs)
local AURA_PER_COMBO = 0.55
local AURA_MAX_COMBO = 10

local folder: Folder? = nil
local rival: Model? = nil
local rivalHeight = 6
local rivalPivot = CFrame.identity
local aura: Part? = nil
local auraLight: PointLight? = nil
local playerPos = Vector3.zero
local rivalPos = Vector3.new(0, 0, -12)
local running = false
local duel = false -- a 1v1 duel: the opponent is a real player's character
local opponentId = 0
local cameraOn = false
local token = 0 -- bumps on every rival change so stale tweens stop
local selfPoser: PlayerPose.Poser? = nil
local foePoser: PlayerPose.Poser? = nil
local poseTokens: { [PlayerPose.Poser]: number } = {}

local function num(value: any, default: number): number
	return if type(value) == "number" and value == value then value else default
end

-- A throwaway invisible anchor for world sprites.
local function anchorAt(position: Vector3, life: number): BasePart
	local part = Instance.new("Part")
	part.Name = "MogFxAnchor"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one * 0.2
	part.CFrame = CFrame.new(position)
	part.Parent = folder or Workspace
	task.delay(life, function()
		part:Destroy()
	end)
	return part
end

local function sprite(name: string, position: Vector3, opts: { [string]: any })
	local o = table.clone(opts) :: any
	o.position = position
	Sprites.billboard(anchorAt(position, 2.2), name, o)
end

-- Runs `fn(alpha)` over `time` seconds (Quad out) on a NumberValue tween; stops early when
-- the rival changes.
local function animate(time: number, style: Enum.EasingStyle, fn: (number) -> ())
	local mine = token
	local value = Instance.new("NumberValue")
	local conn = value.Changed:Connect(function(alpha: number)
		if token == mine then
			fn(alpha)
		end
	end)
	local tween = TweenService:Create(value, TweenInfo.new(time, style, Enum.EasingDirection.Out), { Value = 1 })
	tween.Completed:Connect(function()
		conn:Disconnect()
		value:Destroy()
	end)
	tween:Play()
end

-- Duel opponent ---------------------------------------------------------------------------

-- The opponent's live root part, or nil (left, respawning or not streamed in).
local function opponentRoot(): BasePart?
	local other = Players:GetPlayerByUserId(opponentId)
	local root = other and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Follows the opponent's feet and height (rivalPos / rivalHeight); keeps the last values
-- when the character is gone.
local function trackOpponent()
	local root = opponentRoot()
	local model = root and root.Parent
	if not root or not model or not model:IsA("Model") then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local hip = if humanoid then humanoid.HipHeight else 2
	rivalPos = root.Position - Vector3.new(0, root.Size.Y / 2 + hip, 0)
	rivalHeight = math.clamp(model:GetExtentsSize().Y, 3, 14)
end

-- Poses ------------------------------------------------------------------------------------

-- Strikes `pose` on an avatar; with `settle`, eases back to HandsOnHips after that many
-- seconds unless it struck another pose first.
local function strike(poser: PlayerPose.Poser?, pose: string, hop: number?, settle: number?)
	if not poser then
		return
	end
	local mine = (poseTokens[poser] or 0) + 1
	poseTokens[poser] = mine
	poser:strike(pose, hop)
	if settle then
		task.delay(settle, function()
			if poseTokens[poser] == mine then
				poser:strike("HandsOnHips")
			end
		end)
	end
end

-- The pose for a skill-check result: a fresh flex on a hit, a hopping one on a perfect,
-- a shocked stagger on a miss.
local function strikeResult(poser: PlayerPose.Poser?, result: any)
	if result == "perfect" then
		strike(poser, PlayerPose.nextPose(), 0.6)
	elseif result == "hit" then
		strike(poser, PlayerPose.nextPose(), 0.2)
	elseif result == "miss" then
		strike(poser, "Shock", nil, 1)
	end
end

local function stopPosers()
	if selfPoser then
		selfPoser:stop()
	end
	if foePoser then
		foePoser:stop()
	end
	selfPoser, foePoser = nil, nil
	table.clear(poseTokens)
end

-- Rival -------------------------------------------------------------------------------------

local function tierLook(tier: number): any
	local tiers = Theme.Tiers
	local entry = tiers[math.clamp(math.floor(tier), 1, #tiers)]
	return entry and entry.Look
end

local function removeRival()
	token += 1
	if rival then
		rival:Destroy()
		rival = nil
	end
end

local function spawnRival(info: any)
	removeRival()
	if type(info) ~= "table" then
		return
	end
	local base = tierLook(num(info.tier, 1))
	if not base or not folder then
		return
	end
	local look = table.clone(base)
	look.exprs = { "Smug", "Shock", "Angry", "Sad", "Determined" }
	look.expr = "Smug"
	local ok, model = pcall(CharacterFactory.build, look, "MogRival")
	if not ok or not model then
		warn("[Fx.Mog] rival build failed: " .. tostring(model))
		return
	end
	local m = model :: Model
	local height = m:GetAttribute("Height")
	rivalHeight = if type(height) == "number" then height else 6
	local face = Vector3.new(playerPos.X, rivalPos.Y, playerPos.Z)
	rivalPivot = if (face - rivalPos).Magnitude > 0.1 then CFrame.lookAt(rivalPos, face) else CFrame.new(rivalPos)
	m:PivotTo(rivalPivot)
	m.Parent = folder
	rival = m
	CharacterFactory.setExpression(m, "Smug")
	-- Walk-in pop: grows from small with a puff (the Animator holds it while it scales,
	-- then re-captures its rest pose).
	Animator.hold(m)
	local full = m:GetScale()
	m:ScaleTo(full * 0.2)
	animate(0.45, Enum.EasingStyle.Back, function(a)
		m:ScaleTo(full * (0.2 + 0.8 * a))
		m:PivotTo(rivalPivot)
	end)
	task.delay(0.5, function()
		if rival == m then
			m:ScaleTo(full)
			m:PivotTo(rivalPivot)
			Animator.release(m)
		end
	end)
	sprite("Puff", rivalPos + Vector3.new(0, 1, 0), { size = 6, life = 0.7, rise = Vector3.new(0, 2, 0) })
end

local function setExpr(name: string, back: number?)
	local m = rival
	if not m then
		return
	end
	CharacterFactory.setExpression(m, name)
	if back then
		local mine = token
		task.delay(back, function()
			if token == mine and rival == m then
				CharacterFactory.setExpression(m, "Smug")
			end
		end)
	end
end

-- The rival leans back a little (away from the player) and settles.
local function flinch(distance: number)
	local m = rival
	if not m then
		return
	end
	local away = -rivalPivot.LookVector
	animate(0.5, Enum.EasingStyle.Quad, function(a)
		local push = math.sin(a * math.pi) * distance
		m:PivotTo(rivalPivot * CFrame.Angles(math.rad(8) * math.sin(a * math.pi), 0, 0) + away * push)
	end)
end

-- The rival puffs up: a quick flex pose with a little hop.
local function puffUp()
	local m = rival
	if m then
		Animator.show(m, "DoubleBiceps", 1.2, 0.4)
	end
end

local function moggedPop()
	local m = rival
	if not m then
		return
	end
	CharacterFactory.setExpression(m, "Sad")
	Animator.hold(m)
	token += 1 -- this model is leaving; the shrink below owns it now
	rival = nil
	local full = m:GetScale()
	local head = rivalPos + Vector3.new(0, rivalHeight * 0.6, 0)
	local value = Instance.new("NumberValue")
	value.Changed:Connect(function(a: number)
		if not m.Parent then
			return
		end
		m:ScaleTo(math.max(full * (1 - a), 0.02))
		m:PivotTo(rivalPivot * CFrame.Angles(0, math.rad(540 * a), 0))
	end)
	local tween = TweenService:Create(value, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Value = 0.98 })
	tween.Completed:Connect(function()
		value:Destroy()
		m:Destroy()
	end)
	task.delay(0.25, function()
		tween:Play()
	end)
	task.delay(0.7, function()
		sprite("Puff", head, { size = 7, life = 0.8, rise = Vector3.new(0, 2, 0) })
		sprite("Ring", head, { size = 8, life = 0.6, rise = Vector3.zero, color = W.Sunny })
		local pops = Budget.count(6) -- decorative: fewer on phones (Fx.Budget)
		for i = 1, pops do
			if not Sprites.room() then
				break -- decorative: the device's sprite budget is full
			end
			local angle = i / pops * math.pi * 2
			local offset = Vector3.new(math.cos(angle) * 1.5, math.sin(angle) * 1.2, 0)
			sprite(if i % 2 == 0 then "StarPop" else "Confetti", head + offset, {
				size = 2.6,
				life = 1,
				delay = i * 0.03,
				rise = Vector3.new(math.cos(angle) * 4, 3 + math.sin(angle) * 2, 0),
				spin = 90,
			})
		end
		Sounds.play("Celebrate")
	end)
end

-- Aura --------------------------------------------------------------------------------------

local function auraSize(combo: number): number
	return AURA_BASE + math.min(combo, AURA_MAX_COMBO) * AURA_PER_COMBO
end

local function buildAura()
	local part = Instance.new("Part")
	part.Name = "MogAura"
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = C.Gold
	part.Transparency = 0.6
	part.Size = Vector3.new(0.12, AURA_BASE, AURA_BASE)
	part.CFrame = CFrame.new(playerPos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
	part.Parent = folder
	local light = Instance.new("PointLight")
	light.Color = C.Gold
	light.Range = 10
	light.Brightness = 1.2
	light.Parent = part
	aura, auraLight = part, light
end

local function pulseAura(combo: number, color: Color3)
	local part, light = aura, auraLight
	if not part or not light then
		return
	end
	local d = auraSize(combo)
	part.Color = color
	part.Transparency = 0.25
	part.Size = Vector3.new(0.12, d * 1.25, d * 1.25)
	light.Color = color
	light.Brightness = 3
	TweenService:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
		Size = Vector3.new(0.12, d, d),
		Transparency = 0.6 - math.min(combo, AURA_MAX_COMBO) * 0.025,
		Color = C.Gold,
	}):Play()
	TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 1.2 + math.min(combo, AURA_MAX_COMBO) * 0.15, Color = C.Gold }):Play()
end

-- Camera ------------------------------------------------------------------------------------

local function releaseCamera()
	if not cameraOn then
		return
	end
	cameraOn = false
	RunService:UnbindFromRenderStep(CAMERA_BIND)
	local camera = Workspace.CurrentCamera
	if camera then
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		camera.CameraType = Enum.CameraType.Custom
	end
end

local function takeCamera()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	cameraOn = true
	camera.CameraType = Enum.CameraType.Scriptable
	local started = os.clock()
	local current: CFrame? = nil
	RunService:BindToRenderStep(CAMERA_BIND, Enum.RenderPriority.Camera.Value, function(dt: number)
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		if cam.CameraType ~= Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Scriptable
		end
		if duel then
			trackOpponent()
		end
		local flat = Vector3.new(rivalPos.X - playerPos.X, 0, rivalPos.Z - playerPos.Z)
		local forward = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(0, 0, -1)
		local right = forward:Cross(Vector3.yAxis)
		local t = os.clock() - started
		-- Over the right shoulder, raised for taller rivals; a slow sideways drift.
		local lift = 5.5 + math.max(rivalHeight - 6, 0) * 0.35
		local eye = playerPos - forward * 9 + right * (3.4 + math.sin(t * 0.35) * 0.8) + Vector3.new(0, lift + math.sin(t * 0.27) * 0.3, 0)
		local focus = rivalPos + Vector3.new(0, rivalHeight * 0.55, 0) - forward * 2
		local goal = CFrame.lookAt(eye, focus)
		current = if current then current:Lerp(goal, 1 - math.exp(-dt * 4)) else goal
		cam.CFrame = current :: CFrame
	end)
end

-- Run ---------------------------------------------------------------------------------------

local function clear()
	running, duel, opponentId = false, false, 0
	stopPosers()
	releaseCamera()
	removeRival()
	if folder then
		folder:Destroy()
		folder = nil
	end
	aura, auraLight = nil, nil
end

local function onStart(p: any)
	clear()
	running = true
	if typeof(p.playerPos) == "Vector3" then
		playerPos = p.playerPos
	else
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		playerPos = if root and root:IsA("BasePart") then root.Position - Vector3.new(0, 3, 0) else Vector3.zero
	end
	rivalPos = if typeof(p.rivalPos) == "Vector3" then p.rivalPos else playerPos + Vector3.new(0, 0, -14)
	local f = Instance.new("Folder")
	f.Name = "MogFx"
	f.Parent = Workspace
	folder = f
	buildAura()
	if p.vs == "pvp" then
		duel = true
		local opponent = if type(p.opponent) == "table" then p.opponent else {}
		opponentId = math.floor(num(opponent.userId, 0))
		rivalHeight = 6
		trackOpponent()
	else
		spawnRival(p.rival)
	end
	selfPoser = PlayerPose.attach(player.Character)
	takeCamera()
end

local function onResult(p: any)
	local combo = num(p.combo, 0)
	local head = rivalPos + Vector3.new(0, rivalHeight * 0.85, 0)
	strikeResult(selfPoser, p.result)
	if p.result == "perfect" then
		setExpr("Shock", 0.8)
		flinch(1.4)
		pulseAura(combo, W.Sunny)
		sprite("StarPop", head, { size = 3, life = 0.8, rise = Vector3.new(0, 2, 0), spin = 60 })
		sprite(
			"Ring",
			playerPos + Vector3.new(0, 0.3, 0),
			{ size = auraSize(combo) * 1.4, life = 0.5, rise = Vector3.zero, color = W.Sunny }
		)
	elseif p.result == "hit" then
		setExpr("Shock", 0.6)
		flinch(0.8)
		pulseAura(combo, W.Cream)
	else
		setExpr("Angry", 1)
		puffUp()
		pulseAura(0, C.Bad)
		sprite("Ring", playerPos + Vector3.new(0, 0.3, 0), { size = 6, life = 0.5, rise = Vector3.zero, color = C.Bad })
		sprite("Puff", head, { size = 3, life = 0.6, rise = Vector3.new(0, 1.5, 0), color = C.Bad })
	end
end

-- A duel round: sprites on whoever took damage, the aura from your own result.
local function onRound(p: any)
	local you = if type(p.you) == "table" then p.you else {}
	local opp = if type(p.opp) == "table" then p.opp else {}
	local combo = num(you.combo, 0)
	local head = rivalPos + Vector3.new(0, rivalHeight + 0.6, 0)
	local feet = playerPos + Vector3.new(0, 0.3, 0)
	if not foePoser then
		-- The opponent's avatar may stream in after the start.
		local root = opponentRoot()
		local model = root and root.Parent
		foePoser = if model and model:IsA("Model") then PlayerPose.attach(model) else nil
	end
	strikeResult(selfPoser, you.result)
	strikeResult(foePoser, opp.result)
	if you.result == "perfect" then
		pulseAura(combo, W.Sunny)
		sprite("StarPop", head, { size = 3, life = 0.8, rise = Vector3.new(0, 2, 0), spin = 60 })
		sprite("Ring", feet, { size = auraSize(combo) * 1.4, life = 0.5, rise = Vector3.zero, color = W.Sunny })
	elseif you.result == "hit" then
		pulseAura(combo, W.Cream)
		sprite("Ring", head, { size = 3.5, life = 0.5, rise = Vector3.new(0, 1, 0), color = W.Cream })
	else
		pulseAura(0, C.Bad)
	end
	if opp.result == "miss" then
		-- Their own miss hurts them: a small red puff over their head.
		sprite("Puff", head, { size = 3, life = 0.6, rise = Vector3.new(0, 1.5, 0), color = C.Bad })
	end
	if opp.result == "hit" or opp.result == "perfect" or you.result == "miss" then
		sprite("Ring", feet, { size = 6, life = 0.5, rise = Vector3.zero, color = C.Bad })
	end
end

-- The duel's last word, made after clear() so the sprites outlive the folder.
local function duelFinish(won: boolean, foeHead: Vector3)
	if won then
		sprite("Ring", foeHead, { size = 7, life = 0.6, rise = Vector3.zero, color = W.Sunny })
		local pops = Budget.count(6) -- decorative: fewer on phones (Fx.Budget)
		for i = 1, pops do
			if not Sprites.room() then
				break -- decorative: the device's sprite budget is full
			end
			local angle = i / pops * math.pi * 2
			local offset = Vector3.new(math.cos(angle) * 1.5, math.sin(angle) * 1.2, 0)
			sprite(if i % 2 == 0 then "StarPop" else "Confetti", foeHead + offset, {
				size = 2.6,
				life = 1,
				delay = i * 0.03,
				rise = Vector3.new(math.cos(angle) * 4, 3 + math.sin(angle) * 2, 0),
				spin = 90,
			})
		end
		Sounds.play("Celebrate")
	else
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local head = if root and root:IsA("BasePart") then root.Position + Vector3.new(0, 3, 0) else playerPos + Vector3.new(0, 6, 0)
		sprite("Puff", head, { size = 5, life = 0.8, rise = Vector3.new(0, 2, 0), color = C.Bad })
	end
end

function MogFx.onNotify(p: any)
	if type(p) ~= "table" then
		return
	end
	local event = p.event
	if event == "start" then
		onStart(p)
	elseif not running then
		return
	elseif event == "check" then
		if not duel then
			setExpr("Determined")
		end
	elseif event == "result" then
		if not duel then
			onResult(p)
		end
	elseif event == "round" then
		if duel then
			onRound(p)
		end
	elseif event == "rival" then
		strike(selfPoser, "Victory", 0.8, 1.6)
		moggedPop()
		local nextRival = p.rival
		task.delay(1.1, function()
			if running and type(nextRival) == "table" then
				spawnRival(nextRival)
			end
		end)
	elseif event == "finish" and duel then
		local foeHead = rivalPos + Vector3.new(0, rivalHeight * 0.85, 0)
		clear()
		duelFinish(p.won == true, foeHead)
	elseif event == "finish" or event == "stop" then
		clear()
	end
end

function MogFx.init()
	Net.event("Notify").OnClientEvent:Connect(function(payload)
		if type(payload) == "table" and payload.kind == "Mode" and payload.mode == "mog" then
			MogFx.onNotify(payload)
		end
	end)
	player.CharacterRemoving:Connect(function()
		if running then
			clear()
		end
	end)
end

return MogFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="230">
            <Properties>
              <string name="Name">Orbs</string>
              <string name="Source"><![CDATA[-- Client-side aura orb visuals for the local player's own plot.
--
--   * Orbs the server spawns (anchored at their landing spot, route in Path1..N) roll in
--     from their unit: a hop off its shelf, a gravity fall into the gutter with a squash
--     and a bounce, a roll along it with real spin (angle = distance / radius), faster
--     down the chute, a little air off the lip, two damped bounces across the pen floor
--     and a settle wobble. Orbs queue down the
--     chute (CHUTE_GAP apart); past MAX_ROLLS or a long queue they just pop in place.
--   * Orbs are same-size glossy candy balls painted by the unit tier that produced them
--     (Tier attribute -> Shared.OrbLook.tierColor over Theme.OrbColors): a white Blender ball
--     (props/OrbBall) tinted through MeshPart.Color plus an untinted highlight (props/OrbShine).
--   * Resting orbs sit still and cost nothing per frame.
--   * "Feed" attribute bumps (the pen is full and a new orb joined this ball): a small ball
--     rolls down the same route (FeedPath1..N) and vanishes into the ball with a soft
--     silent pop; the ball's "xN" tag ticks up.
--   * Every ball with Count >= 2 wears a floating "xN" tag (lightened ball colour, Ink
--     outline) visible within LABEL_MAX_DISTANCE.
--   * "OrbsPicked" effects: ghost orbs magnet into the character with a single soft pop.
--   * Auto Aura: the server removes the orb once it has landed and rested; it just vanishes
--     (no effect is sent for it).
--   * Dumbbells (Kind = "Dumbbell", a rare prize worth OrbLook.DUMBBELL_VALUE pieces): built
--     from parts (steel bar, tier-tinted grip and plates with glowing neon rims, end caps) and
--     lit by a soft tier light. It rolls in on its plates at orb size, pumps up to full size
--     when it hits the pen floor, then rests with a slow sway and twinkles; picking it up
--     throws a bigger burst and an "x10" pop.
--   * Look: each orb is drawn as clones of props/OrbBall (Color = tier colour) and
--     props/OrbShine (white) via AssetModels, and the server's ball is hidden locally. Without
--     the uploaded models the server's ball shows in the tier colour.
--
-- Also exports small shared VFX helpers (fly / ring / sparkle / puff) used by Machines and
-- Crates. They draw the Blender sprites (Fx.Sprites: Sparkle, Ring, Puff) when uploaded and
-- fall back to the built-in sparkle texture and a flat neon disc otherwise.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local AssetModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AssetModels"))
local OrbLook = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("OrbLook"))

local Client = script.Parent.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local Sprites = require(script.Parent.Sprites)
local Budget = require(script.Parent.Budget)

local player = Players.LocalPlayer
local C = Theme.Colors

local Orbs = {}

local FAR = CFrame.new(0, -10000, 0)
local ROLL_WINDOW = 1.5 -- seconds after Spawned during which an orb still rolls in
local SOUND_GAP = 1 / 12
local LABEL_MAX_DISTANCE = 70 -- camera distance cap of the "xN" tags (BillboardGui.MaxDistance)
local LABEL_HEIGHT = 1.15 -- studs
local WHITE = Color3.new(1, 1, 1)

local folder: Folder = nil :: any
local fxFolder: () -> Instance
Orbs.folder = nil :: Folder?

-- Helpers -------------------------------------------------------------------------------

local function bezier(a: Vector3, b: Vector3, c: Vector3, t: number): Vector3
	local u = 1 - t
	return a * (u * u) + b * (2 * u * t) + c * (t * t)
end

local function arcControl(from: Vector3, to: Vector3, lift: number): Vector3
	local mid = from:Lerp(to, 0.5)
	return Vector3.new(mid.X, math.max(from.Y, to.Y) + lift, mid.Z)
end

local function basePart(shape: Enum.PartType, name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = FAR
	return p
end

local function sphereMesh(parent: Instance): SpecialMesh
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = parent
	return mesh
end

-- Sparkle emitters (one per colour, moved to the burst point then Emit()) ----------------

local SPARKLE_SPRITE = Sprites.image("Sparkle")
local SPARKLE_WINDOW = 0.3 -- seconds: sparkle bursts inside one window share ...
local SPARKLE_BUDGET = 28 -- ... at most this many particles (a big pickup stays calm)
local sparkleWindow, sparkleSpent = 0, 0

local emitters: { [string]: { part: BasePart, emitter: ParticleEmitter } } = {}

local function emitterFor(color: Color3)
	local key = color:ToHex()
	local entry = emitters[key]
	if entry then
		return entry
	end
	local part = basePart(Enum.PartType.Block, "Sparkles")
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Transparency = 1
	part.Parent = fxFolder()
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE_SPRITE or "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.35), color)
	emitter.LightEmission = if SPARKLE_SPRITE then 0 else 1
	emitter.LightInfluence = 0
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.35, 0.7)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Acceleration = Vector3.new(0, -8, 0)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	if SPARKLE_SPRITE then
		-- The 4-point sprite fills its frame: smaller, pops up then shrinks away.
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(0.2, 0.42),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.1),
			NumberSequenceKeypoint.new(1, 0.8),
		})
		emitter.RotSpeed = NumberRange.new(-90, 90)
	else
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.5),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new(0, 0.6)
	end
	emitter.Parent = part
	entry = { part = part, emitter = emitter }
	emitters[key] = entry
	return entry
end

function Orbs.sparkle(pos: Vector3, color: Color3?, count: number?, speed: number?)
	local now = os.clock()
	if now - sparkleWindow > SPARKLE_WINDOW then
		sparkleWindow, sparkleSpent = now, 0
	end
	local n = math.min(Budget.count(count or 8), Budget.count(SPARKLE_BUDGET) - sparkleSpent)
	if n <= 0 then
		return
	end
	sparkleSpent += n
	local entry = emitterFor(color or C.Orb)
	entry.part.CFrame = CFrame.new(pos)
	local s = speed or 1
	entry.emitter.Speed = NumberRange.new(6 * s, 14 * s)
	entry.emitter:Emit(n)
end

-- Dust puffs (one shared emitter): a few soft clouds spreading low from `pos`. ------------
-- Returns false (and does nothing) when the Puff sprite is missing.

local PUFF_SPRITE = Sprites.image("Puff")
local puffEntry: { part: BasePart, emitter: ParticleEmitter }? = nil

function Orbs.puff(pos: Vector3, count: number?): boolean
	if not PUFF_SPRITE then
		return false
	end
	local entry = puffEntry
	if not entry or not entry.part.Parent then
		local part = basePart(Enum.PartType.Block, "Puffs")
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		part.Transparency = 1
		part.Parent = fxFolder()
		local emitter = Sprites.emitter(part, "Puff", {
			Color = ColorSequence.new(Color3.fromRGB(244, 238, 228)),
			Lifetime = NumberRange.new(0.45, 0.7),
			Speed = NumberRange.new(2.5, 4.5),
			SpreadAngle = Vector2.new(75, 75),
			EmissionDirection = Enum.NormalId.Top,
			Drag = 6,
			RotSpeed = NumberRange.new(-30, 30),
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.5),
				NumberSequenceKeypoint.new(1, 1.4),
			}),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			}),
		})
		if not emitter then
			part:Destroy()
			return false
		end
		entry = { part = part, emitter = emitter :: ParticleEmitter }
		puffEntry = entry
	end
	local e = entry :: { part: BasePart, emitter: ParticleEmitter }
	e.part.CFrame = CFrame.new(pos)
	e.emitter:Emit(Budget.count(math.min(count or 3, 12)))
	return true
end

-- Expanding flat rings (pooled) -----------------------------------------------------------
-- With the Ring sprite: an invisible flat part wearing the sprite as a top decal. Else a
-- flat neon disc.

local RING_SPRITE = Sprites.image("Ring")
local ringPool: { Part } = {}
local spriteRingPool: { { part: Part, decal: Decal } } = {}

local function spriteRing(pos: Vector3, color: Color3, radius: number, dur: number, startTransparency: number)
	local entry = table.remove(spriteRingPool)
	if not entry then
		local part = basePart(Enum.PartType.Block, "FxRing")
		part.Material = Enum.Material.SmoothPlastic
		part.Transparency = 1
		part.Parent = fxFolder()
		local decal = Instance.new("Decal")
		decal.Face = Enum.NormalId.Top
		decal.Texture = RING_SPRITE :: string
		decal.Parent = part
		entry = { part = part, decal = decal }
	end
	local e = entry :: { part: Part, decal: Decal }
	e.decal.Color3 = color:Lerp(WHITE, 0.15)
	e.decal.Transparency = startTransparency
	e.part.Size = Vector3.new(0.6, 0.05, 0.6)
	e.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	local d = radius * 2
	local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(e.part, info, { Size = Vector3.new(d, 0.05, d) }):Play()
	local fade = TweenService:Create(e.decal, info, { Transparency = 1 })
	fade.Completed:Once(function()
		e.part.CFrame = FAR
		table.insert(spriteRingPool, e)
	end)
	fade:Play()
end

function Orbs.ring(pos: Vector3, color: Color3?, radius: number?, duration: number?, startTransparency: number?)
	if RING_SPRITE then
		-- The sprite is a thin outline, so it starts a little more opaque than the disc did.
		spriteRing(pos, color or C.Orb, radius or 3, duration or 0.45, (startTransparency or 0.25) * 0.6)
		return
	end
	local ring = table.remove(ringPool)
	if not ring then
		ring = basePart(Enum.PartType.Cylinder, "FxRing")
		ring.Parent = fxFolder()
	end
	local r = ring :: Part
	local dur = duration or 0.45
	r.Color = color or C.Orb
	r.Transparency = startTransparency or 0.25
	r.Size = Vector3.new(0.08, 0.6, 0.6)
	r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	local d = (radius or 3) * 2
	local tween = TweenService:Create(
		r,
		TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.05, d, d), Transparency = 1 }
	)
	tween.Completed:Once(function()
		r.CFrame = FAR
		table.insert(ringPool, r)
	end)
	tween:Play()
end

-- Shared FX folder (created on demand so helpers work before init) ------------------------

fxFolder = function(): Instance
	if folder and folder.Parent then
		return folder
	end
	local existing = Workspace:FindFirstChild("ClientFx")
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		local f = Instance.new("Folder")
		f.Name = "ClientFx"
		f.Parent = Workspace
		folder = f
	end
	Orbs.folder = folder :: any
	return folder :: any
end

function Orbs.getFolder(): Instance
	return fxFolder()
end

-- World float text (pop in with overshoot, rise, fade). Capped. -------------------------------

local MAX_TEXTS = 10
local texts: { Part } = {}

export type TextOptions = {
	scale: number?, -- 1 = normal, 2 = big
	rise: number?, -- studs
	life: number?, -- seconds
	stroke: Color3?,
	-- An attribute set to the text on the "FloatText" part before it is parented, so other
	-- code can tell this text from the rest without reading its label.
	tag: string?,
}

function Orbs.text(pos: Vector3, text: string, color: Color3?, opts: TextOptions?)
	local o = opts or {}
	local k = math.clamp(o.scale or 1, 0.5, 3)
	local life = o.life or (0.9 + 0.25 * k)
	local rise = o.rise or (3 + k)
	while #texts >= MAX_TEXTS do
		local old = table.remove(texts, 1)
		if old then
			old:Destroy()
		end
	end
	local holder = basePart(Enum.PartType.Block, "FloatText")
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Transparency = 1
	holder.CFrame = CFrame.new(pos)
	if o.tag then
		holder:SetAttribute(o.tag, text)
	end
	holder.Parent = fxFolder()
	table.insert(texts, holder)

	local gui = Instance.new("BillboardGui")
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 220
	gui.Size = UDim2.new(4 * k + 2, 0, 1.4 * k + 0.4, 0)
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Theme.Fonts.Title
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or C.Primary
	label.Rotation = (math.random() - 0.5) * 10
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2 + k
	stroke.Color = o.stroke or C.Stroke or Color3.new(0, 0, 0)
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.2
	scale.Parent = label

	-- Anticipation-free snap: overshoot pop, settle, rise and fade.
	TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.3 }):Play()
	task.delay(0.16, function()
		TweenService:Create(scale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	end)
	TweenService:Create(
		holder,
		TweenInfo.new(life, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(pos + Vector3.new(0, rise, 0)) }
	):Play()
	local fadeAt = life * 0.6
	task.delay(fadeAt, function()
		local info = TweenInfo.new(life - fadeAt, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(label, info, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, info, { Transparency = 1 }):Play()
		TweenService:Create(scale, info, { Scale = 0.7 }):Play()
	end)
	task.delay(life + 0.05, function()
		local i = table.find(texts, holder)
		if i then
			table.remove(texts, i)
		end
		holder:Destroy()
	end)
end

-- 3D coins: ballistic spin, bounce, then fade or home to the wallet. Capped. ----------------

local MAX_COINS = 70
local COIN_GOLD = Color3.fromRGB(255, 205, 60)
local GRAVITY = Vector3.new(0, -70, 0)

type Coin = {
	part: Part,
	pos: Vector3,
	vel: Vector3,
	axis: Vector3,
	angle: number,
	spin: number,
	floor: number,
	born: number,
	life: number,
	homeAt: number?, -- time it starts flying to the wallet
	homeFrom: Vector3?,
	homeT: number,
}

local coinList: { Coin } = {}
local coinConn: RBXScriptConnection? = nil
local coinParts: { BasePart } = {}
local coinCFrames: { CFrame } = {}

-- World point just in front of the camera, under the top-left wallet.
local function walletPoint(): Vector3?
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local ray = camera:ViewportPointToRay(170, 70)
	return ray.Origin + ray.Direction * 7
end

local function stepCoins(dt: number)
	local now = os.clock()
	local wallet = walletPoint()
	table.clear(coinParts)
	table.clear(coinCFrames)
	local i = 1
	while i <= #coinList do
		local c = coinList[i]
		local age = now - c.born
		local done = false
		if c.homeAt and now >= c.homeAt and wallet then
			if not c.homeFrom then
				c.homeFrom = c.pos
			end
			c.homeT += dt / 0.45
			local t = math.min(c.homeT, 1)
			local e = t * t * t -- ease-in: whoosh into the wallet
			local from = c.homeFrom :: Vector3
			c.pos = from:Lerp(wallet, e) + Vector3.new(0, math.sin(t * math.pi) * 2, 0)
			c.part.Size = Vector3.new(0.16, 1, 1) * (1 - 0.6 * e)
			done = t >= 1
		else
			c.vel += GRAVITY * dt
			c.pos += c.vel * dt
			if c.pos.Y < c.floor and c.vel.Y < 0 then
				c.pos = Vector3.new(c.pos.X, c.floor, c.pos.Z)
				c.vel = Vector3.new(c.vel.X * 0.6, -c.vel.Y * 0.42, c.vel.Z * 0.6)
				c.spin *= 0.6
			end
			if not c.homeAt then
				local fade = math.clamp((age - c.life * 0.7) / (c.life * 0.3), 0, 1)
				c.part.Transparency = fade
				done = age >= c.life
			elseif age > 4 then
				done = true
			end
		end
		c.angle += c.spin * dt
		if done then
			c.part:Destroy()
			table.remove(coinList, i)
		else
			table.insert(coinParts, c.part)
			table.insert(coinCFrames, CFrame.new(c.pos) * CFrame.fromAxisAngle(c.axis, c.angle) * CFrame.Angles(0, 0, math.pi / 2))
			i += 1
		end
	end
	if #coinParts > 0 then
		Workspace:BulkMoveTo(coinParts, coinCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	if #coinList == 0 and coinConn then
		coinConn:Disconnect()
		coinConn = nil
	end
end

export type CoinOptions = {
	count: number?,
	speed: number?, -- launch speed
	spread: number?, -- horizontal start radius
	height: number?, -- start height above pos
	floor: number?, -- world Y they bounce on (default pos.Y)
	life: number?,
	toWallet: boolean?, -- fly to the wallet after bouncing
	stagger: number?, -- seconds between coins
}

-- Spawns gold coins at `pos` (a puff when speed is high, a shower when height is high).
function Orbs.coins(pos: Vector3, opts: CoinOptions?)
	local o = opts or {}
	local count = Budget.count(math.clamp(o.count or 6, 1, 40))
	local speed = o.speed or 18
	local spread = o.spread or 0.4
	local height = o.height or 0
	local life = o.life or 1.1
	local stagger = o.stagger or 0
	for i = 1, count do
		local function spawnCoin()
			if #coinList >= Budget.count(MAX_COINS) then
				local old = table.remove(coinList, 1)
				if old then
					old.part:Destroy()
				end
			end
			local part = basePart(Enum.PartType.Cylinder, "Coin")
			part.Material = Enum.Material.Metal
			part.Reflectance = 0.25
			part.Color = COIN_GOLD
			part.Size = Vector3.new(0.16, 1, 1)
			part.Parent = fxFolder()
			local angle = math.random() * math.pi * 2
			local r = math.sqrt(math.random()) * spread
			local start = pos + Vector3.new(math.cos(angle) * r, height + math.random() * height * 0.3, math.sin(angle) * r)
			local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local vel = out * speed * (0.25 + math.random() * 0.25) + Vector3.new(0, speed * (0.7 + math.random() * 0.5), 0)
			local now = os.clock()
			local coinLife = life * (0.85 + math.random() * 0.3)
			table.insert(coinList, {
				part = part,
				pos = start,
				vel = vel,
				axis = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit,
				angle = math.random() * 6,
				spin = 8 + math.random() * 10,
				floor = (o.floor or pos.Y) + 0.1,
				born = now,
				life = coinLife,
				homeAt = if o.toWallet then now + coinLife * 0.6 + i * 0.025 else nil,
				homeT = 0,
			})
			if not coinConn then
				coinConn = RunService.Heartbeat:Connect(stepCoins)
			end
		end
		if stagger > 0 and i > 1 then
			task.delay((i - 1) * stagger, spawnCoin)
		else
			spawnCoin()
		end
	end
end

-- Orb balls ---------------------------------------------------------------------------------
-- Two Blender pieces per orb (art/blender/orbs/make_orbs.py): props/OrbBall, a near-white
-- glossy sphere tinted per orb through MeshPart.Color, and props/OrbShine, its white highlight
-- and sparkle, left untinted. Both are sized from the orb's diameter. nil when not uploaded.

local ballTemplates: { [string]: MeshPart | false } = {}
local BALL_REFLECTANCE = 0.08
local REST_YAW, REST_TILT = math.rad(30), math.rad(9) -- per-orb resting turn, so highlights do not line up
-- OrbShine's bounding box and its centre offset from the ball centre, in ball diameters.
local SHINE_SIZE = Vector3.new(0.6496, 0.2044, 0.1686)
local SHINE_OFFSET = Vector3.new(0.0081, 0.3454, -0.3162)
local ORB_PALETTE: { Color3 } = (Theme :: any).OrbColors or { Color3.fromRGB(150, 76, 242) }

-- Yaw that turns a ball's front (-Z, where OrbShine sits) toward the camera, so resting
-- balls show their highlight from where the player watches the pen.
local function faceCamera(pos: Vector3): CFrame
	local camera = Workspace.CurrentCamera
	if not camera then
		return CFrame.identity
	end
	local d = camera.CFrame.Position - pos
	local flat = Vector3.new(d.X, 0, d.Z)
	if flat.Magnitude < 0.01 then
		return CFrame.identity
	end
	return CFrame.lookAt(Vector3.zero, flat.Unit)
end

local function cloneBall(name: string, color: Color3?): MeshPart?
	local template = ballTemplates[name]
	if template == nil then
		template = false
		local model = AssetModels.clone("props/" .. name)
		local mesh = if model and model:IsA("MeshPart") then model else model and model:FindFirstChildWhichIsA("MeshPart", true)
		if mesh then
			local m = mesh :: MeshPart
			m.Name = name
			m.Anchored = true
			m.CanCollide = false
			m.CanQuery = false
			m.CanTouch = false
			-- Baked vertex colours multiply with Color, so it is always set explicitly: white
			-- here (the shine stays white), the tier colour per ball. No shadows, so piled balls
			-- do not darken each other.
			m.Color = WHITE
			m.Material = Enum.Material.SmoothPlastic
			m.Reflectance = if name == "OrbBall" then BALL_REFLECTANCE else 0
			m.CastShadow = false
			m.Parent = nil
			template = m
		end
		ballTemplates[name] = template
	end
	if not template then
		return nil
	end
	local ball = template:Clone()
	if color then
		ball.Color = color
	end
	ball.CFrame = FAR
	ball.Parent = folder
	return ball
end

-- Rolling trips ---------------------------------------------------------------------------
-- An orb's route from its unit to the pen, sampled by time (frame-rate independent). The
-- server stores it as waypoints <prefix>1..N with <prefix>Kinds naming each one (feet, drop,
-- gutter, chuteTop, chuteBottom, land; see readRoute). Phases:
--   1 hop:    out of the unit, low under the shelf above, to the drop point in front of
--             the rack (never below its own shelf's deck, so it clears the shelves below)
--   2 fall:   gravity drop into the gutter, sped up so the top shelf takes <= FALL_MAX
--   3 gutter: lands with a squash and a small bounce, rolls toward the chute
--   4 chute:  slows a little for the turn, then accelerates down the slide
--   5 air:    leaves the lip on a gravity arc, curving toward its spot
--   6 floor:  lands, two damped bounces, rolls to its spot easing to a stop (and climbs
--             onto the pile when its spot is on the top layer)
-- Waypoints are orb-centre positions for an orb of the server's size; smaller balls `sink`
-- by the radius difference so they still touch the surfaces.

local GRAVITY_Y = 60
local HOP_APEX = 0.3 -- kept low: the shelf above is just overhead
local HOP_MIN, HOP_MAX = 0.3, 0.45
local FALL_MAX = 0.7
local GUTTER_HOP_MIN, GUTTER_HOP_MAX = 0.08, 0.55 -- bounce height on landing in the gutter
local GUTTER_V0, GUTTER_ACCEL, GUTTER_VMAX = 6, 14, 18
local CHUTE_V0, CHUTE_ACCEL, CHUTE_VMAX = 10, 18, 18
local BOUNCE_1, BOUNCE_1_HEIGHT = 0.26, 0.45
local BOUNCE_2, BOUNCE_2_HEIGHT = 0.16, 0.13
local FLOOR_MIN, FLOOR_MAX = 0.5, 1.2
local CHUTE_GAP = 0.3 -- seconds between orbs entering the chute
local MAX_QUEUE = 2.5 -- an orb that would wait longer than this for the chute pops in instead
local MAX_ROLLS = 14 -- concurrent rolling orbs and feed balls; the rest pop in place
local APPEAR_TIME = 0.22
local DOWN = Vector3.new(0, 0, -1)
local PHASE_GUTTER, PHASE_FLOOR, PHASE_DONE = 3, 6, 7

-- Named waypoints of a rack -> pen route. `drop` equals `gutter` on routes without a drop.
export type Route = {
	feet: Vector3,
	drop: Vector3,
	gutter: Vector3,
	chuteTop: Vector3,
	chuteBottom: Vector3,
	land: Vector3,
}

type Roll = {
	t0: number, -- launch time (os.clock)
	dHop: number,
	dFall: number,
	dGutter: number,
	dChute: number,
	dAir: number,
	dFloor: number,
	total: number,
	p0: Vector3, -- start (the unit's chest)
	drop: Vector3,
	gutter: Vector3,
	top: Vector3,
	bottom: Vector3,
	l1: Vector3, -- first floor contact
	land: Vector3,
	hopDrop: number, -- p0.Y - drop.Y
	fallV0: number, -- downward speed leaving the hop
	fallG: number, -- fall gravity (raised for long falls)
	fallLen: number,
	gutterHop: number, -- bounce height and time on landing in the gutter
	dGutterHop: number,
	gutterImpact: number, -- 0..1, scales the landing squash
	gutterLen: number,
	chuteLen: number,
	chuteV0: number,
	airVd: number, -- downward speed leaving the lip
	airFix: number,
	airCtrl: Vector3, -- horizontal Bezier control point of the air arc
	floorY: number, -- centre height of a ball resting on the pen floor
	impact: number, -- 0.4..1, scales the bounces
	sink: number,
	radius: number,
	phase: number, -- 0 waiting, 1 hop, 2 fall, 3 gutter, 4 chute, 5 air, 6 floor, 7 done
	last: Vector3?,
	rot: CFrame,
}

local activeRolls = 0
local chuteFreeAt = 0

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function smooth(x: number): number
	local t = math.clamp(x, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Distance covered after `t` seconds starting at v0, accelerating at `a` up to `vmax`.
local function accelDist(t: number, v0: number, a: number, vmax: number): number
	local t1 = (vmax - v0) / a
	if t <= t1 then
		return v0 * t + 0.5 * a * t * t
	end
	return v0 * t1 + 0.5 * a * t1 * t1 + vmax * (t - t1)
end

-- (seconds to cover `len`, speed at the end) for the same motion.
local function accelTime(len: number, v0: number, a: number, vmax: number): (number, number)
	local s1 = (vmax * vmax - v0 * v0) / (2 * a)
	if len <= s1 then
		local v = math.sqrt(v0 * v0 + 2 * a * len)
		return (v - v0) / a, v
	end
	return (vmax - v0) / a + (len - s1) / vmax, vmax
end

local ROUTE_KINDS = { "feet", "drop", "gutter", "chuteTop", "chuteBottom", "land" }

-- Reads a route stored as <prefix>1..<prefix>N + <prefix>Count (see Tycoon.setRoute). Each
-- waypoint's role comes from <prefix>Kinds ("feet,drop,gutter,..."); without it (or if it
-- does not match) the roles are inferred: 1 = feet, the last four = gutter, chute top,
-- chute bottom, landing, and the point before the gutter (if any) = drop.
local function readRoute(inst: Instance, prefix: string): Route?
	local count = inst:GetAttribute(prefix .. "Count")
	if type(count) ~= "number" or count < 5 then
		return nil
	end
	local points: { Vector3 } = {}
	for i = 1, count do
		local point = inst:GetAttribute(prefix .. i)
		if typeof(point) ~= "Vector3" then
			return nil
		end
		points[i] = point
	end
	local at: { [string]: number } = {}
	local kinds = inst:GetAttribute(prefix .. "Kinds")
	if type(kinds) == "string" then
		local i = 0
		for name in string.gmatch(kinds, "[^,%s]+") do
			i += 1
			at[name] = i
		end
		if i ~= count then
			at = {}
		end
	end
	for _, name in ROUTE_KINDS do
		if name ~= "drop" and not at[name] then
			at = { feet = 1, gutter = count - 3, chuteTop = count - 2, chuteBottom = count - 1, land = count }
			if count >= 6 then
				at.drop = count - 4
			end
			break
		end
	end
	local gutter = points[at.gutter]
	return {
		feet = points[at.feet],
		drop = if at.drop then points[at.drop] else gutter,
		gutter = gutter,
		chuteTop = points[at.chuteTop],
		chuteBottom = points[at.chuteBottom],
		land = points[at.land],
	}
end

local function newRoll(route: Route, origin: Vector3?, floorY: number?, radius: number, sink: number): Roll
	local drop, gutter, top, bottom, land = route.drop, route.gutter, route.chuteTop, route.chuteBottom, route.land
	local p0 = origin or (route.feet + Vector3.new(0, 1.5, 0))

	-- Hop: front-loaded horizontally (out from under the shelf above first), easing down to
	-- the drop point's height with a small lift.
	local hopLen = flat(drop - p0).Magnitude
	local dHop = math.clamp(0.28 + hopLen * 0.02, HOP_MIN, HOP_MAX)
	local hopDrop = p0.Y - drop.Y
	local fallV0 = math.max((2 * hopDrop + 4 * HOP_APEX) / dHop, 0)

	-- Fall: real gravity, raised just enough that long falls end within FALL_MAX.
	local fallLen = math.max(drop.Y - gutter.Y, 0)
	local fallG = GRAVITY_Y
	local dFall = 0
	if fallLen > 1e-3 then
		dFall = (-fallV0 + math.sqrt(fallV0 * fallV0 + 2 * GRAVITY_Y * fallLen)) / GRAVITY_Y
		if dFall > FALL_MAX then
			dFall = FALL_MAX
			fallG = 2 * (fallLen - fallV0 * dFall) / (dFall * dFall)
		end
	end
	local vImpact = fallV0 + fallG * dFall
	local gutterHop = math.clamp(vImpact * 0.006, GUTTER_HOP_MIN, GUTTER_HOP_MAX)

	local gutterLen = (top - gutter).Magnitude
	local dGutter, vGutter = accelTime(gutterLen, GUTTER_V0, GUTTER_ACCEL, GUTTER_VMAX)
	local dGutterHop = 2 * math.sqrt(2 * gutterHop / GRAVITY_Y)
	dGutter = math.max(dGutter, dGutterHop)
	local chuteV0 = math.clamp(vGutter * 0.6, 3, CHUTE_V0)
	local chuteLen = (bottom - top).Magnitude
	local dChute, vChute = accelTime(chuteLen, chuteV0, CHUTE_ACCEL, CHUTE_VMAX)

	local fy = math.min(floorY or land.Y, land.Y)
	local chuteDir = if chuteLen > 1e-3 then (bottom - top) / chuteLen else DOWN
	local chuteFlat = flat(chuteDir)
	chuteFlat = if chuteFlat.Magnitude > 1e-3 then chuteFlat.Unit else DOWN
	local airVd = math.max(0, -chuteDir.Y * vChute)
	local airDrop = math.max(bottom.Y - fy, 0)
	local dAir = math.max((-airVd + math.sqrt(airVd * airVd + 2 * GRAVITY_Y * airDrop)) / GRAVITY_Y, 0.1)
	local airFix = fy - (bottom.Y - airVd * dAir - 0.5 * GRAVITY_Y * dAir * dAir)
	local toSpot = flat(land - bottom)
	local dist = toSpot.Magnitude
	local dirSpot = if dist > 1e-3 then toSpot / dist else chuteFlat
	local airLen = math.min(flat(chuteDir).Magnitude * vChute * dAir, dist * 0.7)
	local l1 = Vector3.new(bottom.X, fy, bottom.Z) + dirSpot * airLen

	local floorLen = dist - airLen
	local vLand = math.max(airLen / dAir, 5)
	local dFloor = math.clamp(2 * floorLen / vLand, FLOOR_MIN, FLOOR_MAX)

	return {
		t0 = 0,
		dHop = dHop,
		dFall = dFall,
		dGutter = dGutter,
		dChute = dChute,
		dAir = dAir,
		dFloor = dFloor,
		total = dHop + dFall + dGutter + dChute + dAir + dFloor,
		p0 = p0,
		drop = drop,
		gutter = gutter,
		top = top,
		bottom = bottom,
		l1 = l1,
		land = land,
		hopDrop = hopDrop,
		fallV0 = fallV0,
		fallG = fallG,
		fallLen = fallLen,
		gutterHop = gutterHop,
		dGutterHop = dGutterHop,
		gutterImpact = math.clamp(vImpact / 60, 0.3, 1),
		gutterLen = gutterLen,
		chuteLen = chuteLen,
		chuteV0 = chuteV0,
		airVd = airVd,
		airFix = airFix,
		airCtrl = flat(bottom) + chuteFlat * airLen * 0.5,
		floorY = fy,
		impact = math.clamp((airVd + GRAVITY_Y * dAir) / 10, 0.4, 1),
		sink = sink,
		radius = math.max(radius, 0.1),
		phase = 0,
		last = nil,
		rot = CFrame.Angles(0, math.random() * math.pi * 2, 0),
	}
end

-- Position on the route `t` seconds after launch, and the phase it is in.
local function sampleRoll(r: Roll, t: number): (Vector3, number)
	if t < 0 then
		return r.p0, 0
	end
	if t < r.dHop then
		local u = t / r.dHop
		local e = 1 - (1 - u) * (1 - u)
		local h = r.p0:Lerp(r.drop, e)
		local y = r.p0.Y - r.hopDrop * u * u + HOP_APEX * 4 * u * (1 - u)
		return Vector3.new(h.X, y - r.sink * u, h.Z), 1
	end
	t -= r.dHop
	local sinkDown = Vector3.new(0, r.sink, 0)
	if t < r.dFall then
		local fallen = math.min(r.fallV0 * t + 0.5 * r.fallG * t * t, r.fallLen)
		local h = r.drop:Lerp(r.gutter, fallen / r.fallLen)
		return Vector3.new(h.X, r.drop.Y - fallen, h.Z) - sinkDown, 2
	end
	t -= r.dFall
	if t < r.dGutter then
		local s = accelDist(t, GUTTER_V0, GUTTER_ACCEL, GUTTER_VMAX)
		local pos = r.gutter:Lerp(r.top, if r.gutterLen > 1e-3 then math.min(s / r.gutterLen, 1) else 1) - sinkDown
		if t < r.dGutterHop then
			local b = t / r.dGutterHop
			pos += Vector3.new(0, 4 * b * (1 - b) * r.gutterHop, 0)
		end
		return pos, 3
	end
	t -= r.dGutter
	if t < r.dChute then
		local s = accelDist(t, r.chuteV0, CHUTE_ACCEL, CHUTE_VMAX)
		return r.top:Lerp(r.bottom, if r.chuteLen > 1e-3 then math.min(s / r.chuteLen, 1) else 1) - sinkDown, 4
	end
	t -= r.dChute
	if t < r.dAir then
		local u = t / r.dAir
		local h = bezier(flat(r.bottom), r.airCtrl, flat(r.l1), u)
		local y = r.bottom.Y - r.airVd * t - 0.5 * GRAVITY_Y * t * t + r.airFix * u
		return Vector3.new(h.X, y - r.sink, h.Z), 5
	end
	t -= r.dAir
	if t < r.dFloor then
		local u = t / r.dFloor
		local e = 1 - (1 - u) * (1 - u) -- constant deceleration to a stop
		local h = flat(r.l1):Lerp(flat(r.land), e)
		local y = r.floorY + (r.land.Y - r.floorY) * smooth((u - 0.55) / 0.45)
		if t < BOUNCE_1 then
			local b = t / BOUNCE_1
			y += 4 * b * (1 - b) * BOUNCE_1_HEIGHT * r.impact
		elseif t < BOUNCE_1 + BOUNCE_2 then
			local b = (t - BOUNCE_1) / BOUNCE_2
			y += 4 * b * (1 - b) * BOUNCE_2_HEIGHT * r.impact
		end
		return Vector3.new(h.X, y - r.sink * (1 - smooth((u - 0.75) / 0.25)), h.Z), 6
	end
	return r.land, PHASE_DONE
end
-- End of the route maths (tests load the section above in Lune).

-- Crates read their routes the same way.
Orbs.readRoute = readRoute

-- Queues a roll behind the orbs already heading for the chute. False = the wait would be too
-- long (or too many rolls are running): show the orb without the trip.
local function scheduleRoll(r: Roll, now: number): boolean
	if activeRolls >= Budget.count(MAX_ROLLS) then
		return false
	end
	local reach = r.dHop + r.dFall + r.dGutter
	local launch = math.max(now, chuteFreeAt - reach)
	if launch - now > MAX_QUEUE then
		return false
	end
	r.t0 = launch
	chuteFreeAt = launch + reach + CHUTE_GAP
	activeRolls += 1
	return true
end

local function finishRoll()
	activeRolls = math.max(0, activeRolls - 1)
end

-- Rolling spin from the distance moved since last frame (angle = distance / radius).
local function spinRoll(r: Roll, pos: Vector3)
	local last = r.last
	r.last = pos
	if not last then
		return
	end
	local axis = Vector3.yAxis:Cross(pos - last)
	local m = axis.Magnitude
	if m > 1e-4 then
		r.rot = (CFrame.fromAxisAngle(axis / m, m / r.radius) * r.rot):Orthonormalize()
	end
end

local function backOut(t: number): number
	local c = 1.70158
	local u = t - 1
	return 1 + (c + 1) * u * u * u + c * u * u
end

-- Flying ghost orbs (pooled; one Heartbeat drives every flight) ---------------------------

type Ghost = {
	part: Part,
	mesh: SpecialMesh,
	trail: Trail,
	balls: { [string]: MeshPart }, -- Blender ball per colour step (lazily made)
	active: string?, -- step currently shown instead of the plain ball
}
type Flight = {
	ghost: Ghost,
	from: Vector3,
	ctrl: Vector3,
	to: Vector3,
	target: BasePart?,
	targetOffset: Vector3,
	t0: number,
	dur: number,
	accel: boolean,
	s0: number,
	s1: number,
	trail: boolean,
	variant: string?,
	started: boolean,
	roll: Roll?, -- follow a rolling route instead of the arc (t0/dur match the roll)
	onDone: (() -> ())?,
}

local ghostPool: { Ghost } = {}
local flights: { Flight } = {}

local function getGhost(): Ghost
	local g = table.remove(ghostPool)
	if g then
		return g
	end
	local part = basePart(Enum.PartType.Ball, "FxOrb")
	part.Size = Vector3.new(1, 1, 1)
	part.Transparency = 1
	local mesh = sphereMesh(part)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.18, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.18, 0)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.22
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Enabled = false
	trail.Parent = part
	part.Parent = folder
	return { part = part, mesh = mesh, trail = trail, balls = {}, active = nil }
end

local function releaseGhost(g: Ghost)
	g.trail.Enabled = false
	g.part.Transparency = 1
	g.part.CFrame = FAR
	if g.active then
		g.balls[g.active].CFrame = FAR
		g.active = nil
	end
	table.insert(ghostPool, g)
end

export type FlyOptions = {
	from: Vector3,
	to: Vector3?,
	target: BasePart?, -- follow a moving part (e.g. HumanoidRootPart)
	targetOffset: Vector3?,
	color: Color3?,
	size: number?,
	endSize: number?,
	duration: number?,
	delay: number?,
	arc: number?, -- studs the curve rises above the higher end
	accel: boolean?, -- ease-in (magnet) instead of smooth in-out
	trail: boolean?,
	variant: string?, -- any value: draw the tinted Blender ball (props/OrbBall) if uploaded
	onDone: (() -> ())?,
}

function Orbs.fly(opts: FlyOptions): Flight
	local g = getGhost()
	local color = opts.color or C.Orb
	g.part.Color = color
	g.trail.Color = ColorSequence.new(color)
	local variant = if opts.variant then "Ball" else nil
	if variant and not g.balls[variant] then
		local ball = cloneBall("OrbBall")
		if ball then
			g.balls[variant] = ball
		end
	end
	if variant and g.balls[variant] then
		g.balls[variant].Color = color
	end
	local to = opts.to or (if opts.target then opts.target.Position else opts.from)
	local flight: Flight = {
		ghost = g,
		from = opts.from,
		ctrl = arcControl(opts.from, to, opts.arc or 3),
		to = to,
		target = opts.target,
		targetOffset = opts.targetOffset or Vector3.zero,
		t0 = os.clock() + (opts.delay or 0),
		dur = opts.duration or 0.6,
		accel = opts.accel == true,
		s0 = opts.size or 0.8,
		s1 = opts.endSize or opts.size or 0.8,
		trail = opts.trail == true,
		variant = if variant and g.balls[variant] then variant else nil,
		started = false,
		roll = nil,
		onDone = opts.onDone,
	}
	table.insert(flights, flight)
	return flight
end

-- Real orbs -------------------------------------------------------------------------------

type OrbFx = {
	part: BasePart,
	mesh: SpecialMesh,
	shell: Part,
	shellMesh: SpecialMesh,
	home: CFrame,
	phase: number,
	scale: number,
	pulse: number, -- extra scale that decays (feed / landing)
	squash: number, -- squash timer (seconds since impact, < 0 = none)
	squashAmp: number,
	roll: Roll?, -- rolling in from its unit (nil = resting)
	waiting: boolean, -- queued for the chute, not shown yet
	rot: CFrame, -- orientation left by the roll; eases back to restRot at rest
	restRot: CFrame, -- small random yaw and tilt of this orb at rest
	rest: number, -- 0..1, fades the idle bob in after settling
	appear: number, -- 0..1 pop-in for orbs shown without a roll
	big: boolean,
	color: Color3,
	flash: number, -- soft flash amount that decays (merge)
	count: number, -- merged count currently shown (catches up as feed balls land)
	feedSeen: number,
	label: BillboardGui?,
	labelPlate: Frame?,
	labelText: TextLabel?,
	labelScale: UIScale?,
	labelOn: boolean, -- picked to show (fading in or shown)
	labelToken: number,
	ball: MeshPart?, -- tinted Blender ball clone (nil = the server's plain ball)
	shine: MeshPart?, -- its untinted highlight
	labelLift: number, -- per-orb tag height jitter, so neighbouring tags do not line up
	still: boolean, -- resting and placed: skipped by the frame loop until something wakes it
	conns: { RBXScriptConnection },
	dumbbell: boolean, -- Kind = "Dumbbell": drawn from `pieces` instead of the ball
	pieces: { DumbbellPiece }?,
	light: PointLight?,
	grow: number, -- dumbbell pump-up on landing: < 0 = travel size, 0..1 growing, >= 1 full
	barAxis: Vector3, -- rolling dumbbell: world direction of its bar
	spin: number, -- rolling dumbbell: angle turned around its bar
	lastPos: Vector3?,
	twinkle: number, -- seconds until the resting dumbbell's next sparkle
}

local orbs: { [BasePart]: OrbFx } = {}
-- Recently removed orbs, so pickup ghosts can keep the colour of the orb they replace.
local recentGone: { { pos: Vector3, color: Color3, big: boolean, dumbbell: boolean, at: number } } = {}
local orbFolder: Instance? = nil
local folderConns: { RBXScriptConnection } = {}
local INK = (Theme :: any).World and (Theme :: any).World.Ink or Color3.fromRGB(58, 48, 96)

local function attrCount(part: BasePart): number
	local n = part:GetAttribute("Count")
	return if type(n) == "number" then math.max(1, math.floor(n)) else 1
end

-- Small bold "x3" count tag just above a ball with Count >= 2 (client-only, lives on the
-- invisible shell): text in the lightened ball colour with a dark Ink outline.
local function ensureLabel(fx: OrbFx): BillboardGui
	local existing = fx.label
	if existing then
		return existing
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CountTag"
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = LABEL_MAX_DISTANCE
	gui.Size = UDim2.fromScale(LABEL_HEIGHT * 2.2, LABEL_HEIGHT)
	gui.Enabled = false
	gui.Adornee = fx.shell
	gui.Parent = fx.shell
	local plate = Instance.new("Frame")
	plate.AnchorPoint = Vector2.new(0.5, 0.5)
	plate.Position = UDim2.fromScale(0.5, 0.5)
	plate.Size = UDim2.fromScale(1, 1)
	plate.BackgroundTransparency = 1
	plate.BorderSizePixel = 0
	plate.Parent = gui
	local uiScale = Instance.new("UIScale")
	uiScale.Parent = plate
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.AnchorPoint = Vector2.new(0.5, 0.5)
	text.Position = UDim2.fromScale(0.5, 0.5)
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Theme.Fonts.Title
	text.TextScaled = true
	local r, g, b = OrbLook.tagRGB(fx.color.R * 255, fx.color.G * 255, fx.color.B * 255)
	text.TextColor3 = Color3.fromRGB(r, g, b)
	text.TextTransparency = 1
	text.Parent = plate
	local stroke = Instance.new("UIStroke")
	stroke.Color = INK
	stroke.Thickness = 2
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = text
	fx.label, fx.labelPlate, fx.labelText, fx.labelScale = gui, plate, text, uiScale
	return gui
end

local function setLabelText(fx: OrbFx)
	local gui = fx.label
	if gui then
		gui.StudsOffset = Vector3.new(0, fx.part.Size.Y * 0.5 + LABEL_HEIGHT * 0.45 + fx.labelLift, 0);
		(fx.labelText :: TextLabel).Text = "x" .. tostring(fx.count)
	end
end

-- Fades the count tag in (small grow) or out (then disables it).
local function fadeLabel(fx: OrbFx, on: boolean)
	if fx.labelOn == on then
		return
	end
	fx.labelOn = on
	fx.labelToken += 1
	if not on and not fx.label then
		return
	end
	local gui = ensureLabel(fx)
	local text, uiScale = fx.labelText :: TextLabel, fx.labelScale :: UIScale
	if on then
		setLabelText(fx)
		gui.Enabled = true
		uiScale.Scale = 0.7
		local info = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(text, info, { TextTransparency = 0 }):Play()
		TweenService:Create(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		return
	end
	local token = fx.labelToken
	local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(uiScale, info, { Scale = 0.7 }):Play()
	local fade = TweenService:Create(text, info, { TextTransparency = 1 })
	fade.Completed:Once(function()
		if fx.labelToken == token then
			gui.Enabled = false
		end
	end)
	fade:Play()
end

-- New count on a ball: show / retext its tag (with a tiny pop when it was already showing).
local function updateLabel(fx: OrbFx, punch: boolean)
	if fx.count < 2 or fx.waiting then
		fadeLabel(fx, false)
		return
	end
	setLabelText(fx)
	fadeLabel(fx, true)
	local uiScale = fx.labelScale
	if punch and fx.labelOn and uiScale then
		uiScale.Scale = 1.4
		TweenService:Create(uiScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function refreshVisibility(fx: OrbFx)
	-- The server ball only shows without the Blender ball, once launched. A dumbbell's server
	-- part is a plain stand-in for other players: always hidden here.
	fx.part.LocalTransparencyModifier = if fx.waiting or fx.ball or fx.dumbbell then 1 else 0
	if fx.pieces then
		for _, piece in fx.pieces do
			piece.part.LocalTransparencyModifier = if fx.waiting then 1 else 0
		end
	end
	if fx.ball then
		fx.ball.LocalTransparencyModifier = if fx.waiting then 1 else 0
	end
	if fx.shine then
		fx.shine.LocalTransparencyModifier = if fx.waiting then 1 else 0
	end
	if fx.waiting then
		fadeLabel(fx, false)
	end
end

local function clearBall(fx: OrbFx)
	if fx.ball then
		fx.ball:Destroy()
	end
	if fx.shine then
		fx.shine:Destroy()
	end
	fx.ball, fx.shine = nil, nil
	if fx.pieces then
		for _, piece in fx.pieces do
			piece.part:Destroy()
		end
	end
	fx.pieces, fx.light = nil, nil
end

-- Dumbbells ----------------------------------------------------------------------------------
-- Cylinders along the bar (local X). x = centre along the bar, len = length, dia = diameter, all
-- in dumbbell lengths; the big rims' radius is OrbLook.DUMBBELL_PLATE (its resting height).

type DumbbellPiece = { part: Part, x: number, len: number, dia: number }

local DUMBBELL_TRAVEL = 0.5 -- size while rolling in (fits the gutter and chute like an orb)
local DUMBBELL_GROW = 0.45 -- seconds to pump up to full size after hitting the pen floor
local STEEL = Color3.fromRGB(228, 234, 242)
-- { x, len, dia, paint }; pieces with x ~= 0 are mirrored to both ends.
local DUMBBELL_SHAPE: { { any } } = {
	{ 0, 0.96, 0.085, "steel" }, -- bar
	{ 0, 0.3, 0.105, "grip" },
	{ 0.2, 0.05, 0.16, "steel" }, -- collar
	{ 0.285, 0.12, 0.6, "plate" }, -- big plate
	{ 0.285, 0.07, 0.62, "rim" },
	{ 0.39, 0.085, 0.46, "plate" }, -- small plate
	{ 0.39, 0.05, 0.475, "rim" },
	{ 0.465, 0.04, 0.12, "steel" }, -- end cap
}

local function paintPiece(part: Part, paint: string, color: Color3)
	if paint == "steel" then
		part.Color, part.Material, part.Reflectance = STEEL, Enum.Material.SmoothPlastic, 0.3
	elseif paint == "grip" then
		part.Color, part.Material, part.Reflectance = color:Lerp(INK, 0.45), Enum.Material.SmoothPlastic, 0
	elseif paint == "plate" then
		part.Color, part.Material, part.Reflectance = color, Enum.Material.SmoothPlastic, 0.12
	else
		part.Color, part.Material, part.Reflectance = color:Lerp(WHITE, 0.45), Enum.Material.Neon, 0
	end
end

local function buildDumbbell(fx: OrbFx)
	local pieces: { DumbbellPiece } = {}
	for _, spec in DUMBBELL_SHAPE do
		local x, len, dia, paint = spec[1] :: number, spec[2] :: number, spec[3] :: number, spec[4] :: string
		local sides: { number } = if x == 0 then { 1 } else { -1, 1 }
		for _, side in sides do
			local part = basePart(Enum.PartType.Cylinder, "Dumbbell")
			paintPiece(part, paint, fx.color)
			part.Parent = folder
			table.insert(pieces, { part = part, x = x * side, len = len, dia = dia })
		end
	end
	local light = Instance.new("PointLight")
	light.Color = fx.color:Lerp(WHITE, 0.25)
	light.Range = 7
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = pieces[1].part
	fx.pieces, fx.light = pieces, light
end

-- Size multiplier of a dumbbell: travel size, then a springy pump-up to full size.
local function dumbbellScale(fx: OrbFx): number
	if fx.grow < 0 then
		return DUMBBELL_TRAVEL
	end
	return DUMBBELL_TRAVEL + (1 - DUMBBELL_TRAVEL) * backOut(math.min(fx.grow, 1))
end

-- Radius of a dumbbell's big plates at size multiplier `k`, and an orb's radius (its route's).
local function dumbbellRadii(fx: OrbFx, k: number): (number, number)
	local length = fx.part.Size.X
	return OrbLook.DUMBBELL_PLATE * length * k, length / OrbLook.DUMBBELL_SCALE / 2
end

-- Rotation of a dumbbell whose bar points along horizontal `axis`, turned `spin` around it.
local function barFrame(axis: Vector3, spin: number): CFrame
	return CFrame.fromMatrix(Vector3.zero, axis, Vector3.yAxis) * CFrame.Angles(spin, 0, 0)
end

-- Rolling dumbbell: the bar turns across the direction of travel and it rolls on its plates.
local function rollDumbbell(fx: OrbFx, pos: Vector3, radius: number, dt: number): CFrame
	local last = fx.lastPos
	fx.lastPos = pos
	if last then
		local axis = Vector3.yAxis:Cross(pos - last)
		local m = axis.Magnitude
		if m > 1e-4 then
			local want, sign = axis / m, 1
			if want:Dot(fx.barAxis) < 0 then
				want, sign = -want, -1
			end
			local blended = fx.barAxis:Lerp(want, math.min(1, dt * 12))
			fx.barAxis = if blended.Magnitude > 1e-3 then blended.Unit else want
			fx.spin += sign * m / math.max(radius, 0.1)
		end
	end
	return barFrame(fx.barAxis, fx.spin)
end

-- Paints the orb in its producing tier's colour and dresses it in the two Blender pieces
-- (the server's plain ball in that colour is the fallback).
local function styleOrb(fx: OrbFx)
	local tier = fx.part:GetAttribute("Tier")
	fx.color = OrbLook.tierColor(if type(tier) == "number" then tier else 1, ORB_PALETTE)
	fx.part.Color = fx.color
	fx.part.Material = Enum.Material.SmoothPlastic
	fx.part.Transparency = 0
	if fx.dumbbell then
		if not fx.pieces then
			buildDumbbell(fx)
		end
	elseif not fx.ball then
		fx.ball = cloneBall("OrbBall", fx.color)
		fx.shine = if fx.ball then cloneBall("OrbShine") else nil
	end
	refreshVisibility(fx)
end

local function untrack(part: BasePart)
	local fx = orbs[part]
	if not fx then
		return
	end
	orbs[part] = nil
	if fx.roll then
		fx.roll = nil
		finishRoll()
	end
	table.insert(recentGone, { pos = fx.home.Position, color = fx.color, big = fx.big, dumbbell = fx.dumbbell, at = os.clock() })
	if #recentGone > 24 then
		table.remove(recentGone, 1)
	end
	for _, conn in fx.conns do
		conn:Disconnect()
	end
	clearBall(fx)
	fx.shell:Destroy()
end

-- First touch of the pen floor: a dust puff (a soft ring without the sprite), a few
-- sparkles and a squash.
local function touchedFloor(fx: OrbFx, pos: Vector3, impact: number)
	fx.squash, fx.squashAmp = 0, 0.32 * impact
	if fx.dumbbell then
		-- A prize: it pumps up to full size with a bigger burst.
		fx.grow = 0
		local plate = dumbbellRadii(fx, DUMBBELL_TRAVEL)
		local floor = pos - Vector3.new(0, plate, 0)
		Orbs.puff(floor, 4)
		Orbs.ring(floor, fx.color, 2.8, 0.55, 0.3)
		Orbs.sparkle(pos, fx.color, 10, 0.8)
		Orbs.sparkle(pos, WHITE, 4, 0.6)
		return
	end
	local floor = pos - Vector3.new(0, fx.part.Size.Y * 0.45, 0)
	if not Orbs.puff(floor, if impact > 0.6 then 3 else 2) then
		Orbs.ring(floor, fx.color, 1.5 * fx.scale, 0.45, 0.35)
	end
	Orbs.sparkle(pos, fx.color, 3, 0.45)
end

-- Came to rest at its spot: small settle wobble, then the idle bob fades in.
local function settled(fx: OrbFx)
	fx.waiting = false
	fx.squash, fx.squashAmp = 0, 0.16
	fx.rest = 0
	refreshVisibility(fx)
	updateLabel(fx, false)
end

-- A feed ball reached its orb: squash, soft flash and a small silent pop; the tag ticks up.
local function mergePop(fx: OrbFx)
	if not orbs[fx.part] then
		return
	end
	local target = attrCount(fx.part)
	fx.count = math.min(fx.count + 1, target)
	fx.still = false
	fx.pulse = 0.18
	fx.squash, fx.squashAmp = 0, 0.3
	fx.flash = 0.7
	local pos = fx.home.Position
	Orbs.ring(pos - Vector3.new(0, fx.part.Size.Y * 0.4 * fx.scale, 0), fx.color, 1.3 * fx.scale, 0.35, 0.45)
	Orbs.sparkle(pos, fx.color, 4, 0.5)
	updateLabel(fx, true)
end

local function onFeed(fx: OrbFx)
	local feed = fx.part:GetAttribute("Feed")
	local total = if type(feed) == "number" then feed else fx.feedSeen + 1
	local delta = math.clamp(total - fx.feedSeen, 1, 3)
	fx.feedSeen = total
	local path = readRoute(fx.part, "FeedPath")
	local from = fx.part:GetAttribute("FeedFrom")
	local tint = fx.part:GetAttribute("FeedTint")
	local color = if typeof(tint) == "Color3" then tint else fx.color
	local orbSize = fx.part.Size.Y
	local size = orbSize * 0.6
	for n = 1, delta do
		local roll = if path
			then newRoll(path, if typeof(from) == "Vector3" then from else nil, nil, size / 2, (orbSize - size) / 2)
			else nil
		if roll and scheduleRoll(roll, os.clock() + (n - 1) * CHUTE_GAP) then
			local flight = Orbs.fly({
				from = roll.p0,
				to = fx.home.Position,
				color = color,
				variant = "Ball",
				size = size,
				trail = false,
				onDone = function()
					finishRoll()
					mergePop(fx)
				end,
			})
			flight.roll = roll
			flight.t0 = roll.t0
			flight.dur = roll.total
		else
			-- Too busy for another rolling ball: pop the count straight away.
			task.delay(0.08 + (n - 1) * 0.12, mergePop, fx)
		end
	end
end

local function track(part: Instance)
	if not part:IsA("BasePart") or orbs[part] then
		return
	end
	local p = part :: BasePart
	p.CastShadow = false -- locally: hidden server balls must not shade the pile
	local mesh = p:FindFirstChildOfClass("SpecialMesh") or sphereMesh(p)
	local shell = basePart(Enum.PartType.Ball, "OrbGlow")
	shell.Size = p.Size * 1.85
	shell.Transparency = 1 -- invisible anchor for the count tag
	local shellMesh = sphereMesh(shell)
	shell.CFrame = p.CFrame
	shell.Parent = folder
	-- Hide any legacy number label the server might still attach.
	for _, child in p:GetChildren() do
		if child:IsA("BillboardGui") then
			child.Enabled = false
		end
	end
	local fx: OrbFx = {
		part = p,
		mesh = mesh :: SpecialMesh,
		shell = shell,
		shellMesh = shellMesh,
		home = p.CFrame,
		phase = math.random() * math.pi * 2,
		scale = 1,
		pulse = 0,
		squash = -1,
		squashAmp = 0,
		roll = nil,
		waiting = false,
		rot = CFrame.identity,
		restRot = faceCamera(p.Position)
			* CFrame.Angles(0, (math.random() * 2 - 1) * REST_YAW, 0)
			* CFrame.Angles((math.random() * 2 - 1) * REST_TILT, 0, (math.random() * 2 - 1) * REST_TILT),
		rest = 1,
		appear = 1,
		big = false,
		color = p.Color,
		labelLift = (math.random() * 2 - 1) * 0.15,
		still = false,
		flash = 0,
		count = attrCount(p),
		feedSeen = (function()
			local feed = p:GetAttribute("Feed")
			return if type(feed) == "number" then feed else 0
		end)(),
		label = nil,
		labelPlate = nil,
		labelText = nil,
		labelScale = nil,
		labelOn = false,
		labelToken = 0,
		ball = nil,
		shine = nil,
		conns = {},
		dumbbell = p:GetAttribute("Kind") == "Dumbbell",
		pieces = nil,
		light = nil,
		grow = 1,
		barAxis = CFrame.Angles(0, math.random() * math.pi * 2, 0).XVector,
		spin = 0,
		lastPos = nil,
		twinkle = math.random(),
	}
	orbs[p] = fx
	if fx.dumbbell then
		-- Lies with its bar across the view (both plates show), turned a little.
		fx.restRot = faceCamera(p.Position) * CFrame.Angles(0, (math.random() * 2 - 1) * REST_YAW * 0.7, 0)
		fx.rot = fx.restRot
	end

	-- Roll in from the unit that produced it (queued behind earlier orbs), or pop in place.
	local spawned = p:GetAttribute("Spawned")
	local age = if type(spawned) == "number" then Workspace:GetServerTimeNow() - spawned else math.huge
	if age < ROLL_WINDOW then
		local path = readRoute(p, "Path")
		local origin = p:GetAttribute("Origin")
		local restY = p:GetAttribute("RestY")
		-- A dumbbell follows the orb route (radius = its travel-size plates) and is lifted
		-- onto its plates when drawn.
		local radius = if fx.dumbbell then (dumbbellRadii(fx, DUMBBELL_TRAVEL)) else p.Size.Y / 2
		local roll = if path
			then newRoll(
				path,
				if typeof(origin) == "Vector3" then origin else nil,
				if type(restY) == "number" then restY else nil,
				radius,
				0
			)
			else nil
		if roll and scheduleRoll(roll, os.clock()) then
			fx.roll = roll
			fx.waiting = true
			fx.rest = 0
			fx.grow = -1
		else
			fx.appear = 0
			fx.rest = 0
		end
	end

	styleOrb(fx)
	updateLabel(fx, false)

	table.insert(
		fx.conns,
		p.AttributeChanged:Connect(function(attr)
			if attr == "Tier" then
				clearBall(fx)
				styleOrb(fx)
			elseif attr == "Feed" then
				onFeed(fx)
			elseif attr == "Count" then
				-- Never show more than the server has; feed balls catch the count up.
				local n = attrCount(p)
				if n < fx.count then
					fx.count = n
					updateLabel(fx, false)
				end
			end
		end)
	)
	table.insert(
		fx.conns,
		p.AncestryChanged:Connect(function(_, parent)
			if parent == nil then
				untrack(p)
			end
		end)
	)
end

local function bindFolder(f: Instance?)
	if f == orbFolder then
		return
	end
	for _, conn in folderConns do
		conn:Disconnect()
	end
	table.clear(folderConns)
	for part in orbs do
		untrack(part)
	end
	orbFolder = f
	if not f then
		return
	end
	table.insert(folderConns, f.ChildAdded:Connect(track))
	for _, child in f:GetChildren() do
		track(child)
	end
end

-- Pickup magnet + pop ----------------------------------------------------------------------

local lastSound = 0

-- One soft pop per pickup: no combo pitch climb, no layered tick. Orbs landing in the
-- same instant share one pop.
local function pickupBlip(count: number)
	local now = os.clock()
	if now - lastSound < SOUND_GAP then
		return
	end
	lastSound = now
	-- Merged orbs and dumbbells: the same pop, a touch lower and fuller.
	local play: any = Sounds.play
	play("OrbPickup", 0.06, if count >= 2 then 0.9 else 1)
end

-- Extra celebration when the piece picked up at `pos` was a dumbbell.
local function dumbbellPicked(pos: Vector3, color: Color3)
	Orbs.sparkle(pos, color, 14, 1.1)
	Orbs.sparkle(pos, WHITE, 6, 0.9)
	Orbs.ring(pos - Vector3.new(0, 0.8, 0), color, 3.4, 0.5, 0.25)
	Orbs.text(pos + Vector3.new(0, 1.5, 0), "x" .. tostring(OrbLook.DUMBBELL_VALUE) .. "!", color:Lerp(WHITE, 0.3), { scale = 1.6 })
end

local function onPicked(data: any)
	if type(data) ~= "table" or type(data.positions) ~= "table" then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local counts = if type(data.counts) == "table" then data.counts else {}
	if not root then
		return
	end
	for i, pos in data.positions do
		if typeof(pos) ~= "Vector3" then
			continue
		end
		local count = if type(counts[i]) == "number" then math.max(1, counts[i]) else 1
		local grow = 1
		local color = ORB_PALETTE[1]
		local dumbbell = false
		-- Match the colour of the real orb that sat there, if we still know it.
		for _, fx in orbs do
			if (fx.home.Position - pos).Magnitude < 1.2 then
				color, dumbbell = fx.color, fx.dumbbell
				break
			end
		end
		for _, gone in recentGone do
			if (gone.pos - pos).Magnitude < 1.2 then
				color, dumbbell = gone.color, gone.dumbbell
				break
			end
		end
		if dumbbell then
			grow = 1.6
			count = math.max(count, 4) -- the fuller pickup sound
			dumbbellPicked(pos, color)
		end
		Orbs.fly({
			from = pos + Vector3.new(0, 0.25, 0),
			target = root,
			color = color,
			variant = "Ball",
			size = 1.3 * grow,
			endSize = 0.25 * grow,
			duration = 0.25 + math.random() * 0.15,
			delay = (i - 1) * 0.035,
			arc = 1.5,
			accel = true,
			trail = true,
			onDone = function()
				Orbs.sparkle(root.Position, color, if count >= 2 then 3 + math.min(count, 8) else 3, 0.5 + (grow - 1))
				if count >= 2 then
					Orbs.ring(root.Position - Vector3.new(0, 2.5, 0), color, 1.6 + grow, 0.35, 0.35)
				end
				pickupBlip(count)
			end,
		})
	end
end

-- Frame loop ----------------------------------------------------------------------------

local moveParts: { BasePart } = {}
local moveCFrames: { CFrame } = {}

-- Queues one orb's ball, glow shell and mesh pieces at `cf` with squash (sx, sy) and scale `s`.
-- `flashed`: the merge flash was active this frame (its last frame restores the colour).
local function drawOrb(fx: OrbFx, cf: CFrame, s: number, sx: number, sy: number, clock: number, flashed: boolean)
	local part = fx.part
	table.insert(moveParts, part)
	table.insert(moveCFrames, cf)
	table.insert(moveParts, fx.shell)
	table.insert(moveCFrames, cf)
	fx.mesh.Scale = Vector3.new(s * sx, s * sy, s * sx)
	local gs = s * (1 + math.sin(clock * 1.6 + fx.phase) * 0.08)
	fx.shellMesh.Scale = Vector3.new(gs * sx, gs * sy, gs * sx)

	local ball = fx.ball
	if flashed then
		local lit = fx.color:Lerp(WHITE, fx.flash * 0.6)
		part.Color = lit
		if ball then
			ball.Color = lit
		end
	end
	-- Blender ball and its highlight: same transform, sized from the orb's diameter.
	if ball then
		local d = part.Size.Y * s
		local size = Vector3.new(d * sx, d * sy, d * sx)
		if (ball.Size - size).Magnitude > 0.002 then
			ball.Size = size
		end
		table.insert(moveParts, ball)
		table.insert(moveCFrames, cf)
		local shine = fx.shine
		if shine then
			local scale = Vector3.new(d * sx, d * sy, d * sx)
			local shineSize = SHINE_SIZE * scale
			if (shine.Size - shineSize).Magnitude > 0.002 then
				shine.Size = shineSize
			end
			table.insert(moveParts, shine)
			table.insert(moveCFrames, cf * CFrame.new(SHINE_OFFSET * scale))
		end
	end
end

-- Queues a dumbbell's pieces at `cf` (its centre and rotation), scaled by `s`.
local function drawDumbbell(fx: OrbFx, cf: CFrame, s: number)
	table.insert(moveParts, fx.part)
	table.insert(moveCFrames, cf)
	table.insert(moveParts, fx.shell)
	table.insert(moveCFrames, cf)
	local pieces = fx.pieces
	if not pieces then
		return
	end
	local length = fx.part.Size.X * s
	for _, piece in pieces do
		local size = Vector3.new(piece.len * length, piece.dia * length, piece.dia * length)
		if (piece.part.Size - size).Magnitude > 0.002 then
			piece.part.Size = size
		end
		table.insert(moveParts, piece.part)
		table.insert(moveCFrames, cf * CFrame.new(piece.x * length, 0, 0))
	end
end

local function step(dt: number)
	local now = os.clock()
	table.clear(moveParts)
	table.clear(moveCFrames)

	-- Flights (ghost orbs: pickups, machine VFX and rolling feed balls).
	local i = 1
	while i <= #flights do
		local f = flights[i]
		if now < f.t0 then
			i += 1
			continue
		end
		local g = f.ghost
		if not f.started then
			f.started = true
			g.active = f.variant
			g.part.Transparency = if f.variant then 1 else 0
			g.trail.Enabled = f.trail
		end
		local t = math.clamp((now - f.t0) / f.dur, 0, 1)
		local pos: Vector3
		local rot = CFrame.identity
		local roll = f.roll
		if roll then
			local p, phase = sampleRoll(roll, now - roll.t0)
			spinRoll(roll, p)
			pos, rot = p, roll.rot
			if phase >= PHASE_DONE then
				t = 1
			end
		else
			local k = if f.accel then t * t * t else t * t * (3 - 2 * t)
			local to = f.to
			if f.target then
				if f.target.Parent then
					to = f.target.Position + f.targetOffset
					f.to = to
				end
				-- Bend the curve toward the moving target.
				f.ctrl = arcControl(f.from, to, 1.5)
			end
			pos = bezier(f.from, f.ctrl, to, k)
		end
		local s = f.s0 + (f.s1 - f.s0) * t
		if roll then
			-- Feed balls pop out of the unit, then hold their size.
			s *= backOut(math.clamp((now - roll.t0) / APPEAR_TIME, 0, 1))
		end
		g.mesh.Scale = Vector3.new(s, s, s)
		local cf = CFrame.new(pos) * rot
		table.insert(moveParts, g.part)
		table.insert(moveCFrames, cf)
		local active = g.active
		if active then
			local ball = g.balls[active]
			ball.Size = g.part.Size * s
			table.insert(moveParts, ball)
			table.insert(moveCFrames, cf)
		end
		if t >= 1 then
			flights[i] = flights[#flights]
			flights[#flights] = nil
			releaseGhost(g)
			if f.onDone then
				task.spawn(f.onDone)
			end
		else
			i += 1
		end
	end

	-- Real orbs: rolling in, or resting (bob, breathe, pulse, squash).
	local clock = now
	local upright = 1 - math.exp(-dt * 4)
	for _, fx in orbs do
		if fx.still then
			continue -- resting and placed: costs nothing until a pop, squash or flash wakes it
		end
		if fx.pulse > 0.001 then
			fx.pulse *= math.exp(-dt * 7)
		else
			fx.pulse = 0
		end
		local flashed = fx.flash > 0
		if flashed then
			fx.flash = math.max(0, fx.flash - dt * 4)
		end
		local sx, sy = 1, 1
		if fx.squash >= 0 then
			fx.squash += dt
			local q = fx.squash
			if q > 0.5 then
				fx.squash = -1
			else
				local wobble = math.sin(q * 26) * math.exp(-q * 8) * fx.squashAmp
				sx, sy = 1 + wobble, 1 - wobble
			end
		end

		local roll = fx.roll
		if roll then
			local t = now - roll.t0
			if t < 0 then
				continue -- still queued for the chute (hidden)
			end
			if fx.waiting then
				fx.waiting = false
				refreshVisibility(fx)
			end
			local pos, phase = sampleRoll(roll, t)
			if not fx.dumbbell then
				spinRoll(roll, pos)
			end
			if phase ~= roll.phase then
				if phase >= PHASE_GUTTER and roll.phase < PHASE_GUTTER then
					fx.squash, fx.squashAmp = 0, 0.1 + 0.15 * roll.gutterImpact -- lands in the gutter
				end
				if phase >= PHASE_FLOOR and roll.phase < PHASE_FLOOR then
					touchedFloor(fx, pos, roll.impact)
				end
				roll.phase = phase
			end
			if fx.dumbbell then
				if fx.grow >= 0 then
					fx.grow += dt / DUMBBELL_GROW
				end
				local k = dumbbellScale(fx)
				local plate, orbR = dumbbellRadii(fx, k)
				local lifted = pos + Vector3.new(0, plate - orbR, 0)
				local rot = rollDumbbell(fx, lifted, plate, dt)
				if phase < PHASE_DONE then
					local grow = backOut(math.clamp(t / APPEAR_TIME, 0, 1))
					drawDumbbell(fx, CFrame.new(lifted) * rot, fx.scale * grow * k * sx)
					continue
				end
				roll.rot = rot
			elseif phase < PHASE_DONE then
				local grow = backOut(math.clamp(t / APPEAR_TIME, 0, 1))
				drawOrb(fx, CFrame.new(pos) * roll.rot, fx.scale * grow, sx, sy, clock, flashed)
				continue
			end
			fx.rot = roll.rot
			fx.roll = nil
			finishRoll()
			settled(fx)
		end

		-- Resting: ease to its resting turn, then hold still at its pile spot.
		fx.rot = fx.rot:Lerp(fx.restRot, upright)
		if fx.rest < 1 then
			fx.rest = math.min(1, fx.rest + dt / 0.8)
			if fx.rest >= 1 then
				fx.rot = fx.restRot
			end
		end
		local appear = 1
		if fx.appear < 1 then
			fx.appear = math.min(1, fx.appear + dt / 0.3)
			appear = backOut(fx.appear)
		end
		local s = fx.scale * (1 + fx.pulse) * appear
		if fx.dumbbell then
			-- Resting prize: finishes pumping up, sways slowly, breathes, glows and twinkles.
			-- Never marked still (there are only ever a few).
			if fx.grow < 1 then
				fx.grow = math.min(1, fx.grow + dt / DUMBBELL_GROW)
			end
			local k = dumbbellScale(fx)
			local full = dumbbellRadii(fx, 1)
			local pos = fx.home.Position + Vector3.new(0, full * (k - 1), 0)
			local sway = CFrame.Angles(0, math.sin(clock * 0.9 + fx.phase) * 0.12, 0)
			local breathe = 1 + math.sin(clock * 2 + fx.phase) * 0.015
			drawDumbbell(fx, CFrame.new(pos) * sway * fx.rot, s * k * breathe * sx)
			if fx.light then
				fx.light.Brightness = 1.2 + 0.5 * math.sin(clock * 2.4 + fx.phase)
			end
			fx.twinkle -= dt
			if fx.twinkle <= 0 and appear >= 1 then
				fx.twinkle = 0.7 + math.random() * 0.6
				local along = (math.random() * 2 - 1) * full * 1.3
				local glint = pos + (sway * fx.rot).XVector * along + Vector3.new(0, full * 0.8, 0)
				Orbs.sparkle(glint, fx.color:Lerp(WHITE, 0.4), 1, 0.25)
			end
			continue
		end
		drawOrb(fx, CFrame.new(fx.home.Position) * fx.rot, s, sx, sy, clock, flashed)
		fx.still = fx.rest >= 1 and fx.appear >= 1 and fx.pulse == 0 and fx.squash < 0 and fx.flash <= 0
	end

	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- Plot discovery --------------------------------------------------------------------------

local function plotOrbFolder(): Instance?
	local data = State.data
	if not data or not data.plotIndex then
		return nil
	end
	local map = Workspace:FindFirstChild("Map")
	local plot = map and map:FindFirstChild("Plot" .. tostring(data.plotIndex))
	return plot and plot:FindFirstChild("Orbs")
end

local started = false

function Orbs.init()
	if started then
		return
	end
	started = true
	folder = Workspace:FindFirstChild("ClientFx") :: Folder?
		or (function()
			local f = Instance.new("Folder")
			f.Name = "ClientFx"
			f.Parent = Workspace
			return f
		end)()
	Orbs.folder = folder

	RunService.Heartbeat:Connect(step)

	local function refresh()
		local f = plotOrbFolder()
		if f then
			bindFolder(f)
		end
	end
	State.changed.Event:Connect(refresh)
	refresh()

	Net.event("Effect").OnClientEvent:Connect(function(kind, data)
		if kind == "OrbsPicked" then
			onPicked(data)
		end
	end)
end

return Orbs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="231">
            <Properties>
              <string name="Name">PlateStyle</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.PlateStyle: how a unit's name plate on the rack looks and glows (pure data + maths,
	no services).

	One row per rarity band (Economy.TIER_BANDS names) sets the look; a small ramp inside
	each band (tier position from the band's first to last tier) nudges halo, size and
	brightness up, never past the next band's base, so the glow grows with every tier and
	steps up at each band change. The champion (slot 1) always gets the top band's effects.

	Readability: the low bands (Common, Uncommon, Rare) are cream sign plates with Ink text
	and a rarity-coloured edge; the high bands (Epic and up) are Ink plates with bright
	rarity-coloured (gradient) text, so the best Chads read as glowing jewels on the rack.
	Far away a plate collapses to a small rarity-coloured gem (`gem`), which glows only for
	the top bands and the champion (`gemGlow`).

	Plates.luau reads the result: plate fill, text colours (several = a gradient), stroke,
	halo, pulse, shimmer sweep, colour cycling, sparkles, a small light pool, plate scale and
	the GUI brightness (SurfaceGui.Brightness with LightInfluence 0; Plates divides the plate
	fill and Ink text by it, so only the coloured glow gets brighter).
]]

local PlateStyle = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- Theme.World.Cream / Theme.World.Ink (this module stays free of requires for the tests).
local CREAM = rgb(255, 247, 232)
local INK = rgb(58, 48, 96)

export type BandLook = {
	plate: Color3, -- plate fill
	dark: boolean, -- Ink plate with bright text (else cream plate with Ink text)
	text: { Color3 }, -- one colour = flat text, more = gradient across the name
	gem: Color3, -- the far-away gem's colour
	gemGlow: boolean, -- the far-away gem keeps a soft halo
	glow: Color3, -- stroke and halo colour
	strokeTransparency: number,
	strokeThickness: number,
	halo: number, -- 0 = no halo, 1 = strongest
	pulseSpeed: number, -- pulses per second (0 = steady)
	pulseAmp: number, -- how much the halo brightens at the pulse peak (0..1)
	shimmer: boolean, -- a light sweep crosses the plate every few seconds
	cycle: boolean, -- gradient text slowly sways through its colours
	sparkles: boolean,
	light: boolean, -- a small warm PointLight pools on the shelf below
	scale: number, -- plate size multiplier
	brightness: number, -- SurfaceGui.Brightness
	plateTransparency: number,
}

-- Per rarity band, quietest first.
PlateStyle.BANDS = {
	Common = {
		plate = CREAM,
		dark = false,
		text = { INK },
		gem = rgb(196, 204, 222),
		gemGlow = false,
		glow = INK,
		strokeTransparency = 0.5,
		strokeThickness = 1.25,
		halo = 0,
		pulseSpeed = 0,
		pulseAmp = 0,
		shimmer = false,
		cycle = false,
		sparkles = false,
		light = false,
		scale = 1,
		brightness = 1,
		plateTransparency = 0.04,
	},
	Uncommon = {
		plate = CREAM,
		dark = false,
		text = { INK },
		gem = rgb(110, 226, 130),
		gemGlow = false,
		glow = rgb(110, 226, 130),
		strokeTransparency = 0.35,
		strokeThickness = 1.5,
		halo = 0.22,
		pulseSpeed = 0,
		pulseAmp = 0,
		shimmer = false,
		cycle = false,
		sparkles = false,
		light = false,
		scale = 1.05,
		brightness = 1.4,
		plateTransparency = 0.04,
	},
	Rare = {
		plate = CREAM,
		dark = false,
		text = { INK },
		gem = rgb(84, 178, 255),
		gemGlow = false,
		glow = rgb(84, 178, 255),
		strokeTransparency = 0.25,
		strokeThickness = 2,
		halo = 0.4,
		pulseSpeed = 0,
		pulseAmp = 0,
		shimmer = false,
		cycle = false,
		sparkles = false,
		light = false,
		scale = 1.1,
		brightness = 1.8,
		plateTransparency = 0.04,
	},
	Epic = {
		plate = INK,
		dark = true,
		text = { rgb(232, 206, 255), rgb(206, 156, 255) },
		gem = rgb(186, 120, 255),
		gemGlow = false,
		glow = rgb(186, 120, 255),
		strokeTransparency = 0.15,
		strokeThickness = 2,
		halo = 0.58,
		pulseSpeed = 0.5,
		pulseAmp = 0.18,
		shimmer = true,
		cycle = false,
		sparkles = false,
		light = false,
		scale = 1.16,
		brightness = 2.3,
		plateTransparency = 0.08,
	},
	Legendary = {
		plate = INK,
		dark = true,
		text = { rgb(255, 244, 190), rgb(255, 204, 64), rgb(255, 160, 40) },
		gem = rgb(255, 200, 56),
		gemGlow = true,
		glow = rgb(255, 200, 56),
		strokeTransparency = 0.05,
		strokeThickness = 2.5,
		halo = 0.75,
		pulseSpeed = 0.6,
		pulseAmp = 0.22,
		shimmer = true,
		cycle = true,
		sparkles = false,
		light = false,
		scale = 1.22,
		brightness = 2.8,
		plateTransparency = 0.08,
	},
	Mythic = {
		plate = INK,
		dark = true,
		text = {
			rgb(255, 214, 92),
			rgb(255, 128, 176),
			rgb(196, 140, 255),
			rgb(110, 200, 255),
			rgb(120, 232, 170),
			rgb(255, 214, 92),
		},
		gem = rgb(255, 104, 164),
		gemGlow = true,
		glow = rgb(255, 150, 196),
		strokeTransparency = 0,
		strokeThickness = 3,
		halo = 0.92,
		pulseSpeed = 0.7,
		pulseAmp = 0.25,
		shimmer = true,
		cycle = true,
		sparkles = true,
		light = true,
		scale = 1.28,
		brightness = 3.4,
		plateTransparency = 0.06,
	},
} :: { [string]: BandLook }

-- Within-band ramp at the band's last tier (each stays below the gap to the next band).
PlateStyle.RAMP = { halo = 0.08, scale = 0.035, brightness = 0.2 }

export type Style = BandLook & {
	band: string,
	level: number, -- continuous glow level: band index + position inside the band
	champion: boolean,
}

export type TierBand = { upTo: number, name: string }

-- Look for `tier` given the rarity bands (Economy.TIER_BANDS). `champion` = slot 1.
function PlateStyle.compute(tier: number, bands: { TierBand }, champion: boolean?): Style
	local index, low, high = #bands, 1, bands[#bands].upTo
	local from = 1
	for i, band in bands do
		if tier <= band.upTo then
			index, low, high = i, from, band.upTo
			break
		end
		from = band.upTo + 1
	end
	local frac = if high > low then math.clamp((tier - low) / (high - low), 0, 1) else 1
	local name = bands[index].name
	local look = PlateStyle.BANDS[name] or PlateStyle.BANDS.Common
	local top = PlateStyle.BANDS[bands[#bands].name] or look
	local ramp = PlateStyle.RAMP
	local style: Style = table.clone(look) :: any
	style.band = name
	style.level = index + frac * 0.9
	style.champion = champion == true
	style.halo = if look.halo > 0 then look.halo + ramp.halo * frac else 0
	style.scale = look.scale + ramp.scale * frac
	style.brightness = look.brightness + ramp.brightness * frac
	if champion then
		-- The champion wears the top band's effects at the top tier's full strength.
		style.plate = top.plate
		style.dark = top.dark
		style.text = top.text
		style.glow = top.glow
		style.gem = top.gem
		style.gemGlow = true
		style.cycle = true
		style.sparkles = true
		style.light = true
		style.shimmer = true
		style.strokeTransparency = math.min(style.strokeTransparency, top.strokeTransparency)
		style.strokeThickness = math.max(style.strokeThickness, top.strokeThickness)
		style.halo = math.max(style.halo, top.halo + ramp.halo)
		style.pulseSpeed = math.max(style.pulseSpeed, top.pulseSpeed)
		style.pulseAmp = math.max(style.pulseAmp, top.pulseAmp)
		style.scale = math.max(style.scale, top.scale + ramp.scale)
		style.brightness = math.max(style.brightness, top.brightness + ramp.brightness)
		style.plateTransparency = math.min(style.plateTransparency, top.plateTransparency)
	end
	return style
end

return PlateStyle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="232">
            <Properties>
              <string name="Name">Plates</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.Plates: a name plate for every unit on every rack, glowing more the higher its tier.

	- Where: each plate hangs from the top front edge of the shelf lip under its unit's feet
	  (the server tags display models with "Slot" and "PlateAt", see Tycoon.markSlot), on a
	  client-only, invisible, non-colliding part with a SurfaceGui facing the pen. It shows
	  the tier's name (Theme.Tiers[tier].Name, shrunk to fit) over a "Tier N" line.
	- Look: Fx.PlateStyle (one table per rarity band plus a small in-band ramp): cream sign
	  plates with Ink text and a rarity-coloured edge for the low bands, Ink plates with
	  bright rarity text from Epic, a soft halo from Uncommon, a pulse and a shimmer sweep
	  from Epic, gold / rainbow gradient text, sparkles and a small light pool for the top
	  band and the champion (slot 1).
	- Distance: within FULL_IN studs of the camera a plate is the full card; beyond FULL_OUT
	  it collapses to a small rarity-coloured gem on the shelf lip (a soft halo for the top
	  bands); past FAR studs the SurfaceGui stops drawing. The champion is always the full card.
	- Motion: a plate pops in once its unit has landed (Fx.Shelf holds arriving units in
	  Animator until they settle), flips to the new name when the unit in its slot changes,
	  shrinks into its gem / grows back out of it with distance and shrinks away when the
	  slot empties (a hidden shelf takes its units with it).
	- Cost: plates are pooled per slot and rebuilt only when the slot's tier changes. A scan
	  every SCAN seconds picks full card or gem per plate (a tween only when that changes),
	  starts the looping glow tweens (TweenService, nothing per frame in Lua) only for full
	  animated plates on the own rack in view, and keeps a few lights on the own rack.
	  Neighbours' plates are built only when the camera comes within NEAR_RACK studs.
	  On "mid" / "low" devices (Fx.Budget) fewer plates animate and carry lights
	  (Budget.count), and on low neighbours' plates wait until 100 studs.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local Theme = require(ReplicatedStorage:WaitForChild("Theme"))

local Client = script.Parent.Parent
local Animator = require(Client.Animator)
local Budget = require(script.Parent.Budget)
local State = require(Client.State)
local PlateStyle = require(script.Parent.PlateStyle)

local Plates = {}

local PLATE_W = 3.5 -- studs at scale 1
local PLATE_H = 0.8
local PAD_X = 0.25 -- halo room around the plate
local PAD_Y = 0.14
local DROP = 0.04 -- gap under the lip's top edge
local OUT = 0.06 -- in front of the rim
local PPS = 64 -- SurfaceGui pixels per stud
local SCAN = 0.25
local FULL_IN = 38 -- a gem grows back into the full plate inside this camera distance...
local FULL_OUT = 42 -- ...and the full plate collapses to its gem beyond this one
local FAR = 120 -- SurfaceGui.MaxDistance
local GEM = 0.42 -- gem diameter in studs at scale 1
local GEM_HALO = 1.9 -- halo diameter / gem diameter (top bands)
local EDGE = 3 -- plate edge pixels per PlateStyle stroke unit
local NEAR_RACK = 150 -- neighbours' plates are built once the camera is this close
local ANIM_MAX = 28 -- animated plates at once
local LIGHTS_MAX = 3 -- light pools on the own rack
local LAND_MIN = 0.35 -- earliest a new unit's plate appears
local LAND_MAX = 8 -- give up waiting for a landing after this long
local FRESH = 4 -- a unit spawned this recently (server time) is still arriving

local WHITE = Color3.new(1, 1, 1)
local INK = (Theme.World and Theme.World.Ink) or Color3.fromRGB(52, 58, 84)
local NAME_FONT = Theme.Fonts.Display
local TIER_FONT = Theme.Fonts.UI

type Plate = {
	part: Part,
	gui: SurfaceGui,
	root: Frame,
	pop: UIScale,
	plate: Frame,
	stroke: UIStroke,
	halos: { Frame },
	name: TextLabel,
	nameStroke: UIStroke,
	nameGradient: UIGradient,
	tierText: TextLabel,
	gemRoot: Frame,
	gemScale: UIScale,
	gem: Frame,
	gemHalo: Frame,
	shimmer: Frame,
	sparkles: { Frame },
	light: PointLight?,
	tweens: { Tween },
	style: PlateStyle.Style?,
	tier: number,
	slot: number,
	shown: boolean,
	mode: string, -- "full" | "gem"
	animating: boolean,
	lit: boolean,
	token: number,
	at: CFrame,
}

type Rack = {
	plot: Instance,
	units: Instance,
	own: boolean,
	near: boolean,
	plates: { [number]: Plate },
	owners: { [number]: Model }, -- slot -> model standing there
	slotOf: { [Model]: number },
	waiting: { [Model]: number }, -- model -> os.clock() it appeared (not landed yet)
	conns: { RBXScriptConnection },
	modelConns: { [Model]: RBXScriptConnection },
}

local racks: { [Instance]: Rack } = {}
local styles: { [number]: PlateStyle.Style } = {}
local championStyles: { [number]: PlateStyle.Style } = {}
local holder: Folder? = nil
local started = false

local function styleFor(tier: number, champion: boolean): PlateStyle.Style
	local cache = if champion then championStyles else styles
	local cached: PlateStyle.Style? = cache[tier]
	if cached then
		return cached
	end
	local style = PlateStyle.compute(tier, Economy.TIER_BANDS, champion)
	cache[tier] = style
	return style
end

local function tierName(tier: number): string
	local info = Theme.Tiers[tier]
	return if info and info.Name then info.Name else ("Tier " .. tier)
end

local function folder(): Folder
	if holder and holder.Parent then
		return holder
	end
	local f = Instance.new("Folder")
	f.Name = "NamePlates"
	f.Parent = Workspace
	holder = f
	return f
end

local function corner(parent: Instance, radius: UDim)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
end

local function frame(parent: Instance, name: string, color: Color3, transparency: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transparency
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

local function label(parent: Frame, name: string, font: Enum.Font, y: number, h: number, maxSize: number): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.AnchorPoint = Vector2.new(0.5, 0)
	t.Position = UDim2.fromScale(0.5, y)
	t.Size = UDim2.fromScale(0.9, h)
	t.BackgroundTransparency = 1
	t.Font = font
	t.TextScaled = true
	t.TextColor3 = WHITE
	t.Parent = parent
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = maxSize
	limit.MinTextSize = 6
	limit.Parent = t
	return t
end

local function newPlate(slot: number): Plate
	local part = Instance.new("Part")
	part.Name = "NamePlate" .. slot
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 0.05)

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = PPS
	gui.LightInfluence = 0
	gui.MaxDistance = FAR
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false
	gui.Parent = part

	local root = frame(gui, "Root", WHITE, 1)
	root.Size = UDim2.fromScale(1, 1)
	local pop = Instance.new("UIScale")
	pop.Scale = 0
	pop.Parent = root

	-- Soft halo: two rounded layers behind the plate; the outer one fills the padding.
	local outer = frame(root, "HaloOuter", WHITE, 1)
	outer.Size = UDim2.fromScale(1, 1)
	outer.ZIndex = 1
	local soft = Instance.new("UIGradient")
	soft.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.85),
		NumberSequenceKeypoint.new(0.2, 0.2),
		NumberSequenceKeypoint.new(0.8, 0.2),
		NumberSequenceKeypoint.new(1, 0.85),
	})
	soft.Parent = outer
	corner(outer, UDim.new(0.5, 0))
	local inner = frame(root, "HaloInner", WHITE, 1)
	inner.Size = UDim2.new(1, -PAD_X * PPS, 1, -PAD_Y * PPS)
	inner.ZIndex = 2
	corner(inner, UDim.new(0.45, 0))
	local halos = { inner, outer }

	local plate = frame(root, "Plate", INK, 0.4)
	plate.Size = UDim2.new(1, -PAD_X * PPS * 2, 1, -PAD_Y * PPS * 2)
	plate.ZIndex = 3
	plate.ClipsDescendants = true
	corner(plate, UDim.new(0.3, 0))
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = plate

	local shimmer = frame(plate, "Shimmer", WHITE, 0.55)
	shimmer.Size = UDim2.fromScale(0.22, 1.6)
	shimmer.Rotation = 18
	shimmer.ZIndex = 4
	shimmer.Visible = false
	local sweep = Instance.new("UIGradient")
	sweep.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	sweep.Parent = shimmer

	-- The tier line is about two thirds of the name's height.
	local name = label(plate, "Name", NAME_FONT, 0.05, 0.52, 44)
	name.ZIndex = 5
	local nameStroke = Instance.new("UIStroke")
	nameStroke.Parent = name
	local nameGradient = Instance.new("UIGradient")
	nameGradient.Parent = name
	local tierText = label(plate, "Tier", TIER_FONT, 0.58, 0.36, 30)
	tierText.ZIndex = 5

	-- The far-away look: a round rarity gem with a white rim (and a soft halo for the top
	-- bands), outside the plate's pop scale so the two can cross-fade.
	local gemRoot = frame(gui, "GemRoot", WHITE, 1)
	local gemScale = Instance.new("UIScale")
	gemScale.Scale = 0
	gemScale.Parent = gemRoot
	local gemHalo = frame(gemRoot, "GemHalo", WHITE, 0.55)
	gemHalo.Size = UDim2.fromScale(GEM_HALO, GEM_HALO)
	gemHalo.ZIndex = 1
	corner(gemHalo, UDim.new(0.5, 0))
	local gem = frame(gemRoot, "Gem", WHITE, 0)
	gem.Size = UDim2.fromScale(1, 1)
	gem.ZIndex = 2
	corner(gem, UDim.new(0.5, 0))
	local rim = Instance.new("UIStroke")
	rim.Color = WHITE
	rim.Thickness = 3
	rim.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rim.Parent = gem

	return {
		part = part,
		gui = gui,
		root = root,
		pop = pop,
		plate = plate,
		stroke = stroke,
		halos = halos,
		name = name,
		nameStroke = nameStroke,
		nameGradient = nameGradient,
		tierText = tierText,
		gemRoot = gemRoot,
		gemScale = gemScale,
		gem = gem,
		gemHalo = gemHalo,
		shimmer = shimmer,
		sparkles = {},
		light = nil,
		tweens = {},
		style = nil,
		tier = 0,
		slot = slot,
		shown = false,
		mode = "full",
		animating = false,
		lit = false,
		token = 0,
		at = CFrame.identity,
	}
end

-- Resting transparencies of the plate's pieces (the glow tweens animate from these).
local function applyLook(p: Plate)
	local style = p.style
	if not style then
		return
	end
	p.plate.BackgroundTransparency = style.plateTransparency
	p.stroke.Transparency = style.strokeTransparency
	p.stroke.Thickness = style.strokeThickness * EDGE
	p.name.TextTransparency = 0
	p.tierText.TextTransparency = if style.dark then 0.1 else 0
	-- Bright text on the Ink plates gets a soft glow outline; Ink text on cream needs none.
	p.nameStroke.Transparency = if style.dark then 0.25 else 1
	p.halos[1].BackgroundTransparency = 1 - style.halo * 0.55
	p.halos[2].BackgroundTransparency = 1 - style.halo * 0.3
	p.shimmer.BackgroundTransparency = 0.55
	for _, s in p.sparkles do
		s.BackgroundTransparency = 1
	end
end

local function stopTweens(p: Plate)
	for _, tw in p.tweens do
		tw:Cancel()
	end
	table.clear(p.tweens)
	p.nameGradient.Offset = Vector2.zero
	p.shimmer.Visible = false
end

-- Builds the plate for its current style: colours, size, gem, sparkles and light.
local function restyle(p: Plate)
	local style = p.style :: PlateStyle.Style
	stopTweens(p)
	p.animating = false
	local w = PLATE_W * style.scale
	local h = PLATE_H * math.sqrt(style.scale)
	p.part.Size = Vector3.new(w + PAD_X * 2, h + PAD_Y * 2, 0.05)
	p.part.CFrame = p.at * CFrame.new(0, -DROP - h / 2, -OUT)
	-- SurfaceGui.Brightness multiplies every colour: the plate fill, the Ink text and the
	-- quiet gems are divided by it so they keep their true colour and only the glow brightens.
	local bright = style.brightness
	local function flat(c: Color3): Color3
		return Color3.new(c.R / bright, c.G / bright, c.B / bright)
	end
	p.gui.Brightness = bright
	p.plate.BackgroundColor3 = flat(style.plate)
	p.stroke.Color = style.glow
	p.nameStroke.Color = style.glow
	p.nameStroke.Thickness = 2
	p.halos[1].BackgroundColor3 = style.glow
	p.halos[2].BackgroundColor3 = style.glow
	local gemPx = GEM * math.sqrt(style.scale) * PPS
	p.gemRoot.Size = UDim2.fromOffset(gemPx, gemPx)
	p.gem.BackgroundColor3 = if style.gemGlow then style.gem else flat(style.gem)
	p.gemHalo.BackgroundColor3 = style.glow
	p.gemHalo.Visible = style.gemGlow
	local colors = style.text
	if not style.dark then
		p.nameGradient.Color = ColorSequence.new(flat(colors[1]))
	elseif #colors == 1 then
		p.nameGradient.Color = ColorSequence.new(colors[1])
	else
		local keys = {}
		for i, c in colors do
			keys[i] = ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c)
		end
		p.nameGradient.Color = ColorSequence.new(keys)
	end
	p.tierText.TextColor3 = if style.dark then style.glow:Lerp(WHITE, 0.55) else flat(style.glow:Lerp(INK, 0.6))
	p.name.Text = tierName(p.tier)
	p.tierText.Text = "Tier " .. p.tier

	if style.sparkles and #p.sparkles == 0 then
		for i, spot in { Vector2.new(0.06, 0.2), Vector2.new(0.95, 0.3), Vector2.new(0.5, 0.05) } do
			local s = frame(p.root, "Sparkle" .. i, WHITE, 1)
			s.Size = UDim2.fromOffset(9, 9)
			s.Position = UDim2.fromScale(spot.X, spot.Y)
			s.Rotation = 45
			s.ZIndex = 6
			p.sparkles[i] = s
		end
	end
	for _, s in p.sparkles do
		s.Visible = style.sparkles
	end
	if style.light and not p.light then
		local light = Instance.new("PointLight")
		light.Range = 5
		light.Brightness = 0.7
		light.Shadows = false
		light.Enabled = false
		light.Parent = p.part
		p.light = light
	end
	if p.light then
		p.light.Color = style.glow:Lerp(WHITE, 0.35)
		p.light.Enabled = false
		p.lit = false
	end
	applyLook(p)
end

-- Looping glow tweens (created on demand, cancelled when the plate stops animating).
local function startTweens(p: Plate)
	local style = p.style :: PlateStyle.Style
	local function loop(inst: Instance, time: number, props: { [string]: any }, reverses: boolean, delay: number?)
		local info = TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, reverses, delay or 0)
		local tw = TweenService:Create(inst, info, props)
		tw:Play()
		table.insert(p.tweens, tw)
	end
	if style.pulseSpeed > 0 then
		local half = 0.5 / style.pulseSpeed
		loop(p.halos[1], half, { BackgroundTransparency = math.max(0, 1 - style.halo * 0.55 - style.pulseAmp) }, true)
		loop(p.halos[2], half, { BackgroundTransparency = math.max(0, 1 - style.halo * 0.3 - style.pulseAmp * 0.6) }, true)
		loop(p.stroke, half, { Thickness = (style.strokeThickness + 1.5) * EDGE }, true)
	end
	if style.shimmer then
		p.shimmer.Visible = true
		p.shimmer.Position = UDim2.fromScale(-0.2, 0.5)
		loop(p.shimmer, 1.1, { Position = UDim2.fromScale(1.2, 0.5) }, false, 2.4 - style.scale)
	end
	if style.cycle then
		p.nameGradient.Offset = Vector2.new(-0.35, 0)
		loop(p.nameGradient, 3.2, { Offset = Vector2.new(0.35, 0) }, true)
	end
	if style.sparkles then
		for i, s in p.sparkles do
			s.BackgroundTransparency = 1
			loop(s, 0.6, { BackgroundTransparency = 0.1, Rotation = 135 }, true, 0.4 + i * 0.45)
		end
	end
end

local function tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle, dir: Enum.EasingDirection): Tween
	local tw = TweenService:Create(inst, TweenInfo.new(time, style, dir), props)
	tw:Play()
	return tw
end

local function plateFor(rack: Rack, slot: number): Plate
	local existing = rack.plates[slot]
	if existing then
		return existing
	end
	local p = newPlate(slot)
	p.part.Parent = folder()
	rack.plates[slot] = p
	return p
end

-- Full card or gem for a plate `dist` studs from the camera (with hysteresis).
local function modeFor(p: Plate, style: PlateStyle.Style, dist: number): string
	if style.champion then
		return "full"
	elseif p.mode == "full" then
		return if dist > FULL_OUT then "gem" else "full"
	end
	return if dist < FULL_IN then "full" else "gem"
end

-- Collapses a shown plate into its gem or grows it back out.
local function setMode(p: Plate, mode: string)
	if p.mode == mode then
		return
	end
	p.mode = mode
	if not p.shown then
		return
	end
	if mode == "full" then
		tween(p.gemScale, 0.15, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(p.pop, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	else
		tween(p.pop, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween(p.gemScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
end

-- Shows `tier` on the slot's plate: pops it in, flips it to a new name, or just restyles.
local function showPlate(rack: Rack, slot: number, tier: number, at: CFrame)
	local p = plateFor(rack, slot)
	local style = styleFor(tier, slot == 1)
	if p.shown and p.tier == tier and p.style == style and p.at == at then
		return
	end
	p.token += 1
	local token = p.token
	local flip = p.shown and p.tier ~= tier
	p.tier, p.style, p.at = tier, style, at
	if flip and p.mode == "gem" and not style.champion then
		-- Far away: the gem takes the new colour with a small punch.
		restyle(p)
		p.gemScale.Scale = 1.4
		tween(p.gemScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		return
	end
	if flip and p.mode == "gem" then
		setMode(p, "full")
	end
	if flip then
		local squash = tween(p.root, 0.12, { Size = UDim2.fromScale(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		squash.Completed:Once(function()
			if p.token ~= token then
				return
			end
			restyle(p)
			tween(p.root, 0.16, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end)
		return
	end
	restyle(p)
	p.root.Size = UDim2.fromScale(1, 1)
	if not p.shown then
		p.shown = true
		p.gui.Enabled = true
		local camera = Workspace.CurrentCamera
		local dist = if camera then (p.part.Position - camera.CFrame.Position).Magnitude else 0
		p.mode = if style.champion or dist < FULL_OUT then "full" else "gem"
		p.pop.Scale = 0
		p.gemScale.Scale = 0
		local grow = if p.mode == "full" then p.pop else p.gemScale
		tween(grow, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	elseif style.champion then
		setMode(p, "full")
	end
end

local function hidePlate(rack: Rack, slot: number)
	local p = rack.plates[slot]
	if not p or not p.shown then
		return
	end
	p.shown = false
	p.token += 1
	local token = p.token
	stopTweens(p)
	p.animating = false
	if p.light then
		p.light.Enabled = false
		p.lit = false
	end
	tween(p.gemScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(p.pop, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Once(function()
		if p.token == token then
			p.gui.Enabled = false
		end
	end)
end

-- Units ------------------------------------------------------------------------------

local function readModel(model: Model): (number?, number?, CFrame?)
	local slot, tier, at = model:GetAttribute("Slot"), model:GetAttribute("Tier"), model:GetAttribute("PlateAt")
	if type(slot) == "number" and type(tier) == "number" and typeof(at) == "CFrame" then
		return slot, tier, at :: CFrame
	end
	return nil, nil, nil
end

-- Shows the model's plate now (it has landed) if it still owns its slot.
local function present(rack: Rack, model: Model)
	local slot, tier, at = readModel(model)
	if slot and tier and at and rack.owners[slot] == model and rack.near then
		showPlate(rack, slot, tier, at)
	end
end

local function release(rack: Rack, model: Model)
	local slot = rack.slotOf[model]
	rack.slotOf[model] = nil
	rack.waiting[model] = nil
	if slot and rack.owners[slot] == model then
		rack.owners[slot] = nil
		-- A replacement may arrive in the same batch: hide only if the slot stays empty.
		task.delay(0.1, function()
			if not rack.owners[slot] then
				hidePlate(rack, slot)
			end
		end)
	end
end

local function claim(rack: Rack, model: Model, fresh: boolean)
	local slot = readModel(model)
	local old = rack.slotOf[model]
	if old and old ~= slot then
		release(rack, model)
	end
	if not slot then
		return
	end
	rack.slotOf[model] = slot
	rack.owners[slot] = model
	if fresh then
		rack.waiting[model] = os.clock()
	else
		present(rack, model)
	end
end

local function onUnitAdded(rack: Rack, model: Instance)
	if not model:IsA("Model") then
		return
	end
	rack.modelConns[model] = model.AttributeChanged:Connect(function(attr: string)
		if attr == "Slot" or attr == "Tier" or attr == "PlateAt" then
			claim(rack, model, false)
		end
	end)
	local spawned = model:GetAttribute("Spawned")
	claim(rack, model, type(spawned) == "number" and Workspace:GetServerTimeNow() - spawned < FRESH)
end

local function onUnitRemoved(rack: Rack, model: Instance)
	if not model:IsA("Model") then
		return
	end
	local conn = rack.modelConns[model]
	if conn then
		conn:Disconnect()
		rack.modelConns[model] = nil
	end
	release(rack, model)
end

local function bindPlot(plot: Instance)
	if racks[plot] then
		return
	end
	local units = plot:FindFirstChild("Units")
	if not units then
		return
	end
	local rack: Rack = {
		plot = plot,
		units = units,
		own = false,
		near = false,
		plates = {},
		owners = {},
		slotOf = {},
		waiting = {},
		conns = {},
		modelConns = {},
	}
	racks[plot] = rack
	table.insert(
		rack.conns,
		units.ChildAdded:Connect(function(child)
			onUnitAdded(rack, child)
		end)
	)
	table.insert(
		rack.conns,
		units.ChildRemoved:Connect(function(child)
			onUnitRemoved(rack, child)
		end)
	)
	for _, child in units:GetChildren() do
		onUnitAdded(rack, child)
	end
	-- Units already standing when the rack is first seen just appear (no landing to wait for).
	for model in rack.waiting do
		rack.waiting[model] = os.clock() - LAND_MAX
	end
end

local function unbindPlot(plot: Instance)
	local rack = racks[plot]
	if not rack then
		return
	end
	racks[plot] = nil
	for _, c in rack.conns do
		c:Disconnect()
	end
	for _, c in rack.modelConns do
		c:Disconnect()
	end
	for _, p in rack.plates do
		stopTweens(p)
		p.part:Destroy()
	end
end

-- Scan: landings, full card or gem, glow animation budget, lights ---------------------

local animCount = 0
local lightCount = 0

-- Where the rack stands: the plate anchor of any unit on it (nil = empty rack).
local function rackCentre(rack: Rack): Vector3?
	local _, model = next(rack.owners)
	local at = model and model:GetAttribute("PlateAt")
	return if typeof(at) == "CFrame" then at.Position else nil
end

local function scanRack(rack: Rack, camPos: Vector3, look: Vector3, right: Vector3, up: Vector3, tanX: number, tanY: number)
	local centre = rackCentre(rack)
	local wasNear = rack.near
	local nearRack = if Budget.low() then math.min(NEAR_RACK, 100) else NEAR_RACK
	rack.near = rack.own or (centre ~= nil and (centre - camPos).Magnitude < nearRack)
	local now = os.clock()
	for model, since in rack.waiting do
		local age = now - since
		if not model.Parent then
			rack.waiting[model] = nil
		elseif age >= LAND_MIN and (age >= LAND_MAX or not Animator.isHeld(model)) then
			rack.waiting[model] = nil
			present(rack, model)
		end
	end
	if rack.near and not wasNear then
		for _, model in rack.owners do
			if not rack.waiting[model] then
				present(rack, model)
			end
		end
	end
	for _, p in rack.plates do
		if not p.shown or not p.style then
			continue
		end
		local style = p.style :: PlateStyle.Style
		local rel = p.part.Position - camPos
		local dist = rel.Magnitude
		setMode(p, modeFor(p, style, dist))
		local animate = rack.own
			and p.mode == "full"
			and dist < FAR
			and animCount < Budget.count(ANIM_MAX)
			and (style.pulseSpeed > 0 or style.shimmer or style.cycle or style.sparkles)
			and Animator.inView(rel, 3, look, right, up, tanX, tanY)
		if animate then
			animCount += 1
		end
		if animate ~= p.animating then
			p.animating = animate
			if animate then
				applyLook(p)
				startTweens(p)
			else
				stopTweens(p)
				applyLook(p)
			end
		end
		if p.light then
			local lit = rack.own and style.light and lightCount < Budget.count(LIGHTS_MAX) and dist < FAR
			if lit then
				lightCount += 1
			end
			if lit ~= p.lit then
				p.lit = lit
				p.light.Enabled = lit
			end
		end
	end
end

local function scan()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local map = Workspace:FindFirstChild("Map")
	if map then
		for _, plot in map:GetChildren() do
			if not racks[plot] and plot.Name:match("^Plot%d+$") and plot:FindFirstChild("Units") then
				bindPlot(plot)
			end
		end
	end
	local data = State.data
	local ownName = if data and data.plotIndex then "Plot" .. data.plotIndex else nil
	local cf = camera.CFrame
	local tanY = math.tan(math.rad(camera.FieldOfView) / 2)
	local viewport = camera.ViewportSize
	local tanX = tanY * (if viewport.Y > 0 then viewport.X / viewport.Y else 16 / 9)
	animCount, lightCount = 0, 0
	for plot, rack in racks do
		if not plot.Parent then
			unbindPlot(plot)
			continue
		end
		rack.own = plot.Name == ownName
		scanRack(rack, cf.Position, cf.LookVector, cf.RightVector, cf.UpVector, tanX, tanY)
	end
end

function Plates.init()
	if started then
		return
	end
	started = true
	-- Plot folders appear late on join; the scan binds them as they show up.
	task.spawn(function()
		local warned = false
		while true do
			local ok, err = pcall(scan :: any)
			if not ok and not warned then
				warned = true
				warn("[Fx.Plates] " .. tostring(err))
			end
			task.wait(SCAN)
		end
	end)
end

return Plates
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="233">
            <Properties>
              <string name="Name">PlayerPose</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Fx.PlayerPose: makes a real R15 avatar (the local player's own, or a duel opponent's)
	strike the game's poses (Poses, the same library the units and rivals use) by
	overriding its Motor6D transforms every frame after Roblox's animations have run.
	Local only: each client poses the characters it sees itself.

	  PlayerPose.attach(character)  a Poser holding the joints, standing HandsOnHips, or nil
	                                for an R6 / missing avatar
	  poser:strike(pose, hop?)      snap into `pose` (any Poses name) with an eased blend,
	                                plus an optional hop (studs)
	  poser:stop()                  hand the joints back to the avatar's animations
	  PlayerPose.nextPose()         the next pose from a shuffled bag of the Chad rotation

	A pose transform is a rotation at the joint in the parent limb's frame; a Motor6D
	Transform is the same rotation turned into the joint's C0 frame.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Poses = require(ReplicatedStorage.Shared:WaitForChild("Poses")) :: any

local PlayerPose = {}

local SET = "Chad"
local BLEND = 0.22 -- seconds to snap into a new pose
local HOP_TIME = 0.32

type Joint = { motor: Motor6D, rot: CFrame, rotInv: CFrame }

export type Poser = {
	strike: (self: Poser, pose: string, hop: number?) -> (),
	stop: (self: Poser) -> (),
}

local function collect(character: Model): { [string]: Joint }?
	local joints: { [string]: Joint } = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and d.Part1 then
			local limb = d.Part1.Name
			if not joints[limb] and table.find(Poses.LIMBS, limb) then
				local rot = d.C0.Rotation
				joints[limb] = { motor = d, rot = rot, rotInv = rot:Inverse() }
			end
		end
	end
	return if joints.LowerTorso and joints.UpperTorso then joints else nil
end

function PlayerPose.attach(character: Model?): Poser?
	local joints = if character then collect(character) else nil
	if not character or not joints then
		return nil
	end
	local scale = character:GetScale()
	local seed = math.random() * 100 -- so two avatars never breathe in step
	local current = "HandsOnHips"
	local changedAt = os.clock() - BLEND
	local from: { [string]: CFrame } = {}
	local target: { [string]: CFrame } = {}
	local applied: { [string]: CFrame } = {}
	local hopAt, hopHeight = -math.huge, 0

	local conn = RunService.PreSimulation:Connect(function()
		local now = os.clock()
		local alpha = math.clamp((now - changedAt) / BLEND, 0, 1)
		local w = TweenService:GetValue(alpha, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		Poses.samplePoseInto(target, SET, current, now + seed, 0)
		local breath = math.rad(math.sin((now + seed) * 1.75) * 1.6)
		local hopT = now - hopAt
		local lift = if hopT < HOP_TIME then math.sin(hopT / HOP_TIME * math.pi) * hopHeight else 0
		for _, limb in Poses.LIMBS do
			local goal = target[limb]
			local start = from[limb]
			local cf = if start and w < 1 then start:Lerp(goal, w) else goal
			applied[limb] = cf
			local joint = joints[limb]
			if not joint or not joint.motor.Parent then
				continue
			end
			local rotation = cf.Rotation
			if limb == "UpperTorso" then
				rotation *= CFrame.Angles(breath, 0, 0)
			end
			local transform = joint.rotInv * rotation * joint.rot
			if limb == "LowerTorso" then
				transform = CFrame.new(joint.rotInv * Vector3.new(0, (cf.Y + lift) * scale, 0)) * transform
			end
			joint.motor.Transform = transform
		end
	end)

	local poser = {} :: Poser
	local stopped = false

	function poser.strike(_self: Poser, pose: string, hop: number?)
		if stopped then
			return
		end
		from = table.clone(applied)
		current = pose
		changedAt = os.clock()
		if hop and hop > 0 then
			hopAt, hopHeight = changedAt, hop
		end
	end

	function poser.stop(_self: Poser)
		if stopped then
			return
		end
		stopped = true
		conn:Disconnect()
		for _, joint in joints do
			if joint.motor.Parent then
				joint.motor.Transform = CFrame.identity
			end
		end
	end

	return poser
end

local bag: { string } = {}
local last: string? = nil

function PlayerPose.nextPose(): string
	if #bag == 0 then
		local names = Poses.poseNames(SET)
		table.remove(names, 1) -- the rest pose
		for i = #names, 2, -1 do
			local j = math.random(1, i)
			names[i], names[j] = names[j], names[i]
		end
		-- The bag is drawn from the end: never repeat the previous bag's last pose.
		if #names > 1 and names[#names] == last then
			names[1], names[#names] = names[#names], names[1]
		end
		bag = names
	end
	local pose = table.remove(bag) :: string
	last = pose
	return pose
end

return PlayerPose
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="234">
            <Properties>
              <string name="Name">Shelf</string>
              <string name="Source"><![CDATA[--[[
	Fx.Shelf: client-side juice for the player's own unit rack.

	- Arrival: unit models that appear in Plot.Units with a fresh "Spawned"
	  attribute pop out of a sparkle puff just in front of their shelf and hop
	  back onto their spot (the arc stays under the board above), growing from
	  tiny with a back-eased scale, bounce (uniform squash), then hit a power
	  pose. Units with nothing above them fall in from above instead. Soft dust
	  ring, sparkles and a "BuyPop" (a few per batch) on landing. Units bound
	  for a shelf that is still unfolding wait until its board is in place.
	- Rack rows (every plot near the camera): a shelf the server reveals (a
	  "RackRow" model arriving in the plot folder) unfolds: its posts and back
	  panel grow up from the shelf below, the board, band and rim slide in from
	  the front with a soft bounce, then a few stars. A shelf that is no longer
	  needed folds away (a local copy plays it backwards), and the roof + sign
	  ("RackTopper") glides to its new height instead of jumping. Shelves
	  already shown when the player joins just exist.
	- Overflow ("Merge" effect with overflow = true, the rack was full): the
	  consumed units' spots pulse, their aura flies together into one light
	  fusion and a short "FULL! AUTO-MERGED xN" float rises there (at most one
	  float per second; merges in between add to the next one).
	- Merge ("Merge" effect): aura soul orbs rise from every consumed unit
	  and spiral into the target (~0.7 s, "MergeCharge"), then a soft
	  tier-tinted puff, an eased ring, a particle burst, "MergeBoom" and a
	  gentle camera punch. Auto merges get a lighter, quieter version. A unit
	  spawning at the merge target lands exactly on the impact.
	- Batched merges ("count"/"summary"): an escalating cascade of soft pops
	  rising in pitch, then a wide ring, palette confetti and an "xN MERGES!"
	  float. Chained step merges show the running total when the chain ends.
	- Shelf glow: every unit stands on a soft tier-coloured disc (sized to fit
	  the shelf; positions refreshed round-robin, not every frame); the best
	  (highest tier) unit gets a hero treatment: a slowly turning ring of
	  tiles, a faint colour haze, rising sparkles and a proud idle
	  (Animator.setHero). The own plot is handed to Animator.setOwnPlot so its
	  units get the bigger posing budget.

	Effects are painted, not glowing: SmoothPlastic parts in tier or palette
	colours with eased fades, low particle light emission and no lights. Only
	the soul orbs (aura) use Neon.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared:WaitForChild("Economy"))
local Net = require(Shared:WaitForChild("Net"))
local Theme = require(ReplicatedStorage:WaitForChild("Theme"))

local Client = script.Parent.Parent
local Animator = require(Client.Animator)
local Sounds = require(Client.Sounds)
local State = require(Client.State)
local Camera = require(script.Parent.Camera)
local Orbs = require(script.Parent.Orbs)

local Shelf = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local WHITE = Color3.new(1, 1, 1)

local function worldColor(key: string, fallback: Color3): Color3
	local palette = (Theme :: any).World
	return if palette and palette[key] then palette[key] else fallback
end

local DUST = worldColor("Cream", Color3.fromRGB(255, 247, 232))
local DUST_SHADE = worldColor("SandDark", Color3.fromRGB(232, 204, 150))
local CONFETTI = {
	worldColor("Sunny", WHITE),
	worldColor("Pink", WHITE),
	worldColor("Blue", WHITE),
	worldColor("Mint", WHITE),
	worldColor("Coral", WHITE),
}
-- Particle light emission: sparkles read on a bright day without blooming.
local SPARKLE_EMISSION = 0.25

local FRESH = 2 -- seconds: a unit spawned this recently gets the drop-in
local DECIDE_DELAY = 0.08 -- wait for a matching Merge effect before dropping
local DROP_HEIGHT = 7 -- fall height for a unit with nothing above it
local FALL = 0.34
local HOP = 0.42 -- hop from the front onto a shelf
local HOP_FORWARD = 3.2 -- studs in front of the spot the hop starts
local HOP_PEAK = 1.4 -- highest hop arc (less when the board above is close)
local SETTLE = 0.45
local STAGGER = 0.04
local START_SCALE = 0.05
local POP_LIMIT = 4 -- BuyPop sounds per POP_WINDOW
local POP_WINDOW = 0.4
local CHARGE = 0.7 -- merge orb flight
local CHARGE_AUTO = 0.5
local MERGE_STAGGER = 0.2 -- chained merge steps play one after another
local CHEST_HEIGHT = 3 -- impact point above the target's feet
local NEAR_PLOT = 120 -- camera punch only if the player is this close
local PUNCH_SCALE = 0.6 -- keeps camera punches and shakes gentle

local fxFolder: Folder? = nil
local started = false

-- Helpers --------------------------------------------------------------------------

local function folder(): Folder
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local f = Instance.new("Folder")
	f.Name = "ShelfFx"
	f.Parent = Workspace
	fxFolder = f
	return f
end

local function fxPart(shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, transparency: number?, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = folder()
	return p
end

local function tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function cleanup(inst: Instance, after: number)
	task.delay(after, function()
		inst:Destroy()
	end)
end

local function tierColor(tier: number): Color3
	local entry = Theme.Tiers[math.clamp(tier, 1, #Theme.Tiers)]
	local rarity = Theme.Colors.Rarity[Economy.tierBand(tier)] or WHITE
	local aura = entry and entry.Look.aura
	if aura then
		return aura:Lerp(rarity, 0.35)
	end
	return rarity
end

-- One-shot particle burst at `pos`; returns after scheduling cleanup.
local function burst(
	pos: Vector3,
	color: Color3,
	count: number,
	opts: {
		texture: string?,
		speed: NumberRange?,
		size: number?,
		life: NumberRange?,
		spread: number?,
		gravity: number?,
		drag: number?,
	}?
)
	local o = opts or {}
	local holder = fxPart(Enum.PartType.Block, Vector3.one * 0.2, CFrame.new(pos), color, 1)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = o.texture or SPARKLE
	emitter.Color = ColorSequence.new(WHITE, color)
	emitter.LightEmission = if o.texture == SMOKE then 0 else SPARKLE_EMISSION
	local size = o.size or 0.8
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, if o.texture == SMOKE then 0.45 else 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = o.life or NumberRange.new(0.4, 0.8)
	emitter.Speed = o.speed or NumberRange.new(8, 16)
	local spread = o.spread or 180
	emitter.SpreadAngle = Vector2.new(spread, spread)
	emitter.Acceleration = Vector3.new(0, -(o.gravity or 10), 0)
	emitter.Drag = o.drag or 3
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	cleanup(holder, 2)
end

-- Flat expanding ring (shockwave / dust ring), eased out as it fades.
local function ring(pos: Vector3, color: Color3, fromSize: number, toSize: number, time: number, transparency: number)
	local cf = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
	local part = fxPart(Enum.PartType.Cylinder, Vector3.new(0.12, fromSize, fromSize), cf, color, transparency)
	tween(part, time, { Size = Vector3.new(0.05, toSize, toSize), Transparency = 1 }, Enum.EasingStyle.Quad)
	cleanup(part, time + 0.05)
end

-- Soft painted puff: a translucent ball that swells and fades (no light, no glow).
local function puff(pos: Vector3, color: Color3, fromSize: number, toSize: number, time: number, transparency: number)
	local part = fxPart(Enum.PartType.Ball, Vector3.one * fromSize, CFrame.new(pos), color, transparency)
	tween(part, time, { Size = Vector3.one * toSize, Transparency = 1 }, Enum.EasingStyle.Quad)
	cleanup(part, time + 0.05)
end

-- Back-eased 0..1 with an overshoot of `overshoot` (default 1.9, ~10 % past the end).
local function backOut(x: number, overshoot: number?): number
	local c1 = overshoot or 1.9
	local c3 = c1 + 1
	local y = x - 1
	return 1 + c3 * y * y * y + c1 * y * y
end

local function easeInOut(x: number): number
	return if x < 0.5 then 4 * x * x * x else 1 - (-2 * x + 2) ^ 3 / 2
end

local function ownPlot(): Instance?
	local data = State.data
	local map = Workspace:FindFirstChild("Map")
	if not data or not map or not data.plotIndex then
		return nil
	end
	return map:FindFirstChild("Plot" .. data.plotIndex)
end

local function playerNear(pos: Vector3, range: number): boolean
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and (root.Position - pos).Magnitude <= range
end

-- Frame loop for the custom animations (one connection for everything) --------------

type Job = (now: number) -> boolean -- returns true when finished
local jobs: { Job } = {}

local function addJob(job: Job)
	table.insert(jobs, job)
end

local function runJobs()
	if #jobs == 0 then
		return
	end
	local now = os.clock()
	local i = 1
	while i <= #jobs do
		local ok, done = pcall(jobs[i], now)
		if not ok or done then
			table.remove(jobs, i)
		else
			i += 1
		end
	end
end

-- Rack rows: shelves unfold / fold away, the roof glides -----------------------------

local ROW_FRESH = 1.2 -- a RackRow arriving this soon after "Rows" changed is a reveal
local ROW_NEAR = 260 -- only racks this close to the camera animate
local ROW_READY = 0.62 -- seconds into a reveal when the board has landed
local BOARD_SLIDE = 4 -- studs in front of its place a revealed board starts
local TOPPER_TIME = 0.5

type PartAnim = {
	part: BasePart,
	cf: CFrame, -- final (server) CFrame
	size: Vector3,
	transparency: number,
	kind: string, -- "grow" (up from its bottom), "slide" (in from the front) or "pop"
	delay: number,
	time: number,
}

type Rack = {
	folder: Instance,
	conns: { RBXScriptConnection },
	rows: number,
	rowsChangedAt: number,
	shownPivot: CFrame?, -- where the roof is drawn right now
	glide: number, -- token of the running roof glide
}

local racks: { [Instance]: Rack } = {}
-- The own plot folder whose units this module animates (set by watchPlot).
local watched: Instance? = nil
-- What the player's rack looks like on joining just exists: no shelf unfolds and no unit
-- hops in until this long after the own plot is first known.
local JOIN_SETTLE = 3
local settledAt = math.huge

local function settled(): boolean
	return os.clock() >= settledAt
end
-- Final CFrames of parts that are mid-animation (board look-ups use these).
local finals: { [BasePart]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
-- Shelves still unfolding: units bound for them wait for the board.
type Reveal = { plot: Instance, minY: number, maxY: number, readyAt: number }
local reveals: { Reveal } = {}

local function cameraNear(pos: Vector3, range: number): boolean
	local camera = Workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - pos).Magnitude <= range
end

-- How a rack part animates: posts and back panel grow, board pieces slide, the rest pops.
local function partAnim(part: BasePart, reveal: boolean): PartAnim
	local name = part.Name
	local kind, delay, time
	if name == "RackPost" then
		kind, delay, time = "grow", 0, 0.38
	elseif name == "ShelfBack" or name == "ShelfBackRear" then
		kind, delay, time = "grow", 0.12, 0.38
	elseif name == "ShelfBoard" or name == "ShelfBand" or name == "ShelfRim" then
		kind, delay, time = "slide", 0.22, 0.42
	elseif name == "RackKnob" then
		kind, delay, time = "pop", 0.02, 0.3
	else
		kind, delay, time = "pop", 0.5, 0.3
	end
	if not reveal then
		-- Folding plays the same moves backwards, top pieces first.
		if kind == "slide" then
			delay, time = 0, 0.28
		elseif name == "ShelfBack" or name == "ShelfBackRear" then
			delay, time = 0.1, 0.3
		elseif kind == "grow" then
			delay, time = 0.16, 0.32
		else
			delay, time = 0, 0.2
		end
	end
	return {
		part = part,
		cf = part.CFrame,
		size = part.Size,
		transparency = part.Transparency,
		kind = kind,
		delay = delay,
		time = time,
	}
end

-- Places one animated part at progress `e` (0 = folded away, 1 = in place; may overshoot).
local function placePart(a: PartAnim, e: number, front: Vector3)
	local part = a.part
	if a.kind == "grow" then
		local h = math.max(a.size.Y * math.clamp(e, 0, 1), 0.05)
		part.Size = Vector3.new(a.size.X, h, a.size.Z)
		part.CFrame = a.cf * CFrame.new(0, (h - a.size.Y) / 2, 0)
	elseif a.kind == "slide" then
		part.CFrame = a.cf + front * (BOARD_SLIDE * (1 - e))
		part.Transparency = a.transparency + (1 - a.transparency) * (1 - math.clamp(e * 3, 0, 1))
	else
		local s = math.max(e, 0.02)
		part.Size = a.size * s
		part.CFrame = a.cf
	end
end

-- The direction out of the rack's front (toward the entrance) for a row model.
local function rowFront(model: Instance): Vector3
	local board = model:FindFirstChild("ShelfBoard")
	if board and board:IsA("BasePart") then
		return board.CFrame.LookVector
	end
	return Vector3.new(0, 0, -1)
end

local function collectParts(model: Instance, reveal: boolean): { PartAnim }
	local anims: { PartAnim } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(anims, partAnim(d, reveal))
		end
	end
	return anims
end

local function revealRow(model: Model, plot: Instance)
	local anims = collectParts(model, true)
	if #anims == 0 then
		return
	end
	local front = rowFront(model)
	local boardTop = -math.huge
	for _, a in anims do
		finals[a.part] = a.cf
		placePart(a, 0, front)
		if a.part.Name == "ShelfBoard" then
			boardTop = a.cf.Position.Y + a.size.Y / 2
		end
	end
	local start = os.clock()
	local reveal: Reveal? = nil
	if boardTop > -math.huge then
		reveal = { plot = plot, minY = boardTop - 0.6, maxY = boardTop + 2, readyAt = start + ROW_READY }
		table.insert(reveals, reveal :: Reveal)
	end
	local starsDone = false
	addJob(function(now: number): boolean
		local t = now - start
		local finished = true
		for _, a in anims do
			if not a.part.Parent then
				continue
			end
			local p = math.clamp((t - a.delay) / a.time, 0, 1)
			local e = if a.kind == "slide" then backOut(p, 1.6) elseif a.kind == "pop" then backOut(p) else 1 - (1 - p) ^ 2
			placePart(a, e, front)
			if p < 1 then
				finished = false
			end
		end
		if not starsDone and t >= ROW_READY - 0.05 then
			starsDone = true
			for _, a in anims do
				if a.part.Name == "ShelfBoard" then
					local half = a.size.X * 0.32
					for k = -1, 1 do
						local pos = (a.cf * CFrame.new(k * half, a.size.Y / 2 + 0.6, 0)).Position
						burst(pos, CONFETTI[(k + 2) % #CONFETTI + 1], 6, {
							speed = NumberRange.new(3, 7),
							size = 0.7,
							life = NumberRange.new(0.5, 0.9),
							gravity = 4,
						})
					end
					ring(a.cf.Position + Vector3.new(0, a.size.Y / 2 + 0.1, 0), WHITE, 2, 9, 0.4, 0.5)
				end
			end
			if plot == ownPlot() then
				Sounds.play("BuyPop", 0.05, 0.75)
			end
		end
		if finished then
			for _, a in anims do
				finals[a.part] = nil
			end
			if reveal then
				local index = table.find(reveals, reveal)
				if index then
					table.remove(reveals, index)
				end
			end
		end
		return finished
	end)
end

-- Plays the fold on a local copy of a shelf the server just took away.
local function foldRow(copy: Model)
	copy.Parent = folder()
	local anims = collectParts(copy, false)
	local front = rowFront(copy)
	for _, a in anims do
		a.part.Anchored = true
		a.part.CanCollide = false
		a.part.CanQuery = false
		a.part.CanTouch = false
	end
	local start = os.clock()
	addJob(function(now: number): boolean
		if not copy.Parent then
			return true
		end
		local t = now - start
		local finished = true
		for _, a in anims do
			local p = math.clamp((t - a.delay) / a.time, 0, 1)
			placePart(a, 1 - p * p, front)
			if p < 1 then
				finished = false
			end
		end
		if finished then
			copy:Destroy()
		end
		return finished
	end)
end

-- Glides the roof + sign from where it is drawn to where the server just put it.
local function glideTopper(rack: Rack)
	local topper = rack.folder:FindFirstChild("RackTopper")
	if not topper or not topper:IsA("Model") then
		return
	end
	rack.glide += 1
	local token = rack.glide
	local target = topper:GetPivot()
	local from = rack.shownPivot
	rack.shownPivot = target
	if not from or not settled() or (from.Position - target.Position).Magnitude < 0.05 or not cameraNear(target.Position, ROW_NEAR) then
		return
	end
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	local cframes: { CFrame } = {}
	for _, d in topper:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			table.insert(offsets, target:ToObjectSpace(d.CFrame))
		end
	end
	local rising = target.Position.Y > from.Position.Y
	local start = os.clock()
	local function placeAt(pivot: CFrame)
		for i, offset in offsets do
			cframes[i] = pivot * offset
		end
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	placeAt(from)
	addJob(function(now: number): boolean
		if rack.glide ~= token then
			return true
		end
		local p = math.clamp((now - start) / TOPPER_TIME, 0, 1)
		local e = if rising then backOut(p, 1.2) else 1 - (1 - p) ^ 2
		local pivot = from:Lerp(target, e)
		rack.shownPivot = pivot
		placeAt(pivot)
		if p >= 1 then
			rack.shownPivot = target
			return true
		end
		return false
	end)
end

local function bindRack(plot: Instance)
	if racks[plot] then
		return
	end
	local topper = plot:FindFirstChild("RackTopper")
	local rowsValue = plot:GetAttribute("Rows")
	local rack: Rack = {
		folder = plot,
		conns = {},
		rows = if type(rowsValue) == "number" then rowsValue else 1,
		rowsChangedAt = -math.huge,
		shownPivot = if topper and topper:IsA("Model") then topper:GetPivot() else nil,
		glide = 0,
	}
	racks[plot] = rack
	table.insert(
		rack.conns,
		plot:GetAttributeChangedSignal("Rows"):Connect(function()
			local value = plot:GetAttribute("Rows")
			rack.rows = if type(value) == "number" then value else rack.rows
			rack.rowsChangedAt = os.clock()
			glideTopper(rack)
		end)
	)
	table.insert(
		rack.conns,
		plot.ChildAdded:Connect(function(child)
			if child.Name == "RackTopper" and child:IsA("Model") then
				rack.shownPivot = child:GetPivot()
				return
			end
			if child.Name ~= "RackRow" or not child:IsA("Model") then
				return
			end
			local row = child:GetAttribute("Row")
			local value = plot:GetAttribute("Rows")
			local rows = if type(value) == "number" then value else 1
			-- New if "Rows" has not caught up yet or just changed (a row streaming back in
			-- with no change to "Rows" just appears).
			local fresh = (type(row) == "number" and row > rows) or os.clock() - rack.rowsChangedAt < ROW_FRESH
			if fresh and settled() and cameraNear(child:GetPivot().Position, ROW_NEAR) then
				revealRow(child, plot)
			end
		end)
	)
	table.insert(
		rack.conns,
		plot.ChildRemoved:Connect(function(child)
			if child.Name ~= "RackRow" or not child:IsA("Model") then
				return
			end
			local row = child:GetAttribute("Row")
			if type(row) ~= "number" or not settled() or not cameraNear(child:GetPivot().Position, ROW_NEAR) then
				return
			end
			-- Copy it now, while its parts are still here; play the fold if the rack shrank.
			child.Archivable = true
			local ok, copy = pcall(child.Clone, child)
			if not ok or not copy then
				return
			end
			task.defer(function()
				local value = plot:GetAttribute("Rows")
				local rows = if type(value) == "number" then value else 1
				if row > rows or os.clock() - rack.rowsChangedAt < ROW_FRESH then
					foldRow(copy :: Model)
				else
					copy:Destroy()
				end
			end)
		end)
	)
end

local function bindRacks()
	local map = Workspace:FindFirstChild("Map")
	if not map then
		return
	end
	for _, child in map:GetChildren() do
		if child.Name:match("^Plot%d+$") then
			bindRack(child)
		end
	end
	map.ChildAdded:Connect(function(child)
		if child.Name:match("^Plot%d+$") then
			bindRack(child)
		end
	end)
end

-- When a unit standing at `feet` on a shelf of `plot` may land: after its shelf unfolds.
local function rowReadyAt(plot: Instance?, feet: Vector3): number
	local ready = 0
	for _, reveal in reveals do
		if reveal.plot == plot and feet.Y >= reveal.minY and feet.Y <= reveal.maxY then
			ready = math.max(ready, reveal.readyAt)
		end
	end
	return ready
end

-- The plot's shelf boards and roof, cached briefly (a batch of arrivals shares one scan).
local boardCache: { plot: Instance?, at: number, parts: { BasePart } } = { plot = nil, at = -math.huge, parts = {} }

local function rackBoards(plot: Instance): { BasePart }
	local now = os.clock()
	if boardCache.plot == plot and now - boardCache.at < 0.1 then
		return boardCache.parts
	end
	local parts: { BasePart } = {}
	for _, child in plot:GetChildren() do
		local name = child.Name
		local part: Instance? = nil
		if name == "ShelfBoard" then
			part = child
		elseif name == "RackRow" then
			part = child:FindFirstChild("ShelfBoard")
		elseif name == "RackTopper" then
			part = child:FindFirstChild("RackRoof")
		end
		if part and part:IsA("BasePart") then
			table.insert(parts, part)
		end
	end
	boardCache.plot, boardCache.at, boardCache.parts = plot, now, parts
	return parts
end

-- Bottom (y) of the lowest shelf board or roof above `feet` that covers it, if any.
local function boardAbove(plot: Instance?, feet: Vector3): number?
	if not plot then
		return nil
	end
	local best: number? = nil
	for _, part in rackBoards(plot) do
		local cf = finals[part] or part.CFrame
		local size = part.Size
		local lp = cf:PointToObjectSpace(feet)
		if math.abs(lp.X) <= size.X / 2 and math.abs(lp.Z) <= size.Z / 2 + 0.5 then
			local bottom = cf.Position.Y - size.Y / 2
			if bottom > feet.Y + 0.5 and (best == nil or bottom < best :: number) then
				best = bottom
			end
		end
	end
	return best
end

-- Arrival -----------------------------------------------------------------------------

local popTimes: { number } = {}
local lastDropStart = 0

-- Pending merge impacts: a unit spawning here lands on the impact.
type Pending = { pos: Vector3, impact: number }
local pendingMerges: { Pending } = {}

local function pop(tier: number)
	local now = os.clock()
	for i = #popTimes, 1, -1 do
		if now - popTimes[i] > POP_WINDOW then
			table.remove(popTimes, i)
		end
	end
	if #popTimes >= POP_LIMIT then
		return
	end
	table.insert(popTimes, now)
	Sounds.play("BuyPop", 0.1, 1 + #popTimes * 0.06 - math.min(tier, 25) * 0.008)
end

local function safeScale(model: Model, scale: number)
	pcall(model.ScaleTo, model, math.max(scale, 0.01))
end

local function land(target: CFrame, tier: number, quiet: boolean?)
	local feet = target.Position
	local color = tierColor(tier)
	ring(feet + Vector3.new(0, 0.15, 0), DUST, 1.5, 7, 0.4, 0.45)
	burst(feet + Vector3.new(0, 0.3, 0), DUST_SHADE, 8, {
		texture = SMOKE,
		speed = NumberRange.new(6, 9),
		size = 1.4,
		life = NumberRange.new(0.35, 0.6),
		spread = 80,
		gravity = 0,
		drag = 6,
	})
	burst(feet + Vector3.new(0, 2, 0), color, 10, { speed = NumberRange.new(4, 9), size = 0.6, gravity = 6 })
	if not quiet then
		pop(tier)
	end
end

-- Moves a unit in: `peak` = nil falls from DROP_HEIGHT above (nothing overhead); otherwise
-- it hops from HOP_FORWARD in front of its spot in an arc no higher than `peak`, so it never
-- passes through the board above. Then a squash, the landing puff and a power pose.
local function arrive(model: Model, target: CFrame, baseScale: number, startAt: number, tier: number, quiet: boolean, peak: number?)
	local landed = false
	local puffed = false
	local flight = if peak then HOP else FALL
	addJob(function(now: number): boolean
		if not model.Parent then
			Animator.release(model)
			return true
		end
		local t = now - startAt
		if t < 0 then
			return false
		end
		if t < flight then
			local p = t / flight
			if peak then
				if not puffed then
					puffed = true
					local from = (target * CFrame.new(0, 1.5, -HOP_FORWARD)).Position
					burst(from, tierColor(tier):Lerp(WHITE, 0.4), 8, { speed = NumberRange.new(2, 6), size = 0.7, gravity = 0 })
					puff(from, WHITE, 0.6, 3, 0.3, 0.4)
				end
				local ease = 1 - (1 - p) * (1 - p)
				local forward = HOP_FORWARD * (1 - ease)
				local height = 4 * peak * p * (1 - p)
				local spin = (1 - p) * math.pi * 1.2
				safeScale(model, baseScale * (START_SCALE + (1 - START_SCALE) * backOut(math.min(1, p * 1.5), 1.2)))
				model:PivotTo(target * CFrame.new(0, height, -forward) * CFrame.Angles(0, spin, 0))
			else
				local height = DROP_HEIGHT * (1 - p * p)
				local spin = (1 - p) * math.pi * 1.5
				safeScale(model, baseScale * (START_SCALE + (1 - START_SCALE) * backOut(p)))
				model:PivotTo(target * CFrame.new(0, height, 0) * CFrame.Angles(0, spin, 0))
			end
			return false
		end
		if not landed then
			landed = true
			land(target, tier, quiet)
		end
		local q = (t - flight) / SETTLE
		if q < 1 then
			-- Uniform squash: dip below full size, overshoot, settle.
			local wobble = -0.16 * math.exp(-5 * q) * math.cos(q * 15)
			safeScale(model, baseScale * (1 + math.min(wobble, 0.04)))
			model:PivotTo(target)
			return false
		end
		safeScale(model, baseScale)
		model:PivotTo(target)
		Animator.release(model)
		Animator.show(model, if tier >= 10 then "MostMuscular" else "DoubleBiceps", 1.5, if peak then 0 else 0.5)
		return true
	end)
end

local function onUnitAdded(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local spawned = model:GetAttribute("Spawned")
	if not settled() or type(spawned) ~= "number" or Workspace:GetServerTimeNow() - spawned > FRESH then
		return
	end
	if not model.PrimaryPart then
		return
	end
	local tierValue = model:GetAttribute("Tier")
	local tier = if type(tierValue) == "number" then tierValue else 1
	local target = model:GetPivot()
	local okScale, baseScale = pcall(model.GetScale, model)
	if not okScale or type(baseScale) ~= "number" then
		baseScale = 1
	end
	-- Room under the shelf board (or roof) above decides between a hop in and a drop.
	local plot = watched
	local heightValue = model:GetAttribute("Height")
	local height = if type(heightValue) == "number" then heightValue else 5
	local ceiling = boardAbove(plot, target.Position)
	local peak: number? = if ceiling then math.clamp(ceiling - (target.Position.Y + height) - 0.2, 0, HOP_PEAK) else nil
	-- Hide it right away (tiny, at the start of its move) while we decide the timing.
	Animator.hold(model)
	safeScale(model, baseScale * START_SCALE)
	model:PivotTo(if peak then target * CFrame.new(0, 0, -HOP_FORWARD) else target * CFrame.new(0, DROP_HEIGHT, 0))
	task.delay(DECIDE_DELAY, function()
		if not model.Parent then
			Animator.release(model)
			return
		end
		local now = os.clock()
		local startAt = math.max(now, lastDropStart + STAGGER, rowReadyAt(plot, target.Position))
		local quiet = false
		local flight = if peak then HOP else FALL
		for _, pending in pendingMerges do
			if (pending.pos - target.Position).Magnitude < 3 and pending.impact > now - 0.2 then
				startAt = math.max(now, pending.impact - flight)
				quiet = true -- the merge boom covers it
				break
			end
		end
		lastDropStart = math.max(lastDropStart, startAt)
		arrive(model, target, baseScale, startAt, tier, quiet, peak)
	end)
end

-- Merge -------------------------------------------------------------------------------

local lastMergeAt = 0
local lastBoom = 0
local lastImpact = 0
local chainIndex = 0
local chainTotal = 0

local function impactFx(pos: Vector3, tier: number, auto: boolean, boost: number?, pitch: number?)
	local color = tierColor(tier)
	local k = (if auto then 0.55 else 1 + math.min(tier, 25) * 0.03) * (boost or 1)
	-- Soft tier-tinted puff.
	puff(pos, color:Lerp(WHITE, 0.45), 1.2, 5.5 * k, 0.35, 0.35)
	-- Floor ring.
	ring(pos - Vector3.new(0, CHEST_HEIGHT - 0.3, 0), color:Lerp(WHITE, 0.25), 2, 16 * k, 0.5, 0.3)
	if not auto then
		ring(pos, WHITE, 1.5, 10 * k, 0.35, 0.45)
	end
	burst(pos, color, if auto then 12 else 28, { speed = NumberRange.new(8, 18), size = 0.8, gravity = 14 })
	if not auto then
		burst(pos, WHITE, 10, { speed = NumberRange.new(4, 9), size = 1.2, life = NumberRange.new(0.3, 0.6), gravity = 0 })
	end
	local now = os.clock()
	if now - lastBoom > 0.12 then
		lastBoom = now
		if auto then
			Sounds.play("MergeBoom", 0.08, 1.35 * (pitch or 1))
		else
			Sounds.play("MergeBoom", 0.05, (1.1 - math.min(tier, 25) * 0.012) * (pitch or 1))
		end
	end
	if not auto and playerNear(pos, NEAR_PLOT) then
		Camera.punch((0.35 + math.min(tier, 25) * 0.035) * math.min(boost or 1, 2) * PUNCH_SCALE)
	end
end

-- One quick fusion pop in a cascade: a soft bubble, ring, sparks, rising pitch.
local function cascadePop(pos: Vector3, tier: number, index: number, total: number, auto: boolean)
	local color = tierColor(tier)
	local grow = 0.6 + 0.8 * (index / total)
	local bubble = fxPart(Enum.PartType.Ball, Vector3.one * 0.6, CFrame.new(pos), color:Lerp(WHITE, 0.5), 0.3)
	tween(bubble, 0.15, { Size = Vector3.one * 2.6 * grow }, Enum.EasingStyle.Back)
	task.delay(0.15, function()
		tween(bubble, 0.2, { Size = Vector3.one * 0.6, Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	cleanup(bubble, 0.4)
	ring(pos, color:Lerp(WHITE, 0.25), 1, 6 * grow, 0.3, 0.35)
	burst(pos, color, if auto then 6 else 10, { speed = NumberRange.new(6, 12), size = 0.55 * grow, gravity = 6 })
	Sounds.play("BuyPop", 0.02, 0.9 + index * 0.11)
	if not auto and playerNear(pos, NEAR_PLOT) then
		Camera.shake((0.05 + 0.1 * grow) * PUNCH_SCALE, 0.15)
	end
end

-- The "xN MERGES!" world text. Its part carries the text in the attribute
-- Shelf.MERGES_ATTRIBUTE: UI.Popups hides the text while a discovery reveal is up and shows
-- the same line on the reveal, and finds it by that attribute.
local MERGES_ATTRIBUTE = "MergesText"
Shelf.MERGES_ATTRIBUTE = MERGES_ATTRIBUTE

local function mergesText(pos: Vector3, count: number, color: Color3, scale: number, life: number)
	Orbs.text(pos, "x" .. count .. " MERGES!", color, { scale = scale, rise = 4, life = life, tag = MERGES_ATTRIBUTE })
end

-- Big finish for a batch: a wide soft ring, palette confetti, "xN MERGES!".
local function cascadeFinale(chest: Vector3, tier: number, count: number, auto: boolean)
	local size = math.clamp(math.log(math.max(count, 2), 2) / 3, 0.6, 1.6)
	impactFx(chest, tier, auto, 1 + size * 0.6, 0.9)
	local color = tierColor(tier)
	local feet = chest - Vector3.new(0, CHEST_HEIGHT - 0.25, 0)
	task.delay(0.08, function()
		ring(feet, WHITE, 3, 26 * size, 0.6, 0.4)
	end)
	-- Confetti in the world palette, tossed up and drifting down.
	for i, confetti in CONFETTI do
		task.delay(0.03 * i, function()
			burst(chest + Vector3.new(0, 0.5, 0), confetti, if auto then 4 else 8, {
				speed = NumberRange.new(10, 20),
				size = 0.7,
				life = NumberRange.new(0.8, 1.3),
				spread = 50,
				gravity = 16,
				drag = 2,
			})
		end)
	end
	mergesText(chest + Vector3.new(0, 3.5, 0), count, color:Lerp(WHITE, 0.25), 1.4 + size * 0.6, 1.6)
	if not auto and playerNear(chest, NEAR_PLOT) then
		Camera.punch((0.9 + size * 0.4) * PUNCH_SCALE)
	end
end

local function soulOrbs(from: Vector3, to: Vector3, color: Color3, startAt: number, duration: number, auto: boolean)
	local count = if auto then 2 else 3
	local start = from + Vector3.new(0, 2.5, 0)
	-- Puff where the unit dissolved.
	task.delay(math.max(0, startAt - os.clock()), function()
		burst(start, color, if auto then 5 else 10, { speed = NumberRange.new(2, 5), size = 0.7, gravity = -4 })
	end)
	for i = 1, count do
		local delay = (i - 1) * 0.06
		local radius = 1.2 + math.random() * 0.8
		local angle0 = (i / count) * math.pi * 2 + math.random()
		local rise = 3.5 + math.random() * 1.5
		local size = (if auto then 0.5 else 0.75) * (1 - (i - 1) * 0.15)
		local orb: Part? = nil
		addJob(function(now: number): boolean
			local t = now - startAt - delay
			if t < 0 then
				return false
			end
			local length = duration - delay
			local p = math.clamp(t / length, 0, 1)
			if not orb then
				-- Soul orbs are aura, the one effect drawn in Neon.
				local part = fxPart(Enum.PartType.Ball, Vector3.one * size, CFrame.new(start), color, 0, Enum.Material.Neon)
				local a0 = Instance.new("Attachment")
				a0.Position = Vector3.new(0, size * 0.45, 0)
				a0.Parent = part
				local a1 = Instance.new("Attachment")
				a1.Position = Vector3.new(0, -size * 0.45, 0)
				a1.Parent = part
				local trail = Instance.new("Trail")
				trail.Attachment0 = a0
				trail.Attachment1 = a1
				trail.Color = ColorSequence.new(WHITE, color)
				trail.LightEmission = SPARKLE_EMISSION
				trail.Lifetime = 0.22
				trail.Transparency = NumberSequence.new(0.3, 1)
				trail.FaceCamera = true
				trail.Parent = part
				orb = part
			end
			local part = orb :: Part
			if p >= 1 then
				part:Destroy()
				return true
			end
			local e = easeInOut(p)
			local center = start:Lerp(to, e) + Vector3.new(0, math.sin(p * math.pi) * rise, 0)
			local angle = angle0 + p * math.pi * 5
			local r = radius * (1 - e) + 0.05
			local offset = Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
			part.CFrame = CFrame.new(center + offset)
			part.Size = Vector3.one * size * (1 + 0.6 * math.sin(p * math.pi))
			return false
		end)
	end
end

-- Overflow merges (the rack was full) --------------------------------------------------

local FULL_FLOAT_GAP = 1 -- seconds between "FULL! AUTO-MERGED" floats
local OVERFLOW_PULSE = 0.4 -- the consumed spots pulse this long before their aura flies
local lastFullFloat = -math.huge
local fullPending = 0 -- merges waiting for the next float
local fullFloatQueued = false

-- One short float per FULL_FLOAT_GAP; merges arriving in between are added to it.
local function fullFloat(pos: Vector3, count: number)
	fullPending += count
	if fullFloatQueued then
		return
	end
	fullFloatQueued = true
	task.delay(math.max(0, lastFullFloat + FULL_FLOAT_GAP - os.clock()), function()
		fullFloatQueued = false
		lastFullFloat = os.clock()
		local n = fullPending
		fullPending = 0
		local text = if n >= 2 then "FULL! AUTO-MERGED x" .. n else "FULL! AUTO-MERGED"
		Orbs.text(pos, text, worldColor("Sunny", WHITE), { scale = 1.25, rise = 3, life = 1.4 })
	end)
end

-- A soft double pulse at a consumed unit's spot (it swells twice, then shrinks away).
local function spotPulse(pos: Vector3, color: Color3, at: number)
	task.delay(math.max(0, at - os.clock()), function()
		local chest = pos + Vector3.new(0, CHEST_HEIGHT * 0.8, 0)
		local bubble = fxPart(Enum.PartType.Ball, Vector3.one * 0.8, CFrame.new(chest), color:Lerp(WHITE, 0.45), 0.4)
		tween(bubble, 0.12, { Size = Vector3.one * 2.4 }, Enum.EasingStyle.Back)
		task.delay(0.12, function()
			tween(bubble, 0.1, { Size = Vector3.one * 1.6 })
		end)
		task.delay(0.22, function()
			tween(bubble, 0.12, { Size = Vector3.one * 2.7 }, Enum.EasingStyle.Back)
		end)
		task.delay(0.34, function()
			tween(bubble, 0.16, { Size = Vector3.one * 0.4, Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
		cleanup(bubble, 0.55)
	end)
end

-- The light "rack full" moment: spots pulse, their aura flies together, a soft fusion at
-- the new unit and a rate-limited float. Queues behind other merges like any merge.
local function onOverflow(data: { [string]: any }, target: Vector3, fromTier: number, toTier: number, count: number)
	local now = os.clock()
	local startAt = math.max(now, lastMergeAt + MERGE_STAGGER)
	local flyAt = startAt + OVERFLOW_PULSE
	local impact = flyAt + CHARGE_AUTO
	lastMergeAt = flyAt
	local pending = { pos = target, impact = impact }
	table.insert(pendingMerges, pending)
	task.delay(impact - now + 0.5, function()
		local index = table.find(pendingMerges, pending)
		if index then
			table.remove(pendingMerges, index)
		end
	end)
	local chest = target + Vector3.new(0, CHEST_HEIGHT, 0)
	local color = tierColor(fromTier)
	if type(data.from) == "table" then
		for index, pos in data.from do
			if typeof(pos) == "Vector3" and index <= 4 then
				spotPulse(pos, color, startAt)
				soulOrbs(pos, chest, color, flyAt, CHARGE_AUTO, true)
			end
		end
	end
	task.delay(startAt - now, function()
		Sounds.play("BuyPop", 0.03, 0.7)
	end)
	task.delay(impact - now, function()
		impactFx(chest, toTier, true, 1.1, 1.1)
		ring(target + Vector3.new(0, 0.15, 0), worldColor("Sunny", WHITE), 1.5, 9, 0.45, 0.35)
		fullFloat(chest + Vector3.new(0, 2.5, 0), count)
	end)
end

local function onMerge(data: { [string]: any })
	local from = data.from
	local to = data.to
	local auto = data.auto == true
	local fromTier = tonumber(data.fromTier) or 1
	local toTier = tonumber(data.toTier) or (fromTier + 1)
	if typeof(to) ~= "Vector3" then
		if type(from) == "table" and #from > 0 then
			local sum = Vector3.zero
			for _, v in from do
				sum += v
			end
			to = sum / #from
		else
			-- Legacy effect without positions: nothing to show in 3D.
			Sounds.play("MergeBoom", 0.05, if auto then 1.35 else 1)
			return
		end
	end
	local target: Vector3 = to
	local count = math.max(1, math.floor(tonumber(data.count) or 1))
	if data.overflow == true then
		onOverflow(data, target, fromTier, toTier, count)
		return
	end
	local summary = data.summary == true
	local now = os.clock()
	local queued = lastMergeAt + MERGE_STAGGER > now
	local startAt = math.max(now, lastMergeAt + MERGE_STAGGER)
	local duration = if auto then CHARGE_AUTO else CHARGE
	local impactAt = startAt + duration
	-- Batched merges: cascade of pops before the final boom.
	local pops = if summary or count >= 4 then math.clamp(if summary then count else count - 1, 3, 8) else 0
	local gaps = 0
	for i = 1, pops do
		gaps += math.max(0.06, 0.14 - i * 0.012)
	end
	local impact = impactAt + gaps
	lastMergeAt = if pops > 0 then impact - duration else startAt
	if queued then
		chainIndex += 1
		chainTotal += count
	else
		chainIndex = 0
		chainTotal = count
	end
	local myChain = chainIndex
	table.insert(pendingMerges, { pos = target, impact = impact })
	task.delay(impact - now + 0.5, function()
		for i, pending in pendingMerges do
			if pending.impact == impact and pending.pos == target then
				table.remove(pendingMerges, i)
				break
			end
		end
	end)

	local chest = target + Vector3.new(0, CHEST_HEIGHT, 0)
	local color = tierColor(fromTier)
	if type(from) == "table" then
		for index, pos in from do
			if typeof(pos) == "Vector3" and index <= 4 then
				soulOrbs(pos, chest, color, startAt, duration, auto)
			end
		end
	end
	task.delay(startAt - now, function()
		if not auto then
			Sounds.play("MergeCharge", 0.05, 1 + math.min(toTier, 25) * 0.01)
		end
	end)
	if pops > 0 then
		local at = impactAt
		for i = 1, pops do
			local p = (i - 1) / math.max(1, pops - 1)
			local tierAt = math.floor(fromTier + (toTier - 1 - fromTier) * p + 0.5)
			local popPos = chest + Vector3.new(math.cos(i * 2.4) * 0.8, (i - 1) * 0.35, math.sin(i * 2.4) * 0.8)
			task.delay(at - now, function()
				cascadePop(popPos, tierAt, i, pops, auto)
			end)
			at += math.max(0.06, 0.14 - i * 0.012)
		end
		task.delay(impact - now, function()
			cascadeFinale(chest, toTier, count, auto)
		end)
		lastImpact = impact
		chainTotal = 0
		return
	end
	task.delay(impact - now, function()
		impactFx(chest, toTier, auto, nil, 1 + math.min(myChain, 6) * 0.06)
		if count >= 2 then
			Orbs.text(chest + Vector3.new(0, 2.5, 0), "x" .. count, tierColor(toTier), { scale = 0.9, rise = 2.5 })
		end
	end)
	lastImpact = impact
	-- When a chain of step merges ends, show its running total.
	task.delay(impact - now + 0.25, function()
		if lastImpact == impact and chainTotal >= 3 then
			mergesText(chest + Vector3.new(0, 4, 0), chainTotal, tierColor(toTier):Lerp(WHITE, 0.25), 1.6, 1.5)
			chainTotal = 0
		end
	end)
end

-- Shelf glow: tier discs under every unit, hero treatment for the best one ------------------

local RUNES = 14
local MAX_DISCS = Economy.DISPLAY_SLOTS or 100
local DISC_REFRESH = 12 -- units whose disc position is re-read per frame (round-robin)
local DISC_GROW = 0.35 -- seconds a new disc takes to pop in
local DISC_ALPHA = 0.74 -- resting transparency of a non-hero disc
-- Disc radius range: a disc stays on its 4-stud-deep board and clear of its neighbours.
local DISC_RADIUS = NumberRange.new(1.2, 1.8)
local HERO_RING_MAX = 1.95 -- the hero's tile ring stays on the board too
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)
local HIDDEN = CFrame.new(0, -10000, 0)

type Deco = {
	disc: Part,
	tier: number,
	color: Color3,
	radius: number,
	floorOffset: number, -- pivot Y minus the model's bottom
	pos: Vector3?, -- last known floor point under the unit
	shownAt: number,
	phase: number,
	measured: boolean,
	dirty: boolean, -- position or size changed since the disc was last placed
	index: number, -- position in decoOrder
}

local decos: { [Model]: Deco } = {}
local decoOrder: { Model } = {}
local decoCursor = 1
local decoCount = 0
local unitsFolder: Instance? = nil
local hero: Model? = nil
local heroSince = 0
local heroBurstDone = false
local glowWarned = false
local heroRunes: { Part } = {}
local heroBeam: Beam? = nil
local heroEmitPart: Part? = nil
local heroEmitter: ParticleEmitter? = nil
local heroColorSet: Color3? = nil -- colour last given to the hero's beam and sparkles
local glowParts: { BasePart } = {}
local glowCFrames: { CFrame } = {}

local function modelTier(model: Model): number
	local value = model:GetAttribute("Tier")
	return if type(value) == "number" then value else 1
end

local function measure(model: Model, deco: Deco)
	local ok, cf, size = pcall(model.GetBoundingBox, model)
	if not ok then
		return
	end
	local pivot = model:GetPivot()
	deco.floorOffset = pivot.Position.Y - (cf.Position.Y - size.Y / 2)
	deco.radius = math.clamp(math.max(size.X, size.Z) * 0.55, DISC_RADIUS.Min, DISC_RADIUS.Max)
	deco.measured = true
	deco.dirty = true
end

local function removeDeco(model: Model)
	local deco = decos[model]
	if deco then
		deco.disc:Destroy()
		decos[model] = nil
		decoCount -= 1
		local last = decoOrder[#decoOrder]
		decoOrder[deco.index] = last
		local lastDeco = decos[last]
		if lastDeco then
			lastDeco.index = deco.index
		end
		decoOrder[#decoOrder] = nil
	end
end

local function addDeco(model: Instance)
	if not model:IsA("Model") or decos[model] or decoCount >= MAX_DISCS then
		return
	end
	local tier = modelTier(model)
	local color = tierColor(tier)
	local disc = fxPart(Enum.PartType.Cylinder, Vector3.new(0.05, 0.1, 0.1), HIDDEN, color, DISC_ALPHA)
	disc.Name = "TierDisc"
	table.insert(decoOrder, model)
	decos[model] = {
		disc = disc,
		tier = tier,
		color = color,
		radius = 2,
		floorOffset = 0,
		pos = nil,
		shownAt = 0,
		phase = math.random() * 6,
		measured = false,
		dirty = false,
		index = #decoOrder,
	}
	decoCount += 1
	model:GetAttributeChangedSignal("Tier"):Connect(function()
		local deco = decos[model]
		if deco then
			deco.tier = modelTier(model)
			deco.color = tierColor(deco.tier)
			deco.disc.Color = deco.color
			deco.measured = false
		end
	end)
end

local function ensureHeroParts()
	if #heroRunes > 0 and heroEmitPart and heroEmitPart.Parent then
		return
	end
	table.clear(heroRunes)
	for i = 1, RUNES do
		local rune = fxPart(Enum.PartType.Block, Vector3.new(0.2, 0.12, 0.6), HIDDEN, WHITE, 0.25)
		rune.Name = "HeroRune" .. i
		heroRunes[i] = rune
	end
	local emitPart = fxPart(Enum.PartType.Block, Vector3.new(3, 0.1, 3), HIDDEN, WHITE, 1)
	emitPart.Name = "HeroSparkles"
	-- Ground-up haze: a faint tier-coloured column, painted rather than glowing,
	-- that fades out well before head height so the hero model always reads clearly.
	local a0 = Instance.new("Attachment")
	a0.Parent = emitPart
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 5.5, 0) -- below the shelf above
	a1.Parent = emitPart
	local beam = Instance.new("Beam")
	beam.Name = "HeroBeam"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.FaceCamera = true
	beam.LightEmission = 0
	beam.LightInfluence = 0.6
	beam.Segments = 8
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.78),
		NumberSequenceKeypoint.new(0.35, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Parent = emitPart
	heroBeam = beam
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE
	emitter.LightEmission = SPARKLE_EMISSION
	emitter.Rate = 6
	emitter.Lifetime = NumberRange.new(1.2, 2)
	emitter.Speed = NumberRange.new(1.5, 3.5)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(12, 12)
	emitter.Acceleration = Vector3.new(0, 1.5, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, 0.45),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Parent = emitPart
	heroEmitPart, heroEmitter = emitPart, emitter
	heroColorSet = nil
end

local function hideHero()
	for _, rune in heroRunes do
		rune.CFrame = HIDDEN
	end
	if heroEmitPart then
		heroEmitPart.CFrame = HIDDEN
	end
	if heroEmitter then
		heroEmitter.Enabled = false
	end
end

local function pickHero()
	local best: Model? = nil
	local bestTier = -1
	for model, deco in decos do
		if model.Parent and (deco.tier > bestTier or (deco.tier == bestTier and model == hero)) then
			best, bestTier = model, deco.tier
		end
	end
	if best ~= hero then
		local old = hero
		if old then
			Animator.setHero(old, false)
			local oldDeco = decos[old]
			if oldDeco then
				oldDeco.dirty = true
				oldDeco.disc.Transparency = DISC_ALPHA
			end
		end
		hero = best
		heroSince = os.clock()
		heroBurstDone = false
		if best then
			Animator.setHero(best, true)
			ensureHeroParts()
		else
			hideHero()
		end
	end
end

-- Re-reads where a unit stands; marks its disc dirty when it moved (or appeared).
local function refreshDeco(model: Model, deco: Deco, now: number)
	if not model.Parent or Animator.isHeld(model) then
		return
	end
	if not deco.measured then
		measure(model, deco)
	end
	local pivot = model:GetPivot().Position
	local pos = Vector3.new(pivot.X, pivot.Y - deco.floorOffset + 0.08, pivot.Z)
	local old = deco.pos
	if not old then
		deco.shownAt = now
		deco.dirty = true
	elseif (old - pos).Magnitude > 0.02 then
		deco.dirty = true
	end
	deco.pos = pos
end

-- Discs are static: a few units are re-checked per frame and only discs that moved, are
-- popping in or belong to the hero are touched. The hero's ring and haze move every frame.
local function stepGlow()
	if decoCount == 0 then
		return
	end
	local now = os.clock()
	table.clear(glowParts)
	table.clear(glowCFrames)
	local heroModel = hero
	local count = #decoOrder
	for _ = 1, math.min(DISC_REFRESH, count) do
		if decoCursor > count then
			decoCursor = 1
		end
		local model = decoOrder[decoCursor]
		decoCursor += 1
		local deco = decos[model]
		if deco then
			refreshDeco(model, deco, now)
		end
	end
	local heroDeco = heroModel and decos[heroModel]
	if heroDeco and not heroDeco.pos then
		refreshDeco(heroModel :: Model, heroDeco, now)
	end
	for _, model in decoOrder do
		local deco = decos[model]
		local pos = deco and deco.pos
		if not deco or not pos then
			continue
		end
		local isHero = model == heroModel
		local growing = now - deco.shownAt < DISC_GROW + 0.05
		if not (deco.dirty or growing or isHero) then
			continue
		end
		deco.dirty = false
		-- Pop in with a back-eased scale the first time it appears.
		local grow = backOut(math.clamp((now - deco.shownAt) / DISC_GROW, 0, 1))
		local d = math.max(deco.radius * 2 * grow, 0.05)
		deco.disc.Size = Vector3.new(0.05, d, d)
		if isHero then
			deco.disc.Transparency = 0.35 + 0.12 * math.sin(now * 2.2 + deco.phase)
		end
		table.insert(glowParts, deco.disc)
		table.insert(glowCFrames, CFrame.new(pos) * UPRIGHT)
	end
	local heroPos = heroDeco and heroDeco.pos
	if heroDeco and heroPos and heroBeam and heroEmitPart then
		local color = heroDeco.color
		local intro = math.clamp((now - heroSince) / 0.5, 0, 1)
		local r = math.min(heroDeco.radius * 1.35, HERO_RING_MAX) * backOut(intro)
		local spin = now * 0.4
		local seg = (2 * math.pi * r / RUNES) * 0.55
		for i, rune in heroRunes do
			local a = spin + (i - 1) * (2 * math.pi / RUNES)
			local wave = 0.5 + 0.5 * math.sin(now * 2 - i * 0.9)
			rune.Size = Vector3.new(0.22, 0.12 + 0.1 * wave, math.max(seg, 0.1))
			rune.Color = color:Lerp(WHITE, 0.2 + 0.35 * wave)
			rune.Transparency = 0.2 + 0.3 * (1 - wave)
			table.insert(glowParts, rune)
			table.insert(
				glowCFrames,
				CFrame.new(heroPos + Vector3.new(math.cos(a) * r, 0.1 + 0.08 * wave, math.sin(a) * r)) * CFrame.Angles(0, -a, 0)
			)
		end
		local breathe = 0.5 + 0.5 * math.sin(now * 1.3)
		local w = heroDeco.radius * (1.1 + 0.15 * breathe)
		-- The haze eases in with the ring, then breathes gently.
		local ease = 1 - (1 - intro) ^ 2
		if heroColorSet ~= color then
			heroColorSet = color
			heroBeam.Color = ColorSequence.new(color:Lerp(WHITE, 0.2))
			if heroEmitter then
				heroEmitter.Color = ColorSequence.new(WHITE, color)
			end
		end
		heroBeam.Width0 = w * (0.4 + 0.6 * ease)
		heroBeam.Width1 = w * 0.25 * ease
		heroBeam.Brightness = 1
		heroEmitPart.Size = Vector3.new(heroDeco.radius * 1.6, 0.1, heroDeco.radius * 1.6)
		table.insert(glowParts, heroEmitPart)
		table.insert(glowCFrames, CFrame.new(heroPos + Vector3.new(0, 0.3, 0)))
		if heroEmitter and not heroEmitter.Enabled then
			heroEmitter.Enabled = true
		end
		if not heroBurstDone then
			heroBurstDone = true
			burst(heroPos + Vector3.new(0, 2, 0), color, 12, { speed = NumberRange.new(4, 9), size = 0.6, gravity = -2 })
		end
	elseif heroModel then
		hideHero()
	end
	if #glowParts > 0 then
		Workspace:BulkMoveTo(glowParts, glowCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local unitConns: { RBXScriptConnection } = {}

local function bindUnits(units: Instance)
	for _, conn in unitConns do
		conn:Disconnect()
	end
	table.clear(unitConns)
	for model in decos do
		removeDeco(model)
	end
	if hero then
		Animator.setHero(hero, false)
		hero = nil
	end
	hideHero()
	unitsFolder = units
	for _, child in units:GetChildren() do
		addDeco(child)
	end
	pickHero()
	table.insert(
		unitConns,
		units.ChildAdded:Connect(function(child)
			addDeco(child)
			pickHero()
		end)
	)
	table.insert(
		unitConns,
		units.ChildRemoved:Connect(function(child)
			if child:IsA("Model") then
				removeDeco(child)
				if child == hero then
					Animator.setHero(child, false)
					hero = nil
				end
				pickHero()
			end
		end)
	)
end

-- Wiring ------------------------------------------------------------------------------

local watchConn: RBXScriptConnection? = nil

local function watchPlot()
	local plot = ownPlot()
	if not plot or plot == watched then
		return
	end
	if watched == nil then
		settledAt = os.clock() + JOIN_SETTLE
	end
	watched = plot
	Animator.setOwnPlot(plot)
	if watchConn then
		watchConn:Disconnect()
		watchConn = nil
	end
	task.spawn(function()
		local units = plot:WaitForChild("Units", 30)
		if not units or watched ~= plot then
			return
		end
		watchConn = units.ChildAdded:Connect(onUnitAdded)
		bindUnits(units)
		-- Units added while we were waiting still get their landing.
		for _, child in units:GetChildren() do
			onUnitAdded(child)
		end
	end)
end

function Shelf.init()
	if started then
		return
	end
	started = true
	RunService.RenderStepped:Connect(runJobs)
	RunService.Heartbeat:Connect(function()
		local ok, err = pcall(stepGlow)
		if not ok and not glowWarned then
			glowWarned = true
			warn("[Fx.Shelf] glow: " .. tostring(err))
		end
	end)
	-- Tier changes on reused models can change the best unit.
	task.spawn(function()
		while true do
			task.wait(1)
			if unitsFolder and unitsFolder.Parent then
				pickHero()
			end
		end
	end)
	Net.event("Effect").OnClientEvent:Connect(function(kind: string, data: any)
		if kind == "Merge" and type(data) == "table" then
			onMerge(data)
		end
	end)
	State.changed.Event:Connect(watchPlot)
	watchPlot()
	task.spawn(function()
		if Workspace:WaitForChild("Map", 60) then
			bindRacks()
		end
	end)
end

return Shelf
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="235">
            <Properties>
              <string name="Name">Sprites</string>
              <string name="Source"><![CDATA[--[[
	Fx.Sprites: the Blender-rendered effect sprites (Assets.Images "vfx/<Name>").

	  Heart, StarPop, CoinSpin   full colour (leave the tint white)
	  Sparkle, SoftDot, Ring,    white: tint them with the effect colour
	  Puff, Confetti, Note
	  Sweat                      light blue

	Sprites.image(name) returns the image id ("Heart" or "vfx/Heart"), or nil when
	the asset is missing (not uploaded, rejected, or the Assets module failed to
	load). Every caller keeps its own code-drawn fallback for that case.

	Sprites.emitter(parent, name, props) makes a ParticleEmitter with the sprite and
	calm defaults: Rate 0 (call :Emit), LightEmission 0 (the sprite's paint, no
	glow), grow-then-shrink size, fade out, LockedToPart off. `props` overrides
	any emitter property.

	Sprites.billboard(parent, name, opts) is a one-off sprite pop in the world: it
	scales in (Back out), drifts by `rise`, fades and cleans itself up.

	Sprites.room() is false while the live billboard count is at the device's
	budget (Fx.Budget: 24 on low, 48 on mid, unlimited on high); decorative pops
	check it and skip, gameplay feedback ignores it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Budget = require(script.Parent.Budget)

local Sprites = {}

local ROOM: { [string]: number } = { low = 24, mid = 48, high = math.huge }
local live = 0 -- billboards currently in the world

local WHITE = Color3.new(1, 1, 1)

-- Assets.Images, looked up once; nil when the generated module is missing or fails.
local images: { [string]: string }? = nil
local loaded = false

local function imageTable(): { [string]: string }?
	if not loaded then
		loaded = true
		local shared = ReplicatedStorage:FindFirstChild("Shared")
		local module = shared and shared:FindFirstChild("Assets")
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module :: any)
			if ok and type(result) == "table" and type((result :: any).Images) == "table" then
				images = (result :: any).Images
			end
		end
	end
	return images
end

-- The image id of sprite `name` ("Heart" or "vfx/Heart"), or nil when missing.
function Sprites.image(name: string): string?
	local list = imageTable()
	if not list then
		return nil
	end
	local key = if string.find(name, "/", 1, true) then name else "vfx/" .. name
	local id = list[key]
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

-- A ParticleEmitter showing sprite `name` under `parent` (nil when the sprite is
-- missing). Defaults: no glow, no sustained rate, 0.6-1 s lives, a soft
-- grow-then-shrink size of about `props.Size` studs, fade out, random spin.
function Sprites.emitter(parent: Instance, name: string, props: { [string]: any }?): ParticleEmitter?
	local id = Sprites.image(name)
	if not id then
		return nil
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sprite" .. (string.gsub(name, "^vfx/", ""))
	emitter.Texture = id
	emitter.Rate = 0
	emitter.LightEmission = 0
	emitter.LightInfluence = 0
	emitter.LockedToPart = false
	emitter.Orientation = Enum.ParticleOrientation.FacingCamera
	emitter.Color = ColorSequence.new(WHITE)
	emitter.Lifetime = NumberRange.new(0.6, 1)
	emitter.Speed = NumberRange.new(2, 4)
	emitter.Drag = 3
	emitter.SpreadAngle = Vector2.new(35, 35)
	emitter.Rotation = NumberRange.new(-180, 180)
	emitter.RotSpeed = NumberRange.new(-40, 40)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.15, 0.6),
		NumberSequenceKeypoint.new(0.7, 0.5),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.6, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	if props then
		for key, value in props do
			(emitter :: any)[key] = value
		end
	end
	-- A sustained rate follows the device budget (bursts: callers use Budget.count).
	emitter.Rate *= Budget.scale()
	emitter.Parent = parent
	return emitter
end

export type BillboardOptions = {
	position: Vector3, -- world start point
	size: number?, -- studs (default 1.1)
	rise: Vector3?, -- world offset travelled over the life (default 3 studs up)
	life: number?, -- seconds from appearing to gone (default 1.5, at most 2)
	delay: number?, -- seconds before it appears
	color: Color3?, -- tint (white keeps the sprite's own colours)
	spin: number?, -- degrees turned over the life
	maxDistance: number?, -- studs (default 80)
}

-- True while there is budget left for another decorative billboard on this device.
function Sprites.room(): boolean
	return live < ROOM[Budget.tier()]
end

-- A one-off sprite at `opts.position` on an attachment under `parent` (a part):
-- scales in, drifts by `rise` (Quad out), fades over the last 40% and is destroyed.
-- Returns the BillboardGui, or nil when the sprite is missing.
function Sprites.billboard(parent: BasePart, name: string, opts: BillboardOptions): BillboardGui?
	local id = Sprites.image(name)
	if not id then
		return nil
	end
	local life = math.min(opts.life or 1.5, 2)
	local delay = opts.delay or 0
	local size = opts.size or 1.1
	local rise = opts.rise or Vector3.new(0, 3, 0)
	local frame = parent.CFrame
	local start = frame:PointToObjectSpace(opts.position)

	local attachment = Instance.new("Attachment")
	attachment.Name = "SpritePop"
	attachment.Position = start
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(size, size)
	gui.LightInfluence = 0
	gui.MaxDistance = opts.maxDistance or 80
	gui.Adornee = attachment
	gui.Parent = attachment
	local scale = Instance.new("UIScale")
	scale.Scale = 0
	scale.Parent = gui
	local image = Instance.new("ImageLabel")
	image.Name = "Sprite"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = id
	image.ImageColor3 = opts.color or WHITE
	image.ScaleType = Enum.ScaleType.Fit
	image.Rotation = (math.random() - 0.5) * 24
	image.Parent = gui
	attachment.Parent = parent
	live += 1

	local function play(target: Instance, info: TweenInfo, goal: { [string]: any })
		TweenService:Create(target, info, goal):Play()
	end
	play(scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delay), { Scale = 1 })
	play(
		attachment,
		TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay),
		{ Position = start + frame:VectorToObjectSpace(rise) }
	)
	if opts.spin then
		play(
			image,
			TweenInfo.new(life, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, false, delay),
			{ Rotation = image.Rotation + opts.spin }
		)
	end
	play(
		image,
		TweenInfo.new(life * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, delay + life * 0.6),
		{ ImageTransparency = 1 }
	)
	task.delay(delay + life + 0.05, function()
		live -= 1
		attachment:Destroy()
	end)
	return gui
end

return Sprites
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="236">
            <Properties>
              <string name="Name">Surge</string>
              <string name="Source"><![CDATA[--[[
	Fx.Surge: the "golden hour hype" mood while an Aura Surge is on (x2 aura).

	The surge is a fixed slice of a server-time cycle (Economy.surgeState), so the
	look is a pure function of the server clock: a player who joins mid-surge gets
	the full look at once, and one who joins in the last second before the end
	sees it fade out like everyone else.

	While the surge look is up the client adds its own post-effects to Lighting
	(the server's ColorCorrection / Bloom / SunRays are left untouched):
	  SurgeGrade  ColorCorrectionEffect: warm peach-gold tint, more saturation
	              (with a slow, small 2.2 s pulse), a little contrast and brightness
	  SurgeBloom  BloomEffect: a soft, wide bloom on the brightest surfaces only
	  SurgeRays   SunRaysEffect: a faint sun glow
	plus large, soft gold sparkles drifting up over the local player's plot (their
	rate scaled by Fx.Budget on phones). The
	look eases in over FADE_IN seconds and out over FADE_OUT seconds, after which
	every instance is removed. No flashing: every value moves smoothly.

	It also sets the music mood (Sounds.setMood("surge") / nil) for as long as the
	surge lasts.

	The module's top level stays free of requires so the tests can load the pure
	helpers (Surge.weight, Surge.grade) without Roblox services.
]]

local Surge = {}

Surge.FADE_IN = 1.2
Surge.FADE_OUT = 1.5
Surge.PULSE_PERIOD = 2.2

-- Full-strength grade values (scaled by the surge weight).
Surge.TINT_RGB = { 255, 232, 196 }
Surge.SATURATION = 0.25
Surge.SATURATION_PULSE = 0.05
Surge.CONTRAST = 0.08
Surge.BRIGHTNESS = 0.02
Surge.BLOOM_INTENSITY = 0.3
Surge.RAYS_INTENSITY = 0.04

local function smooth(x: number): number
	local s = math.clamp(x, 0, 1)
	return s * s * (3 - 2 * s)
end

-- Strength of the surge look (0..1) from Economy.surgeState's (active, left) and the
-- surge timing: eases in over FADE_IN after the surge starts and out over FADE_OUT
-- after it ends.
function Surge.weight(active: boolean, left: number, duration: number, cycle: number): number
	if active then
		return smooth((duration - left) / Surge.FADE_IN)
	end
	local sinceEnd = (cycle - duration) - left
	return 1 - smooth(sinceEnd / Surge.FADE_OUT)
end

export type Grade = {
	tint: number, -- 0..1 blend from white toward TINT_RGB
	saturation: number,
	contrast: number,
	brightness: number,
	bloom: number,
	rays: number,
	sparkles: number, -- 0..1 share of the full sparkle rate
}

-- The post-effect values for surge weight `weight` at clock time `clock` (seconds).
function Surge.grade(weight: number, clock: number): Grade
	local pulse = math.sin(clock * 2 * math.pi / Surge.PULSE_PERIOD)
	return {
		tint = weight,
		saturation = weight * (Surge.SATURATION + Surge.SATURATION_PULSE * pulse),
		contrast = weight * Surge.CONTRAST,
		brightness = weight * Surge.BRIGHTNESS,
		bloom = weight * Surge.BLOOM_INTENSITY,
		rays = weight * Surge.RAYS_INTENSITY,
		sparkles = weight,
	}
end

-- Runtime ------------------------------------------------------------------------------

local SPARKLE_RATE = 2.5
local DOT_RATE = 1.5

function Surge.init()
	local Lighting = game:GetService("Lighting")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")

	local Economy = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Economy")) :: any
	local State = require(script.Parent.Parent.State) :: any
	local Sounds = require(script.Parent.Parent.Sounds) :: any
	local Sprites = require(script.Parent.Sprites) :: any
	local Budget = require(script.Parent.Budget) :: any

	local WHITE = Color3.new(1, 1, 1)
	local TINT = Color3.fromRGB(Surge.TINT_RGB[1], Surge.TINT_RGB[2], Surge.TINT_RGB[3])

	local grade: ColorCorrectionEffect? = nil
	local bloom: BloomEffect? = nil
	local rays: SunRaysEffect? = nil
	local sparkPart: BasePart? = nil
	local emitters: { [ParticleEmitter]: number } = {} -- emitter -> full rate
	local sparkPlot: number? = nil
	local nextSparkTry = 0
	local mood: string? = nil

	-- Stops new sparkles; the ones in the air finish their drift before the box goes.
	local function clearSparkles()
		local part = sparkPart
		if part then
			for emitter in emitters do
				emitter.Rate = 0
			end
			task.delay(6, function()
				part:Destroy()
			end)
		end
		sparkPart = nil
		sparkPlot = nil
		table.clear(emitters)
	end

	local function clearEffects()
		if grade then
			grade:Destroy()
		end
		if bloom then
			bloom:Destroy()
		end
		if rays then
			rays:Destroy()
		end
		grade, bloom, rays = nil, nil, nil
		clearSparkles()
	end

	local function ensureEffects()
		if not grade then
			local cc = Instance.new("ColorCorrectionEffect")
			cc.Name = "SurgeGrade"
			cc.Parent = Lighting
			grade = cc
		end
		if not bloom then
			local b = Instance.new("BloomEffect")
			b.Name = "SurgeBloom"
			b.Intensity = 0
			b.Size = 36
			b.Threshold = 1.5
			b.Parent = Lighting
			bloom = b
		end
		if not rays then
			local r = Instance.new("SunRaysEffect")
			r.Name = "SurgeRays"
			r.Intensity = 0
			r.Spread = 0.5
			r.Parent = Lighting
			rays = r
		end
	end

	-- A box over the local player's plot floor that slowly releases gold sparkles.
	local function ensureSparkles(now: number)
		local data = State.data
		local index = data and data.plotIndex
		if sparkPart and sparkPlot == index then
			return
		end
		if now < nextSparkTry then
			return
		end
		nextSparkTry = now + 1
		clearSparkles()
		if type(index) ~= "number" then
			return
		end
		local map = Workspace:FindFirstChild("Map")
		local plot = map and map:FindFirstChild("Plot" .. index)
		local floor = plot and plot:FindFirstChild("Floor", true)
		if not (floor and floor:IsA("BasePart")) then
			return
		end
		local part = Instance.new("Part")
		part.Name = "SurgeSparkles"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = Vector3.new(floor.Size.X * 0.9, 1, floor.Size.Z * 0.9)
		part.CFrame = floor.CFrame * CFrame.new(0, floor.Size.Y / 2 + 1.5, 0)
		local gold = ColorSequence.new(Color3.fromRGB(255, 214, 120), Color3.fromRGB(255, 240, 205))
		local function fadeInOut(peak: number): NumberSequence
			return NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, peak),
				NumberSequenceKeypoint.new(0.75, peak),
				NumberSequenceKeypoint.new(1, 1),
			})
		end
		local function sizeCurve(size: number): NumberSequence
			return NumberSequence.new({
				NumberSequenceKeypoint.new(0, size * 0.4),
				NumberSequenceKeypoint.new(0.3, size),
				NumberSequenceKeypoint.new(1, size * 0.7),
			})
		end
		local common = {
			Shape = Enum.ParticleEmitterShape.Box,
			ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
			EmissionDirection = Enum.NormalId.Top,
			Lifetime = NumberRange.new(4, 6),
			Speed = NumberRange.new(1.2, 2.4),
			Drag = 0.2,
			Acceleration = Vector3.new(0, 0.3, 0),
			SpreadAngle = Vector2.new(20, 20),
			RotSpeed = NumberRange.new(-20, 20),
			Color = gold,
		}
		local function add(name: string, rate: number, size: number, peak: number)
			local props = table.clone(common) :: { [string]: any }
			props.Size = sizeCurve(size)
			props.Transparency = fadeInOut(peak)
			local emitter = Sprites.emitter(part, name, props)
			if emitter then
				emitters[emitter] = rate
			end
		end
		add("Sparkle", SPARKLE_RATE, 1.8, 0.2)
		add("SoftDot", DOT_RATE, 3, 0.55)
		part.Parent = Workspace.CurrentCamera or Workspace
		sparkPart = part
		sparkPlot = index
	end

	RunService.Heartbeat:Connect(function()
		local now = Workspace:GetServerTimeNow()
		local active, left = Economy.surgeState(now)
		local wantMood = if active then "surge" else nil
		if wantMood ~= mood then
			mood = wantMood
			Sounds.setMood(mood)
		end

		local weight = Surge.weight(active, left, Economy.SURGE_DURATION, Economy.SURGE_CYCLE)
		if weight <= 0.001 then
			if grade or sparkPart then
				clearEffects()
			end
			return
		end
		ensureEffects()
		local g = Surge.grade(weight, os.clock())
		local cc = grade :: ColorCorrectionEffect
		cc.TintColor = WHITE:Lerp(TINT, g.tint)
		cc.Saturation = g.saturation
		cc.Contrast = g.contrast
		cc.Brightness = g.brightness
		local b = bloom :: BloomEffect
		b.Intensity = g.bloom
		local r = rays :: SunRaysEffect
		r.Intensity = g.rays

		ensureSparkles(os.clock())
		local budget = Budget.scale() -- fewer drifting sparkles on phones (Fx.Budget)
		for emitter, rate in emitters do
			emitter.Rate = rate * g.sparkles * budget
		end
	end)
end

return Surge
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="237">
          <Properties>
            <string name="Name">Guide</string>
            <string name="Source"><![CDATA[--[[
	Guide: points the player at something on their plot.

	  - a small chevron (BillboardGui, ~2.2 studs, 70% opacity, MaxDistance 120)
	    gently bobbing above the target, tinted with the target pad's colour
	  - an optional small tag on top of it (the "navigate" label, e.g. "CLAIM!")
	  - a trail of flat chevrons on the floor from the player to the target, flowing
	    toward it. It follows a walkable route: round the pen's corner posts, and over
	    the pen's side stairs when the target (or the player) is inside the pen. During
	    the tutorial it is always shown; for a "navigate" request only while the player
	    is far away (> TRAIL_DISTANCE studs) or has been standing still for IDLE_SECONDS
	  - during the tutorial, a tall soft beam of light over the target (three layered
	    Beams and a thin glowing core, no texture), so the next pad is seen from the spawn

	Everything fades in and out (eased per frame) and stays hidden while the
	intro cutscene plays (Players.LocalPlayer attribute "IntroPlaying").

	Targets are pad names ("Buy1", "Deposit", ...; found as
	workspace.Map.Plot<n>.Pad_<name>) or "Orbs" (the nearest orb in the pen,
	else the middle of the field). Everything is client-only.

	Two sources can ask for a target: the tutorial (persistent) and a short
	"navigate" request (e.g. the Free reward button), which wins while active.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Kit = require(script.Parent.UI.Kit)
local State = require(script.Parent.State)

local World = Kit.Theme.World

local Guide = {}

-- Marker: size in studs, opacity at full fade-in, height above the target's top.
local MARKER_STUDS = 2.2
local MARKER_OPACITY = 0.7
-- Clears the pads' floating labels (World.Pads: about 2.6..6 studs above the top).
local MARKER_HEIGHT = 7
local MARKER_BOB = 0.3
local MAX_DISTANCE = 120
-- Trail: chevron count, spacing along the route, first chevron's distance ahead of the player,
-- and the open floor kept between the last one and the target's edge.
local CHEVRONS = 18
local CHEVRON_SPACING = 3.2
local TRAIL_LEAD = 3
local TRAIL_END_GAP = 0.6
-- One chevron: half its width across the route, tip-to-tail depth, bar width, and the dark
-- rim that shows round each bar (it keeps a pale pad colour readable on the pale floor).
local CHEVRON_HALF = 1.15
local CHEVRON_DEPTH = 1
local CHEVRON_BAR = 0.46
local CHEVRON_RIM = 0.16
-- Studs per second the chevrons travel toward the target.
local CHEVRON_FLOW = 3.4
-- Above the floor paint (World.Decor: its top layer ends 0.12 over the floor).
local CHEVRON_LIFT = 0.15
-- A "navigate" trail shows only from this far, or after standing still this long.
local TRAIL_DISTANCE = 12
local IDLE_SECONDS = 4
-- Route: how close a leg may pass the pen's footprint (a character's half width), and how
-- far off its corners the route turns.
local ROUTE_BODY = 1.2
local ROUTE_TURN = 3
-- Beam of light over the tutorial's target: height, and each layer's width and transparency
-- at the foot (wide and faint to narrow and bright; every layer fades out to the top).
-- It fades away within BEAM_NEAR studs so the pad's own label is not washed out.
local BEAM_HEIGHT = 70
local BEAM_LAYERS = { { width = 7, base = 0.86 }, { width = 4, base = 0.74 }, { width = 1.8, base = 0.5 } }
local BEAM_CORE = 0.5
local BEAM_CORE_OPACITY = 0.4
local BEAM_NEAR = 9
-- Fade speed (per second, exponential ease toward the goal).
local FADE_RATE = 6

type Chevron = { fills: { Part }, rims: { Part }, shown: boolean }
-- The pen as the route sees it, in the frame of its floor (plot axes): the open floor's half
-- size, the footprint's (corner posts included; 0 = none found) and the stairs over the side
-- walls (`outer` / `inner`: how far from the centre line the steps start outside and end inside).
type Stair = { side: number, z: number, outer: number, inner: number }
type Pen = { field: BasePart, frame: CFrame, top: number, inX: number, inZ: number, halfX: number, halfZ: number, stairs: { Stair } }

local folder: Folder
local anchor: Part
local marker: BillboardGui
local markerBars: { Frame } = {}
local tag: BillboardGui
local tagLabel: TextLabel
local tagEdge: UIStroke?
local chevrons: { Chevron } = {}
local trailShown = false
local beams: { Beam } = {}
local beamCore: Part? = nil
local rayParams: RaycastParams? = nil

local pen: Pen? = nil
local penPlot: Instance? = nil
local penLooked = 0

local tutorialTarget: string? = nil
local tutorialText = ""
local navTarget: string? = nil
local navText = ""
local navUntil = 0

local currentPart: BasePart? = nil
local currentName: string? = nil
local lastResolve = 0

-- Eased visibility (0..1) of the marker, the trail and the beam.
local markerAlpha = 0
local trailAlpha = 0
local beamAlpha = 0
local beamPainted = -1
local beamColor: Color3? = nil
local idleFor = 0
local lastRootPos: Vector3? = nil
-- Where the marker floats now (it glides to a new target instead of jumping).
local markerPos: Vector3? = nil

local function plotFolder(): Instance?
	local data = State.data
	local map = Workspace:FindFirstChild("Map")
	if not data or not map or not data.plotIndex then
		return nil
	end
	return map:FindFirstChild("Plot" .. data.plotIndex)
end

local function rootPart(): BasePart?
	local character = Players.LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Reads the pen off the plot's parts (World.Pen: "Field", "PenPost", "PenStep", all built on
-- the plot's axes): the client has no PlotLayout.
local function findPen(plot: Instance): Pen?
	local field = plot:FindFirstChild("Field", true)
	if not field or not field:IsA("BasePart") or not field.Parent then
		return nil
	end
	local frame = field.CFrame
	local halfX, halfZ = 0, 0
	local bySide: { [number]: Stair } = {}
	for _, child in field.Parent:GetChildren() do
		if child:IsA("BasePart") and (child.Name == "PenPost" or child.Name == "PenStep") then
			local at = frame:PointToObjectSpace(child.CFrame.Position)
			local reach, half = math.abs(at.X), child.Size.X / 2
			if child.Name == "PenPost" then
				halfX = math.max(halfX, reach + half)
				halfZ = math.max(halfZ, math.abs(at.Z) + child.Size.Z / 2)
			else
				local side = if at.X < 0 then -1 else 1
				local stair = bySide[side]
				if stair then
					stair.outer = math.max(stair.outer, reach + half)
					stair.inner = math.min(stair.inner, reach - half)
				else
					bySide[side] = { side = side, z = at.Z, outer = reach + half, inner = reach - half }
				end
			end
		end
	end
	local stairs: { Stair } = {}
	for _, stair in bySide do
		table.insert(stairs, stair)
	end
	return {
		field = field,
		frame = frame,
		top = frame.Position.Y + field.Size.Y / 2,
		inX = field.Size.X / 2,
		inZ = field.Size.Z / 2,
		halfX = halfX,
		halfZ = halfZ,
		stairs = stairs,
	}
end

-- The player's plot's pen, looked up once (and again every other second while it is missing
-- or incomplete).
local function currentPen(): Pen?
	local plot = plotFolder()
	if not plot then
		return nil
	end
	local known = pen
	local complete = known ~= nil and plot == penPlot and known.field.Parent ~= nil and known.halfX > 0 and #known.stairs > 0
	if not complete and (plot ~= penPlot or os.clock() - penLooked > 2) then
		penLooked = os.clock()
		penPlot = plot
		pen = findPen(plot)
	end
	return pen
end

-- True when the pen-frame point (x, z) is on the pen's floor (or the inner half of a wall top).
local function inPen(p: Pen, x: number, z: number): boolean
	return math.abs(x) < p.inX + 0.8 and math.abs(z) < p.inZ + 0.8
end

--[[
	Routing, in the pen's frame as Vector2 (x, z). The pen is the one thing on a plot that a
	straight walk between two pads clips (its corner posts) or cannot cross (its walls).
]]

-- True when the leg a-b passes through the box |x| < hx, |z| < hz. Touching an edge is not
-- crossing: the box is taken a hair smaller, as a point put on an edge (pushOut) is stored
-- in single precision and may land just inside it.
local function crosses(a: Vector2, b: Vector2, hx: number, hz: number): boolean
	local t0, t1 = 0, 1
	for axis = 1, 2 do
		local from = if axis == 1 then a.X else a.Y
		local step = if axis == 1 then b.X - a.X else b.Y - a.Y
		local half = (if axis == 1 then hx else hz) - 0.01
		if math.abs(step) < 1e-6 then
			if math.abs(from) >= half then
				return false
			end
		else
			local enter, leave = (-half - from) / step, (half - from) / step
			if enter > leave then
				enter, leave = leave, enter
			end
			t0, t1 = math.max(t0, enter), math.min(t1, leave)
			if t0 >= t1 then
				return false
			end
		end
	end
	return true
end

-- A point inside the box moved to its nearest edge (a character leaning on the pen's wall).
local function pushOut(point: Vector2, hx: number, hz: number): Vector2
	local dx, dz = hx - math.abs(point.X), hz - math.abs(point.Y)
	if dx <= 0 or dz <= 0 then
		return point
	end
	if dx < dz then
		return Vector2.new(if point.X < 0 then -hx else hx, point.Y)
	end
	return Vector2.new(point.X, if point.Y < 0 then -hz else hz)
end

-- The corners to turn at on the shortest walk from a to b round the pen (none when the
-- straight leg is clear), both points outside it. Only its two front corners (-Z, toward
-- the entrance) are used: the gutter and the chute stand behind it.
local function aroundPen(p: Pen, a: Vector2, b: Vector2): { Vector2 }
	if p.halfX <= 0 then
		return {}
	end
	local hx, hz = p.halfX + ROUTE_BODY, p.halfZ + ROUTE_BODY
	a, b = pushOut(a, hx, hz), pushOut(b, hx, hz)
	if not crosses(a, b, hx, hz) then
		return {}
	end
	local tx, tz = p.halfX + ROUTE_TURN, p.halfZ + ROUTE_TURN
	local corners = { Vector2.new(tx, -tz), Vector2.new(-tx, -tz) }
	local best: { Vector2 } = {}
	local bestLength = math.huge
	for i, first in corners do
		if not crosses(a, first, hx, hz) then
			local reach = (first - a).Magnitude
			local second = corners[3 - i]
			if not crosses(first, b, hx, hz) then
				local length = reach + (b - first).Magnitude
				if length < bestLength then
					best, bestLength = { first }, length
				end
			elseif not crosses(second, b, hx, hz) then
				-- Along the front of the pen to its other corner.
				local length = reach + (second - first).Magnitude + (b - second).Magnitude
				if length < bestLength then
					best, bestLength = { first, second }, length
				end
			end
		end
	end
	return best
end

local function pathLength(points: { Vector2 }): number
	local length = 0
	for i = 2, #points do
		length += (points[i] - points[i - 1]).Magnitude
	end
	return length
end

-- The walk from a to b: straight where it can be, round the pen's corners, and over the
-- nearer side stairs when exactly one end is inside the pen.
local function routeInPen(p: Pen, a: Vector2, b: Vector2): { Vector2 }
	local aIn, bIn = inPen(p, a.X, a.Y), inPen(p, b.X, b.Y)
	if aIn and bIn then
		return { a, b }
	end
	if aIn == bIn or #p.stairs == 0 then
		local points = { a }
		table.move(aroundPen(p, a, b), 1, 2, 2, points)
		table.insert(points, b)
		return points
	end
	-- `inner` is the end inside the pen; the route is built outside-in and turned round after.
	local inner, outer = if aIn then a else b, if aIn then b else a
	local best: { Vector2 } = {}
	local bestLength = math.huge
	for _, stair in p.stairs do
		local foot = Vector2.new(stair.side * (stair.outer + 1), stair.z)
		local landing = Vector2.new(stair.side * (stair.inner - 0.6), stair.z)
		local points = { outer }
		table.move(aroundPen(p, outer, foot), 1, 2, 2, points)
		table.insert(points, foot)
		-- Already on these steps (or the target is right at their foot): no step back to the landing.
		local onSteps = stair.side * inner.X >= stair.side * landing.X and math.abs(inner.Y - stair.z) < 2.5
		if not onSteps then
			table.insert(points, landing)
		end
		table.insert(points, inner)
		local length = pathLength(points)
		if length < bestLength then
			best, bestLength = points, length
		end
	end
	if aIn then
		local turned = table.create(#best)
		for i = #best, 1, -1 do
			table.insert(turned, best[i])
		end
		return turned
	end
	return best
end

-- The route from `from` to `to` as flat world points (y = 0), the two ends included.
local function route(from: Vector3, to: Vector3): { Vector3 }
	local p = currentPen()
	if not p then
		return { Vector3.new(from.X, 0, from.Z), Vector3.new(to.X, 0, to.Z) }
	end
	local a, b = p.frame:PointToObjectSpace(from), p.frame:PointToObjectSpace(to)
	local points: { Vector3 } = {}
	for _, point in routeInPen(p, Vector2.new(a.X, a.Z), Vector2.new(b.X, b.Z)) do
		local world = p.frame:PointToWorldSpace(Vector3.new(point.X, 0, point.Y))
		table.insert(points, Vector3.new(world.X, 0, world.Z))
	end
	return points
end

local function resolve(name: string): BasePart?
	local plot = plotFolder()
	if not plot then
		return nil
	end
	if name == "Orbs" then
		local orbs = plot:FindFirstChild("Orbs", true)
		local root = rootPart()
		-- An orb on the pen floor first: one still rolling down the gutter is behind the pen.
		local p = currentPen()
		local best: BasePart? = nil
		local bestDistance = math.huge
		local bestInPen = false
		if orbs and root then
			local from = root.CFrame.Position
			for _, orb in orbs:GetChildren() do
				if orb:IsA("BasePart") then
					local d = (orb.CFrame.Position - from).Magnitude
					local at = if p then p.frame:PointToObjectSpace(orb.CFrame.Position) else nil
					local inside = p ~= nil and at ~= nil and inPen(p, at.X, at.Z)
					if (inside and not bestInPen) or (inside == bestInPen and d < bestDistance) then
						best, bestDistance, bestInPen = orb, d, inside
					end
				end
			end
		end
		if best then
			return best
		end
		return (plot:FindFirstChild("Field", true) or plot:FindFirstChild("Floor", true)) :: BasePart?
	end
	return plot:FindFirstChild("Pad_" .. name, true) :: BasePart?
end

-- The target, its tag text, and whether the tutorial (not a "navigate" request) asked for it.
local function activeTarget(): (string?, string, boolean)
	if navTarget and os.clock() < navUntil then
		return navTarget, navText, false
	end
	navTarget = nil
	return tutorialTarget, tutorialText, true
end

-- The palette colour that matches what the target does.
local function colorFor(name: string): Color3
	local pads = World.Pads
	if name == "Orbs" then
		return World.Pink
	elseif string.sub(name, 1, 3) == "Buy" then
		return pads.Buy
	end
	return pads[name] or World.Sunny
end

local function buildMarker(parent: Instance)
	marker = Kit.new("BillboardGui", {
		Name = "GuideMarker",
		Size = UDim2.fromScale(MARKER_STUDS, MARKER_STUDS),
		StudsOffsetWorldSpace = Vector3.new(0, MARKER_HEIGHT, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = MAX_DISTANCE,
		ResetOnSpawn = false,
		Enabled = false,
		Parent = parent,
	})
	-- A soft downward chevron: two rounded bars meeting at the bottom centre.
	for i, side in { -1, 1 } do
		local bar = Kit.new("Frame", {
			Name = if side < 0 then "Left" else "Right",
			BackgroundColor3 = World.Sunny,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(0.62, 0.24),
			Position = UDim2.fromScale(0.5 + side * 0.19, 0.44),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = side * -40,
			ZIndex = 2,
			Parent = marker,
		})
		Kit.round(bar)
		Kit.new("UIStroke", {
			Name = "Rim",
			Color = World.White,
			Thickness = 1.5,
			Transparency = 1,
			Parent = bar,
		})
		markerBars[i] = bar
	end

	tag = Kit.new("BillboardGui", {
		Name = "GuideTag",
		Size = UDim2.fromOffset(140, 26),
		StudsOffsetWorldSpace = Vector3.new(0, MARKER_HEIGHT + MARKER_STUDS * 0.5 + 0.9, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 60,
		ResetOnSpawn = false,
		Enabled = false,
		Parent = parent,
	})
	tagLabel = Kit.pill(tag, {
		Name = "Label",
		Text = "",
		Color = World.Cream,
		Solid = true,
		TextColor = World.Ink,
		TextSize = 13,
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	tagEdge = tagLabel:FindFirstChild("Edge") :: UIStroke?
end

local function ghost(part: Part, name: string): Part
	part.Name = name
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = folder
	return part
end

-- Each chevron is two glowing bars meeting at the tip, each on a slightly larger dark bar.
local function buildTrail()
	local length = math.sqrt(CHEVRON_DEPTH ^ 2 + CHEVRON_HALF ^ 2) + CHEVRON_BAR * 0.6
	for i = 1, CHEVRONS do
		local chevron: Chevron = { fills = {}, rims = {}, shown = false }
		for side = 1, 2 do
			local rim = ghost(Instance.new("Part"), "GuideChevronRim" .. i)
			rim.Size = Vector3.new(CHEVRON_BAR + CHEVRON_RIM * 2, 0.04, length + CHEVRON_RIM * 2)
			rim.Material = Enum.Material.SmoothPlastic
			rim.Color = World.Ink
			chevron.rims[side] = rim
			local fill = ghost(Instance.new("Part"), "GuideChevron" .. i)
			fill.Size = Vector3.new(CHEVRON_BAR, 0.05, length)
			fill.Material = Enum.Material.Neon
			fill.Color = World.Sunny
			chevron.fills[side] = fill
		end
		chevrons[i] = chevron
	end
end

-- The beam hangs on the marker's anchor, so it glides to a new target with the marker.
-- Optional: an environment without Beams (or Attachments) just has no beam.
local function buildBeam(parent: Instance)
	pcall(function()
		local foot = Instance.new("Attachment")
		foot.Name = "BeamFoot"
		foot.Parent = parent
		local top = Instance.new("Attachment")
		top.Name = "BeamTop"
		top.CFrame = CFrame.new(0, BEAM_HEIGHT, 0)
		top.Parent = parent
		for i in BEAM_LAYERS do
			local beam = Instance.new("Beam")
			beam.Name = "GuideBeam" .. i
			beam.Attachment0 = foot
			beam.Attachment1 = top
			beam.FaceCamera = true
			-- Enough segments for the fade along its height to be smooth.
			beam.Segments = 12
			beam.LightEmission = 0.7
			beam.LightInfluence = 0
			beam.Transparency = NumberSequence.new(1)
			beam.Enabled = false
			beam.Parent = parent
			beams[i] = beam
		end
		local core = ghost(Instance.new("Part"), "GuideBeamCore")
		core.Shape = Enum.PartType.Cylinder
		core.Size = Vector3.new(BEAM_HEIGHT * 0.5, BEAM_CORE, BEAM_CORE)
		core.Material = Enum.Material.Neon
		beamCore = core
	end)
end

function Guide.build()
	folder = Instance.new("Folder")
	folder.Name = "ClientGuide"
	folder.Parent = Workspace

	anchor = Instance.new("Part")
	anchor.Name = "GuideAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Parent = folder

	-- Optional: the preview exporter has no raycasts (the trail then lies at foot level).
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.IgnoreWater = true
		rayParams = params
	end)

	buildMarker(anchor)
	buildTrail()
	buildBeam(anchor)

	local clock = 0
	RunService.Heartbeat:Connect(function(dt)
		clock += dt
		Guide.update(clock, dt)
	end)
end

-- Eases `value` toward `goal`; with no dt (a direct call) it snaps.
local function approach(value: number, goal: number, dt: number?): number
	if not dt then
		return goal
	end
	return value + (goal - value) * (1 - math.exp(-FADE_RATE * dt))
end

local function paintMarker()
	local enabled = markerAlpha > 0.01
	marker.Enabled = enabled
	local fill = 1 - MARKER_OPACITY * markerAlpha
	local rim = 1 - 0.6 * markerAlpha
	for _, bar in markerBars do
		bar.BackgroundTransparency = fill
		local stroke = bar:FindFirstChild("Rim") :: UIStroke?
		if stroke then
			stroke.Transparency = rim
		end
	end
	tag.Enabled = enabled and tagLabel.Text ~= ""
	tagLabel.BackgroundTransparency = 1 - 0.92 * markerAlpha
	tagLabel.TextTransparency = 1 - markerAlpha
	if tagEdge then
		tagEdge.Transparency = 1 - 0.5 * markerAlpha
	end
end

-- The beam at `beamAlpha`, tinted toward `color` and breathing a little. The sequences are
-- rebuilt only when the fade or the colour moved.
local function paintBeam(clock: number, color: Color3)
	local core = beamCore
	if #beams == 0 or not core then
		return
	end
	local on = beamAlpha > 0.01
	if on then
		local breath = 1 + 0.07 * math.sin(clock * 2.4)
		for i, beam in beams do
			local width = BEAM_LAYERS[i].width * breath
			beam.Width0 = width
			beam.Width1 = width * 0.55
		end
		-- The core starts above the pad's labels and the marker.
		local at = anchor.CFrame.Position + Vector3.new(0, MARKER_HEIGHT + 3 + core.Size.X / 2, 0)
		core.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	end
	if color ~= beamColor then
		beamColor = color
		local light = color:Lerp(World.White, 0.35)
		for _, beam in beams do
			beam.Color = ColorSequence.new(light, World.White)
		end
		core.Color = light
	end
	if math.abs(beamAlpha - beamPainted) < 0.01 and on == beams[1].Enabled then
		return
	end
	beamPainted = beamAlpha
	for i, beam in beams do
		beam.Enabled = on
		local foot = 1 - (1 - BEAM_LAYERS[i].base) * beamAlpha
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, foot),
			NumberSequenceKeypoint.new(0.3, foot + (1 - foot) * 0.25),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	core.Transparency = if on then 1 - BEAM_CORE_OPACITY * beamAlpha else 1
end

-- What the trail's ground rays skip: the guide itself, every character and the orbs.
local function refreshRayFilter()
	local params = rayParams
	if not params then
		return
	end
	local ignore: { Instance } = { folder }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	local plot = plotFolder()
	local orbs = plot and plot:FindFirstChild("Orbs", true)
	if orbs then
		table.insert(ignore, orbs)
	end
	params.FilterDescendantsInstances = ignore
end

-- Floor height at the flat point (x, z), looked for between `high` and `low`. Anything
-- taller than a step above `floor` (a prop, a machine) is not floor: the trail stays under it.
local function groundY(x: number, z: number, high: number, low: number, floor: number?): number
	local fallback = floor or low
	local params = rayParams
	if not params then
		return fallback
	end
	local hit = Workspace:Raycast(Vector3.new(x, high + 4, z), Vector3.new(0, low - high - 7, 0), params)
	if not hit or (floor and hit.Position.Y > floor + 2.5) then
		return fallback
	end
	return hit.Position.Y
end

local function hideTrail()
	if not trailShown then
		return
	end
	trailShown = false
	for _, chevron in chevrons do
		if chevron.shown then
			chevron.shown = false
			for side = 1, 2 do
				chevron.fills[side].Transparency = 1
				chevron.rims[side].Transparency = 1
			end
		end
	end
end

-- Lays the chevrons along the route from the player to `target`, `endGap` short of it. They
-- are spaced back from the target's end and travel toward it, so walking does not drag them.
local function paintTrail(clock: number, root: BasePart?, target: Vector3?, endGap: number, color: Color3)
	if trailAlpha < 0.01 or not root or not target then
		hideTrail()
		return
	end
	local rootPos = root.CFrame.Position
	local points = route(rootPos, target)
	local lengths = table.create(#points - 1)
	local total = 0
	for i = 1, #points - 1 do
		lengths[i] = (points[i + 1] - points[i]).Magnitude
		total += lengths[i]
	end
	local first, last = TRAIL_LEAD, total - endGap
	if last - first <= 0.5 then
		hideTrail()
		return
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local footY = rootPos.Y - root.Size.Y * 0.5 - (if humanoid then humanoid.HipHeight else 2)
	-- The plot's floor (the pen floor lies 0.15 above it), when the player is on or near it.
	local p = pen
	local floor: number? = if p and math.abs(footY - p.top) < 30 then p.top - 0.15 else nil
	local high, low = math.max(footY, floor or footY), math.min(footY, floor or footY)
	local phase = (clock * CHEVRON_FLOW) % CHEVRON_SPACING
	trailShown = true
	for k, chevron in chevrons do
		local s = last - (k * CHEVRON_SPACING - phase)
		-- Eased in ahead of the player and out at the target.
		local fade = trailAlpha * math.clamp((s - first) / 2.5, 0, 1) * math.clamp((last - s) / 1.5, 0, 1)
		if fade < 0.02 then
			if chevron.shown then
				chevron.shown = false
				for side = 1, 2 do
					chevron.fills[side].Transparency = 1
					chevron.rims[side].Transparency = 1
				end
			end
			continue
		end
		local leg, along = 1, s
		while leg < #lengths and along > lengths[leg] do
			along -= lengths[leg]
			leg += 1
		end
		if lengths[leg] < 0.01 then
			continue
		end
		local direction = (points[leg + 1] - points[leg]) / lengths[leg]
		local across = Vector3.new(-direction.Z, 0, direction.X)
		local at = points[leg] + direction * along
		local y = groundY(at.X, at.Z, high, low, floor) + CHEVRON_LIFT
		local tip = Vector3.new(at.X, y, at.Z) + direction * (CHEVRON_DEPTH / 2)
		chevron.shown = true
		for side = 1, 2 do
			local tail = tip - direction * CHEVRON_DEPTH + across * (if side == 1 then -CHEVRON_HALF else CHEVRON_HALF)
			local frame = CFrame.lookAt((tip + tail) / 2, tip)
			local fill, rim = chevron.fills[side], chevron.rims[side]
			rim.CFrame = frame
			rim.Transparency = 1 - 0.55 * fade
			fill.CFrame = frame + Vector3.new(0, 0.05, 0)
			fill.Color = color
			fill.Transparency = 1 - 0.95 * fade
		end
	end
end

-- How far short of a target's centre the trail ends: at the edge of its footprint.
local function reachOf(part: BasePart): number
	local size = part.Size
	local smallest = math.min(size.X, size.Y, size.Z)
	local largest = math.max(size.X, size.Y, size.Z)
	return (size.X + size.Y + size.Z - smallest - largest) / 2 + TRAIL_END_GAP
end

local function hideAll(clock: number, dt: number?)
	markerAlpha = approach(markerAlpha, 0, dt)
	trailAlpha = approach(trailAlpha, 0, dt)
	beamAlpha = approach(beamAlpha, 0, dt)
	paintMarker()
	paintBeam(clock, beamColor or World.Sunny)
	hideTrail()
	if markerAlpha <= 0.01 then
		currentPart = nil
	end
end

--[[
	One frame of guide work. `dt` is the frame time; the preview exporter
	calls it directly without one, which snaps every fade to its end state.
]]
function Guide.update(clock: number, dt: number?)
	local player = Players.LocalPlayer
	local name, text, fromTutorial = activeTarget()
	if not name or (player and player:GetAttribute("IntroPlaying") == true) then
		hideAll(clock, dt)
		return
	end
	if name ~= currentName or os.clock() - lastResolve > 0.25 or not currentPart or not currentPart.Parent then
		lastResolve = os.clock()
		currentName = name
		currentPart = resolve(name)
		refreshRayFilter()
	end
	local part = currentPart
	if not part then
		hideAll(clock, dt)
		return
	end
	local color = colorFor(name)
	local position = part.CFrame.Position
	local goal = position + Vector3.new(0, part.Size.Y * 0.5, 0)
	local from = markerPos
	if from and dt and markerAlpha > 0.05 then
		markerPos = from:Lerp(goal, 1 - math.exp(-8 * dt))
	else
		markerPos = goal
	end
	anchor.CFrame = CFrame.new(markerPos :: Vector3)
	marker.StudsOffsetWorldSpace = Vector3.new(0, MARKER_HEIGHT + math.sin(clock * 2.2) * MARKER_BOB, 0)
	tag.StudsOffsetWorldSpace = Vector3.new(0, MARKER_HEIGHT + MARKER_STUDS * 0.5 + 0.9 + math.sin(clock * 2.2) * MARKER_BOB, 0)
	if tagLabel.Text ~= text then
		tagLabel.Text = text
	end
	for _, bar in markerBars do
		bar.BackgroundColor3 = color
	end
	markerAlpha = approach(markerAlpha, 1, dt)
	paintMarker()

	local root = rootPart()
	local wantTrail = false
	local wantBeam = false
	if root then
		local rootPos = root.CFrame.Position
		-- Idle = the character has barely moved since the last frame.
		local moved = if lastRootPos then Vector3.new(rootPos.X - lastRootPos.X, 0, rootPos.Z - lastRootPos.Z).Magnitude else 0
		lastRootPos = rootPos
		if dt and moved < dt * 1.5 then
			idleFor += dt
		else
			idleFor = 0
		end
		local distance = Vector3.new(position.X - rootPos.X, 0, position.Z - rootPos.Z).Magnitude
		-- The tutorial's path is always there; a "navigate" one only when it is needed.
		wantTrail = fromTutorial or distance > TRAIL_DISTANCE or idleFor >= IDLE_SECONDS
		wantBeam = fromTutorial and distance > BEAM_NEAR
	end
	trailAlpha = approach(trailAlpha, if wantTrail then 1 else 0, dt)
	beamAlpha = approach(beamAlpha, if wantBeam then 1 else 0, dt)
	paintBeam(clock, color)
	paintTrail(clock, root, position, reachOf(part), color)
end

function Guide.setTutorialTarget(name: string?, text: string?)
	if name ~= tutorialTarget then
		currentPart = nil
	end
	tutorialTarget = name
	tutorialText = text or ""
end

-- Temporary target that overrides the tutorial for `seconds`.
function Guide.navigate(name: string?, text: string?, seconds: number?)
	navTarget = name
	navText = text or ""
	navUntil = os.clock() + (seconds or 30)
	currentPart = nil
end

function Guide.clearNavigate(name: string)
	if navTarget == name then
		navTarget = nil
		currentPart = nil
	end
end

return Guide
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="238">
          <Properties>
            <string name="Name">Intro</string>
          </Properties>
          <Item class="ModuleScript" referent="239">
            <Properties>
              <string name="Name">Actors</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Actors: the cutscene cast (built by CharacterFactory, posed with
	RigPose) and everything they do on screen: poses with smooth blends,
	walking / running / strutting along eased paths with the feet in step,
	turning, dumbbell curls, expressions and the fan sign flip.

	The hero is the local player's real avatar when it can be cloned and is an
	R15 rig (Intro.Avatar builds a RigPose-shaped rig for it, so everything
	below drives it like any other actor). The part-built hero is built anyway
	and kept as the fallback: it is used when the avatar is unavailable and
	swapped in if posing the avatar ever fails. Expressions are the emotions in
	Avatar.EMOTIONS: on a real avatar only its face changes (Avatar.setFace,
	or nothing when its head cannot show them); the part-built hero shows the
	nearest of its own faces (Avatar.FALLBACK).

	Actors stand on the stage floor (stage-local y = 0) at ground points
	{ x, z }; each faces a ground point (models face -Z). Cutscene calls
	cast:update(dt) every frame, after the timeline has fired its actions.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CharacterFactory = require(Shared:WaitForChild("CharacterFactory"))
local Poses = require(Shared:WaitForChild("Poses"))
local RigPose = require(Shared:WaitForChild("RigPose"))
local Avatar = require(script.Parent:WaitForChild("Avatar"))

local Actors = {}

local SIGN_PARTS = { SignStick = true, SignCard = true, SignHeader = true }

type Move = {
	from: Vector3,
	to: Vector3,
	start: number,
	dur: number,
	gait: string,
	face: Vector3?,
	trail: boolean,
	vanish: boolean,
	lastDrop: number,
}

export type Actor = {
	name: string,
	model: Model,
	rig: any,
	scale: number,
	height: number,
	visible: boolean,
	pos: Vector3, -- stage-local ground point (y = 0)
	yaw: number,
	turnFrom: number,
	turnTo: number,
	turnStart: number,
	turnDur: number,
	basePose: string,
	baseSpeed: number,
	-- Displayed pose and the one it is blending from.
	pose: string,
	poseT0: number,
	poseRate: number,
	poseTime: number,
	fromPose: string?,
	fromTime: number,
	fromRate: number,
	blendStart: number,
	blendDur: number,
	move: Move?,
	curl: number, -- 0..1 curl weight
	curlTarget: number,
	sign: { parts: { number }, offsets: { CFrame }, pivot: CFrame, upright: boolean? }?,
	signSpin: { start: number, text: string, swapped: boolean }?,
	hand: CFrame?,
	seed: number,
	-- True while the actor is the player's real avatar; `fallback` is the
	-- part-built model it swaps to if posing the avatar fails.
	avatar: boolean,
	fallback: { model: Model, rig: any, scale: number, height: number }?,
	-- The avatar's face (nil keeps its own face) and the last expression shown.
	face: Avatar.Face?,
	expr: string?,
}

export type Cast = {
	stage: CFrame,
	parent: Instance,
	clock: number,
	actors: { [string]: Actor },
	order: { Actor },
	-- Called with a stage-local ground point while a "trail" move travels.
	onTrail: ((ground: Vector3) -> ())?,
	scratchA: { [string]: CFrame },
	scratchB: { [string]: CFrame },
	scratchOut: { [string]: CFrame },
}

local function clone(look: any): any
	local copy = table.clone(look)
	if look.acc then
		copy.acc = table.clone(look.acc)
	end
	return copy
end

-- Looks ---------------------------------------------------------------------------

-- The hero: the tier 1 look in the player's own body colours when Roblox has them.
function Actors.heroLook(theme: any, player: Player?): any
	local look = clone(theme.Tiers[1].Look)
	look.anim = "Chad"
	look.manual = true
	look.expr = "Happy"
	look.exprs = { "Happy", "Sad", "Shock", "Determined" }
	look.scale = 1
	look.avatarPlayer = player
	if player and player.UserId > 0 then
		local ok, desc = pcall(function()
			return Players:GetHumanoidDescriptionFromUserId(player.UserId)
		end)
		if ok and desc then
			local d = desc :: HumanoidDescription
			look.skin = d.HeadColor
			look.shirt = d.TorsoColor
			look.pants = d.RightLegColor
		end
	end
	return look
end

-- The #1 fan: the first fan look, holding a sign.
function Actors.fanLook(theme: any): any
	local look = clone(theme.Fans.Looks[1])
	look.manual = true
	look.prop = "FanSign"
	look.signText = theme.Intro.SignBefore
	look.expr = "Cheer"
	look.exprs = { "Cheer", "Starry", "Sad", "Shock" }
	return look
end

-- MAX GIGA CHAD: the top tier look, twice the size, with shades. His body is painted
-- (SmoothPlastic, golden tan skin) so his face and muscles read; the aura ring and the
-- sparkles carry the glow.
function Actors.rivalLook(theme: any): any
	local look = clone(theme.Tiers[#theme.Tiers].Look)
	look.anim = "Chad"
	look.manual = true
	look.scale = 2
	look.material = nil
	look.skin = Color3.fromRGB(232, 178, 110)
	look.shirt = theme.World.Cream
	look.pants = theme.World.Orange
	look.fire = nil
	look.glow = nil
	look.aura = theme.World.Sunny
	look.auraRate = 18
	local acc = look.acc or {}
	if not table.find(acc, "Shades") then
		table.insert(acc, 1, "Shades")
	end
	look.acc = acc
	return look
end

function Actors.crowdLook(theme: any, index: number): any
	local looks = theme.Fans.Looks
	local look = clone(looks[(index - 1) % #looks + 1])
	look.manual = true
	if look.prop == "FanSign" then
		look.signText = theme.Intro.SignAfter
	end
	return look
end

-- Building ------------------------------------------------------------------------

local function ground(p: { number }): Vector3
	return Vector3.new(p[1], 0, p[2])
end

local function yawTo(from: Vector3, to: Vector3, fallback: number): number
	local d = to - from
	if d.X * d.X + d.Z * d.Z < 1e-4 then
		return fallback
	end
	-- Models face -Z: yaw 0 looks toward -Z.
	return math.atan2(-d.X, -d.Z)
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

-- Records the fan sign's parts so it can spin about its stick.
local function captureSign(rig: any): any
	local parts, offsets = {}, {}
	local pivot: CFrame? = nil
	for i, p in rig.parts do
		if SIGN_PARTS[p.Name] then
			table.insert(parts, i)
			table.insert(offsets, rig.offsets[i])
			if p.Name == "SignStick" then
				pivot = rig.offsets[i]
			end
		end
	end
	if #parts == 0 or not pivot then
		return nil
	end
	return { parts = parts, offsets = offsets, pivot = pivot }
end

-- Blows a fan sign up to a big readable card held up in front of the fan's
-- chest: the fist grips a short handle at the card's top edge. updateActor
-- places the sign at the hand's position with the actor's own facing (not the
-- hand's rotation), so the card stays upright and readable however the arm is
-- posed, and below the fan's name tag.
local SIGN_GROW = 1.75
local SIGN_FORWARD = 0.6
local SIGN_INWARD = 0.7

local function enlargeSign(rig: any, sign: any)
	if not sign then
		return
	end
	local stick, card, header
	for _, index in sign.parts do
		local p = rig.parts[index]
		if p.Name == "SignStick" then
			stick = p
		elseif p.Name == "SignCard" then
			card = p
		elseif p.Name == "SignHeader" then
			header = p
		end
	end
	if not (stick and card) then
		return
	end
	stick.Size = Vector3.new(stick.Size.X * 1.4, 1.5, stick.Size.Z * 1.4)
	card.Size = Vector3.new(card.Size.X * SIGN_GROW, card.Size.Y * SIGN_GROW, card.Size.Z * 1.5)
	local cardY = -0.5 - card.Size.Y / 2
	local layout = {
		[stick] = CFrame.new(0, -0.45, -SIGN_FORWARD + 0.15),
		[card] = CFrame.new(-SIGN_INWARD, cardY, -SIGN_FORWARD),
	}
	if header then
		header.Size = Vector3.new(card.Size.X + 0.04, header.Size.Y * SIGN_GROW, card.Size.Z + 0.04)
		layout[header] = CFrame.new(-SIGN_INWARD, cardY + card.Size.Y / 2 - header.Size.Y / 2, -SIGN_FORWARD)
	end
	for j, index in sign.parts do
		local offset = layout[rig.parts[index]] or sign.offsets[j]
		sign.offsets[j] = offset
		rig.offsets[index] = offset
	end
	sign.pivot = CFrame.new(-SIGN_INWARD, 0, -SIGN_FORWARD)
	sign.upright = true
end

function Actors.new(stage: CFrame, parent: Instance): Cast
	return {
		stage = stage,
		parent = parent,
		clock = 0,
		actors = {},
		order = {},
		onTrail = nil,
		scratchA = {},
		scratchB = {},
		scratchOut = {},
	}
end

-- Builds one actor at ground point `at` facing ground point `face`.
function Actors.add(cast: Cast, name: string, look: any, at: { number }, face: { number }, hidden: boolean?): Actor
	local model = CharacterFactory.build(look, name)
	local rig = RigPose.capture(model, #cast.order * 7 + 3)
	assert(rig, "intro actor without a rig: " .. name)
	local scaleValue = model:GetAttribute("RigScale")
	local heightValue = model:GetAttribute("Height")
	local scale = if type(scaleValue) == "number" then scaleValue else 1
	local height = if type(heightValue) == "number" then heightValue else 6

	-- The player's own avatar, with the part-built model kept as the fallback.
	local fallback = nil
	local player = look.avatarPlayer
	if typeof(player) == "Instance" and player:IsA("Player") then
		local hip = rig.pivots.LeftUpperLeg.Y
		local ok, built = pcall(Avatar.build, player, name, hip, rig.seed, rig.animSet)
		if ok and built then
			fallback = { model = model, rig = rig, scale = scale, height = height }
			model, rig, scale, height = built.model, built.rig, built.scale, built.height
		elseif not ok then
			warn("[Intro] avatar hero failed: " .. tostring(built))
		end
	end

	local pos = ground(at)
	local yaw = yawTo(pos, ground(face), 0)
	local rest = if model:GetAttribute("AnimSet") == "Fan" then "Idle" else "Stand"
	local actor: Actor = {
		name = name,
		model = model,
		rig = rig,
		scale = scale,
		height = height,
		visible = not hidden,
		pos = pos,
		yaw = yaw,
		turnFrom = yaw,
		turnTo = yaw,
		turnStart = 0,
		turnDur = 0,
		basePose = rest,
		baseSpeed = 1,
		pose = rest,
		poseT0 = 0,
		poseRate = 1,
		poseTime = 0,
		fromPose = nil,
		fromTime = 0,
		fromRate = 0,
		blendStart = 0,
		blendDur = 0,
		move = nil,
		curl = 0,
		curlTarget = 0,
		sign = if fallback then nil else captureSign(rig),
		signSpin = nil,
		hand = nil,
		seed = #cast.order * 13 + 5,
		avatar = fallback ~= nil,
		fallback = fallback,
		face = if fallback then Avatar.attachFace(model) else nil,
		expr = nil,
	}
	enlargeSign(rig, actor.sign)
	model.Parent = if hidden then nil else cast.parent
	cast.actors[name] = actor
	table.insert(cast.order, actor)
	return actor
end

-- Actions ---------------------------------------------------------------------------

function Actors.get(cast: Cast, name: string): Actor?
	return cast.actors[name]
end

-- Stage-local ground point of an actor.
function Actors.groundOf(actor: Actor): Vector3
	return actor.pos
end

-- Stage-local chest / head heights of an actor.
function Actors.chest(actor: Actor): Vector3
	return actor.pos + Vector3.new(0, actor.height * 0.62, 0)
end

function Actors.head(actor: Actor): Vector3
	return actor.pos + Vector3.new(0, actor.height, 0)
end

function Actors.setVisible(cast: Cast, actor: Actor, on: boolean)
	actor.visible = on
	actor.model.Parent = if on then cast.parent else nil
end

-- Switches the displayed pose with a blend (seconds).
local function switchPose(cast: Cast, actor: Actor, pose: string, rate: number, blend: number, freezeFrom: boolean?)
	if actor.pose == pose and actor.poseRate == rate then
		return
	end
	if blend > 0 then
		actor.fromPose = actor.pose
		actor.fromTime = actor.poseTime
		actor.fromRate = if freezeFrom then 0 else actor.poseRate
		actor.blendStart = cast.clock
		actor.blendDur = blend
	else
		actor.fromPose = nil
	end
	actor.pose = pose
	actor.poseT0 = cast.clock
	actor.poseRate = rate
	actor.poseTime = 0
end

-- The actor's held pose (played whenever it is not moving).
function Actors.pose(cast: Cast, actor: Actor, pose: string, blend: number?, speed: number?)
	actor.basePose = pose
	actor.baseSpeed = speed or 1
	if not actor.move then
		switchPose(cast, actor, pose, actor.baseSpeed, blend or 0.35)
	end
end

function Actors.turn(cast: Cast, actor: Actor, face: { number } | Vector3, dur: number)
	local target = if typeof(face) == "Vector3" then face else ground(face :: { number })
	local yaw = yawTo(actor.pos, target, actor.yaw)
	actor.turnFrom = actor.yaw
	actor.turnTo = actor.yaw + wrapAngle(yaw - actor.yaw)
	actor.turnStart = cast.clock
	actor.turnDur = math.max(dur, 0)
	if dur <= 0 then
		actor.yaw = actor.turnTo
	end
end

-- Walks / runs / struts to a ground point. `face` is turned to on arrival.
function Actors.move(
	cast: Cast,
	actor: Actor,
	to: { number },
	dur: number,
	gait: string,
	face: { number }?,
	trail: boolean?,
	vanish: boolean?
)
	local target = ground(to)
	actor.move = {
		from = actor.pos,
		to = target,
		start = cast.clock,
		dur = math.max(dur, 0.05),
		gait = gait,
		face = if face then ground(face) else nil,
		trail = trail == true,
		vanish = vanish == true,
		lastDrop = -math.huge,
	}
	Actors.turn(cast, actor, target, 0.22)
	switchPose(cast, actor, gait, 0, 0.2)
end

-- Jumps straight to the end of a move (preview fast-forward).
function Actors.place(cast: Cast, actor: Actor, at: { number } | Vector3, face: { number }?)
	actor.move = nil
	actor.pos = if typeof(at) == "Vector3" then at else ground(at :: { number })
	if face then
		Actors.turn(cast, actor, face, 0)
	end
	switchPose(cast, actor, actor.basePose, actor.baseSpeed, 0)
end

function Actors.curl(_cast: Cast, actor: Actor, on: boolean)
	actor.curlTarget = if on then 1 else 0
end

function Actors.expression(actor: Actor, name: string)
	actor.expr = name
	if actor.avatar then
		if actor.face then
			Avatar.setFace(actor.face, name)
		end
		return
	end
	CharacterFactory.setExpression(actor.model, Avatar.FALLBACK[name] or name)
end

-- Spins the sign once about its stick, swapping the text while it is edge-on.
function Actors.flipSign(cast: Cast, actor: Actor, text: string, instant: boolean?)
	if instant or not actor.sign then
		CharacterFactory.setSignText(actor.model, text)
		return
	end
	actor.signSpin = { start = cast.clock, text = text, swapped = false }
end

-- Frame update ----------------------------------------------------------------------

local SPIN_TIME = 0.55

local function easeInOut(u: number): number
	return u * u * (3 - 2 * u)
end

-- Distance along a move at progress u: quick ease in and out, steady between.
local function travel(u: number): number
	return 0.6 * u + 0.4 * (0.5 - math.cos(math.pi * u) * 0.5)
end

local function sample(out: { [string]: CFrame }, set: string, pose: string, time: number, seed: number)
	Poses.samplePoseInto(out, set, pose, time, seed)
end

local function updateActor(cast: Cast, actor: Actor, dt: number)
	local now = cast.clock
	local rig = actor.rig

	-- Movement.
	local move = actor.move
	if move then
		local u = math.clamp((now - move.start) / move.dur, 0, 1)
		local k = travel(u)
		actor.pos = move.from:Lerp(move.to, k)
		local distance = (move.to - move.from).Magnitude * k
		actor.poseTime = Poses.gaitTime(move.gait, distance, actor.scale)
		if move.trail and cast.onTrail and distance - move.lastDrop >= 1.3 then
			move.lastDrop = distance
			cast.onTrail(actor.pos)
		end
		if u >= 1 then
			actor.move = nil
			if move.vanish then
				Actors.setVisible(cast, actor, false)
				return
			end
			if move.face then
				Actors.turn(cast, actor, move.face, 0.35)
			end
			-- Feet stop where they are while the held pose blends back in.
			switchPose(cast, actor, actor.basePose, actor.baseSpeed, 0.3, true)
		end
	else
		actor.poseTime = (now - actor.poseT0) * actor.poseRate
	end

	-- Turning.
	if actor.turnDur > 0 then
		local u = math.clamp((now - actor.turnStart) / actor.turnDur, 0, 1)
		actor.yaw = actor.turnFrom + (actor.turnTo - actor.turnFrom) * easeInOut(u)
		if u >= 1 then
			actor.turnDur = 0
		end
	end

	-- Curl weight eases toward its target.
	actor.curl += (actor.curlTarget - actor.curl) * math.min(1, dt * 6)

	-- Root, then the pose.
	local rootCF = cast.stage * CFrame.new(actor.pos) * CFrame.Angles(0, actor.yaw, 0)
	rig.root.CFrame = rootCF

	local set = rig.animSet
	local out = cast.scratchOut
	local blendW = 1
	if actor.fromPose then
		blendW = math.clamp((now - actor.blendStart) / actor.blendDur, 0, 1)
		if blendW >= 1 then
			actor.fromPose = nil
		end
	end
	if actor.fromPose then
		local fromTime = actor.fromTime + (now - actor.blendStart) * actor.fromRate
		sample(cast.scratchA, set, actor.fromPose :: string, fromTime, actor.seed)
		sample(cast.scratchB, set, actor.pose, actor.poseTime, actor.seed)
		local w = easeInOut(blendW)
		for limb, cf in cast.scratchB do
			local a = cast.scratchA[limb]
			out[limb] = if a then a:Lerp(cf, w) else cf
		end
	else
		sample(out, set, actor.pose, actor.poseTime, actor.seed)
	end

	-- Dumbbell curls: the right forearm pumps between waist and chest height,
	-- holding near the top so the dumbbell reads at chest level.
	if actor.curl > 0.01 then
		local wave = 0.5 - math.cos(now * 3.4) * 0.5
		local lift = (0.35 + 0.65 * math.sqrt(wave)) * 125 * actor.curl
		out.RightUpperArm = out.RightUpperArm * CFrame.Angles(math.rad(24 * actor.curl), 0, math.rad(-6 * actor.curl))
		out.RightLowerArm = out.RightLowerArm * CFrame.Angles(math.rad(lift), 0, 0)
	end

	local parts, cframes = RigPose.computeFrom(rig, out)

	-- The sign spins about its stick.
	-- (An enlarged sign stays upright at the hand, facing the actor's way.)
	local spin = actor.signSpin
	local sign = actor.sign
	if sign and (spin or sign.upright) then
		local angle = 0
		if spin then
			local u = math.clamp((now - spin.start) / SPIN_TIME, 0, 1)
			angle = easeInOut(u) * math.pi * 2
			if not spin.swapped and u >= 0.25 then
				spin.swapped = true
				CharacterFactory.setSignText(actor.model, spin.text)
			end
			if u >= 1 then
				actor.signSpin = nil
			end
		end
		local pivot = sign.pivot
		local turn = pivot * CFrame.Angles(0, angle, 0) * pivot:Inverse()
		local handFrame = rootCF * rig.frames.RightHand
		if sign.upright then
			handFrame = CFrame.new(handFrame.Position) * rootCF.Rotation
		end
		for j, index in sign.parts do
			cframes[index] = handFrame * turn * sign.offsets[j]
		end
	end

	Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)

	local hand = rig.frames.RightHand
	if hand then
		actor.hand = rootCF * hand * CFrame.new(0, -0.42 * actor.scale, -0.05)
	end
end

-- Replaces a failing avatar with the part-built hero, keeping the avatar's
-- root part (the head tag and bubbles are attached to it).
local function useFallback(cast: Cast, actor: Actor, err: any)
	local fallback = actor.fallback :: any
	warn("[Intro] avatar hero swapped for the part-built hero: " .. tostring(err))
	local root = actor.rig.root
	actor.avatar = false
	actor.fallback = nil
	actor.face = nil
	root.Parent = fallback.model
	fallback.rig.root = root
	actor.model:Destroy()
	actor.model = fallback.model
	actor.rig = fallback.rig
	actor.scale = fallback.scale
	actor.height = fallback.height
	actor.sign = captureSign(fallback.rig)
	if actor.expr then
		CharacterFactory.setExpression(actor.model, Avatar.FALLBACK[actor.expr] or actor.expr)
	end
	actor.model.Parent = if actor.visible then cast.parent else nil
end

function Actors.update(cast: Cast, dt: number)
	cast.clock += dt
	for _, actor in cast.order do
		if actor.visible then
			if actor.avatar then
				local ok, err = pcall(function()
					updateActor(cast, actor, dt)
				end)
				if not ok then
					useFallback(cast, actor, err)
					updateActor(cast, actor, 0)
				end
			else
				updateActor(cast, actor, dt)
			end
		end
	end
end

function Actors.destroy(cast: Cast)
	for _, actor in cast.order do
		actor.model:Destroy()
		if actor.fallback then
			actor.fallback.model:Destroy()
		end
	end
	table.clear(cast.actors)
	table.clear(cast.order)
end

return Actors
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="240">
            <Properties>
              <string name="Name">Avatar</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Avatar: turns the local player's real avatar into a cutscene actor.

	fetch() clones the player's character (after a short wait for it and its
	appearance), or builds one from the user id when there is no character in
	time. build() strips the clone down to something that only renders
	(no scripts, sounds, animator, joints, physics or name tag; the Humanoid
	stays so clothing and body colours keep rendering), reads its R15 joint
	graph into AvatarRig, anchors every part and returns a RigPose-shaped rig
	that Actors drives exactly like a CharacterFactory model: the root part
	"IntroRoot" stands on the ground and every part is written each frame with
	BulkMoveTo. When that model is not a full R15 rig (an R6 avatar, or a clone
	that fails the R15 checks), build() makes an R15 model of the same avatar
	from its HumanoidDescription and runs that through the same steps; only if
	that fails too does it return nil (the caller keeps the part-built hero).
	The whole build stays within the fetch wait budget. Studio-only: the
	LocalPlayer attribute IntroForceR15Build skips the clone and goes straight
	to the description build.

	attachFace() / setFace() act out the cutscene's emotions on the clone's
	face only (body, clothes, hair and accessories stay the player's own):
	dynamic heads ease their FaceControls into a pose, classic face decals
	swap to the Blender-made "faces/<Emotion>" image, and decal-less heads of a
	classic shape get that image as their own decal. Other heads, missing
	images and any error keep the avatar's own face.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Assets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Assets"))
local Poses = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Poses"))
local AvatarRig = require(script.Parent:WaitForChild("AvatarRig"))

local Avatar = {}

local CHARACTER_WAIT = 2
local APPEARANCE_WAIT = 2
local CREATE_WAIT = 3

export type Built = {
	model: Model,
	rig: any,
	scale: number,
	height: number,
}

-- Waits up to `seconds` for `ready()`; returns its final value.
local function waitFor(seconds: number, ready: () -> boolean): boolean
	local deadline = os.clock() + seconds
	while not ready() do
		if os.clock() >= deadline then
			return false
		end
		task.wait(0.1)
	end
	return true
end

local function cloneCharacter(player: Player): Model?
	waitFor(CHARACTER_WAIT, function()
		return player.Character ~= nil
	end)
	local character = player.Character
	if not character then
		return nil
	end
	waitFor(APPEARANCE_WAIT, function()
		return player:HasAppearanceLoaded()
	end)
	local was = character.Archivable
	character.Archivable = true
	local ok, copy = pcall(character.Clone, character)
	character.Archivable = was
	if ok and copy then
		return copy :: Model
	end
	return nil
end

-- Runs `make` on a background thread, abandoned (and the late model cleaned
-- up) if it takes longer than `seconds`.
local function createModel(seconds: number, make: () -> Model?): Model?
	local result: Model? = nil
	local done = false
	local abandoned = false
	task.spawn(function()
		local ok, model = pcall(make)
		done = true
		if ok and model then
			if abandoned then
				model:Destroy()
			else
				result = model
			end
		end
	end)
	waitFor(seconds, function()
		return done
	end)
	abandoned = true
	return result
end

-- Players:CreateHumanoidModelFromUserId (the avatar's own rig type), or nil.
local function modelFromUserId(userId: number): Model?
	if userId <= 0 then
		return nil
	end
	return createModel(CREATE_WAIT, function()
		return Players:CreateHumanoidModelFromUserId(userId)
	end)
end

-- An R15 model of the player's avatar built from its HumanoidDescription (the
-- character's applied one, else the one on the website), or nil.
local function r15FromDescription(player: Player, seconds: number): Model?
	if seconds <= 0 then
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return createModel(seconds, function()
		local desc: HumanoidDescription? = nil
		if humanoid then
			local ok, applied = pcall(humanoid.GetAppliedDescription, humanoid)
			if ok then
				desc = applied
			end
		end
		if not desc and player.UserId > 0 then
			desc = Players:GetHumanoidDescriptionFromUserId(player.UserId)
		end
		if not desc then
			return nil
		end
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
end

-- A clone of the player's avatar, or nil.
function Avatar.fetch(player: Player): Model?
	return cloneCharacter(player) or modelFromUserId(player.UserId)
end

local DROP = { "BaseScript", "ModuleScript", "Sound", "ForceField", "Animator", "AnimationController", "BodyMover", "Constraint" }

-- Things the game adds to a character that are not part of the avatar: a held
-- crate (a Model welded to the root), tools, and cosmetic trails and aura (the
-- crown, "CosCrown", stays). Effects that only exist while playing go too.
local NOT_AVATAR = { "Tool", "Trail", "Beam", "ParticleEmitter", "BillboardGui", "Highlight", "Light" }

local function isAvatarPiece(d: Instance, model: Model): boolean
	if d.Parent == model and d:IsA("Model") then
		return d.Name == "CosCrown"
	end
	for _, class in NOT_AVATAR do
		if d:IsA(class) then
			return false
		end
	end
	if d:GetAttribute("Cosmetic") == true then
		local name = d.Name
		return name == "CosCrown" or d:FindFirstAncestor("CosCrown") ~= nil
	end
	return true
end

-- Removes everything that runs, sounds or simulates and everything that is not
-- the avatar itself; keeps the looks.
local function strip(model: Model)
	for _, d in model:GetDescendants() do
		if d.Parent ~= nil and not isAvatarPiece(d, model) then
			d:Destroy()
		end
	end
	for _, d in model:GetDescendants() do
		if d.Parent == nil then
			continue
		end
		for _, class in DROP do
			-- Rigid / weld constraints are read as joints first; see build().
			if d:IsA(class) and not (d:IsA("WeldConstraint") or d:IsA("RigidConstraint") or d:IsA("AnimationConstraint")) then
				d:Destroy()
				break
			end
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.NameDisplayDistance = 0
		humanoid.HealthDisplayDistance = 0
		humanoid.RequiresNeck = false
		humanoid.BreakJointsOnDeath = false
		humanoid.EvaluateStateMachine = false
		humanoid.AutomaticScalingEnabled = false
	end
end

-- Reads the joint graph of a stripped R15 model into an AvatarRig spec.
local function readSpec(model: Model): (any?, { BasePart })
	local list: { BasePart } = {}
	local index: { [BasePart]: number } = {}
	local parts = {}
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return nil, list
	end
	local isLimb = {}
	for _, limb in Poses.LIMBS do
		isLimb[limb] = true
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
			index[d] = #list
			local limb = if d.Parent == model and isLimb[d.Name] then d.Name else nil
			table.insert(parts, { size = d.Size, limb = limb })
		end
	end
	local edges: { AvatarRig.Edge } = {}
	local joints = {}
	for _, d in model:GetDescendants() do
		if d:IsA("JointInstance") then
			local j = d :: JointInstance
			local a, b = j.Part0 and index[j.Part0], j.Part1 and index[j.Part1]
			if a and b then
				local motor = j:IsA("Motor6D") and parts[b].limb ~= nil and (parts[a].limb ~= nil or a == index[root])
				table.insert(edges, { a = a, b = b, rel = j.C0 * j.C1:Inverse(), motor = motor })
				if motor then
					joints[parts[b].limb] = { part0 = a, c0 = j.C0 }
				end
			end
		elseif d:IsA("WeldConstraint") then
			local w = d :: WeldConstraint
			local a, b = w.Part0 and index[w.Part0], w.Part1 and index[w.Part1]
			if a and b then
				table.insert(edges, { a = a, b = b, rel = (w.Part0 :: BasePart).CFrame:ToObjectSpace((w.Part1 :: BasePart).CFrame) })
			end
		elseif d:IsA("AnimationConstraint") then
			-- Upgraded avatar joints: an AnimationConstraint between two rig
			-- attachments stands in for the Motor6D (C0 = Attachment0, C1 = Attachment1).
			local c = d :: AnimationConstraint
			local a0, a1 = c.Attachment0, c.Attachment1
			local p0 = a0 and a0.Parent
			local p1 = a1 and a1.Parent
			if a0 and a1 and p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") and index[p0] and index[p1] then
				local a, b = index[p0], index[p1]
				local motor = parts[b].limb ~= nil and (parts[a].limb ~= nil or a == index[root])
				table.insert(edges, { a = a, b = b, rel = a0.CFrame * a1.CFrame:Inverse(), motor = motor })
				if motor then
					joints[parts[b].limb] = { part0 = a, c0 = a0.CFrame }
				end
			end
		elseif d:IsA("RigidConstraint") then
			local r = d :: RigidConstraint
			local a0, a1 = r.Attachment0, r.Attachment1
			local p0 = a0 and a0.Parent
			local p1 = a1 and a1.Parent
			if a0 and a1 and p0 and p1 and p0:IsA("BasePart") and p1:IsA("BasePart") and index[p0] and index[p1] then
				table.insert(edges, { a = index[p0], b = index[p1], rel = a0.CFrame * a1.CFrame:Inverse() })
			end
		end
	end
	return { parts = parts, root = index[root], edges = edges, joints = joints }, list
end

-- Builds the avatar actor model. `refHipY` is the part-built hero's hip
-- height (so gaits keep the feet planted at the avatar's own scale).
-- Strips `model` and rigs it as an intro actor; nil (model destroyed) when it is
-- not a usable R15 rig.
local function prepare(model: Model, name: string, refHipY: number, seed: number, animSet: string): Built?
	local ok, built = pcall(function(): Built?
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
			return nil
		end
		strip(model)
		local spec, list = readSpec(model)
		if not spec then
			return nil
		end
		local desc, why = AvatarRig.describe(spec, Poses.LIMBS)
		if not desc then
			warn("[Intro] avatar hero unavailable: " .. tostring(why))
			return nil
		end

		-- Joints go (BulkMoveTo places every part itself); parts nothing reached go too.
		for _, d in model:GetDescendants() do
			if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("RigidConstraint") or d:IsA("AnimationConstraint") then
				d:Destroy()
			end
		end
		local instances: { [number]: BasePart } = {}
		for i, part in list do
			if desc.rest[i] then
				instances[i] = part
				part.Anchored = true
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = false
				part.Massless = true
			else
				part:Destroy()
			end
		end

		local root = Instance.new("Part")
		root.Name = "IntroRoot"
		root.Size = Vector3.new(0.2, 0.2, 0.2)
		root.Transparency = 1
		root.Anchored = true
		root.CanCollide = false
		root.CanTouch = false
		root.CanQuery = false
		root.CastShadow = false
		root.Parent = model
		model.PrimaryPart = root
		model.Name = name

		local scale = math.clamp(desc.hipY / math.max(refHipY, 0.1), 0.4, 3)
		local rig = AvatarRig.rig(desc, instances, root, model, scale, seed)
		rig.animSet = animSet
		model:SetAttribute("Height", desc.height)
		model:SetAttribute("RigScale", scale)
		return { model = model, rig = rig, scale = scale, height = desc.height }
	end)
	if ok and built then
		return built
	end
	if not ok then
		warn("[Intro] avatar hero failed: " .. tostring(built))
	end
	model:Destroy()
	return nil
end

function Avatar.build(player: Player, name: string, refHipY: number, seed: number, animSet: string): Built?
	local deadline = os.clock() + CHARACTER_WAIT + APPEARANCE_WAIT + CREATE_WAIT
	local forceR15 = RunService:IsStudio() and player:GetAttribute("IntroForceR15Build") == true
	local model = if forceR15 then nil else Avatar.fetch(player)
	if model then
		local built = prepare(model, name, refHipY, seed, animSet)
		if built then
			return built
		end
	end
	-- R6 avatars (and clones that fail the R15 checks): the same avatar rebuilt as R15.
	local rebuilt = r15FromDescription(player, math.min(CREATE_WAIT, deadline - os.clock()))
	if rebuilt then
		return prepare(rebuilt, name, refHipY, seed, animSet)
	end
	return nil
end

-- Faces ----------------------------------------------------------------------

-- Every emotion the hero acts out; each has an image "faces/<Emotion>".
Avatar.EMOTIONS = { "Happy", "Proud", "Shock", "Awe", "Sad", "Idea", "Fury", "Smirk" }

-- The nearest expression of the part-built hero (Happy, Sad, Shock, Determined).
Avatar.FALLBACK = {
	Happy = "Happy",
	Proud = "Happy",
	Shock = "Shock",
	Awe = "Shock",
	Sad = "Sad",
	Idea = "Happy",
	Fury = "Determined",
	Smirk = "Happy",
} :: { [string]: string }

-- FaceControls poses (0..1) for dynamic heads. Every property in CONTROLS that a
-- pose leaves out eases back to 0.
local CONTROLS = {
	"LeftLipCornerPuller",
	"RightLipCornerPuller",
	"LeftLipCornerDown",
	"RightLipCornerDown",
	"LeftCheekRaiser",
	"RightCheekRaiser",
	"LeftDimpler",
	"RightDimpler",
	"JawDrop",
	"Funneler",
	"LeftUpperLipRaiser",
	"RightUpperLipRaiser",
	"LeftLowerLipDepressor",
	"RightLowerLipDepressor",
	"LeftLipStretcher",
	"RightLipStretcher",
	"ChinRaiser",
	"LeftInnerBrowRaiser",
	"RightInnerBrowRaiser",
	"LeftOuterBrowRaiser",
	"RightOuterBrowRaiser",
	"LeftBrowLowerer",
	"RightBrowLowerer",
	"LeftUpperLidRaiser",
	"RightUpperLidRaiser",
	"LeftEyeClosed",
	"RightEyeClosed",
	"EyesLookUp",
	"EyesLookDown",
}
Avatar.FACE_CONTROLS = CONTROLS

local function both(pose: { [string]: number }, name: string, value: number)
	pose["Left" .. name] = value
	pose["Right" .. name] = value
end

local function pose(build: ({ [string]: number }) -> ()): { [string]: number }
	local p = {}
	build(p)
	return p
end

Avatar.FACE_POSES = {
	Happy = pose(function(p)
		both(p, "LipCornerPuller", 0.9)
		both(p, "CheekRaiser", 0.5)
		both(p, "InnerBrowRaiser", 0.25)
		p.JawDrop = 0.25
	end),
	Proud = pose(function(p)
		p.LeftLipCornerPuller = 0.6
		p.RightLipCornerPuller = 0.95
		p.RightOuterBrowRaiser = 0.6
		both(p, "CheekRaiser", 0.35)
		both(p, "Dimpler", 0.3)
	end),
	Shock = pose(function(p)
		p.JawDrop = 0.8
		p.Funneler = 0.3
		both(p, "UpperLidRaiser", 1)
		both(p, "InnerBrowRaiser", 1)
		both(p, "OuterBrowRaiser", 0.9)
	end),
	Awe = pose(function(p)
		p.EyesLookUp = 0.7
		p.JawDrop = 0.35
		p.Funneler = 0.5
		both(p, "UpperLidRaiser", 0.6)
		both(p, "InnerBrowRaiser", 0.7)
		both(p, "OuterBrowRaiser", 0.5)
	end),
	Sad = pose(function(p)
		both(p, "LipCornerDown", 0.85)
		both(p, "InnerBrowRaiser", 0.9)
		p.EyesLookDown = 0.4
		p.ChinRaiser = 0.4
	end),
	Idea = pose(function(p)
		both(p, "LipCornerPuller", 0.8)
		both(p, "UpperLidRaiser", 0.7)
		both(p, "InnerBrowRaiser", 0.8)
		both(p, "OuterBrowRaiser", 0.8)
		p.JawDrop = 0.4
	end),
	Fury = pose(function(p)
		both(p, "BrowLowerer", 1)
		both(p, "LipCornerPuller", 0.55)
		both(p, "LipStretcher", 0.6)
		both(p, "UpperLipRaiser", 0.5)
		both(p, "LowerLipDepressor", 0.4)
		both(p, "EyeClosed", 0.15)
	end),
	Smirk = pose(function(p)
		p.RightLipCornerPuller = 0.85
		p.LeftLipCornerPuller = 0.15
		p.RightDimpler = 0.5
		p.RightOuterBrowRaiser = 0.6
		p.LeftEyeClosed = 0.2
	end),
} :: { [string]: { [string]: number } }

-- What attachFace reads off a head.
export type HeadInfo = {
	faceControls: boolean,
	faceDecal: boolean,
}

-- How a head shows emotions: "Controls" (dynamic head: pose its FaceControls),
-- "Swap" (classic "face" decal: swap its image) or "None" (no face decal: the
-- face is painted into the head's texture, so a decal would draw a second face
-- on top of it; keep the face as it is).
function Avatar.faceStrategy(info: HeadInfo): string
	if info.faceControls then
		return "Controls"
	end
	if info.faceDecal then
		return "Swap"
	end
	return "None"
end

export type Face = {
	strategy: string,
	head: BasePart,
	decal: Decal?, -- the face image (the avatar's own decal for "Swap")
	top: Decal?, -- the next image, faded in over `decal`
	controls: FaceControls?,
	tweens: { Tween },
	current: string?,
}

-- Reads the clone's head; nil keeps the avatar's own face for the whole cutscene.
function Avatar.attachFace(model: Model): Face?
	local ok, face = pcall(function(): Face?
		local head = model:FindFirstChild("Head")
		if not head or not head:IsA("BasePart") then
			return nil
		end
		local found = head:FindFirstChild("face")
		local decal = if found and found:IsA("Decal") then found else nil
		local controls = head:FindFirstChildOfClass("FaceControls")
		local strategy = Avatar.faceStrategy({
			faceControls = controls ~= nil,
			faceDecal = decal ~= nil,
		})
		if strategy == "None" then
			return nil
		end
		return {
			strategy = strategy,
			head = head,
			decal = decal,
			top = nil,
			controls = controls,
			tweens = {},
			current = nil,
		}
	end)
	if ok then
		return face
	end
	warn("[Intro] hero face unavailable: " .. tostring(face))
	return nil
end

local function faceDecal(head: BasePart, name: string, z: number): Decal
	local decal = Instance.new("Decal")
	decal.Name = name
	decal.Face = Enum.NormalId.Front
	decal.ZIndex = z
	decal.Transparency = 1
	decal.Parent = head
	return decal
end

local function play(face: Face, target: Instance, seconds: number, goal: { [string]: any })
	local tween = TweenService:Create(target, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	table.insert(face.tweens, tween)
	tween:Play()
	return tween
end

-- Shows `emotion` on the face: FaceControls ease over 0.15 s, decal images
-- cross-fade over 0.1 s. Unknown emotions, missing images and errors leave the
-- face as it is. Returns false when something errored.
function Avatar.setFace(face: Face, emotion: string): boolean
	if face.current == emotion then
		return true
	end
	local ok, err = pcall(function(): nil
		for _, tween in face.tweens do
			tween:Cancel()
		end
		table.clear(face.tweens)

		if face.strategy == "Controls" then
			local target = Avatar.FACE_POSES[emotion]
			local controls = face.controls
			if not target or not controls then
				return nil
			end
			local goal = {}
			for _, prop in CONTROLS do
				if pcall(function()
					return (controls :: any)[prop]
				end) then
					goal[prop] = target[prop] or 0
				end
			end
			play(face, controls, 0.15, goal)
			face.current = emotion
			return nil
		end

		local image = Assets.image("faces/" .. emotion)
		if not image then
			return nil
		end
		local base = face.decal or faceDecal(face.head, "IntroFace", 1)
		face.decal = base
		local top = face.top or faceDecal(face.head, "IntroFaceNext", base.ZIndex + 1)
		face.top = top
		if top.Transparency < 1 then
			-- a fade was cut short: settle on the image it was fading to
			base.Texture = top.Texture
			top.Transparency = 1
		end
		base.Face = Enum.NormalId.Front
		base.Color3 = Color3.new(1, 1, 1)
		top.Color3 = Color3.new(1, 1, 1)
		if face.current == nil then
			base.Texture = image
			base.Transparency = 0
		else
			top.Texture = image
			base.Transparency = 0
			play(face, base, 0.1, { Transparency = 1 })
			play(face, top, 0.1, { Transparency = 0 }).Completed:Connect(function(state)
				if state == Enum.PlaybackState.Completed then
					base.Texture = image
					base.Transparency = 0
					top.Transparency = 1
				end
			end)
		end
		face.current = emotion
		return nil
	end)
	if not ok then
		warn("[Intro] hero face change failed: " .. tostring(err))
	end
	return ok
end

return Avatar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="241">
            <Properties>
              <string name="Name">AvatarRig</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.AvatarRig: the maths that lets the game's pose system (Poses /
	RigPose) drive a real R15 avatar. Pure CFrame maths, no services or
	instances, so it also runs under Lune.

	describe() takes a joint graph read from an avatar model: parts (by index,
	body parts tagged with their R15 limb name, plus the HumanoidRootPart),
	rigid edges between them (motors, welds, weld / rigid constraints, each
	"b = a * rel") and the limb joints (Motor6D Part0 + C0 per limb). It walks
	the graph from the root part to get every part's REST CFrame (no
	animation), so the joint pivots and part offsets do not depend on what the
	live character was doing when it was cloned.

	Model space matches Poses: origin on the ground under the root part, +Y up,
	facing -Z (the root part's own axes).
]]

local AvatarRig = {}

export type PartSpec = {
	size: Vector3,
	limb: string?, -- R15 limb name for body parts
}

export type Edge = {
	a: number,
	b: number,
	rel: CFrame, -- b = a * rel
	motor: boolean?, -- a body joint (only these build the body chain)
}

export type Spec = {
	parts: { PartSpec },
	root: number,
	edges: { Edge },
	joints: { [string]: { part0: number, c0: CFrame } },
}

export type Description = {
	rest: { [number]: CFrame }, -- model-space rest CFrame per part index
	owner: { [number]: string }, -- limb that carries each part
	pivots: { [string]: Vector3 },
	height: number, -- top of the head
	hipY: number,
	feet: CFrame, -- the model-space origin in root-part space
}

-- Lowest and highest Y of a box of `size` at `cf`.
local function yRange(cf: CFrame, size: Vector3): (number, number)
	local r = cf.RightVector * size.X
	local u = cf.UpVector * size.Y
	local b = cf.LookVector * size.Z
	local half = (math.abs(r.Y) + math.abs(u.Y) + math.abs(b.Y)) * 0.5
	return cf.Position.Y - half, cf.Position.Y + half
end
AvatarRig.yRange = yRange

-- Walks `edges` breadth-first from the parts already in `rest`, filling in the
-- rest CFrame and owner limb of every part reached.
local function spread(
	rest: { [number]: CFrame },
	owner: { [number]: string },
	edges: { Edge },
	queue: { number },
	accept: (Edge) -> boolean
)
	local adjacent: { [number]: { Edge } } = {}
	for _, e in edges do
		if accept(e) then
			adjacent[e.a] = adjacent[e.a] or {}
			table.insert(adjacent[e.a], e)
			adjacent[e.b] = adjacent[e.b] or {}
			table.insert(adjacent[e.b], e)
		end
	end
	local head = 1
	while head <= #queue do
		local i = queue[head]
		head += 1
		local list = adjacent[i]
		if not list then
			continue
		end
		for _, e in list do
			local j = if e.a == i then e.b else e.a
			if not rest[j] then
				rest[j] = if e.a == i then rest[i] * e.rel else rest[i] * e.rel:Inverse()
				owner[j] = owner[j] or owner[i]
				table.insert(queue, j)
			end
		end
	end
end

-- Rest pose, pivots and size of an avatar, or nil and a reason when it cannot
-- be driven by Poses (missing limbs or joints).
function AvatarRig.describe(spec: Spec, limbs: { string }): (Description?, string?)
	local parts = spec.parts
	local rest: { [number]: CFrame } = { [spec.root] = CFrame.new() }
	local owner: { [number]: string } = { [spec.root] = "LowerTorso" }
	for i, p in parts do
		if p.limb then
			owner[i] = p.limb
		end
	end

	-- 1. The body chain, through its motors only.
	spread(rest, owner, spec.edges, { spec.root }, function(e)
		return e.motor == true
	end)
	local limbIndex: { [string]: number } = {}
	for i, p in parts do
		if p.limb and rest[i] then
			limbIndex[p.limb] = i
		end
	end
	for _, limb in limbs do
		if not limbIndex[limb] then
			return nil, "limb not connected: " .. limb
		end
		if not spec.joints[limb] then
			return nil, "no joint for " .. limb
		end
	end

	-- 2. Everything attached to the body (accessories, tools, layered clothing).
	local queue = {}
	for i in rest do
		table.insert(queue, i)
	end
	table.sort(queue)
	spread(rest, owner, spec.edges, queue, function()
		return true
	end)

	-- The ground is under the lowest body part, straight below the root part.
	local ground = math.huge
	for _, limb in limbs do
		local i = limbIndex[limb]
		local low = yRange(rest[i], parts[i].size)
		ground = math.min(ground, low)
	end
	local feet = CFrame.new(0, ground, 0)
	local toModel = feet:Inverse()
	for i, cf in rest do
		rest[i] = toModel * cf
	end

	local pivots: { [string]: Vector3 } = {}
	for _, limb in limbs do
		local joint = spec.joints[limb]
		local base = rest[joint.part0]
		if not base then
			return nil, "joint parent missing for " .. limb
		end
		pivots[limb] = (base * joint.c0).Position
	end

	-- Head top; hair and hats may add a little, never a tall hat's full height.
	local headIndex = limbIndex.Head
	local _, headTop = yRange(rest[headIndex], parts[headIndex].size)
	local height = headTop
	for i, cf in rest do
		if owner[i] == "Head" and not parts[i].limb then
			local _, top = yRange(cf, parts[i].size)
			height = math.max(height, math.min(top, headTop + 0.6))
		end
	end

	local hipY = 0
	if pivots.LeftUpperLeg and pivots.RightUpperLeg then
		hipY = (pivots.LeftUpperLeg.Y + pivots.RightUpperLeg.Y) * 0.5
	end
	if hipY <= 0.1 or height <= hipY then
		return nil, "implausible proportions"
	end
	return {
		rest = rest,
		owner = owner,
		pivots = pivots,
		height = height,
		hipY = hipY,
		feet = feet,
	}, nil
end

-- A RigPose.Rig-shaped table for the described avatar: `instances[i]` is the
-- part for spec index i (nil entries are skipped), `root` the part whose
-- CFrame is the model-space origin. RigPose.computeFrom poses it.
function AvatarRig.rig(desc: Description, instances: { [number]: any }, root: any, model: any, scale: number, seed: number): any
	local parts, limbList, offsets = {}, {}, {}
	local indices = {}
	for i in desc.rest do
		if instances[i] then
			table.insert(indices, i)
		end
	end
	table.sort(indices)
	for _, i in indices do
		local limb = desc.owner[i]
		local pivot = desc.pivots[limb]
		if pivot then
			table.insert(parts, instances[i])
			table.insert(limbList, limb)
			table.insert(offsets, CFrame.new(pivot):Inverse() * desc.rest[i])
		end
	end
	return {
		model = model,
		root = root,
		animSet = "Chad",
		seed = seed,
		scale = scale,
		pivots = desc.pivots,
		parts = parts,
		limbs = limbList,
		offsets = offsets,
		cframes = {},
		transforms = {},
		frames = {},
	}
end

return AvatarRig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="242">
            <Properties>
              <string name="Name">Cutscene</string>
              <string name="Source"><![CDATA[--[[
	Intro.Cutscene: plays the opening story (Intro.Timeline) once for new
	players, and again whenever Cutscene.play is called (e.g. a "Watch intro"
	button).

	While it plays: the player's "IntroPlaying" attribute is true (the tutorial
	and guide hide on it), the HUD and the Roblox player list are hidden, the
	character's controls are off and the camera is Scriptable. Finishing or
	skipping puts all of that back. Skip is on screen from the first frame (button
	for mouse and touch; Esc, gamepad B, or A on the selected button) and works
	after SKIP_GUARD seconds. Any error, or the 45 s watchdog, ends it the same
	way, so it can never lock the player in.

	  Cutscene.play(opts?) -> boolean   false if one is already playing
	    opts.delay      seconds to hold the first shot before the story starts
	                    (the loading screen fades out over it)
	    opts.startBeat  beat index to start from (earlier beats fast-forward)
	    opts.pauseAt    freeze the story this many seconds into startBeat
	    opts.onDone     fn(skipped, watched) after everything is restored; watched =
	                    story seconds played
	  Cutscene.preview(beatIndex, pauseAt?)  play from a beat (review tool)
	  Cutscene.skip()                        end it now
	  Cutscene.isPlaying() -> boolean
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any

local Intro = script.Parent
local Actors = require(Intro.Actors)
local Effects = require(Intro.Effects)
local Framing = require(Intro.Framing)
local Stage = require(Intro.Stage)
local Timeline = require(Intro.Timeline)
local Ui = require(Intro.Ui)
local Sounds = require(Intro.Parent.Sounds)
local FxCamera = require(Intro.Parent.Fx.Camera)

local Cutscene = {}

local WATCHDOG = 45
-- Skip ignores input for this long after the cutscene starts, so a tap or button press
-- left over from the loading screen cannot end it.
local SKIP_GUARD = 0.4
local BIND_NAME = "IntroCutscene"
local DEFAULT_FOV = 70
-- Matches Fx.Camera's spawn framing, so the hand-off to the follow camera is seamless.
local BEHIND_DISTANCE = 13
local BEHIND_HEIGHT = 5.5

export type Options = {
	delay: number?,
	startBeat: number?,
	pauseAt: number?,
	onDone: ((skipped: boolean, watched: number) -> ())?,
}

type Session = {
	opts: Options,
	ended: boolean,
	started: number,
	clock: number, -- seconds into the current beat
	preroll: number,
	beat: number,
	fired: { [any]: boolean },
	pausedAt: number?,
	stage: Stage.Stage?,
	fx: Effects.Effects?,
	cast: Actors.Cast?,
	ui: Ui.Ui?,
	plotFrame: CFrame?,
	fov: number,
	shakeAmp: number,
	shakeUntil: number,
	shakeLen: number,
	hidden: { ScreenGui },
	playerList: boolean?,
	cameraType: Enum.CameraType?,
	cameraFov: number?,
	controls: any,
	camSmooth: CFrame?,
	camKey: Timeline.CameraKey?,
}

local active: Session? = nil

-- Easing ---------------------------------------------------------------------------------

local EASE: { [string]: (number) -> number } = {
	Linear = function(u)
		return u
	end,
	Sine = function(u)
		return 0.5 - math.cos(math.pi * u) * 0.5
	end,
	Quad = function(u)
		return if u < 0.5 then 2 * u * u else 1 - (-2 * u + 2) ^ 2 / 2
	end,
	QuadIn = function(u)
		return u * u
	end,
	QuadOut = function(u)
		return 1 - (1 - u) * (1 - u)
	end,
	Cubic = function(u)
		return if u < 0.5 then 4 * u * u * u else 1 - (-2 * u + 2) ^ 3 / 2
	end,
	Back = function(u)
		local s = 1.4
		local k = u - 1
		return 1 + (s + 1) * k * k * k + s * k * k
	end,
}

-- Helpers ---------------------------------------------------------------------------------

local function characterRoot(): BasePart?
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	return if root and root:IsA("BasePart") then root else nil
end

local function flatLook(root: BasePart): Vector3
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	return if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
end

-- The normal follow-camera shot behind the character (eye, look-at).
local function behindShot(): (Vector3?, Vector3?)
	local root = characterRoot()
	if not root then
		return nil, nil
	end
	-- The gameplay camera's own spawn framing (Fx.Camera), so the hand-off is seamless.
	local eye, focus = FxCamera.spawnShot(root)
	if eye and focus then
		return eye, focus
	end
	local flat = flatLook(root)
	local head = root.Position + Vector3.new(0, 1.5, 0)
	return head - flat * BEHIND_DISTANCE + Vector3.new(0, BEHIND_HEIGHT, 0), head + flat * 6
end

local function vec(p: { number }?): Vector3
	if not p then
		return Vector3.zero
	end
	return Vector3.new(p[1], p[2], p[3])
end

local function playerControls(): any
	local ok, controls = pcall(function()
		local scripts = Players.LocalPlayer:WaitForChild("PlayerScripts", 5)
		local module = scripts and scripts:WaitForChild("PlayerModule", 5)
		if module and module:IsA("ModuleScript") then
			return (require(module) :: any):GetControls()
		end
		return nil
	end)
	return if ok then controls else nil
end

-- Camera ----------------------------------------------------------------------------------

-- Aspect ratio of the real viewport.
local function viewAspect(): number
	local camera = Workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(16, 9)
	return if size.Y > 1 then size.X / size.Y else 16 / 9
end

-- Stage-local subjects of a shot: each listed, visible actor's feet and real height.
local function shotSubjects(s: Session, shot: Framing.Shot): { Framing.Subject }
	local out = {}
	local cast = s.cast
	if not cast then
		return out
	end
	for _, name in shot.subjects do
		local actor = Actors.get(cast, name)
		if actor and actor.visible then
			local p = actor.pos
			table.insert(out, {
				feet = { p.X, p.Y, p.Z },
				height = actor.height,
				radius = 0.35 * actor.height,
				name = name,
			})
		end
	end
	return out
end

-- World eye, look-at and field of view of a camera key (nil when its space is
-- unavailable). Shot keys are solved from their subjects' current positions.
local function keyPoints(s: Session, key: Timeline.CameraKey): (Vector3?, Vector3?, number?)
	local space = key.space or "stage"
	if space == "behind" then
		local eye, look = behindShot()
		return eye, look, nil
	elseif space == "plot" then
		if not s.plotFrame then
			local root = characterRoot()
			if not root then
				return nil, nil, nil
			end
			s.plotFrame = CFrame.lookAt(root.Position, root.Position + flatLook(root))
		end
		local frame = s.plotFrame :: CFrame
		return frame * vec(key.pos), frame * vec(key.look), nil
	end
	local stage = s.stage
	if not stage then
		return nil, nil, nil
	end
	local shot = key.shot :: Framing.Shot?
	if shot then
		local subjects = shotSubjects(s, shot)
		if #subjects > 0 then
			local eye, look, fov = Framing.solve(subjects, shot, viewAspect())
			return stage.cframe * vec(eye), stage.cframe * vec(look), fov
		end
	end
	return stage.cframe * vec(key.pos), stage.cframe * vec(key.look), nil
end

-- Field of view of every key (inherited from the previous key when unset).
local fovCache: { [Timeline.CameraKey]: number } = {}
local function resolveFovs()
	local fov = DEFAULT_FOV
	for _, beat in Timeline.BEATS do
		for _, key in beat.camera do
			local shot = key.shot :: Framing.Shot?
			fov = key.fov or (if shot then shot.fov or Framing.LENS[shot.size or "full"] else nil) or fov
			fovCache[key] = fov
		end
	end
end
resolveFovs()

-- Camera of a beat at time t, and the key it is on (moves between keys with the
-- next key's ease; shot keys re-solve every frame so they follow their actors).
local function cameraAt(s: Session, beat: Timeline.Beat, t: number): (CFrame?, number, Timeline.CameraKey)
	local keys = beat.camera
	local prev, nextKey = keys[1], nil
	for i, key in keys do
		if key.t <= t then
			prev = key
			nextKey = keys[i + 1]
		end
	end
	local pos, look, solved = keyPoints(s, prev)
	local fov = solved or fovCache[prev] or DEFAULT_FOV
	if nextKey and not nextKey.cut and pos and look then
		local pos2, look2, solved2 = keyPoints(s, nextKey)
		if pos2 and look2 then
			local u = math.clamp((t - prev.t) / math.max(nextKey.t - prev.t, 1e-3), 0, 1)
			local w = (EASE[nextKey.ease or "Sine"] or EASE.Sine)(u)
			pos = pos:Lerp(pos2, w)
			look = look:Lerp(look2, w)
			fov += ((solved2 or fovCache[nextKey] or fov) - fov) * w
		end
	end
	if not pos or not look then
		return nil, fov, prev
	end
	return CFrame.lookAt(pos, look), fov, prev
end

-- Restore ---------------------------------------------------------------------------------

local function try(label: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn("[Intro] " .. label .. ": " .. tostring(err))
	end
end

local function teardown(s: Session, skipped: boolean)
	RunService:UnbindFromRenderStep(BIND_NAME)
	try("input", function()
		ContextActionService:UnbindAction(BIND_NAME)
	end)
	try("camera", function()
		local camera = Workspace.CurrentCamera
		if camera then
			local eye, look = behindShot()
			if eye and look then
				camera.CFrame = CFrame.lookAt(eye, look)
			end
			camera.FieldOfView = s.cameraFov or DEFAULT_FOV
			-- Before the character spawns the camera is still Fixed; hand back the
			-- normal follow camera in that case.
			camera.CameraType = if s.cameraType == nil or s.cameraType == Enum.CameraType.Fixed
				then Enum.CameraType.Custom
				else s.cameraType
			local humanoid = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
	end)
	try("controls", function()
		if s.controls then
			s.controls:Enable()
		end
	end)
	try("hud", function()
		for _, gui in s.hidden do
			gui.Enabled = true
		end
		if s.playerList ~= nil then
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, s.playerList)
		end
	end)
	try("stage", function()
		if s.cast then
			Actors.destroy(s.cast)
		end
		if s.fx then
			s.fx:destroy()
		end
		if s.stage then
			s.stage.destroy()
		end
	end)
	local ui = s.ui
	if ui then
		try("ui", function()
			ui:letterbox(false)
			ui:hideCaption()
			ui:fade(false, 0.35)
			task.delay(0.5, function()
				ui:destroy()
			end)
		end)
	end
	try("attribute", function()
		Players.LocalPlayer:SetAttribute("IntroPlaying", false)
	end)
	if active == s then
		active = nil
	end
	local onDone = s.opts.onDone
	if onDone then
		try("onDone", function()
			-- Story seconds played: the beats before the current one plus its clock.
			local beat = math.min(s.beat, #Timeline.BEATS + 1)
			onDone(skipped, math.min(Timeline.startOf(beat) + s.clock, Timeline.total()))
		end)
	end
end

local function finish(s: Session, skipped: boolean)
	if s.ended then
		return
	end
	s.ended = true
	RunService:UnbindFromRenderStep(BIND_NAME)
	if skipped and s.ui then
		-- Cover the cut back to the plot with a quick soft fade.
		local ui = s.ui :: Ui.Ui
		try("fade", function()
			ui:fade(true, 0.22)
		end)
		task.delay(0.24, function()
			teardown(s, true)
		end)
	else
		teardown(s, skipped)
	end
end

-- Actions ---------------------------------------------------------------------------------

local function shake(s: Session, amp: number, dur: number)
	s.shakeAmp = math.max(s.shakeAmp * math.max(s.shakeUntil - os.clock(), 0) / math.max(s.shakeLen, 1e-3), amp)
	s.shakeUntil = os.clock() + dur
	s.shakeLen = dur
end

local function sound(name: string, pitch: number?)
	Sounds.playCutscene(name, 0.04, pitch)
end

local function run(s: Session, a: Timeline.Action, instant: boolean)
	local cast = s.cast :: Actors.Cast
	local fx = s.fx :: Effects.Effects
	local ui = s.ui :: Ui.Ui
	local stage = s.stage :: Stage.Stage
	local intro = Theme.Intro
	local act = a.act
	local actor = if type(a.actor) == "string" then Actors.get(cast, a.actor) else nil
	local hero = Actors.get(cast, "Hero")
	local function world(p: Vector3): Vector3
		return stage.cframe * p
	end
	-- Stage-local ground point from a { x, z } field (nil when malformed).
	local function point(v: any): Vector3?
		if type(v) == "table" and type(v[1]) == "number" and type(v[2]) == "number" then
			return Vector3.new(v[1], 0, v[2])
		end
		return nil
	end
	-- World point `up` studs above an actor's real head (re-read every frame).
	local function above(who: Actors.Actor, offset: Vector3): () -> Vector3
		return function()
			return world(Actors.head(who) + offset)
		end
	end

	if act == "show" and actor then
		Actors.setVisible(cast, actor, true)
		if a.poof and not instant then
			fx:poof(world(actor.pos), actor.height)
		end
	elseif act == "pop" and actor then
		Actors.place(cast, actor, a.at, a.face)
		if a.pose then
			Actors.pose(cast, actor, a.pose, 0)
		end
		Actors.setVisible(cast, actor, true)
		if not instant then
			fx:poof(world(actor.pos), actor.height)
			sound("BuyPop")
		end
	elseif act == "pose" and actor then
		Actors.pose(cast, actor, a.pose, if instant then 0 else a.blend, a.speed)
	elseif act == "curl" and actor then
		Actors.curl(cast, actor, a.on == true)
	elseif act == "move" and actor then
		if instant then
			local from = actor.pos
			local to = Vector3.new(a.to[1], 0, a.to[2])
			if a.trail then
				local length = (to - from).Magnitude
				for d = 0, length, 1.3 do
					fx:trailDrop(world(from:Lerp(to, d / math.max(length, 1e-3))))
				end
			end
			Actors.place(cast, actor, to, a.face)
			if a.vanish then
				Actors.setVisible(cast, actor, false)
			end
		else
			Actors.move(cast, actor, a.to, a.dur, a.gait, a.face, a.trail, a.vanish)
		end
	elseif act == "turn" and actor then
		Actors.turn(cast, actor, a.face, if instant then 0 else a.dur)
	elseif act == "expr" and actor then
		Actors.expression(actor, a.name)
	elseif act == "sign" and actor then
		Actors.flipSign(cast, actor, intro[a.key] or "", instant)
		if not instant then
			sound("Toggle")
		end
	elseif act == "bubble" and actor and not instant then
		local text = intro.Bubbles[a.key] or a.key
		-- The hero's bubbles sit beside his head, clear of his tag and rain cloud.
		local offset = if actor == hero then Vector3.new(2.3, actor.height - 0.3, 0) else Vector3.new(0, actor.height + 1.8, 0)
		ui:bubble(actor.rig.root, offset, text, a.dur or 1.2, a.thought)
		sound("Pickup", 1.1)
	elseif act == "stat" then
		if instant then
			ui:countStat(a.to, a.to, 0)
		else
			ui:countStat(a.from, a.to, a.dur)
		end
	elseif act == "aura" and actor then
		local key = "halo:" .. actor.name
		if a.on == false then
			fx:stopProp(key, instant)
		else
			if not instant then
				fx:aura(world(Actors.chest(actor)), world(actor.pos), actor.scale)
				sound("Upgrade")
			end
			local who = actor
			fx:halo(key, function()
				return world(Actors.chest(who))
			end, math.max(who.height * 0.48, 2.4), if type(a.dur) == "number" then a.dur else 5.5, instant)
		end
	elseif act == "thump" and not instant then
		local at: Vector3
		if type(a.at) == "string" then
			local target = Actors.get(cast, a.at)
			at = if target then target.pos else Vector3.zero
		else
			at = Vector3.new(a.at[1], 0, a.at[2])
		end
		fx:dust(world(at), 10, 3.2)
		fx:ring(world(at), 5.5)
		shake(s, 0.35, 0.35)
		sound("MergeBoom", 0.6)
	elseif act == "shake" and not instant then
		shake(s, a.amp, a.dur)
	elseif act == "dumbbell" then
		if a.state == "rattle" and not instant then
			fx:dumbbellRattle(0.7)
		elseif a.state == "drop" then
			fx:dumbbellDrop(instant)
		elseif a.state == "roll" then
			local to = a.to or { 0, 0 }
			fx:dumbbellRoll(Vector3.new(to[1], 0, to[2]), a.dur or 1.8, instant)
		end
	elseif act == "cloud" and hero then
		if a.state == "form" then
			-- The cloud's belly sits ~1.5 studs above the hero's real head.
			fx:cloudForm(above(hero, Vector3.new(0, 2.6, 0)), instant)
		elseif a.state == "burst" then
			fx:cloudBurst(instant)
			if not instant then
				sound("Reward")
			end
		end
	elseif act == "bulb" and hero then
		-- A head-height above his head, a little to the front of the rain cloud.
		fx:bulb(above(hero, Vector3.new(-0.6, 2.7, -2)), instant)
		if not instant then
			sound("Ready")
		end
	elseif act == "sweat" and actor then
		fx:sweat("sweat:" .. actor.name, above(actor, Vector3.new(0, -0.35, 0)), a.on == true)
	elseif act == "stars" and actor then
		local dur = if type(a.dur) == "number" then a.dur else 1.8
		fx:stars("stars:" .. actor.name, above(actor, Vector3.new(0, 0.2, 0)), dur, instant)
		if not instant then
			sound("Pickup", 1.4)
		end
	elseif act == "confetti" and not instant then
		local target = if type(a.at) == "string" then Actors.get(cast, a.at) else nil
		local at = if target then Actors.chest(target) else point(a.at)
		if at then
			fx:confetti(world(at))
			sound("Reward", 1.15)
		end
	elseif act == "tumbleweed" and not instant then
		local from, to = point(a.from), point(a.to)
		if from and to then
			fx:tumbleweed(world(from), world(to), if type(a.dur) == "number" then a.dur else 3)
		end
	elseif act == "marker" then
		fx:marker(a.on == true)
	elseif act == "tag" then
		ui:tagShown(a.on == true)
	elseif act == "namecard" then
		-- Shown until a namecard key with on = false (story time, so a paused
		-- preview keeps it).
		if a.on == false then
			ui:hideNameCard()
		elseif not instant then
			ui:nameCard(function()
				shake(s, 0.25, 0.25)
			end)
		end
	elseif act == "title" then
		ui:title(a.on == true, instant)
	elseif act == "flash" and not instant then
		ui:flash(a.dur or 0.6)
	elseif act == "letterbox" then
		ui:letterbox(a.on == true, instant)
	elseif act == "sound" and not instant then
		sound(a.name, a.pitch)
	end
end

-- Fires every action and caption of `beat` due by local time `t`.
local function fireDue(s: Session, beat: Timeline.Beat, t: number, instant: boolean)
	for _, a in beat.actions do
		if not s.fired[a] and a.t <= t then
			s.fired[a] = true
			run(s, a, instant)
		end
	end
	for _, c in beat.captions do
		if not s.fired[c] and c.t <= t then
			s.fired[c] = true
			if not instant and s.ui then
				if c.hide then
					s.ui:hideCaption()
				elseif c.key then
					s.ui:say(Theme.Intro.Lines[c.key] or "")
				end
			end
		end
	end
end

-- Frame -------------------------------------------------------------------------------------

local function step(s: Session, dt: number)
	dt = math.min(dt, 1 / 15)
	local beats = Timeline.BEATS

	-- Advance the story clock (held during the preroll and at pauseAt).
	if s.preroll > 0 then
		s.preroll -= dt
	elseif not s.pausedAt then
		s.clock += dt
		local pauseAt = s.opts.pauseAt
		if pauseAt and s.beat == (s.opts.startBeat or 1) and s.clock >= pauseAt then
			s.clock = pauseAt
			s.pausedAt = pauseAt
		end
		while s.clock >= beats[s.beat].duration do
			fireDue(s, beats[s.beat], math.huge, false)
			s.clock -= beats[s.beat].duration
			s.beat += 1
			if s.beat > #beats then
				finish(s, false)
				return
			end
		end
		fireDue(s, beats[s.beat], s.clock, false)
	end

	-- A paused preview is a frozen frame: actors and props hold still.
	local simDt = if s.pausedAt then 0 else dt
	local cast = s.cast :: Actors.Cast
	Actors.update(cast, simDt)
	local hero = Actors.get(cast, "Hero")
	if s.fx then
		s.fx:update(simDt, hero and hero.hand)
	end
	if s.ui then
		s.ui:update(dt, function()
			Sounds.playCutscene("Tick", 0.05)
		end)
	end

	local camera = Workspace.CurrentCamera
	if camera then
		local cf, fov, key = cameraAt(s, beats[s.beat], s.clock)
		if cf then
			-- Ease toward the target so shots follow moving actors smoothly; cuts
			-- (and the first frame) jump straight there.
			local smooth = s.camSmooth
			if smooth and not (key ~= s.camKey and key.cut) then
				cf = smooth:Lerp(cf, 1 - math.exp(-10 * dt))
			end
			s.camSmooth = cf
			s.camKey = key
			local left = s.shakeUntil - os.clock()
			if left > 0 then
				local k = s.shakeAmp * left / math.max(s.shakeLen, 1e-3)
				local n = os.clock() * 37
				cf *= CFrame.new(math.noise(n, 1.3) * k, math.noise(n, 7.1) * k, 0)
			end
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = cf
			camera.FieldOfView = fov
		end
	end
end

-- Public ------------------------------------------------------------------------------------

function Cutscene.isPlaying(): boolean
	return active ~= nil
end

function Cutscene.skip()
	local s = active
	if s and not s.ended then
		finish(s, true)
	end
end

-- Skip from the player's own input (button, Esc, gamepad B).
local function skipByInput(s: Session)
	if os.clock() - s.started >= SKIP_GUARD then
		Cutscene.skip()
	end
end

local function setup(s: Session)
	local player = Players.LocalPlayer
	player:SetAttribute("IntroPlaying", true)

	-- Hide the HUD (every enabled ScreenGui below the loading screen).
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, gui in playerGui:GetChildren() do
			if gui:IsA("ScreenGui") and gui.Enabled and gui.DisplayOrder < 100 and gui.Name ~= "IntroUI" then
				gui.Enabled = false
				table.insert(s.hidden, gui)
			end
		end
	end
	try("player list", function()
		-- Under the loading screen the list is off already, and not by the player.
		s.playerList = StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.PlayerList) or Players.LocalPlayer:GetAttribute("Loading") == true
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)
	s.controls = playerControls()
	if s.controls then
		s.controls:Disable()
	end
	local camera = Workspace.CurrentCamera
	if camera then
		s.cameraType = camera.CameraType
		s.cameraFov = camera.FieldOfView
		camera.CameraType = Enum.CameraType.Scriptable
	end

	-- The set, the effects, the overlay and the cast.
	local stage = Stage.build(Theme)
	s.stage = stage
	local fx = Effects.new(stage.model, stage.cframe, Theme)
	s.fx = fx
	s.ui = Ui.new(Theme, stage.model, function()
		skipByInput(s)
	end)
	local cast = Actors.new(stage.cframe, stage.model)
	s.cast = cast
	cast.onTrail = function(ground: Vector3)
		fx:trailDrop(stage.cframe * ground)
	end
	for name, spec: any in Timeline.ACTORS do
		local look
		if name == "Hero" then
			look = Actors.heroLook(Theme, player)
		elseif name == "Fan" then
			look = Actors.fanLook(Theme)
		elseif name == "Rival" then
			look = Actors.rivalLook(Theme)
		else
			look = Actors.crowdLook(Theme, spec.look or 2)
		end
		Actors.add(cast, name, look, spec.at, spec.face, spec.hidden)
	end
	local ui = s.ui :: Ui.Ui
	local hero = Actors.get(cast, "Hero")
	if hero then
		ui:heroTag(hero.rig.root, hero.height + 1.6, player.DisplayName, Theme.Intro.HeroAura)
	end
	ui:letterbox(true, (s.opts.startBeat or 1) > 1)
	ui:focusSkip()

	-- Fast-forward to the start beat (the dumbbell starts in the hero's hand).
	Actors.update(cast, 0)
	fx:update(0, hero and hero.hand)
	local startBeat = math.clamp(s.opts.startBeat or 1, 1, #Timeline.BEATS)
	for i = 1, startBeat - 1 do
		fireDue(s, Timeline.BEATS[i], math.huge, true)
	end
	s.beat = startBeat
	Actors.update(cast, 0)
	fx:update(0, hero and hero.hand)

	ContextActionService:BindActionAtPriority(BIND_NAME, function(_, state)
		if state == Enum.UserInputState.Begin then
			skipByInput(s)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.Escape, Enum.KeyCode.ButtonB)
end

function Cutscene.play(opts: Options?): boolean
	if active then
		return false
	end
	local s: Session = {
		opts = opts or {},
		ended = false,
		started = os.clock(),
		clock = 0,
		preroll = 0,
		beat = 1,
		fired = {},
		pausedAt = nil,
		stage = nil,
		fx = nil,
		cast = nil,
		ui = nil,
		plotFrame = nil,
		fov = DEFAULT_FOV,
		shakeAmp = 0,
		shakeUntil = 0,
		shakeLen = 0,
		hidden = {},
		playerList = nil,
		cameraType = nil,
		cameraFov = nil,
		controls = nil,
		camSmooth = nil,
		camKey = nil,
	}
	s.preroll = s.opts.delay or 0
	active = s

	local ok, err = pcall(setup, s)
	if not ok then
		warn("[Intro] could not start: " .. tostring(err))
		s.ended = true
		teardown(s, true)
		return false
	end

	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
		if s.ended then
			return
		end
		local stepOk, stepErr = pcall(step, s, dt)
		if not stepOk then
			warn("[Intro] stopped: " .. tostring(stepErr))
			finish(s, true)
		end
	end)

	local limit = if s.opts.pauseAt then 300 else WATCHDOG + (s.opts.delay or 0)
	task.delay(limit, function()
		if not s.ended then
			warn("[Intro] watchdog ended the cutscene")
			finish(s, true)
		end
	end)
	return true
end

-- Plays from beat `index` (earlier beats fast-forward); `pauseAt` freezes it
-- that many seconds into the beat (Skip / Esc still ends it).
function Cutscene.preview(index: number, pauseAt: number?): boolean
	return Cutscene.play({ startBeat = index, pauseAt = pauseAt })
end

return Cutscene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="243">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Effects: the 3D effects and story props of the intro (dust puffs,
	thump rings, the poof a fan appears in, the rival's golden halo, the
	sparkling aura trail, the hero's rain cloud, the lightbulb, sweat drops,
	dizzy stars, confetti, a tumbleweed, the plot marker and the candy
	dumbbell).

	Everything lives under the stage model and dies with it. Effects.new()
	returns an object; Cutscene calls fx:update(dt) every frame. Story props
	are "live props": parts placed every frame relative to an anchor function
	(usually an actor's head or chest), popping in with a Back ease and
	shrinking away when stopped, so they follow their actor and never snap.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Effects = {}
Effects.__index = Effects

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOOTH = Enum.Material.SmoothPlastic

-- Dumbbell sizes (studs): oversized so it reads from the camera.
local BAR = 1.85
local BAR_R = 0.3
local PLATE = 0.95
local PLATE_W = 0.34

-- Live props pop in over POP_IN seconds and shrink away over POP_OUT.
local POP_IN = 0.3
local POP_OUT = 0.25

export type PropItem = {
	size: Vector3,
	color: Color3,
	offset: CFrame,
	shape: Enum.PartType?,
	wedge: boolean?,
	material: Enum.Material?,
	transparency: number?,
}

export type Handle = {
	stop: (instant: boolean?) -> (),
	parts: { BasePart },
	last: CFrame?,
}

type DumbbellState = "held" | "drop" | "rest" | "roll"

export type Effects = typeof(setmetatable(
	{} :: {
		theme: any,
		folder: Folder,
		stage: CFrame,
		clock: number,
		emitter: BasePart,
		sparkles: ParticleEmitter,
		trail: { { part: BasePart, base: Vector3, phase: number } },
		live: { (now: number, dt: number) -> boolean },
		handles: { [string]: Handle },
		dumbbell: Model,
		dbState: DumbbellState,
		dbFrom: CFrame,
		dbTo: CFrame,
		dbStart: number,
		dbDur: number,
		dbRattleUntil: number,
		dbAxis: Vector3,
	},
	Effects
))

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function part(parent: Instance, props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = SMOOTH
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function later(seconds: number, fn: () -> ())
	task.delay(seconds, function()
		pcall(fn)
	end)
end

local function bounceOut(u: number): number
	-- Two small bounces after the first landing.
	if u < 0.6 then
		local k = u / 0.6
		return k * k
	elseif u < 0.85 then
		local k = (u - 0.725) / 0.125
		return 1 - 0.12 * (1 - k * k)
	end
	local k = (u - 0.925) / 0.075
	return 1 - 0.03 * (1 - k * k)
end

local function backOut(u: number): number
	local s = 1.9
	local k = u - 1
	return 1 + (s + 1) * k * k * k + s * k * k
end

function Effects.new(parent: Instance, stage: CFrame, theme: any): Effects
	local W = theme.World
	local folder = Instance.new("Folder")
	folder.Name = "IntroFx"
	folder.Parent = parent

	-- One hidden emitter part, moved to each burst point and Emit()ted.
	local emitter = part(folder, { Name = "Burst", Size = Vector3.one * 0.2, Transparency = 1, CFrame = stage })
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = SPARKLE
	sparkles.Enabled = false
	sparkles.LightEmission = 0.6
	sparkles.Lifetime = NumberRange.new(0.6, 1.1)
	sparkles.Speed = NumberRange.new(6, 12)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Drag = 3
	sparkles.Acceleration = Vector3.new(0, 4, 0)
	sparkles.RotSpeed = NumberRange.new(-180, 180)
	sparkles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkles.Color = ColorSequence.new(W.Sunny)
	sparkles.Parent = emitter

	-- The candy dumbbell: chrome bar, pink plates with mint collars and white
	-- caps (bar along its X axis).
	local dumbbell = Instance.new("Model")
	dumbbell.Name = "Dumbbell"
	local bar = part(dumbbell, {
		Name = "Bar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(BAR, BAR_R, BAR_R),
		Color = W.Chrome,
	})
	for _, side in { -1, 1 } do
		part(dumbbell, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(PLATE_W, PLATE, PLATE),
			CFrame = CFrame.new(side * (BAR / 2 - 0.26), 0, 0),
			Color = W.Pink,
		})
		part(dumbbell, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.14, PLATE * 0.62, PLATE * 0.62),
			CFrame = CFrame.new(side * (BAR / 2 - 0.5), 0, 0),
			Color = W.Mint,
		})
		part(dumbbell, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, PLATE * 0.55, PLATE * 0.55),
			CFrame = CFrame.new(side * (BAR / 2 - 0.05), 0, 0),
			Color = W.White,
		})
	end
	dumbbell.PrimaryPart = bar
	dumbbell.Parent = folder

	local self = setmetatable({
		theme = theme,
		folder = folder,
		stage = stage,
		clock = 0,
		emitter = emitter,
		sparkles = sparkles,
		trail = {},
		live = {},
		handles = {},
		dumbbell = dumbbell,
		dbState = "held" :: DumbbellState,
		dbFrom = CFrame.new(),
		dbTo = CFrame.new(),
		dbStart = 0,
		dbDur = 0,
		dbRattleUntil = 0,
		dbAxis = Vector3.zAxis,
	}, Effects)
	return self
end

-- Bursts -----------------------------------------------------------------------------

function Effects.burst(self: Effects, pos: Vector3, count: number, color: Color3?, speed: number?)
	self.emitter.CFrame = CFrame.new(pos)
	self.sparkles.Color = ColorSequence.new(color or self.theme.World.Sunny)
	local s = speed or 9
	self.sparkles.Speed = NumberRange.new(s * 0.6, s * 1.2)
	self.sparkles:Emit(count)
end

-- Soft dust balls that swell, drift up and fade.
function Effects.dust(self: Effects, pos: Vector3, count: number, spread: number)
	local W = self.theme.World
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + math.random() * 0.6
		local r = spread * (0.5 + math.random() * 0.5)
		local start = pos + Vector3.new(math.cos(a) * r * 0.4, 0.3, math.sin(a) * r * 0.4)
		local puff = part(self.folder, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.9,
			CFrame = CFrame.new(start),
			Color = if i % 2 == 0 then W.Cream else W.Sand,
			Transparency = 0.15,
		})
		local size = 2 + math.random() * 1.5
		tween(puff, 0.7, {
			Size = Vector3.one * size,
			CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * r, 0.7 + math.random() * 0.6, math.sin(a) * r)),
			Transparency = 1,
		}, Enum.EasingStyle.Quad)
		later(0.75, function()
			puff:Destroy()
		end)
	end
end

-- A flat ring that spreads out over the ground.
function Effects.ring(self: Effects, pos: Vector3, radius: number, color: Color3?)
	local ring = part(self.folder, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 1, 1),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color or self.theme.World.Cream,
		Transparency = 0.2,
	})
	tween(ring, 0.5, { Size = Vector3.new(0.12, radius * 2, radius * 2), Transparency = 1 }, Enum.EasingStyle.Quad)
	later(0.55, function()
		ring:Destroy()
	end)
end

-- White puff balls plus sparkles (a fan pops into the scene).
function Effects.poof(self: Effects, pos: Vector3, height: number)
	local W = self.theme.World
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p0 = pos + Vector3.new(math.cos(a) * 0.6, height * (0.25 + (i % 3) * 0.22), math.sin(a) * 0.6)
		local puff = part(self.folder, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 1.4,
			CFrame = CFrame.new(p0),
			Color = if i % 3 == 0 then W.Cream else W.White,
			Transparency = 0,
		})
		tween(puff, 0.5, {
			Size = Vector3.one * 2.8,
			CFrame = CFrame.new(p0 + Vector3.new(math.cos(a) * 1.4, 0.6, math.sin(a) * 1.4)),
			Transparency = 1,
		}, Enum.EasingStyle.Quad)
		later(0.55, function()
			puff:Destroy()
		end)
	end
	self:burst(pos + Vector3.new(0, height * 0.6, 0), 14, W.Sunny, 8)
end

-- Gold aura burst around a model's chest, with a spreading gold ring.
function Effects.aura(self: Effects, chest: Vector3, ground: Vector3, size: number)
	local W = self.theme.World
	self:burst(chest, 40, W.Sunny, 14 * size)
	self:burst(chest, 16, W.White, 10 * size)
	self:ring(ground, 9 * size, W.Sunny)
end

-- Aura trail ------------------------------------------------------------------------

-- Drops one lingering aura sparkle on the ground.
function Effects.trailDrop(self: Effects, ground: Vector3)
	local W = self.theme.World
	local base = ground + Vector3.new((math.random() - 0.5) * 0.8, 0.35, (math.random() - 0.5) * 0.8)
	local orb = part(self.folder, {
		Name = "AuraSparkle",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.05,
		CFrame = CFrame.new(base),
		Color = W.Sunny,
		-- Aura orbs are the one thing allowed to glow.
		Material = Enum.Material.Neon,
	})
	tween(orb, 0.35, { Size = Vector3.one * (0.3 + math.random() * 0.15) }, Enum.EasingStyle.Back)
	local twinkle = Instance.new("ParticleEmitter")
	twinkle.Texture = SPARKLE
	twinkle.Rate = 2.5
	twinkle.Lifetime = NumberRange.new(0.5, 0.9)
	twinkle.Speed = NumberRange.new(0.5, 1.2)
	twinkle.SpreadAngle = Vector2.new(30, 30)
	twinkle.LightEmission = 0.6
	twinkle.Color = ColorSequence.new(W.Sunny)
	twinkle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.45),
		NumberSequenceKeypoint.new(1, 0),
	})
	twinkle.Parent = orb
	table.insert(self.trail, { part = orb, base = base, phase = math.random() * 6 })
end

-- Live props ---------------------------------------------------------------------------

local function propPart(parent: Instance, item: PropItem): BasePart
	local p: BasePart = if item.wedge then Instance.new("WedgePart") else Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = item.material or SMOOTH
	p.Color = item.color
	p.Transparency = item.transparency or 0
	if item.shape and p:IsA("Part") then
		p.Shape = item.shape
	end
	p.Size = item.size * 0.05
	p.Parent = parent
	return p
end

-- A camera-facing frame at `pos` (upright; -Z looks at the camera).
local function facing(pos: Vector3): CFrame
	local cam = Workspace.CurrentCamera
	if cam then
		local d = cam.CFrame.Position - pos
		local flat = Vector3.new(d.X, 0, d.Z)
		if flat.Magnitude > 1e-3 then
			local back = -flat.Unit
			return CFrame.fromMatrix(pos, Vector3.yAxis:Cross(back), Vector3.yAxis, back)
		end
	end
	return CFrame.new(pos)
end

--[[
	Spawns a live prop: `items` are placed every frame at anchor(age) * motion(age)
	* item.offset, scaled by the pop-in / shrink-out factor. `life` ends it after
	that many seconds; `name` replaces any live prop with the same name;
	`extra(age, frame)` runs every frame while it lives (rain, sweat, sparkles).
]]
function Effects.prop(
	self: Effects,
	name: string?,
	items: { PropItem },
	anchor: (age: number) -> CFrame?,
	motion: ((age: number) -> CFrame)?,
	life: number?,
	instant: boolean?,
	extra: ((age: number, frame: CFrame) -> ())?
): Handle
	if name and self.handles[name] then
		self.handles[name].stop(instant)
	end
	local parts = {}
	for _, item in items do
		table.insert(parts, propPart(self.folder, item))
	end
	local born = if instant then self.clock - POP_IN else self.clock
	local dying: number? = nil
	local dead = false
	local handle: Handle
	local function kill()
		dead = true
		for _, p in parts do
			p:Destroy()
		end
		if name and self.handles[name] == handle then
			self.handles[name] = nil
		end
	end
	handle = {
		parts = parts,
		last = nil,
		stop = function(now: boolean?)
			if dead then
				return
			end
			if now then
				kill()
			elseif not dying then
				dying = self.clock
			end
		end,
	}
	if name then
		self.handles[name] = handle
	end
	table.insert(self.live, function(clock: number, _dt: number): boolean
		if dead then
			return false
		end
		local age = clock - born
		if life and not dying and age >= life then
			dying = clock
		end
		local k = backOut(math.clamp(age / POP_IN, 0, 1))
		if dying then
			local out = math.clamp((clock - dying) / POP_OUT, 0, 1)
			if out >= 1 then
				kill()
				return false
			end
			k *= 1 - out * out
		end
		local frame = anchor(age) or handle.last
		if not frame then
			return true
		end
		handle.last = frame
		if motion then
			frame *= motion(age)
		end
		k = math.max(k, 0.02)
		local cframes = table.create(#parts)
		for i, item in items do
			parts[i].Size = item.size * k
			cframes[i] = frame * CFrame.new(item.offset.Position * k) * item.offset.Rotation
		end
		if #parts > 0 then
			Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
		if extra and not dying then
			extra(age, frame)
		end
		return true
	end)
	return handle
end

-- Stops a named live prop (shrinks away, or at once when instant).
function Effects.stopProp(self: Effects, name: string, instant: boolean?)
	local handle = self.handles[name]
	if handle then
		handle.stop(instant)
	end
end

-- A falling drop part: flies to `peak` then falls `fall` studs while fading.
function Effects.drop(self: Effects, from: Vector3, peak: Vector3, fall: number, color: Color3, size: Vector3)
	local d = part(self.folder, {
		Name = "Drop",
		Shape = Enum.PartType.Ball,
		Size = size * 0.4,
		CFrame = CFrame.new(from),
		Color = color,
	})
	local up = (peak - from).Magnitude > 0.05
	if up then
		tween(d, 0.18, { CFrame = CFrame.new(peak), Size = size })
	else
		d.Size = size
	end
	later(if up then 0.18 else 0, function()
		if d.Parent then
			tween(
				d,
				0.38,
				{ CFrame = CFrame.new(peak - Vector3.new(0, fall, 0)), Transparency = 1 },
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			)
		end
	end)
	later(0.62, function()
		d:Destroy()
	end)
end

-- The hero's rain cloud --------------------------------------------------------------

-- `center` returns the cloud's world centre each frame (it follows the hero).
function Effects.cloudForm(self: Effects, center: () -> Vector3, instant: boolean?)
	if self.handles.cloud then
		return
	end
	local W = self.theme.World
	local layout: { { any } } = {
		{ Vector3.new(0, 0.25, 0), 2.7, W.Steel },
		{ Vector3.new(-1.45, -0.1, 0.15), 2.1, W.Steel },
		{ Vector3.new(1.5, -0.1, -0.1), 2.15, W.Steel },
		{ Vector3.new(-0.65, 0.8, 0.3), 1.9, W.Chrome },
		{ Vector3.new(0.7, 0.75, 0.35), 1.85, W.Chrome },
		{ Vector3.new(0, -0.4, -0.45), 2.2, W.Steel },
	}
	local items: { PropItem } = {}
	for _, item in layout do
		local d = item[2] :: number
		table.insert(items, {
			size = Vector3.new(d * 1.15, d * 0.85, d),
			color = item[3],
			offset = CFrame.new(item[1] :: Vector3),
			shape = Enum.PartType.Ball,
		})
	end
	local nextDrop = 0.45
	self:prop(
		"cloud",
		items,
		function()
			return CFrame.new(center())
		end,
		function(age)
			return CFrame.new(0, math.sin(age * 2) * 0.12, 0) * CFrame.Angles(0, math.sin(age * 0.8) * 0.08, 0)
		end,
		nil,
		instant,
		function(age, frame)
			-- Big blue drops fall from the cloud's belly onto the hero.
			while age >= nextDrop do
				nextDrop += 0.07
				local x, z = (math.random() - 0.5) * 3.2, (math.random() - 0.5) * 1.4
				local from = (frame * CFrame.new(x, -0.9, z)).Position
				self:drop(from, from, 3.4, W.Blue, Vector3.new(0.26, 0.5, 0.26))
			end
		end
	)
end

function Effects.cloudBurst(self: Effects, instant: boolean?)
	local cloud = self.handles.cloud
	if not cloud then
		return
	end
	cloud.stop(instant)
	if not instant and cloud.last then
		local pos = cloud.last.Position
		self:burst(pos, 34, self.theme.World.Sunny, 10)
		self:burst(pos, 14, self.theme.World.White, 7)
	end
end

-- The lightbulb ---------------------------------------------------------------------

-- `center` returns the bulb's world centre each frame; it lives ~2.6 s.
function Effects.bulb(self: Effects, center: () -> Vector3, instant: boolean?)
	local W = self.theme.World
	local items: { PropItem } = {
		{ size = Vector3.one * 2.3, color = W.Sunny, offset = CFrame.new(), shape = Enum.PartType.Ball },
		{ size = Vector3.one * 0.85, color = W.White, offset = CFrame.new(-0.45, 0.4, -0.75), shape = Enum.PartType.Ball },
		{
			size = Vector3.new(0.75, 1.05, 1.05),
			color = W.Chrome,
			offset = CFrame.new(0, -1.3, 0) * CFrame.Angles(0, 0, math.rad(90)),
			shape = Enum.PartType.Cylinder,
		},
		{
			size = Vector3.new(0.22, 0.7, 0.7),
			color = W.Steel,
			offset = CFrame.new(0, -1.75, 0) * CFrame.Angles(0, 0, math.rad(90)),
			shape = Enum.PartType.Cylinder,
		},
	}
	for k = 0, 6 do
		local a = math.rad(-180 + k * 30)
		local dir = Vector3.new(math.cos(a), -math.sin(a), 0)
		table.insert(items, {
			size = Vector3.new(0.32, 0.95, 0.25),
			color = if k % 2 == 0 then W.Sunny else W.Orange,
			offset = CFrame.new(dir * 2.05) * CFrame.Angles(0, 0, -a - math.rad(90)),
		})
	end
	self:prop("bulb", items, function()
		return facing(center())
	end, function(age)
		return CFrame.new(0, math.sin(age * 3) * 0.15, 0) * CFrame.Angles(0, 0, math.sin(age * 2.2) * 0.08)
	end, 2.6, instant)
	if not instant then
		self:burst(center(), 24, W.Sunny, 9)
	end
end

-- The rival's golden halo -----------------------------------------------------------

--[[
	A big golden sun-halo behind an actor while he poses: a soft cream disc,
	a ring of glowing aura beads and spinning paint rays, with sparkles. It sits
	on the far side of the actor from the camera. `chest` returns the actor's
	world chest point each frame; `radius` is the ring radius in studs.
]]
function Effects.halo(self: Effects, key: string, chest: () -> Vector3, radius: number, life: number?, instant: boolean?)
	local W = self.theme.World
	local items: { PropItem } = {
		{
			size = Vector3.new(0.12, radius * 1.7, radius * 1.7),
			color = W.Cream,
			offset = CFrame.Angles(0, math.rad(90), 0),
			shape = Enum.PartType.Cylinder,
			transparency = 0.45,
		},
	}
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		table.insert(items, {
			size = Vector3.new(0.55, radius * 0.5, 0.2),
			color = if k % 2 == 0 then W.Sunny else W.Orange,
			offset = CFrame.Angles(0, 0, a) * CFrame.new(0, radius * 1.12, 0.1),
		})
	end
	for k = 0, 17 do
		local a = k / 18 * math.pi * 2
		table.insert(items, {
			size = Vector3.one * 0.5,
			color = W.Sunny,
			offset = CFrame.new(math.cos(a) * radius * 0.85, math.sin(a) * radius * 0.85, -0.05),
			shape = Enum.PartType.Ball,
			-- Aura glow is the one thing allowed to use Neon.
			material = Enum.Material.Neon,
		})
	end
	local handle = self:prop(key, items, function()
		local c = chest()
		local front = facing(c)
		-- Behind the actor as seen from the camera, slightly raised.
		return front * CFrame.new(0, radius * 0.15, 1.4)
	end, function(age)
		return CFrame.Angles(0, 0, -age * 0.5)
	end, life, instant)
	local glitter = Instance.new("ParticleEmitter")
	glitter.Texture = SPARKLE
	glitter.Rate = 16
	glitter.Lifetime = NumberRange.new(0.6, 1.1)
	glitter.Speed = NumberRange.new(1, 3)
	glitter.SpreadAngle = Vector2.new(180, 180)
	glitter.LightEmission = 0.5
	glitter.Color = ColorSequence.new(W.Sunny)
	glitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.8),
		NumberSequenceKeypoint.new(1, 0),
	})
	glitter.Parent = handle.parts[1]
end

-- Head props: sweat and dizzy stars ---------------------------------------------------

-- Sweat drops flick off both sides of the head while on (`head` = world point).
function Effects.sweat(self: Effects, key: string, head: () -> Vector3, on: boolean)
	if not on then
		self:stopProp(key)
		return
	end
	local W = self.theme.World
	local nextDrop = 0
	local side = 1
	-- An invisible anchor prop: its per-frame hook spawns the drops.
	self:prop(
		key,
		{},
		function()
			return facing(head())
		end,
		nil,
		nil,
		false,
		function(age, frame)
			while age >= nextDrop do
				nextDrop += 0.24
				side = -side
				local from = (frame * CFrame.new(side * 0.55, -0.35, -0.2)).Position
				local peak = (frame * CFrame.new(side * 1.5, 0.45, -0.3)).Position
				self:drop(from, peak, 2.2, if side > 0 then W.Blue else W.Pool, Vector3.new(0.34, 0.48, 0.34))
			end
		end
	)
end

-- Big cartoon stars orbiting the head for `dur` seconds.
function Effects.stars(self: Effects, key: string, head: () -> Vector3, dur: number, instant: boolean?)
	local W = self.theme.World
	local items: { PropItem } = {}
	local colors = { W.Sunny, W.Orange, W.Sunny, W.Pink, W.Sunny }
	for s = 1, 5 do
		local a = s / 5 * math.pi * 2
		local at = CFrame.new(math.cos(a) * 1.5, 0.35 + (s % 2) * 0.25, math.sin(a) * 1.5) * CFrame.Angles(0, -a + math.rad(90), 0)
		table.insert(items, { size = Vector3.one * 0.5, color = W.White, offset = at, shape = Enum.PartType.Ball })
		for j = 0, 4 do
			table.insert(items, {
				size = Vector3.new(0.34, 0.6, 0.22),
				color = colors[s],
				offset = at * CFrame.Angles(0, 0, math.rad(72 * j)) * CFrame.new(0, 0.38, 0),
			})
		end
	end
	self:prop(key, items, function()
		return CFrame.new(head())
	end, function(age)
		return CFrame.Angles(0, age * 3.2, 0) * CFrame.Angles(math.sin(age * 2) * 0.12, 0, 0)
	end, dur, instant)
end

-- Confetti and tumbleweed -------------------------------------------------------------

-- A short colourful burst of paper confetti at a world point.
function Effects.confetti(self: Effects, pos: Vector3)
	local W = self.theme.World
	local colors = { W.Coral, W.Pink, W.Sunny, W.Mint, W.Blue, W.Grape, W.Orange }
	local floor = self.stage.Position.Y + 0.15
	for i = 1, 36 do
		local a = math.random() * math.pi * 2
		local r = 1 + math.random() * 2.8
		local peak = pos + Vector3.new(math.cos(a) * r, 2.2 + math.random() * 2.4, math.sin(a) * r)
		local bit = part(self.folder, {
			Name = "Confetti",
			Size = Vector3.new(0.12, 0.04, 0.18),
			CFrame = CFrame.new(pos),
			Color = colors[i % #colors + 1],
		})
		local spin = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		tween(bit, 0.4, { Size = Vector3.new(0.38, 0.08, 0.55), CFrame = CFrame.new(peak) * spin })
		later(0.4, function()
			if bit.Parent then
				local land = Vector3.new(peak.X + (math.random() - 0.5) * 1.5, math.max(floor, peak.Y - 3.5), peak.Z)
				tween(
					bit,
					1,
					{ CFrame = CFrame.new(land) * spin * CFrame.Angles(4, 2, 3), Transparency = 1 },
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				)
			end
		end)
		later(1.45, function()
			bit:Destroy()
		end)
	end
	self:burst(pos, 18, W.Sunny, 9)
end

-- A brown scribble ball that rolls and bounces from `from` to `to` (world ground points).
function Effects.tumbleweed(self: Effects, from: Vector3, to: Vector3, dur: number)
	local W = self.theme.World
	local items: { PropItem } = {
		{ size = Vector3.one * 1.9, color = W.Wood, offset = CFrame.new(), shape = Enum.PartType.Ball, transparency = 0.45 },
	}
	for k = 1, 8 do
		table.insert(items, {
			size = Vector3.new(2.3, 0.16, 0.16),
			color = if k % 2 == 0 then W.Wood else W.Sand,
			offset = CFrame.Angles(k * 1.7, k * 2.3, k * 0.9),
			shape = Enum.PartType.Cylinder,
		})
	end
	local delta = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local axis = if delta.Magnitude > 0.01 then Vector3.yAxis:Cross(delta.Unit) else Vector3.xAxis
	local d = math.max(dur, 0.2)
	self:prop(nil, items, function(age)
		local u = math.clamp(age / d, 0, 1)
		local hop = math.abs(math.sin(u * math.pi * 5)) * 1.1 * (1 - u * 0.5)
		local pos = from:Lerp(to, u) + Vector3.new(0, 1 + hop, 0)
		return CFrame.new(pos) * CFrame.fromAxisAngle(axis, u * delta.Magnitude / 0.95)
	end, nil, d, false)
end

-- The plot marker ---------------------------------------------------------------------

-- A friendly bouncing arrow ~8 studs above the local character (their plot).
function Effects.marker(self: Effects, on: boolean)
	if not on then
		self:stopProp("marker")
		return
	end
	local W = self.theme.World
	local items: { PropItem } = {
		{ size = Vector3.new(1.1, 2, 1.1), color = W.Coral, offset = CFrame.new(0, 1.9, 0) },
		{ size = Vector3.new(1, 1.8, 1.5), color = W.Coral, offset = CFrame.new(0, 0, -0.75) * CFrame.Angles(0, 0, math.pi), wedge = true },
		{ size = Vector3.new(1, 1.8, 1.5), color = W.Coral, offset = CFrame.new(0, 0, 0.75) * CFrame.Angles(math.pi, 0, 0), wedge = true },
		{ size = Vector3.one * 1.1, color = W.Sunny, offset = CFrame.new(0, 3.3, 0), shape = Enum.PartType.Ball },
	}
	self:prop("marker", items, function()
		local player = Players.LocalPlayer
		local char = player and player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			return CFrame.new(root.CFrame.Position + Vector3.new(0, 8, 0))
		end
		return nil
	end, function(age)
		return CFrame.new(0, math.abs(math.sin(age * 3)) * 0.8, 0) * CFrame.Angles(0, age * 1.4, 0)
	end, nil, false)
end

-- Dumbbell --------------------------------------------------------------------------

function Effects.dumbbellRattle(self: Effects, seconds: number)
	self.dbRattleUntil = self.clock + seconds
end

-- Where the dumbbell lies on the floor below `pos` (bar along the stage Z axis).
function Effects.restFrame(self: Effects, pos: Vector3): CFrame
	local local_ = self.stage:PointToObjectSpace(pos)
	return self.stage * CFrame.new(local_.X, PLATE / 2, local_.Z) * CFrame.Angles(0, math.rad(90), 0)
end

function Effects.dumbbellDrop(self: Effects, instant: boolean?)
	local current = self.dumbbell:GetPivot()
	local rest = self:restFrame(current.Position)
	if instant then
		self.dbState = "rest"
		self.dumbbell:PivotTo(rest)
		return
	end
	self.dbState = "drop"
	self.dbFrom = current
	self.dbTo = rest
	self.dbStart = self.clock
	self.dbDur = 0.6
end

-- Rolls along the floor to the stage-local ground point `to` (studs).
function Effects.dumbbellRoll(self: Effects, to: Vector3, seconds: number, instant: boolean?)
	if self.dbState == "held" or self.dbState == "drop" then
		self:dumbbellDrop(true)
	end
	local from = self.dumbbell:GetPivot()
	local target = self.stage * CFrame.new(to.X, PLATE / 2, to.Z)
	local delta = target.Position - from.Position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if flat.Magnitude < 0.01 then
		return
	end
	-- Bar across the direction of travel; it spins about up x direction.
	local dir = flat.Unit
	local rot = CFrame.lookAt(Vector3.zero, dir)
	self.dbAxis = Vector3.yAxis:Cross(dir).Unit
	self.dbFrom = CFrame.new(from.Position) * rot
	self.dbTo = CFrame.new(target.Position) * rot
	if instant then
		self.dbState = "rest"
		self.dumbbell:PivotTo(self.dbTo)
		return
	end
	self.dbState = "roll"
	self.dbStart = self.clock
	self.dbDur = seconds
end

-- Frame update -----------------------------------------------------------------------

-- `hand` is the hero's right-hand frame (the held dumbbell follows it).
function Effects.update(self: Effects, dt: number, hand: CFrame?)
	self.clock += dt
	local now = self.clock

	-- Dumbbell.
	if self.dbState == "held" then
		if hand then
			local cf = hand
			if now < self.dbRattleUntil then
				local k = (self.dbRattleUntil - now) * 2
				cf *= CFrame.Angles(
					math.rad(math.sin(now * 61) * 14 * math.min(k, 1)),
					0,
					math.rad(math.sin(now * 47) * 10 * math.min(k, 1))
				)
			end
			self.dumbbell:PivotTo(cf)
		end
	elseif self.dbState == "drop" then
		local u = math.clamp((now - self.dbStart) / self.dbDur, 0, 1)
		local from, to = self.dbFrom, self.dbTo
		local turn = from:Lerp(to, math.min(1, u * 1.6))
		local xz = from.Position:Lerp(to.Position, u)
		local y = from.Position.Y + (to.Position.Y - from.Position.Y) * bounceOut(u)
		self.dumbbell:PivotTo(turn.Rotation + Vector3.new(xz.X, y, xz.Z))
		if u >= 1 then
			self.dbState = "rest"
		end
	elseif self.dbState == "roll" then
		local u = math.clamp((now - self.dbStart) / self.dbDur, 0, 1)
		local eased = 1 - (1 - u) * (1 - u)
		local pos = self.dbFrom.Position:Lerp(self.dbTo.Position, eased)
		local dist = (pos - self.dbFrom.Position).Magnitude
		local spin = CFrame.fromAxisAngle(self.dbAxis, dist / (PLATE / 2))
		self.dumbbell:PivotTo(CFrame.new(pos) * spin * self.dbFrom.Rotation)
		if u >= 1 then
			self.dbState = "rest"
		end
	end

	-- Aura trail sparkles bob gently.
	for _, item in self.trail do
		item.part.CFrame = CFrame.new(item.base + Vector3.new(0, math.sin(now * 2.4 + item.phase) * 0.12, 0))
	end

	-- Live props (a failing anchor drops its prop instead of breaking the frame).
	for i = #self.live, 1, -1 do
		local ok, keep = pcall(self.live[i], now, dt)
		if not ok or not keep then
			table.remove(self.live, i)
		end
	end
end

function Effects.destroy(self: Effects)
	table.clear(self.live)
	table.clear(self.handles)
	self.folder:Destroy()
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="244">
            <Properties>
              <string name="Name">Framing</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Framing: shots defined relative to their subjects.

	Pure maths (plain number tables, no Roblox types) so the unit tests can load it.
	Points are { x, y, z } in stage-local studs (+Y up). The camera follows Roblox
	conventions: CFrame.lookAt(eye, look) with +Y up, a vertical field of view, and
	screen right = forward x up.

	A shot (Timeline camera key field `shot`):
	  subjects  actor names to keep in frame (feet to head, plus headroom)
	  size      "close" | "medium" | "full" | "wide": how much of the frame height
	            the group fills (FILL) and the lens (LENS)
	  place     "left" | "center" | "right": where the group's centre sits
	            (left / right = the screen thirds)
	  angle     "ground" | "low" | "eye" | "high": camera pitch (PITCH, degrees,
	            positive looks up); pitch = n overrides it
	  yaw       degrees; the direction the camera looks (0 = +Z, 90 = +X)
	  headroom  extra studs kept clear above the tallest head (props such as the
	            rain cloud or the lightbulb)
	  lift      vertical screen offset of the group centre (-1..1, + is up)
	  push      distance multiplier >= 1 (pulls back from the tightest fit; a dolly
	            in is two keys going from a looser size to a tighter one)
	  fov       overrides the lens
	  focus     subject name whose centre goes to `place` (default: the whole group)

	Framing.solve returns the eye, the look-at point and the field of view that
	put every subject's head and feet inside the SAFE area at the given aspect
	ratio. Cutscene re-solves every frame, so shots follow moving actors.
]]

export type Point = { number }
export type Subject = { feet: Point, height: number, radius: number?, name: string? }
export type Shot = {
	subjects: { string },
	size: string?,
	place: string?,
	angle: string?,
	pitch: number?,
	yaw: number?,
	headroom: number?,
	lift: number?,
	push: number?,
	fov: number?,
	focus: string?,
}

local Framing = {}

-- Fraction of the screen (from its centre) that counts as safe: 5% - 95%.
Framing.SAFE = 0.9
Framing.FILL = { close = 0.84, medium = 0.74, full = 0.62, wide = 0.42 }
Framing.LENS = { close = 32, medium = 36, full = 40, wide = 48 }
Framing.PITCH = { ground = 15, low = 8, eye = 0, high = -12 }
Framing.PLACE = { left = -1 / 3, center = 0, right = 1 / 3 }
Framing.MIN_EYE_Y = 0.6

local function add(a: Point, b: Point, k: number): Point
	return { a[1] + b[1] * k, a[2] + b[2] * k, a[3] + b[3] * k }
end

local function sub(a: Point, b: Point): Point
	return { a[1] - b[1], a[2] - b[2], a[3] - b[3] }
end

local function dot(a: Point, b: Point): number
	return a[1] * b[1] + a[2] * b[2] + a[3] * b[3]
end

local function cross(a: Point, b: Point): Point
	return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
end

local function unit(a: Point): Point
	local m = math.sqrt(dot(a, a))
	if m < 1e-9 then
		return { 0, 0, 1 }
	end
	return { a[1] / m, a[2] / m, a[3] / m }
end

-- Camera basis of a look direction: forward, right, up.
local function basis(forward: Point): (Point, Point, Point)
	local f = unit(forward)
	local r = unit(cross(f, { 0, 1, 0 }))
	local u = cross(r, f)
	return f, r, u
end

-- Screen position of `p` seen from eye toward look: x, y in -1..1 across the
-- viewport (+x right, +y up) and the depth in studs (<= 0 is behind the camera).
function Framing.project(eye: Point, look: Point, fov: number, aspect: number, p: Point): (number, number, number)
	local f, r, u = basis(sub(look, eye))
	local d = sub(p, eye)
	local z = dot(d, f)
	local th = math.tan(math.rad(fov) / 2)
	if z <= 1e-3 then
		return math.huge, math.huge, z
	end
	return dot(d, r) / (z * th * aspect), dot(d, u) / (z * th), z
end

-- Feet and head points of every subject (head raised by headroom), widened by
-- each subject's radius along the screen's horizontal axis.
function Framing.points(subjects: { Subject }, right: Point, headroom: number): { Point }
	local out = {}
	for _, s in subjects do
		local r = s.radius or 1
		local head = { s.feet[1], s.feet[2] + s.height + headroom, s.feet[3] }
		for _, base in { s.feet, head } do
			table.insert(out, add(base, right, r))
			table.insert(out, add(base, right, -r))
		end
	end
	return out
end

-- Camera eye, look-at and field of view for a shot of these subjects.
function Framing.solve(subjects: { Subject }, shot: Shot, aspect: number): (Point, Point, number)
	local size = shot.size or "full"
	local fov = shot.fov or Framing.LENS[size] or 40
	local fill = Framing.FILL[size] or 0.62
	local pitch = math.rad(shot.pitch or Framing.PITCH[shot.angle or "eye"] or 0)
	local yaw = math.rad(shot.yaw or 0)
	local px = Framing.PLACE[shot.place or "center"] or 0
	local py = shot.lift or 0
	local th = math.tan(math.rad(fov) / 2)

	local f, r, u = basis({ math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch) })
	local flat = { r[1], 0, r[3] }
	local points = Framing.points(subjects, flat, shot.headroom or 0)
	if #points == 0 then
		return { 0, 5, -20 }, { 0, 4, 0 }, fov
	end
	local focused = points
	for _, s in subjects do
		if shot.focus and s.name == shot.focus then
			focused = Framing.points({ s }, flat, shot.headroom or 0)
		end
	end

	-- Centre of the bounding box of the focus subject (or of the whole group).
	local lo = { math.huge, math.huge, math.huge }
	local hi = { -math.huge, -math.huge, -math.huge }
	for _, p in focused do
		for i = 1, 3 do
			lo[i] = math.min(lo[i], p[i])
			hi[i] = math.max(hi[i], p[i])
		end
	end
	local centre = { (lo[1] + hi[1]) / 2, (lo[2] + hi[2]) / 2, (lo[3] + hi[3]) / 2 }

	-- Eye at distance d: the centre lands at (px, py) on screen.
	-- When the pitch would put the eye under the ground, the camera stays at ground
	-- level and tilts up just enough to look at the centre instead.
	local function at(d: number): (Point, Point)
		local fd, rd, ud = f, r, u
		if centre[2] - f[2] * d - u[2] * py * d * th < Framing.MIN_EYE_Y then
			local sinp = math.clamp((centre[2] - Framing.MIN_EYE_Y) / d, -0.9, 0.9)
			local cosp = math.sqrt(1 - sinp * sinp)
			fd, rd, ud = basis({ math.sin(yaw) * cosp, sinp, math.cos(yaw) * cosp })
		end
		local eye = add(add(add(centre, fd, -d), rd, -px * d * th * aspect), ud, -py * d * th)
		if eye[2] < Framing.MIN_EYE_Y then
			eye[2] = Framing.MIN_EYE_Y
		end
		return eye, add(eye, fd, d)
	end
	local safe = Framing.SAFE
	local function fits(d: number): boolean
		local eye, look = at(d)
		local top, bottom = -math.huge, math.huge
		for _, p in points do
			local x, y, z = Framing.project(eye, look, fov, aspect, p)
			if z < 1 or math.abs(x) > safe or math.abs(y) > safe then
				return false
			end
			top = math.max(top, y)
			bottom = math.min(bottom, y)
		end
		return top - bottom <= 2 * fill
	end

	-- Closest distance that fits (bisection; farther is always looser).
	local near, far = 1, 40
	while not fits(far) and far < 2000 do
		near, far = far, far * 2
	end
	for _ = 1, 32 do
		local mid = (near + far) / 2
		if fits(mid) then
			far = mid
		else
			near = mid
		end
	end
	local eye, look = at(far * math.max(shot.push or 1, 1))
	return eye, look, fov
end

return Framing
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="245">
            <Properties>
              <string name="Name">Stage</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Stage: the sunny little gym yard the intro is filmed in.

	Built on the client from plain parts, far from the map (see ORIGIN), and
	destroyed when the intro ends. Stage-local coordinates (Intro.Timeline):
	the mat's top is y = 0, the backdrop (fence, cabana, palms) is toward +Z and
	the camera films from -Z.
]]

local Workspace = game:GetService("Workspace")

local Timeline = require(script.Parent.Timeline)

local Stage = {}

-- Far from the map (beyond the fog) and well above the ground.
Stage.ORIGIN = CFrame.new(2600, 320, 2600)

export type Stage = {
	model: Model,
	cframe: CFrame,
	-- World position of a stage-local point.
	toWorld: (x: number, y: number, z: number) -> Vector3,
	destroy: () -> (),
}

local SMOOTH = Enum.Material.SmoothPlastic

local function part(parent: Instance, props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = SMOOTH
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	if p.Size.Magnitude < 1.2 then
		p.CastShadow = false
	end
	p.Parent = parent
	return p
end

function Stage.build(theme: any, origin: CFrame?): Stage
	local W = theme.World
	local base = origin or Stage.ORIGIN
	local model = Instance.new("Model")
	model.Name = "IntroStage"

	-- Stage-local placement helpers.
	local function at(x: number, y: number, z: number, ry: number?): CFrame
		return base * CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(ry or 0), 0)
	end
	local function box(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
		return part(model, { Size = size, CFrame = cf, Color = color, Material = material or SMOOTH })
	end
	local function ball(d: number, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
		return part(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * d,
			CFrame = cf,
			Color = color,
			Material = material or SMOOTH,
		})
	end
	-- Upright cylinder (Roblox cylinders run along X, so turn them onto Y).
	local function post(d: number, h: number, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
		return part(model, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(h, d, d),
			CFrame = cf * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Material = material or SMOOTH,
		})
	end
	local function disc(d: number, h: number, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
		return post(d, h, cf, color, material)
	end

	-- Sea to the horizon, a sand island and the grass yard.
	box(Vector3.new(2048, 2, 2048), at(0, -7, 0), W.Ocean)
	disc(230, 6.75, at(0, -3.625, 6), W.Sand, Enum.Material.Sand)
	disc(236, 0.6, at(0, -6.2, 6), W.SandDark, Enum.Material.Sand)
	box(Vector3.new(70, 0.5, 44), at(-6, -0.3, 4), W.Grass, Enum.Material.Grass)
	box(Vector3.new(71, 0.42, 45), at(-6, -0.36, 4), W.GrassDark, Enum.Material.Grass)

	-- The rubber training mat with a thick white rim and soft stripes.
	box(Vector3.new(32, 0.3, 17), at(-4, -0.15, 1.5), W.Mat)
	for i = -3, 3 do
		box(Vector3.new(2, 0.31, 17), at(-4 + i * 4.5, -0.15, 1.5), W.MatAlt)
	end
	box(Vector3.new(34, 0.34, 1), at(-4, -0.13, 10.5), W.White)
	box(Vector3.new(34, 0.34, 1), at(-4, -0.13, -7.5), W.White)
	box(Vector3.new(1, 0.34, 17), at(-21, -0.13, 1.5), W.White)
	box(Vector3.new(1, 0.34, 17), at(13, -0.13, 1.5), W.White)

	-- A low picket fence with candy post caps along the back.
	local caps = { W.Pink, W.Sunny, W.Mint, W.Blue, W.Coral, W.Grape }
	local n = 0
	for x = -30, 22, 3.25 do
		n += 1
		post(0.55, 3.2, at(x, 1.6, 13.5), W.White)
		ball(0.8, at(x, 3.3, 13.5), caps[(n - 1) % #caps + 1])
	end
	box(Vector3.new(53, 0.42, 0.3), at(-4, 2.3, 13.5), W.Cream)
	box(Vector3.new(53, 0.42, 0.3), at(-4, 1.1, 13.5), W.Cream)
	for x = -28, 20, 4 do
		ball(2.6 + (x % 3) * 0.4, at(x + 1.3, 0.9, 15.2), if x % 8 == 0 then W.Grass else W.GrassDark, Enum.Material.Grass)
	end

	-- Bunting flags strung between two tall striped poles.
	local flagColors = { W.Pink, W.Sunny, W.Mint, W.Blue, W.Orange }
	local poleL, poleR = Vector3.new(-24, 0, 12), Vector3.new(16, 0, 12)
	for _, p in { poleL, poleR } do
		post(0.7, 9, at(p.X, 4.5, p.Z), W.White)
		ball(1.1, at(p.X, 9.2, p.Z), W.Coral)
	end
	local flags = 22
	for i = 0, flags do
		local u = i / flags
		local x = poleL.X + (poleR.X - poleL.X) * u
		local y = 8.4 - math.sin(u * math.pi) * 2
		part(model, {
			Shape = Enum.PartType.Wedge,
			Size = Vector3.new(0.12, 1.1, 0.9),
			CFrame = at(x, y - 0.55, 12) * CFrame.Angles(math.rad(180), math.rad(90), 0),
			Color = flagColors[i % #flagColors + 1],
			CastShadow = false,
		})
	end

	-- The gym cabana: cream walls, a striped awning and a white sign card.
	local cab = Vector3.new(Timeline.SET.Cabana.at[1], 0, Timeline.SET.Cabana.at[2])
	box(Vector3.new(12, 6, 6), at(cab.X, 3, cab.Z), W.Cream)
	box(Vector3.new(12.6, 0.6, 6.6), at(cab.X, 6.3, cab.Z), W.White)
	box(Vector3.new(3, 4.2, 0.4), at(cab.X - 2.5, 2.1, cab.Z - 3.1), W.Wood, Enum.Material.WoodPlanks)
	for i = 0, 7 do
		box(
			Vector3.new(1.6, 0.35, 3.6),
			at(cab.X - 5.6 + i * 1.6, 5.9, cab.Z - 4.4) * CFrame.Angles(math.rad(-22), 0, 0),
			if i % 2 == 0 then W.Coral else W.White
		)
	end
	for i = 0, 7 do
		ball(0.62, at(cab.X - 5.6 + i * 1.6, 5.1, cab.Z - 6.05), if i % 2 == 0 then W.Coral else W.White)
	end
	-- The sign hangs low on the wall right of the door (stage x 11..16), so
	-- nothing sits high on the backdrop behind the hero's and fan's name tags.
	local card = box(Vector3.new(4.8, 1.8, 0.4), at(cab.X + 2.6, 3.6, cab.Z - 3.15), W.White)
	box(Vector3.new(4.9, 0.45, 0.46), at(cab.X + 2.6, 4.3, cab.Z - 3.15), W.Sunny)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.4
	gui.Parent = card
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.92, 0.72)
	label.Position = UDim2.fromScale(0.04, 0.26)
	label.Font = theme.Fonts.Display
	label.TextScaled = true
	label.TextColor3 = W.Ink
	label.Text = "SUNNY GYM"
	label.Parent = gui

	-- Candy-coloured weights: a plate rack, a bench and kettlebells.
	local rack = Vector3.new(Timeline.SET.Rack.at[1], 0, Timeline.SET.Rack.at[2])
	for _, dx in { -2.4, 2.4 } do
		post(0.45, 4, at(rack.X + dx, 2, rack.Z), W.Steel)
	end
	part(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6.2, 0.4, 0.4),
		CFrame = at(rack.X, 3.6, rack.Z),
		Color = W.Chrome,
	})
	local plates = { { -2.9, W.Pink, 2.4 }, { -3.3, W.Sunny, 1.9 }, { 2.9, W.Pink, 2.4 }, { 3.3, W.Sunny, 1.9 } }
	for _, plate in plates do
		part(model, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.38, plate[3], plate[3]),
			CFrame = at(rack.X + plate[1], 3.6, rack.Z),
			Color = plate[2],
		})
	end
	for i, color in { W.Mint, W.Blue, W.Grape, W.Orange } do
		local x = rack.X - 5.5 + i * 2.2
		part(model, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 1.6, 1.6),
			CFrame = at(x, 0.8, rack.Z + 1.5) * CFrame.Angles(0, math.rad(90), 0),
			Color = color,
		})
	end

	local bench = Vector3.new(Timeline.SET.Bench.at[1], 0, Timeline.SET.Bench.at[2])
	box(Vector3.new(1.6, 0.6, 5), at(bench.X, 1.7, bench.Z, 20), W.Coral)
	box(Vector3.new(1.7, 0.2, 5.1), at(bench.X, 1.35, bench.Z, 20), W.White)
	for _, dz in { -1.8, 1.8 } do
		local legAt = at(bench.X, 0, bench.Z, 20) * CFrame.new(0, 0.65, dz)
		box(Vector3.new(0.5, 1.3, 0.5), legAt, W.Steel)
	end
	for i, color in { W.Grape, W.Orange } do
		local kb = at(bench.X + 2.6 + i * 1.5, 0, bench.Z - 2.2 + i * 0.6)
		ball(1.3, kb * CFrame.new(0, 0.62, 0), color)
		part(model, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 0.9, 0.9),
			CFrame = kb * CFrame.new(0, 1.35, 0) * CFrame.Angles(0, math.rad(90), 0),
			Color = W.Chrome,
		})
	end

	-- Palm trees: a curved trunk of stacked rings and a crown of chunky leaves.
	local function palm(x: number, z: number, lean: number, height: number)
		local segs = 7
		local top = at(x, 0, z)
		for i = 0, segs - 1 do
			local u = i / segs
			local cf = at(x + math.sin(u * 1.4) * lean, (i + 0.5) * height / segs, z)
			post(1.25 - u * 0.35, height / segs + 0.12, cf, if i % 2 == 0 then W.Wood else W.WoodDark)
			top = at(x + math.sin(1.4) * lean, height, z)
		end
		for k = 0, 6 do
			local yaw = k * (360 / 7) + x * 7
			box(
				Vector3.new(1.3, 0.35, 5.4),
				top * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(-22), 0, 0) * CFrame.new(0, -0.3, -2.4),
				if k % 2 == 0 then W.Grass else W.GrassDark
			)
		end
		for k = 0, 2 do
			ball(0.85, top * CFrame.Angles(0, math.rad(k * 120), 0) * CFrame.new(0, -0.7, -0.6), W.WoodDark)
		end
	end
	palm(-19, 17, 2.2, 13)
	palm(20, 12, -1.8, 11)
	palm(-34, 9, 2.6, 12)
	palm(30, 20, -2.4, 14)
	palm(-44, 22, 1.5, 15)

	-- A beach umbrella and a cooler on the sand, off the right edge of the mat.
	local umb = at(-28, 0, -2)
	post(0.3, 6, umb * CFrame.new(0, 3, 0), W.White)
	for k = 0, 7 do
		box(
			Vector3.new(2.6, 0.25, 4),
			umb
				* CFrame.new(0, 6, 0)
				* CFrame.Angles(0, math.rad(k * 45), 0)
				* CFrame.Angles(math.rad(14), 0, 0)
				* CFrame.new(0, -0.4, -1.9),
			if k % 2 == 0 then W.Sunny else W.White
		)
	end
	box(Vector3.new(2.4, 1.6, 1.6), at(-25.5, 0.8, -3.5, 15), W.Blue)
	box(Vector3.new(2.5, 0.35, 1.7), at(-25.5, 1.75, -3.5, 15), W.White)

	model.Parent = Workspace

	local stage: Stage = {
		model = model,
		cframe = base,
		toWorld = function(x: number, y: number, z: number): Vector3
			return base * Vector3.new(x, y, z)
		end,
		destroy = function()
			model:Destroy()
		end,
	}
	return stage
end

return Stage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="246">
            <Properties>
              <string name="Name">Timeline</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Timeline: the opening cutscene as data. Cutscene.luau plays it.

	Pure data (no services, no Roblox types) so the unit tests can load it.

	Coordinates are stage-local studs: the yard floor is y = 0 with its centre at
	the origin, the backdrop is toward +Z and the camera usually sits at -Z
	looking +Z (so +X is screen LEFT). Ground points are { x, z }, camera
	points { x, y, z }. Text keys refer to Theme.Intro (captions: Lines,
	bubbles: Bubbles, signs: the top-level keys).

	Beat fields:
	  name      unique beat name
	  duration  seconds
	  camera    keys { t, shot | pos+look, fov?, ease?, cut?, space? } sorted by t;
	            the camera moves from the previous key to each key with that
	            key's ease (EASES). cut = true jumps straight to the key. shot
	            frames actors wherever they are (Intro.Framing documents its
	            fields: subjects, size, place, angle, yaw, headroom, push); pos
	            and look are fixed points. space is
	            "stage" (default), "plot" (relative to the player's character
	            on their plot: -Z is the way they face, +Y up) or "behind" (the
	            normal follow camera behind the player; pos/look unused).
	  captions  { t, key } (Theme.Intro.Lines key) or { t, hide = true }
	  actions   { t, act, ... } (ACTIONS lists each act and its fields)

	Retime a beat by editing its duration and the t values inside it; nothing
	else depends on absolute times.
]]

export type Point = { number }
export type CameraKey = {
	t: number,
	pos: Point?,
	look: Point?,
	fov: number?,
	ease: string?,
	cut: boolean?,
	space: string?,
	shot: { [string]: any }?,
}
export type Caption = { t: number, key: string?, hide: boolean? }
export type Action = { [string]: any }
export type Beat = {
	name: string,
	duration: number,
	camera: { CameraKey },
	captions: { Caption },
	actions: { Action },
}

local Timeline = {}

-- Easing names the camera keys may use.
Timeline.EASES = { "Linear", "Sine", "Quad", "QuadIn", "QuadOut", "Cubic", "Back" }

-- Every action and the fields it reads (besides t and act).
Timeline.ACTIONS = {
	show = { "actor" }, -- appear in place (optional poof = true)
	pop = { "actor", "at" }, -- appear at a spot in a puff (optional face, pose)
	pose = { "actor", "pose" }, -- optional blend (s), speed (time scale)
	curl = { "actor", "on" }, -- dumbbell curls with the right arm
	move = { "actor", "to", "dur", "gait" }, -- optional face (after arriving), trail, vanish
	turn = { "actor", "face", "dur" },
	expr = { "actor", "name" },
	sign = { "actor", "key" }, -- spins and flips the fan sign to Theme.Intro[key]
	bubble = { "actor", "key", "dur" }, -- optional thought = true
	stat = { "from", "to", "dur" }, -- the hero's aura tag counts between values
	aura = { "actor" }, -- golden aura burst
	thump = { "at" }, -- ground thump: shake, dust, sound (at = point or actor name)
	shake = { "amp", "dur" },
	dumbbell = { "state" }, -- "rattle" | "drop" | "roll" (roll: to)
	cloud = { "state" }, -- "form" | "burst" (the hero's rain cloud)
	bulb = {}, -- lightbulb pops over the hero's head
	namecard = {}, -- MAX GIGA CHAD name card slams in (on = false hides it)
	title = { "on" }, -- game title card
	flash = { "dur" }, -- white flash (covers a camera cut)
	letterbox = { "on" },
	sound = { "name" }, -- Sounds module name, optional pitch
	sweat = { "actor", "on" }, -- sweat drops flick off the actor's head
	stars = { "actor", "dur" }, -- big cartoon stars circle the actor's head
	confetti = { "at" }, -- confetti burst (at = point or actor name)
	tumbleweed = { "from", "to", "dur" }, -- a tumbleweed bounces across the yard
	marker = { "on" }, -- bouncing marker over the player's own plot
	tag = { "on" }, -- the hero's name / aura tag (switch it on a camera cut)
}

-- Footprints of the set's bulky pieces (Intro.Stage builds them here): { x, z }
-- centre, radius and height in studs. The framing test keeps them off the lens.
Timeline.SET = {
	Cabana = { at = { 11, 18 }, radius = 7, height = 7 },
	Rack = { at = { -7, 9.5 }, radius = 3.5, height = 3 },
	Bench = { at = { 11, 5 }, radius = 3, height = 2.5 },
}

-- The cast. Builds and starting spots; hidden actors appear with show / pop.
Timeline.ACTORS = {
	Hero = { at = { 3.5, 0 }, face = { 1, -10 } },
	Fan = { at = { -1, 0.6 }, face = { 3, -10 } },
	Rival = { at = { -20, 2 }, face = { 0, 1.5 }, hidden = true },
	Crowd1 = { at = { -12, -0.5 }, face = { -9, -8 }, hidden = true, look = 2 },
	Crowd2 = { at = { -4.4, 2.8 }, face = { -8, -8 }, hidden = true, look = 7 },
	Crowd3 = { at = { -11.2, 3.6 }, face = { -8, -6 }, hidden = true, look = 3 },
	Crowd4 = { at = { -13.8, 1.6 }, face = { -10, -8 }, hidden = true, look = 5 },
}

local EXIT_FACE = { -60, 3 }

-- Shots (Intro.Framing): every shot keeps its subjects' heads and feet on screen.
local DUO = { "Hero", "Fan" }
local GYM_WIDE = { subjects = DUO, size = "full", angle = "low", yaw = -8, headroom = 2.2 }
local GYM_TIGHT = { subjects = DUO, size = "medium", angle = "low", yaw = -8, headroom = 2.2 }
local WALK_IN = { subjects = { "Rival", "Hero", "Fan" }, size = "wide", angle = "low", yaw = -12 }
-- Ground level, tilted up, from the yard's open front: the rival towers in the
-- right third, the hero small at the left (clear of the dropped dumbbell), the
-- name card in the upper left.
local GIANT = { subjects = { "Rival", "Hero" }, size = "full", angle = "ground", yaw = -25, focus = "Rival", place = "right" }
local GIANT_IN = { subjects = { "Rival", "Hero" }, size = "medium", angle = "ground", yaw = -25, focus = "Rival", place = "right" }
local EXODUS = {
	subjects = { "Rival", "Fan", "Crowd1", "Crowd2", "Crowd3", "Crowd4" },
	size = "full",
	angle = "eye",
	yaw = -15,
}
-- The fan and her sign as it flips to TEAM GIGA (the hero beside her).
local FLIP = { subjects = { "Fan", "Hero" }, size = "medium", angle = "eye", yaw = -10, focus = "Fan", place = "right" }
-- The hero in the lower left third, headroom for the cloud, the empty yard behind.
local SAD = { subjects = { "Hero" }, size = "medium", place = "left", angle = "high", yaw = -30, headroom = 4 }
local SAD_START = { subjects = { "Hero" }, size = "medium", place = "left", angle = "high", yaw = -30, headroom = 4, push = 1.25 }
local IDEA = { subjects = { "Hero" }, size = "medium", place = "left", angle = "low", yaw = -30, headroom = 6.5, lift = 0.08 }
local IDEA_IN = { subjects = { "Hero" }, size = "medium", place = "left", angle = "low", yaw = -30, headroom = 6.5, lift = 0.08, fov = 34 }

-- About 14 seconds: one line and one idea per beat, so a new player is on their plot
-- within a quarter of a minute even without pressing Skip.
Timeline.BEATS = {
	-- 1. A sunny little gym yard: the hero curls a big candy dumbbell, his #1 fan cheers.
	{
		name = "Gym",
		duration = 2,
		camera = {
			{ t = 0, shot = GYM_WIDE, cut = true },
			{ t = 2, shot = GYM_TIGHT, ease = "Sine" },
		},
		captions = {
			{ t = 0.1, key = "Meet" },
		},
		actions = {
			{ t = 0, act = "curl", actor = "Hero", on = true },
			{ t = 0, act = "sweat", actor = "Hero", on = true },
			{ t = 0, act = "expr", actor = "Hero", name = "Proud" },
			{ t = 0, act = "pose", actor = "Fan", pose = "SignUp" },
			{ t = 0.6, act = "pose", actor = "Fan", pose = "Cheer", blend = 0.3 },
			{ t = 0.7, act = "bubble", actor = "Fan", key = "Stars", dur = 1.2 },
		},
	},
	-- 2. Thump, thump: MAX GIGA CHAD strides in and flexes under his name card.
	{
		name = "Arrive",
		duration = 2.7,
		camera = {
			{ t = 0, shot = GYM_TIGHT },
			{ t = 0.5, shot = WALK_IN, ease = "Quad" },
			{ t = 1.4, shot = WALK_IN },
			{ t = 1.45, shot = GIANT, cut = true },
			{ t = 2.7, shot = GIANT_IN, ease = "Sine" },
		},
		captions = {
			{ t = 0.1, key = "Arrive" },
		},
		actions = {
			{ t = 0, act = "thump", at = { -2, 1 } },
			{ t = 0.05, act = "dumbbell", state = "rattle" },
			{ t = 0.1, act = "expr", actor = "Hero", name = "Shock" },
			{ t = 0.15, act = "pose", actor = "Fan", pose = "Shock", blend = 0.2 },
			{ t = 0.25, act = "sweat", actor = "Hero", on = false },
			{ t = 0.25, act = "show", actor = "Rival" },
			{ t = 0.25, act = "move", actor = "Rival", to = { -8, 1.5 }, dur = 1.2, gait = "Strut", face = { -5, -10 }, trail = true },
			{ t = 0.35, act = "curl", actor = "Hero", on = false },
			{ t = 0.35, act = "pose", actor = "Hero", pose = "Shock", blend = 0.2 },
			{ t = 0.4, act = "dumbbell", state = "drop" },
			{ t = 0.5, act = "turn", actor = "Hero", face = { -8, 1.5 }, dur = 0.4 },
			{ t = 0.55, act = "turn", actor = "Fan", face = { -8, 1.5 }, dur = 0.4 },
			{ t = 0.75, act = "thump", at = "Rival" },
			{ t = 1.45, act = "thump", at = "Rival" },
			{ t = 1.45, act = "tag", on = false },
			{ t = 1.5, act = "pose", actor = "Rival", pose = "Flex", blend = 0.6, speed = 0.5 },
			{ t = 1.55, act = "aura", actor = "Rival" },
			{ t = 1.6, act = "namecard" },
			{ t = 1.6, act = "sound", name = "SurgeStart" },
			{ t = 2.65, act = "namecard", on = false },
		},
	},
	-- 3. Starry eyes, the sign flips to TEAM GIGA, and the fans leave with him.
	{
		name = "Wow",
		duration = 3,
		camera = {
			{ t = 0, shot = FLIP, cut = true },
			{ t = 0.95, shot = FLIP },
			{ t = 1, shot = EXODUS, cut = true },
			{ t = 3, shot = EXODUS },
		},
		captions = {
			{ t = 0.1, key = "Leave" },
		},
		actions = {
			{ t = 0, act = "tag", on = true },
			{ t = 0, act = "pose", actor = "Rival", pose = "MostMuscular", blend = 0.6 },
			{ t = 0, act = "turn", actor = "Fan", face = { -4, -10 }, dur = 0.3 },
			{ t = 0, act = "turn", actor = "Hero", face = { 0, -10 }, dur = 0.4 },
			{ t = 0, act = "expr", actor = "Hero", name = "Awe" },
			{ t = 0, act = "expr", actor = "Fan", name = "Starry" },
			{ t = 0, act = "pose", actor = "Fan", pose = "Swoon", blend = 0.3 },
			{ t = 0.05, act = "stars", actor = "Fan", dur = 1 },
			{ t = 0.05, act = "bubble", actor = "Fan", key = "Wow", dur = 0.9 },
			{ t = 0.3, act = "sign", actor = "Fan", key = "SignAfter" },
			{ t = 1, act = "tag", on = false },
			{ t = 1, act = "move", actor = "Fan", to = { -4.8, -0.8 }, dur = 0.6, gait = "Run", face = { -7, -6 } },
			{ t = 1.05, act = "pop", actor = "Crowd1", at = { -12, -0.5 }, face = { -9, -8 }, pose = "Cheer" },
			{ t = 1.15, act = "pop", actor = "Crowd2", at = { -4.4, 2.8 }, face = { -8, -8 }, pose = "Jump" },
			{ t = 1.25, act = "pop", actor = "Crowd3", at = { -11.2, 3.6 }, face = { -8, -6 }, pose = "SignUp" },
			{ t = 1.35, act = "pop", actor = "Crowd4", at = { -13.8, 1.6 }, face = { -10, -8 }, pose = "Clap" },
			{ t = 1.4, act = "bubble", actor = "Crowd1", key = "Giga", dur = 1 },
			{ t = 1.6, act = "bubble", actor = "Crowd2", key = "Cool", dur = 1 },
			{
				t = 1.8,
				act = "move",
				actor = "Rival",
				to = { -38, 3 },
				dur = 3,
				gait = "Strut",
				face = EXIT_FACE,
				trail = true,
				vanish = true,
			},
			{ t = 1.9, act = "move", actor = "Crowd4", to = { -42, 2 }, dur = 2.9, gait = "Walk", face = EXIT_FACE, vanish = true },
			{ t = 1.95, act = "move", actor = "Crowd1", to = { -40, 0 }, dur = 3, gait = "Walk", face = EXIT_FACE, vanish = true },
			{ t = 2, act = "move", actor = "Crowd3", to = { -41, 4.5 }, dur = 3, gait = "Walk", face = EXIT_FACE, vanish = true },
			{ t = 2.05, act = "move", actor = "Fan", to = { -38, -0.5 }, dur = 3, gait = "Run", face = EXIT_FACE, vanish = true },
			{ t = 2.1, act = "move", actor = "Crowd2", to = { -40, 3 }, dur = 3.2, gait = "Walk", face = EXIT_FACE, vanish = true },
			{ t = 2.2, act = "expr", actor = "Hero", name = "Sad" },
		},
	},
	-- 4. Alone in an empty yard: a rain cloud, the aura tag counts down to 0 and even
	-- the dumbbell rolls away. Silly, not upsetting.
	{
		name = "Sad",
		duration = 1.7,
		camera = {
			{ t = 0, shot = SAD_START, cut = true },
			{ t = 1.7, shot = SAD, ease = "Sine" },
		},
		captions = {
			{ t = 0.1, key = "Sad" },
		},
		actions = {
			{ t = 0, act = "tag", on = true },
			{ t = 0, act = "turn", actor = "Hero", face = { 6, -10 }, dur = 0.4 },
			{ t = 0, act = "pose", actor = "Hero", pose = "Sad", blend = 0.5 },
			{ t = 0, act = "expr", actor = "Hero", name = "Sad" },
			{ t = 0.05, act = "sound", name = "Close", pitch = 0.7 },
			{ t = 0.15, act = "cloud", state = "form" },
			{ t = 0.3, act = "stat", from = 12, to = 0, dur = 1 },
			{ t = 0.4, act = "dumbbell", state = "roll", to = { 0.5, -1.5 }, dur = 1.2 },
		},
	},
	-- 5. The idea: a lightbulb, the cloud bursts, he pumps his fist.
	{
		name = "Idea",
		duration = 2.2,
		camera = {
			{ t = 0, shot = IDEA, cut = true },
			{ t = 2.2, shot = IDEA_IN, ease = "Sine" },
		},
		captions = {
			{ t = 0.1, key = "Plan" },
		},
		actions = {
			{ t = 0, act = "expr", actor = "Hero", name = "Idea" },
			{ t = 0, act = "pose", actor = "Hero", pose = "Idea", blend = 0.25 },
			{ t = 0.05, act = "bulb" },
			{ t = 0.6, act = "cloud", state = "burst" },
			{ t = 0.7, act = "expr", actor = "Hero", name = "Fury" },
			{ t = 0.7, act = "pose", actor = "Hero", pose = "Cheer", blend = 0.25 },
			{ t = 0.75, act = "confetti", at = "Hero" },
			{ t = 1, act = "stat", from = 0, to = 1, dur = 0.3 },
			{ t = 1.5, act = "pose", actor = "Hero", pose = "Flex", blend = 0.35 },
		},
	},
	-- 6. Up and over to the player's real plot: a low, straight view, the title card
	-- and a bouncing marker on the plot, then gameplay.
	{
		name = "Go",
		duration = 3,
		camera = {
			{ t = 0, shot = IDEA_IN },
			{ t = 0.6, pos = { 3, 30, -24 }, look = { 3, 60, 30 }, fov = 55, ease = "QuadIn" },
			-- Plot space: the spawn point facing the pen; the entrance arch and owner
			-- sign are ~19 studs behind it, so the camera stays inside them.
			{ t = 0.65, pos = { 0, 30, 12 }, look = { 0, 2, -22 }, fov = 50, cut = true, space = "plot" },
			{ t = 2, pos = { 0, 16, 12 }, look = { 0, 3, -12 }, fov = 58, ease = "Sine", space = "plot" },
			{ t = 3, fov = 70, ease = "Cubic", space = "behind" },
		},
		captions = {
			{ t = 0.75, key = "Go" },
			{ t = 2.6, hide = true },
		},
		actions = {
			{ t = 0, act = "expr", actor = "Hero", name = "Smirk" },
			{ t = 0.05, act = "sound", name = "Open" },
			{ t = 0.35, act = "flash", dur = 0.6 },
			{ t = 0.7, act = "marker", on = true },
			{ t = 0.75, act = "title", on = true },
			{ t = 0.75, act = "sound", name = "Celebrate" },
			{ t = 0.75, act = "expr", actor = "Hero", name = "Happy" },
			{ t = 2.3, act = "title", on = false },
			{ t = 2.5, act = "marker", on = false },
			{ t = 2.5, act = "letterbox", on = false },
		},
	},
} :: { Beat }

-- Total running time in seconds.
function Timeline.total(): number
	local sum = 0
	for _, beat in Timeline.BEATS do
		sum += beat.duration
	end
	return sum
end

-- Start time of beat `index` (seconds from the start of the cutscene).
function Timeline.startOf(index: number): number
	local sum = 0
	for i = 1, index - 1 do
		sum += Timeline.BEATS[i].duration
	end
	return sum
end

return Timeline
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="247">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Intro.Ui: the cutscene's screen overlay and world bubbles.

	Screen (ScreenGui "IntroUI", DisplayOrder 80: above the HUD, below the loading screen):
	letterbox bars, the subtitle card (cream card with Ink text, sized to its line and
	kept just above the bottom bar), the Skip button bottom-right (a white pill, on screen
	from the first frame), the MAX GIGA CHAD name card, the game title card, a white flash
	and a full-screen fade.

	Layout is computed in pixels from the real screen size (and recomputed when it
	changes): every card is clamped inside a safe area (6% / 5% margins plus the Roblox
	top-bar inset), scaled by `k` = screen size relative to 1280x720 (clamped 0.6..1.6).
	Text uses TextScaled under a UITextSizeConstraint, so it shrinks instead of clipping.
	Nothing uses CanvasGroup: cards fade by tweening each element's own transparency.

	World (BillboardGuis under the stage): speech / thought bubbles and the hero's name
	and AURA tag. Everything tweens in and out.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Kit = require(script.Parent.Parent.UI.Kit)

local Ui = {}
Ui.__index = Ui

local BAR = 0.1 -- letterbox bar height (screen fraction)
local SAFE_X = 0.06 -- side margins (screen fraction), clears phone notches
local SAFE_Y = 0.05 -- top / bottom margins
local OUT = Enum.EasingStyle.Quad
local BACK = Enum.EasingStyle.Back

export type Ui = typeof(setmetatable(
	{} :: {
		theme: any,
		gui: ScreenGui,
		k: number,
		width: number,
		height: number,
		safe: Rect,
		top: Frame,
		bottom: Frame,
		caption: Frame,
		captionScale: UIScale,
		captionLabel: TextLabel,
		captionText: string,
		captionToken: number,
		skip: TextButton,
		skipHit: TextButton,
		nameCardGui: Frame?,
		titleCardGui: Frame?,
		flashFrame: Frame,
		fadeFrame: Frame,
		world: Folder,
		tag: BillboardGui?,
		tagStat: TextLabel?,
		tagPill: Frame?,
		tagPillScale: UIScale?,
		statFrom: number,
		statTo: number,
		statStart: number,
		statDur: number,
		statShown: number,
		clock: number,
		connections: { RBXScriptConnection },
	},
	Ui
))

local function new(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for key, value in props do
		(inst :: any)[key] = value
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent: Instance, radius: number)
	new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

-- A TextScaled label that never grows past `maxSize` and never clips.
local function scaledText(parent: Instance, props: { [string]: any }, maxSize: number): TextLabel
	props.BackgroundTransparency = 1
	props.TextScaled = true
	props.TextWrapped = if props.TextWrapped == nil then true else props.TextWrapped
	local label = new("TextLabel", props, parent)
	new("UITextSizeConstraint", { MaxTextSize = math.max(math.floor(maxSize), 9), MinTextSize = 8 }, label)
	return label
end

local function setMaxText(label: Instance, maxSize: number)
	local c = label:FindFirstChildOfClass("UITextSizeConstraint")
	if c then
		c.MaxTextSize = math.max(math.floor(maxSize), 9)
	end
end

-- Width/height of `text` at `size`, wrapped at `maxWidth`.
local function measure(text: string, size: number, font: Enum.Font, maxWidth: number): Vector2
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(maxWidth, 10000))
	end)
	if ok and bounds.X > 0 then
		return bounds
	end
	local w = (utf8.len(text) or #text) * size * 0.55
	local lines = math.max(math.ceil(w / maxWidth), 1)
	return Vector2.new(math.min(w, maxWidth), lines * size * 1.2)
end

-- Fades a whole card (every background, text and stroke) to its built look or out.
-- The built transparencies are remembered as attributes on first use.
local function fadeTree(root: Instance, visible: boolean, t: number)
	local items = root:GetDescendants()
	table.insert(items, root)
	for _, inst in items do
		local props: { [string]: number } = {}
		local function track(attr: string, prop: string)
			local base = inst:GetAttribute(attr)
			if base == nil then
				base = (inst :: any)[prop]
				inst:SetAttribute(attr, base)
			end
			props[prop] = if visible then base :: number else 1
		end
		if inst:IsA("GuiObject") then
			track("FadeBg", "BackgroundTransparency")
			if inst:IsA("TextLabel") or inst:IsA("TextButton") then
				track("FadeText", "TextTransparency")
			end
		elseif inst:IsA("UIStroke") then
			track("FadeStroke", "Transparency")
		end
		if next(props) then
			if t <= 0 then
				for prop, value in props do
					(inst :: any)[prop] = value
				end
			else
				Kit.tween(inst, t, props, OUT)
			end
		end
	end
end

-- A rounded card with a coloured header band (the band's lower corners squared off).
local function bandCard(parent: Instance, W: any, bandColor: Color3, bandFrac: number, radius: number): (Frame, Frame)
	local card = new("Frame", {
		BackgroundColor3 = W.Cream,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 10,
	}, parent)
	corner(card, radius)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, card)
	local band = new("Frame", {
		Name = "Band",
		BackgroundColor3 = bandColor,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, bandFrac),
		ZIndex = 11,
	}, card)
	corner(band, radius)
	new("Frame", {
		Name = "BandFill",
		BackgroundColor3 = bandColor,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, bandFrac),
		Size = UDim2.new(1, 0, bandFrac * 0.5, 0),
		ZIndex = 11,
	}, card)
	return card, band
end

function Ui.new(theme: any, worldParent: Instance, onSkip: () -> ()): Ui
	local W = theme.World
	local C = theme.Colors
	local F = theme.Fonts
	local player = Players.LocalPlayer

	local gui = new("ScreenGui", {
		Name = "IntroUI",
		Enabled = true,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 80,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})

	-- Letterbox bars (they slide in from the screen edges).
	local top = new("Frame", {
		Name = "BarTop",
		BackgroundColor3 = C.Ink,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.fromScale(1, BAR),
		Position = UDim2.fromScale(0, 0),
		ZIndex = 1,
	}, gui)
	local bottom = new("Frame", {
		Name = "BarBottom",
		BackgroundColor3 = C.Ink,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0),
		Size = UDim2.fromScale(1, BAR),
		Position = UDim2.fromScale(0, 1),
		ZIndex = 1,
	}, gui)

	-- Subtitle card: sized to its line in relayout, sitting just above the bottom bar.
	local caption = new("Frame", {
		Name = "Caption",
		BackgroundColor3 = W.Cream,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1 - BAR, -12),
		Size = UDim2.fromOffset(200, 54),
		Visible = false,
		ZIndex = 15,
	}, gui)
	corner(caption, 18)
	new("UIStroke", { Color = W.Ink, Thickness = 2.5, Transparency = 0.15 }, caption)
	local captionScale = new("UIScale", {}, caption)
	local captionLabel = scaledText(caption, {
		Name = "Text",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Font = F.UI,
		TextColor3 = W.Ink,
		Text = "",
		ZIndex = 16,
	}, 26)
	fadeTree(caption, false, 0)

	-- Skip: a white pill bottom-right on the letterbox bar, there from the first frame
	-- (sized and placed in _relayout).
	local skip = new("TextButton", {
		Name = "Skip",
		AutoButtonColor = false,
		BackgroundColor3 = W.White,
		BackgroundTransparency = 0.05,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1 - SAFE_X, 0, 1 - BAR / 2, 0),
		Size = UDim2.fromOffset(128, 44),
		Font = F.UI,
		TextScaled = true,
		TextColor3 = W.Ink,
		Text = theme.Intro.Skip .. "  »",
		ZIndex = 18,
	}, gui)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, skip)
	new("UIStroke", { Color = W.Ink, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, skip)
	new("UIPadding", {
		PaddingTop = UDim.new(0.2, 0),
		PaddingBottom = UDim.new(0.2, 0),
		PaddingLeft = UDim.new(0.12, 0),
		PaddingRight = UDim.new(0.12, 0),
	}, skip)
	new("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 10 }, skip)
	skip.Activated:Connect(onSkip)
	-- Gamepad: Skip takes the shared selection ring (B also skips, see Cutscene).
	pcall(Kit.selectable, skip)
	-- Touch: an invisible hit area at least 48 px each way, centred on the pill (sized in
	-- _relayout), so even the smallest pill takes a thumb.
	local skipHit = new("TextButton", {
		Name = "Hit",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Selectable = false,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(104, 48),
		ZIndex = 19,
	}, skip)
	skipHit.Activated:Connect(onSkip)

	local flashFrame = new("Frame", {
		Name = "Flash",
		BackgroundColor3 = W.White,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
	}, gui)
	local fadeFrame = new("Frame", {
		Name = "Fade",
		BackgroundColor3 = W.Cream,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
	}, gui)

	local world = new("Folder", { Name = "IntroBubbles" }, worldParent)

	local self = setmetatable({
		theme = theme,
		gui = gui,
		k = 1,
		width = 1280,
		height = 720,
		safe = Rect.new(0, 0, 1280, 720),
		top = top,
		bottom = bottom,
		caption = caption,
		captionScale = captionScale,
		captionLabel = captionLabel,
		captionText = "",
		captionToken = 0,
		skip = skip,
		skipHit = skipHit,
		nameCardGui = nil,
		titleCardGui = nil,
		flashFrame = flashFrame,
		fadeFrame = fadeFrame,
		world = world,
		tag = nil,
		tagStat = nil,
		tagPill = nil,
		tagPillScale = nil,
		statFrom = 0,
		statTo = 0,
		statStart = 0,
		statDur = 0,
		statShown = -1,
		clock = 0,
		connections = {},
	}, Ui)

	gui.Parent = player and player:FindFirstChildOfClass("PlayerGui")

	local function relayout()
		self:_relayout()
	end
	relayout()
	local camera = Workspace.CurrentCamera
	if camera then
		table.insert(self.connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(relayout))
	end
	table.insert(self.connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout))
	return self
end

-- Layout --------------------------------------------------------------------------------

-- Recomputes the screen size, safe area and scale, then re-places every screen card.
function Ui._relayout(self: Ui)
	local size = self.gui.AbsoluteSize
	if size.X < 2 or size.Y < 2 then
		local camera = Workspace.CurrentCamera
		size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	end
	if size.X < 2 or size.Y < 2 then
		size = Vector2.new(1280, 720)
	end
	local w, h = size.X, size.Y
	local insetTop = 0
	local ok, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if ok and typeof(topLeft) == "Vector2" then
		insetTop = topLeft.Y
	end
	self.width, self.height = w, h
	self.k = math.clamp(math.min(w / 1280, h / 720), 0.6, 1.6)
	self.safe = Rect.new(w * SAFE_X, math.max(h * SAFE_Y, insetTop), w * (1 - SAFE_X), h * (1 - SAFE_Y))

	-- Skip never shrinks below 112 x 40 px. It sits centred in the bottom bar; on a small
	-- phone the bar is lower than the pill, which then rises out of it.
	local k = self.k
	local skipW, skipH = math.floor(math.max(128 * k, 112)), math.floor(math.max(44 * k, 40))
	local skipY = h - math.max((h * BAR - skipH) / 2, 6) - skipH / 2
	self.skip.Size = UDim2.fromOffset(skipW, skipH)
	self.skip.Position = UDim2.new(1 - SAFE_X, 0, 0, math.floor(skipY))
	self.skipHit.Size = UDim2.fromOffset(math.max(skipW + 8, 48), math.max(skipH + 12, 48))
	setMaxText(self.skip, math.max(22 * k, 16))

	self:_layoutCaption()
	if self.nameCardGui then
		self:_layoutNameCard(self.nameCardGui)
	end
	if self.titleCardGui then
		self:_layoutTitleCard(self.titleCardGui)
	end
end

function Ui._layoutCaption(self: Ui)
	local k = self.k
	local textSize = math.floor(26 * k + 0.5)
	local padX, padY = math.floor(24 * k), math.floor(12 * k)
	local maxWidth = self.width * 0.9
	local text = if self.captionText == "" then " " else self.captionText
	local bounds = measure(text, textSize, self.theme.Fonts.UI, maxWidth - padX * 2)
	local cw = math.min(math.ceil(bounds.X) + padX * 2 + 4, maxWidth)
	local ch = math.ceil(bounds.Y) + padY * 2 + 2
	self.caption.Size = UDim2.fromOffset(cw, ch)
	self.caption.Position = UDim2.new(0.5, 0, 1 - BAR, -math.floor(12 * k))
	local label = self.captionLabel
	label.Size = UDim2.new(1, -padX * 2, 1, -padY * 2)
	setMaxText(label, textSize)
	local c = self.caption:FindFirstChildOfClass("UICorner")
	if c then
		c.CornerRadius = UDim.new(0, math.floor(math.min(18 * k, ch / 2)))
	end
end

function Ui._layoutNameCard(self: Ui, card: Frame)
	local safe, k = self.safe, self.k
	local cw = math.min(safe.Width * 0.46, 430 * k)
	local ch = cw / 2.9
	-- Upper left of the safe area (the rival stands in the right third); 8 px spare
	-- for the tilt.
	local cx = safe.Min.X + cw / 2 + 8
	local cy = math.clamp(self.height * 0.24, safe.Min.Y + ch / 2 + 8, safe.Max.Y - ch / 2 - 8)
	card.Size = UDim2.fromOffset(cw, ch)
	card.Position = UDim2.fromOffset(cx, cy)
	for _, label in card:GetDescendants() do
		if label:IsA("TextLabel") then
			setMaxText(label, (label:GetAttribute("MaxText") :: number? or 40) * k)
		end
	end
end

function Ui._layoutTitleCard(self: Ui, card: Frame)
	local safe, k = self.safe, self.k
	local cw = math.min(self.width * 0.7, safe.Width, 640 * k)
	local ch = cw * 0.26
	local cy = math.clamp(self.height * 0.36, safe.Min.Y + ch / 2, safe.Max.Y - ch / 2)
	card.Size = UDim2.fromOffset(cw, ch)
	card.Position = UDim2.fromOffset(self.width / 2, cy)
	for _, label in card:GetDescendants() do
		if label:IsA("TextLabel") then
			setMaxText(label, 64 * k)
		end
	end
end

-- Letterbox ---------------------------------------------------------------------------

function Ui.letterbox(self: Ui, on: boolean, instant: boolean?)
	local t = if instant then 0 else 0.45
	local topPos = if on then UDim2.fromScale(0, BAR) else UDim2.fromScale(0, 0)
	local bottomPos = if on then UDim2.fromScale(0, 1 - BAR) else UDim2.fromScale(0, 1)
	if t == 0 then
		self.top.Position = topPos
		self.bottom.Position = bottomPos
	else
		Kit.tween(self.top, t, { Position = topPos }, Enum.EasingStyle.Quart)
		Kit.tween(self.bottom, t, { Position = bottomPos }, Enum.EasingStyle.Quart)
	end
end

-- Captions ------------------------------------------------------------------------------

-- Shows `text` at once: the card is fully readable within ~0.2 s.
function Ui.say(self: Ui, text: string)
	self.captionToken += 1
	local caption = self.caption
	local wasShown = caption.Visible and (caption:GetAttribute("Shown") == true)
	self.captionText = text
	self.captionLabel.Text = text
	self:_layoutCaption()
	caption.Visible = true
	caption:SetAttribute("Shown", true)
	if wasShown then
		-- Swapping lines: the card stays up and gives a small pop.
		fadeTree(caption, true, 0.1)
		self.captionScale.Scale = 0.96
		Kit.tween(self.captionScale, 0.18, { Scale = 1 }, BACK)
	else
		self.captionScale.Scale = 0.9
		fadeTree(caption, true, 0.15)
		Kit.tween(self.captionScale, 0.22, { Scale = 1 }, BACK)
	end
end

function Ui.hideCaption(self: Ui)
	self.captionToken += 1
	local token = self.captionToken
	local caption = self.caption
	caption:SetAttribute("Shown", false)
	if not caption.Visible then
		return
	end
	fadeTree(caption, false, 0.22)
	task.delay(0.24, function()
		if token == self.captionToken and caption.Parent then
			caption.Visible = false
		end
	end)
end

-- Skip button ---------------------------------------------------------------------------

-- On a controller the selection sits on Skip, so A skips as well as B.
function Ui.focusSkip(self: Ui)
	if Kit.gamepad or Kit.tenFoot then
		pcall(function()
			GuiService.SelectedObject = self.skip
		end)
	end
end

-- Name card ----------------------------------------------------------------------------

-- MAX GIGA CHAD's card slams in on the right; `onLand` runs when it hits.
function Ui.nameCard(self: Ui, onLand: (() -> ())?)
	local theme = self.theme
	local W, F = theme.World, theme.Fonts
	if self.nameCardGui then
		self.nameCardGui:Destroy()
	end
	local card, band = bandCard(self.gui, W, W.Sunny, 0.56, 20)
	card.Name = "NameCard"
	card.Rotation = -3
	self.nameCardGui = card
	-- The name sits over the band but belongs to the card: the band's square-off fill is a
	-- later sibling of the band and would otherwise draw over the lower half of the letters.
	local bandFrac = band.Size.Y.Scale
	local nameLabel = scaledText(card, {
		Name = "Name",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, bandFrac * 0.52),
		Size = UDim2.fromScale(0.9, bandFrac * 0.72),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = theme.Intro.RivalName,
		ZIndex = 12,
	}, 44)
	nameLabel:SetAttribute("MaxText", 44)
	local statLabel = scaledText(card, {
		Name = "Stat",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.78),
		Size = UDim2.fromScale(0.86, 0.32),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = theme.Intro.RivalStat,
		ZIndex = 12,
	}, 32)
	statLabel:SetAttribute("MaxText", 32)
	self:_layoutNameCard(card)

	-- Slam: drops from big to a touch small, then settles with a Back overshoot.
	local cardScale = new("UIScale", { Scale = 2.2 }, card)
	fadeTree(card, false, 0)
	fadeTree(card, true, 0.1)
	Kit.tween(cardScale, 0.14, { Scale = 0.93 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.14, function()
		if card.Parent then
			Kit.tween(cardScale, 0.24, { Scale = 1 }, BACK)
			if onLand then
				onLand()
			end
		end
	end)
end

function Ui.hideNameCard(self: Ui)
	local card = self.nameCardGui
	if not card then
		return
	end
	self.nameCardGui = nil
	fadeTree(card, false, 0.28)
	Kit.tween(card, 0.3, { Position = card.Position + UDim2.fromOffset(math.floor(40 * self.k), 0) }, OUT)
	task.delay(0.32, function()
		card:Destroy()
	end)
end

-- Title card ----------------------------------------------------------------------------

function Ui.title(self: Ui, on: boolean, instant: boolean?)
	local theme = self.theme
	local W, F = theme.World, theme.Fonts
	if not on then
		local card = self.titleCardGui
		self.titleCardGui = nil
		if card then
			fadeTree(card, false, 0.28)
			task.delay(0.32, function()
				card:Destroy()
			end)
		end
		return
	end
	if self.titleCardGui then
		return
	end
	local card = new("Frame", {
		Name = "TitleCard",
		BackgroundColor3 = W.Cream,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ClipsDescendants = false,
		ZIndex = 10,
	}, self.gui)
	self.titleCardGui = card
	corner(card, 26)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, card)
	-- Candy stripe header band, inset so it sits inside the rounded corners.
	local stripes = { W.Coral, W.Sunny, W.Mint, W.Blue, W.Pink }
	local strip = new("Frame", {
		Name = "Stripes",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromScale(0.86, 0.1),
		ZIndex = 11,
	}, card)
	for i, color in stripes do
		local s = new("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromScale((i - 1) / #stripes, 0),
			Size = UDim2.new(1 / #stripes, -4, 1, 0),
			ZIndex = 11,
		}, strip)
		corner(s, 6)
	end
	scaledText(card, {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.fromScale(0.88, 0.56),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = theme.GameName,
		ZIndex = 12,
	}, 64)
	self:_layoutTitleCard(card)
	local cardScale = new("UIScale", { Scale = if instant then 1 else 0.6 }, card)
	if not instant then
		fadeTree(card, false, 0)
		fadeTree(card, true, 0.22)
		Kit.tween(cardScale, 0.4, { Scale = 1 }, BACK)
	end
end

-- Flash and fade ---------------------------------------------------------------------------

function Ui.flash(self: Ui, dur: number)
	local f = self.flashFrame
	local inTime = dur * 0.4
	Kit.tween(f, inTime, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(inTime, function()
		if f.Parent then
			Kit.tween(f, dur - inTime, { BackgroundTransparency = 1 }, OUT)
		end
	end)
end

function Ui.fade(self: Ui, on: boolean, t: number)
	Kit.tween(self.fadeFrame, t, { BackgroundTransparency = if on then 0 else 1 }, OUT)
end

-- World bubbles ----------------------------------------------------------------------------

-- A speech (or thought) bubble at `offset` (world studs) from `adornee`.
function Ui.bubble(self: Ui, adornee: BasePart, offset: Vector3, text: string, dur: number, thought: boolean?)
	local W, F = self.theme.World, self.theme.Fonts
	local textSize = 38
	local cardH = 70
	local width = math.max(96, math.ceil(measure(text, textSize, F.Display, 1000).X) + 44)
	local bb = new("BillboardGui", {
		Name = "Bubble",
		Adornee = adornee,
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 500,
		Size = UDim2.fromOffset(width + 8, cardH + 40),
		StudsOffsetWorldSpace = offset,
		ResetOnSpawn = false,
	}, self.world)
	local root = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, bb)
	local s = new("UIScale", { Scale = 0.05 }, root)
	local card = new("Frame", {
		BackgroundColor3 = W.White,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 2),
		Size = UDim2.fromOffset(width, cardH),
		ZIndex = 2,
	}, root)
	corner(card, 28)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, card)
	scaledText(card, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -24, 1, -14),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = text,
		ZIndex = 3,
	}, textSize)
	if thought then
		for i, d in { 20, 12 } do
			local dot = new("Frame", {
				BackgroundColor3 = W.White,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, (i - 1) * 10, 0, cardH + 6 + (i - 1) * 18),
				Size = UDim2.fromOffset(d, d),
				ZIndex = 2,
			}, root)
			corner(dot, d)
			new("UIStroke", { Color = W.Ink, Thickness = 2.5, Transparency = 0.1 }, dot)
		end
	else
		local tail = new("Frame", {
			BackgroundColor3 = W.White,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, cardH + 2),
			Size = UDim2.fromOffset(22, 22),
			Rotation = 45,
			ZIndex = 1,
		}, root)
		new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.1 }, tail)
	end
	Kit.tween(s, 0.28, { Scale = 1 }, BACK)
	task.delay(math.max(dur - 0.2, 0.1), function()
		if bb.Parent then
			Kit.tween(s, 0.18, { Scale = 0.05 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.2, function()
				bb:Destroy()
			end)
		end
	end)
end

-- The hero's tag: his name over an "AURA: n" pill (Sunny, turning Coral at zero).
-- Sized in studs, so it reads like a sign above his head in every shot.
-- Shows or hides the hero's tag (switched on camera cuts, so it never pops on screen).
function Ui.tagShown(self: Ui, on: boolean)
	if self.tag then
		self.tag.Enabled = on
	end
end

function Ui.heroTag(self: Ui, adornee: BasePart, height: number, name: string, aura: number)
	local W, F = self.theme.World, self.theme.Fonts
	if self.tag then
		self.tag:Destroy()
	end
	local bb = new("BillboardGui", {
		Name = "HeroTag",
		Adornee = adornee,
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 120,
		Size = UDim2.fromScale(5.2, 2.3),
		StudsOffsetWorldSpace = Vector3.new(0, height, 0),
		ResetOnSpawn = false,
	}, self.world)
	local namePill = new("Frame", {
		Name = "Name",
		BackgroundColor3 = W.White,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.7, 0.4),
	}, bb)
	corner(namePill, 999)
	new("UIStroke", { Color = W.Ink, Thickness = 2, Transparency = 0.2 }, namePill)
	scaledText(namePill, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.74),
		Font = F.UI,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = name,
	}, 40)
	local pill = new("Frame", {
		Name = "Aura",
		BackgroundColor3 = W.Sunny,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromScale(1, 0.54),
	}, bb)
	corner(pill, 999)
	new("UIStroke", { Color = W.Ink, Thickness = 3, Transparency = 0.05 }, pill)
	local pillScale = new("UIScale", {}, pill)
	local stat = scaledText(pill, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.84, 0.72),
		Font = F.Display,
		TextColor3 = W.Ink,
		TextWrapped = false,
		Text = string.format(self.theme.Intro.Stat, aura),
	}, 56)
	self.tag = bb
	self.tagStat = stat
	self.tagPill = pill
	self.tagPillScale = pillScale
	self.statFrom, self.statTo, self.statShown = aura, aura, aura
	self:_paintStat(aura)
end

-- Sunny pill with Ink text normally; Coral pill with White text at zero.
function Ui._paintStat(self: Ui, value: number)
	local W = self.theme.World
	local pill, label = self.tagPill, self.tagStat
	if pill and label then
		local zero = value <= 0
		Kit.tween(pill, 0.2, { BackgroundColor3 = if zero then W.Coral else W.Sunny }, OUT)
		label.TextColor3 = if zero then W.White else W.Ink
	end
end

-- Counts the hero's AURA tag between two values over `dur` seconds.
function Ui.countStat(self: Ui, from: number, to: number, dur: number)
	self.statFrom, self.statTo = from, to
	self.statStart = self.clock
	self.statDur = math.max(dur, 0)
end

function Ui.update(self: Ui, dt: number, onTick: (() -> ())?)
	self.clock += dt
	local label = self.tagStat
	if not label then
		return
	end
	local u = if self.statDur > 0 then math.clamp((self.clock - self.statStart) / self.statDur, 0, 1) else 1
	local value = math.floor(self.statFrom + (self.statTo - self.statFrom) * u + 0.5)
	if value ~= self.statShown then
		self.statShown = value
		label.Text = string.format(self.theme.Intro.Stat, value)
		self:_paintStat(value)
		local pillScale = self.tagPillScale
		if pillScale then
			pillScale.Scale = 1.12
			Kit.tween(pillScale, 0.15, { Scale = 1 }, OUT)
		end
		if onTick then
			onTick()
		end
	end
end

function Ui.destroy(self: Ui)
	for _, c in self.connections do
		c:Disconnect()
	end
	pcall(function()
		if GuiService.SelectedObject == self.skip then
			GuiService.SelectedObject = nil
		end
	end)
	self.captionToken += 1
	self.gui:Destroy()
	self.world:Destroy()
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="248">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI and routes server messages.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Client = script.Parent
local State = require(Client.State)
local Sounds = require(Client.Sounds)
local Guide = require(Client.Guide)
local Kit = require(Client.UI.Kit)
local Animator = require(Client.Animator)
local Hud = require(Client.UI.Hud)
local Windows = require(Client.UI.Windows)
local Popups = require(Client.UI.Popups)
local Tutorial = require(Client.UI.Tutorial)
local MogHud = require(Client.UI.MogHud)
local CardioHud = require(Client.UI.CardioHud)
local ObbyHud = require(Client.UI.ObbyHud)

-- The opening cutscene (optional: the game runs without it if it fails to load).
local introOk, Cutscene = pcall(require, Client.Intro.Cutscene)
if not introOk then
	warn("[Intro] failed to load: " .. tostring(Cutscene))
	Cutscene = nil
end

local player = Players.LocalPlayer
local C = Theme.Colors
local I = Theme.Icons

local screen = Instance.new("ScreenGui")
screen.Name = "TycoonUI"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.IgnoreGuiInset = false
pcall(function()
	-- Keep clear of the Roblox top bar buttons and device notches.
	screen.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
end)
screen.Parent = player:WaitForChild("PlayerGui")

-- Scale the whole UI from a 1280x720 design size. Touch screens get a little
-- extra so buttons stay comfortably tappable; a TV (10-foot console, or a
-- gamepad on a big screen) gets extra for the viewing distance and may go up
-- to 3x on 4K; short screens switch the HUD to its compact layout.
local uiScale = Instance.new("UIScale")
uiScale.Parent = screen
local function rescale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	local topInset = 58
	pcall(function()
		local topLeft = GuiService:GetGuiInset()
		topInset = topLeft.Y
	end)
	local fit = math.min(size.X / 1280, size.Y / 720)
	if Kit.touch then
		fit *= 1.15
	elseif Kit.tenFoot or (Kit.gamepad and size.X >= 1600) then
		fit *= 1.12
	end
	uiScale.Scale = math.clamp(fit, 0.5, if Kit.tenFoot then 3 else 1.5)
	screen:SetAttribute("Compact", (size.Y - topInset) / uiScale.Scale < 600)
	-- Text held at a size on the glass (Kit.holdText) follows the new scale, once the
	-- windows have re-fitted.
	task.defer(Kit.reflowText)
end
-- The viewport is not sized yet in the first frames of a session (it reads 1 x 1): wait for
-- it, or everything built below would be measured for the smallest scale.
do
	local started = os.clock()
	while os.clock() - started < 5 do
		local camera = Workspace.CurrentCamera
		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
end
rescale()
-- Kit.px reads the design scale from here, also for labels built off screen.
Kit.pixelScale(screen)
-- Modules that only hold the ScreenGui read the input mode from its Input attribute.
Kit.onInput(function(mode)
	screen:SetAttribute("Input", mode)
	rescale()
end)
-- Console navigation: the D-pad / left stick moves the selection between buttons.
pcall(function()
	GuiService.AutoSelectGuiEnabled = true
end)
pcall(function()
	GuiService.GuiNavigationEnabled = true
end)
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(rescale)
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end

Kit.setSoundPlayer(function(name)
	Sounds.play(name)
end)

Animator.start()
Popups.build(screen, Sounds)
Windows.build(screen)
MogHud.build(screen)
CardioHud.build(screen)
-- The Modes window's MOG TEST PLAY opens the VS RIVALS / 1v1 DUEL picker.
Windows.onMogPlay = MogHud.choose
Guide.build()
Hud.build(screen, {
	openWindow = Windows.open,
	toast = Popups.toast,
	guide = function(target)
		Guide.navigate(target, "CLAIM!", 45)
	end,
}, Sounds)
-- The sky obby's rainbow progress bar, stage counter, skip button and gear hotbar.
-- Hud's run pill docks into its row; its gear hotbar rides on Hud's dumbbell.
ObbyHud.build(screen, { sounds = Sounds, dockRun = Hud.dockRun, tank = Hud.tank })
-- Last "Cash" effect: the tutorial reward waits for the wallet count-up.
local lastCashAt = 0

Tutorial.build(screen, {
	popups = Popups,
	sounds = Sounds,
	guide = Guide,
	walletIdle = function(): boolean
		return os.clock() - lastCashAt >= 1.5 and Hud.walletIdle()
	end,
	highlight = function(name, on)
		local button = Hud.buttons[name]
		if button then
			Kit.setGlow(button, on)
		end
	end,
})

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- The intro hides the default player list while it plays; registering it as a
-- reason keeps windows that close mid-intro from showing the list again.
player:GetAttributeChangedSignal("IntroPlaying"):Connect(function()
	Kit.hidePlayerList("intro", player:GetAttribute("IntroPlaying") == true)
end)
-- The loading screen hides the list too (the loader sets "Loading" before this
-- script exists); as a reason here, the list comes back once it has faded out.
local function loadingList()
	Kit.hidePlayerList("loading", player:GetAttribute("Loading") == true)
end
player:GetAttributeChangedSignal("Loading"):Connect(loadingList)
loadingList()

local action = Net.event("Action")

-- Plays the intro once, after the first snapshot, for players who haven't seen
-- it (the server sets the "IntroSeen" attribute before that snapshot). The
-- loading screen fades out over its first shot.
local introChecked = false
local function maybePlayIntro()
	if introChecked or not Cutscene then
		return
	end
	introChecked = true
	task.spawn(function()
		local waited = 0
		while player:GetAttribute("IntroSeen") == nil and waited < 3 do
			waited += task.wait(0.1)
		end
		if player:GetAttribute("IntroSeen") ~= false then
			return
		end
		-- Start after the loading screen (ReplicatedFirst) has faded out, not under it.
		local playerGui = player:WaitForChild("PlayerGui")
		while playerGui:FindFirstChild("LoadingScreen") and waited < 50 do
			waited += task.wait(0.1)
		end
		Cutscene.play({
			delay = 0.6,
			onDone = function(skipped: boolean, watched: number)
				action:FireServer({ action = "IntroSeen", skipped = skipped, seconds = watched })
			end,
		})
	end)
end

-- Studio-only capture hook: setting the LocalPlayer attribute "IntroPreview" to
-- "<beat>,<pauseSeconds>" replays the intro paused inside that beat.
if RunService:IsStudio() and Cutscene then
	player:GetAttributeChangedSignal("IntroPreview"):Connect(function()
		local spec = player:GetAttribute("IntroPreview")
		if typeof(spec) ~= "string" or spec == "" then
			return
		elseif spec == "skip" then
			Cutscene.skip()
			return
		end
		local beat, pause = string.match(spec, "^(%d+),?([%d%.]*)$")
		if beat then
			if Cutscene.isPlaying() then
				Cutscene.skip()
				task.wait(0.6)
			end
			-- Deferred so the Studio MCP's camera reset after execute_luau runs first.
			task.wait(0.8)
			Cutscene.preview(tonumber(beat) :: number, tonumber(pause))
		end
	end)
end
-- Studio-only capture hook: "UiPreview" = "<WindowName>", "Shop,<focus>", "close", "starter" or "reward,<tier>".
if RunService:IsStudio() then
	player:GetAttributeChangedSignal("UiPreview"):Connect(function()
		local spec = player:GetAttribute("UiPreview")
		if typeof(spec) ~= "string" or spec == "" then
			return
		end
		local tier = string.match(spec, "^reward,(%d+)$")
		if tier then
			Popups.reward({ kind = "Reward", tier = tonumber(tier), tiers = { tonumber(tier) }, new = true })
		elseif spec == "close" then
			Windows.closeAll()
			Popups.closeModals()
		elseif spec == "starter" then
			Popups.starterOffer()
		elseif string.match(spec, "^Shop,") then
			Windows.open("Shop", { focus = string.sub(spec, 6) })
		else
			Windows.open(spec)
		end
	end)
end

Net.event("State").OnClientEvent:Connect(function(data)
	State.set(data)
	CardioHud.onState(data)
	maybePlayIntro()
	Sounds.updateMusic()
	if data.freeIn and data.freeIn > 0 then
		Guide.clearNavigate("Free")
	end
	-- Tells the loading screen (ReplicatedFirst) that the game is ready.
	if player:GetAttribute("GameReady") ~= true then
		player:SetAttribute("GameReady", true)
	end
end)

Net.event("Notify").OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	if payload.kind == "Toast" then
		Popups.toast(payload.text, payload.tone)
	elseif payload.kind == "Reward" then
		Popups.reward(payload)
	elseif payload.kind == "Offline" then
		Popups.offline(payload)
	elseif payload.kind == "Confirm" then
		Popups.confirm(payload.text, function()
			action:FireServer(payload.action)
		end)
	elseif payload.kind == "Tutorial" then
		Tutorial.onNotify(payload)
	elseif payload.kind == "Mode" and payload.mode == "mog" then
		-- MOG TEST (vs rivals or a 1v1 duel): the picker, queue panel, ring, HP and finish card
		-- (Fx.Mog does the 3D side).
		MogHud.onNotify(payload)
		if payload.event == "stop" and payload.reason == "full" then
			-- All six duel spots are taken: the test never started.
			Popups.toast("The Mog stage is full right now, try again in a moment", "info")
		end
	elseif payload.kind == "Mode" and payload.mode == "cardio" then
		-- CARDIO (keyboard runner): speed counter, stage strip, cards and banners
		-- (Fx.Cardio does the 3D side).
		CardioHud.onNotify(payload)
	elseif payload.kind == "Mode" then
		-- Game-mode runs: the HUD run pill and the finish card (Fx.Modes does the 3D side).
		local event = payload.event
		if event == "pick" then
			-- Walked through gate 1's portal: pick a map (opening the window plays "Open").
			Windows.openMaps(tonumber(payload.level))
		elseif event == "start" then
			-- A run teleports the player onto the course: no window (the map picker, the
			-- Modes window) may stay up over it.
			Windows.closeAll()
			if payload.mode == "parkour" then
				-- The obby HUD owns the top centre for the run: the tycoon's counter, deposit
				-- strip, quest pill, promo and FREE gift step aside; it docks the run pill
				-- before the pill slides in.
				Hud.setObbyMode(true)
				ObbyHud.show(tonumber(payload.stage), tonumber(payload.stageCount))
			end
			Hud.runStart(
				tonumber(payload.startedAt) or workspace:GetServerTimeNow(),
				0,
				tonumber(payload.checkpoints) or 0,
				tonumber(payload.level)
			)
			Sounds.play("Ready")
		elseif event == "checkpoint" then
			Hud.runCheckpoint(tonumber(payload.index) or 0, tonumber(payload.checkpoints) or 0)
			if payload.stage ~= nil then
				ObbyHud.setStage(tonumber(payload.stage), tonumber(payload.stageCount))
			end
			Sounds.play("Step")
		elseif event == "respawn" then
			-- Fell through the clouds (or touched lava): back to the start of the map, the run goes on.
			if payload.stage ~= nil then
				ObbyHud.setStage(tonumber(payload.stage), tonumber(payload.stageCount))
			end
			if payload.reason == "kill" then
				Sounds.play("Error")
				Popups.toast("Ouch! Back to the start of the map", "bad")
			end
		elseif event == "skip" then
			-- Paid a map skip: on to the next map (the run is now assisted).
			ObbyHud.setStage(tonumber(payload.stage), tonumber(payload.stageCount))
			if payload.index ~= nil then
				Hud.runCheckpoint(tonumber(payload.index) or 0, tonumber(payload.checkpoints) or 0)
			end
			Sounds.play("Step")
		elseif event == "finish" then
			Hud.setObbyMode(false)
			Hud.runStop()
			ObbyHud.hide()
			-- "Run again" replays the same level; "Next level" starts the one just unlocked;
			-- "Choose map" opens the Maps window on the next level (or this one).
			local onPick = if payload.mode == "parkour"
				then function()
					Windows.openMaps(tonumber(payload.nextLevel) or tonumber(payload.level))
				end
				else nil
			Popups.modeFinish(payload, function()
				action:FireServer({ action = "ModeStart", mode = payload.mode, level = tonumber(payload.level) })
			end, function()
				action:FireServer({ action = "Home" })
			end, function()
				action:FireServer({ action = "ModeStart", mode = payload.mode, level = tonumber(payload.nextLevel) })
			end, onPick)
		elseif event == "invalid" then
			Hud.setObbyMode(false)
			Hud.runStop()
			ObbyHud.hide()
			Popups.toast(
				if payload.reason == "fast" then "Whoa, too fast! Try the course again" else "Something went wrong, try the map again",
				"info"
			)
		elseif event == "stop" then
			Hud.setObbyMode(false)
			Hud.runStop()
			ObbyHud.hide()
			if payload.reason == "left" then
				Popups.toast("You left the course. Run ended", "info")
			elseif payload.reason == "respawn" then
				Popups.toast("Run reset. Hop back in at the gate!", "info")
			elseif payload.reason == "quit" then
				Popups.toast("Run ended", "info")
			end
		end
	end
end)

-- Floating "+X" anchors: beside the HUD dumbbell (bottom centre) and above the
-- cash amount (bottom left).
local TANK = UDim2.new(0.5, 170, 1, -90)
local WALLET = UDim2.new(0, 150, 1, -110)

-- Sounds for effects owned by the UI. Fx modules (Client.Fx.*) listen to the
-- same remote for their 3D work and their own sounds (OrbPickup, MergeCharge,
-- MergeBoom, BuyPop): no sound here for "Merge".
Net.event("Effect").OnClientEvent:Connect(function(kind, data)
	data = if type(data) == "table" then data else {}
	if kind == "Collect" then
		-- Silent: Fx.Orbs already popped for each pickup.
		Hud.pulseTank()
		Popups.float("+" .. I.Orb .. Format.short(data.amount or 0), C.Orb, TANK)
	elseif kind == "Cash" then
		-- Auto Cash pays out every few seconds: no sound, float or coin burst for it, the
		-- wallet number simply rolls up.
		if data.source == "Auto" then
			return
		end
		local amount = if type(data.amount) == "number" then data.amount else 0
		lastCashAt = os.clock()
		if data.source == "Purchase" then
			-- Developer-product cash pack: full-screen celebration (plays its own sounds).
			Popups.purchase(amount)
			Hud.coinBurst(amount, nil)
			return
		end
		if data.source == "Daily" then
			-- Daily reward: the amount pops over the Daily window and the coins fly out of it.
			Sounds.play("Cash")
			Popups.float("+" .. Format.money(amount), C.Good, UDim2.fromScale(0.5, 0.42))
			Hud.coinBurst(amount, nil, nil)
			return
		end
		Sounds.play("Cash")
		Popups.float("+" .. Format.money(amount), C.Good, WALLET)
		-- Claimed from the Free menu button: coins fly from the button.
		local fromMenu = data.source == "Free" and os.clock() - Hud.freeClaimedAt < 3
		Hud.coinBurst(amount, if typeof(data.padPos) == "Vector3" then data.padPos else nil, if fromMenu then Hud.buttons.Free else nil)
	elseif kind == "Pad" then
		-- Fx.Machines plays the deny sound and pad wobble; the wallet shake
		-- guards against double calls.
		if data.ok == false and data.reason == "money" then
			Hud.shakeWallet()
		end
	elseif kind == "AuraGrant" then
		-- Aura pack: orbs fly into the tank (the server sends the "+X aura" toast).
		Hud.orbBurst(if type(data.amount) == "number" then data.amount else 0)
	elseif kind == "Deposit" then
		Sounds.play("Deposit")
		-- `amount` is the aura queued in the converter; the deposit multiplier's part is `bonus`,
		-- cash paid at once (Economy.depositSplit), so the float names it as cash.
		local text = I.Orb .. Format.short(if type(data.amount) == "number" then data.amount else 0)
		if type(data.bonus) == "number" and data.bonus >= 1 then
			text ..= "  +" .. Format.money(data.bonus) .. " bonus"
		end
		Popups.float(text, C.Primary, TANK)
	elseif kind == "Buy" then
		Sounds.play("Buy", 0.1)
	elseif kind == "Merge" then
		Popups.noteMerge()
	elseif kind == "Upgrade" then
		Sounds.play("Upgrade")
	elseif kind == "ChestOpen" then
		-- The crate reveal (Popups) plays its own shake/burst sounds.
		Popups.noteChestOpen(data.rarity)
	elseif kind == "ChestPickup" then
		Sounds.play("Pickup")
	elseif kind == "CardioSteps" then
		CardioHud.onSteps(data)
	end
end)

-- 3D effect modules (built by other streams; any may be missing or fail).
local fxFolder = Client:FindFirstChild("Fx")
if fxFolder then
	for _, name in
		{
			"Camera",
			"Shelf",
			"Orbs",
			"Machines",
			"Crates",
			"Fans",
			"Ambient",
			"Plates",
			"Cosmetics",
			"Modes",
			"Mog",
			"Surge",
			"Cardio",
			"CardioChase",
			"Interactive",
		}
	do
		local moduleScript = fxFolder:FindFirstChild(name)
		if moduleScript and moduleScript:IsA("ModuleScript") then
			local ok, err = pcall(function()
				local fx = require(moduleScript) :: any
				if type(fx) == "table" and type(fx.init) == "function" then
					fx.init()
				end
			end)
			if not ok then
				warn("[Fx] " .. name .. " failed: " .. tostring(err))
			end
		end
	end
end

-- Ask for a fresh snapshot now that every listener is connected.
action:FireServer({ action = "Sync" })
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="249">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[-- Sound effects plus background music.
--
-- Every name has a list of candidate sound ids (primary first). All ids below
-- were verified to load in the client (IsLoaded, TimeLength > 0). Each candidate
-- is still preloaded once at runtime; one that fails to load (moderation,
-- missing asset, timeout) is skipped in favour of the next. Until any candidate
-- is confirmed, the first one not known to have failed plays (it streams in).
--
-- Sources: Roblox-made UI sounds (creator "Roblox"), the licensed APM / Pro
-- Sound Effects libraries, this game's own uploads, and free public Creator
-- Store audio. The only bundled client file used is volume_slider.ogg (a soft
-- tick, shipped with every client) as a last resort for UI clicks.
--
-- Sounds.play(name, pitchJitter?, pitchMult?): unknown names are a no-op.
-- Sounds.updateMusic(): starts/stops the music per settings.music. The music is a
-- playlist: each track plays once, then the next in a shuffled order (reshuffled
-- when it runs out, never the same track twice in a row).
-- Sounds.setMood("surge" | nil): during an Aura Surge the music cross-fades (1 s)
-- to the surge playlist (Theme.SurgeMusicId, else SURGE_MUSIC; each surge starts
-- the next track) and back, resuming the normal track where it paused. With no
-- surge track loaded yet the normal track just speeds up for the surge. Music
-- off stays off; the mood waits while the intro cutscene plays.

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local State = require(script.Parent.State)

local Sounds = {}

local function lib(id: number): string
	return "rbxassetid://" .. id
end

-- Bundled with the client (content/sounds); always available.
local BUNDLED_TICK = "rbxasset://sounds/volume_slider.ogg"

-- Roblox-made UI sounds.
local UI_SMALL_CLICK = lib(15675032796) -- Roblox_UI_Small_Click
local UI_BRIGHT_CLICK = lib(15675059323) -- Roblox_UI_Bright_Click
local UI_CUTE_POP = lib(15675055424) -- Roblox_UI_Cute_Pop
local UI_TONAL_STINGER = lib(15675043410) -- Roblox_UI_Tonal_Stinger
local UI_WHOOSH_01 = lib(15675024286) -- Roblox_UI_Whoosh_01
local UI_DELETE = lib(15675075163) -- Roblox_UI_Delete
local GUI_SELECT = lib(17208396156) -- Roblox GUI - Select
local GUI_NOTIFY_HIGH = lib(17208361335) -- Roblox GUI - Notification High
local GUI_BUBBLE = lib(17208204604) -- Roblox GUI - Bubble
local GUI_BACK = lib(17208186900) -- Roblox GUI - Back
local GUI_ACCEPT = lib(17208209318) -- Roblox GUI - Call Accept
local GUI_DECLINE = lib(17208214688) -- Roblox GUI - Call Decline
local GUI_PURCHASE = lib(17208380755) -- Roblox GUI - Purchase

-- Pro Sound Effects library.
local WHOOSH_ZOOM = lib(9125648149) -- Magic Zoom Up Sharp Tubular Whoosh

-- Free public Creator Store audio.
local KACHING = lib(134208887292061) -- cash-register-kaching
local COIN_COLLECT = lib(135483737426662) -- Coin Collect
local ERROR_BUZZ = lib(91501650514390) -- Error Buzz

-- This game's own uploads.
local POP_MARIMBA = lib(82880781602391)
local POP_BELL = lib(108513451493306)
local TICK_A = lib(95444478167276)
local TICK_B = lib(104556737710683)
local TICK_C = lib(111480305904301)
local CRACKLE_A = lib(130988843893972)
local CRACKLE_B = lib(109769434232691)
local HIT_A = lib(132346841133984)
local HIT_B = lib(83739861834001)
local HIT_C = lib(112084716984188)
local LEVELUP = lib(139915238370208)
local FRENZY_START = lib(87726512735006)
local RING_A = lib(131720940448187)
local RING_B = lib(102704930703884)
local UNLOCK_STINGER = lib(121068318613723)
local CEREMONY_COMMON = lib(75797999851350)
local CEREMONY_EPIC = lib(100965222685530)
local CEREMONY_LEGENDARY = lib(85196226744574)
-- CARDIO step sound: "keyboard click" by Telemest (public Creator Store audio, one
-- stroke in a 0.65 s clip), picked by the owner on 2026-10-07.
local KEY_CLICK = lib(96591611478915)

-- Funk / disco APM library tracks (licensed for every experience). The playlist
-- when the theme leaves MusicId empty.
local DEFAULT_MUSIC = {
	lib(1839889634), -- APM "Work Out"
	lib(9038367768), -- APM "Funky Disco Beats"
	lib(1843481682), -- APM "Flash Funk"
	lib(1843481858), -- APM "Funk Jam"
	lib(1839686686), -- APM "So Groovy"
	lib(1839802242), -- APM "Bouncy Funk"
	lib(1835725225), -- APM "Disco Sapiens"
	lib(1847605088), -- APM "Retro Funk"
	lib(9042511427), -- APM "Downtown Swagger C"
}
-- Harder APM tracks for an Aura Surge, when the theme leaves SurgeMusicId empty.
local SURGE_MUSIC = {
	lib(1847444965), -- APM "Party Hype A"
	lib(1839890308), -- APM "Football Frenzy"
	lib(1839705126), -- APM "Hype"
	lib(1845056062), -- APM "Pump It Up (a)"
	lib(9043939853), -- APM "Big Muscles A"
	lib(1837110694), -- APM "Skyhook"
	lib(1840321644), -- APM "Rave!"
}
local MUSIC_VOLUME = 0.18
-- Aura Surge music: cross-fade time, the surge track's loudness, and the speed
-- of the normal track when it has to double as the surge track.
local MOOD_FADE = 1
local SURGE_VOLUME = MUSIC_VOLUME * 1.15
local SURGE_SOLO_SPEED = 1.15

-- `rotate` names pick a random loaded candidate on each play.
type Def = {
	ids: { string },
	volume: number,
	pitch: number?,
	gap: number?,
	rotate: boolean?,
}

local DEFS: { [string]: Def } = {
	-- UI
	Click = { ids = { UI_SMALL_CLICK, GUI_SELECT, BUNDLED_TICK }, volume = 0.45 },
	Toggle = { ids = { UI_BRIGHT_CLICK, GUI_SELECT, BUNDLED_TICK }, volume = 0.45 },
	Toast = { ids = { GUI_NOTIFY_HIGH, GUI_BUBBLE }, volume = 0.25, gap = 0.05 },
	Error = { ids = { ERROR_BUZZ, GUI_DECLINE, UI_DELETE }, volume = 0.35 },
	Open = { ids = { WHOOSH_ZOOM, UI_WHOOSH_01 }, volume = 0.18 },
	Close = { ids = { GUI_BACK, WHOOSH_ZOOM }, volume = 0.3, pitch = 1.1 },
	Step = { ids = { GUI_ACCEPT, POP_BELL }, volume = 0.5 },
	Reward = { ids = { CEREMONY_COMMON, UI_TONAL_STINGER }, volume = 0.55 },
	Celebrate = { ids = { CEREMONY_EPIC, CEREMONY_COMMON }, volume = 0.6 },
	CelebrateLegendary = { ids = { CEREMONY_LEGENDARY, CEREMONY_EPIC }, volume = 0.7 },
	-- Economy
	Collect = { ids = { POP_MARIMBA, COIN_COLLECT }, volume = 0.3, gap = 0.05 },
	Cash = { ids = { KACHING, GUI_PURCHASE }, volume = 0.35, gap = 0.1 },
	Coin = { ids = { POP_MARIMBA, COIN_COLLECT }, volume = 0.28, gap = 0.045 },
	-- One soft pop when the Deposit pad banks your aura.
	Deposit = { ids = { UI_CUTE_POP, POP_BELL }, volume = 0.5, gap = 0.15 },
	Buy = { ids = { GUI_PURCHASE, KACHING }, volume = 0.5 },
	BuyPop = { ids = { POP_BELL, UI_CUTE_POP }, volume = 0.45 },
	Upgrade = { ids = { LEVELUP, UNLOCK_STINGER }, volume = 0.45 },
	Pickup = { ids = { GUI_BUBBLE, UI_CUTE_POP }, volume = 0.45 },
	-- Orbs
	OrbPickup = { ids = { UI_CUTE_POP, POP_BELL }, volume = 0.35, gap = 0.08 },
	-- Merges
	MergeCharge = { ids = { CRACKLE_A, CRACKLE_B }, volume = 0.4 },
	MergeBoom = { ids = { HIT_A, HIT_B, HIT_C }, volume = 0.55, rotate = true },
	-- Machines
	Ready = { ids = { RING_A, RING_B }, volume = 0.6 },
	Tick = { ids = { TICK_A, TICK_B, TICK_C, BUNDLED_TICK }, volume = 0.35, gap = 0.03, rotate = true },
	-- Events (SurgeStart is the intro cutscene's sting; the live surge itself is silent)
	SurgeStart = { ids = { FRENZY_START, UNLOCK_STINGER }, volume = 0.7 },
	CrateShake = { ids = { CRACKLE_B, CRACKLE_A }, volume = 0.55 },
	CrateBurst = { ids = { UNLOCK_STINGER, CEREMONY_COMMON }, volume = 0.6 },
	-- CARDIO keyboard floor: one key press per step (callers add pitch jitter for variety)
	KeyClick = { ids = { KEY_CLICK, BUNDLED_TICK }, volume = 0.85, gap = 0.05 },
}

local PRELOAD_TIMEOUT = 6

-- Load status per sound id: nil = unknown, "pending", "ok", "failed".
local status: { [string]: string } = {}
-- One Sound instance per name holding the currently chosen id.
local instances: { [string]: Sound } = {}
local lastPlayed: { [string]: number } = {}

local function probe(id: string)
	if status[id] ~= nil then
		return
	end
	status[id] = "pending"
	task.spawn(function()
		local probeSound = Instance.new("Sound")
		probeSound.SoundId = id
		probeSound.Volume = 0
		probeSound.Parent = SoundService
		local result = "failed"
		local done = false
		task.delay(PRELOAD_TIMEOUT, function()
			done = true
		end)
		task.spawn(function()
			local ok = pcall(function()
				ContentProvider:PreloadAsync({ probeSound }, function(_, fetch)
					if fetch == Enum.AssetFetchStatus.Success then
						result = "ok"
					end
				end)
			end)
			if not ok then
				result = "failed"
			end
			done = true
		end)
		while not done do
			task.wait(0.1)
		end
		if result == "ok" and not (probeSound.IsLoaded and probeSound.TimeLength > 0) then
			-- Preload succeeded but the Sound must also report a playable length.
			result = "failed"
		end
		status[id] = result
		probeSound:Destroy()
	end)
end

-- Best id right now: a confirmed candidate (random among them for `rotate`),
-- else the first candidate not known to have failed. Nil when all failed.
local function chooseId(ids: { string }, rotate: boolean?): string?
	for _, id in ids do
		probe(id)
	end
	if rotate then
		local ready = {}
		for _, id in ids do
			if status[id] == "ok" and string.sub(id, 1, 11) ~= "rbxasset://" then
				table.insert(ready, id)
			end
		end
		if #ready > 0 then
			return ready[math.random(1, #ready)]
		end
	end
	for _, id in ids do
		if status[id] == "ok" then
			return id
		end
	end
	for _, id in ids do
		if status[id] ~= "failed" then
			return id
		end
	end
	return nil
end

local function sfxEnabled(): boolean
	local data = State.data
	return not data or not data.settings or data.settings.sfx ~= false
end

local function playNow(name: string, pitchJitter: number?, pitchMult: number?)
	local entry = DEFS[name]
	if not entry or not sfxEnabled() then
		return
	end
	local now = os.clock()
	if entry.gap and now - (lastPlayed[name] or 0) < entry.gap then
		return
	end
	lastPlayed[name] = now
	local id = chooseId(entry.ids, entry.rotate)
	if not id then
		return
	end
	local sound = instances[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Sfx_" .. name
		sound.Parent = SoundService
		instances[name] = sound
	end
	if sound.SoundId ~= id then
		sound.SoundId = id
	end
	sound.Volume = entry.volume
	local pitch = (entry.pitch or 1) * (pitchMult or 1)
	if pitchJitter then
		pitch += (math.random() - 0.5) * pitchJitter
	end
	sound.PlaybackSpeed = math.max(0.1, pitch)
	SoundService:PlayLocalSound(sound)
end

-- While the intro cutscene plays (LocalPlayer attribute "IntroPlaying"), gameplay sounds
-- stay silent: the tycoon keeps running behind it and its merges and pickups would leak in.
local function introPlaying(): boolean
	return Players.LocalPlayer:GetAttribute("IntroPlaying") == true
end

function Sounds.play(name: string, pitchJitter: number?, pitchMult: number?)
	if introPlaying() then
		return
	end
	playNow(name, pitchJitter, pitchMult)
end

-- For the cutscene's own sounds, which are the only ones heard while it plays.
function Sounds.playCutscene(name: string, pitchJitter: number?, pitchMult: number?)
	playNow(name, pitchJitter, pitchMult)
end

-- A shuffled play order over `ids`; `pos` is the last track handed out.
type Playlist = { ids: { string }, order: { string }, pos: number }

local function newPlaylist(ids: { string }): Playlist
	return { ids = ids, order = {}, pos = 0 }
end

-- The track the playlist hands out next. A used-up order is reshuffled, with the
-- track that just played moved off the front so it never plays twice in a row.
local function peek(list: Playlist): string
	if list.pos >= #list.order then
		local last = list.order[#list.order]
		local order = table.clone(list.ids)
		for i = #order, 2, -1 do
			local j = math.random(1, i)
			order[i], order[j] = order[j], order[i]
		end
		if #order > 1 and order[1] == last then
			order[1], order[#order] = order[#order], order[1]
		end
		list.order = order
		list.pos = 0
	end
	return list.order[list.pos + 1]
end

-- Hands out the next track, skipping ones that failed to load, and starts loading
-- the one after it. A track still loading is handed out anyway (it streams in)
-- unless `loadedOnly`, which then returns nil and keeps it for later. Nil when
-- every track failed.
local function nextTrack(list: Playlist, loadedOnly: boolean?): string?
	for _ = 1, #list.ids do
		local id = peek(list)
		probe(id)
		local state = status[id]
		if state == "failed" then
			list.pos += 1
		elseif state == "ok" or not loadedOnly then
			list.pos += 1
			probe(peek(list))
			return id
		else
			return nil
		end
	end
	return nil
end

local mainList = newPlaylist(if Theme.MusicId ~= "" then { Theme.MusicId } else DEFAULT_MUSIC)
local surgeMusicId: string = (Theme :: any).SurgeMusicId or ""
local surgeList = newPlaylist(if surgeMusicId ~= "" then { surgeMusicId } else SURGE_MUSIC)

-- Kick off loading of every sound effect and the first surge track early (the
-- music loads its tracks one ahead as it goes).
task.defer(function()
	for _, entry in DEFS do
		for _, id in entry.ids do
			probe(id)
		end
	end
	probe(peek(surgeList))
end)

local music: Sound? = nil

-- Every music track plays through this group, so a mode can turn the music down
-- (Sounds.setMusicDuck) without fighting the per-track cross-fades.
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "MusicGroup"
musicGroup.Volume = 1
musicGroup.Parent = SoundService
local duckTween: Tween? = nil

-- Music mood ("surge" or nil) and how the surge music is playing right now:
-- "track" = a second Sound (surgeMusic) with the normal track paused under it,
-- "speed" = the normal track itself sped up; nil = normal music.
local mood: string? = nil
local surgeMode: string? = nil
local surgeMusic: Sound? = nil

-- The running cross-fade per Sound (a new fade replaces it).
local fades: { [Sound]: Tween } = {}

local function fade(sound: Sound, props: { [string]: any }): Tween
	local old = fades[sound]
	if old then
		old:Cancel()
	end
	local tween = TweenService:Create(sound, TweenInfo.new(MOOD_FADE, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), props)
	fades[sound] = tween
	tween:Play()
	return tween
end

local function cancelFades()
	for _, tween in fades do
		tween:Cancel()
	end
	table.clear(fades)
end

local function enterSurge(m: Sound)
	-- A surge track still fading out from the last surge just carries on.
	local s = surgeMusic
	local carryOn = s ~= nil and s.IsPlaying and status[s.SoundId] == "ok"
	local id = if carryOn then (s :: Sound).SoundId else nextTrack(surgeList, true)
	if not id then
		surgeMode = "speed"
		fade(m, { PlaybackSpeed = SURGE_SOLO_SPEED, Volume = SURGE_VOLUME })
		return
	end
	surgeMode = "track"
	if not s then
		local sound = Instance.new("Sound")
		sound.Name = "MusicSurge"
		sound.SoundGroup = musicGroup
		sound.Parent = SoundService
		sound.Ended:Connect(function()
			if surgeMode ~= "track" then
				return
			end
			local nextId = nextTrack(surgeList, true)
			if nextId then
				sound.SoundId = nextId
				sound.TimePosition = 0
				sound:Play()
			elseif music then
				-- The next surge track is still loading: the normal track speeds up instead.
				surgeMode = "speed"
				music:Resume()
				fade(music, { PlaybackSpeed = SURGE_SOLO_SPEED, Volume = SURGE_VOLUME })
			end
		end)
		surgeMusic = sound
		s = sound
	end
	local surgeSound = s :: Sound
	if surgeSound.SoundId ~= id then
		surgeSound:Stop()
		surgeSound.SoundId = id
	end
	surgeSound.Volume = 0
	if not surgeSound.IsPlaying then
		surgeSound:Play()
	end
	fade(surgeSound, { Volume = SURGE_VOLUME })
	fade(m, { Volume = 0 }).Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and surgeMode == "track" then
			m:Pause()
		end
	end)
end

local function leaveSurge(m: Sound)
	local wasTrack = surgeMode == "track"
	surgeMode = nil
	if not m.IsPlaying then
		m:Resume()
	end
	fade(m, { Volume = MUSIC_VOLUME, PlaybackSpeed = 1 })
	local s = surgeMusic
	if wasTrack and s then
		fade(s, { Volume = 0 }).Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and surgeMode == nil then
				s:Stop()
			end
		end)
	end
end

-- Music off: everything stops at once and the next start is the normal track.
local function stopAll(m: Sound)
	surgeMode = nil
	cancelFades()
	if surgeMusic then
		surgeMusic:Stop()
	end
	m:Stop()
	m.Volume = MUSIC_VOLUME
	m.PlaybackSpeed = 1
end

-- Called on every state update: also skips to the next track if the current one
-- turned out not to load.
function Sounds.updateMusic()
	local data = State.data
	local enabled = not data or not data.settings or data.settings.music ~= false
	if not music and not enabled then
		return
	end
	local current = if music then music.SoundId else ""
	local id = if current ~= "" and status[current] ~= "failed" then current else nextTrack(mainList)
	if not music then
		if not id then
			return
		end
		local sound = Instance.new("Sound")
		sound.Name = "Music"
		sound.Volume = MUSIC_VOLUME
		sound.SoundGroup = musicGroup
		sound.Parent = SoundService
		-- Each track plays once, then the playlist moves on (also while sped up for
		-- a surge; under a surge track it is paused and never ends).
		sound.Ended:Connect(function()
			local nextId = nextTrack(mainList)
			if nextId then
				sound.SoundId = nextId
				sound.TimePosition = 0
				sound:Play()
			end
		end)
		music = sound
	end
	local m = music :: Sound
	if id and m.SoundId ~= id then
		m:Stop()
		m.SoundId = id
	end
	if not enabled or not id then
		if m.IsPlaying or surgeMode then
			stopAll(m)
		end
		return
	end
	local wantSurge = mood == "surge" and not introPlaying()
	if wantSurge and not surgeMode then
		if not m.IsPlaying then
			m:Play()
		end
		enterSurge(m)
	elseif not wantSurge and surgeMode then
		leaveSurge(m)
	elseif surgeMode ~= "track" and not m.IsPlaying then
		m:Play()
	end
end

function Sounds.setMood(name: string?)
	if name == mood then
		return
	end
	mood = name
	Sounds.updateMusic()
end

-- The surge mood waits for the intro to finish (and clears if the intro replays).
Players.LocalPlayer:GetAttributeChangedSignal("IntroPlaying"):Connect(function()
	if mood ~= nil or surgeMode ~= nil then
		Sounds.updateMusic()
	end
end)

-- Music level for a game mode: 1 = normal, e.g. 0.4 in CARDIO so the key clicks come
-- through. Eases over half a second.
function Sounds.setMusicDuck(level: number)
	if duckTween then
		duckTween:Cancel()
	end
	local tween = TweenService:Create(musicGroup, TweenInfo.new(0.5), { Volume = math.clamp(level, 0, 1) })
	duckTween = tween
	tween:Play()
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="250">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Client-side store for the latest server snapshot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage.Shared.Format)

local State = {}

State.data = nil :: { [string]: any }?
State.changed = Instance.new("BindableEvent")
State.clockOffset = 0
State.receivedAt = 0

function State.set(data: { [string]: any })
	State.data = data
	State.clockOffset = (data.now or os.time()) - os.time()
	State.receivedAt = os.clock()
	State.changed:Fire(data)
end

-- Server unix time estimate.
function State.now(): number
	return os.time() + State.clockOffset
end

-- Seconds since the snapshot arrived (for smooth countdowns between pushes).
function State.age(): number
	return os.clock() - State.receivedAt
end

-- Formats a number honouring the "full numbers" setting.
function State.num(n: number): string
	local data = State.data
	if data and data.settings and data.settings.fullNumbers then
		return Format.commas(n)
	end
	return Format.short(n)
end

function State.money(n: number): string
	return "$" .. State.num(n)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="251">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="252">
            <Properties>
              <string name="Name">CardioHud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CardioHud: the screen side of CARDIO, the keyboard runner (Fx.Cardio does the 3D side,
	including the floating "+N" step pops). Laid out like "+1 Speed Keyboard Escape".
	Everything shows only during a run (snapshot modes.cardio.running or a "start" Notify).

	  Speed box     bottom centre, where the dumbbell sits (the Hud's "Dumbbell" group is
	                hidden while a run is active and shown again after): a BIG outlined
	                "12.85K Speed" that counts up smoothly, a chunky bar under it toward the
	                next stage's need ("Stage 3 · 968 / 1.1K", gold until the need is met,
	                then mint), and small lines beside it ("Multiplier x1.25 (Stages)",
	                "Treadmill Lv 3"); on narrow screens those lines sit above the number.
	                The bar runs on past the need to the recommended Speed (snapshot
	                `recommended`, 15% above the need): a dark tick marks the need, and from
	                there the text reads "Stage 3 · 1.12K · recommended 1.27K", then
	                "... · ready!".
	  Stage line    top centre in the run-pill slot (y 92): a persistent "STAGE 4 · NAME";
	                in a safe zone what its WIN pad does right now: gold "WIN plate: +$12.4K
	                · it ends this run" (and, for a first clear, "Skip it and this first win
	                stays for later": true in Modes.Cardio, first clears are kept per plate),
	                or white "NO REWARD on this WIN plate right now" with when it pays again
	                and the same warning; while Speed < need, a pulsing coral "Need more
	                speed!" hint.
	  Title         a big bubbly "STAGE n" (plus the stage's name) under it whenever you
	                enter a stage; also "STAGE 3 CLEAR!" (reaching a safe zone: nothing is
	                paid until you step on its WIN plate), "YOU WIN!" (cashed out; "RUN
	                OVER" when the plate paid nothing), and for a fall "TOO SLOW!" / "OOPS!"
	                / "CAUGHT!" with what happened (Speed below the stage's need, the custom
	                speed cap, a plain fall, the chaser), "TREADMILL LV 4!" banners.
	  WIN plates    the floating "Amount" line over every WIN pad (tag "CardioWinPad",
	                World.CardioTrack) is written here: "+$12.4K" or "NO REWARD".
	  Right column  centre right: Custom Speed (title, "Your Max Speed: N", a number box
	                + green OK that fires CardioSpeedCap { cap } with 0 / empty = no cap,
	                "Current speed: N"; a small "Custom Speed" chip by default on every
	                screen: tapping it expands the box, OK and the run's end fold it),
	                the treadmill card (on / near a treadmill), SPEED UP
	                (near the upgrade pad, fires CardioUpgrade) and a QUIT pill that asks
	                "QUIT?" before ModeQuit.
	  Finish card   centre, on the last WIN plate: CARDIO CHAMPION!, the reward, RUN AGAIN /
	                HOME, confetti.

	Snapshot fields read (modes.cardio): running, speed, walkSpeed, maxWalkSpeed?,
	speedCap?, multiplier, treadmill, treadmillRate, nextCost, stage, wins?, firsts?,
	cooldownEnds, onTreadmill, stageCount, needs, recommended?, names. Main routes Notify (kind "Mode", mode "cardio")
	to CardioHud.onNotify, every State snapshot to CardioHud.onState and the "CardioSteps"
	effect to CardioHud.onSteps.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Format = require(ReplicatedStorage.Shared.Format) :: any
local Net = require(ReplicatedStorage.Shared.Net)

local Client = script.Parent.Parent
local Kit = require(script.Parent.Kit) :: any
local Popups = require(script.Parent.Popups) :: any
local Sounds = require(Client.Sounds) :: any
local State = require(Client.State) :: any

local CardioHud = {}

local C = Kit.C
local F = Kit.F
local W = Theme.World

local MINT: Color3 = W.Mint or Color3.fromRGB(98, 224, 160)
local CORAL: Color3 = W.Coral or C.Bad
local GOLD: Color3 = C.Gold
local GRAPE: Color3 = W.Grape or Color3.fromRGB(176, 132, 255)
local WHITE = Color3.new(1, 1, 1)
local HINT_DIM = CORAL
local HINT_BRIGHT = Color3.new(1, 0.86, 0.8)

local STRIP_Y = 92 -- Hud's run-pill slot (Tutorial steps aside while "RunActive")
local TITLE_Y = 128
local BOX_W = 400
local SPEED_TEXT = 78 -- the big bottom-centre number (1.4x the old 56)
local SPEED_H = 84
local BOX_H = SPEED_H + 4 + 30 + 10
local BAR_H = 30
local SIDE_W = 210
local COLUMN_W = 250
local WALLET_RIGHT = 340 -- px the desktop wallet (bottom left) reaches
local NEAR_PAD = 16 -- studs (flat) from the upgrade pad that show the SPEED UP card
local NEAR_TREADMILL = 14
local PROXIMITY_EVERY = 0.15
local PADS_EVERY = 1 -- seconds between repaints of the WIN pads' floating amounts
local WIN_TAG = "CardioWinPad"
local MAX_LEVEL = 10
local MAX_CAP = 100000

local player = Players.LocalPlayer
local action = Net.event("Action")

local screen: ScreenGui? = nil
local root: Frame
local column: Frame
-- Speed box (bottom centre)
local box: Frame
local boxBody: Frame
local boxScale: UIScale
local speedLabel: TextLabel
local barFill: Frame
local barTick: Frame
local barText: TextLabel
local side: Frame
local sideLayout: UIListLayout
local multLine: TextLabel
local treadLine: TextLabel
-- Custom speed
local customCard: Frame
local customBody: Frame
local customToggle: TextButton
local customTitle: TextLabel
local customChip: TextButton
local maxLabel: TextLabel
local currentLabel: TextLabel
local capBox: TextBox
local capButton: TextButton
local customOpen = false
-- Collapsed Custom Speed chip width.
local CHIP_W = 176
local quitButton: TextButton
-- Treadmill card
local treadCard: Frame
local treadTitle: TextLabel
local treadRate: TextLabel
local treadBelt: Frame
-- Upgrade card
local upCard: Frame
local upLevel: TextLabel
local upRate: TextLabel
local upPips: { Frame } = {}
local upButton: TextButton
-- Stage line
local stageLine: Frame
local stageLabel: TextLabel
local winLabel: TextLabel
local winNote: TextLabel
local hintLabel: TextLabel
-- Banner, finish
local banner: Frame
local bannerTitle: TextLabel
local bannerSub: TextLabel
local finishCard: Frame
local finishSub: TextLabel
local finishReward: TextLabel

-- Run state
local active = false
local startedAt = 0
local snap: { [string]: any } = {}
local targetSpeed = 0
local shownSpeed = 0
local walkSpeed = 16
local maxSeen = 16
local stage = 0
local stageCount = 10
local nearPad = false
local nearTreadmill = false
-- Safe zone the player stands in (0 = none), and what each zone's WIN pad paid when its
-- "zone" Notify came (used until a snapshot brings `wins`).
local zoneIn = 0
local zoneCash: { [number]: number } = {}
local zoneFirst: { [number]: boolean } = {}
-- Speed recommended for a stage when the snapshot has none: this far above its need.
local RECOMMEND = 1.15
local padsAt = 0
local quitArmed = false
local bannerToken = 0
local renderConn: RBXScriptConnection? = nil
local proximityAt = 0
local hintShown = false
local compactTouch = false
local quitPress: () -> () = function() end

local function num(value: any, default: number): number
	return if type(value) == "number" and value == value then value else default
end

local function speedText(n: number): string
	return Format.short(math.floor(n))
end

local function multText(m: number): string
	if m == math.floor(m) then
		return tostring(m)
	end
	local text = string.format("%.2f", m)
	return (string.gsub(text, "0$", ""))
end

local function needOf(index: number): number?
	local needs = snap.needs
	if type(needs) == "table" then
		local v = needs[index]
		if type(v) == "number" then
			return v
		end
	end
	return nil
end

-- The Speed to run stage `index` with comfortably (>= its need).
local function recommendedOf(index: number, need: number): number
	local list = snap.recommended
	local v = if type(list) == "table" then list[index] else nil
	return math.max(need, if type(v) == "number" then v else math.ceil(need * RECOMMEND))
end

local function nameOf(index: number): string?
	local names = snap.names
	if type(names) == "table" and type(names[index]) == "string" and names[index] ~= "" then
		return names[index]
	end
	return nil
end

local function iconName(): string
	return Kit.pickIcon("Cardio", "Surge")
end

-- Banner / big stage title --------------------------------------------------------------------

local function showBanner(title: string, sub: string?, color: Color3, hold: number, delay: number?)
	bannerToken += 1
	local mine = bannerToken
	local function run()
		if bannerToken ~= mine then
			return
		end
		bannerTitle.Text = title
		bannerTitle.TextColor3 = color
		bannerSub.Text = sub or ""
		bannerSub.Visible = sub ~= nil
		Kit.appear(banner, { from = 0.35, time = 0.4 })
		task.delay(hold, function()
			if bannerToken == mine then
				Kit.disappear(banner)
			end
		end)
	end
	if delay and delay > 0 then
		task.delay(delay, run)
	else
		run()
	end
end

-- "STAGE n" for the stage you are about to run (n = safe zone + 1), after `delay`.
local function stageTitle(delay: number?)
	local n = math.min(stage + 1, stageCount)
	if stage >= stageCount then
		return
	end
	local name = nameOf(n)
	showBanner("STAGE " .. n, if name then string.upper(name) else nil, WHITE, 1.8, delay)
end

-- "No reward this time: plates pay again in 12:30" for a WIN plate that paid nothing.
local function noRewardText(p: any): string
	local left = math.max(0, math.ceil(num(p.cooldownEnds, 0) - os.time()))
	return if left > 0 then "No reward this time: plates pay again in " .. Format.time(left) else "No reward this time"
end

local function rewardText(p: any): string?
	local cash = num(p.cash, 0)
	if cash <= 0 then
		return if p.full == false then noRewardText(p) else nil
	end
	local text = "+" .. Format.money(cash)
	if p.full == false then
		text ..= "  (cooling down)"
	end
	return text
end

-- WIN plates ----------------------------------------------------------------------------------

-- What safe zone n's WIN pad pays right now (0 inside the reward cooldown), if known.
local function winCash(n: number): number?
	local wins = snap.wins
	if type(wins) == "table" and type(wins[n]) == "number" then
		return wins[n]
	end
	return zoneCash[n]
end

-- Seconds until a WIN pad that pays nothing pays again (0 when it should pay already).
local function cooldownLeft(): number
	return math.max(0, math.ceil(num(snap.cooldownEnds, 0) - os.time()))
end

-- Is safe zone n's WIN pad still a first clear (always paid, and kept if you run past)?
local function winFirst(n: number): boolean
	local firsts = snap.firsts
	if type(firsts) == "table" and type(firsts[n]) == "boolean" then
		return firsts[n]
	end
	return zoneFirst[n] == true
end

-- Does a WIN pad deeper than zone n pay right now?
local function deeperPays(n: number): boolean
	for m = n + 1, stageCount do
		local cash = winCash(m)
		if cash and cash > 0 then
			return true
		end
	end
	return false
end

-- The stage line while standing in a safe zone: what its WIN plate pays right now, that
-- stepping on it ends the run, and what happens to the reward if you run past.
local function paintWin()
	local cash = if zoneIn > 0 then winCash(zoneIn) else nil
	local show = active and cash ~= nil
	local note: string? = nil
	if show then
		local left = cooldownLeft()
		local pays = (cash :: number) > 0
		if pays then
			winLabel.Text = "WIN plate: +" .. Format.money(cash) .. "  ·  it ends this run"
			-- True in Modes.Cardio: first clears are kept per plate (profile.cardio.firsts).
			if winFirst(zoneIn) and zoneIn < stageCount then
				note = "Skip it and this first win stays for later"
			end
		else
			winLabel.Text = "NO REWARD on this WIN plate right now"
			note = if left > 0
				then "Pays again in " .. Format.time(left) .. ". Stepping on it ends this run!"
				else "Stepping on it ends this run!"
		end
		winLabel.TextColor3 = if pays then GOLD else WHITE
		winNote.Text = note or ""
	end
	winNote.Visible = show and note ~= nil
	if show ~= winLabel.Visible then
		winLabel.Visible = show
		if show then
			Kit.appear(winLabel, { from = 0.7 })
		end
	end
	-- The need hint steps down while the win lines are up.
	hintLabel.Position = UDim2.fromOffset(0, if not show then 30 elseif note then 72 else 52)
end

-- The floating amount over every WIN pad: what it pays this player right now.
local function paintPads()
	for _, pad in CollectionService:GetTagged(WIN_TAG) do
		local gui = pad:FindFirstChild("WinLabel")
		local amount = gui and gui:FindFirstChild("Amount")
		if amount and amount:IsA("TextLabel") then
			local cash = winCash(math.floor(num(pad:GetAttribute("Stage"), 0)))
			local text = "CASH OUT"
			if active and cash then
				-- A pad that pays nothing right now says so (stepping on it still ends the run).
				text = if cash > 0 then "+" .. Format.money(cash) elseif cooldownLeft() > 0 then "NO REWARD" else "CASH OUT"
			end
			if amount.Text ~= text then
				amount.Text = text
			end
		end
	end
end

-- The safe zone (1..10) whose deck is under `pos`, from the WIN pads' zone attributes.
local function zoneAt(pos: Vector3): number
	for _, pad in CollectionService:GetTagged(WIN_TAG) do
		local x0, x1 = num(pad:GetAttribute("ZoneX0"), 0), num(pad:GetAttribute("ZoneX1"), 0)
		local z0, z1 = num(pad:GetAttribute("ZoneZ0"), 0), num(pad:GetAttribute("ZoneZ1"), 0)
		if pos.X >= x0 and pos.X <= x1 and pos.Z >= z0 and pos.Z <= z1 then
			return math.floor(num(pad:GetAttribute("Stage"), 0))
		end
	end
	return 0
end

-- Speed box, stage line, custom speed ---------------------------------------------------------

local function paintSpeedText()
	speedLabel.Text = speedText(shownSpeed + 0.5) .. ' <font size="42">Speed</font>'
end

-- Bar, stage line and hint; cheap, runs every frame while active.
local function paintNeed()
	local next = stage + 1
	if stage >= stageCount then
		stageLabel.Text = "ALL STAGES CLEAR!"
		barText.Text = "MAX STAGE!"
		barFill.Size = UDim2.fromScale(1, 1)
		barFill.BackgroundColor3 = MINT
		barTick.Visible = false
		hintLabel.Visible = false
		hintShown = false
		return
	end
	local name = nameOf(next)
	stageLabel.Text = string.format("STAGE %d%s", next, if name then "  ·  " .. string.upper(name) else "")
	local need = needOf(next)
	if not need then
		barText.Text = "Stage " .. next
		barFill.Size = UDim2.fromScale(0, 1)
		barTick.Visible = false
		hintLabel.Visible = false
		hintShown = false
		return
	end
	-- The bar runs to the recommended Speed; a tick marks the need on the way.
	local best = recommendedOf(next, need)
	local full = math.max(best, 1)
	local ready = targetSpeed >= need
	barText.Text = if not ready
		then string.format("Stage %d  ·  %s / %s", next, speedText(shownSpeed), speedText(need))
		elseif targetSpeed < best then string.format(
			"Stage %d  ·  %s  ·  recommended %s",
			next,
			speedText(shownSpeed),
			speedText(best)
		)
		else string.format("Stage %d  ·  %s  ·  ready!", next, speedText(shownSpeed))
	local k = math.clamp(shownSpeed / full, 0, 1)
	barFill.Size = UDim2.fromScale(math.max(k, 0.04), 1)
	barFill.BackgroundColor3 = if ready then MINT else GOLD
	barTick.Visible = best > need
	barTick.Position = UDim2.fromScale(need / full, 0)
	if (not ready) ~= hintShown then
		hintShown = not ready
		hintLabel.Visible = hintShown
		if hintShown then
			Kit.appear(hintLabel, { from = 0.7 })
		end
	end
	if hintShown then
		-- A gentle colour pulse so the hint reads as a call to action.
		hintLabel.TextColor3 = HINT_DIM:Lerp(HINT_BRIGHT, 0.5 + 0.5 * math.sin(os.clock() * 6))
	end
end

local function setTarget(speed: number, exact: boolean?)
	if exact then
		targetSpeed = speed
		shownSpeed = speed
		paintSpeedText()
	elseif speed > targetSpeed then
		targetSpeed = speed
	end
end

local function paintCustom()
	local cap = snap.speedCap
	if type(cap) ~= "number" or cap <= 0 then
		maxSeen = math.max(walkSpeed, num(snap.maxWalkSpeed, 0))
	end
	local maxWalk = num(snap.maxWalkSpeed, maxSeen)
	maxLabel.Text = "Your Max Speed: " .. math.floor(maxWalk + 0.5)
	currentLabel.Text = "Current speed: " .. math.floor(walkSpeed + 0.5)
	if not capBox:IsFocused() then
		capBox.Text = if type(cap) == "number" and cap > 0 then tostring(math.floor(cap)) else ""
	end
end

local function setWalk(ws: number)
	walkSpeed = ws
	paintCustom()
end

local function setMultiplier(mult: number)
	local text = "Multiplier x" .. multText(mult) .. " (Stages)"
	if multLine.Text ~= text then
		local grew = multLine.Text ~= "" and active
		multLine.Text = text
		if grew then
			Kit.pop(multLine, 1.3)
		end
	end
	treadLine.Text = "Treadmill Lv " .. math.clamp(math.floor(num(snap.treadmill, 0)), 0, MAX_LEVEL)
end

-- Custom Speed is a small chip until tapped; OK and the run's end fold it again.
local function setCustomOpen(open: boolean)
	customOpen = open
	customBody.Visible = open
	customChip.Visible = not open
	customCard.Size = UDim2.fromOffset(if open then COLUMN_W else CHIP_W, if open then 168 else 40)
	customTitle.TextSize = if open then 22 else 17
	customTitle.Size = UDim2.fromOffset((if open then COLUMN_W else CHIP_W) - 54, 26)
	customTitle.Position = UDim2.fromOffset(14, if open then 9 else 7)
	customToggle.Position = UDim2.new(1, -8, 0, if open then 8 else 6)
	Kit.setButton(customToggle, if open then "–" else "+", C.SurfaceHi)
	if not open and capBox:IsFocused() then
		capBox:ReleaseFocus()
	end
end

local function sendCap()
	local digits = string.gsub(capBox.Text, "%D", "")
	local cap = math.clamp(tonumber(digits) or 0, 0, MAX_CAP)
	capBox:ReleaseFocus()
	action:FireServer({ action = "CardioSpeedCap", cap = cap })
	Kit.pop(capButton, 1.2)
	snap.speedCap = if cap > 0 then cap else nil
	paintCustom()
	setCustomOpen(false)
end

-- Cards ---------------------------------------------------------------------------------------

local function paintTreadmill()
	local rate = num(snap.treadmillRate, 0)
	local on = snap.onTreadmill == true
	-- Compact touch: the SPEED UP card takes the treadmill card's place near the pad.
	local show = active and (on or nearTreadmill) and not (compactTouch and nearPad and not on)
	if show ~= treadCard.Visible then
		if show then
			Kit.appear(treadCard, { from = 0.8 })
		else
			Kit.disappear(treadCard)
		end
	end
	treadTitle.Text = if on then "RUNNING!" else "TREADMILL"
	treadTitle.TextColor3 = if on then MINT else C.Text
	treadRate.Text = if rate > 0 then "+" .. speedText(rate) .. " speed/s" else "Hop on to train!"
end

local function paintUpgrade()
	local level = math.clamp(math.floor(num(snap.treadmill, 0)), 0, MAX_LEVEL)
	local cost = num(snap.nextCost, 0)
	local show = active and nearPad
	if show ~= upCard.Visible then
		if show then
			Kit.appear(upCard, { from = 0.8 })
		else
			Kit.disappear(upCard)
		end
	end
	upLevel.Text = string.format("Treadmill Lv %d/%d", level, MAX_LEVEL)
	upRate.Text = "+" .. speedText(num(snap.treadmillRate, 0)) .. "/s"
	for i, pip in upPips do
		pip.BackgroundColor3 = if i <= level then GOLD else C.Well
	end
	if level >= MAX_LEVEL then
		Kit.setButton(upButton, "MAX!", C.SurfaceHi)
		Kit.setEnabled(upButton, false)
	else
		local money = 0
		local data = State.data
		if type(data) == "table" then
			money = num(data.money, 0)
		end
		Kit.setEnabled(upButton, true)
		Kit.setButton(upButton, if cost > 0 then Format.money(cost) else "UPGRADE", if money >= cost then C.Good else C.SurfaceHi)
	end
end

-- Proximity to the upgrade pad and treadmills (flat distance, every PROXIMITY_EVERY s).
local function pivotOf(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return nil
end

local function nearTagged(tag: string, from: Vector3, radius: number): boolean
	for _, inst in CollectionService:GetTagged(tag) do
		local pos = pivotOf(inst)
		if pos then
			local flat = Vector3.new(pos.X - from.X, 0, pos.Z - from.Z).Magnitude
			if flat <= radius and math.abs(pos.Y - from.Y) < 14 then
				return true
			end
		end
	end
	return false
end

local function checkProximity()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local pad, tread = false, false
	zoneIn = 0
	if hrp and hrp:IsA("BasePart") then
		pad = nearTagged("CardioUpgradePad", hrp.Position, NEAR_PAD)
		tread = nearTagged("CardioTreadmill", hrp.Position, NEAR_TREADMILL)
		zoneIn = zoneAt(hrp.Position)
	end
	paintWin()
	if pad ~= nearPad then
		nearPad = pad
		paintUpgrade()
	end
	if tread ~= nearTreadmill then
		nearTreadmill = tread
		paintTreadmill()
	end
end

-- Per frame -----------------------------------------------------------------------------------

local function render(dt: number)
	-- Smooth count-up toward the server's Speed (eased, at least 1 per frame).
	if shownSpeed ~= targetSpeed then
		local gap = targetSpeed - shownSpeed
		local stepBy = gap * math.min(1, dt * 7)
		if math.abs(stepBy) < 1 then
			stepBy = math.sign(gap) * math.min(math.abs(gap), math.max(1, math.abs(gap) * dt * 7))
		end
		shownSpeed += stepBy
		if math.abs(targetSpeed - shownSpeed) < 0.5 then
			shownSpeed = targetSpeed
		end
		paintSpeedText()
	end
	paintNeed()
	-- Treadmill stripes scroll while on it.
	if treadCard.Visible then
		local rate = if snap.onTreadmill == true then 60 else 14
		for _, stripe in treadBelt:GetChildren() do
			if stripe:IsA("Frame") then
				local base = num(stripe:GetAttribute("Base"), 0)
				local x = (base - os.clock() * rate) % 72 - 12
				stripe.Position = UDim2.fromOffset(x, 0)
			end
		end
	end
	local now = os.clock()
	if now - proximityAt >= PROXIMITY_EVERY then
		proximityAt = now
		checkProximity()
	end
	-- The pads' cooldown countdowns tick on their own.
	if now - padsAt >= PADS_EVERY then
		padsAt = now
		paintPads()
	end
end

-- Show / hide ---------------------------------------------------------------------------------

-- The Hud's bottom-centre dumbbell steps aside for the speed box during a run.
local CLUTTER = { "Dumbbell", "Menu", "Units", "Wallet", "DepositStrip", "FreeCorner", "Version", "ChestPanel" }
local stashed: { [GuiObject]: boolean } = {}
local function setRunActive(on: boolean)
	local gui = screen
	if not gui then
		return
	end
	gui:SetAttribute("RunActive", on)
	gui:SetAttribute("CardioActive", on)
	-- The Hud's other blocks (icon grid, cash, bonus strip, gift, chad counter, crate
	-- panel) step aside too, so only the run, QUIT and the Settings gear stay. The Promo
	-- hides itself on "CardioActive" (Hud). Each block gets back the Visible it had.
	if on then
		for _, name in CLUTTER do
			local gui2 = gui:FindFirstChild(name)
			if gui2 and gui2:IsA("GuiObject") and stashed[gui2] == nil then
				stashed[gui2] = gui2.Visible
				gui2.Visible = false
			end
		end
	else
		for gui2, was in stashed do
			gui2.Visible = was
		end
		table.clear(stashed)
	end
end

-- Music level during a Cardio run (1 = normal).
local MUSIC_DUCK = 0.25

local function show()
	if active then
		return
	end
	active = true
	-- Music a bit quieter during a run so the key clicks come through.
	Sounds.setMusicDuck(MUSIC_DUCK)
	quitArmed = false
	Kit.setButton(quitButton, "QUIT", C.SurfaceHi)
	hintShown = false
	hintLabel.Visible = false
	nearPad, nearTreadmill = false, false
	zoneIn = 0
	table.clear(zoneCash)
	table.clear(zoneFirst)
	paintWin()
	paintPads()
	treadCard.Visible = false
	upCard.Visible = false
	root.Visible = true
	Kit.appear(stageLine, { from = 0.7, time = 0.3 })
	Kit.appear(boxBody, { from = 0.7, time = 0.3 })
	Kit.appear(customCard, { from = 0.8, time = 0.3, delay = 0.05 })
	Kit.appear(quitButton, { from = 0.8, time = 0.3, delay = 0.1 })
	setRunActive(true)
	paintCustom()
	if not renderConn then
		renderConn = RunService.RenderStepped:Connect(render)
	end
end

local function hide()
	if not active then
		return
	end
	active = false
	Sounds.setMusicDuck(1)
	setRunActive(false)
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	zoneIn = 0
	paintWin()
	paintPads()
	capBox:ReleaseFocus()
	setCustomOpen(false)
	Kit.disappear(stageLine)
	Kit.disappear(boxBody)
	Kit.disappear(customCard)
	Kit.disappear(quitButton)
	Kit.disappear(treadCard)
	Kit.disappear(upCard)
end

local function applySnapshot(s: { [string]: any }, exact: boolean)
	snap = s
	stageCount = math.clamp(math.floor(num(s.stageCount, 10)), 1, 10)
	stage = math.floor(num(s.stage, stage))
	setTarget(num(s.speed, targetSpeed), exact)
	setWalk(num(s.walkSpeed, walkSpeed))
	setMultiplier(num(s.multiplier, 1))
	if active then
		paintTreadmill()
		paintUpgrade()
		paintWin()
		paintPads()
	end
end

-- Closes the finish card and drops a gamepad selection left on its buttons, so the stick
-- goes back to running.
local function hideFinish()
	Kit.unfocus(finishCard)
	if finishCard.Visible then
		Kit.disappear(finishCard)
	end
end

local function showFinish(p: any)
	finishSub.Text = string.format("You cleared all %d stages!", stageCount)
	finishReward.Text = rewardText(p) or ""
	finishReward.Visible = finishReward.Text ~= ""
	Kit.appear(finishCard, { from = 0.5, time = 0.35 })
	Kit.confetti(screen :: any, { Count = 28, Origin = UDim2.fromScale(0.5, 0.35), Power = 1.2 })
	Sounds.play("Celebrate")
	if Kit.gamepad then
		Kit.select(Kit.firstSelectable(finishCard))
	end
end

-- Notify / state / steps ----------------------------------------------------------------------

function CardioHud.onNotify(p: any)
	if not screen or type(p) ~= "table" then
		return
	end
	local event = tostring(p.event)
	if event == "start" then
		startedAt = os.clock()
		hideFinish()
		-- A run always starts in the lobby (stage 1).
		stage = 0
		setTarget(num(p.speed, targetSpeed), true)
		setWalk(num(p.walkSpeed, walkSpeed))
		setMultiplier(num(p.multiplier, 1))
		show()
		Sounds.play("Ready")
		showBanner("CARDIO!", "Every key you step on = +Speed!", MINT, 2)
		stageTitle(2.4)
	elseif event == "zone" then
		-- Reached a safe zone: nothing is paid yet, its WIN plate shows what it would pay.
		local n = math.floor(num(p.stage, stage))
		stage = n
		local cash = num(p.cash, 0)
		zoneCash[n] = cash
		zoneFirst[n] = p.first == true
		-- What this zone's WIN plate does right now; never a promise the plates can't keep.
		local sub
		if cash > 0 then
			sub = "WIN plate: +" .. Format.money(cash) .. " (it ends this run)"
		elseif deeperPays(n) then
			sub = "No reward on this plate now. A deeper one pays!"
		else
			local left = math.max(0, math.ceil(num(p.cooldownEnds, 0) - os.time()))
			sub = if left > 0 then "No reward right now: plates pay again in " .. Format.time(left) else "No reward on this plate right now"
		end
		showBanner("STAGE " .. n .. " CLEAR!", sub, MINT, 2.4)
		stageTitle(2.8)
		Sounds.play("Step")
		paintWin()
		paintPads()
	elseif event == "win" then
		-- Cashed out on a WIN plate: paid, and back in the lobby for the next run.
		stage = 0
		zoneIn = 0
		table.clear(zoneCash)
		table.clear(zoneFirst)
		paintWin()
		if p.final == true then
			showFinish(p)
		elseif num(p.cash, 0) <= 0 then
			-- The plate paid nothing (the cooldown) and still ended the run: say so, no party.
			showBanner("RUN OVER", noRewardText(p), WHITE, 2.4)
			stageTitle(2.8)
			Sounds.play("Step")
		else
			showBanner("YOU WIN!", rewardText(p), GOLD, 2.4)
			stageTitle(2.8)
			Sounds.play("Reward")
			if screen then
				Kit.confetti(screen, { Count = 18, Origin = UDim2.fromScale(0.5, 0.3) })
			end
		end
	elseif event == "fall" then
		-- A fall or a catch: the run starts over in the lobby (the chaser's own "MOGGED!"
		-- splash plays first on a catch).
		stage = 0
		zoneIn = 0
		table.clear(zoneCash)
		table.clear(zoneFirst)
		paintWin()
		local caught = p.reason == "caught"
		-- What happened, from the server: the run was slower than the stage's need gives (not
		-- enough Speed, or the player's own speed cap), or it was fast enough and just fell /
		-- got caught.
		local from = math.floor(num(p.from, 1))
		local need = num(p.need, needOf(from) or 0)
		local title, sub
		if p.capped == true then
			title = if caught then "CAUGHT!" else "TOO SLOW!"
			sub = "Your Custom Speed is too low for Stage " .. from .. ". Raise it!"
		elseif p.slow == true then
			title = if caught then "CAUGHT!" else "TOO SLOW!"
			sub = "Stage " .. from .. " needs " .. speedText(need) .. " Speed. Back to Stage 1."
		elseif caught then
			title = "CAUGHT!"
			sub = "Keep running, don't stop! Back to Stage 1."
		else
			title = "OOPS!"
			sub = "You fell in Stage " .. from .. ". Back to Stage 1."
		end
		showBanner(title, sub, CORAL, 2.2, if caught then 1.2 else nil)
		Sounds.play("Error")
	elseif event == "refused" then
		-- The server already toasted why; just shake the button.
		Sounds.play("Error")
		if upCard.Visible then
			Kit.pop(upButton, 1.2)
		end
	elseif event == "upgrade" then
		local level = math.floor(num(p.level, num(snap.treadmill, 0)))
		snap.treadmill = level
		Sounds.play("Upgrade")
		showBanner("TREADMILL LV " .. level .. "!", "Treadmills give more Speed", GOLD, 1.8)
		paintUpgrade()
		setMultiplier(num(p.multiplier, num(snap.multiplier, 1)))
		Kit.pop(treadLine, 1.4)
		for i = 1, math.min(level, #upPips) do
			task.delay(0.03 * i, function()
				Kit.pop(upPips[i], 1.6)
			end)
		end
	elseif event == "stop" then
		hide()
		local reason = p.reason
		if reason == "left" then
			Popups.toast("You left Cardio. Run ended", "info")
		elseif reason == "respawn" then
			Popups.toast("Run reset. Hop back in at the gate!", "info")
		elseif reason == "quit" then
			Popups.toast("Cardio run ended", "info")
		end
	end
end

function CardioHud.onState(data: any)
	if not screen or type(data) ~= "table" then
		return
	end
	local modes = data.modes
	local s = type(modes) == "table" and modes.cardio
	if type(s) ~= "table" then
		return
	end
	local exact = not active
	applySnapshot(s, exact)
	if s.running == true and not active then
		show()
	elseif s.running == false and active and os.clock() - startedAt > 2 then
		hide()
	end
end

-- The step pops themselves float in 3D (Fx.Cardio); here the number just counts up.
function CardioHud.onSteps(data: any)
	if not screen or type(data) ~= "table" then
		return
	end
	local gained = num(data.gained, 0)
	if data.speed ~= nil then
		setTarget(num(data.speed, targetSpeed))
	elseif gained > 0 then
		setTarget(targetSpeed + gained)
	end
	if data.walkSpeed ~= nil then
		setWalk(num(data.walkSpeed, walkSpeed))
	end
	-- The treadmill rate grows with Speed: keep "+X speed/s" live.
	if type(data.rate) == "number" and data.rate ~= snap.treadmillRate then
		snap.treadmillRate = data.rate
		if active then
			paintTreadmill()
			paintUpgrade()
		end
	end
	-- Every gain pops the number (bigger gains, bigger bounce).
	if active and gained > 0 then
		Kit.pop(speedLabel, math.clamp(0.45 + gained / 60, 0.45, 1.1))
	end
end

-- Build ---------------------------------------------------------------------------------------

local function buildBox()
	box = Kit.new("Frame", {
		Name = "CardioSpeed",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(BOX_W, BOX_H),
		Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 20,
		Parent = root,
	})
	-- The holder carries the layout scale; the body is what appears (Kit.appear tweens
	-- the first UIScale it finds).
	boxScale = Kit.new("UIScale", { Parent = box })
	local body = Kit.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 20,
		Parent = box,
	})
	boxBody = body
	speedLabel = Kit.hudText(body, {
		Name = "Speed",
		Text = "0",
		RichText = true,
		TextSize = SPEED_TEXT,
		Size = UDim2.new(1, 0, 0, SPEED_H),
		Position = UDim2.fromOffset(0, 0),
		ZIndex = 22,
		StrokeThickness = 6,
	})
	Kit.gradient(speedLabel, WHITE, Color3.fromRGB(214, 226, 255), 90)

	-- Chunky bar toward the next stage's need.
	local track = Kit.new("Frame", {
		Name = "NeedBar",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -24, 0, BAR_H),
		Position = UDim2.new(0.5, 0, 0, SPEED_H + 4),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 21,
		Parent = body,
	})
	Kit.round(track)
	Kit.new("UIStroke", { Color = C.Ink, Thickness = 3, Parent = track })
	local inner = Kit.new("Frame", {
		Name = "Inner",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 22,
		Parent = track,
	})
	barFill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0.04, 1),
		ZIndex = 22,
		Parent = inner,
	})
	Kit.round(barFill)
	Kit.gradient(barFill, WHITE, Color3.new(0.78, 0.78, 0.84), 90)
	-- The need: the bar itself runs on to the recommended Speed (paintNeed places the tick).
	barTick = Kit.new("Frame", {
		Name = "NeedTick",
		BackgroundColor3 = C.Ink,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 3, 1, 0),
		Position = UDim2.fromScale(1 / RECOMMEND, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		ZIndex = 23,
		Parent = inner,
	})
	barText = Kit.hudText(track, {
		Name = "Need",
		Text = "",
		TextSize = 18,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 24,
	})

	-- Multiplier lines: beside the number on wide screens, above it on narrow ones.
	side = Kit.new("Frame", {
		Name = "Lines",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(SIDE_W, 50),
		ZIndex = 21,
		Parent = body,
	})
	sideLayout = Kit.new("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = side,
	})
	multLine = Kit.hudText(side, {
		Name = "Multiplier",
