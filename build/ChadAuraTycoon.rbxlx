  <Item class="ServerScriptService" referent="170">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="171">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="172">
        <Properties>
          <string name="Name">Analytics</string>
          <string name="Source"><![CDATA[--[[
	Analytics: funnels for the Creator Dashboard (AnalyticsService), so ad traffic can be
	judged by where new players stop and how often the shop turns into a purchase.

	Onboarding funnel (Dashboard > Analytics > Funnels > Onboarding), once per player.
	Shared.Funnel has the step numbers and rules; progress is saved in
	profile.onboarding, and saves from before this module start at ONBOARDING_LEGACY
	and never log.
	  1 Joined            first session starts
	  2 Intro Done        the cutscene finished or was skipped (Player attribute IntroSeen)
	  3..7                each tutorial step reached / finished (Buy, Orbs, Deposit, Collect, Merge)
	  8..11               highest tier discovered: Tier 3, Tier 5, Tier 7, Tier 10
	A skipped tutorial logs the custom event "TutorialSkipped" and stops the funnel, so
	it never shows tutorial steps the player did not do. Their tier milestones are
	logged as one-time custom events instead: "SkipperTier3", "SkipperTier5",
	"SkipperTier7", "SkipperTier10". Everyone who reached a tier = its funnel step + its
	Skipper event. Profiles from before the milestones whose tutorial was already over
	log none of them (Funnel.returning): the tiers they reached long ago are not news.

	Intro: the first-run cutscene logs one custom event when it ends, "IntroSkipped" or
	"IntroWatched", with the story seconds played as its value.

	Shop funnel (recurring "Shop"): 1 Opened, 2 Prompted, 3 Purchased. One funnel session
	per shop visit; a prompt from outside the shop (pads, crate panel) starts a new one.
]]

local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Funnel = require(ReplicatedStorage.Shared.Funnel)
local TutorialSteps = require(ReplicatedStorage.Shared.TutorialSteps)

local Tycoon = require(script.Parent.Tycoon)

local Analytics = {}

Analytics.ONBOARDING_LEGACY = Funnel.LEGACY

local ONBOARDING_NAMES = { "Joined", "Intro Done" }
for i, step in TutorialSteps.STEPS do
	ONBOARDING_NAMES[2 + i] = "Tutorial " .. i .. " " .. step.id
end
for i in Funnel.MILESTONES do
	ONBOARDING_NAMES[Funnel.TUTORIAL_END + i] = Funnel.milestoneName(i)
end

-- Player -> current shop funnel session id and its last step.
local shopFunnel: { [Player]: { id: string, step: number } } = {}

local function safely(fn: (...any) -> (), ...: any)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[Analytics]", err)
	end
end

local function logStep(session: Tycoon.Session, step: number)
	safely(AnalyticsService.LogOnboardingFunnelStepEvent, AnalyticsService, session.player, step, ONBOARDING_NAMES[step])
end

-- Logs onboarding steps up to `step` that this player has not logged yet. A profile that
-- skipped the tutorial (Funnel.SKIPPED and up) or predates the funnel is past every step.
function Analytics.onboard(session: Tycoon.Session, step: number)
	local p = session.profile
	if not session.alive or step <= p.onboarding then
		return
	end
	for s = p.onboarding + 1, math.min(step, #ONBOARDING_NAMES) do
		logStep(session, s)
	end
	p.onboarding = step
	Tycoon.markDirty(session)
end

-- Tier milestones the player's best tier has reached and not logged yet (Funnel.tiers):
-- funnel steps after a finished tutorial, "SkipperTier<n>" custom events after a skipped one.
function Analytics.tiers(session: Tycoon.Session)
	local p = session.profile
	if not session.alive then
		return
	end
	local plan = Funnel.tiers(p.onboarding, Economy.highestTier(p.discovered))
	if plan.onboarding == p.onboarding then
		return
	end
	for _, step in plan.steps do
		logStep(session, step)
	end
	for _, name in plan.events do
		safely(AnalyticsService.LogCustomEvent, AnalyticsService, session.player, name)
	end
	p.onboarding = plan.onboarding
	Tycoon.markDirty(session)
end

-- Tutorial progress: `step` is the step now current (DONE = finished); skipped = true when skipped.
function Analytics.tutorial(session: Tycoon.Session, step: number, skipped: boolean?)
	if skipped then
		safely(AnalyticsService.LogCustomEvent, AnalyticsService, session.player, "TutorialSkipped", step)
		session.profile.onboarding = Funnel.skip(session.profile.onboarding)
		Tycoon.markDirty(session)
	else
		-- Step n current means steps 1..n-1 are done: funnel step 2 + (n - 1).
		Analytics.onboard(session, 1 + step)
	end
	-- Tiers discovered during the tutorial count from the moment it ends.
	Analytics.tiers(session)
end

-- The first-run cutscene ended after `seconds` of its story.
function Analytics.intro(session: Tycoon.Session, skipped: boolean, seconds: number)
	local name = if skipped then "IntroSkipped" else "IntroWatched"
	safely(AnalyticsService.LogCustomEvent, AnalyticsService, session.player, name, seconds)
end

function Analytics.shop(player: Player, step: number, name: string)
	local funnel = shopFunnel[player]
	if step == 1 or not funnel or step <= funnel.step then
		funnel = { id = HttpService:GenerateGUID(false), step = 0 }
		shopFunnel[player] = funnel
	end
	funnel.step = step
	safely(AnalyticsService.LogFunnelStepEvent, AnalyticsService, player, "Shop", funnel.id, step, name)
end

function Analytics.onSessionStart(session: Tycoon.Session)
	local player = session.player
	-- Returning players never log here: a save from before the tier milestones arrives with
	-- all of them marked as logged (DataService's migration, Funnel.returning), so these
	-- two calls only send what a new profile has not sent yet.
	Analytics.onboard(session, 1)
	Analytics.tiers(session)
	if player:GetAttribute("IntroSeen") == true then
		Analytics.onboard(session, 2)
	else
		local conn
		conn = player:GetAttributeChangedSignal("IntroSeen"):Connect(function()
			if player:GetAttribute("IntroSeen") == true then
				conn:Disconnect()
				Analytics.onboard(session, 2)
			end
		end)
	end
end

function Analytics.init()
	-- The shop window reports each time it opens (Client.UI.Windows).
	Tycoon.addAction("ShopOpened", function(session)
		Analytics.shop(session.player, 1, "Opened")
	end)
	table.insert(Tycoon.listeners, function(session, name)
		if name == "Discover" then
			Analytics.tiers(session)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		shopFunnel[player] = nil
	end)
end

return Analytics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="173">
        <Properties>
          <string name="Name">Badges</string>
          <string name="Source"><![CDATA[--[[
	Badges: awards the Roblox badges listed in Theme.Badges (ids from the universe,
	created with tools/badges.py). A badge with Id 0 is skipped.

	Each badge is awarded once: profile.badges[key] is set when BadgeService confirms it,
	and a failed award is retried on the next check (every CHECK_SECONDS, plus right after
	the tutorial finishes). Conditions read only the saved profile:
	  Welcome        joined the game
	  GymGraduate    finished the tutorial (Badges.graduate, not on a skip)
	  CertifiedChad  discovered tier 10
	  AbsoluteChad   discovered the top tier
	  ParkourMaster  cleared the last parkour level
]]

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)

local Tycoon = require(script.Parent.Tycoon)

local Badges = {}

local CHECK_SECONDS = 5

local theme: any
-- Awards in flight per session, so a slow AwardBadgeAsync is never sent twice.
local busy: { [any]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any

local conditions: { [string]: (profile: any) -> boolean } = {
	Welcome = function()
		return true
	end,
	GymGraduate = function(p)
		return p.badges.GymGraduate == false
	end,
	CertifiedChad = function(p)
		return Economy.highestTier(p.discovered) >= 10
	end,
	AbsoluteChad = function(p)
		return Economy.highestTier(p.discovered) >= Economy.MAX_TIER
	end,
	ParkourMaster = function(p)
		return (p.parkour.clears[#p.parkour.clears] or 0) > 0
	end,
}

-- Awards one badge if its condition holds. profile.badges[key]: true = awarded,
-- false = earned but not yet confirmed by BadgeService (retried), nil = not earned.
local function check(session: Tycoon.Session, key: string)
	local badge = theme.Badges[key]
	local p = session.profile
	if not badge or badge.Id == 0 or p.badges[key] == true or not conditions[key](p) then
		return
	end
	local inFlight = busy[session] or {}
	busy[session] = inFlight
	if inFlight[key] then
		return
	end
	inFlight[key] = true
	local ok, result = pcall(BadgeService.AwardBadgeAsync, BadgeService, session.player.UserId, badge.Id)
	inFlight[key] = nil
	if not session.alive then
		return
	end
	if ok and result then
		p.badges[key] = true
		Tycoon.markDirty(session)
	elseif not ok then
		warn("[Badges]", key, result)
	end
end

local function checkAll(session: Tycoon.Session)
	for key in theme.Badges do
		if session.alive then
			check(session, key)
		end
	end
end

-- The tutorial was finished (not skipped).
function Badges.graduate(session: Tycoon.Session)
	if session.profile.badges.GymGraduate == nil then
		session.profile.badges.GymGraduate = false
	end
	task.spawn(check, session, "GymGraduate")
end

function Badges.onSessionStart(session: Tycoon.Session)
	task.spawn(checkAll, session)
end

function Badges.init(themeModule: any)
	theme = themeModule
	task.spawn(function()
		while true do
			task.wait(CHECK_SECONDS)
			for _, session in Tycoon.allSessions() do
				task.spawn(checkAll, session)
			end
		end
	end)
end

return Badges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="174">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--[[
	Cosmetics: the cosmetic game passes (Theme.Cosmetics) and the Starter pack.

	Ownership: an item is owned through its own pass, or the Bundle pass (every item
	except Starter ones), or, for a Starter item, the Starter pack pass.

	Saved in profile.cosmetics: the equipped trail ("" = none) and the on/off switch of
	each toggle item (perk / wear; missing = on). profile.starterGranted marks the
	Starter pack's one-time cash as given.

	On every character (and whenever ownership or equipment changes) the server puts
	the visible pieces on the character so everyone sees them: Humanoid.WalkSpeed, the
	trail (two attachments on the HumanoidRootPart), the aura emitters and the crown.
	Local-only effects (double jump, speed puffs) live in Client.Fx.Cosmetics, which
	reads the Player attributes "CosDoubleJump" and "CosSpeed".

	Speed: WalkSpeed = Humanoid attribute "BaseWalkSpeed" (default
	Theme.Cosmetics.BaseWalkSpeed) x the boost. Code that changes a player's normal speed
	sets that attribute and calls Cosmetics.refresh(player) instead of writing WalkSpeed.

	Client actions:
	  EquipTrail      { name = "<trail item>" | "" }   "" unequips
	  ToggleCosmetic  { name = "<perk/wear item>", value = boolean? }   nil flips
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local AssetModels = require(Shared.AssetModels)

local DataService = require(script.Parent.DataService)
local Tycoon = require(script.Parent.Tycoon)

local Cosmetics = {}

type Session = Tycoon.Session

-- Name of every instance the server adds to a character.
local PIECE_ATTR = "Cosmetic"
-- Trail ribbon: attachment offsets on the HumanoidRootPart (behind the hips).
local TRAIL_TOP = Vector3.new(0, 0.55, 0.45)
local TRAIL_BOTTOM = Vector3.new(0, -1.05, 0.45)
-- Crown width as a fraction of the head's width, and how far it sinks onto the head.
local CROWN_WIDTH = 1.05
local CROWN_SINK = 0.18
-- Seconds before the join-time Starter popup is sent, so the client UI is listening.
local STARTER_NOTIFY_DELAY = 4

local theme: any
-- Per player: the cosmetic instances on the current character, and its connections.
local pieces: { [Player]: { Instance } } = {}
local pieceConns: { [Player]: { RBXScriptConnection } } = {}

-- Sprite image ids from the generated Assets module (nil when missing).
local images: { [string]: string }? = nil
do
	local module = Shared:FindFirstChild("Assets")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module :: any)
		if ok and type(result) == "table" and type((result :: any).Images) == "table" then
			images = (result :: any).Images
		end
	end
end

local function sprite(name: string): string?
	local id = images and images["vfx/" .. name]
	return if type(id) == "string" and id ~= "" then id else nil
end

-- Pure rules (also used by the unit tests) -------------------------------------------------

local function config(t: any): any
	return t and t.Cosmetics
end

-- Does a player with `passes` own cosmetic `name`?
function Cosmetics.owns(t: any, passes: { [string]: boolean }, name: string): boolean
	local c = config(t)
	local item = c and c.Items[name]
	if not item then
		return false
	end
	if item.Starter then
		return passes[c.Starter.Pass] == true
	end
	return (item.Pass ~= nil and passes[item.Pass] == true) or passes[c.Bundle] == true
end

-- { [name] = true } for every owned cosmetic.
function Cosmetics.ownedSet(t: any, passes: { [string]: boolean }): { [string]: boolean }
	local owned = {}
	local c = config(t)
	if c then
		for name in c.Items do
			if Cosmetics.owns(t, passes, name) then
				owned[name] = true
			end
		end
	end
	return owned
end

local function isToggle(item: any): boolean
	return item ~= nil and item.Kind ~= "trail"
end

-- Is toggle item `name` switched on in this profile (missing = on)?
function Cosmetics.toggleOn(profile: any, name: string): boolean
	return profile.cosmetics.toggles[name] ~= false
end

-- Is cosmetic `name` owned and in use (equipped trail / toggle switched on)?
function Cosmetics.active(t: any, profile: any, passes: { [string]: boolean }, name: string): boolean
	local c = config(t)
	local item = c and c.Items[name]
	if not item or not Cosmetics.owns(t, passes, name) then
		return false
	end
	if item.Kind == "trail" then
		return profile.cosmetics.trail == name
	end
	return Cosmetics.toggleOn(profile, name)
end

-- The equipped trail if it is still owned, else "".
function Cosmetics.trail(t: any, profile: any, passes: { [string]: boolean }): string
	local name = profile.cosmetics.trail
	if name ~= "" and Cosmetics.active(t, profile, passes, name) then
		return name
	end
	return ""
end

-- Marks the Starter pack as granted. True exactly once, the first time the pass is owned.
function Cosmetics.claimStarter(t: any, profile: any, passes: { [string]: boolean }): boolean
	local c = config(t)
	if not c or passes[c.Starter.Pass] ~= true or profile.starterGranted then
		return false
	end
	profile.starterGranted = true
	return true
end

-- The Starter pack's cash for a player at `income` cash/s and `progression`.
function Cosmetics.starterCash(t: any, income: number, progression: Economy.Progression): number
	local starter = t.Cosmetics.Starter
	return Economy.moneyPackAmount(income, starter.CashSeconds, starter.CashMin, progression)
end

-- The State snapshot's `cosmetics` field.
function Cosmetics.state(t: any, profile: any, passes: { [string]: boolean }): { [string]: any }
	local c = config(t)
	local toggles = {}
	for name, item in c.Items do
		if isToggle(item) then
			toggles[name] = Cosmetics.toggleOn(profile, name)
		end
	end
	return {
		owned = Cosmetics.ownedSet(t, passes),
		trail = Cosmetics.trail(t, profile, passes),
		toggles = toggles,
		bundleOwned = passes[c.Bundle] == true,
		starterOwned = passes[c.Starter.Pass] == true,
		starterGranted = profile.starterGranted == true,
	}
end

-- Character pieces -------------------------------------------------------------------------

local function clearPieces(player: Player)
	local conns: { RBXScriptConnection } = pieceConns[player] or {}
	for _, conn in conns do
		conn:Disconnect()
	end
	local made: { Instance } = pieces[player] or {}
	for _, inst in made do
		inst:Destroy()
	end
	pieces[player] = {}
	pieceConns[player] = {}
end

local function keep(player: Player, inst: Instance): Instance
	inst:SetAttribute(PIECE_ATTR, true)
	table.insert(pieces[player], inst)
	return inst
end

local function sequence(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keys = {}
	for i, color in colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keys)
end

local function addTrail(player: Player, root: BasePart, item: any)
	local top = keep(player, Instance.new("Attachment")) :: Attachment
	top.Name = "CosTrailTop"
	top.Position = TRAIL_TOP
	top.Parent = root
	local bottom = keep(player, Instance.new("Attachment")) :: Attachment
	bottom.Name = "CosTrailBottom"
	bottom.Position = TRAIL_BOTTOM
	bottom.Parent = root

	local trail = keep(player, Instance.new("Trail")) :: Trail
	trail.Name = "CosTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = sequence(item.Colors or { item.Color })
	trail.Lifetime = 0.55
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 0
	trail.LightInfluence = 0.35
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0.35),
	})
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.7, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = root

	local starId = if item.Stars then sprite("StarPop") else nil
	if starId then
		local stars = keep(player, Instance.new("ParticleEmitter")) :: ParticleEmitter
		stars.Name = "CosTrailStars"
		stars.Texture = starId
		stars.Rate = 5
		stars.Enabled = true
		stars.LightEmission = 0
		stars.LightInfluence = 0
		stars.Lifetime = NumberRange.new(0.7, 1.1)
		stars.Speed = NumberRange.new(0.5, 1.5)
		stars.SpreadAngle = Vector2.new(60, 60)
		stars.Acceleration = Vector3.new(0, -3, 0)
		stars.Drag = 2
		stars.Rotation = NumberRange.new(-180, 180)
		stars.RotSpeed = NumberRange.new(-60, 60)
		stars.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.15, 0.45),
			NumberSequenceKeypoint.new(0.7, 0.35),
			NumberSequenceKeypoint.new(1, 0),
		})
		stars.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		stars.Parent = bottom
		-- Stars only fall while the player is moving.
		local humanoid = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			table.insert(
				pieceConns[player],
				humanoid.Running:Connect(function(speed)
					stars.Enabled = speed > 2
				end)
			)
		end
	end
end

local function auraEmitter(player: Player, root: BasePart, name: string, props: { [string]: any })
	local id = sprite(name)
	if not id then
		return
	end
	local emitter = keep(player, Instance.new("ParticleEmitter")) :: ParticleEmitter
	emitter.Name = "CosAura" .. name
	emitter.Texture = id
	emitter.LightEmission = 0
	emitter.LightInfluence = 0
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Rotation = NumberRange.new(-180, 180)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.15),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = root
end

local function addAura(player: Player, root: BasePart, item: any)
	local color = item.Color
	auraEmitter(player, root, "Sparkle", {
		Color = ColorSequence.new(color, theme.World.Cream),
		Rate = 6,
		Lifetime = NumberRange.new(0.9, 1.4),
		Speed = NumberRange.new(1, 2),
		Drag = 1,
		RotSpeed = NumberRange.new(-90, 90),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, 0.5),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})
	auraEmitter(player, root, "SoftDot", {
		Color = ColorSequence.new(color),
		Rate = 3,
		Lifetime = NumberRange.new(1.4, 2),
		Speed = NumberRange.new(0.4, 1),
		Drag = 0.5,
		RotSpeed = NumberRange.new(0, 0),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.2),
			NumberSequenceKeypoint.new(1, 2.4),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
end

local function dressPart(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

-- A part-built crown (used when the props/Crown mesh is missing): a gold band with
-- round points and a coral gem at the front. `width` studs across, pointing up +Y,
-- centred on the origin.
local function partCrown(width: number, color: Color3): Model
	local model = Instance.new("Model")
	local bandHeight = width * 0.38
	local function piece(shape: Enum.PartType, size: Vector3, cf: CFrame, tint: Color3): BasePart
		local part = Instance.new("Part")
		part.Shape = shape
		part.Size = size
		part.CFrame = cf
		part.Color = tint
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end
	local band = piece(Enum.PartType.Cylinder, Vector3.new(bandHeight, width, width), CFrame.Angles(0, 0, math.rad(90)), color)
	band.Name = "Band"
	model.PrimaryPart = band
	local ball = width * 0.26
	for i = 0, 4 do
		local angle = i / 5 * math.pi * 2
		local offset = Vector3.new(math.sin(angle), 0, -math.cos(angle)) * (width * 0.4)
		piece(Enum.PartType.Ball, Vector3.one * ball, CFrame.new(offset + Vector3.new(0, bandHeight * 0.5 + ball * 0.3, 0)), color).Name =
			"Point"
	end
	piece(Enum.PartType.Ball, Vector3.one * width * 0.2, CFrame.new(0, 0, -width * 0.48), theme.World.Coral).Name = "Gem"
	return model
end

-- The crown model (mesh if uploaded, else part-built), `width` studs wide, bottom at y = 0.
local function crownModel(item: any, width: number): Model
	local clone = AssetModels.clone(item.Model or "props/Crown")
	local mesh: MeshPart? = nil
	if clone then
		local found = if clone:IsA("MeshPart") then clone else clone:FindFirstChildWhichIsA("MeshPart", true)
		if found then
			local part = found :: MeshPart
			mesh = part
			if part ~= clone then
				part.Parent = nil
				clone:Destroy()
			end
		else
			clone:Destroy()
		end
	end
	if mesh then
		local size = mesh.Size
		local scale = width / math.max(size.X, size.Z, 1e-3)
		mesh.Size = size * scale
		mesh.CFrame = CFrame.new(0, mesh.Size.Y / 2, 0)
		mesh.Color = Color3.new(1, 1, 1)
		mesh.Name = "CrownMesh"
		local model = Instance.new("Model")
		mesh.Parent = model
		model.PrimaryPart = mesh
		return model
	end
	local model = partCrown(width, item.Color)
	local box, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() + Vector3.new(0, size.Y / 2 - box.Position.Y, 0))
	return model
end

local function addCrown(player: Player, head: BasePart, item: any)
	local width = math.min(head.Size.X, head.Size.Z) * CROWN_WIDTH
	local model = keep(player, crownModel(item, width)) :: Model
	model.Name = "CosCrown"
	-- Model space has the crown's base at y = 0: move it onto the top of the head.
	local seat = head.CFrame * CFrame.new(0, head.Size.Y / 2 - CROWN_SINK * head.Size.Y, 0)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			dressPart(part)
			local world = seat * part.CFrame
			local weld = Instance.new("Weld")
			weld.Part0 = head
			weld.Part1 = part
			weld.C0 = head.CFrame:ToObjectSpace(world)
			weld.Parent = part
			part.CFrame = world
		end
	end
	model.Parent = head.Parent
end

-- Applying ---------------------------------------------------------------------------------

local function applySpeed(player: Player, humanoid: Humanoid, boosted: boolean)
	local c = config(theme)
	local base = humanoid:GetAttribute("BaseWalkSpeed")
	if type(base) ~= "number" then
		base = c.BaseWalkSpeed
		humanoid:SetAttribute("BaseWalkSpeed", base)
	end
	local mult = if boosted then c.Items.SpeedBoost.SpeedMultiplier else 1
	humanoid:SetAttribute("SpeedMultiplier", mult)
	humanoid.WalkSpeed = base * mult
	player:SetAttribute("CosSpeed", boosted)
end

-- Rebuilds every cosmetic on the player's current character.
local function apply(session: Session)
	local player = session.player
	if not session.alive or not config(theme) then
		return
	end
	local profile, passes = session.profile, session.passes
	local items = theme.Cosmetics.Items
	clearPieces(player)
	player:SetAttribute("CosDoubleJump", Cosmetics.active(theme, profile, passes, "DoubleJump"))
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not root or not root:IsA("BasePart") then
		player:SetAttribute("CosSpeed", false)
		return
	end
	applySpeed(player, humanoid, Cosmetics.active(theme, profile, passes, "SpeedBoost"))
	local trail = Cosmetics.trail(theme, profile, passes)
	if trail ~= "" then
		addTrail(player, root, items[trail])
	end
	if Cosmetics.active(theme, profile, passes, "AuraGlow") then
		addAura(player, root, items.AuraGlow)
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") and Cosmetics.active(theme, profile, passes, "Crown") then
		local ok, err = pcall(addCrown, player, head, items.Crown)
		if not ok then
			warn("[Cosmetics] crown:", err)
		end
	end
end

-- Re-applies the player's cosmetics (e.g. after changing the humanoid's BaseWalkSpeed).
function Cosmetics.refresh(player: Player)
	local session = Tycoon.getSession(player)
	if session then
		apply(session)
	end
end

-- Starter pack -----------------------------------------------------------------------------

local function grantStarter(session: Session, delayNotify: boolean)
	local profile = session.profile
	if not Cosmetics.claimStarter(theme, profile, session.passes) then
		return
	end
	local progression = Economy.progression(Economy.highestTier(profile.discovered), profile.processLevel)
	local cash = Cosmetics.starterCash(theme, Tycoon.income(session), progression)
	local starter = theme.Cosmetics.Starter
	Tycoon.grantMoney(session, cash)
	if profile.cosmetics.trail == "" then
		profile.cosmetics.trail = starter.Item
	end
	apply(session)
	Tycoon.markDirty(session)
	if session.canSave then
		task.spawn(DataService.save, session.player, profile)
	end
	local payload = { kind = "Starter", cash = cash, item = starter.Item }
	if delayNotify then
		task.delay(STARTER_NOTIFY_DELAY, function()
			if session.alive then
				Tycoon.notify(session, payload)
			end
		end)
	else
		Tycoon.notify(session, payload)
	end
end

-- A pass was just bought (or granted in Studio).
local function onPassGranted(session: Session, passName: string)
	local c = config(theme)
	if not c then
		return
	end
	if passName == c.Starter.Pass then
		grantStarter(session, false)
		return
	end
	-- A newly bought trail goes on straight away if none is equipped.
	if session.profile.cosmetics.trail == "" then
		for _, name in c.Order do
			local item = c.Items[name]
			if item.Kind == "trail" and (item.Pass == passName or passName == c.Bundle) and not item.Starter then
				session.profile.cosmetics.trail = name
				break
			end
		end
	end
	apply(session)
end

-- Call right after Tycoon.addPlayer: hooks the character and grants an owed Starter pack.
function Cosmetics.onSessionStart(session: Session)
	if not config(theme) then
		return
	end
	local player = session.player
	local function onCharacter(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		character:WaitForChild("Head", 5)
		if humanoid and root and session.alive and player.Character == character then
			apply(session)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	-- The avatar's own parts and accessories can arrive after CharacterAdded.
	player.CharacterAppearanceLoaded:Connect(function(character)
		if session.alive and player.Character == character then
			apply(session)
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	else
		apply(session)
	end
	grantStarter(session, true)
end

function Cosmetics.init(themeModule: any)
	theme = themeModule
	local c = config(theme)
	if not c then
		return
	end

	Tycoon.hooks.passGranted = onPassGranted
	Tycoon.hooks.cosmetics = function(session)
		return Cosmetics.state(theme, session.profile, session.passes)
	end

	Tycoon.addAction("EquipTrail", function(session, data)
		local name = data.name
		if name == "" or name == nil then
			session.profile.cosmetics.trail = ""
		elseif type(name) == "string" then
			local item = c.Items[name]
			if not item or item.Kind ~= "trail" then
				return
			end
			if not Cosmetics.owns(theme, session.passes, name) then
				Tycoon.toast(session, "Unlock " .. item.Title .. " in the shop first!", "info")
				return
			end
			session.profile.cosmetics.trail = name
		else
			return
		end
		apply(session)
	end)

	Tycoon.addAction("ToggleCosmetic", function(session, data)
		local name = data.name
		local item = type(name) == "string" and c.Items[name] or nil
		if not isToggle(item) then
			return
		end
		if not Cosmetics.owns(theme, session.passes, name) then
			Tycoon.toast(session, "Unlock " .. item.Title .. " in the shop first!", "info")
			return
		end
		local value = if type(data.value) == "boolean" then data.value else not Cosmetics.toggleOn(session.profile, name)
		session.profile.cosmetics.toggles[name] = value
		apply(session)
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearPieces(player)
		pieces[player] = nil
		pieceConns[player] = nil
	end)
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="175">
        <Properties>
          <string name="Name">Daily</string>
          <string name="Source"><![CDATA[--[[
	Daily: server side of the daily reward (rules: Shared.DailyReward; client:
	Client.UI.DailyWindow and the HUD's Daily button).

	The saved profile field `daily` holds the UTC day of the last claim and the
	streak at that claim. The State snapshot's `daily` field tells the client
	what today looks like: { claimable, day (today's card 1..7), claimed (cards
	ticked), streak, nextIn (seconds to the next UTC day), firstDay (today is the
	player's first day: today's card is capped, DailyReward.firstDayCap) }. The
	"ClaimDaily" action pays today's card: cash sized by the player's income right
	now (the amounts the window shows) and, on days 3 and 7, a crate opened on the
	spot. With no room on the rack for the crate's unit, the crate is paid as cash.

	Notify payloads (client shows them):
	  { kind = "Daily", event = "claimed", day = n, cash = c, crate = rarity?, streak = s,
	    crateCash = part of `cash` paid instead of the crate (rack full)? }

	First day: once a player has finished the tutorial, has claimed and has been
	playing for a few minutes, one toast names tomorrow's reward.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DailyReward = require(Shared.DailyReward)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Tycoon = require(script.Parent.Tycoon)

local Daily = {}

local CHECK_SECONDS = 5
-- The first-day toast waits for this much play time, and this long after the claim.
local HINT_AFTER_JOIN = 180
local HINT_AFTER_CLAIM = 30

local theme: any
-- os.clock() of the session's start and of its claim (sessions are weak keys).
local startedAt: { [any]: number } = setmetatable({}, { __mode = "k" }) :: any
local claimedAt: { [any]: number } = setmetatable({}, { __mode = "k" }) :: any

local function today(): number
	return DailyReward.dayNumber(os.time())
end

-- Cash of card `day` for this player right now (the same formula the window shows).
-- `firstDay` = paid on the player's first day (capped).
local function cashFor(session: Tycoon.Session, day: number, firstDay: boolean): number
	local p = session.profile
	local progression = Economy.progression(Economy.highestTier(p.discovered), p.processLevel)
	local cap = if firstDay then DailyReward.firstDayCap(day, p.bought) else nil
	return DailyReward.cash(day, Tycoon.income(session), progression, cap)
end

local function snapshot(session: Tycoon.Session): { [string]: any }
	local d = session.profile.daily
	local now = os.time()
	local status = DailyReward.status(d.day, d.streak, DailyReward.dayNumber(now))
	return {
		claimable = status.claimable,
		day = status.day,
		claimed = status.claimed,
		streak = status.streak,
		nextIn = DailyReward.secondsLeft(now),
		firstDay = d.firstDay == DailyReward.dayNumber(now),
	}
end

function Daily.claim(session: Tycoon.Session)
	if not session.alive then
		return
	end
	local d = session.profile.daily
	local streak, day = DailyReward.claim(d.day, d.streak, today())
	if not streak or not day then
		Tycoon.toast(session, "Next daily reward in " .. Format.time(DailyReward.secondsLeft(os.time())), "info")
		return
	end
	-- Sized before anything is granted, so the crate's unit does not change the cash.
	local cash = cashFor(session, day, d.firstDay == today())
	local crate: string? = DailyReward.REWARDS[day].crate
	-- Rolled before the claim is announced: with no room on the rack for its unit, the crate
	-- is paid as cash instead of being lost.
	local tier = if crate then Tycoon.rollCrate(session, crate) else nil
	local crateCash: number? = nil
	if crate and not tier then
		crateCash = DailyReward.crateCash(day, Economy.highestTier(session.profile.discovered))
		cash += crateCash
	end
	d.day = today()
	d.streak = streak
	claimedAt[session] = os.clock()
	Tycoon.notify(session, {
		kind = "Daily",
		event = "claimed",
		day = day,
		cash = cash,
		crate = if tier then crate else nil,
		streak = streak,
		crateCash = crateCash,
	})
	Tycoon.grantMoney(session, cash, "Daily")
	if crate and tier then
		Tycoon.grantCrate(session, crate, tier)
	elseif crate and crateCash then
		local text = "Your rack is full: the %s %s paid %s instead"
		Tycoon.toast(session, string.format(text, crate, theme.Words.Chest, Format.money(crateCash)), "info")
	end
end

-- The first-day "come back tomorrow" toast (once per player, saved).
local function hint(session: Tycoon.Session, now: number)
	local p = session.profile
	local d = p.daily
	if d.hinted or not p.tutorialDone or d.firstDay ~= now or d.day ~= now then
		return
	end
	local clock = os.clock()
	if clock - (startedAt[session] or clock) < HINT_AFTER_JOIN or clock - (claimedAt[session] or 0) < HINT_AFTER_CLAIM then
		return
	end
	d.hinted = true
	local nextDay = DailyReward.card(d.streak + 1)
	local reward = DailyReward.describe(nextDay, Format.money(cashFor(session, nextDay, false)), theme.Words.Chest)
	Tycoon.toast(session, string.format("Come back tomorrow for Day %d: %s", nextDay, reward), "good")
	Tycoon.markDirty(session)
end

-- The loop's work for one session. `newDay` = a new UTC day began since the last check.
local function check(session: Tycoon.Session, now: number, newDay: boolean)
	if not session.alive then
		return
	end
	if newDay then
		-- The snapshot's `claimable` changes for everyone online.
		Tycoon.markDirty(session)
	end
	hint(session, now)
end

-- Call right after Tycoon.addPlayer: starts the play-time clock and stamps the first day.
function Daily.onSessionStart(session: Tycoon.Session)
	startedAt[session] = os.clock()
	local d = session.profile.daily
	if d.firstDay == 0 then
		d.firstDay = today()
		Tycoon.markDirty(session)
	end
end

function Daily.init(themeModule: any)
	theme = themeModule
	Tycoon.hooks.daily = snapshot
	Tycoon.addAction("ClaimDaily", function(session)
		Daily.claim(session)
	end)

	task.spawn(function()
		local lastDay = today()
		while true do
			task.wait(CHECK_SECONDS)
			local now = today()
			for _, session in Tycoon.allSessions() do
				-- One session's error (a player leaving mid-check) must not stop the loop
				-- for the whole server.
				local ok, err = pcall(check, session, now, now ~= lastDay)
				if not ok then
					warn("[Daily] check:", err)
				end
			end
			lastDay = now
		end
	end)
end

return Daily
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="176">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService: loads and saves player profiles in a DataStore.

	- Retries with backoff on load/save.
	- If a profile cannot be loaded on a live server the player is kicked
	  instead of being given a blank profile that would overwrite their save.
	- In Studio without API access it falls back to an in-memory profile and
	  never saves, so the game is still playable for testing.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Economy = require(ReplicatedStorage.Shared.Economy)
local Funnel = require(ReplicatedStorage.Shared.Funnel)
local SessionLock = require(ReplicatedStorage.Shared.SessionLock)
local TutorialSteps = require(ReplicatedStorage.Shared.TutorialSteps)

local DataService = {}

local STORE_NAME = "TycoonProfiles_v1"
local MAX_RETRIES = 4
-- Profile.version of a save written by this code. reconcile migrates older saves once:
--   2  the onboarding funnel counts tier milestones (Shared.Funnel)
--   3  Economy 2.0: the converter level is lifted to the free floor of the best tier
--      (Economy.minProcessLevel), firstCrateDone and the parkour `skipped` record exist.
--      Nothing saved is lowered or removed.
local VERSION = 3
DataService.VERSION = VERSION

export type Unlocker = { rarity: string, endsAt: number }

export type Profile = {
	version: number,
	money: number,
	carried: number,
	queue: number,
	pending: number,
	units: { number },
	discovered: { number },
	totalObtained: number,
	-- Units bought on the buy pads so far (Economy.unitPrice grows with it).
	bought: number,
	processLevel: number,
	heldChest: string,
	-- The profile's first crate has been opened (until then a Smasher slot takes
	-- Economy.FIRST_CRATE_SECONDS).
	firstCrateDone: boolean,
	-- Rarity of the crate the player was last prompted to open with Robux ("" = none);
	-- the receipt opens this one if the crate is no longer held.
	pendingCrate: string,
	-- Smasher slot (1 or 2) that Robux prompt was for (0 = the held crate): the receipt
	-- opens the crate still in that slot.
	pendingUnlocker: number,
	unlockers: { Unlocker },
	autoMergeOwned: boolean,
	autoMerge: boolean,
	lastOnline: number,
	lastFreeReward: number,
	settings: { music: boolean, sfx: boolean, fullNumbers: boolean },
	receipts: { string },
	totalEarned: number,
	tutorialStep: number,
	tutorialDone: boolean,
	introSeen: boolean,
	-- Equipped trail ("" = none) and on/off switches of the toggle cosmetics (missing = on).
	cosmetics: { trail: string, toggles: { [string]: boolean } },
	-- The Starter pack's one-time cash and trail have been given.
	starterGranted: boolean,
	-- Highest onboarding funnel step logged (Analytics; ONBOARDING_LEGACY = saves from before it).
	onboarding: number,
	-- Roblox badges: true = awarded, false = earned and waiting to be awarded (Badges).
	badges: { [string]: boolean },
	-- Daily reward (Server.Daily, Shared.DailyReward): UTC day number of the last claim
	-- (0 = never), days claimed in a row at that claim, UTC day number of the player's first
	-- day (0 = not started yet, 1 = saves from before the daily reward) and whether the
	-- first-day "come back tomorrow" toast was shown.
	daily: { day: number, streak: number, firstDay: number, hinted: boolean },
	-- Game mode records: personal best seconds (0 = never finished), finishes, and os.time()
	-- of the last full cash reward (Economy.modeReward cooldown).
	-- Mog Test: best = highest score, rivals = most rivals mogged in one run, clears = tests
	-- passed (and PvP wins paid), pvpWins / pvpPlayed = PvP duels won / fought.
	-- Parkour per level (dense, PARKOUR_LEVELS long, 0 = never): best seconds, finishes and
	-- skipped (1 = the map was skipped for cash, which unlocks the next one).
	-- modes.parkour keeps the shared reward cooldown and mirrors level 1 for the old UI.
	-- stage = highest sky-obby stage reached (0 = never ran; one stage per map since the
	-- checkpoints went: map n is stage n, finishing map 10 is 11); stageMaps = the stage is
	-- in those units (older saves counted checkpoints and are rebuilt on load); gear = the
	-- chosen coil ("none" | "speed" | "jump" | "gravity", worn only during runs).
	parkour: { best: { number }, clears: { number }, skipped: { number }, stage: number, stageMaps: boolean, gear: string },
	-- Cardio (keyboard runner): Speed earned (permanent, never goes down), deepest WIN plate
	-- claimed (0..CARDIO_STAGES), treadmill level (0..CARDIO_TREADMILL_MAX), WIN plates claimed
	-- in total (clears), the player's own max WalkSpeed (0 = none, else 16..CARDIO_WALK_CAP)
	-- and the plates whose first-clear pay was taken (firsts: a bit set, bit n - 1 = plate n;
	-- Modes.CardioRules.firstsOf).
	cardio: { speed: number, bestStage: number, treadmill: number, clears: number, speedCap: number, firsts: number },
	modes: {
		parkour: { best: number, clears: number, lastRewardAt: number },
		mog: {
			best: number,
			rivals: number,
			clears: number,
			lastRewardAt: number,
			pvpWins: number,
			pvpPlayed: number,
		},
		-- best mirrors cardio.bestStage, clears cardio.clears; lastRewardAt is the cooldown.
		cardio: { best: number, clears: number, lastRewardAt: number },
	},
}

-- Must equal Modes.Course.LEVEL_COUNT (checked by the unit tests).
local PARKOUR_LEVELS = 10
DataService.PARKOUR_LEVELS = PARKOUR_LEVELS
-- Must equal Modes.CardioRules.STAGE_COUNT / TREADMILL_MAX.
local CARDIO_STAGES = 10
local CARDIO_TREADMILL_MAX = 10
-- Must equal Modes.CardioRules.BASE_WALK / WALK_CAP.
local CARDIO_WALK_MIN = 16
local CARDIO_WALK_CAP = 120

local function zeros(n: number): { number }
	local t = table.create(n, 0)
	return t
end

function DataService.defaultProfile(): Profile
	local units = zeros(Economy.MAX_TIER)
	units[1] = 1
	local discovered = zeros(Economy.MAX_TIER)
	discovered[1] = os.time()
	return {
		version = VERSION,
		money = Economy.START_CASH,
		carried = 0,
		queue = 0,
		pending = 0,
		units = units,
		discovered = discovered,
		totalObtained = 1,
		bought = 0,
		processLevel = Economy.START_PROCESS_LEVEL,
		heldChest = "",
		firstCrateDone = false,
		pendingCrate = "",
		pendingUnlocker = 0,
		unlockers = {
			{ rarity = "", endsAt = 0 },
			{ rarity = "", endsAt = 0 },
		},
		autoMergeOwned = false,
		autoMerge = false,
		lastOnline = 0,
		lastFreeReward = 0,
		settings = { music = true, sfx = true, fullNumbers = false },
		receipts = {},
		totalEarned = 0,
		tutorialStep = 1,
		tutorialDone = false,
		introSeen = false,
		cosmetics = { trail = "", toggles = {} },
		starterGranted = false,
		onboarding = 0,
		badges = {},
		daily = { day = 0, streak = 0, firstDay = 0, hinted = false },
		parkour = {
			best = zeros(PARKOUR_LEVELS),
			clears = zeros(PARKOUR_LEVELS),
			skipped = zeros(PARKOUR_LEVELS),
			stage = 0,
			stageMaps = true,
			gear = "none",
		},
		cardio = { speed = 0, bestStage = 0, treadmill = 0, clears = 0, speedCap = 0, firsts = 0 },
		modes = {
			parkour = { best = 0, clears = 0, lastRewardAt = 0 },
			mog = { best = 0, rivals = 0, clears = 0, lastRewardAt = 0, pvpWins = 0, pvpPlayed = 0 },
			cardio = { best = 0, clears = 0, lastRewardAt = 0 },
		},
	}
end

-- Parkour gear names a save may hold (Modes.Parkour).
local PARKOUR_GEARS = { none = true, speed = true, jump = true, gravity = true }

-- Fills in any fields missing from older saves and sanitises bad values.
local function reconcile(data: any): Profile
	local default = DataService.defaultProfile()
	if type(data) ~= "table" then
		return default
	end
	-- Read before the defaults below fill a missing version in.
	local version = if type(data.version) == "number" then data.version else 1
	-- Saves from before Parkour levels: the old single record becomes level 1's.
	if type(data.parkour) ~= "table" then
		local old = type(data.modes) == "table" and data.modes.parkour
		local migrated = { best = zeros(PARKOUR_LEVELS), clears = zeros(PARKOUR_LEVELS), stage = 0, gear = "none" }
		if type(old) == "table" then
			migrated.best[1] = old.best
			migrated.clears[1] = old.clears
		end
		data.parkour = migrated
	end
	-- Saves from before the tutorial existed belong to players who already
	-- know the game: don't send them through onboarding.
	if data.tutorialDone == nil then
		data.tutorialDone = type(data.totalObtained) == "number" and data.totalObtained > 1
	end
	-- Saves from before the intro cutscene existed: those players already know
	-- the story, so it never plays for them.
	if data.introSeen == nil then
		data.introSeen = true
	end
	-- Rizz (gems) was removed from the game: old balances are dropped.
	data.gems = nil
	-- Buy tiers were removed: the pads sell the first tier only. A save that had upgraded
	-- starts just past the easy units; one that had not keeps its count, as capped as it was.
	if data.bought == nil then
		local old = if type(data.boughtAtTier) == "number" and data.boughtAtTier == data.boughtAtTier then data.boughtAtTier else 0
		local upgraded = type(data.buyTier) == "number" and data.buyTier > 1
		data.bought = if upgraded then Economy.BUY_EASY_UNITS else math.clamp(math.floor(old), 0, Economy.BUY_EASY_UNITS)
	end
	data.buyTier = nil
	data.boughtAtTier = nil
	-- Saves from before the onboarding funnel: those players are not new, so they never log it.
	if data.onboarding == nil then
		data.onboarding = 99
	end
	-- Saves from before the first-crate head start: anyone who has played already had their
	-- first crate (or waits the normal time for it); only a brand-new profile gets the short one.
	if type(data.firstCrateDone) ~= "boolean" then
		local played = (type(data.bought) == "number" and data.bought > 0)
			or (type(data.totalObtained) == "number" and data.totalObtained > 1)
			or data.tutorialDone == true
		data.firstCrateDone = played
	end
	-- Saves from before the daily reward: day 1 is waiting, but today is not a "first day".
	if data.daily == nil then
		data.daily = { day = 0, streak = 0, firstDay = 1, hinted = true }
	end
	for key, value in default :: any do
		if data[key] == nil or type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	for _, key in { "units", "discovered" } do
		local list = data[key]
		for tier = 1, Economy.MAX_TIER do
			if type(list[tier]) ~= "number" or list[tier] ~= list[tier] then
				list[tier] = 0
			end
		end
	end
	for i = 1, 2 do
		local slot = data.unlockers[i]
		if type(slot) ~= "table" or type(slot.rarity) ~= "string" or type(slot.endsAt) ~= "number" then
			data.unlockers[i] = { rarity = "", endsAt = 0 }
		end
	end
	for key, value in default.settings :: any do
		if type(data.settings[key]) ~= type(value) then
			data.settings[key] = value
		end
	end
	if type(data.cosmetics.trail) ~= "string" then
		data.cosmetics.trail = ""
	end
	if type(data.cosmetics.toggles) ~= "table" then
		data.cosmetics.toggles = {}
	end
	for key, value in data.cosmetics.toggles do
		if type(key) ~= "string" or type(value) ~= "boolean" then
			data.cosmetics.toggles[key] = nil
		end
	end
	data.bought = if data.bought ~= data.bought or data.bought == math.huge then 0 else math.max(0, math.floor(data.bought))
	-- The converter starts at START_PROCESS_LEVEL; saves from before that are lifted to it.
	data.processLevel = math.max(math.floor(data.processLevel), Economy.START_PROCESS_LEVEL)
	-- ...and it is never below the free floor of the best tier the player has discovered.
	data.processLevel = math.max(data.processLevel, Economy.minProcessLevel(Economy.highestTier(data.discovered)))
	data.tutorialStep = TutorialSteps.clamp(data.tutorialStep)
	if data.heldChest ~= "" and not Economy.isRarity(data.heldChest) then
		data.heldChest = ""
	end
	for id, defaults in default.modes :: any do
		local record = data.modes[id]
		if type(record) ~= "table" then
			data.modes[id] = defaults
		else
			for key, value in defaults do
				local v = record[key]
				if type(v) ~= "number" or v ~= v or v < 0 or v == math.huge then
					record[key] = value
				end
			end
		end
	end
	for _, key in { "best", "clears", "skipped" } do
		local list = data.parkour[key]
		local fixed = zeros(PARKOUR_LEVELS)
		if type(list) == "table" then
			for i = 1, PARKOUR_LEVELS do
				local v = list[i]
				if type(v) == "number" and v == v and v >= 0 and v ~= math.huge then
					fixed[i] = if key == "best" then v elseif key == "skipped" then math.min(math.floor(v), 1) else math.floor(v)
				end
			end
		end
		data.parkour[key] = fixed
	end
	local stage = data.parkour.stage
	stage = if type(stage) == "number" and stage == stage and stage >= 0 and stage ~= math.huge then math.floor(stage) else 0
	if data.parkour.stageMaps ~= true then
		-- Saves from the checkpoint days: `stage` counted checkpoints along the chain. Rebuild
		-- it in map units from the maps cleared in a row from map 1 (the start of the next
		-- map is reached; all ten cleared is the last finish, PARKOUR_LEVELS + 1).
		local cleared = 0
		while cleared < PARKOUR_LEVELS and data.parkour.clears[cleared + 1] > 0 do
			cleared += 1
		end
		stage = if cleared > 0 then cleared + 1 elseif stage > 0 then 1 else 0
		data.parkour.stageMaps = true
	end
	data.parkour.stage = math.min(stage, PARKOUR_LEVELS + 1)
	if not PARKOUR_GEARS[data.parkour.gear] then
		data.parkour.gear = "none"
	end
	-- (Read before the defaults go in: a save without `firsts` is not a save that took none.)
	local firsts = data.cardio.firsts
	for key, value in default.cardio :: any do
		local v = data.cardio[key]
		if type(v) ~= "number" or v ~= v or v < 0 or v == math.huge then
			data.cardio[key] = value
		end
	end
	data.cardio.bestStage = math.clamp(math.floor(data.cardio.bestStage), 0, CARDIO_STAGES)
	data.cardio.treadmill = math.clamp(math.floor(data.cardio.treadmill), 0, CARDIO_TREADMILL_MAX)
	data.cardio.clears = math.floor(data.cardio.clears)
	local cap = math.floor(data.cardio.speedCap + 0.5)
	data.cardio.speedCap = if cap < CARDIO_WALK_MIN then 0 else math.min(cap, CARDIO_WALK_CAP)
	-- Saves from before the per-plate set had one counter: every plate up to bestStage is taken
	-- (the same rule as Modes.CardioRules.firstsOf).
	data.cardio.firsts = if type(firsts) == "number"
			and firsts == firsts
			and firsts >= 0
		then math.min(math.floor(firsts), 2 ^ CARDIO_STAGES - 1)
		else 2 ^ data.cardio.bestStage - 1
	for key, value in data.badges do
		if type(key) ~= "string" or type(value) ~= "boolean" then
			data.badges[key] = nil
		end
	end
	if data.pendingCrate ~= "" and not Economy.isRarity(data.pendingCrate) then
		data.pendingCrate = ""
	end
	for key, value in default.daily :: any do
		local v = data.daily[key]
		if type(v) ~= type(value) or (type(v) == "number" and (v ~= v or v < 0 or v == math.huge)) then
			data.daily[key] = value
		elseif type(v) == "number" then
			data.daily[key] = math.floor(v)
		end
	end
	if data.pendingUnlocker ~= 1 and data.pendingUnlocker ~= 2 then
		data.pendingUnlocker = 0
	end
	if version < 2 then
		-- Returning players' tier milestones count as logged, with nothing sent.
		data.onboarding = Funnel.returning(data.onboarding, data.tutorialDone)
	end
	data.version = math.max(version, VERSION)
	return data :: Profile
end

-- Exposed for the unit tests.
DataService.reconcile = reconcile

local store: DataStore? = nil
local storeOk, storeErr = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if not storeOk then
	warn("[DataService] DataStore unavailable:", storeErr)
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local lastErr
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(attempt * 1.5)
	end
	warn("[DataService]", label, "failed:", lastErr)
	return false, nil
end

-- This server's identity for session locks (JobId is empty in Studio).
local JOB_ID = if game.JobId ~= "" then game.JobId else ("studio-" .. HttpService:GenerateGUID(false))
-- How long a joining player waits for another server to release their save.
local LOCK_WAIT_SECONDS = 20

local function stripMeta(data: any): any
	if type(data) == "table" then
		data._lock = nil
	end
	return data
end

-- Returns (profile, canSave). profile is nil when the player should be kicked.
-- Acquires a session lock so two servers never write the same save.
function DataService.load(player: Player): (Profile?, boolean)
	if not store then
		if RunService:IsStudio() then
			warn("[DataService] Studio without DataStore access: progress will not be saved.")
			return reconcile(nil), false
		end
		return nil, false
	end
	local activeStore = store :: DataStore
	local started = os.clock()
	while player.Parent do
		local decision: SessionLock.Decision = "acquire"
		local loaded: any = nil
		local ok = retry("load " .. player.Name, function()
			activeStore:UpdateAsync(keyFor(player), function(current)
				local existing = if type(current) == "table" then current._lock else nil
				decision = SessionLock.decide(existing, JOB_ID, os.time(), os.clock() - started, LOCK_WAIT_SECONDS)
				if decision == "wait" then
					return nil -- leave the save untouched
				end
				local data = if type(current) == "table" then current else {}
				data._lock = { jobId = JOB_ID, at = os.time() }
				loaded = table.clone(data)
				return data
			end)
			return true
		end)
		if not ok then
			if RunService:IsStudio() then
				warn("[DataService] Enable 'Studio Access to API Services' to test saving. Using a temporary profile.")
				return reconcile(nil), false
			end
			return nil, false
		end
		if decision ~= "wait" then
			if decision == "steal" then
				warn("[DataService] Took over a save still locked by another server for", player.Name)
			end
			local isNew = loaded == nil or next(stripMeta(loaded)) == nil
			return reconcile(if isNew then nil else loaded), true
		end
		task.wait(3)
	end
	return nil, false
end

-- Saves the profile if this server still owns the session lock.
-- `release` clears the lock (player left / server shutting down).
-- Returns (saved, lostOwnership). lostOwnership is true when another server has
-- taken over this save; the caller should stop playing this session.
function DataService.save(player: Player, profile: Profile, release: boolean?): (boolean, boolean)
	if not store then
		return false, false
	end
	local activeStore = store :: DataStore
	profile.lastOnline = os.time()
	local stillOwner = true
	local ok = retry("save " .. player.Name, function()
		activeStore:UpdateAsync(keyFor(player), function(current)
			local existing = if type(current) == "table" then current._lock else nil
			if existing ~= nil and not SessionLock.owns(existing, JOB_ID) then
				stillOwner = false
				return nil -- another server owns this save now; never overwrite it
			end
			local data = table.clone(profile) :: any
			data._lock = if release then nil else { jobId = JOB_ID, at = os.time() }
			return data
		end)
		return true
	end)
	if not stillOwner then
		warn("[DataService] Save for", player.Name, "is owned by another server; not overwriting.")
	end
	return ok and stillOwner, not stillOwner
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="177">
        <Properties>
          <string name="Name">GameModes</string>
          <string name="Source"><![CDATA[--[[
	GameModes: the registry of plaza game modes and their shared plumbing.

	A mode is a catalog entry (Modes.Catalog: id, title, blurb, gate slot, enabled) plus an
	implementation registered here (see Modes.Parkour):

	  start(player, teleport, options)
	                           begin a run (teleport = move the player to the mode's start;
	                           options = the "ModeStart" action's data table, or nil);
	                           returns false when refused
	  stop(player, reason)     end the player's run: "quit" | "left" | "respawn" | "leave" |
	                           "switch" | "invalid"
	  running(player)          is the player in a run of this mode?
	  tick(player, root, now)  every TICK seconds for every player with a character
	                           (position polling: start lines, checkpoints, falls)
	  snapshot(player)         the State snapshot's modes[id] table
	  rewardPreview(player)    what finishing right now would pay ({ cash, full, ... })

	Every implementation's create() receives (GameModes, context) with context = { built =
	World.Modes' Built, theme, Tycoon, world = WorldBuilder's whole result }.

	GameModes keeps which mode each player is in, stops runs on leave / respawn, provides the
	teleports (mode start, plaza, own plot) and the Notify / Effect helpers, and adds the
	actions "ModeStart" { mode }, "ModeQuit" and "GoModes". Modes add their own actions
	through context.Tycoon.addAction (Parkour: "ParkourGear" { gear }, "ParkourSkip"). A
	run's stop (any reason, including "respawn" and "leave") must undo whatever the mode put
	on the character (Parkour's gear).

	Notify payloads all have kind = "Mode", `event` and `mode` (see Modes.Parkour for each
	event's fields). Effects are fired on the "Effect" remote as (kind, data).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Net = require(ReplicatedStorage.Shared.Net)

local Catalog = require(script.Parent.Modes.Catalog)
local Course = require(script.Parent.Modes.Course)

local GameModes = {}

export type ModeDef = {
	id: string,
	title: string,
	blurb: string,
	slot: number,
	enabled: boolean,
	start: (player: Player, teleport: boolean, options: { [string]: any }?) -> boolean,
	stop: (player: Player, reason: string) -> (),
	running: (player: Player) -> boolean,
	tick: (player: Player, root: BasePart, now: number) -> (),
	snapshot: (player: Player) -> { [string]: any },
	rewardPreview: (player: Player) -> { [string]: any },
}

-- Implementations of the built-in modes, by catalog id. Each module returns
-- { create = function(GameModes, context) -> ModeDef }.
local BUILTIN = {
	parkour = script.Parent.Modes.Parkour,
	mog = script.Parent.Modes.Mog,
	cardio = script.Parent.Modes.Cardio,
}

local TICK = 0.1

local modes: { [string]: ModeDef } = {}
local order: { string } = {}
local Tycoon: any

-- Reward hooks: `reward` may change a reward before it is paid (events, boosts);
-- `rewarded` is told after it was paid. reward = { cash, full, packCash }.
GameModes.hooks = {
	reward = function(_session: any, _modeId: string, reward: { [string]: any }): { [string]: any }
		return reward
	end,
	rewarded = function(_session: any, _modeId: string, _reward: { [string]: any }) end,
}

local function catalogEntry(id: string): Catalog.Entry?
	for _, entry in Catalog do
		if entry.id == id then
			return entry
		end
	end
	return nil
end

-- Registers a mode implementation; title, blurb, slot and enabled come from the catalog.
function GameModes.register(def: ModeDef)
	local entry = catalogEntry(def.id)
	assert(entry, "unknown game mode " .. tostring(def.id))
	def.title = entry.title
	def.blurb = entry.blurb
	def.slot = entry.slot
	def.enabled = entry.enabled
	if not modes[def.id] then
		table.insert(order, def.id)
	end
	modes[def.id] = def
end

function GameModes.get(id: string): ModeDef?
	return modes[id]
end

function GameModes.list(): { ModeDef }
	local out = {}
	for _, id in order do
		table.insert(out, modes[id])
	end
	return out
end

-- The mode the player is running right now, if any.
function GameModes.active(player: Player): ModeDef?
	for _, id in order do
		local def = modes[id]
		if def.running(player) then
			return def
		end
	end
	return nil
end

function GameModes.start(player: Player, id: string, teleport: boolean, options: { [string]: any }?): boolean
	local def = modes[id]
	if not def or not def.enabled then
		return false
	end
	local current = GameModes.active(player)
	if current and current ~= def then
		current.stop(player, "switch")
	end
	local ok = def.start(player, teleport, options)
	if not ok and current then
		-- The old run is over and the new one was refused: never leave the player standing
		-- on a far arena with no run.
		GameModes.toGates(player)
	end
	return ok
end

function GameModes.stop(player: Player, reason: string)
	local current = GameModes.active(player)
	if current then
		current.stop(player, reason)
	end
end

-- Helpers for mode implementations ---------------------------------------------------------

function GameModes.session(player: Player): any
	return Tycoon and Tycoon.getSession(player)
end

function GameModes.notify(player: Player, event: string, modeId: string, data: { [string]: any }?)
	local session = GameModes.session(player)
	if not session then
		return
	end
	local payload: { [string]: any } = { kind = "Mode", event = event, mode = modeId }
	if data then
		for key, value in data do
			payload[key] = value
		end
	end
	Tycoon.notify(session, payload)
end

function GameModes.effect(player: Player, kind: string, data: { [string]: any })
	Net.event("Effect"):FireClient(player, kind, data)
end

-- Pushes a fresh State snapshot to the player.
function GameModes.refresh(player: Player)
	if Tycoon then
		Tycoon.refresh(player)
	end
end

function GameModes.root(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Moves the player's character so its feet stand at `feet`, facing `look` (horizontal).
function GameModes.teleport(player: Player, feet: Vector3, look: Vector3)
	local character = player.Character
	local root = GameModes.root(player)
	if not character or not root then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hip = if humanoid then humanoid.HipHeight else 2
	local pos = feet + Vector3.new(0, hip + root.Size.Y / 2 + 0.2, 0)
	-- A lifter on a plot's bench press is welded to its seat (World.Decor): let go first.
	local seat = humanoid and humanoid.SeatPart
	local weld = seat and seat:FindFirstChild("SeatWeld")
	if humanoid and weld then
		weld:Destroy()
		humanoid.Sit = false
	end
	character:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(look.X, 0, look.Z)))
	root.AssemblyLinearVelocity = Vector3.zero
end

local function spot(s: { x: number, y: number, z: number }): Vector3
	return Vector3.new(s.x, s.y, s.z)
end

type Spot = { x: number, y: number, z: number }

-- Facing for a plaza spot: its faceX (a direction, or an x to look toward) or `default`
-- (plazas sit west of the hub at -x and mirrored at +x, so the side decides the default).
local function faceOf(s: Spot, default: number): Vector3
	local f = (s :: any).faceX
	if type(f) ~= "number" then
		return Vector3.new(default, 0, 0)
	end
	local dx = if math.abs(f) <= 1 then f else f - s.x
	return Vector3.new(if dx == 0 then default else math.sign(dx), 0, 0)
end

-- The spot nearest the player's current position via Course[helper] (two plazas), else
-- `fallback` (the original plaza's spot).
local function nearest(player: Player, helper: string, fallback: Spot): Spot
	local pick = (Course :: any)[helper]
	local root = GameModes.root(player)
	if type(pick) ~= "function" or not root then
		return fallback
	end
	local found = pick(root.Position.X, root.Position.Z)
	return if type(found) == "table" then found else fallback
end

-- The nearer plaza's arrival point (end of its spur), facing the gates.
function GameModes.toPlaza(player: Player)
	local s = nearest(player, "nearestArrival", Course.ARRIVAL)
	GameModes.teleport(player, spot(s), faceOf(s, if s.x > 0 then 1 else -1))
end

-- In front of the nearer plaza's gates, facing back toward the hub (after quitting a run).
function GameModes.toGates(player: Player)
	local s = nearest(player, "nearestQuit", Course.QUIT)
	GameModes.teleport(player, spot(s), faceOf(s, if s.x > 0 then -1 else 1))
end

-- Brings a player back from a teleport-only arena (a far Parkour level, the Mog stage):
-- after `seconds`, unless they started another run or `stillThere` says they already left,
-- they stand in front of the gates again.
function GameModes.returnLater(player: Player, seconds: number, stillThere: ((root: BasePart) -> boolean)?)
	task.delay(seconds, function()
		local root = GameModes.root(player)
		if not root or GameModes.active(player) then
			return
		end
		if stillThere and not stillThere(root) then
			return
		end
		GameModes.toGates(player)
	end)
end

-- The State snapshot's `modes` table: modes[id] for every registered mode.
function GameModes.snapshot(player: Player): { [string]: any }
	local out = {}
	for _, id in order do
		out[id] = modes[id].snapshot(player)
	end
	return out
end

-- Setup --------------------------------------------------------------------------------------

local function watchPlayer(player: Player)
	player.CharacterAdded:Connect(function()
		GameModes.stop(player, "respawn")
	end)
end

function GameModes.init(built: any, theme: any, tycoon: any, world: any)
	Tycoon = tycoon
	for id, module in BUILTIN do
		local impl = (require :: any)(module)
		GameModes.register(impl.create(GameModes, { built = built, theme = theme, Tycoon = tycoon, world = world }))
		assert(modes[id], "mode " .. id .. " did not register")
	end

	Tycoon.hooks.modes = function(session: any)
		return GameModes.snapshot(session.player)
	end
	-- "Home" during a run ends it first (un-anchors a Mog player, no "left" stop later).
	Tycoon.hooks.leavingForHome = function(session: any)
		GameModes.stop(session.player, "quit")
	end

	Tycoon.addAction("ModeStart", function(session, data)
		if type(data.mode) == "string" then
			GameModes.start(session.player, data.mode, true, data)
		end
	end)
	Tycoon.addAction("ModeQuit", function(session)
		if GameModes.active(session.player) then
			GameModes.stop(session.player, "quit")
			GameModes.toGates(session.player)
		end
	end)
	Tycoon.addAction("GoModes", function(session)
		GameModes.stop(session.player, "quit")
		GameModes.toPlaza(session.player)
	end)

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		GameModes.stop(player, "leave")
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local now = Workspace:GetServerTimeNow()
			for _, player in Players:GetPlayers() do
				local root = GameModes.root(player)
				if root and Tycoon.getSession(player) then
					for _, id in order do
						local ok, err = pcall(modes[id].tick, player, root, now)
						if not ok then
							warn("[GameModes] tick:", err)
						end
					end
				end
			end
		end
	end)
end

return GameModes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="178">
        <Properties>
          <string name="Name">Intro</string>
          <string name="Source"><![CDATA[--[[
	Intro: server side of the opening cutscene (client: Client.Intro.Cutscene).

	The saved profile field introSeen says whether the player has watched it.
	When a session starts it is copied to the Player attribute "IntroSeen";
	the client plays the cutscene when that is false and sends the "IntroSeen"
	action when it ends (finished or skipped), which saves it as true. The action
	also says how it ended ({ skipped = boolean, seconds = story seconds played }),
	which goes to Analytics once.
]]

local Analytics = require(script.Parent.Analytics)
local Tycoon = require(script.Parent.Tycoon)

-- Longest story time the client may report (the cutscene's watchdog ends it by then).
local MAX_SECONDS = 60

local Intro = {}

-- Call before Tycoon.addPlayer sends the first State snapshot.
function Intro.onSessionStart(player: Player, profile: { [string]: any })
	player:SetAttribute("IntroSeen", profile.introSeen == true)
end

function Intro.init()
	Tycoon.addAction("IntroSeen", function(session, data)
		if not session.alive then
			return
		end
		session.player:SetAttribute("IntroSeen", true)
		if session.profile.introSeen ~= true then
			session.profile.introSeen = true
			local seconds = data.seconds
			if type(data.skipped) == "boolean" and type(seconds) == "number" and seconds == seconds then
				Analytics.intro(session, data.skipped, math.clamp(seconds, 0, MAX_SECONDS))
			end
			Tycoon.markDirty(session)
		end
	end)
end

return Intro
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="179">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the map, wires services and handles join/leave/saving.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage:WaitForChild("Theme"))
local Net = require(ReplicatedStorage.Shared.Net)

local Server = script.Parent
local DataService = require(Server.DataService)
local WorldBuilder = require(Server.WorldBuilder)
local Tycoon = require(Server.Tycoon)
local Monetization = require(Server.Monetization)
local Ranking = require(Server.Ranking)
local Tutorial = require(Server.Tutorial)
local Intro = require(Server.Intro)
local GameModes = require(Server.GameModes)
local Cosmetics = require(Server.Cosmetics)
local Analytics = require(Server.Analytics)
local Badges = require(Server.Badges)
local Daily = require(Server.Daily)

local AUTOSAVE_SECONDS = 90

-- Create remotes before anything else so clients never wait long.
Net.event("State")

local world = WorldBuilder.build(Theme)
Tycoon.init(world, Theme)
Tutorial.init()
Intro.init()
Monetization.init(Theme)
GameModes.init(world.modes, Theme, Tycoon, world)
Cosmetics.init(Theme)
Ranking.init(Theme, world.ranking)
Analytics.init()
Badges.init(Theme)
Daily.init(Theme)

local saving: { [Player]: boolean } = {}

local function saveSession(session: Tycoon.Session, release: boolean?)
	if not session.canSave then
		return
	end
	local _, lost = DataService.save(session.player, session.profile, release)
	if lost and not release then
		-- Another server owns this save now (e.g. the player joined elsewhere).
		-- Stop writing from here so progress can never be overwritten.
		session.canSave = false
		session.player:Kick("Your progress is now active in another server. Please rejoin!")
	end
end

local function onPlayerAdded(player: Player)
	local profile, canSave = DataService.load(player)
	if not player.Parent then
		-- Left while loading: hand the session lock back straight away.
		if profile and canSave then
			DataService.save(player, profile, true)
		end
		return
	end
	if not profile then
		player:Kick("We couldn't load your save right now. Please rejoin in a moment - your progress is safe.")
		return
	end
	local passes = Monetization.ownedPasses(player)
	if not player.Parent then
		if canSave then
			DataService.save(player, profile, true)
		end
		return
	end
	-- Before the session's first State snapshot, so the client knows whether to play the intro.
	Intro.onSessionStart(player, profile)
	local session = Tycoon.addPlayer(player, profile, canSave, passes)
	if session then
		Cosmetics.onSessionStart(session)
		Analytics.onSessionStart(session)
		Badges.onSessionStart(session)
		Daily.onSessionStart(session)
	end
end

local function onPlayerRemoving(player: Player)
	local session = Tycoon.removePlayer(player)
	if session and not saving[player] then
		saving[player] = true
		saveSession(session, true)
		saving[player] = nil
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_SECONDS)
		for player, session in Tycoon.allSessions() do
			if not saving[player] then
				task.spawn(saveSession, session)
			end
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player, session in Tycoon.allSessions() do
		pending += 1
		saving[player] = true
		task.spawn(function()
			saveSession(session, true)
			pending -= 1
		end)
	end
	Ranking.writeScores()
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="180">
        <Properties>
          <string name="Name">Modes</string>
        </Properties>
        <Item class="ModuleScript" referent="181">
          <Properties>
            <string name="Name">Cardio</string>
            <string name="Source"><![CDATA[--[[
	Cardio: the CARDIO game mode (gate 3), a keyboard runner out at sea (docs/cardio.md).
	Numbers in Modes.CardioRules, the runway in Modes.CardioLayout (built by World.CardioTrack).

	- "ModeStart" { mode = "cardio" } starts a run in the Warm-Up lobby (stage 1), always: the
	  action's other fields are ignored, so no client can start deeper. Starting again restarts.
	- Steps: every CardioRules.KEY_STEP studs of ground run over a key (server-measured, clamped
	  to what the current WalkSpeed allows) add stepMultiplier(bestStage, treadmill) Speed.
	  Standing on a treadmill adds treadmillRate(zone, treadmill, speed) Speed per second instead
	  (it grows with the player's Speed).
	  Speed (profile.cardio.speed) is permanent; in a run, WalkSpeed = CardioRules.walkSpeed(speed)
	  through the Humanoid "BaseWalkSpeed" attribute (Speedy Sneakers still multiplies on top),
	  lowered to the player's own cap if set.
	- "CardioSpeedCap" { cap: number? }: the player's own max WalkSpeed (the "Custom Speed" box).
	  nil / 0 / invalid clears it; else it is rounded and clamped to [16, walkSpeed(speed)].
	  Kept in profile.cardio.speedCap (0 = none); the base WalkSpeed is min(walkSpeed(speed), cap).
	- Steps are measured on the dense key carpet (CardioLayout.KEY.size studs) but paid per
	  CardioRules.KEY_STEP (8) studs, i.e. one step per ~two keys. Every key counts: bridge
	  sills, run-up pieces, jump / blink / mover / end platforms and decor blocks.
	- No checkpoints at all: feet below CardioLayout.killYAt(x) (the room's killY, just above
	  a bridge room's hazard floor, so landing on the hazard is a fall) or a chaser's catch send
	  the player back to the lobby (the start of stage 1) and the run starts over: nothing
	  reached, chasers reset. Speed, the treadmill level and bestStage are permanent.
	- Reaching a safe zone pays nothing. Zones are reached in order from the lobby, on foot
	  (zone n counts only on its deck, after bridge room n was entered this run with zone
	  n - 1 reached, so a teleport deeper or a late position report reaches nothing). Cash is paid only on a WIN pad (CardioLayout zone.winPad, one per safe zone
	  1..10; zone 10's is the finish): the server sees a living runner's feet on the pad of a
	  zone reached this run (CardioLayout.onWinPad) and pays Economy.modeReward x
	  stageBonus(n) for that zone: a first clear the first time that pad is claimed (always
	  paid; kept per pad in profile.cardio.firsts, CardioRules.firstsOf, so a pad that was run
	  past keeps its first clear for later), else only once per
	  Economy.MODE_REWARD_COOLDOWN (modes.cardio.lastRewardAt, shared by all ten pads; a pad
	  inside the cooldown pays $0). A claim deeper than bestStage raises it and with it the
	  step multiplier. The claim ends the run: back to the lobby with nothing
	  reached, so one run pays at most once and a pad cannot be stepped on again without
	  running its stages again. Walking past a pad keeps the run going toward a bigger one.
	- Leaving the runway any other way (Home, GoModes...) ends the run ("left").
	- "CardioUpgrade": on the lobby SPEED UP pad, spends treadmillCost(level, income) cash for
	  treadmill level + 1 (max CardioRules.TREADMILL_MAX).

	Notify payloads (kind = "Mode", mode = "cardio"):
	  { event = "start", speed, walkSpeed, bestStage, multiplier }      always in the lobby
	  { event = "zone", stage, name, first, cash, full, cooldownEnds }
	                                  reached safe zone `stage`; cash = what its WIN pad pays
	                                  right now (nothing is paid yet)
	  { event = "win", stage, name, final, first, cash, full, cooldownEnds, bestStage, multiplier }
	                                  claimed `stage`'s WIN pad (final = stage 10): paid, back
	                                  in the lobby
	  { event = "fall", stage = 0, from, reason, speed, need, slow, capped }
	                                  back in the lobby from stage `from`; reason "fall" |
	                                  "caught"; speed = whole Speed, need = that stage's need,
	                                  slow = the run's WalkSpeed was below what the need gives,
	                                  capped = ...only because of the player's own speed cap
	  { event = "upgrade", level, cost, rate, multiplier, nextCost? }
	  { event = "refused", reason, cost? }        upgrade refused: "run" | "far" | "max" | "cash"
	  { event = "stop", reason }
	Snapshot: running, speed, walkSpeed (effective base, capped), maxWalkSpeed (uncapped),
	speedCap (nil when none), multiplier, bestStage, treadmill, treadmillMax, treadmillRate,
	nextCost, stage, reached (safe zones reached this run), wins (in a run: wins[n] = cash safe
	zone n's WIN pad pays right now), firsts (in a run: firsts[n] = pad n's first clear is
	still there), onTreadmill, cooldownEnds, stageCount, needs, recommended (Speed the HUD
	recommends per stage, CardioRules.recommended), names.
	Effects: "CardioSteps" { gained, speed, walkSpeed, treadmill, multiplier, rate } (at most ~4
	per second while gaining; speed and gained are whole Speed, treadmill is true on a belt,
	multiplier is the step multiplier, rate the current treadmillRate), "ModeSplash" { pos } on a fall, "ModeFinish" { pos, newBest } on a first clear,
	"Cash" { amount, source = "Mode", padPos } when a WIN pad pays.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Cosmetics = require(script.Parent.Parent.Cosmetics)
local CardioLayout = require(script.Parent.CardioLayout)
local CardioRules = require(script.Parent.CardioRules)
local CardioChase = require(script.Parent.CardioChase) -- CardioChase hook
local Course = require(script.Parent.Course)

local Cardio = {}

local ID = "cardio"
-- Seconds after a teleport during which position checks are skipped.
local TELEPORT_GRACE = 0.6
-- Feet are this far below the HumanoidRootPart's centre on a default character.
local FEET_BELOW_ROOT = 3
-- Seconds between "CardioSteps" effects.
local EFFECT_EVERY = 0.25
-- Ground distance counted per tick: up to WalkSpeed x dt x STEP_SLACK + STEP_EXTRA studs.
local STEP_SLACK = 1.25
local STEP_EXTRA = 0.5
-- Longest tick counted (server hiccups don't turn into a burst of steps).
local MAX_DT = 0.5
-- WalkSpeed is re-applied when the curve moved this much.
local WALK_STEP = 0.25
-- Studs around the runway bounds that still count as "on the runway" (falls past the edge).
local BOUNDS_MARGIN = 80
-- Seconds off the runway before the run ends (a late position report after a teleport).
local LEAVE_SECONDS = 1.5
-- Reach of the SPEED UP pad, studs past its edge (horizontal) and above the deck.
local PAD_REACH = 6
local PAD_HEIGHT = 10

local LAYOUT = CardioLayout.LAYOUT
local BOUNDS = LAYOUT.bounds
local FORWARD = Vector3.new(1, 0, 0)

local NEEDS = {}
local RECOMMENDED = {}
local NAMES = {}
for n, s in CardioRules.STAGES do
	NEEDS[n] = s.need
	RECOMMENDED[n] = CardioRules.recommended(n)
	NAMES[n] = s.name
end

type State = {
	-- Highest safe zone reached this run, in order from the lobby (0 = none yet), and the
	-- bridge room entered toward the next one (reached + 1, or 0).
	reached: number,
	crossing: number,
	lastPos: Vector3?,
	lastT: number,
	graceUntil: number,
	outsideSince: number?,
	-- Studs of key ground not yet turned into a step.
	stepDist: number,
	-- WalkSpeed currently applied (BaseWalkSpeed).
	walk: number,
	-- Whole Speed last reported by "CardioSteps" and when.
	shownSpeed: number,
	lastEffectAt: number,
	stage: number,
	onTreadmill: boolean,
	treadmillZone: number,
}

local function vec(p: { x: number, y: number, z: number }): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

-- Where every run starts and every fall, catch and WIN pad claim ends: the lobby's spawn.
local LOBBY_SPAWN: CardioLayout.Point = CardioLayout.spawn(0) or LAYOUT.zones[1].spawn

local function inBounds(x: number, z: number, margin: number): boolean
	return x >= BOUNDS.x0 - margin and x <= BOUNDS.x1 + margin and z >= BOUNDS.z0 - margin and z <= BOUNDS.z1 + margin
end

function Cardio.create(GameModes: any, context: { built: any, theme: any, Tycoon: any })
	local theme = context.theme
	local Tycoon = context.Tycoon
	local runs: { [Player]: State } = {}
	-- CardioChase hook: chaser Chads on stages 3, 6 and 9 (Modes.CardioChase).
	local chaser = CardioChase.serve(function(p: Player, event: string, data: { [string]: any })
		GameModes.notify(p, event, ID, data)
	end)

	local function now(): number
		return workspace:GetServerTimeNow()
	end

	local function record(
		session: any
	): { speed: number, bestStage: number, treadmill: number, clears: number, speedCap: number, firsts: number? }
		return session.profile.cardio
	end

	-- The WIN pads whose first clear was taken (a bit set; DataService.reconcile fills it in on
	-- saves without it, and this read repairs a record that still lacks it).
	local function firstsOf(session: any): number
		local rec = record(session)
		local firsts = CardioRules.firstsOf(rec.firsts, rec.bestStage)
		rec.firsts = firsts
		return firsts
	end

	-- The player's own max WalkSpeed, or nil when none.
	local function capOf(session: any): number?
		local cap = record(session).speedCap
		return if type(cap) == "number" and cap >= CardioRules.BASE_WALK then cap else nil
	end

	-- Base WalkSpeed in a run: the Speed curve, lowered to the player's cap.
	local function walkOf(session: any): number
		local walk = CardioRules.walkSpeed(record(session).speed)
		local cap = capOf(session)
		return if cap then math.min(walk, cap) else walk
	end

	local function cooldown(session: any): { best: number, clears: number, lastRewardAt: number }
		return session.profile.modes.cardio
	end

	local function multiplierOf(session: any): number
		local rec = record(session)
		return CardioRules.stepMultiplier(rec.bestStage, rec.treadmill)
	end

	local function nextCostOf(session: any): number?
		local rec = record(session)
		if rec.treadmill >= CardioRules.TREADMILL_MAX then
			return nil
		end
		return CardioRules.treadmillCost(rec.treadmill, Tycoon.income(session))
	end

	local function cooldownEnds(session: any): number
		local at = cooldown(session).lastRewardAt
		return if at > 0 then at + Economy.MODE_REWARD_COOLDOWN else 0
	end

	local function humanoidOf(player: Player): Humanoid?
		local character = player.Character
		return character and character:FindFirstChildOfClass("Humanoid")
	end

	local function alive(player: Player): boolean
		local humanoid = humanoidOf(player)
		return humanoid ~= nil and humanoid.Health > 0
	end

	-- Feet below the root's centre: hip height + half the root on R15 (scaled avatars too),
	-- FEET_BELOW_ROOT otherwise. Keeps a body standing on a hazard floor below its killY.
	local function feetBelow(player: Player, root: BasePart): number
		local humanoid = humanoidOf(player)
		if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 and humanoid.HipHeight > 0 then
			return humanoid.HipHeight + root.Size.Y / 2
		end
		return FEET_BELOW_ROOT
	end

	-- Sets the run's WalkSpeed without rebuilding the cosmetics (Sneakers' multiplier kept).
	local function applyWalk(player: Player, state: State, walk: number)
		state.walk = walk
		local humanoid = humanoidOf(player)
		if not humanoid then
			return
		end
		humanoid:SetAttribute("BaseWalkSpeed", walk)
		local mult = humanoid:GetAttribute("SpeedMultiplier")
		humanoid.WalkSpeed = walk * (if type(mult) == "number" then mult else 1)
	end

	local function rewardFor(session: any, stage: number, first: boolean): Economy.ModeReward
		local p = session.profile
		local pack = theme.Modes.Reward
		local progression = Economy.progression(Economy.highestTier(p.discovered), p.processLevel)
		local r = Economy.modeReward(
			Tycoon.income(session),
			progression,
			pack.Seconds,
			pack.Min,
			first,
			cooldown(session).lastRewardAt,
			os.time()
		)
		r.packCash = math.floor(r.packCash * CardioRules.stageBonus(stage) + 0.5)
		r.cash = if r.full then r.packCash else 0
		return r
	end

	-- What safe zone `stage`'s WIN pad pays right now, and whether it would be a first clear
	-- (this pad was never claimed: always paid; anything else pays once per cooldown).
	local function winReward(session: any, stage: number): (Economy.ModeReward, boolean)
		local first = CardioRules.isFirst(firstsOf(session), stage)
		return rewardFor(session, stage, first), first
	end

	local function teleportTo(player: Player, state: State, c: CardioLayout.Point)
		GameModes.teleport(player, vec(c), FORWARD)
		state.lastPos = nil
		state.stepDist = 0
		state.graceUntil = now() + TELEPORT_GRACE
	end

	-- The run starts over (a fall, a catch, a WIN pad claim): back on the lobby spawn with no
	-- safe zone reached and every chaser ready again.
	local function restart(player: Player, state: State, reason: string)
		chaser.stop(player, reason) -- CardioChase hook
		chaser.forget(player) -- CardioChase hook
		state.reached = 0
		state.crossing = 0
		state.stage = 0
		state.onTreadmill = false
		teleportTo(player, state, LOBBY_SPAWN)
	end

	-- Last X seen while not running (plaza gate crossing).
	local lastX: { [Player]: number } = {}

	local def = {} :: any
	def.id = ID

	function def.running(player: Player): boolean
		return runs[player] ~= nil
	end

	-- Every run starts in the lobby (safe zone 0), whatever the "ModeStart" data says: reached
	-- stages (bestStage) are a record, not a place to start from.
	function def.start(player: Player, _teleport: boolean, _options: { [string]: any }?): boolean
		local session = GameModes.session(player)
		if not session then
			return false
		end
		local rec = record(session)
		local t = now()
		chaser.stop(player, "restart") -- CardioChase hook
		chaser.forget(player) -- CardioChase hook
		local state: State = {
			reached = 0,
			crossing = 0,
			lastPos = nil,
			lastT = t,
			graceUntil = t + TELEPORT_GRACE,
			outsideSince = nil,
			stepDist = 0,
			walk = walkOf(session),
			shownSpeed = math.floor(rec.speed),
			lastEffectAt = 0,
			stage = 0,
			onTreadmill = false,
			treadmillZone = 0,
		}
		runs[player] = state
		-- The arena is far out at sea: a run always begins on its deck.
		teleportTo(player, state, LOBBY_SPAWN)
		local humanoid = humanoidOf(player)
		if humanoid then
			humanoid:SetAttribute("BaseWalkSpeed", state.walk)
		end
		Cosmetics.refresh(player)
		GameModes.notify(player, "start", ID, {
			speed = math.floor(rec.speed),
			walkSpeed = state.walk,
			bestStage = rec.bestStage,
			multiplier = multiplierOf(session),
		})
		GameModes.refresh(player)
		return true
	end

	function def.stop(player: Player, reason: string)
		if not runs[player] then
			return
		end
		runs[player] = nil
		chaser.stop(player, reason, reason == "leave") -- CardioChase hook
		chaser.forget(player) -- CardioChase hook
		local humanoid = humanoidOf(player)
		if humanoid then
			humanoid:SetAttribute("BaseWalkSpeed", theme.Cosmetics.BaseWalkSpeed)
		end
		if reason ~= "leave" then
			Cosmetics.refresh(player)
			GameModes.notify(player, "stop", ID, { reason = reason })
			GameModes.refresh(player)
		end
	end

	-- Reached safe zone `stage` (>= 1) this run. Nothing is paid here: the HUD learns what the
	-- zone's WIN pad would pay.
	local function reach(player: Player, session: any, stage: number)
		local reward, first = winReward(session, stage)
		local s = CardioRules.STAGES[stage]
		GameModes.notify(player, "zone", ID, {
			stage = stage,
			name = s and s.name,
			first = first,
			cash = reward.cash,
			full = reward.full,
			cooldownEnds = cooldownEnds(session),
		})
		GameModes.refresh(player)
	end

	-- Stepped on safe zone `stage`'s WIN pad: pays that stage, records it and ends the run
	-- (back to the lobby, nothing reached: one claim per run).
	local function win(player: Player, session: any, state: State, root: BasePart, stage: number)
		local rec = record(session)
		local shared = cooldown(session)
		local firsts = firstsOf(session)
		local first = CardioRules.isFirst(firsts, stage)
		local reward = GameModes.hooks.reward(session, ID, rewardFor(session, stage, first))
		rec.clears += 1
		shared.clears = rec.clears
		rec.firsts = CardioRules.claimFirst(firsts, stage)
		if stage > rec.bestStage then
			rec.bestStage = stage
			shared.best = stage
		end
		if reward.full then
			shared.lastRewardAt = os.time()
		end
		local p = session.profile
		if reward.cash > 0 then
			p.money += reward.cash
			p.totalEarned += reward.cash
			GameModes.effect(player, "Cash", { amount = reward.cash, source = "Mode", padPos = root.Position })
		end
		if first then
			GameModes.effect(player, "ModeFinish", { pos = root.Position, newBest = true })
		end
		restart(player, state, "win")
		local s = CardioRules.STAGES[stage]
		GameModes.notify(player, "win", ID, {
			stage = stage,
			name = s and s.name,
			final = stage >= CardioRules.STAGE_COUNT,
			first = first,
			cash = reward.cash,
			full = reward.full,
			cooldownEnds = cooldownEnds(session),
			bestStage = rec.bestStage,
			multiplier = multiplierOf(session),
		})
		GameModes.hooks.rewarded(session, ID, reward)
		Tycoon.markDirty(session)
		GameModes.refresh(player)
	end

	function def.tick(player: Player, root: BasePart, t: number)
		local state = runs[player]
		if not state then
			-- Walking through this mode's gate on either plaza (toward -X on the first, toward +X
			-- on the mirrored second) starts a run.
			local gx = root.Position.X
			local prevX = lastX[player]
			lastX[player] = gx
			local gate = Course.GATES[def.slot]
			local gate2 = Course.GATES2 and Course.GATES2[def.slot]
			local gz = root.Position.Z
			local crossed = prevX ~= nil
				and (
					(gate ~= nil and prevX > Course.GATE_X and gx <= Course.GATE_X and math.abs(gz - gate.z) <= Course.GATE_HALF + 1)
					or (gate2 ~= nil and prevX < Course.GATE2_X and gx >= Course.GATE2_X and math.abs(gz - gate2.z) <= Course.GATE_HALF + 1)
				)
			if crossed and root.Position.Y - FEET_BELOW_ROOT < Course.PLAZA.top + 8 then
				lastX[player] = nil
				GameModes.start(player, ID, true)
			end
			return
		end
		lastX[player] = nil
		local session = GameModes.session(player)
		if not session then
			return
		end
		local pos = root.Position
		local x, y, z = pos.X, pos.Y - feetBelow(player, root), pos.Z
		local dt = math.clamp(t - state.lastT, 0, MAX_DT)
		state.lastT = t
		if t < state.graceUntil then
			state.lastPos = pos
			return
		end
		if not inBounds(x, z, BOUNDS_MARGIN) then
			state.outsideSince = state.outsideSince or t
			if t - (state.outsideSince :: number) >= LEAVE_SECONDS then
				def.stop(player, "left")
			end
			state.lastPos = nil
			return
		end
		state.outsideSince = nil
		-- The last safe zone passed (the HUD shows stage + 1 as the stage being run).
		state.stage = CardioLayout.startStageAt(x)
		local killY = CardioLayout.killYAt(x)
		-- No checkpoints: a fall or a catch (CardioChase hook) starts the run over in the lobby.
		local failed: string? = nil
		if y < killY then
			GameModes.effect(player, "ModeSplash", { pos = Vector3.new(x, killY - CardioLayout.KILL_ABOVE, z) })
			failed = "fall"
		elseif chaser.tick(player, x, z, t) then
			failed = "caught"
		end
		if failed then
			local from = state.stage + 1
			-- Why, for the HUD: was the run slower than the stage's need asks for?
			local speed = record(session).speed
			local need = NEEDS[from] or 0
			local slow = state.walk < CardioRules.walkSpeed(need) - WALK_STEP
			restart(player, state, failed)
			GameModes.notify(player, "fall", ID, {
				stage = 0,
				from = from,
				reason = failed,
				speed = math.floor(speed),
				need = need,
				slow = slow,
				capped = slow and speed >= need,
			})
			GameModes.refresh(player)
			return
		end

		-- Speed: treadmill or steps on keys.
		local rec = record(session)
		local before = rec.speed
		local zoneStage = CardioLayout.onTreadmill(x, y, z)
		state.onTreadmill = zoneStage ~= nil
		if zoneStage then
			state.treadmillZone = zoneStage
			state.stepDist = 0
			rec.speed += CardioRules.treadmillRate(zoneStage, rec.treadmill, rec.speed) * dt
		else
			local last = state.lastPos
			if last and CardioLayout.isOverKey(x, y, z, t) then
				local moved = Vector3.new(x - last.X, 0, z - last.Z).Magnitude
				local humanoid = humanoidOf(player)
				local mult = humanoid and humanoid:GetAttribute("SpeedMultiplier")
				local walk = state.walk * (if type(mult) == "number" then mult else 1)
				state.stepDist += math.min(moved, walk * dt * STEP_SLACK + STEP_EXTRA)
				if state.stepDist >= CardioRules.KEY_STEP then
					local steps = math.floor(state.stepDist / CardioRules.KEY_STEP)
					state.stepDist -= steps * CardioRules.KEY_STEP
					rec.speed += steps * multiplierOf(session)
				end
			end
		end
		state.lastPos = pos
		if rec.speed ~= before then
			Tycoon.markDirty(session)
			local walk = walkOf(session)
			local top = math.min(CardioRules.WALK_CAP, capOf(session) or math.huge)
			if math.abs(walk - state.walk) >= WALK_STEP or (walk >= top and state.walk ~= walk) then
				applyWalk(player, state, walk)
			end
			local shown = math.floor(rec.speed)
			if shown > state.shownSpeed and t - state.lastEffectAt >= EFFECT_EVERY then
				GameModes.effect(player, "CardioSteps", {
					gained = shown - state.shownSpeed,
					speed = shown,
					walkSpeed = state.walk,
					treadmill = state.onTreadmill,
					multiplier = multiplierOf(session),
					rate = CardioRules.treadmillRate(state.treadmillZone, rec.treadmill, rec.speed),
				})
				state.shownSpeed = shown
				state.lastEffectAt = t
			end
		end

		-- Safe zones are reached in order and on foot: the next zone counts on its deck once its
		-- bridge room was entered this run (a teleport deeper reaches nothing).
		local room = CardioLayout.roomAt(x)
		if room and room.kind == "bridge" and room.stage == state.reached + 1 then
			state.crossing = room.stage
		end
		local zone = CardioLayout.zoneAt(x, z, y)
		if zone and zone.stage == state.reached + 1 and state.crossing == zone.stage then
			state.reached = zone.stage
			reach(player, session, zone.stage)
		end
		-- WIN pad: a living runner on the pad of a zone reached this run cashes out. The claim
		-- restarts the run (nothing reached), so the pad cannot pay twice.
		local padStage = CardioLayout.onWinPad(x, y, z)
		if padStage and padStage <= state.reached and alive(player) then
			win(player, session, state, root, padStage)
		end
	end

	-- What the WIN pad of the next new stage would pay right now.
	function def.rewardPreview(player: Player): { [string]: any }
		local session = GameModes.session(player)
		if not session then
			return { cash = 0, full = false, packCash = 0 }
		end
		local rec = record(session)
		local r = winReward(session, math.min(rec.bestStage + 1, CardioRules.STAGE_COUNT))
		return { cash = r.cash, full = r.full, packCash = r.packCash }
	end

	function def.snapshot(player: Player): { [string]: any }
		local session = GameModes.session(player)
		local state = runs[player]
		local rec = session and record(session)
		local speed = if rec then rec.speed else 0
		local level = if rec then rec.treadmill else 0
		-- In a run: what each safe zone's WIN pad pays right now (the pads' floating labels)
		-- and whether its first clear is still there.
		local wins: { number }? = nil
		local firsts: { boolean }? = nil
		if session and state then
			local list, firstList = {}, {}
			for n = 1, CardioRules.STAGE_COUNT do
				local reward, first = winReward(session, n)
				list[n] = reward.cash
				firstList[n] = first
			end
			wins, firsts = list, firstList
		end
		return {
			running = state ~= nil,
			speed = math.floor(speed),
			walkSpeed = if session then walkOf(session) else CardioRules.walkSpeed(speed),
			maxWalkSpeed = CardioRules.walkSpeed(speed),
			speedCap = if session then capOf(session) else nil,
			multiplier = CardioRules.stepMultiplier(if rec then rec.bestStage else 0, level),
			bestStage = if rec then rec.bestStage else 0,
			treadmill = level,
			treadmillMax = CardioRules.TREADMILL_MAX,
			treadmillRate = CardioRules.treadmillRate(if state then state.treadmillZone else 0, level, speed),
			nextCost = if session then nextCostOf(session) else nil,
			stage = if state then state.stage else 0,
			reached = if state then state.reached else 0,
			wins = wins,
			firsts = firsts,
			onTreadmill = if state then state.onTreadmill else false,
			cooldownEnds = if session then cooldownEnds(session) else 0,
			stageCount = CardioRules.STAGE_COUNT,
			needs = NEEDS,
			recommended = RECOMMENDED,
			names = NAMES,
		}
	end

	local function refuse(session: any, reason: string, text: string, cost: number?)
		Tycoon.toast(session, text, "bad")
		GameModes.notify(session.player, "refused", ID, { reason = reason, cost = cost })
	end

	Tycoon.addAction("CardioUpgrade", function(session: any)
		local player = session.player
		if not runs[player] then
			refuse(session, "run", "Start a Cardio run to upgrade your treadmill!")
			return
		end
		local root = GameModes.root(player)
		local lobby = CardioLayout.zone(0)
		local pad = lobby and lobby.upgradePad
		if not root or not lobby or not pad then
			return
		end
		local pos = root.Position
		local feet = pos.Y - FEET_BELOW_ROOT
		local reach = pad.size / 2 + PAD_REACH
		if math.abs(pos.X - pad.x) > reach or math.abs(pos.Z - pad.z) > reach or feet < lobby.top - 2 or feet > lobby.top + PAD_HEIGHT then
			refuse(session, "far", "Step on the SPEED UP pad in the Warm-Up lobby!")
			return
		end
		local rec = record(session)
		local cost = nextCostOf(session)
		if not cost then
			refuse(session, "max", "Your treadmill is already at max speed!")
			return
		end
		if session.profile.money < cost then
			refuse(session, "cash", "Not enough cash yet! Keep running and come back.", cost)
			return
		end
		session.profile.money -= cost
		rec.treadmill += 1
		GameModes.notify(player, "upgrade", ID, {
			level = rec.treadmill,
			cost = cost,
			rate = CardioRules.treadmillRate(0, rec.treadmill, rec.speed),
			multiplier = multiplierOf(session),
			nextCost = nextCostOf(session),
		})
		Tycoon.markDirty(session)
		GameModes.refresh(player)
	end)

	Tycoon.addAction("CardioSpeedCap", function(session: any, data: { [string]: any })
		local player = session.player
		local rec = record(session)
		local asked = type(data) == "table" and data.cap or nil
		local cap = 0
		if type(asked) == "number" and asked == asked and asked > 0 and asked ~= math.huge then
			-- Rounded after the clamp: a cap a fraction above the curve still only lowers WalkSpeed
			-- through walkOf's min.
			local max = CardioRules.walkSpeed(rec.speed)
			cap = math.floor(math.clamp(asked, CardioRules.BASE_WALK, max) + 0.5)
		end
		if rec.speedCap == cap then
			return
		end
		rec.speedCap = cap
		local state = runs[player]
		if state then
			applyWalk(player, state, walkOf(session))
		end
		Tycoon.markDirty(session)
		GameModes.refresh(player)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		runs[player] = nil
		lastX[player] = nil
		chaser.forget(player) -- CardioChase hook
	end)
	return def
end

return Cardio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="182">
          <Properties>
            <string name="Name">CardioChase</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CardioChase: the CHASER CHADS of the CARDIO keyboard runner (stages 3, 6 and 9). Pure and
	deterministic (no Roblox APIs; unit-tested in tests/cardio_chase.luau); Modes.Cardio calls
	`serve(...)` once and feeds it every running player's position each tick.

	A chase stage's SECTION is its bridge room's path (CardioLayout platforms of stage n: west
	sill, run-up, jump platforms, end platform, east sill). Walking TRIGGER studs onto the
	run-up (its first "run" piece starts at `x0`; within TRIGGER_WINDOW studs past that, so a
	teleport deep into the stage does not start one) begins a chase: a big Chad of
	TUNING[n].tier, scaled TUNING[n].scale, appears in the west doorway (`startX`) and, after
	`headStart` seconds, runs along the path's CENTRE LINE `line` (vertices { s, x, z, half }:
	every surface's centre from x0 to x1, joined straight over gaps and the run-up's jog; s =
	distance along it, half = the surface's half width across Z):
	  s(t)  = min(stopS, startS + speed * max(0, t - startAt))
	  x, pz, half = the line at s (linear between vertices)
	  z(t)  = clamp(pz + clamp(playerZ - pz, -half, half) * min(1, run / LANE_EASE), zMin, zMax)
	with speed = factor * walkSpeed(need_n) (TUNING[n].factor, SPEED_FACTOR unless set) and
	zMin / zMax the room's side walls minus WALL_MARGIN. It hovers / hops over gaps (the client draws a jump arc from `path`) and stops
	STOP_SHORT studs before the end platform (stopS). A runner at walkSpeed(need_n) along the
	same line stays ahead with >= MIN_SLACK seconds to spare; anyone slower
	(walkSpeed(need_n-1) can't clear the stage's longest gap) gets caught.
	Stage 3 is the first chase a runner meets, so its Chad is gentler (a 2 s head start at 0.85
	of the walk speed, was 1.2 s at 0.9): a runner at exactly the need can lose FIRST_SLACK
	(2) seconds there, against about 1.2 on stages 6 and 9.
	  caught    chaser x >= player x - catchRadius  -> back to the lobby (Modes.Cardio)
	  escaped   player x >= endX (ESCAPE_IN studs onto the end platform, before the timed exit
	            door; not chased again this run)
	  retreat   player x < x0 - 1 (back in the west doorway; re-entering restarts it)
	The client (Fx.CardioChase) gets the whole chase in the "chase" notify and places the Chad
	with the same formula every frame from workspace:GetServerTimeNow().
]]

local Rules = require(script.Parent.CardioRules)
local Layout = require(script.Parent.CardioLayout)

local CardioChase = {}

CardioChase.STAGES = { 3, 6, 9 }
-- Chaser speed as a share of walkSpeed(need_n).
CardioChase.SPEED_FACTOR = 0.9
-- Studs onto the run-up that start a chase, and how far past that a chase may still start.
CardioChase.TRIGGER = 6
CardioChase.TRIGGER_WINDOW = 40
-- Seconds for the chaser to swing from the path's centre toward the player's z.
CardioChase.LANE_EASE = 1
-- The chaser stops this far short of the end platform (hovering over the last gap).
CardioChase.STOP_SHORT = 3
-- Studs onto the end platform that count as an escape.
CardioChase.ESCAPE_IN = 2
-- Keep the chaser this far inside the bridge room's side walls.
CardioChase.WALL_MARGIN = 6
-- Seconds a runner at exactly walkSpeed(need_n) may lose (blinking keys, a late jump) and
-- still escape (checked in tests/cardio_chase.luau).
CardioChase.MIN_SLACK = 1
-- The same for the first chase stage (3), where a new runner hesitates before the jumps.
CardioChase.FIRST_SLACK = 2

export type Tuning = {
	tier: number,
	scale: number,
	headStart: number,
	catchRadius: number,
	speed: number,
	factor: number?,
}

-- Per chase stage: Theme.Tiers index of the chaser's look, model scale, seconds of head
-- start, catch radius (studs along X). speed (studs/s) is set below from `factor`
-- (SPEED_FACTOR unless given).
CardioChase.TUNING = {
	[3] = { tier = 10, scale = 2.0, headStart = 2.0, catchRadius = 4, speed = 0, factor = 0.85 },
	[6] = { tier = 17, scale = 2.2, headStart = 1.2, catchRadius = 4.5, speed = 0 },
	[9] = { tier = 24, scale = 2.4, headStart = 1.2, catchRadius = 5, speed = 0 },
} :: { [number]: Tuning }

for n, tune in CardioChase.TUNING do
	local factor = tune.factor or CardioChase.SPEED_FACTOR
	tune.speed = math.floor(factor * Rules.walkSpeed(Rules.STAGES[n].need) * 10 + 0.5) / 10
end

-- A walking surface along the section: [x0, x1] at height top, across [z0, z1].
export type Surface = { x0: number, x1: number, top: number, z0: number, z1: number }
-- A vertex of the path's centre line: distance s along it, position (x, z), half width.
export type Vertex = { s: number, x: number, z: number, half: number }

export type Section = {
	stage: number,
	-- Start of the run-up (first "run" piece), the escape line and the chaser's stop.
	x0: number,
	endX: number,
	stopX: number,
	-- The bridge path's surfaces in order along +X and their centre line.
	path: { Surface },
	line: { Vertex },
	startX: number,
	startS: number,
	stopS: number,
	zMin: number,
	zMax: number,
}

export type Chase = {
	stage: number,
	tier: number,
	scale: number,
	speed: number,
	headStart: number,
	catchRadius: number,
	startX: number,
	startZ: number,
	startS: number,
	stopS: number,
	startAt: number,
	endX: number,
	zMin: number,
	zMax: number,
	path: { Surface },
	line: { Vertex },
}

local LAYOUT = Layout.LAYOUT
local SECTIONS: { [number]: Section } = {}

local function round1(v: number): number
	return math.floor(v * 10 + 0.5) / 10
end

-- The centre line at distance s: x, z, half width (clamped to the line's ends).
function CardioChase.lineAt(line: { Vertex }, s: number): (number, number, number)
	local first = line[1]
	if s <= first.s then
		return first.x, first.z, first.half
	end
	for i = 2, #line do
		local b = line[i]
		if s <= b.s then
			local a = line[i - 1]
			local u = if b.s > a.s then (s - a.s) / (b.s - a.s) else 1
			return a.x + (b.x - a.x) * u, a.z + (b.z - a.z) * u, a.half + (b.half - a.half) * u
		end
	end
	local last = line[#line]
	return last.x, last.z, last.half
end

-- Distance along the line where it first reaches x.
function CardioChase.arcAt(line: { Vertex }, x: number): number
	if x <= line[1].x then
		return line[1].s
	end
	for i = 2, #line do
		local a, b = line[i - 1], line[i]
		if x <= b.x then
			local u = if b.x > a.x then (x - a.x) / (b.x - a.x) else 1
			return a.s + (b.s - a.s) * u
		end
	end
	return line[#line].s
end

for n in CardioChase.TUNING do
	local room = Layout.room(n)
	assert(room, `CardioChase: no bridge room for stage {n}`)
	local plats = {}
	for _, p in LAYOUT.platforms do
		if p.stage == n then
			table.insert(plats, p)
		end
	end
	table.sort(plats, function(a, b)
		return a.x0 < b.x0
	end)
	local path: { Surface } = {}
	local line: { Vertex } = {}
	local x0, endPlat: Layout.Platform? = nil, nil
	for _, p in plats do
		if p.kind == "run" and not x0 then
			x0 = p.x0
		elseif p.kind == "end" then
			endPlat = p
		end
		local s: Surface = { x0 = round1(p.x0), x1 = round1(p.x1), top = round1(p.top), z0 = round1(p.z0), z1 = round1(p.z1) }
		table.insert(path, s)
		local zc, half = (s.z0 + s.z1) / 2, (s.z1 - s.z0) / 2
		for _, vx in { s.x0, s.x1 } do
			local prev = line[#line]
			local d = if prev then math.sqrt((vx - prev.x) ^ 2 + (zc - prev.z) ^ 2) else 0
			table.insert(line, { s = if prev then round1(prev.s + d) else 0, x = vx, z = zc, half = half })
		end
	end
	assert(x0 and endPlat, `CardioChase: stage {n} has no run-up / end platform`)
	local startX = x0 - Layout.DOOR_WALL / 2
	local stopX = endPlat.x0 - CardioChase.STOP_SHORT
	SECTIONS[n] = {
		stage = n,
		x0 = x0,
		endX = endPlat.x0 + CardioChase.ESCAPE_IN,
		stopX = stopX,
		path = path,
		line = line,
		startX = startX,
		startS = CardioChase.arcAt(line, startX),
		stopS = CardioChase.arcAt(line, stopX),
		zMin = room.z0 + CardioChase.WALL_MARGIN,
		zMax = room.z1 - CardioChase.WALL_MARGIN,
	}
end

function CardioChase.isChaseStage(n: number): boolean
	return CardioChase.TUNING[n] ~= nil
end

function CardioChase.section(n: number): Section?
	return SECTIONS[n]
end

-- Is a runner at x (in stage n's bridge room) where a chase starts?
function CardioChase.triggers(n: number, x: number): boolean
	local sec = SECTIONS[n]
	if not sec then
		return false
	end
	local from = sec.x0 + CardioChase.TRIGGER
	return x >= from and x <= from + CardioChase.TRIGGER_WINDOW
end

function CardioChase.begin(n: number, _z: number, now: number): Chase?
	local sec, tune = SECTIONS[n], CardioChase.TUNING[n]
	if not sec or not tune then
		return nil
	end
	local _, startZ = CardioChase.lineAt(sec.line, sec.startS)
	return {
		stage = n,
		tier = tune.tier,
		scale = tune.scale,
		speed = tune.speed,
		headStart = tune.headStart,
		catchRadius = tune.catchRadius,
		startX = sec.startX,
		startZ = math.clamp(startZ, sec.zMin, sec.zMax),
		startS = sec.startS,
		stopS = sec.stopS,
		startAt = now + tune.headStart,
		endX = sec.endX,
		zMin = sec.zMin,
		zMax = sec.zMax,
		path = sec.path,
		line = sec.line,
	}
end

-- Chaser feet (x, z) at server time t, on the path's centre line eased toward the player's z.
function CardioChase.position(chase: Chase, t: number, playerZ: number): (number, number)
	local run = math.max(0, t - chase.startAt)
	local s = math.min(chase.stopS, chase.startS + chase.speed * run)
	local x, pz, half = CardioChase.lineAt(chase.line, s)
	local pull = math.clamp(playerZ - pz, -half, half) * math.min(1, run / CardioChase.LANE_EASE)
	return x, math.clamp(pz + pull, chase.zMin, chase.zMax)
end

-- Feet height along a path at x: the surface top, or a jump arc over gaps.
function CardioChase.groundY(path: { Surface }, x: number, hop: number?): number
	local prev: Surface? = nil
	for _, s in path do
		if x < s.x0 then
			if not prev then
				return s.top
			end
			local u = (x - prev.x1) / math.max(0.01, s.x0 - prev.x1)
			local h = hop or 4
			return prev.top + (s.top - prev.top) * u + 4 * h * u * (1 - u)
		elseif x <= s.x1 then
			return s.top
		end
		prev = s
	end
	return if prev then prev.top else 0
end

-- "caught" | "escaped" | "retreat" | nil (still on) for a runner at (x, z) at time t.
function CardioChase.update(chase: Chase, x: number, z: number, t: number): string?
	if x >= chase.endX then
		return "escaped"
	end
	if x < chase.startX + Layout.DOOR_WALL / 2 - 1 then
		return "retreat"
	end
	local cx = CardioChase.position(chase, t, z)
	if t >= chase.startAt and cx >= x - chase.catchRadius then
		return "caught"
	end
	return nil
end

-- The "chase" notify payload (everything the client needs to replay the chaser).
function CardioChase.payload(chase: Chase): { [string]: any }
	local path, line = {}, {}
	for _, s in chase.path do
		table.insert(path, { s.x0, s.x1, s.top, s.z0, s.z1 })
	end
	for _, v in chase.line do
		table.insert(line, { v.s, v.x, v.z, v.half })
	end
	local stopX = CardioChase.lineAt(chase.line, chase.stopS)
	return {
		stage = chase.stage,
		tier = chase.tier,
		scale = chase.scale,
		speed = chase.speed,
		startX = chase.startX,
		startZ = chase.startZ,
		startS = chase.startS,
		stopS = chase.stopS,
		startAt = chase.startAt,
		endX = stopX,
		zMin = chase.zMin,
		zMax = chase.zMax,
		laneEase = CardioChase.LANE_EASE,
		path = path,
		line = line,
	}
end

export type Server = {
	-- Feed a running player's feet each tick; true when the chaser caught them this tick (the
	-- run starts over in the lobby).
	tick: (player: any, x: number, z: number, t: number) -> boolean,
	-- Ends the player's chase (if any) with `reason`; "chaseEnd" unless silent.
	stop: (player: any, reason: string, silent: boolean?) -> (),
	-- The run ended or started over: also forget which chases were escaped.
	forget: (player: any) -> (),
	active: (player: any) -> Chase?,
}

-- Per-player chase state for Modes.Cardio. notify(player, event, payload) sends a cardio
-- Notify ("chase" | "caught" | "chaseEnd").
function CardioChase.serve(notify: (any, string, { [string]: any }) -> ()): Server
	local chases: { [any]: Chase } = {}
	local escaped: { [any]: { [number]: boolean } } = {}
	local server = {} :: Server

	function server.tick(player: any, x: number, z: number, t: number): boolean
		local c = chases[player]
		if c then
			local result = CardioChase.update(c, x, z, t)
			if result == "caught" then
				chases[player] = nil
				notify(player, "caught", { stage = c.stage })
				return true
			elseif result then
				chases[player] = nil
				if result == "escaped" then
					escaped[player] = escaped[player] or {}
					escaped[player][c.stage] = true
				end
				notify(player, "chaseEnd", { stage = c.stage, reason = result })
			end
			return false
		end
		local n = Layout.stageAt(x)
		local done = escaped[player]
		if CardioChase.triggers(n, x) and not (done and done[n]) then
			local chase = CardioChase.begin(n, z, t)
			if chase then
				chases[player] = chase
				notify(player, "chase", CardioChase.payload(chase))
			end
		end
		return false
	end

	function server.stop(player: any, reason: string, silent: boolean?)
		local c = chases[player]
		if c then
			chases[player] = nil
			if not silent then
				notify(player, "chaseEnd", { stage = c.stage, reason = reason })
			end
		end
	end

	function server.forget(player: any)
		chases[player] = nil
		escaped[player] = nil
	end

	function server.active(player: any): Chase?
		return chases[player]
	end

	return server
end

return CardioChase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="183">
          <Properties>
            <string name="Name">CardioLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CardioLayout: pure, deterministic layout of the CARDIO keyboard runner (no Roblox APIs,
	no math.random; unit-tested in tests/cardio.luau), shared by World.CardioTrack (builds it),
	Modes.Cardio (teleports, steps, treadmills, safe zones, falls) and
	Modes.CardioChase.

	THEMED ROOMS along +X, centred on z = ORIGIN.z, from ORIGIN.x to at most X_END. `rooms`
	tiles the X axis with no gaps, in this order:
	  lobby (stage 0)   a full key-carpet room (treadmills, upgrade pad), CORRIDOR.width wide;
	  for n = 1..10:
	    bridge room n   ROOM.width wide, ROOM.height tall: a hazard floor (theme's melted
	                    chocolate / candy tiles / ...) ROOM.floorDrop studs below the deck
	                    height, crossed by a NARROW KEY BRIDGE Rules.STAGES[n].width wide
	                    (9 keys on stage 1 .. 4 keys from stage 8). Its west and east walls are
	                    DOOR_WALL (= one key) thick with a doorway each (`doors`), DOOR.keys
	                    wide and at most DOOR_REACH off the centre line;
	    safe zone n     a full key-carpet room as wide as the bridge rooms (ZONE_KEYS; zone
	                    10 = FINISH_KEYS) between bridge room n's east wall and bridge room
	                    n+1's west wall. Across Z it has three bands: the LANE in the middle
	                    (every doorway opens inside it, so the run from door to door is
	                    free), the WIN pad (`winPad`, WIN_PAD square) in the north band and
	                    four treadmills in the south band. Zone 10's WIN pad is the finish: it
	                    sits on the centre line in front of the podium (`finish`).
	A bridge room's walkable path, in order (all `platforms`, x-disjoint and increasing):
	  "sill"  one key long, door-width wide: the floor of the west doorway (inside the wall;
	          a porch wider than the bridge on every stage but the first);
	  "run"   the run-up (index 0) as three pieces: a straight run along X, a sideways LEG (a
	          90-degree jog: the leg is `width` long along X and spans both runs across Z),
	          then a second straight run at another lateral offset. Steps are farmed here;
	  "key" | "blink" | "mover"  stage n's jump platforms (index k = after jump k), with the
	          gaps / rises of CardioRules.jumps(n) (jump 1 leaves the run-up's far edge);
	  "end"   the raised landing platform (index = #jumps; the last jump lands here), END_KEYS
	          wide, in front of the east door;
	  "sill"  the floor of the east doorway, then safe zone n's deck.
	Consecutive surfaces either touch (flush walk, same top) or are a CardioRules jump along
	+X; across Z they always share >= 2 keys. Everything outside the path in a bridge room is
	hazard: feet below killYAt(x) (= the room's killY, just above its floorY) is a fall.

	Keys: (x, z) is the centre, `y` the TOP surface (feet level); the part's centre is
	y - KEY.height / 2. Letters run in keyboard rows across Z; each key has a `tint` (1..3)
	into THEMES[themeOf(stage)].keys (= PALETTES[stage + 1]). Blinking keys are solid while
	((t + phase) % blinkPeriod) < blinkOn; sliding keys are offset along `axis` ("z") by
	travel * sin(2 pi (t + phase) / period), t = server time. Keys of one platform (`group`)
	blink / slide together. kind "block" keys belong to `blocks` (decor islands, group 0).
	Walls and bases are boxes by CENTRE (x, y, z) and size (sx, sy, sz).
	Treadmills: (x, z) centre, y = belt top; TREADMILL.length along X; yaw for
	CFrame.Angles(0, yaw, 0).

	New fields for World.CardioTrack (see the export types below for every field):
	  rooms    Room boxes { id, kind "lobby"|"bridge"|"zone", stage, theme, x0, x1 (whole
	           span incl. a bridge room's end walls), z0, z1 (side walls' inner faces),
	           floorY (hazard surface top; build a slab with its top here over x0..x1/z0..z1),
	           killY, wallTop }.
	  THEMES   by id: keys (3 RGB), hazard { color, material "Neon"|"Glass"|"SmoothPlastic"|
	           "Foil", liquid, pattern "tiles"|"river"|"waves"|"clouds"|"grid"|"stripes" },
	           wall, truss (neon X frames), edge (neon key-block edges), props (mesh names).
	  doors    { x (wall centre), y (= sill top, the doorway's bottom), z, width, height,
	           stage, side "west"|"east", timed, open, period, phase }: the doorway is open
	           while ((t + phase) % period) < open (doorOpen()); timed = false doors never
	           close (no slab, just a frame). Timed doors (east walls from stage 3) want a
	           countdown sign above them.
	  trusses  { a = {x,y,z}, b = {x,y,z}, thick, stage, wall } beam segments (square
	           section `thick`) of the orange X frames on a bridge room's inner wall faces.
	  props    { kind, x, y, z, yaw, scale, stage, wall, normal?, float }: candy meshes
	           (CandyDonut ...) scaled so their largest side = scale. Floor props: (x, y, z) =
	           bottom centre on the hazard floor (float = sunk into a liquid, y below
	           floorY). Wall props (wall = true): (x, y, z) = centre on the wall's inner face,
	           normal = unit vector into the room. yaw is radians about +Y.
	  blocks   { id, stage, x0, x1, z0, z1, top }: raised neon-edged key islands beside the
	           path (keys kind "block"); their `bases` (block = id) reach down to floorY.
	  signs    stage banner over the west doorway, inside the room (archSpan / archHeight
	           = the doorway frame's outer width / height above the deck).
]]

local Rules = require(script.Parent.CardioRules)

local CardioLayout = {}

CardioLayout.ORIGIN = { x = -1296, y = 20, z = 1150 }
-- The finish deck's far edge never passes this X (the east cap wall stands just past it):
-- the runway mirrors ORIGIN.x about x = 0.
CardioLayout.X_END = 1296
-- Key pitch (studs), keycap height and the visible cap size (keys touch at the pitch; the
-- thin seams show the base). The props/Key_A..Z meshes are scaled to (cap, height, cap).
CardioLayout.KEY = { size = 2.8, height = 1.16, cap = 2.72 }
-- Keys are visual only: every walkable surface has one invisible collision slab whose top is
-- PRESS below the key tops, and the client sinks the keys under feet by exactly PRESS (World.
-- CardioTrack sets it as the CardioTrack folder's PressDepth attribute), so feet rest on
-- pressed keys and the character never rides keys up and down (~0.85 x KEY.height: a key bottoms out almost flush with its base).
CardioLayout.PRESS = 1
-- Lobby width (studs, keys); bridge rooms and safe zones are ROOM.width wide.
CardioLayout.CORRIDOR = { width = 29 * CardioLayout.KEY.size, lanes = 29 }
-- Deck sizes in keys (along X, across Z). Safe zones span the bridge rooms' full width.
CardioLayout.LOBBY_KEYS = { long = 20, wide = 29 }
CardioLayout.ZONE_KEYS = { long = 16, wide = 45 }
CardioLayout.FINISH_KEYS = { long = 20, wide = 45 }
-- Safe zones: the middle band across Z (studs) that every doorway opens into. The WIN pad
-- and the treadmills stand outside it, so running from door to door touches neither.
CardioLayout.LANE = 25 * CardioLayout.KEY.size
-- The raised landing platform at a bridge room's far end (keys).
CardioLayout.END_KEYS = { long = 5, wide = 19 }
-- Bridge rooms: width between the side walls' inner faces, wall top above ORIGIN.y, hazard
-- floor depth below ORIGIN.y, and the margin the bridge (with mover sweeps) keeps from the
-- side walls.
CardioLayout.ROOM = { width = 126, height = 45, floorDrop = 10, margin = 22 }
-- Lobby / safe zone wall top above ORIGIN.y.
CardioLayout.ZONE_WALL_HEIGHT = 30
-- Feet this far above a room's floorY still count as standing (killY = floorY + KILL_ABOVE).
CardioLayout.KILL_ABOVE = 1.5
-- Feet below this (anywhere in the mode) count as a fall; every room's killY equals it.
CardioLayout.KILL_Y = CardioLayout.ORIGIN.y - CardioLayout.ROOM.floorDrop + CardioLayout.KILL_ABOVE
-- Shortest run-up a stage may get (studs, incl. the jog leg); generate() errors below it.
CardioLayout.RUNUP_MIN = 48
-- Side / cap walls: thickness and bottom Y (below the hazard floor).
CardioLayout.WALL = { thick = 2, bottom = 4 }
-- Bridge room end walls are one key thick so a sill key row fills each doorway.
CardioLayout.DOOR_WALL = CardioLayout.KEY.size
-- Doorways (both end walls): width in keys, height above the sill top; exit door timing per
-- stage (from stage 3).
CardioLayout.DOOR = { keys = 9, height = 14 }
-- Farthest a doorway's centre sits from the centre line (studs, whole keys): the doorway
-- stays inside the LANE, which is narrower than the lobby.
CardioLayout.DOOR_REACH = math.floor((CardioLayout.LANE / CardioLayout.KEY.size - CardioLayout.DOOR.keys) / 2 + 1e-6)
	* CardioLayout.KEY.size
CardioLayout.DOOR_TIMES = {
	[3] = { open = 4, period = 6 },
	[4] = { open = 3.8, period = 6 },
	[5] = { open = 3.5, period = 6 },
	[6] = { open = 3.3, period = 5.8 },
	[7] = { open = 3, period = 5.5 },
	[8] = { open = 2.8, period = 5.2 },
	[9] = { open = 2.6, period = 5 },
	[10] = { open = 2.5, period = 5 },
} :: { [number]: { open: number, period: number } }
-- Chocolate slab under every static carpet: thickness, and the air between its top and the
-- key bottoms.
CardioLayout.BASE = { depth = 2, drop = 0.2 }
-- X-truss frames: beam thickness and target bay width (studs).
CardioLayout.TRUSS = { thick = 1.6, bay = 52 }
-- Per bridge room: floor props, wall props, decor key blocks, extra floor props in clusters
-- along the side walls, and groups of three wall props.
CardioLayout.PROPS = { floor = 26, wall = 8, blocks = 4, edgeFloor = 9, wallGroups = 4 }
-- Clearance (studs) between floor props / blocks and the path's footprint (incl. gaps).
CardioLayout.PROP_CLEAR = 4
CardioLayout.TREADMILL = { length = 10, width = 6, height = 1.2 }
CardioLayout.UPGRADE_PAD = 6
-- WIN pad side (studs, whole keys) and, in keys from the centre line, where its centre and
-- the two treadmill rows sit across Z in safe zones 1..9 (zone 10's pad is on the centre line).
CardioLayout.WIN_PAD = 5 * CardioLayout.KEY.size
CardioLayout.WIN_PAD_SIDE = 18
CardioLayout.TREADMILL_ROWS = { 15.5, 19.5 }
-- Stage banner centre height above the deck (over the west doorway).
CardioLayout.SIGN_HEIGHT = 24
CardioLayout.ARCH = { frame = 2 }
-- Chance a key's tint avoids both its left and back neighbours' tints (else fully random).
CardioLayout.TINT_SPREAD = 0.8

export type RGB = { r: number, g: number, b: number }

local function rgb(r: number, g: number, b: number): RGB
	return { r = r, g = g, b = b }
end

export type Hazard = { color: RGB, material: string, liquid: boolean, pattern: string }
export type Theme = {
	id: string,
	name: string,
	-- Key tints 1..3.
	keys: { RGB },
	hazard: Hazard,
	wall: RGB,
	truss: RGB,
	edge: RGB,
	props: { string },
}

local function theme(id: string, name: string, keys: { RGB }, hazard: Hazard, wall: RGB, truss: RGB, edge: RGB, props: { string }): Theme
	return { id = id, name = name, keys = keys, hazard = hazard, wall = wall, truss = truss, edge = edge, props = props }
end

