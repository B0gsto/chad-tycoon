	})
end

ICONS.Sound = function(root, color)
	shape(root, {
		Name = "Box",
		Color = color,
		Size = UDim2.fromScale(0.22, 0.34),
		Position = UDim2.fromScale(0.24, 0.5),
		Radius = 2,
		Light = false,
