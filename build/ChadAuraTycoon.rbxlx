-- Emoji keys from Theme.Icons map to shape names so callers can pass either.
local EMOJI_TO_ICON: { [string]: string } = {}
for name, glyph in Theme.Icons do
	if ICONS[name] then
		EMOJI_TO_ICON[glyph] = name
	end
end
EMOJI_TO_ICON["💰"] = "Coin"
EMOJI_TO_ICON["💵"] = "Coin"
EMOJI_TO_ICON["🔒"] = "Lock"
EMOJI_TO_ICON["✓"] = "Check"
EMOJI_TO_ICON["X"] = "Close"
EMOJI_TO_ICON["⭐"] = "Star"
EMOJI_TO_ICON["★"] = "Star"

function Kit.iconName(icon: string?): string?
	if not icon then
		return nil
	end
	if ICONS[icon] then
		return icon
	end
	local mapped = EMOJI_TO_ICON[icon]
	if mapped then
		return mapped
	end
	-- Image-only icons (Shared.Assets Icons with no shape builder, e.g. "Modes")
	-- are icons too, so buttons draw them instead of printing the name.
	return if Kit.hasImageIcon(icon) then icon else nil
end

-- Optional image icons: ReplicatedStorage.Shared.Assets may export
-- Icons[name] = { image = "rbxassetid://...", x?, y?, w?, h? } (an atlas cell).
-- Looked up once; a missing module or key falls back to the shape icon.
local assetIcons: { [string]: any }? = nil
local assetsLoaded = false
local function imageIcon(name: string, resolved: string?): { [string]: any }?
	if not assetsLoaded then
		assetsLoaded = true
		local shared = ReplicatedStorage:FindFirstChild("Shared")
		local module = shared and shared:FindFirstChild("Assets")
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(require, module :: any)
			if ok and type(result) == "table" and type((result :: any).Icons) == "table" then
				assetIcons = (result :: any).Icons
			end
		end
	end
	local icons = assetIcons
	if not icons then
		return nil
	end
	local entry = icons[name] or (if resolved then icons[resolved] else nil)
	if type(entry) == "table" and type(entry.image) == "string" and entry.image ~= "" then
		return entry
	end
	return nil
end

--[[
	Icon. `name` is a Kit.ICONS key (or an emoji from Theme.Icons that maps to
	one). Returns a transparent square frame of `size` holding the shapes;
	recolour by rebuilding. When Shared.Assets provides Icons[name], the frame
	holds an ImageLabel ("Image") instead and `color` is not applied.
	props: Position, AnchorPoint, ZIndex, LayoutOrder, Name.
]]
function Kit.icon(parent: Instance, name: string, size: number, color: Color3?, props: { [string]: any }?): Frame
	local p = props or {}
	local root = Kit.new("Frame", {
		Name = p.Name or ("Icon" .. name),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		ZIndex = p.ZIndex or 1,
		LayoutOrder = p.LayoutOrder or 0,
		Parent = parent,
	})
	root:SetAttribute("Icon", name)
	local resolved = Kit.iconName(name)
	local image = imageIcon(name, resolved)
	if image then
		local w, h = tonumber(image.w), tonumber(image.h)
		Kit.new("ImageLabel", {
			Name = "Image",
			BackgroundTransparency = 1,
			Image = image.image,
			ImageRectOffset = if w and h then Vector2.new(tonumber(image.x) or 0, tonumber(image.y) or 0) else Vector2.zero,
			ImageRectSize = if w and h then Vector2.new(w, h) else Vector2.zero,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(1, 1),
			ZIndex = root.ZIndex,
			Parent = root,
		})
		root:SetAttribute("IconImage", true)
		return root
	end
	local builder = ICONS[resolved or ""]
	if builder then
		builder(root, color or C.Text)
	end
	return root
end

-- True when the Shared.Assets atlas has an image icon called `name`.
function Kit.hasImageIcon(name: string): boolean
	return imageIcon(name, nil) ~= nil
end

-- `preferred` (an atlas-only icon such as "PassDoubleCash") when the atlas has
-- it, else `fallback` (a shape icon), so art that failed to load degrades.
function Kit.pickIcon(preferred: string, fallback: string): string
	return if imageIcon(preferred, nil) then preferred else fallback
end

-- Default accent per icon so menus stay quiet (only the icon carries colour).
Kit.ICON_COLORS = {
	Coin = C.Gold,
	Gem = C.Rizz,
	Shop = C.Gold,
	Index = C.Violet,
	Ranking = C.Gold,
	Home = Color3.fromRGB(220, 232, 255),
	Free = C.Cash,
	Invite = C.Rizz,
	Settings = Color3.fromRGB(220, 232, 255),
	Surge = C.Amber,
	Orb = C.Orb,
	Chad = C.Rizz,
	Plus = C.Text,
	Close = C.Text,
	Check = C.Text,
	Star = C.Gold,
	Lock = C.TextDim,
	Music = C.Violet,
	Sound = C.Rizz,
	Hash = C.Gold,
	Merge = C.Cash,
}

-- Motion helpers -------------------------------------------------------------------------

type ButtonState = {
	face: Frame,
	base: Frame,
	gradient: UIGradient,
	rim: UIStroke,
	shine: Frame,
	label: TextLabel,
	icon: GuiObject?,
	color: Color3,
	enabled: boolean,
	depth: number,
	hover: boolean,
}

local buttons: { [Instance]: ButtonState } = setmetatable({}, { __mode = "k" }) :: any

-- The UIScale a gui animates with (reuses an existing one: a gui honours only one).
local function scaleOf(gui: GuiObject): UIScale
	local existing = gui:FindFirstChildOfClass("UIScale")
	if existing then
		return existing
	end
	return Kit.new("UIScale", { Name = "Scale", Parent = gui })
end

type FadeEntry = { inst: Instance, prop: string, value: number }

-- Per-gui animation state. `token` invalidates the delayed step of an older
-- appear/disappear; `entries` holds the resting transparencies while a fade
-- runs; `pop` invalidates the second half of an older pop.
type Motion = { token: number, entries: { FadeEntry }?, pop: number }
local motions: { [Instance]: Motion } = setmetatable({}, { __mode = "k" }) :: any
local function motionOf(gui: Instance): Motion
	local existing = motions[gui]
	if existing then
		return existing
	end
	local m: Motion = { token = 0, entries = nil, pop = 0 }
	motions[gui] = m
	return m
end

local FADE_PROPS: { { string } } = {
	{ "GuiObject", "BackgroundTransparency" },
	{ "TextLabel", "TextTransparency" },
	{ "TextButton", "TextTransparency" },
	{ "TextBox", "TextTransparency" },
	{ "ImageLabel", "ImageTransparency" },
	{ "ImageButton", "ImageTransparency" },
	{ "ViewportFrame", "ImageTransparency" },
	{ "ScrollingFrame", "ScrollBarImageTransparency" },
	{ "UIStroke", "Transparency" },
}

-- Everything visible in `gui` (itself included) with its resting transparency.
local function collectFade(gui: GuiObject): { FadeEntry }
	local entries: { FadeEntry } = {}
	local function add(inst: Instance)
		for _, spec in FADE_PROPS do
			if inst:IsA(spec[1]) then
				local value = (inst :: any)[spec[2]]
				if value < 1 then
					table.insert(entries, { inst = inst, prop = spec[2], value = value })
				end
			end
		end
	end
	add(gui)
	for _, descendant in gui:GetDescendants() do
		add(descendant)
	end
	return entries
end

local function setFade(entries: { FadeEntry }, hidden: boolean)
	for _, entry in entries do
		(entry.inst :: any)[entry.prop] = if hidden then 1 else entry.value
	end
end

--[[
	Kit.appear(gui, opts?): shows `gui` and eases it in: scale from 0.92 with a
	soft Back overshoot while everything inside fades in. Cancel-safe: called
	during a Kit.disappear it turns around from where it is. opts:
	  from   start scale (0.92)          time   seconds (0.22)
	  delay  start delay (0)             fade   false = scale only
	  style  Enum.EasingStyle (Back)
]]
function Kit.appear(gui: GuiObject, opts: { [string]: any }?)
	local o = opts or {}
	local m = motionOf(gui)
	m.token += 1
	local mine = m.token
	local time: number = o.time or 0.22
	local delay: number = o.delay or 0
	local scale = scaleOf(gui)
	local resuming = m.entries ~= nil and gui.Visible
	if not resuming then
		scale.Scale = o.from or 0.92
	end
	gui.Visible = true
	tweenAfter(scale, time, delay, { Scale = 1 }, o.style or Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	if o.fade == false and not m.entries then
		return
	end
	local entries = m.entries or collectFade(gui)
	if not resuming then
		setFade(entries, true)
	end
	m.entries = entries
	local fadeTime = time * 0.8
	for _, entry in entries do
		tweenAfter(entry.inst, fadeTime, delay, { [entry.prop] = entry.value })
	end
	local function settle()
		if m.token == mine then
			m.entries = nil
		end
	end
	if PREVIEW then
		settle()
	else
		task.delay(delay + fadeTime + 0.05, settle)
	end
end

--[[
	Kit.disappear(gui, opts?): eases `gui` out (scale to 0.94 + fade, 0.14 s),
	then hides it and restores its resting look for the next Kit.appear.
	Cancel-safe: a later Kit.appear takes over mid-way. opts:
	  to       end scale (0.94)          time     seconds (0.14)
	  destroy  destroy instead of hide   onDone   called once it is gone
]]
function Kit.disappear(gui: GuiObject, opts: { [string]: any }?)
	local o = opts or {}
	local m = motionOf(gui)
	m.token += 1
	local mine = m.token
	local function finish()
		if m.token ~= mine then
			return
		end
		local entries = m.entries
		m.entries = nil
		if o.destroy then
			gui:Destroy()
		else
			gui.Visible = false
			if entries then
				setFade(entries, false)
			end
			scaleOf(gui).Scale = 1
		end
		if o.onDone then
			o.onDone()
		end
	end
	if not gui.Visible then
		finish()
		return
	end
	local time: number = o.time or 0.14
	Kit.tween(scaleOf(gui), time, { Scale = o.to or 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local entries = m.entries or collectFade(gui)
	m.entries = entries
	for _, entry in entries do
		Kit.tween(entry.inst, time, { [entry.prop] = 1 })
	end
	if PREVIEW then
		finish()
	else
		task.delay(time + 0.05, finish)
	end
end

--[[
	Kit.stagger(children, step?): eases rows in one after another, `step`
	seconds apart (0.025). Rows past the 12th share the last delay so long lists
	stay quick. `children` is an array of GuiObjects, or a container whose
	visible GuiObject children are used in LayoutOrder.
]]
function Kit.stagger(children: { GuiObject } | Instance, step: number?)
	local list: { GuiObject } = {}
	if typeof(children) == "Instance" then
		for _, child in (children :: Instance):GetChildren() do
			if child:IsA("GuiObject") and child.Visible and not child:GetAttribute("KitChrome") then
				table.insert(list, child)
			end
		end
		table.sort(list, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
	else
		list = children :: { GuiObject }
	end
	local gap = step or 0.025
	for i, gui in list do
		Kit.appear(gui, { from = 0.9, time = 0.24, delay = math.min(i - 1, 12) * gap })
	end
end

--[[
	Kit.pop(gui, strength?): a quick scale bump that springs back (a landing
	pop for counters, badges, rewards). strength 1 = +12 %. Skipped while the
	gui is appearing or disappearing.
]]
function Kit.pop(gui: GuiObject, strength: number?)
	local m = motionOf(gui)
	if PREVIEW or m.entries then
		return
	end
	m.pop += 1
	local mine = m.pop
	local scale = scaleOf(gui)
	Kit.tween(scale, 0.08, { Scale = 1 + 0.12 * (strength or 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	task.delay(0.08, function()
		if m.pop == mine and not m.entries then
			Kit.tween(scale, 0.24, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end)
end

type Roll = { value: number, active: boolean, driver: NumberValue, conn: RBXScriptConnection?, tween: Tween? }
local rolls: { [Instance]: Roll } = setmetatable({}, { __mode = "k" }) :: any

--[[
	Kit.countTo(label, from, to, format?, duration?): rolls the number shown in
	`label` from `from` to `to` (eased, 0.45 s), then gives a small landing
	pop. Cancel-safe: called again mid-roll it continues from the number on
	screen. `format(n)` turns the number into text (default: tostring); n is
	rounded to a whole number when `from` and `to` are whole.
]]
function Kit.countTo(label: TextLabel | TextButton, from: number, to: number, format: ((number) -> string)?, duration: number?)
	local fmt: (number) -> string = format or tostring
	local whole = from == math.floor(from) and to == math.floor(to)
	local function show(n: number)
		(label :: any).Text = fmt(if whole then math.floor(n + 0.5) else n)
	end
	local roll = rolls[label]
	if not roll then
		roll = { value = from, active = false, driver = Instance.new("NumberValue"), conn = nil, tween = nil }
		rolls[label] = roll
	end
	local r = roll :: Roll
	local old = r.tween
	r.tween = nil
	if old then
		old:Cancel()
	end
	if r.conn then
		r.conn:Disconnect()
		r.conn = nil
	end
	local start = if r.active then r.value else from
	if PREVIEW or start == to then
		r.active = false
		r.value = to
		show(to)
		return
	end
	r.active = true
	r.value = start
	r.driver.Value = start
	show(start)
	local conn = r.driver:GetPropertyChangedSignal("Value"):Connect(function()
		r.value = r.driver.Value
		show(r.value)
	end)
	r.conn = conn
	local tween = Kit.tween(r.driver, duration or 0.45, { Value = to }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	r.tween = tween
	tween.Completed:Connect(function(state)
		if r.tween ~= tween then
			return
		end
		conn:Disconnect()
		r.conn = nil
		r.tween = nil
		r.active = false
		r.value = to
		show(to)
		if state == Enum.PlaybackState.Completed then
			Kit.pop(label, 0.5)
		end
	end)
end

--[[
	Kit.breathe(gui, amount?): slow idle breathing scale (+4 %) for the single
	most important call to action on screen. One repeating tween, no per-frame
	work. On a Kit.button the face and lip breathe, so hover and press keep
	working. Returns a stop function that eases back to rest.
]]
function Kit.breathe(gui: GuiObject, amount: number?): () -> ()
	if PREVIEW then
		return function() end
	end
	local state = buttons[gui]
	local targets: { GuiObject } = if state then { state.face, state.base } else { gui }
	local info = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tweens: { Tween } = {}
	local scales: { UIScale } = {}
	for _, target in targets do
		local scale = scaleOf(target)
		scale.Scale = 1
		local tween = TweenService:Create(scale, info, { Scale = 1 + (amount or 0.04) })
		tween:Play()
		table.insert(tweens, tween)
		table.insert(scales, scale)
	end
	local stopped = false
	return function()
		if stopped then
			return
		end
		stopped = true
		for i, tween in tweens do
			tween:Cancel()
			Kit.tween(scales[i], 0.2, { Scale = 1 })
		end
	end
end

-- Hover lift and press squash (0.94) with a springy release.
function Kit.bouncy(button: GuiButton, hover: number?): UIScale
	local scale = scaleOf(button)
	local up = hover or 1.03
	Kit.selectable(button)
	-- A finger tap fires MouseEnter but not always MouseLeave, so touch never hovers.
	button.MouseEnter:Connect(function()
		if not Kit.touch then
			Kit.tween(scale, 0.12, { Scale = up })
		end
	end)
	button.MouseLeave:Connect(function()
		Kit.tween(scale, 0.12, { Scale = 1 })
	end)
	-- The gamepad selection lifts the button like a hover (pcall: the preview has no Selection* events).
	pcall(function()
		button.SelectionGained:Connect(function()
			Kit.tween(scale, 0.12, { Scale = up })
		end)
		button.SelectionLost:Connect(function()
			Kit.tween(scale, 0.12, { Scale = 1 })
		end)
	end)
	button.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.07, { Scale = 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end)
	button.MouseButton1Up:Connect(function()
		Kit.tween(scale, 0.28, { Scale = if Kit.touch then 1 else up }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if Kit.gamepad then
			-- A press from the controller squashes and springs like a click.
			Kit.tween(scale, 0.07, { Scale = 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.08, function()
				Kit.tween(scale, 0.28, { Scale = up }, Enum.EasingStyle.Back)
			end)
		end
	end)
	return scale
end

--[[
	Idle sheen: a soft light band that glides across `face` every `every`
	seconds (for the one call to action on screen). `face` must clip.
	Returns a stop function.
]]
function Kit.shimmer(face: GuiObject, every: number?, zindex: number?): () -> ()
	face.ClipsDescendants = true
	local bar = Kit.new("Frame", {
		Name = "Sheen",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 40, 1.6, 0),
		Position = UDim2.fromScale(-0.4, -0.3),
		Rotation = 18,
		ZIndex = zindex or 3,
		Parent = face,
	})
	chrome(bar)
	Kit.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.65),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = bar,
	})
	local alive = true
	local period = every or 4.5
	task.spawn(function()
		task.wait(math.random() * period)
		while alive and bar.Parent do
			bar.Position = UDim2.fromScale(-0.4, -0.3)
			Kit.tween(bar, 1.2, { Position = UDim2.fromScale(1.2, -0.3) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			task.wait(period)
		end
	end)
	return function()
		alive = false
		bar:Destroy()
	end
end

-- Buttons ---------------------------------------------------------------------------

-- Face of a moulded button: lighter at the top, the true colour below.
local function faceColors(color: Color3, hover: boolean): ColorSequence
	local lift = if hover then 0.08 else 0
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Kit.lighten(color, 0.24 + lift)),
		ColorSequenceKeypoint.new(0.5, Kit.lighten(color, 0.04 + lift)),
		ColorSequenceKeypoint.new(1, Kit.lighten(color, lift * 0.5)),
	})
end

local function paintButton(state: ButtonState)
	local color = if state.enabled then state.color else DISABLED
	local lipColor = Kit.lip(color)
	state.gradient.Color = faceColors(color, state.hover and state.enabled)
	state.base.BackgroundColor3 = lipColor
	state.rim.Color = lipColor
	state.shine.BackgroundTransparency = if state.enabled then 0.4 else 0.7
	state.label.TextTransparency = if state.enabled then 0 else 0.35
	if state.icon then
		if state.icon:IsA("TextLabel") then
			state.icon.TextTransparency = if state.enabled then 0 else 0.4
		end
	end
end

--[[
	A chunky moulded button: coloured face (lighter at the top, white highlight
	line) on a darker lip; squashes on press and springs back. props:
	  Text, Icon (Kit.ICONS name or emoji), IconColor, Layout ("Inline" | "Stack": icon above text),
	  Color, Size, Position, AnchorPoint, LayoutOrder, Name, ZIndex,
	  Font, TextSize, TextColor, RichText, Radius, Depth, Sound (default "Click"),
	  Shimmer (idle sheen for the call to action), Breathe (idle breathing scale
	  for the single most important call to action).
	Returns the TextButton (the hit area). Recolour/relabel with Kit.setButton,
	enable/disable with Kit.setEnabled.
]]
function Kit.button(parent: Instance, props: { [string]: any }, onClick: (() -> ())?): TextButton
	local color: Color3 = props.Color or C.Good
	local size: UDim2 = props.Size or UDim2.fromOffset(160, 48)
	local fixedHeight = if size.Y.Scale == 0 then size.Y.Offset else nil
	local depth = props.Depth or (if fixedHeight and fixedHeight < 44 then 4 else 5)
	local radius = props.Radius or Kit.RADIUS.M

	local button = Kit.new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = "",
		Size = size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})

	-- Soft navy contact shadow under the lip.
	local contact = Kit.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -4, 1, -depth),
		Position = UDim2.fromOffset(2, depth + 3),
		Parent = button,
	})
	Kit.corner(contact, radius)

	local base = Kit.new("Frame", {
		Name = "Base",
		BackgroundColor3 = Kit.lip(color),
		Size = UDim2.new(1, 0, 1, -depth),
		Position = UDim2.new(0.5, 0, 0, depth),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = button,
	})
	Kit.corner(base, radius)

	local face = Kit.new("Frame", {
		Name = "Face",
		BackgroundColor3 = WHITE,
		Size = UDim2.new(1, 0, 1, -depth),
		-- Centred so Breathe's UIScale grows both sides evenly, not off the right edge.
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = button,
	})
	Kit.corner(face, radius)
	local rim = Kit.new("UIStroke", {
		Thickness = 1.5,
		Color = Kit.lip(color),
		Transparency = 0.2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = face,
	})
	local gradient = Kit.gradient(face, color, color)
	local shine = highlight(face, radius, 0.4)
	shine.ZIndex = 2

	local faceHeight = if fixedHeight then fixedHeight - depth else nil
	local font = props.Font or F.UI
	local textColor = props.TextColor or Kit.inkOn(color)
	local label: TextLabel
	local icon: GuiObject? = nil
	local iconName = Kit.iconName(props.Icon)
	local iconColor = props.IconColor or (if iconName then Kit.ICON_COLORS[iconName] else nil) or textColor
	if props.Layout == "Stack" then
		local iconSize = if faceHeight then math.floor(faceHeight * 0.5) else 32
		if iconName then
			icon = Kit.icon(face, iconName, iconSize, iconColor, {
				Name = "Icon",
				Position = UDim2.new(0.5, 0, 0.08, 0),
				AnchorPoint = Vector2.new(0.5, 0),
				ZIndex = 2,
			})
		elseif props.Icon then
			icon = Kit.text(face, {
				Name = "Icon",
				Text = props.Icon,
				TextSize = iconSize,
				Size = UDim2.new(1, 0, 0.56, 0),
				Position = UDim2.fromScale(0, 0.04),
				StrokeThickness = 0,
				ZIndex = 2,
			})
		end
		label = Kit.text(face, {
			Name = "Label",
			Text = string.upper(props.Text or ""),
			Font = font,
			TextSize = props.TextSize or (if faceHeight then math.clamp(math.floor(faceHeight * 0.2), 12, 18) else nil),
			TextColor3 = textColor,
			TextWrapped = false,
			Size = UDim2.new(1, -4, 0.28, 0),
			Position = UDim2.new(0, 2, 0.68, 0),
			StrokeThickness = 0,
			ZIndex = 2,
		})
	else
		local textSize = props.TextSize or (if faceHeight then math.clamp(math.floor(faceHeight * 0.42), 12, 30) else nil)
		local inset = 10
		if iconName then
			local iconSize = if faceHeight then math.floor(faceHeight * 0.6) else 24
			icon = Kit.icon(face, iconName, iconSize, iconColor, {
				Name = "Icon",
				Position = UDim2.new(0, 10, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				ZIndex = 2,
			})
			inset = 10 + iconSize + 6
		end
		local text = props.Text or ""
		if props.Icon and not iconName then
			text = props.Icon .. "  " .. text
		end
		label = Kit.text(face, {
			Name = "Label",
			Text = text,
			Font = font,
			RichText = props.RichText or false,
			TextSize = textSize,
			MaxTextSize = if faceHeight or props.TextSize then nil else 28,
			TextColor3 = textColor,
			TextWrapped = false,
			Size = UDim2.new(1, -(inset + 10), 1, -4),
			Position = UDim2.fromOffset(inset, 2),
			TextXAlignment = if iconName then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center,
			StrokeThickness = 0,
			ZIndex = 2,
		})
		if iconName and props.Center ~= false then
			-- Centre the icon+text pair.
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.Size = UDim2.new(1, -inset, 1, -4)
		end
	end
	if props.Shimmer then
		Kit.shimmer(face, 4.5, 3)
	end

	local state: ButtonState = {
		face = face,
		base = base,
		gradient = gradient,
		rim = rim,
		shine = shine,
		label = label,
		icon = icon,
		color = color,
		enabled = true,
		depth = depth,
		hover = false,
	}
	buttons[button] = state
	paintButton(state)

	if props.Breathe then
		Kit.breathe(button)
	end

	local scale = scaleOf(button)
	local function rest()
		face.Position = UDim2.fromScale(0.5, 0)
		base.Visible = true
	end
	Kit.selectable(button)
	local function hoverOn()
		if state.enabled then
			state.hover = true
			Kit.tween(scale, 0.12, { Scale = 1.03 })
			paintButton(state)
		end
	end
	local function hoverOff()
		state.hover = false
		Kit.tween(scale, 0.12, { Scale = 1 })
		paintButton(state)
		rest()
	end
	local function press()
		if state.enabled then
			Kit.tween(scale, 0.07, { Scale = 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Kit.tween(face, 0.07, { Position = UDim2.new(0.5, 0, 0, depth - 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end
	local function release()
		Kit.tween(scale, 0.28, { Scale = if state.hover then 1.03 else 1 }, Enum.EasingStyle.Back)
		Kit.tween(face, 0.22, { Position = UDim2.fromScale(0.5, 0) }, Enum.EasingStyle.Back)
	end
	-- A finger tap fires MouseEnter but not always MouseLeave, so touch never hovers
	-- (a stuck hover would leave the button enlarged and lit after the tap).
	button.MouseEnter:Connect(function()
		if not Kit.touch then
			hoverOn()
		end
	end)
	button.MouseLeave:Connect(hoverOff)
	pcall(function()
		button.SelectionGained:Connect(hoverOn)
		button.SelectionLost:Connect(hoverOff)
	end)
	button.MouseButton1Down:Connect(press)
	button.MouseButton1Up:Connect(function()
		if Kit.touch then
			state.hover = false
			paintButton(state)
		end
		release()
	end)
	button.Activated:Connect(function()
		if Kit.gamepad then
			press()
			task.delay(0.08, release)
		end
		if not state.enabled then
			Kit.sound("Error")
			return
		end
		Kit.sound(props.Sound or "Click")
		if onClick then
			onClick()
		end
	end)
	button:SetAttribute("BaseColor", color)
	return button
end

function Kit.setButton(button: TextButton, text: string?, color: Color3?)
	local state = buttons[button]
	if not state then
		return
	end
	if text then
		state.label.Text = if state.icon
				and state.icon:IsA("Frame")
				and state.label.Position.Y.Scale > 0.5
			then string.upper(text)
			else text
	end
	if color then
		state.color = color
		if not state.label:GetAttribute("FixedTextColor") then
			state.label.TextColor3 = Kit.inkOn(color)
		end
	end
	paintButton(state)
end

function Kit.setEnabled(button: TextButton, enabled: boolean)
	local state = buttons[button]
	if not state or state.enabled == enabled then
		return
	end
	state.enabled = enabled
	button.Active = enabled
	paintButton(state)
end

function Kit.buttonFace(button: TextButton): Frame?
	local state = buttons[button]
	return if state then state.face else nil
end

function Kit.buttonLabel(button: TextButton): TextLabel?
	local state = buttons[button]
	return if state then state.label else nil
end

-- Invisible square hit area `size` px wide, centred on a small button (close
-- buttons), so a 36-40 px button still takes 44+ px taps. Calls `onClick`.
function Kit.hitArea(button: GuiButton, size: number, onClick: () -> ()): TextButton
	local hit = Kit.new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = button.ZIndex + 3,
		Selectable = false,
		Parent = button,
	})
	hit.Activated:Connect(onClick)
	return hit
end

-- Panels / pills ----------------------------------------------------------------------

--[[
	Moulded plastic panel: royal-blue body (lighter at the top), a white
	highlight line along the top inner edge, a darker blue lip under the bottom
	edge and a soft navy shadow. props: Color (body tint), Elevated (SurfaceHi),
	Size, Position, AnchorPoint, LayoutOrder, Visible, Name, ZIndex, Radius,
	StrokeThickness, StrokeColor, Shadow (false = no lip and no shadow),
	Transparency. The body colour lives in the frame's UIGradient (the frame
	itself is white) and the outline is its UIStroke; both may be recoloured.
	Chrome children (Highlight, Lip, Shadow) carry the KitChrome attribute.
]]
function Kit.panel(parent: Instance, props: { [string]: any }): Frame
	local color: Color3 = props.Color or (if props.Elevated then C.SurfaceHi else C.Surface)
	local frame = Kit.new("Frame", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = props.Transparency or 0,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(200, 100),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Visible = if props.Visible == nil then true else props.Visible,
		Name = props.Name or "Panel",
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	local radius = props.Radius or Kit.RADIUS.L
	local lipColor = Kit.lip(color)
	Kit.corner(frame, radius)
	Kit.stroke(frame, props.StrokeThickness or 1.5, props.StrokeColor or lipColor)
	Kit.gradient(frame, Kit.lighten(color, 0.1), color:Lerp(lipColor, 0.12))
	highlight(frame, radius, 0.55)
	if props.Shadow ~= false then
		local depth = if radius >= 14 then 4 else 3
		lip(frame, radius, depth, lipColor)
		Kit.shadow(frame, radius, 1, depth)
	end
	return frame
end

-- Deeper-blue inset well inside a panel: slightly shaded along its top edge
-- (a multiplying gradient, so BackgroundColor3 can be recoloured) and a thin
-- darker outline. Adds no child frames, so it is safe as a layout container.
function Kit.well(parent: Instance, props: { [string]: any }): Frame
	local frame = Kit.new("Frame", {
		Name = props.Name or "Well",
		BackgroundColor3 = props.Color or C.Well,
		BackgroundTransparency = props.Transparency or 0,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Parent = parent,
	})
	local radius = props.Radius or Kit.RADIUS.M
	Kit.corner(frame, radius)
	Kit.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(0.84, 0.86, 0.92)),
			ColorSequenceKeypoint.new(0.18, WHITE),
			ColorSequenceKeypoint.new(1, WHITE),
		}),
		Parent = frame,
	})
	Kit.new("UIStroke", {
		Thickness = 1,
		Color = C.Edge,
		Transparency = 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = frame,
	})
	return frame
end

--[[
	Small rounded chip. Tinted by default (soft fill of the colour, light text);
	Solid = true for badges and tags (full colour, darker lip outline, ink or
	white text by contrast). Rotation is ignored (chips sit flat).
]]
function Kit.pill(parent: Instance, props: { [string]: any }): TextLabel
	local color: Color3 = props.Color or C.SurfaceHi
	local solid = props.Solid == true
	local label = Kit.text(parent, {
		Name = props.Name or "Pill",
		Text = props.Text or "",
		Font = props.Font or F.UI,
		TextSize = props.TextSize or Kit.TEXT.Tiny,
		TextColor3 = props.TextColor or (if solid then Kit.inkOn(color) else Kit.lighten(color, 0.55)),
		TextWrapped = false,
		BackgroundTransparency = if solid then 0 else 0.7,
		BackgroundColor3 = color,
		Size = props.Size or UDim2.fromOffset(80, 22),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		Visible = if props.Visible == nil then true else props.Visible,
		RichText = props.RichText or false,
		StrokeThickness = 0,
	})
	if props.AutomaticSize then
		Kit.padding(label, 0, 10)
	end
	Kit.round(label)
	if solid then
		-- Multiplying gradient: a touch lighter at the top, like moulded plastic.
		Kit.gradient(label, WHITE, Color3.new(0.88, 0.88, 0.92))
	end
	Kit.new("UIStroke", {
		Name = "Edge",
		Thickness = if solid then 1.5 else 1,
		Color = if solid then Kit.lip(color) else color,
		Transparency = if solid then 0 else 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = label,
	})
	return label
end

-- Coral notification dot centred on the top-right corner of `target` (nil text
-- hides it), so it overhangs the rim instead of covering the icon. Pops in when
-- shown and pops again when its text changes.
function Kit.setBadge(target: GuiObject, text: string?)
	local holder: GuiObject = buttons[target] and buttons[target].face or target
	local badge = holder:FindFirstChild("Badge") :: TextLabel?
	if not text then
		if badge then
			badge.Visible = false
		end
		return
	end
	if not badge then
		local created = Kit.pill(holder, {
			Name = "Badge",
			Text = text,
			Color = C.Danger,
			Solid = true,
			TextColor = C.Text,
			TextSize = Kit.TEXT.Small,
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.new(1, -3, 0, 3),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 5,
			Visible = false,
		})
		local edge = created:FindFirstChild("Edge") :: UIStroke
		edge.Color = WHITE
		edge.Thickness = 2
		Kit.new("UIScale", { Name = "Pop", Scale = 1, Parent = created })
		badge = created
	end
	local b = badge :: TextLabel
	local changed = b.Text ~= text
	b.Text = text
	b.Size = UDim2.fromOffset(math.max(20, 8 + utf8.len(text) :: number * 8), 20)
	if not b.Visible then
		b.Visible = true
		local pop = b:FindFirstChild("Pop") :: UIScale
		pop.Scale = 0.4
		Kit.tween(pop, 0.26, { Scale = 1 }, Enum.EasingStyle.Back)
	elseif changed then
		Kit.pop(b, 0.8)
	end
end

-- Softly pulsing ring around `target` to draw the eye (tutorial / ready). One
-- repeating tween per ring.
local glowTweens: { [Instance]: Tween } = setmetatable({}, { __mode = "k" }) :: any
function Kit.setGlow(target: GuiObject, on: boolean, color: Color3?)
	local holder: GuiObject = buttons[target] and buttons[target].face or target
	local ring = holder:FindFirstChild("Glow") :: Frame?
	if not on then
		local tween = glowTweens[holder]
		glowTweens[holder] = nil
		if tween then
			tween:Cancel()
		end
		if ring then
			ring.Visible = false
		end
		return
	end
	if not ring then
		local created = Kit.new("Frame", {
			Name = "Glow",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 10, 1, 10),
			Position = UDim2.fromOffset(-5, -5),
			ZIndex = 4,
			Parent = holder,
		})
		chrome(created)
		local corner = holder:FindFirstChildOfClass("UICorner")
		Kit.corner(created, (if corner then corner.CornerRadius.Offset else Kit.RADIUS.M) + 5)
		Kit.new("UIStroke", { Name = "Ring", Thickness = 3, Color = color or C.Gold, Parent = created })
		ring = created
	end
	local r = ring :: Frame
	r.Visible = true
	local stroke = r:FindFirstChild("Ring") :: UIStroke
	stroke.Color = color or C.Gold
	if glowTweens[holder] or PREVIEW then
		return
	end
	stroke.Transparency = 0
	local info = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tween = TweenService:Create(stroke, info, { Transparency = 0.7 })
	tween:Play()
	glowTweens[holder] = tween
end

-- Horizontal progress bar in a deep-blue track: the fill is a moulded strip
-- (lighter on top, white highlight) that eases to each new value. Returns the
-- frame, a setter (0..1, instant?) and the label.
function Kit.progress(parent: Instance, props: { [string]: any }): (Frame, (number) -> (), TextLabel)
	local color: Color3 = props.Color or C.Good
	local track = Kit.new("Frame", {
		Name = props.Name or "Progress",
		BackgroundColor3 = props.TrackColor or C.Well,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 20),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ClipsDescendants = false,
		Parent = parent,
	})
	Kit.round(track)
	Kit.new("UIStroke", { Thickness = 1.5, Color = C.Edge, Transparency = 0.15, Parent = track })
	local fill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	Kit.round(fill)
	Kit.gradient(fill, Kit.lighten(color, 0.25), color, 90)
	local gloss = Kit.new("Frame", {
		Name = "Gloss",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -10, 0, 2),
		Position = UDim2.fromOffset(5, 2),
		Parent = fill,
	})
	Kit.round(gloss)
	local label = Kit.text(track, {
		Name = "Label",
		Text = props.Text or "",
		Font = props.Font or F.UI,
		TextSize = props.TextSize or Kit.TEXT.Small,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		StrokeThickness = 2,
	})
	local minVisible = props.MinFill or 0.06
	local function set(ratio: number, instant: boolean?)
		local r = math.clamp(ratio, 0, 1)
		fill.Visible = r > 0
		local target = UDim2.fromScale(math.max(r, minVisible), 1)
		if instant then
			fill.Size = target
		else
			Kit.tween(fill, 0.4, { Size = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end
	return track, set, label
end

-- On/off switch: deep-blue track that turns mint when on, white knob that
-- springs across. props.Large: a 70x32 track with a 14 px ON/OFF label (else
-- 56x30 with a 10 px label). Returns the hit button and a setter (value, locked?).
function Kit.switch(parent: Instance, props: { [string]: any }, onToggle: () -> ()): (TextButton, (boolean, boolean?) -> ())
	local large = props.Large == true
	local w, h = if large then 70 else 56, if large then 32 else 30
	local button = Kit.new("TextButton", {
		Name = props.Name or "Switch",
		AutoButtonColor = false,
		BackgroundColor3 = C.Well,
		Text = "",
		Size = UDim2.fromOffset(w, h),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = parent,
	})
	Kit.round(button)
	local edge = Kit.new("UIStroke", { Thickness = 1.5, Color = C.Edge, Parent = button })
	local stateLabel = Kit.text(button, {
		Name = "State",
		Text = "",
		Font = F.UI,
		TextSize = if large then Kit.TEXT.Small else 10,
		TextColor3 = C.Text,
		Size = UDim2.new(1, -h, 1, 0),
		Position = UDim2.fromOffset(0, 0),
		StrokeThickness = 0,
	})
	local lockIcon = Kit.icon(button, "Lock", 14, C.TextDim, {
		Name = "LockIcon",
		Position = UDim2.new(0, h, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	lockIcon.Visible = false
	local knob = Kit.new("Frame", {
		Name = "Knob",
		BackgroundColor3 = WHITE,
		Size = UDim2.fromOffset(h - 8, h - 8),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 4, 0.5, 0),
		Parent = button,
	})
	Kit.round(knob)
	Kit.gradient(knob, WHITE, Color3.fromRGB(218, 226, 246))
	Kit.shadow(knob, math.floor((h - 8) / 2), 0.3)
	Kit.bouncy(button, 1.03)
	local locked = false
	button.Activated:Connect(function()
		Kit.sound(if locked then "Error" else "Toggle")
		onToggle()
	end)
	local function set(value: boolean, isLocked: boolean?)
		locked = isLocked == true
		lockIcon.Visible = locked
		if locked then
			Kit.tween(button, 0.18, { BackgroundColor3 = C.Well })
			edge.Color = C.Edge
			stateLabel.Text = ""
			Kit.tween(knob, 0.22, { Position = UDim2.new(0, 4, 0.5, 0) }, Enum.EasingStyle.Back)
			return
		end
		Kit.tween(button, 0.18, { BackgroundColor3 = if value then C.Cash else C.Well })
		edge.Color = if value then C.CashDeep else C.Edge
		stateLabel.Text = if value then "ON" else "OFF"
		stateLabel.TextColor3 = if value then C.GoldInk else C.TextDim
		stateLabel.Position = if value then UDim2.fromOffset(4, 0) else UDim2.fromOffset(h - 4, 0)
		Kit.tween(
			knob,
			0.22,
			{ Position = if value then UDim2.new(1, -(h - 4), 0.5, 0) else UDim2.new(0, 4, 0.5, 0) },
			Enum.EasingStyle.Back
		)
	end
	set(false)
	return button, set
end

--[[
	Segmented tab bar in a well. The selected tab is a moulded pill in the
	accent colour that glides between slots. props:
	  Items = { { key = "Passes", text = "Passes", icon = "Star"? }, ... }
	  Color (indicator), Size, Position, AnchorPoint, LayoutOrder, TextSize
	Returns the bar and a `select(key)` function; `onSelect(key)` fires on change.
]]
function Kit.tabs(parent: Instance, props: { [string]: any }, onSelect: (string) -> ()): (Frame, (string) -> ())
	local items: { { key: string, text: string, icon: string? } } = props.Items
	local color: Color3 = props.Color or C.Gold
	local bar = Kit.well(parent, {
		Name = props.Name or "Tabs",
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Radius = 20,
	})
	local n = #items
	local function slot(i: number): (UDim2, UDim2)
		return UDim2.new((i - 1) / n, 4, 0, 4), UDim2.new(1 / n, -8, 1, -8)
	end
	local indicatorPos, indicatorSize = slot(1)
	local indicator = Kit.new("Frame", {
		Name = "Indicator",
		BackgroundColor3 = WHITE,
		Position = indicatorPos,
		Size = indicatorSize,
		ZIndex = 2,
		Parent = bar,
	})
	Kit.round(indicator)
	Kit.gradient(indicator, Kit.lighten(color, 0.24), color)
	Kit.new("UIStroke", { Thickness = 1.5, Color = Kit.lip(color), Parent = indicator })
	highlight(indicator, 12, 0.4).ZIndex = 2
	local labels: { [string]: TextLabel } = {}
	local selected: string? = nil
	local function selectTab(key: string)
		local index = 1
		for i, item in items do
			if item.key == key then
				index = i
			end
		end
		local pos, size = slot(index)
		Kit.tween(indicator, 0.24, { Position = pos, Size = size }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		for k, label in labels do
			Kit.tween(label, 0.18, { TextColor3 = if k == key then Kit.inkOn(color) else C.TextDim })
		end
		if selected ~= key then
			selected = key
			onSelect(key)
		end
	end
	for i, item in items do
		local pos, size = slot(i)
		local hit = Kit.new("TextButton", {
			Name = item.key,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Text = "",
			Position = pos,
			Size = size,
			ZIndex = 3,
			Parent = bar,
		})
		local label = Kit.text(hit, {
			Name = "Label",
			Text = string.upper(item.text),
			Font = F.UI,
			TextSize = props.TextSize or Kit.TEXT.Small,
			TextColor3 = C.TextDim,
			TextWrapped = false,
			ZIndex = 3,
			StrokeThickness = 0,
		})
		labels[item.key] = label
		Kit.bouncy(hit, 1)
		hit.Activated:Connect(function()
			if selected ~= item.key then
				Kit.sound("Click")
				selectTab(item.key)
			end
		end)
	end
	if items[1] then
		selectTab(items[1].key)
	end
	return bar, selectTab
end

-- Builds a ViewportFrame showing a unit tier (`silhouette`: an undiscovered tier,
-- drawn as one soft mid-blue shape).
local SILHOUETTE = Color3.fromRGB(122, 146, 220)
function Kit.unitViewport(parent: Instance, tier: number, props: { [string]: any }, silhouette: boolean?): ViewportFrame
	local look = Theme.Tiers[tier].Look
	local viewport = Kit.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Ambient = Color3.fromRGB(200, 200, 210),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.5, -1, 0.6),
		Parent = parent,
	})
	-- Tagged so tooling (preview renderer) can identify what the viewport shows.
	viewport:SetAttribute("Tier", tier)
	viewport:SetAttribute("Silhouette", silhouette == true)
	local model = CharacterFactory.build(look, Theme.Tiers[tier].Name)
	if silhouette then
		-- A soft mid-blue shape (lighter than the tile's ink, never black), lit flat.
		CharacterFactory.silhouette(model)
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part.Transparency < 1 then
				part.Color = SILHOUETTE
			end
		end
		viewport.Ambient = Color3.new(1, 1, 1)
		viewport.LightColor = Color3.fromRGB(70, 70, 80)
		viewport.ImageTransparency = 0.15
	end
	model.Parent = viewport
	Animator.attach(model)
	local height = CharacterFactory.height(look)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	local focus = Vector3.new(0, height * 0.5, 0)
	camera.CFrame = CFrame.lookAt(Vector3.new(height * 0.35, height * 0.62, -height * 1.75), focus)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

-- Windows ------------------------------------------------------------------------------

-- Scene blur while any window or modal is open (reference counted).
local blurCount = 0
local blur: BlurEffect? = nil
function Kit.setBlur(on: boolean)
	blurCount = math.max(0, blurCount + (if on then 1 else -1))
	if blurCount > 0 then
		if not blur then
			local effect = Instance.new("BlurEffect")
			effect.Name = "UiBlur"
			effect.Size = 0
			effect.Parent = Lighting
			blur = effect
		end
		Kit.tween(blur :: BlurEffect, 0.22, { Size = 8 })
	elseif blur then
		Kit.tween(blur :: BlurEffect, 0.18, { Size = 0 })
	end
end

-- Share of the visible design area a window or modal may cover.
local FIT_MARGIN = 0.92

--[[
	Visible design area of a ScreenGui: its AbsoluteSize (already inside the
	top bar and safe-area insets) divided by the screen's own UIScale. nil when
	the engine cannot tell (the Lune preview has no layout).
]]
function Kit.designArea(screen: Instance): Vector2?
	local ok, absolute = pcall(function()
		return (screen :: any).AbsoluteSize
	end)
	if not ok or typeof(absolute) ~= "Vector2" or absolute.X < 1 or absolute.Y < 1 then
		return nil
	end
	local uiScale = screen:FindFirstChildOfClass("UIScale")
	local scale = if uiScale and uiScale.Scale > 0 then uiScale.Scale else 1
	return absolute / scale
end

--[[
	Kit.fit(holder, screen, design, minSize?, onResize?): keeps a centred
	holder inside 92% of the screen's visible design area. The holder first
	narrows / shortens toward `minSize` (so its content can reflow), then
	shrinks as a whole with its own UIScale ("Fit"). Re-fits whenever the
	viewport or the screen's UIScale changes. `onResize(size)` runs with the
	holder's design size after every change (and once at the start). The holder
	must not be animated with Kit.appear (a gui honours one UIScale): animate a
	child instead.
]]
function Kit.fit(holder: GuiObject, screen: Instance, design: Vector2, minSize: Vector2?, onResize: ((Vector2) -> ())?)
	local fitScale = Kit.new("UIScale", { Name = "Fit", Parent = holder })
	local low = minSize or design
	local minW, minH = math.min(low.X, design.X), math.min(low.Y, design.Y)
	local current: Vector2? = nil
	local function apply()
		local w, h, s = design.X, design.Y, 1
		local area = Kit.designArea(screen)
		if area then
			local maxW, maxH = area.X * FIT_MARGIN, area.Y * FIT_MARGIN
			w = math.floor(math.clamp(maxW, minW, design.X))
			h = math.floor(math.clamp(maxH, minH, design.Y))
			s = math.min(1, maxW / w, maxH / h)
		end
		fitScale.Scale = s
		local size = Vector2.new(w, h)
		if size ~= current then
			current = size
			holder.Size = UDim2.fromOffset(w, h)
			if onResize then
				onResize(size)
			end
		end
	end
	apply()
	pcall(function()
		local connections: { RBXScriptConnection } = {}
		table.insert(connections, (screen :: any):GetPropertyChangedSignal("AbsoluteSize"):Connect(apply))
		local uiScale = screen:FindFirstChildOfClass("UIScale")
		if uiScale then
			table.insert(connections, uiScale:GetPropertyChangedSignal("Scale"):Connect(apply))
		end
		table.insert(
			connections,
			holder.AncestryChanged:Connect(function()
				if not holder:IsDescendantOf(game) then
					for _, connection in connections do
						connection:Disconnect()
					end
				end
			end)
		)
	end)
end

--[[
	WindowOpen contract: the ScreenGui attribute WindowOpen is true while any
	window or blocking modal is up, so the HUD can fade back under the dim.
	`key` names the opener; the flag clears once every opener has closed.
]]
local openers: { [Instance]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) :: any
function Kit.markOpen(screen: Instance, key: string, on: boolean)
	local set = openers[screen] or {}
	openers[screen] = set
	set[key] = if on then true else nil
	local any = next(set) ~= nil
	if screen:GetAttribute("WindowOpen") ~= any then
		screen:SetAttribute("WindowOpen", any)
	end
	Kit.hidePlayerList("window", any)
end

--[[
	Roblox's default player list (top-right leaderstats) covers the window
	header chips and the held-crate panel, so it is hidden while any of them is
	up. `reason` names the caller ("window", "crate", "intro"); the list stays
	hidden while any reason is on and goes back to the state it had before the
	first reason once every reason is off. Each call re-applies the wanted
	state, so a caller that restores the list on its own (the intro) is
	overridden while other reasons remain. CoreGui calls can fail early in a
	session: a failed set is retried for a few seconds.
]]
local listReasons: { [string]: boolean } = {}
local listBase: boolean? = nil
local listToken = 0
function Kit.hidePlayerList(reason: string, on: boolean)
	if on then
		listReasons[reason] = true
	else
		listReasons[reason] = nil
	end
	if PREVIEW then
		return
	end
	local hide = next(listReasons) ~= nil
	if hide and listBase == nil then
		-- The intro hides the list itself and puts back what it found, so while
		-- it plays the list's own state is not the player's.
		local player = game:GetService("Players").LocalPlayer
		local ok, enabled = pcall(function()
			return game:GetService("StarterGui"):GetCoreGuiEnabled(Enum.CoreGuiType.PlayerList)
		end)
		listBase = if player and player:GetAttribute("IntroPlaying") == true then true elseif ok then enabled else true
	elseif not hide and listBase == nil then
		return
	end
	local want = if hide then false else listBase == true
	if not hide then
		listBase = nil
	end
	listToken += 1
	local token = listToken
	task.spawn(function()
		for _ = 1, 12 do
			if token ~= listToken then
				return
			end
			local ok = pcall(function()
				game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, want)
			end)
			if ok then
				return
			end
			task.wait(0.5)
		end
	end)
end

export type Window = {
	frame: Frame,
	content: Frame,
	header: Frame,
	setOpen: (boolean) -> (),
	isOpen: () -> boolean,
	onOpen: BindableEvent,
	onClose: BindableEvent,
	-- Current design size of the window (after narrowing to fit the screen).
	size: () -> Vector2,
	-- Fires with the new design size when the window narrows or widens.
	onResize: BindableEvent,
	-- Gamepad: re-selects the first button in content (call after re-rendering it).
	focus: () -> (),
}

--[[
	Standard window: a moulded blue panel under one shared royal-blue header
	band (white highlight, white title); only the round icon chip and the thin
	strip under the band carry the window's accent `color`. Coral close button,
	deep-blue content well. Opens with Kit.appear (scale + fade, 0.22 s Back)
	and closes with Kit.disappear (0.14 s). Blurs the scene while open and sets
	the WindowOpen attribute; the caller owns the dimming backdrop
	(Kit.backdrop + Kit.fadeBackdrop).

	The panel ("Panel") sits in a centred holder named `name` that Kit.fit
	keeps inside the visible area: it narrows toward `minSize` first (content
	built with scale sizes reflows; listen to onResize for column counts), then
	scales down as a whole.
]]
function Kit.window(screen: ScreenGui, name: string, title: string, icon: string, color: Color3, size: Vector2, minSize: Vector2?): Window
	local holder = Kit.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.new(0.5, 0, 0.5, 4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	})
	local frame = Kit.panel(holder, {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		StrokeThickness = 2,
		Radius = Kit.RADIUS.XL,
	})
	frame.ZIndex = 10
	scaleOf(frame)

	-- Shared header: royal blue, lighter at the top.
	local bandTop, bandBottom = C.SurfaceHiTop, C.SurfaceHi
	local header = Kit.new("Frame", {
		Name = "Header",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 56),
		ZIndex = 2,
		Parent = frame,
	})
	Kit.corner(header, Kit.RADIUS.XL)
	Kit.new("UIGradient", { Color = ColorSequence.new(Kit.lighten(bandTop, 0.08), bandBottom), Rotation = 90, Parent = header })
	-- Square off the bottom corners of the band.
	local cover = Kit.new("Frame", {
		Name = "Cover",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 1, -24),
		ZIndex = 2,
		Parent = header,
	})
	Kit.new("UIGradient", {
		Color = ColorSequence.new(Kit.lighten(bandTop, 0.08):Lerp(bandBottom, 32 / 56), bandBottom),
		Rotation = 90,
		Parent = cover,
	})
	-- White highlight along the top inner edge of the band.
	highlight(header, Kit.RADIUS.XL, 0.3).ZIndex = 3
	-- Thin accent strip under the band (the window's small accent).
	Kit.new("Frame", {
		Name = "Shade",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, 0),
		ZIndex = 2,
		Parent = header,
	})

	-- Round icon chip in the accent colour with a white rim.
	local chip = Kit.new("Frame", {
		Name = "Chip",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(42, 42),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
		Parent = header,
	})
	Kit.round(chip)
	Kit.gradient(chip, Kit.lighten(color, 0.3), color)
	Kit.new("UIStroke", { Thickness = 2.5, Color = WHITE, Transparency = 0.05, Parent = chip })
	local iconName = Kit.iconName(icon)
	if iconName then
		Kit.icon(chip, iconName, 30, Kit.inkOn(color), {
			Name = "Icon",
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 4,
		})
	else
		Kit.text(chip, { Name = "Icon", Text = icon, TextSize = 24, Size = UDim2.fromScale(1, 1), StrokeThickness = 0, ZIndex = 4 })
	end

	Kit.title(header, {
		Name = "Title",
		Text = string.upper(title),
		TextSize = Kit.TEXT.H1,
		TextColor3 = C.Text,
		TextWrapped = false,
		Size = UDim2.new(1, -130, 1, 0),
		Position = UDim2.fromOffset(64, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 0,
		ZIndex = 3,
	})

	local content = Kit.well(frame, {
		Name = "Content",
		Size = UDim2.new(1, -24, 1, -84),
		Position = UDim2.fromOffset(12, 72),
		Radius = Kit.RADIUS.M,
	})
	Kit.padding(content, 10)

	-- The D-pad never leaves an open window.
	Kit.confine(holder)

	local open = false
	local onOpen = Instance.new("BindableEvent")
	local onClose = Instance.new("BindableEvent")
	local onResize = Instance.new("BindableEvent")
	local current = size
	Kit.fit(holder, screen, size, minSize, function(fitted: Vector2)
		current = fitted
		onResize:Fire(fitted)
	end)
	local function setOpen(value: boolean)
		if value == open then
			return
		end
		open = value
		Kit.markOpen(screen, "Window:" .. name, value)
		if value then
			holder.Visible = true
			Kit.appear(frame)
			Kit.setBlur(true)
			Kit.sound("Open")
			onOpen:Fire()
			-- Gamepad: the selection lands on the first button once the content is built.
			task.defer(function()
				if open then
					Kit.focus(content)
				end
			end)
		else
			Kit.unfocus(holder)
			Kit.disappear(frame, {
				onDone = function()
					holder.Visible = false
				end,
			})
			Kit.setBlur(false)
			onClose:Fire()
		end
	end
	local close = Kit.button(header, {
		Name = "Close",
		Icon = "Close",
		IconColor = C.Text,
		Color = C.Danger,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -10, 0.5, -1),
		AnchorPoint = Vector2.new(1, 0.5),
		Radius = 20,
		Depth = 4,
		Sound = "Close",
		ZIndex = 3,
	}, function()
		setOpen(false)
	end)
	local closeIcon = (Kit.buttonFace(close) :: Frame):FindFirstChild("Icon") :: Frame
	closeIcon.Position = UDim2.fromScale(0.5, 0.5)
	closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
	closeIcon.Size = UDim2.fromOffset(16, 16)
	Kit.hitArea(close, 52, function()
		Kit.sound("Close")
		setOpen(false)
	end)

	return {
		frame = frame,
		content = content,
		header = header,
		setOpen = setOpen,
		isOpen = function()
			return open
		end,
		onOpen = onOpen,
		onClose = onClose,
		size = function()
			return current
		end,
		onResize = onResize,
		focus = function()
			if open then
				Kit.focus(content)
			end
		end,
	}
end

function Kit.scrolling(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local p = props or {}
	return Kit.new("ScrollingFrame", {
		Name = p.Name or "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = p.Size or UDim2.fromScale(1, 1),
		Position = p.Position or UDim2.new(),
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = C.SurfaceHiTop,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
end

-- Confetti burst from a point inside `parent` (scale position). Pieces shoot
-- outward and upward, then fall and fade. Cleans itself up. With the Blender
-- sprites, pieces are curled confetti tinted with `Colors` plus a few yellow
-- star pops; without them, rounded colour chips. At most CONFETTI_MAX pieces.
local CONFETTI_MAX = 28
local CONFETTI_IMAGE = Sprites.image("Confetti")
local STAR_IMAGE = Sprites.image("StarPop")
function Kit.confetti(parent: Instance, options: { [string]: any }?)
	local opts = options or {}
	local W = Theme.World
	local colors = opts.Colors or { W.Sunny, W.Pink, W.Mint, W.Blue, W.Grape, W.Orange, W.Coral }
	local origin: UDim2 = opts.Origin or UDim2.fromScale(0.5, 0.4)
	local count = math.min(opts.Count or 24, CONFETTI_MAX)
	local zindex = opts.ZIndex or 45
	local power = opts.Power or 1
	for i = 1, count do
		local angle = math.rad(math.random(200, 340))
		local speed = math.random(160, 380) * power
		local piece: GuiObject
		local fadeProp = "BackgroundTransparency"
		if CONFETTI_IMAGE then
			local star = STAR_IMAGE ~= nil and i % 7 == 0
			local side = if star then math.random(22, 28) else math.random(16, 24)
			piece = Kit.new("ImageLabel", {
				Name = "Confetti",
				BackgroundTransparency = 1,
				Image = if star then STAR_IMAGE else CONFETTI_IMAGE,
				ImageColor3 = if star then Color3.new(1, 1, 1) else colors[(i % #colors) + 1],
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromOffset(side, side),
				Position = origin,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Rotation = math.random(0, 360),
				ZIndex = zindex,
				Parent = parent,
			})
			fadeProp = "ImageTransparency"
		else
			piece = Kit.new("Frame", {
				Name = "Confetti",
				BackgroundColor3 = colors[(i % #colors) + 1],
				Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22)),
				Position = origin,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Rotation = math.random(0, 360),
				ZIndex = zindex,
				Parent = parent,
			})
			Kit.corner(piece, 3)
		end
		local apex = origin + UDim2.fromOffset(math.cos(angle) * speed, math.sin(angle) * speed)
		local burst = 0.3 + math.random() * 0.15
		Kit.tween(piece, burst, { Position = apex, Rotation = piece.Rotation + math.random(-180, 180) }, Enum.EasingStyle.Quad)
		task.delay(burst, function()
			if not piece.Parent then
				return
			end
			local fall = 1 + math.random() * 0.5
			Kit.tween(piece, fall, {
				Position = apex + UDim2.fromOffset(math.random(-50, 50), math.random(220, 380)),
				Rotation = piece.Rotation + math.random(-360, 360),
				[fadeProp] = 1,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(fall + 0.05, function()
				piece:Destroy()
			end)
		end)
	end
end

-- Full-screen soft navy dimmer; returns the (clickable) frame. Starts hidden;
-- show and hide it with Kit.fadeBackdrop.
function Kit.backdrop(parent: Instance, zindex: number, onClick: (() -> ())?): TextButton
	local dim = Kit.new("TextButton", {
		Name = "Backdrop",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 1,
		Size = UDim2.new(2, 0, 2, 0),
		Position = UDim2.fromScale(-0.5, -0.5),
		ZIndex = zindex,
		Visible = false,
		Selectable = false,
		Parent = parent,
	})
	if onClick then
		dim.Activated:Connect(onClick)
	end
	return dim
end

-- Eases a backdrop in (to `opacity`, default 0.55) or out, then hides it.
local fadeTokens: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
function Kit.fadeBackdrop(dim: GuiObject, show: boolean, opacity: number?)
	local token = (fadeTokens[dim] or 0) + 1
	fadeTokens[dim] = token
	if show then
		if not dim.Visible then
			dim.BackgroundTransparency = 1
		end
		dim.Visible = true
		Kit.tween(dim, 0.22, { BackgroundTransparency = 1 - (opacity or 0.55) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	else
		Kit.tween(dim, 0.16, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.17, function()
			if fadeTokens[dim] == token then
				dim.Visible = false
			end
		end)
	end
end

-- HUD text drawn straight over the world: bold display font, white, with a solid
-- Ink outline (2.5 px by default, prop StrokeThickness overrides) so it reads on
-- sky, sand or a busy plot alike.
function Kit.hudText(parent: Instance, props: { [string]: any }): TextLabel
	local thickness = props.StrokeThickness or 2.5
	props.Font = props.Font or F.Display
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.TextWrapped = if props.TextWrapped == nil then false else props.TextWrapped
	props.StrokeThickness = 0
	local label = Kit.text(parent, props)
	local stroke = Kit.textStroke(label, thickness, 0)
	stroke.Name = "Outline"
	return label
end

-- A HUD icon with a soft drop shadow under it (a darkened copy 3 px lower), for
-- icons that sit straight over the world with no panel behind them.
function Kit.hudIcon(parent: Instance, name: string, size: number, color: Color3?, props: { [string]: any }?): Frame
	local p = props or {}
	local icon = Kit.icon(parent, name, size, color, p)
	local shade = Kit.icon(icon, name, size, C.Ink, { Name = "Shade", Position = UDim2.fromOffset(0, 3) })
	-- Follows the icon when callers resize it (e.g. Size = fromScale(1, 1) on a button).
	shade.Size = UDim2.fromScale(1, 1)
	shade.ZIndex = math.max(icon.ZIndex - 1, 0)
	for _, part in shade:GetDescendants() do
		if part:IsA("ImageLabel") then
			part.ImageColor3 = C.Ink
			part.ImageTransparency = 0.6
			part.ZIndex = shade.ZIndex
		elseif part:IsA("Frame") then
			part.BackgroundColor3 = C.Ink
			part.BackgroundTransparency = math.max(part.BackgroundTransparency, 0.6)
			part.ZIndex = shade.ZIndex
		elseif part:IsA("UIStroke") then
			part.Enabled = false
		end
	end
	return icon
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">MapPicker</string>
              <string name="Source"><![CDATA[--[[
	MapPicker: the "Maps" window (docs/parkour-maps.md, "Picker + server").

	Header "PICK A MAP". Left: a 2-column grid of the ten Parkour map cards, stretched so all
	ten fit without scrolling (accent band with the map's icon, "Level n", the best time and a
	check when cleared or a lock badge when locked; the name and difficulty pips below). The
	selected card carries a thick gold rim, a lighter body and a gold chevron; a locked one has
	a grey band (text kept bright) and wobbles with "Clear <previous map> first!" when tapped.
	Right, top to bottom: the selected map in a slowly orbiting ViewportFrame preview (panel
	width, about 45% of its height) with a "Level n" chip, name, pips, best/clears, blurb, the
	reward line and a gold PLAY (RESTART while that map is running) that fires ModeStart and
	closes every window. When the screen or window is narrow (viewport < 700 or window < 750
	wide) the side panel stacks under the grid in one scrolling column.

	The preview is a lazy clone of workspace.Map.GameModes.Parkour.Level<n> without its
	invisible volumes (Transparency 1, ParkourFinish, ParkourWater, Trigger), cached per map,
	over a flat sky-blue plane (the course floats above the clouds), framed so the whole level
	bounding box (path, cloud floor and floating islands with their props) fits the viewport
	from a high 3/4 angle. It orbits on RenderStepped only while the window is open.

	Windows.luau owns the window list: it calls MapPicker.build with its register/closeAll
	helpers and the shared reward/pip helpers, and exposes Windows.open("Maps") and
	Windows.openMaps(level?). Reads State.data.modes.parkour (levels[i] = { name,
	difficulty, best, clears, bonus, theme?, blurb?, icon?, accent? }, unlocked, level,
	running).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage.Shared.Net)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)

local Theme = Kit.Theme
local C = Kit.C
local T = Kit.TEXT
local F = Kit.F

local MapPicker = {}

export type Deps = {
	register: (string, Kit.Window) -> (),
	closeAll: () -> (),
	-- Paints `label` with what finishing parkour level `level` pays (Windows' setRewardLine
	-- with the level bonus rescale).
	parkourReward: (label: TextLabel, info: { [string]: any }, level: number) -> (),
	-- Builds a difficulty pip row; returns its setter.
	pips: (parent: Instance, props: { [string]: any }) -> (number) -> (),
	runTime: (number) -> string,
	plural: (number, string, string?) -> string,
	ripple: ({ GuiObject }) -> (),
}

export type Picker = {
	window: Kit.Window,
	-- Runs before the window opens: refresh, selection resync, card ripple.
	beforeOpen: () -> (),
	-- Selects `level` the next time the window opens (nil: the player's unlocked level).
	preselect: (number?) -> (),
	-- Selects an unlocked level now (clamped).
	select: (number) -> (),
}

local MAP_COUNT = 10
local SIDE_W = 300
-- Card height: fills the grid column so all ten cards show without scrolling, within these
-- bounds (CARD_MIN is also the height in the stacked phone layout).
local CARD_MIN = 60
local CARD_MAX = 84
local CARD_GAP = 8
local BAND_H = 28
local GRID_PAD = 6
local STACK_W = 700
-- Below this window width the cards get too narrow for their pip row: stack instead.
local SIDE_BY_SIDE_MIN_W = 750
local SIDE_STACK_H = 440
-- Side panel: fixed rows measured up from the bottom (offsets of each row's bottom edge).
local PLAY_H = 50
local PLAY_BOTTOM = 12
local REWARD_BOTTOM = PLAY_BOTTOM + PLAY_H + 8
local BLURB_H = 40
local BLURB_BOTTOM = REWARD_BOTTOM + 18 + 4
local STATS_H = 20
local STATS_BOTTOM = BLURB_BOTTOM + BLURB_H + 4
local PIPS_BOTTOM = STATS_BOTTOM + STATS_H + 4
local NAME_H = 24
local NAME_BOTTOM = PIPS_BOTTOM + 16 + 4
-- The preview spans the side panel's width (less a thin inset) at the top and takes about
-- 45% of its height, never so much that it would run into the name row below.
local PREVIEW_INSET = 6
local PREVIEW_SHARE = 0.45
local PREVIEW_BOTTOM = NAME_BOTTOM + NAME_H + 8
-- Lock badge on locked bands: a dark disc behind a 20 px lock.
local LOCK_SIZE = 20
local LOCK_DISC = 26
local LOCKED_SLATE = Color3.fromRGB(104, 112, 138)
-- Accent fallbacks (Theme.World keys) for maps whose data has no accent yet.
local ACCENTS = { "Sunny", "Teal", "Blue", "Coral", "Mint", "Pink", "Grape", "Blue", "Orange", "Sunny" }
local ICONS = { "🏖️", "🌴", "⚓", "🐠", "🫧", "🪸", "🦈", "⛈️", "🌋", "👑" }
local STRIP = { ParkourFinish = true, ParkourWater = true, Trigger = true }
-- The sky under the cloud floor (preview plane and well).
local SEA = Color3.fromRGB(120, 190, 245)
local PREVIEW_FOV = 40
-- Camera pitch (degrees below the horizon) for the 3/4 overhead view, and the breathing
-- room left round the course in the frame.
local PREVIEW_PITCH = 40
local PREVIEW_MARGIN = 1.12
local ORBIT_SPEED = 0.12

local function parkourInfo(): { [string]: any }?
	local data = State.data
	local info = data and data.modes and data.modes.parkour
	return if type(info) == "table" then info else nil
end

local function levelList(info: { [string]: any }?): { any }
	return if info and type(info.levels) == "table" then info.levels else {}
end

local function accentOf(lv: any, i: number): Color3
	local key = if type(lv) == "table" and type(lv.accent) == "string" then lv.accent else ACCENTS[i] or "Sunny"
	local color = (Theme.World :: any)[key]
	if typeof(color) ~= "Color3" then
		color = (Theme.World :: any)[ACCENTS[i] or "Sunny"]
	end
	return if typeof(color) == "Color3" then color else C.Gold
end

local function iconOf(lv: any, i: number): string
	return if type(lv) == "table" and type(lv.icon) == "string" and lv.icon ~= "" then lv.icon else ICONS[i] or "🏁"
end

local function nameOf(lv: any, i: number): string
	return if type(lv) == "table" and type(lv.name) == "string" then lv.name else "Level " .. i
end

-- Preview -------------------------------------------------------------------------------

type Preview = { model: Model, center: Vector3, span: Vector3 }

-- Clones Level<n> without its invisible volumes into a Model over a sky plane, or nil when
-- the level is not in the workspace (yet).
local function buildPreview(n: number): Preview?
	local map = workspace:FindFirstChild("Map")
	local modes = map and map:FindFirstChild("GameModes")
	local parkour = modes and modes:FindFirstChild("Parkour")
	local source = parkour and parkour:FindFirstChild("Level" .. n)
	if not source then
		return nil
	end
	local ok, clone = pcall(function()
		return source:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "MapPreview" .. n
	local strip: { Instance } = {}
	for _, item in clone:GetDescendants() do
		if item:IsA("BasePart") then
			if item.Transparency >= 1 or STRIP[item.Name] then
				table.insert(strip, item)
			end
		elseif item:IsA("Sound") or item:IsA("Script") or item:IsA("LocalScript") then
			table.insert(strip, item)
		end
	end
	for _, item in strip do
		item:Destroy()
	end
	-- Bounding box of what is left (rotated parts by their world-axis extents).
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = -lo
	local count = 0
	for _, part in clone:GetDescendants() do
		if part:IsA("BasePart") then
			count += 1
			local cf, size = part.CFrame, part.Size * 0.5
			local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
			local ext = Vector3.new(
				math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z,
				math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z,
				math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z
			)
			lo = lo:Min(cf.Position - ext)
			hi = hi:Max(cf.Position + ext)
		end
	end
	if count < 4 then
		-- Not streamed in yet (or empty): try again next time.
		clone:Destroy()
		model:Destroy()
		return nil
	end
	for _, child in clone:GetChildren() do
		child.Parent = model
	end
	clone:Destroy()
	local center = (lo + hi) * 0.5
	local span = hi - lo
	local sea = Instance.new("Part")
	sea.Name = "Sea"
	sea.Anchored = true
	sea.Material = Enum.Material.SmoothPlastic
	sea.Color = SEA
	sea.Size = Vector3.new(span.X * 1.6 + 120, 1, span.Z * 1.6 + 120)
	sea.CFrame = CFrame.new(center.X, lo.Y - 0.5, center.Z)
	sea.Parent = model
	return { model = model, center = center, span = span }
end

-- Camera distance that fits the whole course box in a viewport of `aspect` (width/height)
-- from PREVIEW_PITCH above the horizon. The ground footprint is fitted by the larger of
-- width and depth, widened to the footprint diagonal so no orbit angle crops a corner;
-- vertically by that footprint foreshortened by the pitch plus the course's height.
local function fitDistance(span: Vector3, aspect: number): number
	local footprint = math.max(math.max(span.X, span.Z), math.sqrt(span.X * span.X + span.Z * span.Z), 20)
	local pitch = math.rad(PREVIEW_PITCH)
	local tanV = math.tan(math.rad(PREVIEW_FOV * 0.5))
	local tanH = tanV * math.max(aspect, 0.2)
	local wide = footprint * 0.5 / tanH
	local tall = (footprint * math.sin(pitch) + span.Y * math.cos(pitch)) * 0.5 / tanV
	-- Half the footprint sits nearer the camera than the centre (and looks bigger).
	return math.max(wide, tall) * PREVIEW_MARGIN + footprint * 0.5 * math.cos(pitch) * 0.35
end

-- Window --------------------------------------------------------------------------------

type Card = {
	frame: Frame,
	band: Frame,
	icon: TextLabel,
	levelLabel: TextLabel,
	name: TextLabel,
	stats: TextLabel,
	check: Frame,
	lock: Frame,
	body: CanvasGroup,
	chevron: TextLabel,
	stroke: UIStroke?,
	fill: UIGradient?,
	setPips: (number) -> (),
}

-- Card body fills: the panel's own ramp, and a lighter one for the selected card.
local CARD_FILL = ColorSequence.new(Kit.lighten(C.SurfaceHi, 0.1), C.SurfaceHi:Lerp(Kit.lip(C.SurfaceHi), 0.12))
local CARD_FILL_SELECTED = ColorSequence.new(Kit.lighten(C.SurfaceHi, 0.26), Kit.lighten(C.SurfaceHi, 0.12))

-- Grey version of an accent for locked bands: its luminance, pulled toward a cool slate.
local function desaturate(color: Color3): Color3
	local y = color.R * 0.3 + color.G * 0.59 + color.B * 0.11
	return Color3.new(y, y, y):Lerp(LOCKED_SLATE, 0.6)
end

function MapPicker.build(screen: ScreenGui, deps: Deps): Picker
	local accent = Theme.World.Mint
	local window = Kit.window(screen, "Maps", "Pick a Map", "🗺️", accent, Vector2.new(880, 560), Vector2.new(420, 480))
	deps.register("Maps", window)
	local action = Net.event("Action")

	local selected = 1
	local pending: number? = nil
	local stacked = false
	local laidOut = false

	-- One scroll for the grid; in stacked mode the side panel joins it below the grid.
	local scroll = Kit.scrolling(window.content, { Name = "Scroll" })
	-- Only scrolls in the stacked layout; keep the bar easy to spot there.
	scroll.ScrollBarThickness = 8
	scroll.ScrollBarImageColor3 = C.Text
	scroll.ScrollBarImageTransparency = 0.35
	Kit.list(scroll, 10)
	local grid = Kit.new("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = scroll,
	})
	local gridLayout = Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -CARD_GAP / 2, 0, CARD_MIN),
		CellPadding = UDim2.fromOffset(CARD_GAP, CARD_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	}) :: UIGridLayout
	-- Room for the card lips and shadows at the bottom of the grid.
	Kit.padding(grid, 0).PaddingBottom = UDim.new(0, GRID_PAD)

	local side = Kit.panel(window.content, {
		Name = "Side",
		Elevated = true,
		Size = UDim2.new(0, SIDE_W, 1, 0),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		LayoutOrder = 2,
		Radius = Kit.RADIUS.M + 2,
	})

	-- Preview well with the viewport, a fallback icon and a "Level n" chip.
	local previewWell = Kit.well(side, {
		Name = "Preview",
		Color = SEA,
		Size = UDim2.new(1, -PREVIEW_INSET * 2, PREVIEW_SHARE, 0),
		Position = UDim2.fromOffset(PREVIEW_INSET, PREVIEW_INSET),
		Radius = Kit.RADIUS.M,
	})
	previewWell.ClipsDescendants = true
	local viewport = Kit.new("ViewportFrame", {
		Name = "View",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(190, 196, 210),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.4, -1, 0.5),
		ZIndex = 2,
		Parent = previewWell,
	}) :: ViewportFrame
	Kit.corner(viewport, Kit.RADIUS.M)
	local camera = Instance.new("Camera")
	camera.FieldOfView = PREVIEW_FOV
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local fallback = Kit.text(previewWell, {
		Name = "Fallback",
		Text = "",
		TextSize = 72,
		Size = UDim2.fromScale(1, 1),
		StrokeThickness = 0,
		ZIndex = 3,
	})
	local levelChip = Kit.pill(side, {
		Name = "LevelChip",
		Text = "",
		Font = Theme.Fonts.Display,
		TextSize = T.Small,
		Color = C.Gold,
		Solid = true,
		Size = UDim2.fromOffset(90, 26),
		Position = UDim2.fromOffset(PREVIEW_INSET + 8, PREVIEW_INSET + 8),
		ZIndex = 4,
	})

	-- About 45% of the side panel's height, capped so the rows below always fit.
	local function sizePreview()
		-- (pcall: the Lune preview export's GUI stand-ins have no AbsoluteSize.)
		local ok, size = pcall(function()
			return side.AbsoluteSize
		end)
		local h = if ok and typeof(size) == "Vector2" then size.Y else 0
		if h <= 0 then
			return
		end
		local room = h - PREVIEW_BOTTOM - PREVIEW_INSET
		local height = math.max(math.min(math.floor(h * PREVIEW_SHARE), room), 60)
		previewWell.Size = UDim2.new(1, -PREVIEW_INSET * 2, 0, height)
	end
	side:GetPropertyChangedSignal("AbsoluteSize"):Connect(sizePreview)

	local sideName = Kit.title(side, {
		Name = "MapName",
		Text = "",
		TextSize = T.H3,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -24, 0, NAME_H),
		Position = UDim2.new(0, 12, 1, -NAME_BOTTOM),
		AnchorPoint = Vector2.new(0, 1),
		TextColor3 = C.Text,
	})
	local setSidePips = deps.pips(side, {
		Name = "Difficulty",
		Size = UDim2.new(1, -24, 0, 16),
		Position = UDim2.new(0, 12, 1, -(PIPS_BOTTOM + 16)),
	})
	local sideStats = Kit.text(side, {
		Name = "Stats",
		Text = "",
		Font = F.UI,
		TextSize = T.Body,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -24, 0, STATS_H),
		Position = UDim2.new(0, 12, 1, -STATS_BOTTOM),
		AnchorPoint = Vector2.new(0, 1),
		TextColor3 = C.Text,
		StrokeThickness = 0,
	})
	local blurb = Kit.text(side, {
		Name = "Blurb",
		Text = "",
		TextSize = T.Body,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -24, 0, BLURB_H),
		Position = UDim2.new(0, 12, 1, -BLURB_BOTTOM),
		AnchorPoint = Vector2.new(0, 1),
		TextColor3 = C.TextDim,
		StrokeThickness = 0,
	})
	local reward = Kit.text(side, {
		Name = "Reward",
		Text = "",
		Font = F.UI,
		TextSize = T.Small,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.new(0, 12, 1, -REWARD_BOTTOM),
		AnchorPoint = Vector2.new(0, 1),
		TextColor3 = C.MoneyText,
		StrokeThickness = 0,
	})
	local play = Kit.button(side, {
		Name = "Play",
		Text = "PLAY",
		Font = Theme.Fonts.Display,
		Color = C.Gold,
		Breathe = true,
		Size = UDim2.new(1, -24, 0, PLAY_H),
		Position = UDim2.new(0.5, 0, 1, -PLAY_BOTTOM),
		AnchorPoint = Vector2.new(0.5, 1),
	}, function()
		action:FireServer({ action = "ModeStart", mode = "parkour", level = selected })
		deps.closeAll()
	end)
	-- Gamepad starts on PLAY.
	play:SetAttribute("FocusFirst", true)

	-- "Clear <map> first!" bubble over the grid (the toast for locked taps).
	local hint = Kit.pill(window.frame, {
		Name = "Hint",
		Text = "",
		Font = Theme.Fonts.Display,
		TextSize = T.Small,
		Color = C.Bad,
		Solid = true,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 28),
		Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		ZIndex = 20,
	})
	local hintToken = 0
	local function showHint(text: string)
		hintToken += 1
		local mine = hintToken
		hint.Text = text
		hint.Visible = true
		Kit.pop(hint, 1.2)
		task.delay(1.8, function()
			if hintToken == mine then
				hint.Visible = false
			end
		end)
	end

	-- Preview cache and orbit ------------------------------------------------------------
	local previews: { [number]: Preview } = {}
	local shown: Preview? = nil
	local angle = math.rad(35)
	local function placeCamera()
		local p = shown
		if not p then
			return
		end
		local px = viewport.AbsoluteSize
		local aspect = if px.Y > 0 then px.X / px.Y else 1.4
		local d = fitDistance(p.span, aspect)
		-- High 3/4 view: PREVIEW_PITCH degrees down onto the course.
		local pitch = math.rad(PREVIEW_PITCH)
		local flat = d * math.cos(pitch)
		local offset = Vector3.new(math.cos(angle) * flat, d * math.sin(pitch), math.sin(angle) * flat)
		camera.CFrame = CFrame.lookAt(p.center + offset, p.center)
	end
	local function showPreview(n: number)
		local p = previews[n]
		if not p then
			local ok, built = pcall(buildPreview, n)
			if ok and built then
				previews[n] = built
				p = built
			end
		end
		if shown and shown ~= p then
			shown.model.Parent = nil
		end
		shown = p
		if p then
			p.model.Parent = viewport
			fallback.Visible = false
			placeCamera()
		else
			local list = levelList(parkourInfo())
			fallback.Text = iconOf(list[n], n)
			fallback.Visible = true
		end
	end
	local orbit: RBXScriptConnection? = nil
	window.onOpen.Event:Connect(function()
		if orbit then
			return
		end
		pcall(function()
			orbit = RunService.RenderStepped:Connect(function(dt: number)
				if shown then
					angle += dt * ORBIT_SPEED
					placeCamera()
				end
			end)
		end)
	end)
	window.onClose.Event:Connect(function()
		if orbit then
			orbit:Disconnect()
			orbit = nil
		end
	end)

	-- Cards --------------------------------------------------------------------------------
	local cards: { Card } = {}
	local refresh: () -> ()

	local function wobble(gui: GuiObject)
		Kit.tween(gui, 0.06, { Rotation = -5 })
		task.delay(0.06, function()
			Kit.tween(gui, 0.08, { Rotation = 4 })
			task.delay(0.08, function()
				Kit.tween(gui, 0.2, { Rotation = 0 }, Enum.EasingStyle.Back)
			end)
		end)
	end

	for i = 1, MAP_COUNT do
		local frame = Kit.panel(grid, {
			Name = "Map" .. i,
			Elevated = true,
			Size = UDim2.fromScale(1, 1),
			LayoutOrder = i,
			Radius = Kit.RADIUS.M,
		})
		local band = Kit.new("Frame", {
			Name = "Band",
			BackgroundColor3 = C.Gold,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, BAND_H),
			ZIndex = 2,
			Parent = frame,
		})
		Kit.corner(band, Kit.RADIUS.M)
		-- Square off the bottom of the band.
		local cover = Kit.new("Frame", {
			Name = "Cover",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 12),
			Position = UDim2.new(0, 0, 1, -12),
			ZIndex = 2,
			Parent = band,
		})
		-- Moulded look: a touch darker toward the bottom (the cover carries on the same ramp).
		Kit.gradient(band, Color3.new(1, 1, 1), Color3.new(0.86, 0.86, 0.9))
		Kit.gradient(cover, Color3.new(0.92, 0.92, 0.94), Color3.new(0.86, 0.86, 0.9))
		local icon = Kit.text(band, {
			Name = "Icon",
			Text = "",
			TextSize = 18,
			Size = UDim2.fromOffset(26, BAND_H),
			Position = UDim2.fromOffset(6, 0),
			StrokeThickness = 0,
			ZIndex = 3,
		})
		local levelLabel = Kit.title(band, {
			Name = "Level",
			Text = "Level " .. i,
			TextSize = T.Small,
			TextWrapped = false,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(0, 72, 1, 0),
			Position = UDim2.fromOffset(34, 0),
			StrokeThickness = 0,
			ZIndex = 3,
		})
		-- Best time on the right of the band, then the cleared check or the lock.
		local stats = Kit.text(band, {
			Name = "Stats",
			Text = "",
			Font = F.UI,
			TextSize = T.Tiny,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.new(1, -136, 1, 0),
			Position = UDim2.new(1, -30, 0, 0),
			AnchorPoint = Vector2.new(1, 0),
			StrokeThickness = 0,
			ZIndex = 3,
		})
		local check = Kit.icon(band, "Check", 16, C.Good, {
			Position = UDim2.new(1, -8, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 3,
		})
		-- Lock badge: a 20 px lock on a dark disc so it reads on any band colour.
		local lock = Kit.new("Frame", {
			Name = "Lock",
			BackgroundColor3 = C.Ink,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(LOCK_DISC, LOCK_DISC),
			Position = UDim2.new(1, -4, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 3,
			Parent = band,
		})
		Kit.corner(lock, LOCK_DISC)
		Kit.icon(lock, "Lock", LOCK_SIZE, C.Text, {
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 4,
		})
		-- Name and pips, centred under the band.
		local body = Kit.new("CanvasGroup", {
			Name = "Body",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1, -BAND_H),
			Position = UDim2.fromOffset(0, BAND_H),
			ZIndex = 2,
			Parent = frame,
		}) :: CanvasGroup
		Kit.list(body, 4).VerticalAlignment = Enum.VerticalAlignment.Center
		Kit.padding(body, 0, 10)
		local name = Kit.title(body, {
			Name = "MapName",
			Text = "",
			TextSize = T.Body,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			-- Leaves room on the right for the selected card's chevron.
			Size = UDim2.new(1, -14, 0, 18),
			LayoutOrder = 1,
			TextColor3 = C.Text,
			ZIndex = 2,
		})
		local setPips = deps.pips(body, {
			Name = "Difficulty",
			Pip = 8,
			Size = UDim2.new(1, 0, 0, 14),
		})
		local pipRow = body:FindFirstChild("Difficulty")
		if pipRow and pipRow:IsA("GuiObject") then
			pipRow.LayoutOrder = 2
		end
		-- Small gold chevron on the right of the selected card's body.
		local chevron = Kit.text(frame, {
			Name = "Chevron",
			Text = "▶",
			TextSize = T.Small,
			TextColor3 = C.Gold,
			Size = UDim2.fromOffset(14, 18),
			Position = UDim2.new(1, -8, 0.5, BAND_H / 2),
			AnchorPoint = Vector2.new(1, 0.5),
			StrokeThickness = 0,
			Visible = false,
			ZIndex = 3,
		})
		local hit = Kit.new("TextButton", {
			Name = "Hit",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 7,
			Parent = frame,
		})
		local card: Card = {
			frame = frame,
			band = band,
			icon = icon,
			levelLabel = levelLabel,
			name = name,
			stats = stats,
			check = check,
			lock = lock,
			body = body,
			chevron = chevron,
			stroke = frame:FindFirstChildOfClass("UIStroke"),
			fill = frame:FindFirstChildOfClass("UIGradient"),
			setPips = setPips,
		}
		cards[i] = card
		hit.Activated:Connect(function()
			local info = parkourInfo()
			local unlocked = if info then tonumber(info.unlocked) or 1 else 1
			if i > unlocked then
				Kit.sound("Error")
				wobble(frame)
				local list = levelList(info)
				showHint(string.format("Clear %s first!", nameOf(list[i - 1], i - 1)))
				return
			end
			Kit.sound("Click")
			Kit.pop(frame, 0.5)
			if selected ~= i then
				selected = i
				refresh()
			end
		end)
	end

	local function paintCard(card: Card, i: number, lv: any, unlocked: number)
		local color = accentOf(lv, i)
		local locked = i > unlocked
		local clears = if type(lv) == "table" then tonumber(lv.clears) or 0 else 0
		local best = if type(lv) == "table" then tonumber(lv.best) or 0 else 0
		-- Locked: a grey (desaturated) band with a lock badge; text stays at full brightness.
		local bandColor = if locked then desaturate(color) else color
		card.band.BackgroundColor3 = bandColor
		local cover = card.band:FindFirstChild("Cover")
		if cover and cover:IsA("Frame") then
			cover.BackgroundColor3 = bandColor
		end
		local ink = if locked then C.Text else Kit.inkOn(color)
		card.levelLabel.TextColor3 = ink
		card.levelLabel.TextTransparency = 0
		card.stats.TextColor3 = ink
		card.icon.Text = iconOf(lv, i)
		card.icon.TextTransparency = 0
		card.name.Text = nameOf(lv, i)
		card.setPips(if type(lv) == "table" then tonumber(lv.difficulty) or i else i)
		card.check.Visible = clears > 0 and not locked
		card.lock.Visible = locked
		card.body.GroupTransparency = 0
		if locked or clears <= 0 then
			card.stats.Text = ""
		else
			card.stats.Text = if best > 0 then "Best " .. deps.runTime(best) else deps.plural(clears, "clear")
		end
		-- Selected: thick gold rim, a lighter body and a gold chevron.
		local isSelected = i == selected
		local stroke = card.stroke
		if stroke then
			stroke.Color = if isSelected then C.Gold else Kit.lip(C.SurfaceHi)
			stroke.Thickness = if isSelected then 4 else 1.5
		end
		if card.fill then
			card.fill.Color = if isSelected then CARD_FILL_SELECTED else CARD_FILL
		end
		card.chevron.Visible = isSelected
	end

	local function paintSide(info: { [string]: any }?, list: { any })
		local lv = list[selected]
		levelChip.Text = "Level " .. selected
		levelChip.BackgroundColor3 = accentOf(lv, selected)
		levelChip.TextColor3 = Kit.inkOn(levelChip.BackgroundColor3)
		sideName.Text = nameOf(lv, selected)
		local clears = if type(lv) == "table" then tonumber(lv.clears) or 0 else 0
		local best = if type(lv) == "table" then tonumber(lv.best) or 0 else 0
		setSidePips(if type(lv) == "table" then tonumber(lv.difficulty) or selected else selected)
		sideStats.Text = string.format("Best %s  ·  %s", if best > 0 then deps.runTime(best) else "--", deps.plural(clears, "clear"))
		blurb.Text = if type(lv) == "table" and type(lv.blurb) == "string" then lv.blurb else "Jump, bounce and slide across the sky!"
		if info and type(lv) == "table" then
			deps.parkourReward(reward, info, selected)
		else
			reward.Text = ""
		end
		local runningHere = info ~= nil and info.running == true and tonumber(info.level) == selected
		Kit.setButton(play, if runningHere then "RESTART" else "PLAY")
		if window.isOpen() then
			showPreview(selected)
		end
	end

	refresh = function()
		local info = parkourInfo()
		local list = levelList(info)
		local count = math.max(#list, 1)
		local unlocked = math.clamp(if info then tonumber(info.unlocked) or 1 else 1, 1, math.max(count, 1))
		selected = math.clamp(selected, 1, unlocked)
		for i, card in cards do
			card.frame.Visible = #list == 0 or list[i] ~= nil
			paintCard(card, i, list[i], unlocked)
		end
		paintSide(info, list)
	end

	-- Layout: side panel beside the grid, or stacked under it on narrow screens. Beside the
	-- grid the cards stretch to fill the column so all ten show without scrolling.
	local function layout()
		local viewportW = math.huge
		pcall(function()
			local cam = workspace.CurrentCamera
			if cam then
				viewportW = cam.ViewportSize.X
			end
		end)
		local size = window.size()
		local narrow = viewportW < STACK_W or size.X < SIDE_BY_SIDE_MIN_W
		local cardH = CARD_MIN
		if not narrow then
			-- Window content well: 84 px of header and margins, 10 px padding each side.
			local rows = math.ceil(MAP_COUNT / 2)
			local available = size.Y - 84 - 20 - GRID_PAD - CARD_GAP * (rows - 1)
			cardH = math.clamp(math.floor(available / rows), CARD_MIN, CARD_MAX)
		end
		gridLayout.CellSize = UDim2.new(0.5, -CARD_GAP / 2, 0, cardH)
		if laidOut and narrow == stacked then
			return
		end
		laidOut = true
		stacked = narrow
		if stacked then
			scroll.Size = UDim2.fromScale(1, 1)
			side.Parent = scroll
			side.AnchorPoint = Vector2.zero
			side.Position = UDim2.new()
			side.Size = UDim2.new(1, 0, 0, SIDE_STACK_H)
		else
			side.Parent = window.content
			scroll.Size = UDim2.new(1, -(SIDE_W + 12), 1, 0)
			side.AnchorPoint = Vector2.new(1, 0)
			side.Position = UDim2.fromScale(1, 0)
			side.Size = UDim2.new(0, SIDE_W, 1, 0)
		end
	end
	layout()
	window.onResize.Event:Connect(layout)
	sizePreview()

	State.changed.Event:Connect(function()
		if window.isOpen() then
			refresh()
		end
	end)
	local tickId = 0
	window.onOpen.Event:Connect(function()
		showPreview(selected)
		-- The cooldown line counts down while the window is open (one loop per open: a
		-- reopen within the second retires the previous loop).
		tickId += 1
		local myId = tickId
		task.spawn(function()
			while window.isOpen() and tickId == myId do
				task.wait(1)
				if window.isOpen() and tickId == myId then
					local info = parkourInfo()
					local list = levelList(info)
					if info and type(list[selected]) == "table" then
						deps.parkourReward(reward, info, selected)
					end
				end
			end
		end)
	end)

	local function beforeOpen()
		layout()
		local info = parkourInfo()
		selected = if pending then pending elseif info then tonumber(info.unlocked) or 1 else 1
		pending = nil
		scroll.CanvasPosition = Vector2.zero
		refresh()
		local list: { GuiObject } = {}
		for _, card in cards do
			table.insert(list, card.frame)
		end
		table.insert(list, side)
		deps.ripple(list)
	end

	refresh()
	return {
		window = window,
		beforeOpen = beforeOpen,
		preselect = function(level: number?)
			pending = if type(level) == "number" and level == level then math.floor(level) else nil
		end,
		select = function(level: number)
			if level == level then
				selected = math.floor(level)
				refresh()
			end
		end,
	}
end

return MapPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">MogHud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MogHud: the screen side of the MOG TEST, a skill-check duel either against rival chads
	(vs = "rivals", solo) or against a real player (vs = "pvp", 1v1).

	  Picker       Notify "choose" (the player walked through the mog gate) and the Modes
	               window's PLAY open Popups.mogChoose: VS RIVALS or 1v1 DUEL, which fire
	               ModeStart with vs = "rivals" | "pvp".
	  Queue        "queue" { since, timeout }: a compact "FINDING OPPONENT…" panel on the
	               right (spinner, dots, elapsed seconds, Cancel = MogCancel); the player
	               walks around meanwhile. "stop" "noOpponent" toasts and reopens the picker.
	               While queued choose() opens no picker and pops the queue panel instead.
	  Ring         centre-right, 180 px, drawn by UI.MogRing: setCheck draws the zone with
	               its swell-in cue, warn() runs every frame until the needle starts, then
	               setNeedle(travel, dir) poses the needle from the server clock (travel =
	               speed * (now - appearAt)), flash() on each result, idle() between checks.
	               The result word ("PERFECT!", "HIT", "MISS" / "TOO EARLY" / "TOO SLOW"
	               in red) pops in on the ring's top edge and rises as it fades.
	  Input        Space, Enter and gamepad A (ContextActionService, high priority, sunk
	               so Space does not jump) and a big invisible button over the ring for
	               mouse / touch. One MogPress per check, sent with the server time of the
	               press; presses before the needle starts only give a small "wait..."
	               wobble. The needle freezes where it was pressed until the result.
	  Status       score (bouncy count) and the combo chip above the ring and a quiet "X"
	               that asks "QUIT?" before firing ModeQuit. Vs rivals: hearts (maxLives)
	               under them and the rival's name and HP bar under the ring. In a duel the
	               hearts become your own HP bar ("YOU", green, gold flash on perfect) and
	               the bottom panel is the opponent's name and red HP bar, both moved by
	               "round" only ("result" is just your own press); the opponent's result
	               shows small under it ("Opponent: PERFECT").
	  Banners      "MOG TEST!" / "1v1 DUEL!" (vs <name>) at the start, "MOGGED!" per rival,
	               "MOG TEST PASSED!" with the cash the first time the run passes,
	               "SUDDEN DEATH!" in a duel.

	MogHud.onNotify(payload) takes every Notify with kind "Mode" and mode "mog" (Main
	routes them); Fx.Mog does the 3D side from the same payloads. MogHud.choose() opens
	the picker (Windows.onMogPlay points here).
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Format = require(ReplicatedStorage.Shared.Format) :: any
local Net = require(ReplicatedStorage.Shared.Net)

local Client = script.Parent.Parent
local Kit = require(script.Parent.Kit) :: any
local MogRing = require(script.Parent.MogRing) :: any
local Popups = require(script.Parent.Popups) :: any
local Sounds = require(Client.Sounds) :: any

local MogHud = {}

local C = Kit.C
local F = Kit.F
local W = Theme.World

local RING = 180 -- ring diameter (px, design space)
local ACTION = "MogPress"
local QUIT_ACTION = "MogQuit"
local PRIORITY = 3000
local RESULT_WORDS = { perfect = "PERFECT", hit = "HIT", miss = "MISS" }

local action = Net.event("Action")

type Check = {
	id: any,
	n: number,
	appearAt: number,
	speed: number,
	dir: number,
	zoneStart: number,
	zoneSize: number,
	perfectSize: number,
}

local screen: ScreenGui? = nil
local root: Frame
local ring: any -- MogRing
local tapHint: TextLabel
local resultLabel: TextLabel
local scoreLabel: TextLabel
local comboChip: TextLabel
local heartsRow: Frame
local youPanel: Frame
local youFill: Frame
local youHpText: TextLabel
local rivalName: TextLabel
local rivalFill: Frame
local rivalHpText: TextLabel
local oppResult: TextLabel
local banner: Frame
local bannerTitle: TextLabel
local bannerSub: TextLabel
local quitButton: TextButton
local queuePanel: Frame
local queueTitle: TextLabel
local queueTime: TextLabel
local queueSpinner: Frame

local active = false
local pvp = false -- this run is a 1v1 duel
local check: Check? = nil
local pressed = false -- this check's press is sent (input locked until the result)
local frozenTravel: number? = nil
local shownScore = 0
local lives, maxLives = 3, 3
local passedShown = false
local quitArmed = false
-- Which input prompt the ring centre shows ("idle", "check"), so it re-reads when the
-- player switches between touch, keyboard and gamepad; nil while it shows something else.
local centreHint: string? = nil
-- The resting quit label: a close "X", or "Y" on a controller (the button that quits).
local function quitLabel(): string
	return if Kit.gamepad then "Y" else "X"
end

-- The quit button's press (first arms "QUIT?", the second quits); set in build.
local quitPress: () -> () = function() end
local warned = false
local bannerToken = 0
local stepConn: RBXScriptConnection? = nil
local queueToken = 0
local choosing = false -- the picker is open (or queued)
local queued = false -- waiting for a duel opponent (the queue panel is up)

local function num(value: any, default: number): number
	return if type(value) == "number" and value == value then value else default
end

-- Hearts ----------------------------------------------------------------------------------

-- A heart from two discs and a 45-degree square.
local function heart(parent: Instance, index: number): Frame
	local holder = Kit.new("Frame", {
		Name = "Heart" .. index,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(30, 28),
		LayoutOrder = index,
		Parent = parent,
	})
	local scale = Kit.new("UIScale", { Parent = holder })
	scale.Name = "Pop"
	local function piece(name: string, size: number, x: number, y: number, rotation: number, round: boolean)
		local f = Kit.new("Frame", {
			Name = name,
			BackgroundColor3 = C.Bad,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.fromOffset(x, y),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = rotation,
			Parent = holder,
		})
		if round then
			Kit.round(f)
		else
			Kit.corner(f, 3)
		end
	end
	piece("Left", 15, 10, 10, 0, true)
	piece("Right", 15, 20, 10, 0, true)
	piece("Point", 15, 15, 15.5, 45, false)
	return holder
end

local function paintHeart(holder: Instance, full: boolean)
	for _, f in holder:GetChildren() do
		if f:IsA("Frame") then
			Kit.tween(f, 0.25, { BackgroundColor3 = if full then C.Bad else C.Well })
		end
	end
end

local function setHearts(newLives: number, newMax: number, animate: boolean)
	if newMax ~= maxLives or #heartsRow:GetChildren() <= 1 then
		for _, child in heartsRow:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		for i = 1, newMax do
			heart(heartsRow, i)
		end
	end
	for i = 1, newMax do
		local holder = heartsRow:FindFirstChild("Heart" .. i)
		if holder then
			local full = i <= newLives
			local was = i <= lives
			paintHeart(holder, full)
			local pop = holder:FindFirstChild("Pop") :: UIScale?
			if animate and pop and was ~= full then
				-- A lost heart squashes and drops back; a regained one bounces in.
				pop.Scale = if full then 0.4 else 1.5
				Kit.tween(pop, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	end
	lives, maxLives = newLives, newMax
end

-- Ring --------------------------------------------------------------------------------------

local function travelNow(c: Check): number
	return math.clamp(c.speed * (Workspace:GetServerTimeNow() - c.appearAt), 0, 360)
end

local showBanner: (title: string, sub: string?, color: Color3, hold: number) -> ()

-- The result word pops in on the ring's top edge (clear of the "#n" centre label) and
-- rises toward the hearts / HP row while it fades.
local RESULT_FROM = UDim2.new(0.5, 0, 0, 6)
local RESULT_TO = UDim2.new(0.5, 0, 0, -16)

local function popResult(text: string, color: Color3)
	resultLabel.Text = text
	resultLabel.TextColor3 = color
	resultLabel.TextTransparency = 0
	resultLabel.Position = RESULT_FROM
	local scale = resultLabel:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.3
	Kit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.tween(resultLabel, 0.9, { Position = RESULT_TO }, Enum.EasingStyle.Quad)
	task.delay(0.65, function()
		if resultLabel.Text == text then
			Kit.tween(resultLabel, 0.3, { TextTransparency = 1 })
		end
	end)
end

local function setIdle()
	-- Between checks the ring rests small and dim with the needle hidden.
	check, pressed, frozenTravel = nil, false, nil
	ring:idle()
	ring:setNeedle(nil, 1)
	centreHint = "idle"
	ring:setCentre(Kit.keyHint("confirm"), C.TextDim)
end

local function wobble()
	-- "Wait..." : a little side-to-side shake of the ring, no camera shake.
	centreHint = nil
	ring:setCentre("wait…", C.TextDim)
	local frame: Frame = ring.frame
	local base = UDim2.fromScale(0.5, 0.5)
	task.spawn(function()
		for _, dx in { 6, -6, 4, -3, 0 } do
			frame.Position = base + UDim2.fromOffset(dx, 0)
			task.wait(0.04)
		end
		frame.Position = base
	end)
end

local function press()
	local c = check
	if not active or not c or pressed then
		return
	end
	local now = Workspace:GetServerTimeNow()
	if now < c.appearAt then
		wobble()
		return
	end
	pressed = true
	frozenTravel = travelNow(c)
	Kit.pop(ring.frame, 1.06)
	action:FireServer({ action = "MogPress", id = c.id, at = now })
end

local function onAction(_name: string, state: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult
	if state == Enum.UserInputState.Begin then
		press()
	end
	return Enum.ContextActionResult.Sink
end

local function step()
	local c = check
	if not c then
		return
	end
	local now = Workspace:GetServerTimeNow()
	if now < c.appearAt then
		-- Warning: MogRing breathes its cue until the needle starts.
		ring:warn(now)
		return
	end
	if not warned then
		warned = true
		centreHint = nil
		ring:setCentre("#" .. tostring(c.n), C.Text)
	end
	ring:setNeedle(frozenTravel or travelNow(c), c.dir)
end

local function onCheck(p: any)
	local c: Check = {
		id = p.id,
		n = num(p.n, 1),
		appearAt = num(p.appearAt, Workspace:GetServerTimeNow() + 1),
		speed = math.max(num(p.speed, 180), 1),
		dir = if p.dir == -1 then -1 else 1,
		zoneStart = num(p.zoneStart, 180),
		zoneSize = num(p.zoneSize, 40),
		perfectSize = num(p.perfectSize, 10),
	}
	check, pressed, frozenTravel, warned = c, false, nil, false
	-- The DBD-style warning: tick, and MogRing swells the ring in with the new zone.
	ring:setCheck({ zoneStart = c.zoneStart, zoneSize = c.zoneSize, perfectSize = c.perfectSize, dir = c.dir, n = c.n })
	ring:setNeedle(nil, c.dir)
	centreHint = "check"
	ring:setCentre(Kit.keyHint("confirm") .. (if Kit.touch then "!" else ""), C.Gold)
	Sounds.play("Tick")
end

-- An HP bar fill and its "hp/max" label; `flash` briefly tints the fill (a hit taken).
local function setBar(fill: Frame, label: TextLabel, hp: number, hpMax: number, flash: Color3?)
	hpMax = math.max(hpMax, 1)
	Kit.tween(fill, 0.35, { Size = UDim2.fromScale(math.clamp(hp / hpMax, 0, 1), 1) }, Enum.EasingStyle.Quart)
	label.Text = string.format("%d/%d", math.max(hp, 0), hpMax)
	if flash then
		local base = fill.BackgroundColor3
		fill.BackgroundColor3 = flash
		Kit.tween(fill, 0.5, { BackgroundColor3 = base })
		Kit.pop(label, 1.25)
	end
end

local function setScore(score: number, combo: number)
	-- Score rolls up with a bounce; the combo chip shows from x2.
	if score ~= shownScore then
		Kit.countTo(scoreLabel, shownScore, score, Format.short, 0.4)
		Kit.pop(scoreLabel, 1.25)
		shownScore = score
	end
	if combo >= 2 then
		comboChip.Text = "x" .. tostring(combo) .. " COMBO"
		if not comboChip.Visible then
			comboChip.Visible = true
			Kit.appear(comboChip, { from = 0.5 })
		else
			Kit.pop(comboChip, 1.2)
		end
	elseif comboChip.Visible then
		comboChip.Visible = false
	end
end

local function onResult(p: any)
	local c = check
	if c and p.id ~= nil and p.id ~= c.id then
		return
	end
	if c then
		local travel = num(p.travel, frozenTravel or travelNow(c))
		frozenTravel = travel
		ring:setNeedle(travel, c.dir)
	end
	local result = p.result
	if result == "perfect" then
		ring:flash("perfect")
		popResult("PERFECT!", C.Gold)
		Sounds.play("Coin", 0.05, 1.15)
	elseif result == "hit" then
		ring:flash("hit")
		popResult("HIT", W.Cream)
		Sounds.play("Pickup", 0.08)
	else
		ring:flash("miss")
		popResult(if p.reason == "early" then "TOO EARLY" elseif p.reason == "timeout" then "TOO SLOW" else "MISS", C.Bad)
		Sounds.play("Error")
	end
	setScore(num(p.score, shownScore), num(p.combo, 0))
	if not pvp then
		-- Vs rivals the result carries the damage; a duel waits for "round".
		setHearts(num(p.lives, lives), maxLives, true)
		setBar(rivalFill, rivalHpText, num(p.rivalHp, 1), num(p.rivalMax, 1))
	end
	task.delay(0.7, function()
		if active and check == c then
			setIdle()
		end
	end)
end

-- A duel round: both presses are judged, both HP bars move.
local function onRound(p: any)
	local you = if type(p.you) == "table" then p.you else {}
	local opp = if type(p.opp) == "table" then p.opp else {}
	local hurt = opp.result == "hit" or opp.result == "perfect" or you.result == "miss"
	local landed = you.result == "hit" or you.result == "perfect" or opp.result == "miss"
	setBar(youFill, youHpText, num(you.hp, 0), num(you.maxHp, 1), if hurt then C.Bad else nil)
	setBar(rivalFill, rivalHpText, num(opp.hp, 0), num(opp.maxHp, 1), if landed then Color3.new(1, 1, 1) else nil)
	if you.score ~= nil then
		setScore(num(you.score, shownScore), num(you.combo, 0))
	end
	local word = RESULT_WORDS[opp.result] or "MISS"
	oppResult.Text = "Opponent: " .. word
	oppResult.TextColor3 = if opp.result == "perfect" then C.Gold elseif opp.result == "hit" then W.Cream else C.Bad
	oppResult.TextTransparency = 0
	Kit.pop(oppResult, 1.2)
	if p.suddenDeath == true then
		showBanner("SUDDEN DEATH!", "Next hit wins!", C.Bad, 1.6)
		Sounds.play("Ready")
	end
end

local function setRival(info: any)
	if type(info) ~= "table" then
		return
	end
	rivalName.Text = tostring(info.name or "Rival")
	local hpMax = math.max(num(info.maxHp, 1), 1)
	local hp = num(info.hp, hpMax)
	rivalFill.Size = UDim2.fromScale(math.clamp(hp / hpMax, 0, 1), 1)
	rivalHpText.Text = string.format("%d/%d", hp, hpMax)
end

function showBanner(title: string, sub: string?, color: Color3, hold: number)
	bannerToken += 1
	local mine = bannerToken
	bannerTitle.Text = title
	bannerTitle.TextColor3 = color
	bannerSub.Text = sub or ""
	bannerSub.Visible = sub ~= nil
	banner.Visible = true
	Kit.appear(banner, { from = 0.4, time = 0.3 })
	task.delay(hold, function()
		if bannerToken == mine then
			Kit.disappear(banner)
		end
	end)
end

-- Picker and queue ---------------------------------------------------------------------------

local function hideQueue()
	queueToken += 1
	queued = false
	if queuePanel.Visible then
		Kit.disappear(queuePanel)
	end
end

-- "FINDING OPPONENT…": the spinner turns, the dots count and the seconds tick (from the
-- server's `since`, a workspace:GetServerTimeNow() stamp) until the queue ends.
local function showQueue(p: any)
	queueToken += 1
	queued = true
	local mine = queueToken
	local now = Workspace:GetServerTimeNow()
	local since = num(p.since, now)
	if since > now + 5 or since < now - 600 then
		since = now -- not a server-clock stamp: count from now
	end
	local timeout = num(p.timeout, 0)
	queuePanel.Visible = true
	Kit.appear(queuePanel, { from = 0.7, time = 0.25 })
	task.spawn(function()
		while queueToken == mine do
			local t = Workspace:GetServerTimeNow()
			local elapsed = math.max(0, math.floor(t - since))
			queueTitle.Text = "FINDING OPPONENT" .. string.rep(".", 1 + math.floor(t * 2) % 3)
			queueTime.Text = if timeout > 0
				then string.format("%ds  ·  up to %ds", elapsed, math.ceil(timeout))
				else string.format("%ds", elapsed)
			queueSpinner.Rotation = (t * 360) % 360
			task.wait()
		end
	end)
end

function MogHud.choose()
	if queued then
		-- Already waiting for a duel: point at the queue panel instead of a second picker.
		Kit.pop(queuePanel, 1.15)
		return
	end
	if choosing or active then
		return
	end
	choosing = true
	Popups.mogChoose(function()
		action:FireServer({ action = "ModeStart", mode = "mog", vs = "rivals" })
	end, function()
		action:FireServer({ action = "ModeStart", mode = "mog", vs = "pvp" })
	end, function()
		choosing = false
	end)
end

-- Show / hide -------------------------------------------------------------------------------

local function bind()
	ContextActionService:BindActionAtPriority(
		ACTION,
		onAction,
		false,
		PRIORITY,
		Enum.KeyCode.Space,
		Enum.KeyCode.Return,
		Enum.KeyCode.ButtonA
	)
	-- Gamepad quit: Y (or B) presses the quit button (arm, then confirm).
	ContextActionService:BindActionAtPriority(QUIT_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			quitPress()
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, Enum.KeyCode.ButtonY, Enum.KeyCode.ButtonB)
	if not stepConn then
		stepConn = RunService.RenderStepped:Connect(step)
	end
end

local function unbind()
	ContextActionService:UnbindAction(ACTION)
	ContextActionService:UnbindAction(QUIT_ACTION)
	if stepConn then
		stepConn:Disconnect()
		stepConn = nil
	end
end

local function hide()
	active = false
	unbind()
	check = nil
	hideQueue()
	if screen then
		screen:SetAttribute("RunActive", false)
	end
	if root.Visible then
		Kit.disappear(root)
	end
	banner.Visible = false
end

local function onStart(p: any)
	hideQueue()
	active, passedShown, quitArmed = true, false, false
	pvp = p.vs == "pvp"
	shownScore = num(p.score, 0)
	scoreLabel.Text = Format.short(shownScore)
	comboChip.Visible = false
	Kit.setButton(quitButton, quitLabel(), C.SurfaceHi)
	quitButton.Size = UDim2.fromOffset(30, 28)
	heartsRow.Visible = not pvp
	youPanel.Visible = pvp
	oppResult.TextTransparency = 1
	if pvp then
		setBar(youFill, youHpText, num(p.hp, 8), num(p.maxHp, 8))
		setRival(p.opponent)
	else
		lives = num(p.lives, 3)
		setHearts(lives, num(p.maxLives, lives), false)
		setRival(p.rival)
	end
	setIdle()
	root.Visible = true
	Kit.appear(root, { from = 0.6, time = 0.3 })
	tapHint.Visible = Kit.touch
	if screen then
		-- Tells Tutorial to step aside, like a Parkour run.
		screen:SetAttribute("RunActive", true)
	end
	bind()
	Sounds.play("Ready")
	if pvp then
		local foe = type(p.opponent) == "table" and p.opponent.name
		showBanner("1v1 DUEL!", "vs " .. tostring(foe or "Opponent"), C.Gold, 2)
	else
		local best = num(p.best, 0)
		showBanner("MOG TEST!", if best > 0 then "Best " .. Format.short(best) else "Hit the zone to mog!", C.Gold, 1.8)
	end
end

function MogHud.onNotify(p: any)
	if not screen or type(p) ~= "table" then
		return
	end
	local event: string = tostring(p.event)
	local ending = event == "finish" or event == "stop"
	if event == "choose" then
		MogHud.choose()
		return
	elseif event == "queue" then
		showQueue(p)
		return
	elseif event == "start" then
		onStart(p)
	elseif not active and not ending then
		return
	elseif event == "check" then
		onCheck(p)
	elseif event == "result" then
		onResult(p)
	elseif event == "round" then
		onRound(p)
	elseif event == "rival" then
		local passedNow = p.passed == true and not passedShown
		if passedNow then
			passedShown = true
			local cash = num(p.cash, 0)
			showBanner("MOG TEST PASSED!", if cash > 0 then "+" .. Format.money(cash) else "Keep mogging!", C.Gold, 2.4)
		else
			local mogged = type(p.mogged) == "table" and p.mogged.name
			showBanner("MOGGED!", if mogged then tostring(mogged) .. " is out!" else nil, W.Cream, 1.5)
		end
		task.delay(0.9, function()
			if active then
				setRival(p.rival)
				Kit.pop(rivalName, 1.2)
			end
		end)
	elseif event == "finish" then
		local wasActive = active
		local duel = p.vs == "pvp"
		hide()
		if wasActive or p.score ~= nil then
			Popups.mogFinish(p, function()
				action:FireServer({ action = "ModeStart", mode = "mog", vs = if duel then "pvp" else "rivals" })
			end, function()
				action:FireServer({ action = "Home" })
			end)
		end
	elseif event == "stop" then
		local wasActive = active
		hide()
		if p.reason == "noOpponent" then
			Popups.toast("No one to duel right now — try VS RIVALS!", "info")
			MogHud.choose()
		elseif wasActive and p.reason == "quit" then
			Popups.toast("Mog test ended", "info")
		end
	end
end

-- Build -------------------------------------------------------------------------------------

function MogHud.build(screenGui: ScreenGui)
	screen = screenGui
	root = Kit.new("Frame", {
		Name = "MogHud",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 410),
		Position = UDim2.new(1, -36, 0.5, 6),
		AnchorPoint = Vector2.new(1, 0.5),
		Visible = false,
		ZIndex = 20,
		Parent = screenGui,
	})

	-- Score panel with the quiet quit button on its right end.
	local scorePanel = Kit.panel(root, {
		Name = "Score",
		Size = UDim2.fromOffset(200, 44),
		Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Radius = 22,
	})
	Kit.icon(scorePanel, "Star", 26, C.Gold, { Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 3 })
	scoreLabel = Kit.number(scorePanel, {
		Name = "Value",
		Text = "0",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -84, 1, 0),
		Position = UDim2.fromOffset(42, 0),
		ZIndex = 3,
	})
	quitButton = Kit.button(scorePanel, {
		Name = "Quit",
		Text = "X",
		Color = C.SurfaceHi,
		TextSize = 14,
		Size = UDim2.fromOffset(30, 28),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Radius = 14,
		Depth = 2,
		ZIndex = 4,
	}, function()
		quitPress()
	end)
	Kit.selectable(quitButton)
	-- The X reads 30 x 28; on touch it takes taps over 48 px.
	local quitHit = Kit.hitArea(quitButton, 48, function()
		Kit.sound("Click")
		quitPress()
	end)
	quitHit.Visible = Kit.touch
	Kit.onInput(function()
		quitHit.Visible = Kit.touch
		if active then
			tapHint.Visible = Kit.touch
			if centreHint == "idle" then
				ring:setCentre(Kit.keyHint("confirm"), C.TextDim)
			elseif centreHint == "check" then
				ring:setCentre(Kit.keyHint("confirm") .. (if Kit.touch then "!" else ""), C.Gold)
			end
		end
	end)
	quitPress = function()
		if quitArmed then
			quitArmed = false
			action:FireServer({ action = "ModeQuit" })
			return
		end
		-- First tap arms it: "QUIT?" for a few seconds.
		quitArmed = true
		Kit.setButton(quitButton, "QUIT?", C.Bad)
		Kit.tween(quitButton, 0.2, { Size = UDim2.fromOffset(64, 28) }, Enum.EasingStyle.Back)
		task.delay(3, function()
			if quitArmed then
				quitArmed = false
				Kit.setButton(quitButton, quitLabel(), C.SurfaceHi)
				Kit.tween(quitButton, 0.2, { Size = UDim2.fromOffset(30, 28) })
			end
		end)
	end
	comboChip = Kit.text(root, {
		Name = "Combo",
		Text = "x2 COMBO",
		Font = F.Display,
		TextSize = 16,
		TextWrapped = false,
		TextColor3 = C.GoldInk,
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(110, 26),
		Position = UDim2.new(0.5, 0, 0, 50),
		AnchorPoint = Vector2.new(0.5, 0),
		StrokeThickness = 0,
		Visible = false,
		ZIndex = 3,
	})
	Kit.round(comboChip)

	heartsRow = Kit.new("Frame", {
		Name = "Hearts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(240, 28),
		Position = UDim2.new(0.5, 0, 0, 82),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = root,
	})
	Kit.list(heartsRow, 6, true, Enum.HorizontalAlignment.Center)

	-- In a duel the hearts give way to your own HP bar: "YOU", a green bar, "hp/max".
	youPanel = Kit.new("Frame", {
		Name = "You",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(240, 28),
		Position = UDim2.new(0.5, 0, 0, 82),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		Parent = root,
	})
	Kit.text(youPanel, {
		Name = "Label",
		Text = "YOU",
		Font = F.Display,
		TextSize = 18,
		TextWrapped = false,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0, 44, 1, 0),
		ZIndex = 3,
	})
	local youTrack = Kit.new("Frame", {
		Name = "Bar",
		BackgroundColor3 = C.Well,
		Size = UDim2.new(1, -104, 0, 18),
		Position = UDim2.new(0, 46, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
		Parent = youPanel,
	})
	Kit.round(youTrack)
	Kit.stroke(youTrack, 2, C.Gold)
	youFill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = C.Good,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = youTrack,
	})
	Kit.round(youFill)
	Kit.gradient(youFill, Color3.new(1, 1, 1), Kit.darken(Color3.new(1, 1, 1), 0.15), 90)
	youHpText = Kit.number(youPanel, {
		Name = "Hp",
		Text = "8/8",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(52, 28),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 3,
	})

	-- The ring (UI.MogRing draws it; the holder keeps the tap target and result label).
	local ringHolder = Kit.new("Frame", {
		Name = "RingHolder",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(RING, RING),
		Position = UDim2.new(0.5, 0, 0, 120),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = root,
	})
	ring = MogRing.new(ringHolder, RING)

	-- The tap target over the whole ring (mouse and touch).
	local hit = Kit.new("TextButton", {
		Name = "Tap",
		Text = "",
		BackgroundTransparency = 1,
		-- Gamepad presses with A (ContextActionService); the selection never lands here.
		Selectable = false,
		Size = UDim2.fromOffset(RING + 40, RING + 40),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 12,
		Parent = ringHolder,
	})
	hit.Activated:Connect(press)
	tapHint = Kit.text(ringHolder, {
		Name = "TapHint",
		Text = "TAP!",
		Font = F.Display,
		TextSize = 18,
		TextColor3 = C.Gold,
		Size = UDim2.fromOffset(80, 22),
		Position = UDim2.new(0, -10, 1, -6),
		AnchorPoint = Vector2.new(0, 1),
		Rotation = -12,
		Visible = false,
		ZIndex = 11,
	})
	resultLabel = Kit.number(ringHolder, {
		Name = "Result",
		Text = "",
		TextSize = 34,
		TextWrapped = false,
		Size = UDim2.fromOffset(260, 40),
		Position = RESULT_FROM,
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextTransparency = 1,
		ZIndex = 14,
	})
	Kit.new("UIScale", { Parent = resultLabel })

	-- The rival: name and HP bar under the ring.
	local rivalPanel = Kit.panel(root, {
		Name = "Rival",
		Size = UDim2.fromOffset(240, 58),
		Position = UDim2.new(0.5, 0, 0, 316),
		AnchorPoint = Vector2.new(0.5, 0),
		Radius = 16,
	})
	rivalName = Kit.text(rivalPanel, {
		Name = "Name",
		Text = "Rival",
		Font = F.Display,
		TextSize = 17,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -90, 0, 22),
		Position = UDim2.fromOffset(14, 5),
		ZIndex = 3,
	})
	rivalHpText = Kit.number(rivalPanel, {
		Name = "Hp",
		Text = "0/0",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(70, 22),
		Position = UDim2.new(1, -14, 0, 5),
		AnchorPoint = Vector2.new(1, 0),
		TextColor3 = C.TextDim,
		StrokeThickness = 0,
		ZIndex = 3,
	})
	local barTrack = Kit.new("Frame", {
		Name = "Bar",
		BackgroundColor3 = C.Well,
		Size = UDim2.new(1, -28, 0, 16),
		Position = UDim2.fromOffset(14, 32),
		ZIndex = 3,
		Parent = rivalPanel,
	})
	Kit.round(barTrack)
	rivalFill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = C.Bad,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
		Parent = barTrack,
	})
	Kit.round(rivalFill)
	Kit.gradient(rivalFill, Kit.lighten(C.Bad, 0.25), C.Bad, 90)

	-- The opponent's last result in a duel, small under their bar.
	oppResult = Kit.text(root, {
		Name = "OppResult",
		Text = "",
		Font = F.Display,
		TextSize = 16,
		TextWrapped = false,
		Size = UDim2.fromOffset(240, 22),
		Position = UDim2.new(0.5, 0, 0, 382),
		AnchorPoint = Vector2.new(0.5, 0),
		TextTransparency = 1,
		ZIndex = 3,
	})
	Kit.new("UIScale", { Parent = oppResult })

	-- "FINDING OPPONENT…" (right side, outside the run HUD: shown while root is hidden).
	queuePanel = Kit.panel(screenGui, {
		Name = "MogQueue",
		Size = UDim2.fromOffset(276, 124),
		Position = UDim2.new(1, -36, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Radius = 18,
		Visible = false,
		ZIndex = 20,
	})
	queueSpinner = Kit.new("Frame", {
		Name = "Spinner",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(48, 48),
		Position = UDim2.fromOffset(14, 10),
		ZIndex = 21,
		Parent = queuePanel,
	})
	-- A faint well disc behind the dots so the spinner reads as one badge.
	local spinnerWell = Kit.new("Frame", {
		Name = "Well",
		BackgroundColor3 = C.Well,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 21,
		Parent = queueSpinner,
	})
	Kit.round(spinnerWell)
	for i = 1, 10 do
		-- Ten dots round a circle, growing and brightening toward the head.
		local angle = i / 10 * math.pi * 2
		local size = 5 + math.floor(i / 2)
		local dot = Kit.new("Frame", {
			BackgroundColor3 = C.Gold,
			BackgroundTransparency = (10 - i) / 12,
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.new(0.5, math.sin(angle) * 16, 0.5, -math.cos(angle) * 16),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 22,
			Parent = queueSpinner,
		})
		Kit.round(dot)
	end
	queueTitle = Kit.text(queuePanel, {
		Name = "Title",
		Text = "FINDING OPPONENT...",
		Font = F.Display,
		TextSize = 17,
		TextWrapped = false,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -84, 0, 22),
		Position = UDim2.fromOffset(72, 12),
		ZIndex = 21,
	})
	queueTime = Kit.text(queuePanel, {
		Name = "Time",
		Text = "0s",
		TextSize = 15,
		TextWrapped = false,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -84, 0, 20),
		Position = UDim2.fromOffset(72, 36),
		StrokeThickness = 0,
		ZIndex = 21,
	})
	-- The same slim secondary button as Popups' "Back to my gym".
	Kit.button(queuePanel, {
		Name = "Cancel",
		Text = "Cancel",
		Color = C.SurfaceHi,
		TextSize = Kit.TEXT.Body,
		Size = UDim2.new(1, -28, 0, 42),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 22,
	}, function()
		action:FireServer({ action = "MogCancel" })
		hideQueue()
	end)

	-- Banner (top centre, under the unit count).
	banner = Kit.new("Frame", {
		Name = "MogBanner",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(560, 90),
		Position = UDim2.new(0.5, 0, 0, 96),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		ZIndex = 30,
		Parent = screenGui,
	})
	bannerTitle = Kit.title(banner, {
		Text = "MOGGED!",
		TextSize = 48,
		TextWrapped = false,
		Size = UDim2.new(1, 0, 0, 56),
		ZIndex = 31,
	})
	bannerSub = Kit.text(banner, {
		Text = "",
		Font = F.Display,
		TextSize = 22,
		TextColor3 = C.MoneyText,
		Size = UDim2.new(1, 0, 0, 28),
		Position = UDim2.fromOffset(0, 58),
		ZIndex = 31,
	})
end

return MogHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">MogRing</string>
              <string name="Source"><![CDATA[--!strict
--[[
	MogRing: the visuals of the MOG TEST skill-check ring (MogHud owns the logic and input).

	  local ring = MogRing.new(parent, 180)   -- diameter in px
	  ring.frame / ring.scale                  -- root Frame (centred in parent) and its UIScale
	  ring:setCheck(c)    c = { zoneStart, zoneSize, perfectSize, dir, n }: draws the zone, swells in, hides the needle
	  ring:warn(now)      every frame before the needle starts: soft breathing gold halo
	  ring:setNeedle(travel?, dir)   every frame while running (nil hides the needle)
	  ring:setCentre(text, color)
	  ring:flash("perfect" | "hit" | "miss")
	  ring:idle()         between checks: no zone, no needle, small and dim
	  ring:destroy()

	Textures (art/blender/ui/mog_ring.py -> hud/MogRing*): an anti-aliased base (shadow, thick gold rim, bright
	blue track with bold 30-degree ticks, centre plate), white tintable layers (halo, rim flash, zone band and
	its wider perfect slice, both with a baked dark outline that takes the tint's hue; glow, edge ticks, trail,
	burst) and a full-colour needle (gold hub at the plate edge, outlined red hand reaching past the rim).

	Arcs: MogRingArc is the zone band's RIGHT half only (0..180 deg clockwise from 12 o'clock). Rotating the
	ImageLabel by `a` puts that half at screen angles [a, a + 180]; a UIGradient (rotates with the image) with a
	hard transparency step at 0.5 and Rotation = span keeps only image angles [0, span] (it hides the half-plane
	on the gradient's far side, whose boundary is the radial line at image angle span). Travel [t0, t1] maps to
	screen angles dir * travel, so dir = 1 starts at a = t0 and dir = -1 at a = -t1; both cover exactly span
	degrees, so the zone stays exact to the degree. Spans over 180 use two pieces.

	Without the image ids (not uploaded yet) the ring falls back to the old frame drawing: UICorner discs and
	a zone made of thin rotated segments.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(ReplicatedStorage:WaitForChild("Theme")) :: any
local Kit = require(script.Parent.Kit) :: any

local C = Kit.C
local W = Theme.World

local DESIGN = 180 -- design diameter: the geometry below is in px of a 180 px ring
local CANVAS = 1.2 -- most textures cover 1.2 x the ring
local HALO_CANVAS = 1.5
local TRACK_OUT = 79 -- fallback drawing: track, plate and zone radii (match art/blender/ui/mog_ring.py)
local PLATE = 49
local BAND_OUT, BAND_IN = 79.5, 49.5
local WIDE_OUT, WIDE_IN = 84.5, 45.5 -- the raised perfect slice
local TRAIL_SPAN = 28 -- degrees of motion trail behind the needle
local SEGMENT = 2 -- fallback zone segment (degrees)
local WHITE = Color3.new(1, 1, 1)
local PERFECT = Color3.fromRGB(255, 210, 31) -- fallback perfect slice (the texture one is full colour)
local GLOW = 0.2 -- perfect-slice glow transparency at rest (a perfect flash pops it to 0)
local DIM = Color3.fromRGB(226, 230, 240) -- base tint while idle (light: the gold rim stays gold)
local ZONE = Color3.fromRGB(56, 232, 120) -- saturated green zone band (its baked outline takes this hue)

local Assets = (function(): any
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local module = shared and shared:FindFirstChild("Assets")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return nil
end)()

local KEYS = { "Base", "Halo", "Flash", "Arc", "ArcWide", "ArcGlow", "Edge", "Needle", "TrailL", "TrailR", "Burst" }
local ids: { [string]: string } = {}
local complete = true
do
	local images = if Assets and type(Assets.Images) == "table" then Assets.Images else {}
	for _, key in KEYS do
		local id = images["hud/MogRing" .. key]
		if type(id) == "string" and id ~= "" then
			ids[key] = id
		else
			complete = false
		end
	end
end

-- Transparency steps across the gradient's middle: opaque on the near side, clear on the far side.
local HARD = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.4995, 0),
	NumberSequenceKeypoint.new(0.5005, 1),
	NumberSequenceKeypoint.new(1, 1),
})
local SOFT = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.475, 0),
	NumberSequenceKeypoint.new(0.525, 1),
	NumberSequenceKeypoint.new(1, 1),
})

export type Check = { zoneStart: number, zoneSize: number, perfectSize: number, dir: number, n: number? }

local MogRing = {}
MogRing.__index = MogRing

export type MogRing = typeof(setmetatable(
	{} :: {
		frame: Frame,
		scale: UIScale,
		size: number,
		images: boolean,
		base: GuiObject,
		halo: GuiObject,
		flashLayer: GuiObject?,
		zone: Frame,
		perfect: { ImageLabel },
		needle: GuiObject,
		trails: { [number]: ImageLabel },
		trailCut: { [number]: UIGradient },
		centre: TextLabel,
		running: boolean,
		lastTravel: number?,
		trailFading: boolean,
		haloTween: Tween?,
	},
	MogRing
))

local function centred(props: { [string]: any }): { [string]: any }
	props.BackgroundTransparency = if props.BackgroundTransparency == nil then 1 else props.BackgroundTransparency
	props.BorderSizePixel = 0
	props.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	props.AnchorPoint = Vector2.new(0.5, 0.5)
	return props
end

local function image(parent: Instance, key: string, scale: number, z: number, props: { [string]: any }?): ImageLabel
	local p = centred(props or {})
	p.Name = p.Name or key
	p.Image = ids[key]
	p.Size = UDim2.fromScale(scale, scale)
	p.ZIndex = z
	p.Parent = parent
	return Kit.new("ImageLabel", p)
end

-- Colour / transparency of either an ImageLabel (texture mode) or a Frame (fallback).
local function colourProp(obj: GuiObject): string
	return if obj:IsA("ImageLabel") then "ImageColor3" else "BackgroundColor3"
end
local function alphaProp(obj: GuiObject): string
	return if obj:IsA("ImageLabel") then "ImageTransparency" else "BackgroundTransparency"
end

-- Texture mode --------------------------------------------------------------------------------

-- One arc piece: the half band rotated to screen angle `a`, cut to `span` (0 < span <= 180) degrees.
local function arcPiece(
	parent: Instance,
	key: string,
	a: number,
	span: number,
	color: Color3,
	alpha: number,
	z: number,
	cut: NumberSequence
): ImageLabel
	local piece = image(parent, key, CANVAS, z, { Rotation = a, ImageColor3 = color, ImageTransparency = alpha })
	Kit.new("UIGradient", { Rotation = span, Transparency = cut, Parent = piece })
	return piece
end

-- Pieces covering travel [t0, t1] on the side `dir` points to.
local function arcImages(
	parent: Instance,
	key: string,
	t0: number,
	t1: number,
	dir: number,
	color: Color3,
	alpha: number,
	z: number,
	cut: NumberSequence
): { ImageLabel }
	local pieces = {}
	local span = t1 - t0
	local a = if dir == 1 then t0 else -t1
	while span > 1e-3 do
		local part = math.min(span, 180)
		table.insert(pieces, arcPiece(parent, key, a, part, color, alpha, z, cut))
		a += part
		span -= part
	end
	return pieces
end

-- Fallback mode -------------------------------------------------------------------------------

local function segment(parent: Instance, k: number, a: number, b: number, color: Color3, z: number, wide: boolean?)
	local mid = math.rad((a + b) / 2)
	local outer, inner = if wide then WIDE_OUT else BAND_OUT, if wide then WIDE_IN else BAND_IN
	local radius = k * (outer + inner) / 2
	local width = 2 * math.pi * radius * math.abs(b - a) / 360 + 1.2 -- slight overlap: no seams
	Kit.new("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(width, k * (outer - inner)),
		Position = UDim2.new(0.5, math.sin(mid) * radius, 0.5, -math.cos(mid) * radius),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = math.deg(mid),
		ZIndex = z,
		Parent = parent,
	})
end

local function arcFrames(parent: Instance, k: number, t0: number, t1: number, dir: number, color: Color3, z: number, wide: boolean?)
	if t1 <= t0 then
		return
	end
	local count = math.max(1, math.ceil((t1 - t0) / SEGMENT))
	local step = (t1 - t0) / count
	for i = 0, count - 1 do
		local a, b = t0 + i * step, t0 + (i + 1) * step
		segment(parent, k, dir * a, dir * b, color, z, wide)
	end
end

local function disc(parent: Instance, name: string, scale: number, color: Color3, z: number, alpha: number?): Frame
	local frame = Kit.new(
		"Frame",
		centred({
			Name = name,
			BackgroundColor3 = color,
			BackgroundTransparency = alpha or 0,
			Size = UDim2.fromScale(scale, scale),
			ZIndex = z,
			Parent = parent,
		})
	)
	Kit.round(frame)
	return frame
end

-- Build ---------------------------------------------------------------------------------------

function MogRing.new(parent: GuiObject, size: number): MogRing
	local k = size / DESIGN
	local frame = Kit.new(
		"Frame",
		centred({
			Name = "MogRing",
			Size = UDim2.fromOffset(size, size),
			Parent = parent,
		})
	)
	local scale = Kit.new("UIScale", { Parent = frame })
	local self = setmetatable({
		frame = frame,
		scale = scale,
		size = size,
		images = complete,
		perfect = {},
		trails = {},
		trailCut = {},
		running = false,
		lastTravel = nil,
		trailFading = false,
		haloTween = nil,
	}, MogRing) :: any

	if complete then
		self.halo = image(frame, "Halo", HALO_CANVAS, 1, { ImageColor3 = C.Gold, ImageTransparency = 1 })
		self.base = image(frame, "Base", CANVAS, 2)
		self.zone = Kit.new("Frame", centred({ Name = "Zone", Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = frame }))
		for _, dir in { 1, -1 } do
			local trail = image(frame, if dir == 1 then "TrailL" else "TrailR", CANVAS, 7, { Visible = false, ImageColor3 = C.GoldLight })
			self.trails[dir] = trail
			self.trailCut[dir] = Kit.new("UIGradient", { Transparency = HARD, Parent = trail })
		end
		self.flashLayer = image(frame, "Flash", CANVAS, 8, { ImageTransparency = 1 })
		self.needle = image(frame, "Needle", CANVAS, 9, { Visible = false })
	else
		self.halo = disc(frame, "Glow", (size + 28) / size, C.Gold, 1, 1)
		local rim = disc(frame, "Rim", 1, C.Gold, 2)
		Kit.stroke(rim, 2, Color3.fromRGB(150, 92, 18))
		Kit.shadow(rim, size // 2, 0.35, 4)
		self.base = rim
		disc(frame, "Track", (TRACK_OUT * 2 + 2) / DESIGN, Color3.fromRGB(86, 126, 230), 3)
		self.zone = Kit.new("Frame", centred({ Name = "Zone", Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = frame }))
		local plate = disc(frame, "Plate", (PLATE * 2 - 4) / DESIGN, C.Surface, 7)
		Kit.stroke(plate, 3, C.Edge)
		local needle =
			Kit.new("Frame", centred({ Name = "Needle", Size = UDim2.fromScale(1, 1), ZIndex = 9, Visible = false, Parent = frame }))
		local bar = Kit.new("Frame", {
			Name = "Bar",
			BackgroundColor3 = C.Bad,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(9 * k, (104 - PLATE + 7) * k),
			Position = UDim2.new(0.5, 0, 0.5, -(PLATE - 7) * k),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 9,
			Parent = needle,
		})
		Kit.round(bar)
		Kit.stroke(bar, 2, Color3.fromRGB(24, 30, 72))
		self.needle = needle
	end

	self.centre = Kit.number(frame, {
		Name = "Centre",
		Text = if Kit.touch then "TAP" else "SPACE",
		TextSize = math.floor(26 * k + 0.5),
		TextWrapped = false,
		TextColor3 = C.TextDim,
		Size = UDim2.fromScale(0.56, 0.4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 10,
	})
	return self :: MogRing
end

-- Halo ----------------------------------------------------------------------------------------

local function haloTo(self: MogRing, color: Color3?, from: number?, to: number, time: number)
	if self.haloTween then
		self.haloTween:Cancel()
		self.haloTween = nil
	end
	local halo = self.halo
	if color then
		(halo :: any)[colourProp(halo)] = color
	end
	if from then
		(halo :: any)[alphaProp(halo)] = from
	end
	if time <= 0 then
		(halo :: any)[alphaProp(halo)] = to
	else
		self.haloTween = Kit.tween(halo, time, { [alphaProp(halo)] = to }, Enum.EasingStyle.Quad)
	end
end

-- Zone ----------------------------------------------------------------------------------------

local function clearZone(self: MogRing)
	self.zone:ClearAllChildren()
	table.clear(self.perfect)
end

function MogRing.setCheck(self: MogRing, c: Check)
	clearZone(self)
	local dir = if c.dir == -1 then -1 else 1
	local zoneStart = math.clamp(c.zoneStart, 0, 360)
	local zoneEnd = math.min(zoneStart + math.max(c.zoneSize, 0), 360)
	local perfectEnd = math.min(zoneStart + math.max(c.perfectSize, 0), zoneEnd)
	if self.images then
		-- The green band covers the whole zone; the raised full-colour gold perfect slice lies on its start, with
		-- its glow underneath (it shows round the slice, not over the band) and a white divider at the hand-off.
		arcImages(self.zone, "Arc", zoneStart, zoneEnd, dir, ZONE, 0, 4, HARD)
		if perfectEnd > zoneStart then
			self.perfect = arcImages(self.zone, "ArcGlow", zoneStart, perfectEnd, dir, C.GoldLight, GLOW, 3, SOFT)
			arcImages(self.zone, "ArcWide", zoneStart, perfectEnd, dir, WHITE, 0, 5, HARD)
			image(self.zone, "Edge", CANVAS, 6, { Rotation = dir * perfectEnd, ImageColor3 = WHITE })
		end
		image(self.zone, "Edge", CANVAS, 6, { Rotation = dir * zoneStart, ImageColor3 = C.GoldLight })
		image(self.zone, "Edge", CANVAS, 6, { Rotation = dir * zoneEnd, ImageColor3 = WHITE })
		Kit.tween(self.base, 0.2, { ImageColor3 = WHITE })
	else
		local k = self.size / DESIGN
		arcFrames(self.zone, k, perfectEnd, zoneEnd, dir, ZONE, 4)
		arcFrames(self.zone, k, zoneStart, perfectEnd, dir, PERFECT, 5, true)
		for _, t in { zoneStart, zoneEnd } do
			segment(self.zone, k, dir * t - 0.6, dir * t + 0.6, C.GoldLight, 6)
		end
	end
	self:setNeedle(nil, dir)
	haloTo(self, nil, nil, 1, 0)
	-- The swell-in cue.
	self.scale.Scale = 0.7
	Kit.tween(self.scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	self:_burst(W.Cream)
end

function MogRing.warn(self: MogRing, now: number)
	if self.haloTween then
		self.haloTween:Cancel()
		self.haloTween = nil
	end
	local halo = self.halo;
	(halo :: any)[colourProp(halo)] = C.Gold;
	(halo :: any)[alphaProp(halo)] = 0.3 + 0.25 * math.cos(now * 12)
end

-- Needle --------------------------------------------------------------------------------------

function MogRing.setNeedle(self: MogRing, travel: number?, dir: number)
	local d = if dir == -1 then -1 else 1
	if travel == nil then
		self.needle.Visible = false
		for _, trail in self.trails do
			trail.Visible = false
		end
		self.running, self.lastTravel, self.trailFading = false, nil, false
		return
	end
	if not self.running then
		self.running = true
		haloTo(self, nil, nil, 1, 0.15)
	end
	self.needle.Visible = true
	self.needle.Rotation = d * travel
	local trail = self.trails[d]
	if trail then
		local other = self.trails[-d]
		if other then
			other.Visible = false
		end
		local shown = math.clamp(travel, 0, TRAIL_SPAN)
		trail.Visible = shown > 0.5
		trail.Rotation = d * travel
		-- Hide the part of the trail that would reach back past 12 o'clock (the start of travel).
		self.trailCut[d].Rotation = if d == 1 then 180 - shown else shown
		local last = self.lastTravel
		if last ~= nil and math.abs(travel - last) < 1e-3 then
			-- Frozen (pressed or judged): the streak fades out once.
			if not self.trailFading then
				self.trailFading = true
				Kit.tween(trail, 0.2, { ImageTransparency = 1 })
			end
		elseif self.trailFading or last == nil then
			self.trailFading = false
			trail.ImageTransparency = 0.1
		end
	end
	self.lastTravel = travel
end

function MogRing.setCentre(self: MogRing, text: string, color: Color3)
	self.centre.Text = text
	self.centre.TextColor3 = color
end

-- Results -------------------------------------------------------------------------------------

function MogRing._burst(self: MogRing, color: Color3)
	if self.images then
		local wave = image(self.frame, "Burst", 1, 1, { Name = "Burst", ImageColor3 = color })
		Kit.tween(wave, 0.5, { Size = UDim2.fromScale(1.7, 1.7), ImageTransparency = 1 }, Enum.EasingStyle.Quart)
		task.delay(0.55, function()
			wave:Destroy()
		end)
		return
	end
	local wave = Kit.new("Frame", centred({ Name = "Burst", Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = self.frame }))
	Kit.round(wave)
	local stroke = Kit.stroke(wave, 10, color)
	Kit.tween(wave, 0.5, { Size = UDim2.fromScale(1.7, 1.7) }, Enum.EasingStyle.Quart)
	Kit.tween(stroke, 0.5, { Transparency = 1, Thickness = 2 }, Enum.EasingStyle.Quart)
	task.delay(0.55, function()
		wave:Destroy()
	end)
end

function MogRing.flash(self: MogRing, kind: string)
	local color = if kind == "perfect" then C.Gold elseif kind == "hit" then W.Cream else C.Bad
	local flashLayer = self.flashLayer
	if flashLayer then
		local layer = flashLayer :: ImageLabel
		layer.ImageColor3 = if kind == "hit" then WHITE elseif kind == "perfect" then C.GoldLight else color
		layer.ImageTransparency = 0
		Kit.tween(layer, 0.6, { ImageTransparency = 1 })
	else
		local rim = self.base :: Frame
		rim.BackgroundColor3 = if kind == "hit" then WHITE else color
		Kit.tween(rim, 0.6, { BackgroundColor3 = C.Gold })
	end
	haloTo(self, color, if kind == "miss" then 0.35 else 0.1, 1, 0.7)
	if kind == "perfect" then
		for _, glow in self.perfect do
			glow.ImageColor3 = WHITE
			glow.ImageTransparency = 0
			Kit.tween(glow, 0.45, { ImageColor3 = C.GoldLight, ImageTransparency = GLOW })
		end
	end
	self:_burst(color)
end

function MogRing.idle(self: MogRing)
	clearZone(self)
	self:setNeedle(nil, 1)
	Kit.tween(self.scale, 0.3, { Scale = 0.86 })
	haloTo(self, nil, nil, 1, 0.3)
	if self.images then
		Kit.tween(self.base, 0.3, { ImageColor3 = DIM })
	end
end

function MogRing.destroy(self: MogRing)
	if self.haloTween then
		self.haloTween:Cancel()
	end
	self.frame:Destroy()
end

return MogRing
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">ObbyHud</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ObbyHud: the sky obby's run HUD (docs/sky-obby.md, Client), styled like a classic
	rainbow obby. Shown while the local player is on a parkour run (Main calls show on the
	run's start Notify) and hidden on finish / stop / invalid (Main calls hide).

	  Bar       top centre (y 14, 46% of the width): a chunky rainbow bar (UIGradient) with
	            a trophy at its end; the stretch past the local player is dimmed. Every
	            player with a ParkourStage attribute above 0 rides its top edge as a round
	            avatar head (Players:GetUserThumbnailAsync HeadShot 48 px, cached per user)
	            at ParkourStage / stageCount; the local head sits on top with a white caret
	            under the bar. Attributes are followed live (PlayerAdded / Removing too).
	  Row       one line under the bar: Hud's run pill (docked through deps.dockRun) on the
	            left, "STAGE n / N" in the centre, SKIP STAGE (pink, with a coin and the cash cost from
	            State.data.modes.parkour.skipCost, refreshed on State.changed; fires
	            ParkourSkip) on the right.
	  Gear      a 3-slot hotbar 8 px above the dumbbell (deps.tank): Speed, Jump and Gravity
	            coils with key badges 1 / 2 / 3. Keys or a tap toggle; the chosen slot is
	            outlined gold; tapping it again picks "none". Fires ParkourGear { gear } and
	            follows State.data.modes.parkour.gear.

	Phones (viewport under 700 px wide): the bar takes 70% of the width and the row wraps to
	two lines (timer + stage, then skip). Every engine call that the Lune preview cannot run
	(thumbnails, AbsoluteSize) is wrapped in pcall.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Format = require(ReplicatedStorage.Shared.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)

local C = Kit.C
local F = Kit.F
local World = (Kit.Theme :: any).World

local ObbyHud = {}

-- Filled in by build(); safe no-ops before that.
ObbyHud.show = function(_stage: number?, _stageCount: number?) end
ObbyHud.setStage = function(_stage: number?, _stageCount: number?) end
ObbyHud.hide = function() end
ObbyHud.isShown = function(): boolean
	return false
end

export type Deps = {
	sounds: any?,
	-- Hud.dockRun: moves the run pill into the row (nil puts it back).
	dockRun: ((UDim2?, Vector2?) -> ())?,
	-- Hud's dumbbell group: the hotbar rides 8 px above it.
	tank: GuiObject?,
}

-- Layout (design px, 1280x720).
local BAR_Y = 14
local BAR_H = 22
local BAR_FRACTION = 0.46
local BAR_FRACTION_PHONE = 0.7
local PHONE_PX = 700 -- viewport px
local HEAD = 40
local CARET_H = 12 -- the local caret under the bar
local ROW_Y = BAR_Y + BAR_H + CARET_H + 8 -- the row clears the heads and the caret
local ROW_H = 46
local ROW_GAP = 12
local RUN_W = 236 -- Hud's run pill
local STAGE_W = 190
local SKIP_W = 186
local SLOT = 66
local SLOT_GAP = 10
local HOTBAR_GAP = 8
local HOTBAR_BOTTOM = 129 -- fallback: Hud's dumbbell (264 * 448 / 1024 + 6) + 8

local RAINBOW_KEYS =
	{ "RainbowRed", "RainbowOrange", "RainbowYellow", "RainbowGreen", "RainbowCyan", "RainbowBlue", "RainbowPurple", "RainbowPink" }
local RAINBOW_FALLBACK = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 150, 50),
	Color3.fromRGB(255, 225, 60),
	Color3.fromRGB(90, 220, 100),
	Color3.fromRGB(70, 220, 230),
	Color3.fromRGB(70, 140, 255),
	Color3.fromRGB(170, 110, 255),
	Color3.fromRGB(255, 120, 200),
}
local WHITE = Color3.new(1, 1, 1)
local GOLD = C.Gold

type GearDef = { key: string, label: string, color: Color3, keyCode: Enum.KeyCode }
local GEARS: { GearDef } = {
	{ key = "speed", label = "SPEED", color = Color3.fromRGB(255, 80, 80), keyCode = Enum.KeyCode.One },
	{ key = "jump", label = "JUMP", color = Color3.fromRGB(90, 220, 100), keyCode = Enum.KeyCode.Two },
	{ key = "gravity", label = "GRAVITY", color = Color3.fromRGB(170, 110, 255), keyCode = Enum.KeyCode.Three },
}

local function rainbow(i: number): Color3
	local color = World and World[RAINBOW_KEYS[i]]
	return if typeof(color) == "Color3" then color else RAINBOW_FALLBACK[i]
end

-- The cash cost of a skip from the parkour snapshot (nil before the first snapshot).
local function skipCost(): number?
	local data = State.data
	local info = data and data.modes and data.modes.parkour
	return if type(info) == "table" then tonumber(info.skipCost) else nil
end

local function skipText(cost: number?): string
	return if cost then "SKIP STAGE  " .. Format.money(cost) else "SKIP STAGE"
end

-- The course's last stage from the world: Parkour folder's Levels and the last level
-- folder's StageLast (0 when the world is not there yet).
local function worldStageCount(): number
	local map = workspace:FindFirstChild("Map")
	local modes = map and map:FindFirstChild("GameModes")
	local parkour = modes and modes:FindFirstChild("Parkour")
	if not parkour then
		return 0
	end
	local best = 0
	local levels = tonumber(parkour:GetAttribute("Levels")) or 0
	local last = if levels > 0 then parkour:FindFirstChild("Level" .. levels) else nil
	if last then
		best = tonumber(last:GetAttribute("StageLast")) or 0
	end
	if best <= 0 then
		for _, child in parkour:GetChildren() do
			best = math.max(best, tonumber(child:GetAttribute("StageLast")) or 0)
		end
	end
	return best
end

-- Avatar headshots, fetched once per user (nil while loading or when unavailable).
local thumbs: { [number]: string } = {}
local pending: { [number]: { (string) -> () } } = {}
local function headshot(userId: number, onReady: (string) -> ())
	local cached = thumbs[userId]
	if cached then
		onReady(cached)
		return
	end
	if userId <= 0 then
		return -- Studio test players have no avatar
	end
	local waiting = pending[userId]
	if waiting then
		table.insert(waiting, onReady)
		return
	end
	pending[userId] = { onReady }
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		local callbacks: { (string) -> () } = pending[userId] or {}
		pending[userId] = nil
		if ok and type(image) == "string" and image ~= "" then
			thumbs[userId] = image
			for _, callback in callbacks do
				callback(image)
			end
		end
	end)
end

-- A coil spring glyph: a little grey handle over five overlapping rings in `color`.
local function coil(parent: Instance, color: Color3, size: number): Frame
	local root = Kit.new("Frame", {
		Name = "Coil",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
		Parent = parent,
	})
	local handle = Kit.new("Frame", {
		Name = "Handle",
		BackgroundColor3 = Color3.fromRGB(120, 128, 150),
		Size = UDim2.new(0.22, 0, 0.2, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
		Parent = root,
	})
	Kit.corner(handle, 3)
	local rings = 5
	for i = 1, rings do
		local ring = Kit.new("Frame", {
			Name = "Ring" .. i,
			BackgroundTransparency = 1,
			Size = UDim2.new(0.82, 0, 0.2, 0),
			Position = UDim2.new(0.5, 0, 0.16 + (i - 1) * 0.15, 0),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 4,
			Parent = root,
		})
		Kit.round(ring)
		Kit.new("UIStroke", {
			Thickness = 3.5,
			Color = if i % 2 == 0 then Kit.lighten(color, 0.25) else color,
			Parent = ring,
		})
	end
	return root
end

function ObbyHud.build(screen: ScreenGui, deps: Deps?)
	local dockRun = deps and deps.dockRun
	local tank = deps and deps.tank
	local action = Net.event("Action")
	local me = Players.LocalPlayer
	local shown = false
	local myStage = 0
	local stageCount = 0
	local cost = skipCost()

	local root = Kit.new("Frame", {
		Name = "ObbyHud",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = screen,
	})

	-- Bar --------------------------------------------------------------------------------
	local barHolder = Kit.new("Frame", {
		Name = "Bar",
		BackgroundTransparency = 1,
		Size = UDim2.new(BAR_FRACTION, 0, 0, BAR_H),
		Position = UDim2.new(0.5, 0, 0, BAR_Y),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = root,
	})
	local track = Kit.new("Frame", {
		Name = "Track",
		BackgroundColor3 = WHITE,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = barHolder,
	})
	Kit.round(track)
	Kit.new("UIStroke", { Thickness = 3, Color = C.Ink, Parent = track })
	local keypoints = {}
	for i = 1, #RAINBOW_KEYS do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (#RAINBOW_KEYS - 1), rainbow(i)))
	end
	Kit.new("UIGradient", { Color = ColorSequence.new(keypoints), Parent = track })
	-- A glossy top half.
	local gloss = Kit.new("Frame", {
		Name = "Gloss",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		Size = UDim2.new(1, -10, 0.36, 0),
		Position = UDim2.new(0.5, 0, 0, 2),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
		Parent = track,
	})
	Kit.round(gloss)
	-- The stretch still ahead of the local player, dimmed.
	local ahead = Kit.new("Frame", {
		Name = "Ahead",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.5,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 4,
		Parent = track,
	})
	Kit.round(ahead)
	-- Start dot and trophy.
	local startDot = Kit.new("Frame", {
		Name = "Start",
		BackgroundColor3 = WHITE,
		Size = UDim2.fromOffset(BAR_H + 6, BAR_H + 6),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		Parent = barHolder,
	})
	Kit.round(startDot)
	Kit.new("UIStroke", { Thickness = 3, Color = C.Ink, Parent = startDot })
	local trophyBack = Kit.new("Frame", {
		Name = "Trophy",
		BackgroundColor3 = GOLD,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(1, 8, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 6,
		Parent = barHolder,
	})
	Kit.round(trophyBack)
	Kit.new("UIStroke", { Thickness = 3, Color = C.Ink, Parent = trophyBack })
	Kit.gradient(trophyBack, Kit.lighten(GOLD, 0.3), GOLD)
	Kit.icon(trophyBack, "Ranking", 30, C.GoldInk, {
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 7,
	})

	-- Heads.
	type Head = { frame: Frame, image: ImageLabel, conn: RBXScriptConnection?, stage: number }
	local heads: { [Player]: Head } = {}
	local function headX(stage: number): number
		local total = if stageCount > 0 then stageCount else math.max(stage, 1)
		return math.clamp(stage / total, 0, 1)
	end
	local function makeHead(p: Player): Head
		local mine = p == me
		local size = HEAD
		local frame = Kit.new("Frame", {
			Name = "Head" .. p.UserId,
			BackgroundColor3 = Color3.fromRGB(205, 220, 245),
			Size = UDim2.fromOffset(size, size),
			Position = UDim2.new(0, 0, 1, 2),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = if mine then 12 else 8,
			Parent = barHolder,
		})
		Kit.round(frame)
		Kit.new("UIStroke", { Thickness = if mine then 3.5 else 2.5, Color = if mine then WHITE else C.Ink, Parent = frame })
		local initial = Kit.text(frame, {
			Name = "Initial",
			Text = string.upper(string.sub(p.DisplayName ~= "" and p.DisplayName or p.Name, 1, 1)),
			Font = F.Display,
			TextSize = math.floor(size * 0.5),
			TextColor3 = C.Ink,
			StrokeThickness = 0,
			ZIndex = frame.ZIndex + 1,
		})
		local image = Kit.new("ImageLabel", {
			Name = "Avatar",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Image = "",
			ZIndex = frame.ZIndex + 2,
			Parent = frame,
		})
		Kit.round(image)
		if mine then
			-- White caret under the local head (below the bar, above the row).
			local caret = Kit.text(frame, {
				Name = "Caret",
				Text = "▲",
				Font = F.Display,
				TextSize = 14,
				TextColor3 = WHITE,
				Size = UDim2.fromOffset(18, CARET_H),
				Position = UDim2.new(0.5, 0, 1, 0),
				AnchorPoint = Vector2.new(0.5, 0),
				ZIndex = frame.ZIndex + 3,
			})
			Kit.textStroke(caret, 2, 0)
		end
		headshot(p.UserId, function(id)
			if image.Parent then
				image.Image = id
				initial.Visible = false
			end
		end)
		return { frame = frame, image = image, conn = nil, stage = 0 }
	end

	local function placeHead(p: Player, stage: number, animate: boolean)
		local head = heads[p]
		if stage <= 0 and p ~= me then
			if head then
				head.frame.Visible = false
				head.stage = 0
			end
			return
		end
		if not head then
			head = makeHead(p)
			heads[p] = head
		end
		local h = head :: Head
		h.frame.Visible = true
		-- Bottoms just under the bar's bottom edge: the heads ride on top of it.
		local target = UDim2.new(headX(stage), 0, 1, 2)
		if animate and h.stage > 0 and shown then
			Kit.tween(h.frame, 0.45, { Position = target }, Enum.EasingStyle.Back)
		else
			h.frame.Position = target
		end
		h.stage = stage
	end

	local function stageOf(p: Player): number
		return tonumber(p:GetAttribute("ParkourStage")) or 0
	end

	-- Re-places every head (the stage count changed).
	local function placeAll()
		for _, p in Players:GetPlayers() do
			if p == me then
				placeHead(p, myStage, false)
			else
				placeHead(p, stageOf(p), false)
			end
		end
		ahead.Size = UDim2.fromScale(1 - headX(myStage), 1)
	end

	local watched: { [Player]: RBXScriptConnection } = {}
	local function watch(p: Player)
		if watched[p] or p == me then
			return
		end
		watched[p] = p:GetAttributeChangedSignal("ParkourStage"):Connect(function()
			placeHead(p, stageOf(p), true)
		end)
		placeHead(p, stageOf(p), false)
	end
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(p)
		local conn = watched[p]
		if conn then
			conn:Disconnect()
			watched[p] = nil
		end
		local head = heads[p]
		if head then
			head.frame:Destroy()
			heads[p] = nil
		end
	end)

	-- Counter and skip -----------------------------------------------------------------
	local counter = Kit.hudText(root, {
		Name = "Stage",
		Text = "STAGE 1",
		RichText = true,
		Font = F.Display,
		TextSize = 30,
		StrokeThickness = 3,
		Size = UDim2.fromOffset(STAGE_W, ROW_H),
		Position = UDim2.new(0.5, 0, 0, ROW_Y),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	local counterScale = Kit.new("UIScale", { Parent = counter })
	local skip = Kit.button(root, {
		Name = "Skip",
		Text = skipText(cost),
		Icon = "Coin",
		IconColor = C.MoneyText,
		Font = F.Display,
		Color = Color3.fromRGB(255, 95, 150),
		TextSize = 17,
		Size = UDim2.fromOffset(SKIP_W, ROW_H),
		Position = UDim2.new(0.5, STAGE_W / 2 + ROW_GAP, 0, ROW_Y),
	}, function()
		if not shown then
			return
		end
		action:FireServer({ action = "ParkourSkip" })
	end)

	local function renderCounter()
		local total = if stageCount > 0 then string.format(' <font size="18" transparency="0.25">/ %d</font>', stageCount) else ""
		counter.Text = string.format("STAGE %d%s", math.max(myStage, 1), total)
	end

	-- Gear hotbar --------------------------------------------------------------------------
	local hotbar = Kit.new("Frame", {
		Name = "Gear",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(SLOT * 3 + SLOT_GAP * 2, SLOT + 14),
		Position = UDim2.new(0.5, 0, 1, -HOTBAR_BOTTOM),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = root,
	})
	local chosen = "none"
	type Slot = { button: TextButton, stroke: UIStroke, scale: UIScale, def: GearDef }
	local slots: { Slot } = {}
	local function renderGear()
		for _, slot in slots do
			local on = slot.def.key == chosen
			slot.stroke.Color = if on then GOLD else WHITE
			slot.stroke.Thickness = if on then 4.5 else 2.5
			Kit.tween(slot.scale, 0.15, { Scale = if on then 1.08 else 1 }, Enum.EasingStyle.Back)
			slot.button.BackgroundTransparency = if on then 0.15 else 0.35
		end
	end
	local function pick(key: string)
		if not shown then
			return
		end
		chosen = if chosen == key then "none" else key
		renderGear()
		Kit.sound("Click")
		action:FireServer({ action = "ParkourGear", gear = chosen })
	end
	for i, def in GEARS do
		local button = Kit.new("TextButton", {
			Name = def.label,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = C.Ink,
			BackgroundTransparency = 0.35,
			Size = UDim2.fromOffset(SLOT, SLOT),
			Position = UDim2.fromOffset((i - 1) * (SLOT + SLOT_GAP), 0),
			Parent = hotbar,
		})
		Kit.corner(button, 12)
		Kit.selectable(button)
		local stroke = Kit.new("UIStroke", {
			Thickness = 2.5,
			Color = WHITE,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = button,
		})
		local scale = Kit.new("UIScale", { Parent = button })
		coil(button, def.color, 38)
		Kit.hudText(button, {
			Name = "Label",
			Text = def.label,
			Font = F.UI,
			TextSize = 12,
			StrokeThickness = 1.5,
			Size = UDim2.new(1, 0, 0, 14),
			Position = UDim2.new(0.5, 0, 1, -3),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 5,
		})
		-- Key badge in the top-left corner, like a Roblox backpack slot.
		local badge = Kit.new("Frame", {
			Name = "Key",
			BackgroundColor3 = C.Ink,
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.fromOffset(-5, -5),
			ZIndex = 6,
			Parent = button,
		})
		Kit.round(badge)
		Kit.new("UIStroke", { Thickness = 2, Color = WHITE, Parent = badge })
		Kit.hudText(badge, {
			Name = "Number",
			Text = tostring(i),
			Font = F.Display,
			TextSize = 14,
			StrokeThickness = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 7,
		})
		button.Activated:Connect(function()
			pick(def.key)
		end)
		table.insert(slots, { button = button, stroke = stroke, scale = scale, def = def })
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not shown or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		for _, def in GEARS do
			if input.KeyCode == def.keyCode then
				pick(def.key)
			end
		end
	end)

	local function syncGear()
		local data = State.data
		local info = data and data.modes and data.modes.parkour
		local gear = if type(info) == "table" then info.gear else nil
		local key = if type(gear) == "string" then gear else "none"
		if key ~= chosen then
			chosen = key
			renderGear()
		end
	end
	State.changed.Event:Connect(syncGear)

	local function syncSkip()
		local next = skipCost()
		if next ~= cost then
			cost = next
			local label = Kit.buttonLabel(skip)
			if label then
				label.Text = skipText(cost)
			end
		end
	end
	State.changed.Event:Connect(syncSkip)

	-- Layout -----------------------------------------------------------------------------
	local function viewport(): Vector2
		local ok, size = pcall(function()
			return screen.AbsoluteSize
		end)
		return if ok and typeof(size) == "Vector2" and size.X > 0 then size else Vector2.new(1280, 720)
	end
	-- Row positions, as offsets from the screen centre (design px). Desktop:
	-- [run pill][STAGE n / N][SKIP] on one line, the stage centred. Phones: the run pill
	-- and the stage share line 1, the skip button is centred on line 2.
	local phone = false
	local function rowLayout(): (UDim2, Vector2)
		phone = viewport().X < PHONE_PX
		barHolder.Size = UDim2.new(if phone then BAR_FRACTION_PHONE else BAR_FRACTION, 0, 0, BAR_H)
		counter.AnchorPoint = Vector2.new(0.5, 0)
		counter.TextXAlignment = Enum.TextXAlignment.Center
		skip.AnchorPoint = Vector2.new(0.5, 0)
		local runPos: UDim2
		if phone then
			-- Line 1: [run pill][stage] centred as a pair; line 2: skip.
			local left = -(RUN_W + ROW_GAP + STAGE_W) / 2
			runPos = UDim2.new(0.5, left + RUN_W, 0, ROW_Y)
			counter.Position = UDim2.new(0.5, left + RUN_W + ROW_GAP + STAGE_W / 2, 0, ROW_Y)
			skip.Position = UDim2.new(0.5, 0, 0, ROW_Y + ROW_H + 8)
		else
			runPos = UDim2.new(0.5, -STAGE_W / 2 - ROW_GAP, 0, ROW_Y)
			counter.Position = UDim2.new(0.5, 0, 0, ROW_Y)
			skip.Position = UDim2.new(0.5, STAGE_W / 2 + ROW_GAP + SKIP_W / 2, 0, ROW_Y)
		end
		-- The run pill is anchored by its right edge so "QUIT?" widens it to the left,
		-- away from the stage counter.
		return runPos, Vector2.new(1, 0)
	end
	local function placeHotbar()
		local y = -HOTBAR_BOTTOM
		local x = 0
		if tank then
			local pos, size = tank.Position, tank.Size
			-- The dumbbell is anchored bottom centre (Hud): its top is pos.Y - height.
			y = pos.Y.Offset - size.Y.Offset * tank.AnchorPoint.Y - HOTBAR_GAP
			x = pos.X.Offset
			hotbar.Position = UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
			return
		end
		local compact = screen:GetAttribute("Compact") == true
		hotbar.Position = UDim2.new(0.5, x, 1, if compact then -100 else y)
	end
	local function relayout()
		local runPos, runAnchor = rowLayout()
		if shown and dockRun then
			dockRun(runPos, runAnchor)
		end
		placeHotbar()
	end
	relayout()
	pcall(function()
		screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)
	end)
	screen:GetAttributeChangedSignal("Compact"):Connect(relayout)
	if tank then
		-- Follows the dumbbell as it resizes (compact) or slides away under a window.
		tank:GetPropertyChangedSignal("Position"):Connect(placeHotbar)
		tank:GetPropertyChangedSignal("Size"):Connect(placeHotbar)
	end

	-- API ----------------------------------------------------------------------------------
	local function setCount(count: number?)
		local n = tonumber(count) or 0
		if n <= 0 then
			n = worldStageCount()
		end
		if n > 0 and n ~= stageCount then
			stageCount = n
			placeAll()
		end
	end

	ObbyHud.setStage = function(stage: number?, count: number?)
		setCount(count)
		local n = tonumber(stage) or myStage
		local changed = n ~= myStage
		myStage = n
		placeHead(me, myStage, true)
		Kit.tween(ahead, 0.45, { Size = UDim2.fromScale(1 - headX(myStage), 1) }, Enum.EasingStyle.Quad)
		renderCounter()
		if changed and shown then
			counterScale.Scale = 1.3
			Kit.tween(counterScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		end
	end

	ObbyHud.show = function(stage: number?, count: number?)
		local was = shown
		shown = true
		root.Visible = true
		syncGear()
		renderGear()
		relayout() -- docks Hud's run pill into the row
		ObbyHud.setStage(stage, count)
		if not was then
			-- The bar drops in from above the screen.
			barHolder.Position = UDim2.new(0.5, 0, 0, BAR_Y - 60)
			Kit.tween(barHolder, 0.35, { Position = UDim2.new(0.5, 0, 0, BAR_Y) }, Enum.EasingStyle.Back)
			Kit.appear(hotbar, { from = 0.6, time = 0.3, delay = 0.08 })
		end
	end

	ObbyHud.hide = function()
		if not shown then
			return
		end
		shown = false
		root.Visible = false
		if dockRun then
			dockRun(nil, nil)
		end
	end

	ObbyHud.isShown = function(): boolean
		return shown
	end

	renderCounter()
	renderGear()
	setCount(nil)
end

return ObbyHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">Popups</string>
              <string name="Source"><![CDATA[--[[
	Popups: toasts, reward reveals, the held-crate panel, confirm dialogs,
	offline earnings and floating "+X" text.

	Everything eases: popups come in with Kit.appear and leave with
	Kit.disappear, toasts slide into a stack, floats rise on an arc, numbers
	count up. Celebrations use the candy colours of Theme.World (confetti,
	soft rays, a white ring on bursts); nothing flashes.

	Z order (ScreenGui uses Sibling ZIndex):
	  floats 20, toasts 25, reward 30, offline 44-45, starter 46-47, confirm 49-50,
	  cash rain 50
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)
local Sprites = require(script.Parent.Parent.Fx.Sprites)
local Windows = require(script.Parent.Windows)

local Theme = Kit.Theme
local C = Kit.C
local T = Kit.TEXT
local W = Theme.Words
local World = Theme.World

local WHITE = Color3.new(1, 1, 1)

-- Candy colours for confetti (the world's paint, never neon).
local CANDY = { World.Sunny, World.Pink, World.Mint, World.Blue, World.Grape, World.Orange, World.White }

-- The Lune preview exporter stubs TweenInfo and captures synchronously: there,
-- modals skip the queue and staged reveals build at once.
local PREVIEW = typeof(TweenInfo.new(0)) ~= "TweenInfo"

local Popups = {}

local screen: ScreenGui
local toastHolder: Frame
local sounds: any

local TOAST_Y = 146

-- Motion helpers -------------------------------------------------------------------

-- Runs `fn` after `t` seconds (at once in the preview).
local function after(t: number, fn: () -> ())
	if PREVIEW then
		fn()
	else
		task.delay(t, fn)
	end
end

-- Tween with a start delay.
local function tweenAfter(
	obj: Instance,
	time: number,
	delay: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out, 0, false, delay)
	local tween = TweenService:Create(obj, info, props)
	tween:Play()
	return tween
end

-- Screen-covering layer inside a centred holder (a soft navy dim or a tint).
local function cover(parent: Instance, name: string, color: Color3, transparency: number): Frame
	return Kit.new("Frame", {
		Name = name,
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(6000, 6000),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 0,
		Parent = parent,
	})
end

-- Transparent full-screen tap catcher inside a centred holder.
local function catcher(parent: Instance, zindex: number): TextButton
	return Kit.new("TextButton", {
		Name = "Skip",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Selectable = false,
		Text = "",
		Size = UDim2.fromOffset(6000, 6000),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = zindex,
		Parent = parent,
	})
end

local function circle(parent: Instance, name: string, color: Color3, transparency: number, zindex: number): Frame
	local frame = Kit.new("Frame", {
		Name = name,
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = zindex,
		Parent = parent,
	})
	Kit.round(frame)
	return frame
end

-- Toasts ------------------------------------------------------------------------
--[[
	A short stack under the top bar, newest on top. Each toast is a small blue
	panel with a coloured icon chip; it slides down into place, the others
	slide to make room, and it fades up and away after 3 s.
]]

local TONES = {
	good = { color = C.Cash, icon = "Check" },
	bad = { color = C.Danger, icon = "!" },
	info = { color = C.Gold, icon = "i" },
}

local TOAST_H = 44
local TOAST_STEP = 54 -- toast + lip/shadow + gap
local MAX_TOASTS = 4

local toasts: { Frame } = {}

-- Width that hugs the text (TextService when available, else an estimate).
local function toastWidth(text: string): number
	local width = 0
	pcall(function()
		local TextService = game:GetService("TextService")
		width = TextService:GetTextSize(text, 16, Theme.Fonts.UI, Vector2.new(1000, 40)).X
	end)
	if width <= 0 then
		width = (utf8.len(text) or #text) * 8.5
	end
	return math.clamp(math.ceil(width) + 72, 220, 520)
end

local function placeToasts()
	for i = #toasts, 1, -1 do
		if toasts[i].Parent ~= toastHolder then
			table.remove(toasts, i)
		end
	end
	for index, toast in toasts do
		Kit.tween(toast, 0.3, { Position = UDim2.new(0.5, 0, 0, (index - 1) * TOAST_STEP) }, Enum.EasingStyle.Quint)
	end
end

local function dismissToast(toast: Frame)
	local index = table.find(toasts, toast)
	if not index then
		return
	end
	table.remove(toasts, index)
	Kit.tween(toast, 0.18, { Position = toast.Position + UDim2.fromOffset(0, -12) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	Kit.disappear(toast, { time = 0.18, destroy = true })
	placeToasts()
end

function Popups.toast(text: string, tone: string?)
	local style = TONES[tone or "info"] or TONES.info
	local toast = Kit.new("Frame", {
		Name = "Toast",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(toastWidth(text), TOAST_H),
		Position = UDim2.new(0.5, 0, 0, -16),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = toastHolder,
	})
	local card = Kit.panel(toast, {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		Radius = Kit.RADIUS.M,
	})
	local chip = Kit.new("Frame", {
		Name = "Icon",
		BackgroundColor3 = WHITE,
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(0, 8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 2,
		Parent = card,
	})
	Kit.round(chip)
	Kit.gradient(chip, Kit.lighten(style.color, 0.25), style.color)
	Kit.stroke(chip, 2, Kit.lip(style.color))
	local ink = Kit.inkOn(style.color)
	if Kit.ICONS[style.icon] then
		Kit.icon(chip, style.icon, 16, ink, { Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 })
	else
		Kit.text(chip, {
			Text = style.icon,
			Font = Theme.Fonts.Display,
			TextSize = 18,
			TextColor3 = ink,
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 1),
			StrokeThickness = 0,
			ZIndex = 3,
		})
	end
	Kit.text(card, {
		Name = "Text",
		Text = text,
		Font = Theme.Fonts.UI,
		TextSize = 16,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -60, 1, -4),
		Position = UDim2.fromOffset(48, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 0,
		ZIndex = 2,
	})

	table.insert(toasts, 1, toast)
	while #toasts > MAX_TOASTS do
		dismissToast(toasts[#toasts])
	end
	placeToasts()
	Kit.appear(toast, { from = 0.9, time = 0.24 })
	if tone == "bad" then
		sounds.play("Error")
	else
		sounds.play("Toast")
	end
	task.delay(3, function()
		dismissToast(toast)
	end)
end

-- Floating text -------------------------------------------------------------------

-- "+$120" over the world: pops in, rises on a soft arc (steady sideways drift,
-- easing-out climb) and fades near the top.
function Popups.float(text: string, color: Color3, anchor: UDim2)
	local mover = Kit.new("Frame", {
		Name = "Float",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 44),
		Position = anchor,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 20,
		Parent = screen,
	})
	local label = Kit.title(mover, {
		Name = "Text",
		Text = text,
		TextSize = 30,
		TextWrapped = false,
		Size = UDim2.fromScale(1, 1),
		TextColor3 = color,
		StrokeThickness = 0,
	})
	-- Over the 3D world: a solid navy outline.
	local outline = Kit.textStroke(label, 2.5, 0)
	local pop = Kit.new("UIScale", { Scale = 0.55, Parent = label })
	Kit.tween(pop, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
	local drift = math.random(-36, 36)
	Kit.tween(mover, 1.1, { Position = anchor + UDim2.fromOffset(drift, 0) }, Enum.EasingStyle.Linear)
	Kit.tween(label, 1.1, { Position = UDim2.fromOffset(0, -80) }, Enum.EasingStyle.Quad)
	tweenAfter(label, 0.4, 0.7, { TextTransparency = 1 })
	tweenAfter(outline, 0.4, 0.7, { Transparency = 1 })
	tweenAfter(pop, 0.4, 0.7, { Scale = 0.85 })
	task.delay(1.15, function()
		mover:Destroy()
	end)
end

-- Modal queue -------------------------------------------------------------------------
--[[
	One modal at a time: rewards, crate reveals, offline earnings, confirms and the
	tutorial completion card all go through here. Highest priority first, then
	arrival order. New arrivals wait a short "gather" window so cards that arrive
	together sort correctly, and the whole queue holds for 1 s after a Merge
	effect so the 3D fusion is seen before the card covers it.
]]

Popups.PRIORITY = { NewTier = 3, Tutorial = 2, Normal = 1 }

type Entry = {
	kind: string,
	priority: number,
	seq: number,
	readyAt: number,
	show: (done: () -> ()) -> (),
	data: { [string]: any }?,
}

local GATHER = 0.15
local MERGE_HOLD = 1.0
local CRATE_LINK = 0.6

local queue: { Entry } = {}
local busy = false
local seqCounter = 0
local holdUntil = 0
local pendingChest: { rarity: string, at: number }? = nil
-- os.clock() when the last modal closed (the Starter offer waits for a calm moment).
local lastModalAt = 0

local pump: () -> ()

local function schedule(delay: number)
	task.delay(math.max(delay, 0), pump)
end

pump = function()
	if busy or #queue == 0 then
		return
	end
	local now = os.clock()
	if now < holdUntil then
		schedule(holdUntil - now + 0.01)
		return
	end
	local best: number? = nil
	local soonest = math.huge
	for index, entry in queue do
		if entry.readyAt <= now then
			local current = if best then queue[best] else nil
			if not current or entry.priority > current.priority or (entry.priority == current.priority and entry.seq < current.seq) then
				best = index
			end
		else
			soonest = math.min(soonest, entry.readyAt)
		end
	end
	if not best then
		schedule(soonest - now + 0.01)
		return
	end
	local entry = table.remove(queue, best) :: Entry
	busy = true
	local finished = false
	local function done()
		if finished then
			return
		end
		finished = true
		busy = false
		lastModalAt = os.clock()
		schedule(0.05)
	end
	local ok, err = pcall(entry.show, done)
	if not ok then
		warn("[Popups] " .. entry.kind .. " failed: " .. tostring(err))
		done()
	end
end

-- Queue a modal. `show(done)` builds it and must call `done()` once it closes.
function Popups.enqueue(kind: string, priority: number, show: (done: () -> ()) -> (), data: { [string]: any }?)
	if PREVIEW then
		-- The preview captures right after the call: show it at once.
		local ok, err = pcall(show, function() end)
		if not ok then
			warn("[Popups] " .. kind .. " failed: " .. tostring(err))
		end
		return
	end
	seqCounter += 1
	table.insert(queue, {
		kind = kind,
		priority = priority,
		seq = seqCounter,
		readyAt = os.clock() + GATHER,
		show = show,
		data = data,
	})
	schedule(GATHER + 0.01)
end

-- Main calls this on every "Merge" effect.
function Popups.noteMerge()
	holdUntil = math.max(holdUntil, os.clock() + MERGE_HOLD)
end

-- Main calls this on "ChestOpen": tags the reward it produced so it plays the
-- crate reveal (the Reward notify usually arrives just before the effect).
function Popups.noteChestOpen(rarity: string?)
	local now = os.clock()
	for i = #queue, 1, -1 do
		local data = queue[i].data
		if queue[i].kind == "Reward" and data and now - data._at <= CRATE_LINK and not data.crateRarity then
			data.crate = true
			data.crateRarity = rarity
			return
		end
	end
	pendingChest = { rarity = rarity or "Common", at = now }
end

-- Shared modal pieces ------------------------------------------------------------------

--[[
	Dimmed, blurred modal: a moulded blue panel. The caller fills it, then calls
	Kit.appear(box). `close()` eases it out with Kit.disappear and calls
	`onClosed` once it is gone.
]]
-- Gamepad and keyboard "back" ------------------------------------------------------------------
--[[
	Every open overlay (modal, reward card, crate reveal) pushes a Back entry. B /
	Escape runs the top-most one (highest ZIndex, newest first); an entry with no
	`fn` swallows the press (nothing dismissable). The ScreenGui's ModalOpen
	attribute is true while any entry is up, so Windows leaves its own B / Escape
	alone underneath a modal.
]]
type Back = { z: number, seq: number, fn: (() -> ())? }
local backStack: { Back } = {}
local backSeq = 0
local BACK_ACTION = "PopupsBack"
local backBound = false
local runBack: () -> ()
local function syncModalFlag()
	local up = #backStack > 0
	if screen then
		screen:SetAttribute("ModalOpen", up)
	end
	if up == backBound or PREVIEW then
		return
	end
	backBound = up
	-- B / Escape bound (sunk, high priority) only while an overlay is up.
	pcall(function()
		if up then
			ContextActionService:BindActionAtPriority(BACK_ACTION, function(_, state)
				if state ~= Enum.UserInputState.Begin then
					return Enum.ContextActionResult.Pass
				end
				runBack()
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value + 10, Enum.KeyCode.ButtonB, Enum.KeyCode.Escape)
		else
			ContextActionService:UnbindAction(BACK_ACTION)
		end
	end)
end
local function pushBack(z: number, fn: (() -> ())?): Back
	backSeq += 1
	local entry: Back = { z = z, seq = backSeq, fn = fn }
	table.insert(backStack, entry)
	syncModalFlag()
	return entry
end
local function dropBack(entry: Back)
	local i = table.find(backStack, entry)
	if i then
		table.remove(backStack, i)
		syncModalFlag()
	end
end
local function topBack(): Back?
	local top: Back? = nil
	for _, entry in backStack do
		if not top or entry.z > top.z or (entry.z == top.z and entry.seq > top.seq) then
			top = entry
		end
	end
	return top
end

-- Runs the top-most overlay's back action (deferred, so Windows still sees ModalOpen
-- for this same press and leaves the window under the modal open).
runBack = function()
	local top = topBack()
	local fn = top and top.fn
	if fn then
		task.defer(fn)
	end
end

local function selectedNow(): GuiObject?
	local ok, selected = pcall(function()
		return GuiService.SelectedObject
	end)
	return if ok then selected else nil
end

-- Gamepad: once the caller has filled the card (next frame), select its FocusFirst
-- button, or its first button, and keep the selection inside it.
local function focusCard(card: GuiObject)
	if PREVIEW then
		return
	end
	task.defer(function()
		if card.Parent then
			Kit.confine(card)
			Kit.focus(card)
		end
	end)
end

-- Drops the selection out of a closing card and hands it back to what was selected
-- before it opened (a button in an open window), if that is still on screen.
local function release(card: GuiObject, previous: GuiObject?)
	if PREVIEW then
		return
	end
	Kit.unfocus(card)
	if previous and previous ~= card and previous.Visible and previous:IsDescendantOf(game) and not previous:IsDescendantOf(card) then
		local current = selectedNow()
		if current == nil or current == card or current:IsDescendantOf(card) then
			Kit.select(previous)
		end
	end
end

local modalCount = 0
local openModals: { [() -> ()]: boolean } = {}
local backOf: { [() -> ()]: Back } = {}
local function modal(name: string, size: Vector2, zindex: number, onBackdrop: (() -> ())?, onClosed: (() -> ())?): (Frame, () -> ())
	modalCount += 1
	local openKey = "Modal:" .. name .. modalCount
	local dim = Kit.backdrop(screen, zindex - 1)
	dim.Name = name .. "Backdrop"
	Kit.fadeBackdrop(dim, true, 0.55)
	Kit.setBlur(true)
	Kit.markOpen(screen, openKey, true)
	-- Centred holder (named `name`) that Kit.fit keeps on screen; it leaves
	-- room above for the medallion that overlaps the top edge.
	local holder = Kit.new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size.X, size.Y + 96),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = zindex,
		Parent = screen,
	})
	Kit.fit(holder, screen, Vector2.new(size.X, size.Y + 96))
	local box = Kit.panel(holder, {
		Name = "Box",
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		StrokeThickness = 2,
		Radius = Kit.RADIUS.XL,
		ZIndex = zindex,
	})
	local closed = false
	local previous = selectedNow()
	local back: Back? = nil
	local function close()
		if closed then
			return
		end
		closed = true
		openModals[close] = nil
		backOf[close] = nil
		if back then
			dropBack(back)
		end
		release(box, previous)
		Kit.setBlur(false)
		Kit.markOpen(screen, openKey, false)
		Kit.fadeBackdrop(dim, false)
		Kit.disappear(box, {
			onDone = function()
				holder:Destroy()
			end,
		})
		task.delay(0.3, function()
			dim:Destroy()
			if holder.Parent then
				holder:Destroy()
			end
		end)
		if onClosed then
			task.delay(0.15, onClosed)
		end
	end
	local function backdropTap()
		if onBackdrop then
			onBackdrop()
		end
		close()
	end
	dim.Activated:Connect(backdropTap)
	openModals[close] = true
	-- B / Escape acts like a backdrop tap unless the card overrides it (onBack).
	back = pushBack(zindex, backdropTap)
	backOf[close] = back :: Back
	focusCard(box)
	return box, close
end

-- Overrides what B / Escape does on the modal `close` belongs to (nil: ignore it).
local function onBack(close: () -> (), fn: (() -> ())?)
	local entry = backOf[close]
	if entry then
		entry.fn = fn
	end
end

-- Closes every open modal (Studio capture hook "UiPreview" = "close").
function Popups.closeModals()
	for close in openModals do
		close()
	end
end

-- Round toy badge: a coloured face with a white rim on a darker lip, sitting
-- across the top edge of a modal.
local function medallion(parent: Instance, icon: string, color: Color3, size: number, position: UDim2): Frame
	local depth = math.max(math.floor(size * 0.06), 3)
	local medal = Kit.new("Frame", {
		Name = "Medal",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
		Parent = parent,
	})
	local shadow = circle(medal, "Shadow", C.Ink, 0.72, 1)
	shadow.Size = UDim2.fromScale(0.92, 0.92)
	shadow.Position = UDim2.new(0.5, 0, 0.5, depth + 5)
	local base = circle(medal, "Base", Kit.lip(color), 0, 2)
	base.Size = UDim2.fromScale(1, 1)
	base.Position = UDim2.new(0.5, 0, 0.5, depth)
	local face = circle(medal, "Face", WHITE, 0, 3)
	face.Size = UDim2.fromScale(1, 1)
	Kit.gradient(face, Kit.lighten(color, 0.3), color)
	Kit.new("UIStroke", { Thickness = 3, Color = WHITE, Transparency = 0.1, Parent = face })
	local gloss = circle(face, "Gloss", WHITE, 0.6, 4)
	gloss.Size = UDim2.fromScale(0.36, 0.2)
	gloss.Position = UDim2.fromScale(0.36, 0.22)
	gloss.Rotation = -20
	local ink = Kit.inkOn(color)
	local iconName = Kit.iconName(icon)
	if iconName then
		Kit.icon(face, iconName, math.floor(size * 0.56), ink, {
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 5,
		})
	else
		Kit.title(face, {
			Text = icon,
			TextSize = math.floor(size * 0.52),
			TextColor3 = ink,
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 2),
			StrokeThickness = 0,
			ZIndex = 5,
		})
	end
	return medal
end

--[[
	Soft light rays behind something celebratory: wide bars that fade toward
	both ends, turning slowly with one repeating tween. `reverse` spins the
	other way (for a counter-layer).
]]
function Popups.rays(
	parent: Instance,
	color: Color3,
	size: number,
	position: UDim2,
	zindex: number?,
	count: number?,
	reverse: boolean?
): Frame
	local holder = Kit.new("Frame", {
		Name = "Rays",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = zindex or 1,
		Parent = parent,
	})
	local n = count or 6
	local fade = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.32, 0.35),
		NumberSequenceKeypoint.new(0.5, 0.1),
		NumberSequenceKeypoint.new(0.68, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	for i = 0, n - 1 do
		local ray = Kit.new("Frame", {
			Name = "Ray",
			BackgroundColor3 = color,
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 36, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = i * (180 / n),
			ZIndex = zindex or 1,
			Parent = holder,
		})
		Kit.round(ray)
		Kit.new("UIGradient", { Rotation = 90, Transparency = fade, Parent = ray })
	end
	if not PREVIEW then
		local info = TweenInfo.new(22, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
		TweenService:Create(holder, info, { Rotation = if reverse then -360 else 360 }):Play()
	end
	return holder
end

-- Atlas crate art per crate rarity (Mythic shares the Legendary crate).
local CRATE_ART: { [string]: string } = {
	Common = "CrateCommon",
	Uncommon = "CrateUncommon",
	Rare = "CrateRare",
	Epic = "CrateEpic",
	Legendary = "CrateLegendary",
	Mythic = "CrateLegendary",
}

--[[
	A chunky toy crate: the rarity's atlas art when props.Rarity is given and
	the art loaded, else drawn from frames: a rounded box in `color` (lighter at
	the top) on a darker lip, a lid band, two straps and a sunny clasp.
]]
local function crateIcon(parent: Instance, color: Color3, size: number, props: { [string]: any }?): Frame
	local p = props or {}
	-- The Blender crate for this rarity from the icon atlas (p.Rarity), drawn a
	-- little larger since the art has its own padding.
	local art = p.Rarity and CRATE_ART[p.Rarity]
	if art and Kit.hasImageIcon(art) then
		return Kit.icon(parent, art, math.floor(size * 1.15), nil, {
			Name = p.Name or "Crate",
			Position = p.Position or UDim2.new(),
			AnchorPoint = p.AnchorPoint or Vector2.zero,
			ZIndex = p.ZIndex or 1,
		})
	end
	local root = Kit.new("Frame", {
		Name = p.Name or "Crate",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		ZIndex = p.ZIndex or 1,
		Parent = parent,
	})
	local lipColor = Kit.lip(color)
	local r = math.max(math.floor(size * 0.12), 6)
	local depth = math.max(math.floor(size * 0.05), 3)
	-- `round` = pill corners instead of the crate radius.
	local function part(name: string, z: number, props2: { [string]: any }, round: boolean?): Frame
		props2.Name = name
		props2.BorderSizePixel = 0
		props2.ZIndex = z
		props2.Parent = root
		local frame = Kit.new("Frame", props2)
		if round then
			Kit.round(frame)
		else
			Kit.corner(frame, r)
		end
		return frame
	end
	part("Shadow", 1, {
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.72,
		Size = UDim2.fromScale(0.86, 0.12),
		Position = UDim2.fromScale(0.5, 0.93),
		AnchorPoint = Vector2.new(0.5, 0.5),
	}, true)
	part("Base", 2, {
		BackgroundColor3 = lipColor,
		Size = UDim2.fromScale(0.8, 0.6),
		Position = UDim2.fromScale(0.5, 0.92),
		AnchorPoint = Vector2.new(0.5, 1),
	})
	local body = part("Body", 3, {
		BackgroundColor3 = WHITE,
		Size = UDim2.new(0.8, 0, 0.6, -depth),
		Position = UDim2.new(0.5, 0, 0.92, -depth),
		AnchorPoint = Vector2.new(0.5, 1),
	})
	Kit.gradient(body, Kit.lighten(color, 0.3), color)
	Kit.stroke(body, 2, lipColor)
	for _, x in { 0.28, 0.72 } do
		part("Strap", 4, {
			BackgroundColor3 = Kit.lighten(color, 0.55),
			BackgroundTransparency = 0.25,
			Size = UDim2.new(0.09, 0, 0.6, -depth - 6),
			Position = UDim2.new(x, 0, 0.92, -depth - 3),
			AnchorPoint = Vector2.new(0.5, 1),
		})
	end
	part("LidLip", 5, {
		BackgroundColor3 = lipColor,
		Size = UDim2.fromScale(0.92, 0.22),
		Position = UDim2.new(0.5, 0, 0.2, depth),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	local lid = part("Lid", 6, {
		BackgroundColor3 = WHITE,
		Size = UDim2.fromScale(0.92, 0.22),
		Position = UDim2.fromScale(0.5, 0.2),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	Kit.gradient(lid, Kit.lighten(color, 0.42), Kit.lighten(color, 0.08))
	Kit.stroke(lid, 2, lipColor)
	part("Highlight", 7, {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.45,
		Size = UDim2.new(0.7, 0, 0, math.max(math.floor(size * 0.025), 2)),
		Position = UDim2.new(0.5, 0, 0.2, 3),
		AnchorPoint = Vector2.new(0.5, 0),
	}, true)
	local clasp = part("Clasp", 8, {
		BackgroundColor3 = WHITE,
		Size = UDim2.fromScale(0.22, 0.2),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	Kit.gradient(clasp, C.GoldLight, C.Gold)
	Kit.stroke(clasp, 2, C.GoldDeep)
	return root
end

-- Reward card ----------------------------------------------------------------------------

local function isBigBand(band: string): boolean
	return band == "Legendary" or band == "Mythic"
end

-- Other tiers discovered by the same action (payload.tiers minus the headline tier).
local function extraTiers(reward: { [string]: any }): { number }
	local extras = {}
	if type(reward.tiers) == "table" then
		for _, t in reward.tiers do
			if type(t) == "number" and t ~= reward.tier and Theme.Tiers[t] and not table.find(extras, t) then
				table.insert(extras, t)
			end
		end
	end
	return extras
end

local STRIP_HEIGHT = 78
local STRIP_SLOTS = 5
local CARD_WIDTH = 380
local CARD_HEIGHT = 500

-- "+N more new Chads!" strip: small tier medallions that pop in one by one
-- from `start` seconds.
local function discoveryStrip(card: Frame, extras: { number }, y: number, start: number, alive: () -> boolean)
	local strip = Kit.well(card, {
		Name = "MoreNew",
		Size = UDim2.new(1, -28, 0, STRIP_HEIGHT - 8),
		Position = UDim2.fromOffset(14, y),
		Radius = Kit.RADIUS.M,
	})
	Kit.title(strip, {
		Name = "Header",
		Text = string.format("+%d MORE NEW %s!", #extras, string.upper(if #extras == 1 then W.Unit else W.Units)),
		TextSize = T.Small,
		TextWrapped = false,
		Size = UDim2.new(1, -10, 0, 18),
		Position = UDim2.fromOffset(5, 3),
		TextColor3 = C.Gold,
		StrokeThickness = 0,
	})
	-- Before the slots exist, so the strip fade does not touch them.
	Kit.appear(strip, { from = 0.9, delay = start - 0.1 })
	local row = Kit.new("Frame", {
		Name = "Row",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -10, 0, 46),
		Position = UDim2.fromOffset(5, 22),
		Parent = strip,
	})
	Kit.list(row, 4, true, Enum.HorizontalAlignment.Center)
	local shown = if #extras > STRIP_SLOTS then STRIP_SLOTS - 1 else #extras
	local function slot(order: number): Frame
		return Kit.new("Frame", {
			Name = "Slot" .. order,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(62, 46),
			LayoutOrder = order,
			Parent = row,
		})
	end
	-- Hidden at once (keeping its layout slot), then eased in at `at`.
	local function popIn(frame: Frame, at: number, pitch: number?)
		Kit.appear(frame, { from = 0.3, time = 0.3, delay = at })
		if pitch then
			after(at, function()
				if alive() then
					sounds.play("Tick", 0.03, pitch)
				end
			end)
		end
	end
	for i = 1, shown do
		local t = extras[i]
		local tierColor = C.Rarity[Economy.tierBand(t)] or C.Gold
		local frame = slot(i)
		local medal = Kit.new("Frame", {
			Name = "Medal",
			BackgroundColor3 = WHITE,
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Parent = frame,
		})
		Kit.round(medal)
		Kit.stroke(medal, 2, Kit.lip(tierColor))
		Kit.gradient(medal, Kit.lighten(tierColor, 0.3), tierColor)
		Kit.title(medal, {
			Text = tostring(t),
			TextSize = 16,
			TextWrapped = false,
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(0, 1),
			TextColor3 = Kit.inkOn(tierColor),
			StrokeThickness = 0,
		})
		-- (No name under the chip: at this width it could only be tiny.)
		popIn(frame, start + i * 0.09, 1 + i * 0.08)
	end
	if shown < #extras then
		local frame = slot(STRIP_SLOTS)
		Kit.title(frame, {
			Text = "+" .. (#extras - shown),
			TextSize = 22,
			TextWrapped = false,
			Size = UDim2.new(1, 0, 0, 30),
			TextColor3 = C.Gold,
			StrokeThickness = 0,
		})
		popIn(frame, start + STRIP_SLOTS * 0.09, nil)
	end
end

-- One stat in the reward card's stat row: icon, caption, rolling number.
local function statCell(
	parent: Instance,
	icon: string,
	iconColor: Color3,
	caption: string,
	valueColor: Color3,
	order: number,
	width: UDim2
): TextLabel
	local cell = Kit.new("Frame", {
		Name = "Stat" .. order,
		BackgroundTransparency = 1,
		Size = width,
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.icon(cell, icon, 30, iconColor, {
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	Kit.text(cell, {
		Name = "Caption",
		Text = caption,
		Font = Theme.Fonts.UI,
		TextSize = 14,
		MaxTextSize = 14,
		TextScaled = true,
		TextWrapped = false,
		Size = UDim2.new(1, -52, 0, 17),
		Position = UDim2.fromOffset(46, 3),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Text:Lerp(C.TextDim, 0.4),
		StrokeThickness = 0,
	})
	return Kit.number(cell, {
		Name = "Value",
		Text = "0",
		TextSize = 22,
		Size = UDim2.new(1, -52, 0, 24),
		Position = UDim2.fromOffset(46, 21),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = valueColor,
		StrokeThickness = 0,
	})
end

--[[
	The reward card builds in steps within about a second: card and banner,
	then the unit spins in on its stage, then its name and tier, then the stats
	roll up, then the button. Tap anywhere (or the button) to continue; it
	also closes by itself after a few seconds.
]]
local function showRewardCard(reward: { [string]: any }, done: () -> ())
	local tier = reward.tier
	local band = Economy.tierBand(tier)
	local color = C.Rarity[band] or C.Gold
	local extras = extraTiers(reward)
	local extraHeight = if #extras > 0 then STRIP_HEIGHT else 0

	-- "Reward" is kept inside the visible area by Kit.fit; "Body" inside it
	-- carries the appear / disappear animation.
	local root = Kit.new("Frame", {
		Name = "Reward",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT + extraHeight),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 30,
		Parent = screen,
	})
	Kit.fit(root, screen, Vector2.new(CARD_WIDTH, CARD_HEIGHT + extraHeight))
	local openKey = "Reward:" .. tostring(os.clock())
	Kit.markOpen(screen, openKey, true)
	local holder = Kit.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 30,
		Parent = root,
	})
	local dim = cover(holder, "Dim", C.Ink, 0.45)
	Kit.appear(dim, { from = 1, time = 0.25 })
	local rays = Popups.rays(holder, Kit.lighten(color, 0.55), 660, UDim2.new(0.5, 0, 0, 200), 1, 7)
	Kit.appear(rays, { from = 0.3, time = 0.5, style = Enum.EasingStyle.Quart })
	if reward.new then
		-- A white counter-layer turning the other way for a fresh discovery.
		local inner = Popups.rays(holder, WHITE, 500, UDim2.new(0.5, 0, 0, 200), 1, 9, true)
		Kit.appear(inner, { from = 0.3, time = 0.55, style = Enum.EasingStyle.Quart })
	end

	local card = Kit.panel(holder, {
		Name = "Card",
		Size = UDim2.new(1, 0, 1, -24),
		Position = UDim2.fromOffset(0, 24),
		StrokeColor = color,
		StrokeThickness = 3,
		Radius = Kit.RADIUS.XL,
		ZIndex = 2,
	})
	-- Pastel stage in the rarity colour behind the unit, with a soft white
	-- sunburst turning slowly behind it (a CanvasGroup clips the rotating rays
	-- to the stage's rounded corners).
	local stage = Kit.new("Frame", {
		Name = "Stage",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -28, 0, 226),
		Position = UDim2.fromOffset(14, 34),
		ZIndex = 2,
		Parent = card,
	})
	Kit.corner(stage, Kit.RADIUS.L)
	Kit.gradient(stage, Kit.lighten(color, 0.55), color:Lerp(C.Surface, 0.25))
	Kit.new("UIStroke", { Thickness = 2, Color = WHITE, Transparency = 0.45, Parent = stage })
	local burst = Kit.new("CanvasGroup", {
		Name = "Burst",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		GroupTransparency = 0.25,
		ZIndex = 2,
		Parent = stage,
	})
	Kit.corner(burst, Kit.RADIUS.L)
	Popups.rays(burst, WHITE, 420, UDim2.fromScale(0.5, 0.56), 2, 10)
	local sun = circle(burst, "Sun", WHITE, 0.45, 2)
	sun.Size = UDim2.fromOffset(150, 150)
	sun.Position = UDim2.fromScale(0.5, 0.56)
	local spot = Kit.new("Frame", {
		Name = "Spot",
		BackgroundColor3 = Kit.lip(color),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(170, 30),
		Position = UDim2.new(0.5, 0, 1, -26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
		Parent = stage,
	})
	Kit.round(spot)
	Kit.appear(card, { from = 0.7, time = 0.32 })

	local banner = Kit.pill(holder, {
		Name = "Banner",
		Text = if reward.new then "NEW " .. string.upper(W.Unit) .. "!" else "YOU GOT",
		Solid = true,
		Color = if reward.new then C.Gold else C.SurfaceHi,
		Font = Theme.Fonts.Display,
		TextSize = 26,
		Size = UDim2.fromOffset(240, 46),
		Position = UDim2.new(0.5, 0, 0, 2),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 3,
	})
	Kit.appear(banner, { from = 0.4, time = 0.32, delay = 0.08 })

	if reward.new then
		sounds.play(if isBigBand(band) then "CelebrateLegendary" else "Celebrate")
	elseif not reward._sounded then
		-- The crate reveal already played "Reward" when it landed.
		sounds.play("Reward")
	end

	local closed = false
	local spin: RBXScriptConnection? = nil
	local previous = selectedNow()
	local back: Back? = nil
	local function alive(): boolean
		return not closed and root.Parent ~= nil
	end
	local function close()
		if closed then
			return
		end
		closed = true
		if spin then
			spin:Disconnect()
		end
		if back then
			dropBack(back)
		end
		release(holder, previous)
		Kit.markOpen(screen, openKey, false)
		Kit.disappear(holder, {
			time = 0.18,
			onDone = function()
				root:Destroy()
				done()
			end,
		})
		-- The queue must never stall (done is idempotent).
		task.delay(0.4, done)
	end
	catcher(holder, 5).Activated:Connect(close)
	back = pushBack(30, close)

	-- Step 2: the unit turns in on its stage. It starts a little past its rest
	-- pose (never side-on or from behind), eases to the front three-quarter
	-- view the viewport camera frames, then idles with a gentle sway around it.
	after(0.14, function()
		if not alive() then
			return
		end
		local viewport = Kit.unitViewport(stage, tier, { Size = UDim2.fromScale(1, 1) })
		viewport.ZIndex = 4
		Kit.appear(viewport, { from = 0.35, time = 0.42 })
		local model = viewport:FindFirstChildOfClass("Model")
		if model and not PREVIEW then
			local rest = model:GetPivot()
			local started = os.clock()
			local TURN, FROM, SWAY = 0.9, -0.8, 0.2
			model:PivotTo(rest * CFrame.Angles(0, FROM, 0))
			spin = RunService.RenderStepped:Connect(function()
				if not root.Parent then
					if spin then
						spin:Disconnect()
					end
					return
				end
				local t = os.clock() - started
				local yaw
				if t < TURN then
					-- Back-out ease: a small overshoot past the front, then settle.
					local u = t / TURN - 1
					local eased = 1 + 2.2 * u * u * u + 1.2 * u * u
					yaw = FROM * (1 - eased)
				else
					local idle = t - TURN
					yaw = SWAY * math.sin(idle * 0.8) * math.min(1, idle / 1.5)
				end
				model:PivotTo(rest * CFrame.Angles(0, yaw, 0))
			end)
		end
		if reward.new then
			Kit.confetti(holder, {
				Origin = UDim2.new(0.5, 0, 0, 170),
				Count = if isBigBand(band) then 54 else 38,
				ZIndex = 4,
				Colors = { color, CANDY[1], CANDY[2], CANDY[3], CANDY[4], CANDY[5], CANDY[7] },
				Power = 1.15,
			})
		end
	end)

	-- Step 3: name and tier.
	after(0.4, function()
		if not alive() then
			return
		end
		-- Big name in the rarity colour, scaled down to fit on one line.
		local name = Kit.title(card, {
			Name = "UnitName",
			Text = string.upper(Theme.Tiers[tier].Name),
			TextSize = 38,
			TextScaled = true,
			MaxTextSize = 38,
			TextWrapped = false,
			Size = UDim2.new(1, -28, 0, 42),
			Position = UDim2.fromOffset(14, 266),
			TextColor3 = Kit.lighten(color, 0.12),
			StrokeThickness = 3,
			ZIndex = 2,
		})
		Kit.appear(name, { from = 0.6, time = 0.28 })
		local pill = Kit.pill(card, {
			Name = "Tier",
			Text = string.format("TIER %d  •  %s", tier, string.upper(band)),
			Solid = true,
			Color = color,
			TextSize = T.Small,
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			Position = UDim2.new(0.5, 0, 0, 312),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 2,
		})
		Kit.appear(pill, { from = 0.6, time = 0.26, delay = 0.06 })
		sounds.play("Tick", 0.02, 1.2)
	end)

	-- Step 4: stats roll up.
	after(0.58, function()
		if not alive() then
			return
		end
		local stats = Kit.well(card, {
			Name = "Stats",
			Size = UDim2.new(1, -28, 0, 50),
			Position = UDim2.fromOffset(14, 348),
			Radius = Kit.RADIUS.M,
		})
		stats.ZIndex = 2
		Kit.list(stats, 0, true, Enum.HorizontalAlignment.Center)
		local rate = statCell(stats, "Orb", C.Orb, string.upper(W.Orb) .. " / SEC", Kit.lighten(C.Orb, 0.35), 1, UDim2.fromScale(1, 1))
		Kit.appear(stats, { from = 0.9, time = 0.24 })
		Kit.countTo(rate, 0, Economy.unitRate(tier), function(n)
			return Format.short(n) .. "/s"
		end, 0.5)
	end)

	-- Step 5: the button.
	after(0.85, function()
		if not alive() then
			return
		end
		local button = Kit.button(holder, {
			Name = "Continue",
			Text = if reward.new then "AWESOME!" else "NICE!",
			Font = Theme.Fonts.Display,
			Color = C.Gold,
			Breathe = true,
			TextSize = 28,
			Size = UDim2.fromOffset(250, 58),
			Position = UDim2.new(0.5, 0, 1, -14),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 6,
		}, close)
		button:SetAttribute("FocusFirst", true)
		Kit.appear(button, { from = 0.6, time = 0.28 })
		if not PREVIEW then
			Kit.focus(holder, button)
		end
	end)

	if #extras > 0 then
		discoveryStrip(card, extras, 404, 0.95, alive)
	end

	if not PREVIEW then
		task.delay((if reward.new then 4 else 3.4) + (if #extras > 0 then 0.4 + 0.11 * math.min(#extras, STRIP_SLOTS) else 0), close)
	end
end

local RARITY_RANK = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6 }

-- Crate reveal: rising shakes (more for rarer crates, with a halo and a soft
-- tint building up), a burst (white ring, rays, confetti; a held breath before
-- Legendary+), a quick roll through the possible units, then the reward card.
-- 1.5-3 s; tap to skip.
local function crateReveal(reward: { [string]: any }, done: () -> ())
	if PREVIEW then
		showRewardCard(reward, done)
		return
	end
	local rarity = reward.crateRarity or Economy.tierBand(reward.tier)
	local color = C.Rarity[rarity] or C.Gold
	local rank = RARITY_RANK[rarity] or 1

	local holder = Kit.new("Frame", {
		Name = "CrateReveal",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 420),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 30,
		Parent = screen,
	})
	local dim = cover(holder, "Dim", C.Ink, 0.66)
	Kit.appear(dim, { from = 1, time = 0.25 })
	local tint: Frame? = if rank >= 3 then cover(holder, "Tint", color, 1) else nil

	local beam = Kit.new("Frame", {
		Name = "Beam",
		BackgroundColor3 = Kit.lighten(color, 0.45),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(90, 0),
		Position = UDim2.fromScale(0.5, 0.55),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 1,
		Parent = holder,
	})
	Kit.corner(beam, 45)
	Kit.new("UIGradient", {
		Rotation = -90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = beam,
	})
	local halo = circle(holder, "Glow", Kit.lighten(color, 0.4), 0.7, 2)
	halo.Size = UDim2.fromOffset(170, 170)
	Kit.new("UIStroke", { Thickness = 3, Color = WHITE, Transparency = 0.45, Parent = halo })
	local crate = crateIcon(holder, color, 160, {
		Rarity = rarity,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 3,
	})
	local crateScale = Kit.new("UIScale", { Parent = crate })
	Kit.appear(crate, { from = 0.4, time = 0.3 })
	local rarityPill = Kit.pill(holder, {
		Name = "Rarity",
		Text = string.upper(rarity .. " " .. W.Chest),
		Solid = true,
		Color = color,
		TextSize = T.Small,
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.new(0.5, 0, 1, -36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 4,
	})
	Kit.appear(rarityPill, { from = 0.6, delay = 0.12 })
	local rollLabel = Kit.title(holder, {
		Name = "Roll",
		Text = "",
		TextSize = 40,
		TextScaled = true,
		MaxTextSize = 40,
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		StrokeThickness = 0,
		Visible = false,
	})
	Kit.textStroke(rollLabel, 2.5, 0)

	local skipped = false
	local finished = false
	local skipBack: Back? = nil
	local function finish()
		if finished then
			return
		end
		finished = true
		if skipBack then
			dropBack(skipBack)
		end
		Kit.disappear(holder, { to = 1.08, time = 0.2, destroy = true })
		task.delay(0.1, function()
			showRewardCard(reward, done)
		end)
	end
	catcher(holder, 6).Activated:Connect(function()
		skipped = true
		finish()
	end)
	skipBack = pushBack(30, function()
		skipped = true
		finish()
	end)
	local function pause(t: number): boolean
		task.wait(t)
		return skipped
	end

	task.spawn(function()
		-- Rising shakes: 2 for Common up to 6 for Legendary/Mythic.
		local shakes = math.min(rank + 1, 6)
		for i = 1, shakes do
			local k = i / shakes
			if pause(math.max(0.24 - i * 0.02, 0.13)) then
				return
			end
			sounds.play("CrateShake", 0.04, 0.85 + k * 0.6)
			local a = (6 + 14 * k) * (if i % 2 == 0 then 1 else -1)
			Kit.tween(crate, 0.05, { Rotation = a })
			Kit.tween(crateScale, 0.06, { Scale = 1.08 + 0.12 * k })
			task.delay(0.05, function()
				Kit.tween(crate, 0.2, { Rotation = 0 }, Enum.EasingStyle.Back)
				Kit.tween(crateScale, 0.22, { Scale = 1 + 0.06 * k }, Enum.EasingStyle.Back)
			end)
			local haloSize = 170 + (40 + rank * 12) * k
			Kit.tween(halo, 0.2, {
				BackgroundTransparency = 0.7 - (0.15 + rank * 0.03) * k,
				Size = UDim2.fromOffset(haloSize, haloSize),
			})
			if tint then
				Kit.tween(tint, 0.25, { BackgroundTransparency = 1 - (0.04 + rank * 0.015) * k })
			end
		end

		-- Legendary+: a held breath (trembling, swelling, halo growing) before the pop.
		if rank >= 5 then
			sounds.play("Ready", 0, 0.8)
			Kit.tween(crateScale, 0.7, { Scale = 1.25 }, Enum.EasingStyle.Sine)
			Kit.tween(halo, 0.7, { BackgroundTransparency = 0.3, Size = UDim2.fromOffset(320, 320) }, Enum.EasingStyle.Sine)
			local held = 0
			while held < 0.7 do
				crate.Rotation = (math.random() - 0.5) * 6
				crate.Position = UDim2.new(0.5, math.random(-2, 2), 0.5, math.random(-2, 2))
				if pause(0.04) then
					return
				end
				held += 0.04
			end
			crate.Rotation = 0
			crate.Position = UDim2.fromScale(0.5, 0.5)
		elseif pause(0.14) then
			return
		end

		-- Burst: the crate puffs away, a white ring spreads, rays and confetti.
		sounds.play("CrateBurst", 0, if rank >= 5 then 0.85 else 1)
		Kit.disappear(crate, { to = 1.6, time = 0.2, destroy = true })
		local ring = circle(holder, "Ring", WHITE, 1, 4)
		ring.Size = UDim2.fromOffset(90, 90)
		local ringStroke = Kit.new("UIStroke", { Thickness = 10, Color = WHITE, Transparency = 0.15, Parent = ring })
		local ringSize = 360 + rank * 40
		Kit.tween(ring, 0.5, { Size = UDim2.fromOffset(ringSize, ringSize) }, Enum.EasingStyle.Quart)
		Kit.tween(ringStroke, 0.5, { Transparency = 1, Thickness = 2 }, Enum.EasingStyle.Quart)
		if tint then
			Kit.tween(tint, 0.6, { BackgroundTransparency = 0.92 })
		end
		Kit.tween(beam, 0.35, { Size = UDim2.fromOffset(90 + rank * 10, 900) }, Enum.EasingStyle.Quart)
		local haloSize = 240 + rank * 15
		Kit.tween(halo, 0.3, { BackgroundTransparency = 0.55, Size = UDim2.fromOffset(haloSize, haloSize) })
		local raySize = 560 + rank * 40
		local rays = Popups.rays(holder, Kit.lighten(color, 0.5), raySize, UDim2.fromScale(0.5, 0.5), 1, 6 + rank)
		Kit.appear(rays, { from = 0.2, time = 0.4, style = Enum.EasingStyle.Quart })
		if rank >= 4 then
			local inner = Popups.rays(holder, WHITE, raySize * 0.7, UDim2.fromScale(0.5, 0.5), 1, 9, true)
			Kit.appear(inner, { from = 0.2, time = 0.45, style = Enum.EasingStyle.Quart })
		end
		Kit.pop(holder, 0.15 + 0.05 * rank)
		Kit.confetti(holder, {
			Origin = UDim2.fromScale(0.5, 0.5),
			Count = 12 + rank * 8,
			ZIndex = 4,
			Colors = { color, CANDY[1], CANDY[2], CANDY[3], CANDY[4], CANDY[7] },
			Power = 0.7 + rank * 0.12,
		})
		if pause(0.22) then
			return
		end

		-- Roll through the possible units, slowing down, then land.
		local pool = {}
		local data = State.data
		if reward.crateRarity and data then
			for _, entry in Economy.chestOdds(reward.crateRarity, data.highestTier) do
				table.insert(pool, entry.tier)
			end
		end
		if #pool < 2 then
			pool = {}
			for t = math.max(1, reward.tier - 2), math.min(Economy.MAX_TIER, reward.tier + 1) do
				table.insert(pool, t)
			end
		end
		Kit.appear(rollLabel, { from = 0.6, time = 0.18 })
		local elapsed = 0
		local step = 0.05
		local last = 0
		local pitch = 1
		while elapsed < 0.72 do
			local pick = pool[math.random(1, #pool)]
			if pick == last and #pool > 1 then
				pick = pool[(table.find(pool, pick) :: number) % #pool + 1]
			end
			last = pick
			rollLabel.Text = Theme.Tiers[pick].Name
			rollLabel.TextColor3 = Kit.lighten(C.Rarity[Economy.tierBand(pick)], 0.2)
			Kit.pop(rollLabel, 0.6)
			sounds.play("Tick", 0.05, pitch)
			pitch = math.min(pitch + 0.04, 1.4)
			if pause(step) then
				return
			end
			elapsed += step
			step *= 1.28
		end
		local final = reward.tier
		local finalBand = Economy.tierBand(final)
		rollLabel.Text = Theme.Tiers[final].Name
		rollLabel.TextColor3 = Kit.lighten(C.Rarity[finalBand], 0.25)
		rarityPill.Text = string.upper(finalBand)
		Kit.pop(rollLabel, 2.5)
		Kit.pop(rarityPill, 1)
		-- One sound per reveal: a new discovery celebrates on the card instead.
		reward._sounded = true
		if not reward.new then
			sounds.play("Reward")
		end
		if pause(0.32) then
			return
		end
		finish()
	end)
end

function Popups.reward(data: { [string]: any })
	data._at = os.clock()
	if data.source == "unlock" or data.source == "unlocker" then
		data.crate = true
	end
	if pendingChest and os.clock() - pendingChest.at <= CRATE_LINK then
		data.crate = true
		data.crateRarity = pendingChest.rarity
		pendingChest = nil
	end
	if not data.new then
		-- Ignore anything beyond a handful queued (e.g. huge cascades).
		local queued = 0
		for _, entry in queue do
			if entry.kind == "Reward" then
				queued += 1
			end
		end
		if queued >= 4 then
			return
		end
	end
	local priority = if data.new then Popups.PRIORITY.NewTier else Popups.PRIORITY.Normal
	Popups.enqueue("Reward", priority, function(done)
		if data.crate then
			crateReveal(data, done)
		else
			showRewardCard(data, done)
		end
	end, data)
end

-- Confirm dialog ---------------------------------------------------------------------------

function Popups.confirm(text: string, onYes: () -> (), options: { [string]: any }?)
	local opts = options or {}
	Popups.enqueue("Confirm", Popups.PRIORITY.Normal, function(done)
		local box, close = modal("Confirm", Vector2.new(460, 256), 50, nil, done)
		local medal = medallion(box, opts.icon or "?", C.Gold, 70, UDim2.new(0.5, 0, 0, 0))
		Kit.title(box, {
			Text = opts.title or "ARE YOU SURE?",
			TextSize = T.H2,
			TextWrapped = false,
			Size = UDim2.new(1, -30, 0, 32),
			Position = UDim2.fromOffset(15, 44),
			TextColor3 = C.Gold,
		})
		Kit.text(box, {
			Name = "Text",
			Text = text,
			TextSize = T.Body,
			Size = UDim2.new(1, -40, 0, 70),
			Position = UDim2.fromOffset(20, 80),
			StrokeThickness = 0,
		})
		local yes = Kit.button(box, {
			Text = opts.yes or "Yes",
			Color = C.Gold,
			Size = UDim2.new(0.5, -24, 0, 58),
			Position = UDim2.new(0, 16, 1, -76),
		}, function()
			close()
			onYes()
		end)
		local no = Kit.button(box, {
			Text = opts.no or "No",
			Color = C.SurfaceHi,
			Size = UDim2.new(0.5, -24, 0, 58),
			Position = UDim2.new(0.5, 8, 1, -76),
			Sound = "Close",
		}, close)
		-- Gamepad lands on the safe answer; B also answers "No".
		no:SetAttribute("FocusFirst", true)
		Kit.appear(box)
		Kit.appear(medal, { from = 0.4, time = 0.32, delay = 0.06 })
		local buttons: { GuiObject } = { yes, no }
		Kit.stagger(buttons, 0.04)
	end)
end

-- Offline earnings ---------------------------------------------------------------------------

function Popups.offline(data: { [string]: any })
	Popups.enqueue("Offline", Popups.PRIORITY.Normal, function(done)
		local box, close = modal("Offline", Vector2.new(500, 330), 45, nil, done)
		local medal = medallion(box, "💤", C.Rizz, 84, UDim2.new(0.5, 0, 0, 0))
		Kit.title(box, {
			Text = "WELCOME BACK!",
			TextSize = T.H1,
			TextWrapped = false,
			Size = UDim2.new(1, -20, 0, 36),
			Position = UDim2.fromOffset(10, 50),
			TextColor3 = C.Gold,
		})
		Kit.text(box, {
			Text = string.format("Your %s kept grinding for %s.", W.Units, Format.time(data.seconds)),
			TextSize = T.Body,
			Size = UDim2.new(1, -30, 0, 24),
			Position = UDim2.fromOffset(15, 88),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local well = Kit.well(box, { Size = UDim2.new(1, -40, 0, 66), Position = UDim2.fromOffset(20, 120) })
		local function amount(icon: string, iconColor: Color3, x: number, textColor: Color3): TextLabel
			local cell = Kit.new("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(0.42, 0, 1, 0),
				Position = UDim2.fromScale(x, 0),
				Parent = well,
			})
			Kit.icon(cell, icon, 30, iconColor, { Position = UDim2.new(0, 14, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5) })
			return Kit.number(cell, {
				Text = "0",
				TextSize = 26,
				Size = UDim2.new(1, -54, 1, 0),
				Position = UDim2.fromOffset(50, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = textColor,
				StrokeThickness = 0,
			})
		end
		local orbs = amount("Orb", C.Orb, 0, Kit.lighten(C.Orb, 0.35))
		Kit.title(well, {
			Text = "→",
			TextSize = 28,
			TextWrapped = false,
			Size = UDim2.new(0.16, 0, 1, 0),
			Position = UDim2.fromScale(0.42, 0),
			TextColor3 = C.TextMute,
			StrokeThickness = 0,
		})
		local cash = amount("Coin", C.Gold, 0.58, C.MoneyText)
		Kit.text(box, {
			Text = "Your cash is waiting on the Collect pad.",
			TextSize = T.Small,
			Size = UDim2.new(1, -40, 0, 34),
			Position = UDim2.fromOffset(20, 192),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local go = Kit.button(box, {
			Text = "Let's go!",
			Font = Theme.Fonts.Display,
			Color = C.Gold,
			Breathe = true,
			Size = UDim2.new(1, -40, 0, 58),
			Position = UDim2.new(0.5, 0, 1, -18),
			AnchorPoint = Vector2.new(0.5, 1),
		}, close)
		go:SetAttribute("FocusFirst", true)
		Kit.appear(box)
		Kit.appear(medal, { from = 0.4, time = 0.32, delay = 0.06 })
		Kit.appear(go, { from = 0.8, time = 0.26, delay = 0.14 })
		local orbTotal = tonumber(data.orbs) or 0
		local cashTotal = tonumber(data.cash) or 0
		after(0.18, function()
			Kit.countTo(orbs, 0, orbTotal, Format.short, 0.7)
		end)
		after(0.32, function()
			Kit.countTo(cash, 0, cashTotal, Format.money, 0.8)
		end)
		sounds.play("Reward")
	end)
end

-- Game mode finish ----------------------------------------------------------------------------
--[[
	The Parkour finish card: "LEVEL n CLEAR!" (or "NEW BEST!") over the level's name,
	the run time, best and today's rank, the cash reward rolling up or a
	calm "Reward again in m:ss" line while the full reward is cooling down,
	and a popping "Level n+1 unlocked!" chip when this clear opened the next level.
	Buttons: "Next level" (gold, when there is one) beside "Run again", with slim "Choose
	map" (opens the Maps window) and "Back to my gym" under them; on the last level "Run
	again" beside "Back to my gym" with a slim "Choose map" under them. `data` is the finish Notify payload (time, best, newBest, rank?, cash, full,
	cooldownEnds, level, levelName, nextLevel?, unlockedNew, assisted?). An assisted run (gear or a
	skipped stage) shows "Assisted run" instead of the best / rank line.
]]

local function runTime(seconds: number): string
	local tenths = math.floor(math.max(seconds, 0) * 10 + 0.5)
	return string.format("%d:%02d.%d", tenths // 600, (tenths // 10) % 60, tenths % 10)
end
Popups.runTime = runTime

-- A finish card's reward well: the coin and a rolling "+$N", centred as one group sized
-- for the final amount so it holds still while it counts.
local function cashRow(well: Frame, total: number): TextLabel
	local final = "+" .. Format.money(total)
	local width = 0
	pcall(function()
		local TextService = game:GetService("TextService")
		width = TextService:GetTextSize(final, 26, Kit.F.Number, Vector2.new(1000, 40)).X
	end)
	if width <= 0 then
		width = (utf8.len(final) or #final) * 16
	end
	local cell = Kit.new("Frame", {
		Name = "Cash",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 38 + math.ceil(width) + 4, 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = well,
	})
	Kit.icon(cell, "Coin", 30, C.Gold, { Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5) })
	return Kit.number(cell, {
		Text = "+0",
		TextSize = 26,
		Size = UDim2.new(1, -38, 1, 0),
		Position = UDim2.fromOffset(38, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.MoneyText,
		StrokeThickness = 0,
	})
end

function Popups.modeFinish(data: { [string]: any }, onAgain: () -> (), onHome: () -> (), onNext: (() -> ())?, onPick: (() -> ())?)
	Popups.enqueue("ModeFinish", Popups.PRIORITY.Normal, function(done)
		local cashTotal = tonumber(data.cash) or 0
		local cooling = data.full == false and (tonumber(data.cooldownEnds) or 0) > os.time()
		local level = tonumber(data.level)
		local nextLevel = tonumber(data.nextLevel)
		local hasNext = nextLevel ~= nil and onNext ~= nil
		local unlockedNew = data.unlockedNew == true and nextLevel ~= nil
		-- Height grows with the unlock chip and the third (slim) button.
		local noteY = if unlockedNew then 284 else 254
		local hasPick = onPick ~= nil
		local buttonsH = if hasNext or hasPick then 128 else 74
		local box, close = modal("ModeFinish", Vector2.new(480, noteY + 22 + 14 + buttonsH), 45, nil, done)
		local medal = medallion(box, "🏁", C.Gold, 84, UDim2.new(0.5, 0, 0, 0))
		Kit.title(box, {
			Text = if data.newBest and data.assisted ~= true
				then "NEW BEST!"
				elseif level then "LEVEL " .. tostring(level) .. " CLEAR!"
				else "COURSE CLEAR!",
			TextSize = T.H1,
			TextWrapped = false,
			Size = UDim2.new(1, -20, 0, 34),
			Position = UDim2.fromOffset(10, 48),
			TextColor3 = C.Gold,
		})
		local levelLine = if type(data.levelName) == "string" then data.levelName else ""
		if level and data.newBest and data.assisted ~= true then
			levelLine = "Level " .. tostring(level) .. (if levelLine ~= "" then "  ·  " .. levelLine else "")
		end
		Kit.text(box, {
			Name = "LevelName",
			Text = levelLine,
			Font = Kit.F.UI,
			TextSize = T.Body,
			TextWrapped = false,
			Size = UDim2.new(1, -30, 0, 22),
			Position = UDim2.fromOffset(15, 82),
			TextColor3 = C.Text,
			StrokeThickness = 0,
		})
		local timeLabel = Kit.number(box, {
			Text = runTime(tonumber(data.time) or 0),
			TextSize = 44,
			Size = UDim2.new(1, -20, 0, 48),
			Position = UDim2.fromOffset(10, 106),
			TextColor3 = C.Text,
		})
		-- An assisted run (gear or a skipped stage) never sets a best or a board entry.
		local assisted = data.assisted == true
		local sub = "Best " .. runTime(tonumber(data.best) or tonumber(data.time) or 0)
		if type(data.rank) == "number" then
			sub ..= "  ·  #" .. tostring(data.rank) .. " today"
		end
		Kit.text(box, {
			Name = if assisted then "Assisted" else "Best",
			Text = if assisted then "Assisted run" else sub,
			Font = if assisted then Kit.F.UI else nil,
			TextSize = T.Body,
			Size = UDim2.new(1, -30, 0, 22),
			Position = UDim2.fromOffset(15, 156),
			TextColor3 = if assisted then C.Rizz else C.TextDim,
			StrokeThickness = 0,
		})
		local well = Kit.well(box, { Size = UDim2.new(1, -40, 0, 62), Position = UDim2.fromOffset(20, 184) })
		-- Runs inside the reward cooldown pay nothing: no empty "+$0" row.
		well.Visible = cashTotal > 0
		local cashLabel = cashRow(well, cashTotal)
		local note = Kit.text(box, {
			Text = if cooling
				then "Reward again in " .. Format.time(math.max(0, data.cooldownEnds - os.time()))
				else "Nice run! Try to beat your best.",
			TextSize = T.Small,
			Size = UDim2.new(1, -40, 0, 22),
			Position = UDim2.fromOffset(20, noteY),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local unlockChip: TextLabel? = nil
		if unlockedNew then
			unlockChip = Kit.pill(box, {
				Name = "Unlocked",
				Text = "Level " .. tostring(nextLevel) .. " unlocked!",
				Font = Theme.Fonts.Display,
				TextSize = T.Small,
				Color = C.Good,
				Solid = true,
				Size = UDim2.fromOffset(200, 26),
				Position = UDim2.new(0.5, 0, 0, 252),
				AnchorPoint = Vector2.new(0.5, 0),
				ZIndex = 3,
			})
		end
		-- With a next level: [Next level] [Run again] and a slim "Back to my gym" below.
		local rowY = if hasNext or hasPick then -128 else -74
		local nextButton: TextButton? = nil
		if hasNext then
			nextButton = Kit.button(box, {
				Name = "Next",
				Text = "Next level ▶",
				Font = Theme.Fonts.Display,
				Color = C.Gold,
				Breathe = true,
				Size = UDim2.new(0.5, -26, 0, 56),
				Position = UDim2.new(0, 20, 1, rowY),
			}, function()
				close()
				if onNext then
					onNext()
				end
			end)
		end
		local again = Kit.button(box, {
			Text = "Run again",
			Font = Theme.Fonts.Display,
			Color = if hasNext then C.SurfaceHi else C.Gold,
			Breathe = not hasNext,
			Size = UDim2.new(0.5, -26, 0, 56),
			Position = if hasNext then UDim2.new(0.5, 6, 1, rowY) else UDim2.new(0, 20, 1, rowY),
		}, function()
			close()
			onAgain()
		end)
		-- Slim second row: [Choose map] [Back to my gym] with a next level, else a full-width
		-- [Choose map] under [Run again] [Back to my gym].
		local homeSize = UDim2.new(0.5, -26, 0, 56)
		local homePos = UDim2.new(0.5, 6, 1, rowY)
		if hasNext then
			homeSize = if hasPick then UDim2.new(0.5, -26, 0, 42) else UDim2.new(1, -40, 0, 42)
			homePos = if hasPick then UDim2.new(0.5, 6, 1, -60) else UDim2.new(0, 20, 1, -60)
		end
		local home = Kit.button(box, {
			Text = "Back to my gym",
			Color = C.SurfaceHi,
			TextSize = if hasNext then T.Body else nil,
			Size = homeSize,
			Position = homePos,
		}, function()
			close()
			onHome()
		end)
		local pick: TextButton? = nil
		if onPick then
			pick = Kit.button(box, {
				Name = "ChooseMap",
				Text = "Choose map",
				Color = C.SurfaceHi,
				TextSize = T.Body,
				Size = if hasNext then UDim2.new(0.5, -26, 0, 42) else UDim2.new(1, -40, 0, 42),
				Position = UDim2.new(0, 20, 1, -60),
			}, function()
				close()
				onPick()
			end)
		end
		-- Gamepad starts on the loud button; B is "Back to my gym".
		local primary: GuiObject = nextButton or again
		primary:SetAttribute("FocusFirst", true)
		onBack(close, function()
			close()
			onHome()
		end)
		Kit.appear(box)
		Kit.appear(medal, { from = 0.4, time = 0.32, delay = 0.06 })
		if nextButton then
			Kit.appear(nextButton, { from = 0.8, time = 0.26, delay = 0.12 })
		end
		Kit.appear(again, { from = 0.8, time = 0.26, delay = 0.14 })
		Kit.appear(home, { from = 0.8, time = 0.26, delay = 0.18 })
		if pick then
			Kit.appear(pick, { from = 0.8, time = 0.26, delay = 0.2 })
		end
		if unlockChip then
			local chip = unlockChip
			chip.Visible = false
			after(0.7, function()
				chip.Visible = true
				Kit.pop(chip, 1.3)
				sounds.play("BuyPop")
			end)
		end
		Kit.confetti(box, { Origin = UDim2.fromScale(0.5, 0.1), Count = 24, ZIndex = 60 })
		after(0.12, function()
			Kit.pop(timeLabel, 1.2)
		end)
		after(0.25, function()
			Kit.countTo(cashLabel, 0, cashTotal, function(n)
				return "+" .. Format.money(n)
			end, 0.8)
		end)
		if cooling then
			-- The countdown line ticks while the card is up.
			task.spawn(function()
				while note.Parent do
					local left = (tonumber(data.cooldownEnds) or 0) - os.time()
					note.Text = if left > 0 then "Reward again in " .. Format.time(left) else "Reward ready next run!"
					task.wait(1)
				end
			end)
		end
		sounds.play("Reward")
	end)
end

--[[
	The MOG TEST finish card, in the same language as the Parkour one: the score,
	"NEW BEST!", rivals mogged, best and today's rank, the reward rolling up or the
	"Reward again in m:ss" line while the full reward cools down. "Mog again" and
	"Back to my gym". `data` is the mog finish Notify payload (score, rivals, best,
	newBest, passed, cash, full, cooldownEnds, rank?).

	A 1v1 duel (data.vs == "pvp": won, reason "ko" | "forfeit", opponent { userId, name },
	score, wins, played, cash, full, cooldownEnds) uses the same card: "YOU MOGGED
	<name>!" in gold or "<name> MOGGED YOU" in red, duels won / played, the reward (the
	winner's) and "Duel again" instead of "Mog again".
]]
function Popups.mogFinish(data: { [string]: any }, onAgain: () -> (), onHome: () -> ())
	Popups.enqueue("MogFinish", Popups.PRIORITY.Normal, function(done)
		local score = tonumber(data.score) or 0
		local cashTotal = tonumber(data.cash) or 0
		local cooling = data.full == false and (tonumber(data.cooldownEnds) or 0) > os.time()
		local duel = data.vs == "pvp"
		local won = duel and data.won == true
		local foe = if duel and type(data.opponent) == "table" then tostring(data.opponent.name or "Opponent") else "Opponent"
		local box, close = modal("MogFinish", Vector2.new(480, 380), 45, nil, done)
		local medal = medallion(
			box,
			if duel and not won then "😤" else "💪",
			if duel and not won then C.Bad else C.Gold,
			84,
			UDim2.new(0.5, 0, 0, 0)
		)
		Kit.title(box, {
			Text = if duel
				then (if won then "YOU MOGGED " .. string.upper(foe) .. "!" else string.upper(foe) .. " MOGGED YOU")
				elseif data.newBest then "NEW BEST!"
				else "MOG TEST OVER",
			TextScaled = duel,
			TextSize = T.H1,
			TextWrapped = false,
			Size = UDim2.new(1, -20, 0, 34),
			Position = UDim2.fromOffset(10, 48),
			TextColor3 = if duel and not won then C.Bad else C.Gold,
		})
		local scoreLabel = Kit.number(box, {
			Text = "0",
			TextSize = 44,
			Size = UDim2.new(1, -20, 0, 48),
			Position = UDim2.fromOffset(10, 84),
			TextColor3 = C.Text,
		})
		local sub = "Rivals mogged " .. tostring(tonumber(data.rivals) or 0)
		sub ..= "  ·  Best " .. Format.short(math.max(tonumber(data.best) or 0, score))
		if duel then
			sub = "Duels won " .. tostring(tonumber(data.wins) or 0) .. "  ·  Played " .. tostring(tonumber(data.played) or 0)
		elseif type(data.rank) == "number" then
			sub ..= "  ·  #" .. tostring(data.rank) .. " today"
		end
		Kit.text(box, {
			Text = sub,
			TextSize = T.Body,
			Size = UDim2.new(1, -30, 0, 22),
			Position = UDim2.fromOffset(15, 134),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local well = Kit.well(box, { Size = UDim2.new(1, -40, 0, 62), Position = UDim2.fromOffset(20, 164) })
		well.Visible = cashTotal > 0
		local cashLabel = cashRow(well, cashTotal)
		local note = Kit.text(box, {
			Text = if duel and data.reason == "forfeit"
				then (if won then foe .. " left the duel. The win is yours!" else "You left the duel.")
				elseif duel and not won then "So close! Hit PERFECT to deal double damage."
				elseif cooling then "Reward again in " .. Format.time(math.max(0, data.cooldownEnds - os.time()))
				elseif duel then "Total mog! Can you win another?"
				elseif data.passed then "MOG TEST PASSED! Can you mog even more?"
				else "Nice try! Mog more rivals to pass.",
			TextSize = T.Small,
			Size = UDim2.new(1, -40, 0, 22),
			Position = UDim2.fromOffset(20, 232),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local again = Kit.button(box, {
			Text = if duel then "Duel again" else "Mog again",
			Font = Theme.Fonts.Display,
			Color = C.Gold,
			Breathe = true,
			Size = UDim2.new(0.5, -26, 0, 56),
			Position = UDim2.new(0, 20, 1, -74),
		}, function()
			close()
			onAgain()
		end)
		local home = Kit.button(box, {
			Text = "Back to my gym",
			Color = C.SurfaceHi,
			Size = UDim2.new(0.5, -26, 0, 56),
			Position = UDim2.new(0.5, 6, 1, -74),
		}, function()
			close()
			onHome()
		end)
		again:SetAttribute("FocusFirst", true)
		onBack(close, function()
			close()
			onHome()
		end)
		Kit.appear(box)
		Kit.appear(medal, { from = 0.4, time = 0.32, delay = 0.06 })
		Kit.appear(again, { from = 0.8, time = 0.26, delay = 0.14 })
		Kit.appear(home, { from = 0.8, time = 0.26, delay = 0.18 })
		if data.newBest or data.passed or won then
			Kit.confetti(box, { Origin = UDim2.fromScale(0.5, 0.1), Count = 24, ZIndex = 60 })
		end
		after(0.1, function()
			Kit.countTo(scoreLabel, 0, score, Format.short, 0.6)
		end)
		after(0.72, function()
			Kit.pop(scoreLabel, 1.2)
		end)
		after(0.25, function()
			Kit.countTo(cashLabel, 0, cashTotal, function(n)
				return "+" .. Format.money(n)
			end, 0.8)
		end)
		if cooling and not (duel and (not won or data.reason == "forfeit")) then
			task.spawn(function()
				while note.Parent do
					local left = (tonumber(data.cooldownEnds) or 0) - os.time()
					note.Text = if left > 0 then "Reward again in " .. Format.time(left) else "Reward ready next run!"
					task.wait(1)
				end
			end)
		end
		sounds.play("Reward")
	end)
end

--[[
	The MOG TEST picker, opened by walking through the mog gate (Notify "choose") or the
	Modes window's PLAY: two big cards side by side. VS RIVALS (solo: mog 3 rival chads to
	pass) and 1v1 DUEL (out-mog a real player; hit = 1 damage, perfect = 2, a miss hurts
	you; the winner takes the reward). Each card's button closes the picker and runs its
	callback; the backdrop just closes it. `onClosed` runs once the picker is gone either way.
]]
function Popups.mogChoose(onRivals: () -> (), onPvp: () -> (), onClosed: (() -> ())?)
	Popups.enqueue("MogChoose", Popups.PRIORITY.Normal, function(done)
		local box, close = modal("MogChoose", Vector2.new(560, 374), 45, nil, function()
			done()
			if onClosed then
				onClosed()
			end
		end)
		-- The badge sits astride the card's top edge (raised a little so its lip and
		-- shadow clear the title below).
		local medal = medallion(box, "💪", C.Gold, 84, UDim2.new(0.5, 0, 0, -8))
		Kit.title(box, {
			Text = "MOG TEST",
			TextSize = T.H1,
			TextWrapped = false,
			Size = UDim2.new(1, -20, 0, 34),
			Position = UDim2.fromOffset(10, 56),
			TextColor3 = C.Gold,
		})
		Kit.text(box, {
			Text = "Who do you want to mog?",
			TextSize = T.Body,
			Size = UDim2.new(1, -30, 0, 22),
			Position = UDim2.fromOffset(15, 92),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local function card(
			x: number,
			icon: string,
			color: Color3,
			title: string,
			blurb: string,
			label: string,
			pick: () -> ()
		): (Frame, TextButton)
			local panel = Kit.panel(box, {
				Name = title,
				Elevated = true,
				Size = UDim2.new(0.5, -28, 0, 226),
				Position = UDim2.new(x, if x == 0 then 20 else 8, 0, 128),
				Radius = Kit.RADIUS.L,
				StrokeThickness = 3,
				StrokeColor = color,
				ZIndex = 46,
			})
			Kit.title(panel, {
				Text = icon,
				TextSize = 44,
				Size = UDim2.new(1, 0, 0, 52),
				Position = UDim2.fromOffset(0, 8),
				StrokeThickness = 0,
				ZIndex = 47,
			})
			Kit.title(panel, {
				Text = title,
				TextSize = 26,
				TextWrapped = false,
				TextColor3 = color,
				Size = UDim2.new(1, -16, 0, 30),
				Position = UDim2.fromOffset(8, 62),
				ZIndex = 47,
			})
			Kit.text(panel, {
				-- Full-white body text: TextDim at Small size was too faint on the card.
				Text = blurb,
				TextSize = T.Small + 2,
				TextColor3 = C.Text,
				Size = UDim2.new(1, -20, 0, 62),
				Position = UDim2.fromOffset(10, 94),
				StrokeThickness = 0,
				ZIndex = 47,
			})
			local button = Kit.button(panel, {
				Text = label,
				Font = Theme.Fonts.Display,
				Color = color,
				Size = UDim2.new(1, -24, 0, 52),
				Position = UDim2.new(0, 12, 1, -64),
				ZIndex = 48,
			}, function()
				close()
				pick()
			end)
			return panel, button
		end
		local rivals, rivalsGo = card(0, "🏋️", C.Gold, "VS RIVALS", "Solo: mog 3 rival chads to pass the test!", "PLAY", onRivals)
		local duel, duelGo =
			card(0.5, "⚔️", C.Bad, "1v1 DUEL", "Out-mog a real player! PERFECT hits twice. Winner gets the reward.", "FIND DUEL", onPvp)
		Kit.breathe(duelGo)
		rivalsGo:SetAttribute("FocusFirst", true)
		Kit.appear(box)
		Kit.appear(medal, { from = 0.4, time = 0.32, delay = 0.06 })
		Kit.appear(rivals, { from = 0.8, time = 0.26, delay = 0.1 })
		Kit.appear(duel, { from = 0.8, time = 0.26, delay = 0.16 })
		Kit.appear(rivalsGo, { from = 0.8, time = 0.24, delay = 0.2 })
		sounds.play("Toast")
	end)
end

-- Starter pack -------------------------------------------------------------------------------
--[[
	The one-time Starter pack offer and the card that celebrates the grant.
	The offer shows at most once per session, only to players who do not own the
	pack: a few seconds after the tutorial finishes, or a minute after joining for
	returning players. It waits while the intro plays, while a window, another
	popup or the held-crate panel is up, and for a few calm seconds after a popup
	closes. A plain close button, no timers.
]]

local STARTER = Theme.Cosmetics.Starter
local OFFER_AFTER_JOIN = 60
local OFFER_AFTER_TUTORIAL = 6
local CALM = 4

-- The two things in the pack in a well: cash and the Rookie Trail. Returns the cash
-- amount label and the trail's icon (for the celebration's pop-in).
local function starterContents(box: Frame, y: number, trailCaption: string): (TextLabel, Frame)
	local well = Kit.well(box, { Name = "Contents", Size = UDim2.new(1, -40, 0, 100), Position = UDim2.fromOffset(20, y) })
	local function cell(
		index: number,
		icon: string,
		fallback: string,
		color: Color3,
		textColor: Color3,
		caption: string
	): (TextLabel, Frame)
		local holder = Kit.new("Frame", {
			Name = "Item" .. index,
			BackgroundTransparency = 1,
			Size = UDim2.new(1 / 2, 0, 1, 0),
			Position = UDim2.fromScale((index - 1) / 2, 0),
			Parent = well,
		})
		local art = Kit.icon(holder, Kit.pickIcon(icon, fallback), 46, color, {
			Name = "Icon",
			Position = UDim2.new(0.5, 0, 0, 6),
			AnchorPoint = Vector2.new(0.5, 0),
		})
		local amount = Kit.number(holder, {
			Name = "Amount",
			Text = "",
			TextSize = 22,
			MaxTextSize = 22,
			TextScaled = true,
			Size = UDim2.new(1, -16, 0, 24),
			Position = UDim2.fromOffset(8, 54),
			TextColor3 = textColor,
			StrokeThickness = 0,
		})
		Kit.text(holder, {
			Name = "Caption",
			Text = caption,
			TextSize = T.Small,
			TextWrapped = false,
			Size = UDim2.new(1, -12, 0, 18),
			Position = UDim2.fromOffset(6, 77),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		return amount, art
	end
	local cash = cell(1, "Coin", "Coin", C.Gold, C.MoneyText, "cash")
	local item = Theme.Cosmetics.Items[STARTER.Item]
	local trail, trailArt = cell(2, item.Icon, "Star", item.Color, C.Text, trailCaption)
	trail.Text = item.Title
	return cash, trailArt
end

-- The pack's art standing over the top edge of a modal, with slow mint rays behind the box.
local function starterArt(box: Frame, size: number): Frame
	local holder = box.Parent :: Frame
	local top = (holder.Size.Y.Offset - box.Size.Y.Offset) / 2
	local rays = Popups.rays(holder, World.Mint, size * 2.2, UDim2.new(0.5, 0, 0, top - 4), 1, 7)
	rays.ZIndex = 0
	Kit.appear(rays, { from = 0.3, time = 0.5, style = Enum.EasingStyle.Quart })
	local art = Kit.icon(box, Kit.pickIcon(STARTER.Icon, "Star"), size, C.Gold, {
		Name = "Art",
		Position = UDim2.new(0.5, 0, 0, -4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 4,
	})
	return art
end

-- A round coral X in the top-right corner of a modal (52 px hit area).
local function closeButton(box: Frame, onClick: () -> ()): TextButton
	local close = Kit.button(box, {
		Name = "Close",
		Icon = "Close",
		IconColor = C.Text,
		Color = C.Danger,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -12, 0, 12),
		AnchorPoint = Vector2.new(1, 0),
		Radius = 20,
		Depth = 4,
		Sound = "Close",
		ZIndex = 5,
	}, onClick)
	local face = Kit.buttonFace(close)
	local icon = face and face:FindFirstChild("Icon")
	if icon and icon:IsA("GuiObject") then
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
	end
	Kit.hitArea(close, 52, function()
		Kit.sound("Close")
		onClick()
	end)
	return close
end

-- The offer: what is inside (with this player's own amounts), the price and "Not now".
function Popups.starterOffer()
	Popups.enqueue("StarterOffer", Popups.PRIORITY.Normal, function(done)
		local data = State.data
		if not data or Windows.cosmeticsOf(data).starterOwned == true then
			done()
			return
		end
		local pass = Theme.Monetization.Passes[STARTER.Pass]
		local box, close = modal("StarterOffer", Vector2.new(520, 360), 47, nil, done)
		local art = starterArt(box, 132)
		Kit.title(box, {
			Name = "Title",
			Text = "STARTER PACK",
			TextSize = T.H1,
			TextWrapped = false,
			Size = UDim2.new(1, -120, 0, 36),
			Position = UDim2.fromOffset(60, 70),
			TextColor3 = C.Gold,
		})
		Kit.text(box, {
			Name = "Text",
			Text = "A head start for your gym, once per player.",
			TextSize = T.Body,
			TextWrapped = false,
			Size = UDim2.new(1, -40, 0, 22),
			Position = UDim2.fromOffset(20, 108),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local cash = starterContents(box, 142, "only in this pack")
		cash.Text = State.money(Windows.starterAmounts(data))
		local buy = Kit.button(box, {
			Name = "Buy",
			Text = Kit.ROBUX .. " " .. tostring(pass.Price),
			Font = Theme.Fonts.Number,
			Color = C.Gold,
			Shimmer = true,
			Size = UDim2.new(0.5, -24, 0, 58),
			Position = UDim2.new(0, 16, 1, -76),
		}, function()
			close()
			Net.event("Action"):FireServer({ action = "PromptPass", name = STARTER.Pass })
		end)
		buy:SetAttribute("FocusFirst", true)
		local later = Kit.button(box, {
			Name = "Later",
			Text = "Not now",
			Color = C.SurfaceHi,
			Size = UDim2.new(0.5, -24, 0, 58),
			Position = UDim2.new(0.5, 8, 1, -76),
			Sound = "Close",
		}, close)
		local x = closeButton(box, close)
		Kit.appear(box)
		Kit.appear(art, { from = 0.4, time = 0.34, delay = 0.06 })
		local buttons: { GuiObject } = { buy, later, x }
		Kit.stagger(buttons, 0.04)
	end)
end

-- The grant landed: what the pack gave, cash rolling up and the trail popping in.
function Popups.starter(data: { [string]: any })
	-- Never over the intro: hold the card until it has finished.
	local player = Players.LocalPlayer
	if not PREVIEW and player and player:GetAttribute("IntroPlaying") == true then
		task.spawn(function()
			while player:GetAttribute("IntroPlaying") == true do
				task.wait(0.5)
			end
			task.wait(1)
			Popups.starter(data)
		end)
		return
	end
	Popups.enqueue("Starter", Popups.PRIORITY.Normal, function(done)
		local box, close = modal("StarterDone", Vector2.new(520, 344), 47, nil, done)
		local art = starterArt(box, 132)
		Kit.title(box, {
			Name = "Title",
			Text = "STARTER PACK UNLOCKED!",
			TextSize = T.H1,
			MaxTextSize = T.H1,
			TextScaled = true,
			TextWrapped = false,
			Size = UDim2.new(1, -60, 0, 36),
			Position = UDim2.fromOffset(30, 70),
			TextColor3 = C.Gold,
		})
		Kit.text(box, {
			Name = "Text",
			Text = "Thanks for the support! Here is what you got:",
			TextSize = T.Body,
			TextWrapped = false,
			Size = UDim2.new(1, -40, 0, 22),
			Position = UDim2.fromOffset(20, 108),
			TextColor3 = C.TextDim,
			StrokeThickness = 0,
		})
		local cash, trailArt = starterContents(box, 142, "now in your shop")
		cash.Text = State.money(0)
		local go = Kit.button(box, {
			Name = "Go",
			Text = "Awesome!",
			Font = Theme.Fonts.Display,
			Color = C.Gold,
			Breathe = true,
			Size = UDim2.new(1, -40, 0, 58),
			Position = UDim2.new(0.5, 0, 1, -18),
			AnchorPoint = Vector2.new(0.5, 1),
		}, close)
		go:SetAttribute("FocusFirst", true)
		Kit.appear(box)
		Kit.appear(art, { from = 0.4, time = 0.34, delay = 0.06 })
		Kit.appear(go, { from = 0.8, time = 0.26, delay = 0.2 })
		local cashTotal = tonumber(data.cash) or 0
		after(0.2, function()
			Kit.countTo(cash, 0, cashTotal, State.money, 0.8)
		end)
		trailArt.Visible = false
		after(0.6, function()
			Kit.appear(trailArt, { from = 0.3, time = 0.34 })
			after(0.36, function()
				Kit.pop(trailArt, 1.4)
			end)
		end)
		if not PREVIEW then
			Kit.confetti(box, { Origin = UDim2.fromScale(0.5, 0.1), Count = 28, ZIndex = 60 })
		end
		sounds.play("Reward")
	end)
end

-- Finds a calm moment for the one Starter offer of this session (see the header above).
local function watchStarterOffer()
	if PREVIEW then
		return
	end
	local player = Players.LocalPlayer
	local eligibleAt: number? = nil
	local first = true
	local sawTutorial = false
	State.changed.Event:Connect(function(data)
		if eligibleAt then
			return
		end
		if first then
			first = false
			if data.tutorialDone == true then
				eligibleAt = os.clock() + OFFER_AFTER_JOIN
				return
			end
			sawTutorial = true
		elseif sawTutorial and data.tutorialDone == true then
			eligibleAt = os.clock() + OFFER_AFTER_TUTORIAL
		end
	end)
	task.spawn(function()
		while true do
			task.wait(2)
			local data = State.data
			if data and Windows.cosmeticsOf(data).starterOwned == true then
				return
			end
			local now = os.clock()
			local calm = data ~= nil
				and eligibleAt ~= nil
				and now >= eligibleAt
				and not busy
				and #queue == 0
				and now - lastModalAt >= CALM
				and screen:GetAttribute("WindowOpen") ~= true
				and player:GetAttribute("IntroPlaying") ~= true
				and data.heldChest == nil
			if calm then
				Popups.starterOffer()
				return
			end
		end
	end)
end

-- Held crate panel -----------------------------------------------------------------------------

--[[
	Side panel while the player carries a crate: rarity header, the crate, the
	odds (a scrolling list of rarity-dot rows; bars fill), then one primary
	"Open now" button, the free route as a plain line, a quiet text link to the
	Crate Master pass, and at the bottom (well apart from "Open now") a red
	Discard button (discards at once, any rarity). The "ChestPanel" holder carries the compact-mode
	UIScale; the "Card" inside eases in and out with Kit.appear / Kit.disappear.
	While it is up the ScreenGui attribute "CratePanelOpen" is true (the held
	crate's world chip hides then, so the two labels never show together).
]]
local function buildChestPanel()
	local action = Net.event("Action")
	-- Card geometry: header band, crate, odds well, then the button rows from BUTTON_Y.
	local PANEL_W = 320
	local ODDS_Y = 172
	local ODDS_H = 128
	local BUTTON_Y = ODDS_Y + ODDS_H + 12
	local holder = Kit.new("Frame", {
		Name = "ChestPanel",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(PANEL_W, 440),
		Position = UDim2.new(1, -12, 0.5, 30),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = screen,
	})
	local compactScale = Kit.new("UIScale", { Name = "Compact", Parent = holder })
	local panel = Kit.panel(holder, {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		StrokeThickness = 2,
		Radius = Kit.RADIUS.XL,
	})
	local band = Kit.new("Frame", {
		Name = "Band",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -16, 0, 46),
		Position = UDim2.fromOffset(8, 8),
		Parent = panel,
	})
	Kit.corner(band, Kit.RADIUS.L)
	local bandStroke = Kit.stroke(band, 2, Kit.lip(C.Gold))
	local bandGradient = Kit.gradient(band, C.Gold, C.Gold)
	local bandShine = Kit.new("Frame", {
		Name = "Highlight",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Size = UDim2.new(1, -28, 0, 2),
		Position = UDim2.fromOffset(14, 3),
		Parent = band,
	})
	Kit.round(bandShine)
	local title = Kit.title(band, {
		Text = "",
		TextSize = T.H2,
		TextWrapped = false,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 1),
		StrokeThickness = 0,
	})

	local halo = Kit.new("Frame", {
		Name = "IconGlow",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(88, 88),
		Position = UDim2.new(0.5, 0, 0, 102),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = panel,
	})
	Kit.round(halo)
	local crate: Frame? = nil

	Kit.title(panel, {
		Text = "POSSIBLE " .. string.upper(W.Units),
		Font = Theme.Fonts.UI,
		TextSize = T.Small,
		TextWrapped = false,
		Size = UDim2.new(1, -28, 0, 18),
		Position = UDim2.fromOffset(14, ODDS_Y - 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.TextDim,
		StrokeThickness = 0,
	})
	local oddsWell = Kit.well(panel, { Name = "Odds", Size = UDim2.new(1, -24, 0, ODDS_H), Position = UDim2.fromOffset(12, ODDS_Y) })
	local odds = Kit.scrolling(oddsWell, { Name = "List", Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4) })
	Kit.padding(odds, 2, 4)
	Kit.list(odds, 3)

	-- Instant open: free for Crate Master owners ("owner"); otherwise one developer
	-- product (same price for every rarity) with the Crate Master pass as a quiet text
	-- link under it ("buy"). Both purchases are hidden where paid random items are not
	-- allowed ("none"). The free route is always a plain readable line.
	local crateOpen = Theme.Monetization.CrateOpen
	local crateKey = Theme.Monetization.Passes.CrateKey
	local mode = "none"
	local openButton = Kit.button(panel, {
		Name = "OpenNow",
		Text = "Open now",
		Color = C.Gold,
		Size = UDim2.new(1, -24, 0, 56),
		Position = UDim2.fromOffset(12, BUTTON_Y),
		TextSize = 24,
	}, function()
		action:FireServer({ action = "OpenCrateNow" })
	end)
	openButton:SetAttribute("FocusFirst", true)
	local masterTag = Kit.pill(panel, {
		Name = "MasterTag",
		Text = string.upper(crateKey.Title),
		Color = crateKey.Color,
		Solid = true,
		TextSize = T.Small,
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(PANEL_W - 8, BUTTON_Y - 10),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 6,
		Visible = false,
	})
	local crackerName = string.gsub(string.lower(W.Unlocker), "%f[%a]%a", string.upper)
	local freeLine = Kit.text(panel, {
		Name = "FreeRoute",
		Text = "Carry it to a " .. crackerName .. ": free",
		TextSize = T.Small,
		Size = UDim2.new(1, -32, 0, 22),
		Position = UDim2.fromOffset(16, BUTTON_Y + 64),
		TextColor3 = C.Text,
		StrokeThickness = 0,
	})
	-- Quiet text link: the pass that opens every crate free.
	local function textLink(
		name: string,
		text: string,
		color: Color3,
		hover: Color3,
		y: number,
		width: number,
		onClick: () -> ()
	): TextButton
		local link = Kit.new("TextButton", {
			Name = name,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			RichText = true,
			Text = "<u>" .. text .. "</u>",
			Font = Theme.Fonts.UI,
			TextSize = T.Small,
			TextColor3 = color,
			Size = UDim2.fromOffset(width, 30),
			Position = UDim2.new(0.5, 0, 0, y),
			AnchorPoint = Vector2.new(0.5, 0),
			Parent = panel,
		})
		Kit.bouncy(link, 1.04)
		local function lit(on: boolean)
			Kit.tween(link, 0.12, { TextColor3 = if on then hover else color })
		end
		link.MouseEnter:Connect(function()
			lit(true)
		end)
		link.MouseLeave:Connect(function()
			lit(false)
		end)
		link.SelectionGained:Connect(function()
			lit(true)
		end)
		link.SelectionLost:Connect(function()
			lit(false)
		end)
		link.Activated:Connect(onClick)
		-- The link reads 30 px tall; its tap area is 44 (an invisible strip over it).
		local hit = Kit.new("TextButton", {
			Name = "Hit",
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Selectable = false,
			Text = "",
			Size = UDim2.new(1, 0, 0, 44),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = link.ZIndex + 1,
			Parent = link,
		})
		hit.Activated:Connect(onClick)
		return link
	end
	local passLink = textLink(
		"BuyCrateMaster",
		"Open every crate free  " .. Kit.ROBUX .. " " .. crateKey.Price,
		C.TextDim,
		C.GoldLight,
		BUTTON_Y + 88,
		PANEL_W - 40,
		function()
			Kit.sound("Click")
			action:FireServer({ action = "PromptPass", name = "CrateKey" })
		end
	)
	-- Discard: a red button at the bottom of the card, DISCARD_GAP below the rows above it.
	-- It discards the held crate at once, whatever its rarity.
	local DISCARD_H, DISCARD_GAP = 44, 14
	local discard = Kit.button(panel, {
		Name = "Discard",
		Text = "Discard",
		Icon = "Close",
		IconColor = WHITE,
		TextColor = WHITE,
		Color = C.Danger,
		Size = UDim2.fromOffset(150, DISCARD_H),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, BUTTON_Y + 48 + DISCARD_GAP),
		TextSize = T.Body,
		Sound = "Close",
	}, function()
		action:FireServer({ action = "DiscardChest" })
	end)

	-- Lays the panel out for `newMode` (rows from BUTTON_Y down): the open button, the
	-- free-route line, the pass link (buy only), Discard. Without an open button the
	-- free route takes the button's place at body size.
	local function setMode(newMode: string)
		if newMode == mode then
			return
		end
		local wasButton = mode ~= "none"
		mode = newMode
		local hasButton = newMode ~= "none"
		local buying = newMode == "buy"
		if hasButton and not wasButton then
			Kit.appear(openButton, { from = 0.9, time = 0.2 })
		elseif not hasButton and wasButton then
			Kit.disappear(openButton)
		end
		if newMode == "owner" then
			Kit.setButton(openButton, "Open now")
			Kit.appear(masterTag, { from = 0.6, time = 0.25 })
		else
			Kit.setButton(openButton, "Open now   " .. Kit.ROBUX .. " " .. crateOpen.Price)
			if masterTag.Visible then
				Kit.disappear(masterTag)
			end
		end
		if buying then
			Kit.appear(passLink, { from = 0.9, time = 0.2, delay = 0.05 })
		elseif passLink.Visible then
			Kit.disappear(passLink)
		end
		local y = BUTTON_Y
		if hasButton then
			y += 56 + 8
		end
		local freeHeight = if hasButton then 22 else 44
		Kit.tween(freeLine, 0.25, {
			Position = UDim2.fromOffset(16, y),
			Size = UDim2.new(1, -32, 0, freeHeight),
			TextSize = if hasButton then T.Small else T.Body,
		})
		y += freeHeight + 4
		if buying then
			passLink.Position = UDim2.new(0.5, 0, 0, y)
			y += 30 + 2
		end
		y += DISCARD_GAP
		Kit.tween(discard, 0.25, { Position = UDim2.new(0.5, 0, 0, y) })
		Kit.tween(holder, 0.25, { Size = UDim2.fromOffset(PANEL_W, y + DISCARD_H + 12) })
	end
	openButton.Visible = false
	passLink.Visible = false
	freeLine.Position = UDim2.fromOffset(16, BUTTON_Y)
	freeLine.Size = UDim2.new(1, -32, 0, 44)
	freeLine.TextSize = T.Body
	holder.Size = UDim2.fromOffset(PANEL_W, BUTTON_Y + 48 + DISCARD_GAP + DISCARD_H + 12)

	local function fullScale(): number
		return if screen:GetAttribute("Compact") == true then 0.8 else 1
	end
	screen:GetAttributeChangedSignal("Compact"):Connect(function()
		compactScale.Scale = fullScale()
	end)
	compactScale.Scale = fullScale()

	local function fillOdds(rarity: string, highestTier: number)
		for _, child in odds:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local rows: { GuiObject } = {}
		for order, entry in Economy.chestOdds(rarity, highestTier) do
			local row = Kit.new("Frame", {
				Name = "Odds" .. order,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 24),
				LayoutOrder = order,
				Parent = odds,
			})
			local tierBand = Economy.tierBand(entry.tier)
			local tierColor = C.Rarity[tierBand] or C.Gold
			local bar = Kit.new("Frame", {
				Name = "Bar",
				BackgroundColor3 = tierColor,
				BackgroundTransparency = 0.7,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(0, 1),
				Parent = row,
			})
			Kit.corner(bar, 8)
			tweenAfter(bar, 0.5, 0.06 + order * 0.04, { Size = UDim2.fromScale(entry.chance / 100, 1) }, Enum.EasingStyle.Quint)
			-- Rarity dot, then tier number, name and chance.
			local dot = Kit.new("Frame", {
				Name = "Dot",
				BackgroundColor3 = tierColor,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(10, 10),
				Position = UDim2.new(0, 8, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = row,
			})
			Kit.round(dot)
			Kit.new("UIStroke", { Thickness = 1.5, Color = WHITE, Transparency = 0.2, Parent = dot })
			Kit.number(row, {
				Text = "#" .. entry.tier,
				TextSize = T.Small,
				Size = UDim2.new(0, 36, 1, 0),
				Position = UDim2.fromOffset(24, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = C.TextDim,
				StrokeThickness = 0,
			})
			Kit.text(row, {
				Text = Theme.Tiers[entry.tier].Name,
				Font = Theme.Fonts.UI,
				TextSize = T.Small,
				TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Size = UDim2.new(1, -118, 1, 0),
				Position = UDim2.fromOffset(60, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Kit.lighten(tierColor, 0.35),
				StrokeThickness = 0,
			})
			Kit.number(row, {
				Text = entry.chance .. "%",
				TextSize = T.Small,
				Size = UDim2.new(0, 54, 1, 0),
				Position = UDim2.new(1, -4, 0, 0),
				AnchorPoint = Vector2.new(1, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
				StrokeThickness = 0,
			})
			table.insert(rows, row)
		end
		Kit.stagger(rows)
	end

	local shownFor = ""
	local open = false
	State.changed.Event:Connect(function(data)
		local rarity = data.heldChest
		if rarity == nil or rarity == "" then
			shownFor = ""
			if open then
				open = false
				Kit.unfocus(panel)
				Kit.disappear(panel)
				Kit.hidePlayerList("crate", false)
				screen:SetAttribute("CratePanelOpen", false)
			end
			return
		end
		if not open then
			open = true
			-- Fx/Crates hides the held crate's own world chip while this is true.
			screen:SetAttribute("CratePanelOpen", true)
			Kit.appear(panel, { from = 0.85, time = 0.26 })
			-- The default player list sits over the panel's header on short screens.
			Kit.hidePlayerList("crate", true)
		end
		local color = C.Rarity[rarity] or C.Gold
		local key = rarity .. ":" .. data.highestTier
		if key ~= shownFor then
			shownFor = key
			title.Text = string.upper(rarity .. " " .. W.Chest)
			title.TextColor3 = Kit.inkOn(color)
			bandGradient.Color = ColorSequence.new(Kit.lighten(color, 0.22), color)
			bandStroke.Color = Kit.lip(color)
			halo.BackgroundColor3 = Kit.lighten(color, 0.45)
			if crate then
				crate:Destroy()
			end
			local icon = crateIcon(panel, color, 80, {
				Rarity = rarity,
				Position = UDim2.new(0.5, 0, 0, 102),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 2,
			})
			crate = icon
			Kit.appear(icon, { from = 0.6, time = 0.3 })
			fillOdds(rarity, data.highestTier)
		end
		-- Pass owners open free; everyone else only where paid random items are allowed.
		local owner = type(data.passes) == "table" and data.passes.CrateKey == true
		setMode(if owner then "owner" elseif data.crateRobux == true then "buy" else "none")
	end)
end

-- Cash pack purchase: full-screen money rain + big count-up (non-blocking) ----------------

-- The Blender gold coin for the rain; the code-drawn "$" coin without it.
local COIN_IMAGE = Sprites.image("CoinSpin")

local function moneyPiece(parent: Instance, bill: boolean, zindex: number): GuiObject
	if not bill and COIN_IMAGE then
		return Kit.new("ImageLabel", {
			Name = "Coin",
			BackgroundTransparency = 1,
			Image = COIN_IMAGE,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(38, 38),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = zindex,
			Parent = parent,
		})
	end
	local piece = Kit.new("Frame", {
		Name = if bill then "Bill" else "Coin",
		BackgroundColor3 = WHITE,
		Size = if bill then UDim2.fromOffset(58, 30) else UDim2.fromOffset(34, 34),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = zindex,
		Parent = parent,
	})
	if bill then
		Kit.corner(piece, 6)
		Kit.stroke(piece, 2, C.CashDeep)
		Kit.gradient(piece, Kit.lighten(C.Cash, 0.35), C.Cash)
	else
		Kit.round(piece)
		Kit.stroke(piece, 2, C.GoldDeep)
		Kit.gradient(piece, C.GoldLight, C.Gold)
	end
	Kit.title(piece, {
		Text = "$",
		TextSize = 20,
		TextWrapped = false,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 1),
		TextColor3 = if bill then C.CashDeep else C.GoldDeep,
		ZIndex = zindex,
		StrokeThickness = 0,
	})
	return piece
end

function Popups.purchase(amount: number)
	amount = math.max(tonumber(amount) or 0, 0)
	local old = screen:FindFirstChild("CashRain")
	if old then
		old:Destroy()
	end
	local layer = Kit.new("Frame", {
		Name = "CashRain",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = screen,
	})
	local dim = Kit.new("Frame", {
		Name = "Dim",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(2, 2),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 50,
		Parent = layer,
	})
	Kit.appear(dim, { from = 1, time = 0.3 })
	local rays = Popups.rays(layer, Kit.lighten(C.Cash, 0.4), 760, UDim2.fromScale(0.5, 0.42), 51, 10)
	Kit.appear(rays, { from = 0.15, time = 0.5, style = Enum.EasingStyle.Quart })

	local headline = Kit.title(layer, {
		Name = "Amount",
		Text = "+" .. State.money(0) .. "!",
		TextSize = 96,
		TextWrapped = false,
		Size = UDim2.fromOffset(900, 110),
		Position = UDim2.fromScale(0.5, 0.42),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = WHITE,
		StrokeThickness = 0,
		ZIndex = 54,
	})
	Kit.textStroke(headline, 4, 0)
	Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(240, 255, 246), C.MoneyText),
		Rotation = 90,
		Parent = headline,
	})
	Kit.appear(headline, { from = 0.3, time = 0.4 })
	local sub = Kit.pill(layer, {
		Name = "Sub",
		Text = "💰 CASH PACK! THANK YOU!",
		Solid = true,
		Color = C.Cash,
		TextSize = T.H3,
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromScale(0.5, 0.53),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 54,
	})
	Kit.appear(sub, { from = 0.4, time = 0.32, delay = 0.25 })
	sounds.play("Celebrate")

	-- Count-up (ease-out) with coin ticks and a landing pop.
	local COUNT_TIME = 1.3
	after(0.15, function()
		Kit.countTo(headline, 0, amount, function(n)
			return "+" .. State.money(n) .. "!"
		end, COUNT_TIME)
	end)
	task.spawn(function()
		task.wait(0.15)
		local t = 0
		while t < COUNT_TIME - 0.1 and layer.Parent do
			sounds.play("Coin", 0.03, 0.9 + (t / COUNT_TIME) * 0.6)
			task.wait(0.1)
			t += 0.1
		end
		if layer.Parent then
			sounds.play("Cash")
		end
	end)

	-- Bills and coins raining across the whole UI.
	task.spawn(function()
		for i = 1, 46 do
			if not layer.Parent then
				return
			end
			local piece = moneyPiece(layer, i % 3 ~= 0, if i % 2 == 0 then 52 else 55)
			local x = math.random()
			piece.Position = UDim2.new(x, 0, -0.08, 0)
			piece.Rotation = math.random(-40, 40)
			local fall = 1.3 + math.random() * 0.9
			Kit.tween(piece, fall, {
				Position = UDim2.new(x + (math.random() - 0.5) * 0.15, 0, 1.1, 0),
				Rotation = piece.Rotation + math.random(-280, 280),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(fall, function()
				piece:Destroy()
			end)
			task.wait(0.035)
		end
	end)
	Kit.confetti(layer, {
		Origin = UDim2.fromScale(0.5, 0.42),
		Count = 40,
		ZIndex = 53,
		Colors = { C.Cash, World.Sunny, World.Mint, World.Blue, WHITE },
		Power = 1.3,
	})

	task.delay(3.3, function()
		if layer.Parent then
			Kit.disappear(layer, { to = 1, time = 0.35, destroy = true })
		end
	end)
end

function Popups.build(screenGui: ScreenGui, soundModule: any)
	screen = screenGui
	sounds = soundModule
	toastHolder = Kit.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(560, 230),
		Position = UDim2.new(0.5, 0, 0, TOAST_Y),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 25,
		Parent = screen,
	})
	-- Slide toasts below the tutorial card while it sits at the top centre.
	local function placeHolder()
		local offset = screen:GetAttribute("TopCardHeight")
		local y = TOAST_Y + (if type(offset) == "number" then offset else 0)
		Kit.tween(toastHolder, 0.3, { Position = UDim2.new(0.5, 0, 0, y) }, Enum.EasingStyle.Quad)
	end
	screen:GetAttributeChangedSignal("TopCardHeight"):Connect(placeHolder)
	placeHolder()
	buildChestPanel()
	if not PREVIEW then
		-- The server's one-time Starter grant (other Notify kinds are routed by Main).
		Net.event("Notify").OnClientEvent:Connect(function(payload)
			if type(payload) == "table" and payload.kind == "Starter" then
				Popups.starter(payload)
			end
		end)
	end
	watchStarterOffer()
end

return Popups
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">ShopScenes</string>
              <string name="Source"><![CDATA[--[[
	ShopScenes: the little looping animations on the shop's pass banners and pack cards.

	  ShopScenes.pass(stage, name, tint)  one banner scene per game pass key (AutoLoot, AutoMerge,
	                                      AutoCash, DoubleAura, DoubleMoney, PremiumUnlocker,
	                                      CrateKey, StarterPack, AllCosmetics; anything else
	                                      gets a sparkling star)
	  ShopScenes.pack(stage, kind, index) a pack card scene: kind "Money" | "Aura",
	                                      index 1..4 (bigger = bigger pile, more particles)

	Both return a Scene { play, stop, celebrate, destroy }:
	  play()       starts the idle loop (call while the shop is open and the scene shows)
	  stop()       pauses every tween and loop and puts the scene back in its resting pose
	  celebrate()  a one-shot burst (purchase landed), then back to idle
	  destroy()    disconnects everything and destroys the scene's GUI

	All GUI lives in one transparent "Scene" canvas inside `stage`, letterboxed to the
	design aspect (pass 230x120, pack 1:1) and sized with Scale only, so the caller sizes
	(and clips) the stage. Motion is TweenService tweens plus at most one Heartbeat per
	scene (connected only while something is flying). In the Lune preview (TweenInfo
	stubbed) nothing animates: scenes show a still frame. Missing sprites or atlas icons
	fall back to plain rounded Frames and shape icons.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local OrbLook = require(ReplicatedStorage.Shared.OrbLook)
local Kit = require(script.Parent.Kit)
local Sprites = require(script.Parent.Parent.Fx.Sprites)

local Theme = Kit.Theme
local C = Kit.C
local F = Kit.F
local WC = Theme.World

-- Same test as Kit: the preview exporter stubs TweenInfo with a plain table.
local PREVIEW = typeof(TweenInfo.new(0)) ~= "TweenInfo"

local WHITE = Color3.new(1, 1, 1)
local ZERO = UDim2.fromScale(0, 0)
local FULL = UDim2.fromScale(1, 1)
local CENTER = Vector2.new(0.5, 0.5)
local BOTTOM = Vector2.new(0.5, 1)

local QUAD = Enum.EasingStyle.Quad
local SINE = Enum.EasingStyle.Sine
local BACK = Enum.EasingStyle.Back
local LINEAR = Enum.EasingStyle.Linear
local BOUNCE = Enum.EasingStyle.Bounce
local ELASTIC = Enum.EasingStyle.Elastic
local IN = Enum.EasingDirection.In
local OUT = Enum.EasingDirection.Out
local INOUT = Enum.EasingDirection.InOut

local PASS_ASPECT = 230 / 120
local PACK_ASPECT = 1

local HOT_PINK = Theme.OrbColors[2] or WC.Pink

-- Shared.Assets (atlas cells), for swapping a crate icon's image in place; nil when missing.
local Assets: any = (function()
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local module = shared and shared:FindFirstChild("Assets")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module :: any)
		if ok and type(result) == "table" then
			return result
		end
	end
	return nil
end)()

local COIN_IMAGE = Sprites.image("CoinSpin")

local ShopScenes = {}

export type Scene = { play: () -> (), stop: () -> (), celebrate: () -> (), destroy: () -> () }

type Flight = { gui: Instance, t0: number, dur: number, step: (number) -> (), done: (() -> ())? }
type Pool = { items: { GuiObject }, busy: { [GuiObject]: boolean } }
type Ctx = {
	root: Frame,
	aspect: number,
	gen: number,
	playing: boolean,
	dead: boolean,
	tweens: { Tween },
	threads: { thread },
	flights: { Flight },
	temps: { Instance },
	pools: { Pool },
	heartbeat: RBXScriptConnection?,
	destroying: RBXScriptConnection?,
	onPlay: { () -> () },
	onRest: { () -> () },
	onCelebrate: { () -> () },
}

-- Scene runtime -----------------------------------------------------------------------

local function newCtx(stage: Frame, aspect: number): Ctx
	local root = Kit.new("Frame", {
		Name = "Scene",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = FULL,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = CENTER,
		Parent = stage,
	})
	Kit.new("UIAspectRatioConstraint", {
		AspectRatio = aspect,
		AspectType = Enum.AspectType.FitWithinMaxSize,
		DominantAxis = Enum.DominantAxis.Width,
		Parent = root,
	})
	return {
		root = root,
		aspect = aspect,
		gen = 0,
		playing = false,
		dead = false,
		tweens = {},
		threads = {},
		flights = {},
		temps = {},
		pools = {},
		heartbeat = nil,
		destroying = nil,
		onPlay = {},
		onRest = {},
		onCelebrate = {},
	}
end

local function alive(ctx: Ctx, gen: number): boolean
	return not ctx.dead and ctx.gen == gen and ctx.root.Parent ~= nil
end

local function track(ctx: Ctx, thread: thread)
	if #ctx.threads > 32 then
		local live = {}
		for _, th in ctx.threads do
			if coroutine.status(th) ~= "dead" then
				table.insert(live, th)
			end
		end
		ctx.threads = live
	end
	table.insert(ctx.threads, thread)
end

-- A tween the scene owns (cancelled by stop).
local function tw(
	ctx: Ctx,
	obj: Instance,
	time: number,
	props: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?,
	repeats: number?,
	reverses: boolean?
): Tween
	local info = TweenInfo.new(time, style or QUAD, direction or OUT, repeats or 0, reverses or false, 0)
	local tween = TweenService:Create(obj, info, props)
	tween:Play()
	if #ctx.tweens > 40 then
		local live = {}
		for _, t in ctx.tweens do
			local state = t.PlaybackState
			if state == Enum.PlaybackState.Playing or state == Enum.PlaybackState.Delayed or state == Enum.PlaybackState.Begin then
				table.insert(live, t)
			end
		end
		ctx.tweens = live
	end
	table.insert(ctx.tweens, tween)
	return tween
end

-- Runs `fn` after `t` seconds unless the scene was stopped or replayed meanwhile.
local function later(ctx: Ctx, t: number, fn: () -> ())
	local gen = ctx.gen
	track(
		ctx,
		task.delay(t, function()
			if alive(ctx, gen) then
				fn()
			end
		end)
	)
end

-- Repeats `body(nap)` while the scene plays; `nap(t)` sleeps and returns false once stopped.
local function loop(ctx: Ctx, body: ((number) -> boolean) -> (), firstDelay: number?)
	local gen = ctx.gen
	local function nap(t: number): boolean
		task.wait(t)
		return alive(ctx, gen)
	end
	track(
		ctx,
		task.spawn(function()
			if firstDelay and not nap(firstDelay) then
				return
			end
			while alive(ctx, gen) do
				local before = os.clock()
				body(nap)
				if os.clock() == before and not nap(0.5) then
					return
				end
			end
		end)
	)
end

local halt: (Ctx) -> ()

local function stepFlights(ctx: Ctx)
	if ctx.dead or ctx.root.Parent == nil then
		halt(ctx)
		return
	end
	local now = os.clock()
	local list = ctx.flights
	local i = 1
	while i <= #list do
		local flight = list[i]
		local a = math.clamp((now - flight.t0) / flight.dur, 0, 1)
		flight.step(a)
		if a >= 1 then
			table.remove(list, i)
			if flight.done then
				flight.done()
			end
		else
			i += 1
		end
	end
	if #ctx.flights == 0 and ctx.heartbeat then
		ctx.heartbeat:Disconnect()
		ctx.heartbeat = nil
	end
end

-- Drives `gui` along `step(alpha 0..1)` for `dur` seconds on the scene's one Heartbeat.
local function fly(ctx: Ctx, gui: Instance, dur: number, step: (number) -> (), done: (() -> ())?)
	if ctx.dead or PREVIEW then
		return
	end
	table.insert(ctx.flights, { gui = gui, t0 = os.clock(), dur = math.max(dur, 0.01), step = step, done = done })
	step(0)
	if not ctx.heartbeat then
		ctx.heartbeat = RunService.Heartbeat:Connect(function()
			stepFlights(ctx)
		end)
	end
end

local function pool(ctx: Ctx, items: { GuiObject }): Pool
	local p: Pool = { items = items, busy = {} }
	table.insert(ctx.pools, p)
	return p
end

local function take(p: Pool): GuiObject?
	for _, gui in p.items do
		if not p.busy[gui] then
			p.busy[gui] = true
			gui.Visible = true
			return gui
		end
	end
	return nil
end

local function free(p: Pool, gui: GuiObject)
	p.busy[gui] = nil
	gui.Visible = false
end

-- A short-lived object (burst piece); destroyed by stop if still around.
local function temp(ctx: Ctx, inst: Instance)
	if #ctx.temps > 16 then
		local live = {}
		for _, t in ctx.temps do
			if t.Parent ~= nil then
				table.insert(live, t)
			end
		end
		ctx.temps = live
	end
	table.insert(ctx.temps, inst)
end

halt = function(ctx: Ctx)
	ctx.gen += 1
	ctx.playing = false
	local current = coroutine.running()
	for _, th in ctx.threads do
		if th ~= current and coroutine.status(th) ~= "dead" then
			pcall(task.cancel, th)
		end
	end
	table.clear(ctx.threads)
	for _, tween in ctx.tweens do
		tween:Cancel()
	end
	table.clear(ctx.tweens)
	table.clear(ctx.flights)
	if ctx.heartbeat then
		ctx.heartbeat:Disconnect()
		ctx.heartbeat = nil
	end
	for _, inst in ctx.temps do
		inst:Destroy()
	end
	table.clear(ctx.temps)
	for _, p in ctx.pools do
		for _, gui in p.items do
			p.busy[gui] = nil
			gui.Visible = false
		end
	end
	if not ctx.dead and ctx.root.Parent ~= nil then
		for _, fn in ctx.onRest do
			fn()
		end
	end
end

local function finish(ctx: Ctx): Scene
	-- Resting pose from the start (the preview still frame too).
	for _, fn in ctx.onRest do
		fn()
	end
	local scene: Scene
	local function destroy()
		if ctx.dead then
			return
		end
		ctx.dead = true
		halt(ctx)
		if ctx.destroying then
			ctx.destroying:Disconnect()
			ctx.destroying = nil
		end
		ctx.root:Destroy()
	end
	if not PREVIEW then
		pcall(function()
			ctx.destroying = ctx.root.Destroying:Connect(function()
				if not ctx.dead then
					ctx.dead = true
					halt(ctx)
				end
			end)
		end)
	end
	scene = {
		play = function()
			if ctx.dead or ctx.playing then
				return
			end
			ctx.playing = true
			if PREVIEW then
				return
			end
			ctx.gen += 1
			for _, fn in ctx.onPlay do
				fn()
			end
		end,
		stop = function()
			if not ctx.dead then
				halt(ctx)
			end
		end,
		celebrate = function()
			if ctx.dead or PREVIEW or ctx.root.Parent == nil then
				return
			end
			for _, fn in ctx.onCelebrate do
				fn()
			end
		end,
		destroy = destroy,
	}
	return scene
end

-- GUI helpers ---------------------------------------------------------------------------

-- A square `s` stage-heights on a side.
local function sq(ctx: Ctx, s: number): UDim2
	return UDim2.fromScale(s / ctx.aspect, s)
end

-- A box `w` by `h` stage-heights.
local function box(ctx: Ctx, w: number, h: number): UDim2
	return UDim2.fromScale(w / ctx.aspect, h)
end

local function at(x: number, y: number): UDim2
	return UDim2.fromScale(x, y)
end

-- An instance with transparent, centred GUI defaults, then `props`, then the parent.
local function node(className: string, parent: Instance, props: { [string]: any }): any
	local inst: any = Instance.new(className)
	if inst:IsA("GuiObject") then
		inst.BackgroundTransparency = 1
		inst.BorderSizePixel = 0
		inst.AnchorPoint = CENTER
	end
	for key, value in props do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

-- Candy plastic fill: lighter top, the colour below, optional chunky outline.
-- radius < 0 = fully round.
local function paint(f: GuiObject, color: Color3, radius: number?, strokeColor: Color3?, thickness: number?): GuiObject
	f.BackgroundColor3 = WHITE
	f.BackgroundTransparency = 0
	if radius then
		if radius < 0 then
			Kit.round(f)
		else
			Kit.corner(f, radius)
		end
	end
	Kit.gradient(f, Kit.lighten(color, 0.32), Kit.darken(color, 0.04))
	if strokeColor then
		Kit.new("UIStroke", {
			Color = strokeColor,
			Thickness = thickness or 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = f,
		})
	end
	return f
end

-- A Blender sprite (white ones tinted `color`), or a rounded Frame stand-in.
local function sprite(parent: Instance, name: string, color: Color3?, props: { [string]: any }): GuiObject
	local id = Sprites.image(name)
	local tint = color or WHITE
	local gui: any
	if id then
		gui = node("ImageLabel", parent, { Name = name, Image = id, ImageColor3 = tint, ScaleType = Enum.ScaleType.Fit })
	else
		gui = node("Frame", parent, { Name = name, BackgroundColor3 = tint, BackgroundTransparency = 0 })
		if name == "Ring" then
			gui.BackgroundTransparency = 1
			Kit.round(gui)
			Kit.new("UIStroke", { Color = tint, Thickness = 3, Parent = gui })
			gui:SetAttribute("StrokeAlpha", true)
		elseif name == "Sparkle" or name == "StarPop" then
			Kit.corner(gui, 3)
			gui.Rotation = 45
		elseif name == "Confetti" then
			Kit.corner(gui, 2)
		else
			Kit.round(gui)
		end
	end
	for key, value in props do
		gui[key] = value
	end
	return gui
end

local function alphaTarget(gui: Instance): (Instance, string)
	if gui:IsA("ImageLabel") then
		return gui, "ImageTransparency"
	end
	if gui:GetAttribute("StrokeAlpha") then
		local stroke = gui:FindFirstChildOfClass("UIStroke")
		if stroke then
			return stroke, "Transparency"
		end
	end
	return gui, "BackgroundTransparency"
end

local function setAlpha(gui: Instance, a: number)
	local inst, prop = alphaTarget(gui);
	(inst :: any)[prop] = a
end

local function fade(ctx: Ctx, gui: Instance, time: number, a: number, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local inst, prop = alphaTarget(gui)
	return tw(ctx, inst, time, { [prop] = a }, style, direction)
end

local function hasArt(name: string): boolean
	return Kit.hasImageIcon(name) or Kit.ICONS[name] ~= nil
end

local function pick(names: { string }): string
	for _, name in names do
		if hasArt(name) then
			return name
		end
	end
	return names[#names]
end

-- The first available icon of `names` (atlas art, else a shape icon tinted `color`).
local function icon(parent: Instance, names: { string }, color: Color3?, props: { [string]: any }): Frame
	local f = Kit.icon(parent, pick(names), 64, color, {
		Name = props.Name,
		Position = props.Position or at(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or CENTER,
		ZIndex = props.ZIndex or 1,
	})
	f.Size = props.Size or FULL
	if props.Visible ~= nil then
		f.Visible = props.Visible
	end
	return f
end

-- Swaps the atlas cell an image icon (and its shade) shows, keeping the frame.
local function retexture(iconFrame: Instance, name: string)
	local icons = Assets and Assets.Icons
	local entry = if type(icons) == "table" then icons[name] else nil
	if type(entry) ~= "table" or type(entry.image) ~= "string" then
		return
	end
	for _, childName in { "Image", "Shade" } do
		local image = iconFrame:FindFirstChild(childName)
		if image and image:IsA("ImageLabel") then
			image.Image = entry.image
			image.ImageRectOffset = Vector2.new(tonumber(entry.x) or 0, tonumber(entry.y) or 0)
			image.ImageRectSize = Vector2.new(tonumber(entry.w) or 0, tonumber(entry.h) or 0)
		end
	end
end

-- A dark copy of `gui`'s image (the ImageLabel itself, or a Kit.icon's "Image") a little
-- below-right of it: a drop shadow, so the art reads on light and dark stage tints alike.
local function shade(gui: Instance, alpha: number?)
	local found = if gui:IsA("ImageLabel") then gui else gui:FindFirstChild("Image")
	if not found or not found:IsA("ImageLabel") then
		return
	end
	local image = found :: ImageLabel
	local copy = image:Clone()
	copy.Name = "Shade"
	copy.ImageColor3 = WC.Ink
	copy.ImageTransparency = alpha or 0.45
	copy.Position = image.Position + UDim2.fromScale(0.03, 0.06)
	copy.ZIndex = math.max(image.ZIndex - 1, 1)
	copy.Parent = image.Parent
end

-- The gold coin: the Blender CoinSpin sprite, or the shape coin. `shaded` wraps it in a
-- Frame with a drop shadow (size, move and pop the returned wrapper).
local function coin(parent: Instance, props: { [string]: any }, shaded: boolean?): GuiObject
	if COIN_IMAGE then
		local gui: any
		if shaded then
			gui = node("Frame", parent, { Name = "Coin" })
			local image = node("ImageLabel", gui, {
				Name = "Image",
				Image = COIN_IMAGE,
				ScaleType = Enum.ScaleType.Fit,
				Size = FULL,
				Position = at(0.5, 0.5),
				ZIndex = props.ZIndex or 1,
			})
			shade(image)
		else
			gui = node("ImageLabel", parent, { Name = "Coin", Image = COIN_IMAGE, ScaleType = Enum.ScaleType.Fit })
		end
		for key, value in props do
			gui[key] = value
		end
		return gui
	end
	local f = icon(parent, { "Coin" }, C.Gold, props)
	if shaded then
		shade(f)
	end
	return f
end

-- A glossy candy aura ball.
local function orb(parent: Instance, color: Color3, props: { [string]: any }): GuiObject
	local f = node("Frame", parent, props)
	paint(f, Kit.lighten(color, 0.08), -1, Kit.darken(color, 0.38), 1.5)
	return f
end

-- Chunky display text (sticker style): coloured fill, thick navy outline.
local function sticker(parent: Instance, text: string, color: Color3, props: { [string]: any }, thickness: number?): TextLabel
	local label = node("TextLabel", parent, {
		Text = text,
		Font = F.Display,
		TextScaled = true,
		TextColor3 = color,
	})
	for key, value in props do
		label[key] = value
	end
	Kit.new("UIStroke", {
		Color = WC.Ink,
		Thickness = thickness or 2.5,
		LineJoinMode = Enum.LineJoinMode.Round,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = label,
	})
	return label
end

-- Sparkle twinkle: scales in with a quarter spin (Back overshoot ~10 %), holds, scales out.
local function twinkle(ctx: Ctx, gui: GuiObject, size: UDim2, hold: number?)
	gui.Visible = true
	gui.Size = ZERO
	gui.Rotation = 0
	tw(ctx, gui, 0.18, { Size = size }, BACK, OUT)
	tw(ctx, gui, 0.5 + (hold or 0.1), { Rotation = 90 }, LINEAR)
	later(ctx, 0.18 + (hold or 0.1), function()
		tw(ctx, gui, 0.22, { Size = ZERO }, QUAD, IN)
	end)
end

-- Sets a sprite's alpha to `peak`, then fades it back to `rest`.
local function flash(ctx: Ctx, gui: Instance, peak: number, rest: number, time: number?)
	setAlpha(gui, peak)
	fade(ctx, gui, time or 0.5, rest)
end

-- Purchase burst: star pops flying out of (x, y) plus a puff of Kit confetti. Each star's
-- end point is clamped 0.2 stage-heights inside the edges, so none leaves the stage.
local function burst(ctx: Ctx, x: number, y: number, stars: number, confetti: number, reach: number?)
	local A = ctx.aspect
	local id = Sprites.image("StarPop")
	local dist = reach or 0.6
	local x0 = x * A
	for i = 1, stars do
		local star = sprite(ctx.root, "StarPop", if id then WHITE else WC.Sunny, {
			Size = sq(ctx, 0.3),
			Position = at(x, y),
			ZIndex = 9,
		})
		temp(ctx, star)
		local angle = (i / stars) * math.pi * 2 + math.random() * 0.6
		local ex = math.clamp(x0 + math.cos(angle) * dist, 0.2, A - 0.2)
		local ey = math.clamp(y + math.sin(angle) * dist, 0.2, 0.8)
		fly(ctx, star, 0.55 + math.random() * 0.15, function(a)
			local e = 1 - (1 - a) ^ 3
			star.Position = at((x0 + (ex - x0) * e) / A, y + (ey - y) * e)
			star.Size = sq(ctx, 0.3 * (1 - a * a) + 0.01)
			star.Rotation = 160 * a
		end, function()
			star:Destroy()
		end)
	end
	if confetti > 0 then
		Kit.confetti(ctx.root, { Count = confetti, Power = 0.3, Origin = at(x, y), ZIndex = 10 })
	end
end

local function onPlay(ctx: Ctx, fn: () -> ())
	table.insert(ctx.onPlay, fn)
end
local function onRest(ctx: Ctx, fn: () -> ())
	table.insert(ctx.onRest, fn)
end
local function onCelebrate(ctx: Ctx, fn: () -> ())
	table.insert(ctx.onCelebrate, fn)
end

-- Pass scenes ---------------------------------------------------------------------------
--[[
	Geometry is worked in stage-height units ("h"): the stage is A = 230/120 ≈ 1.92 h wide
	and 1 h tall. Everything that moves keeps ≥ 0.05 h (≈ 6 px) from the edges at its
	largest (idle breathing x pops x Back overshoot x rotation), except things that
	deliberately enter from an edge (Auto Aura orbs, Auto Cash drops, falling crates) and
	soft light (SoftDot glows, aura rings, crate rays), which fade at the edges.
]]

local PASSES: { [string]: (Ctx, Color3) -> () } = {}

-- Auto Aura: candy orbs spiral in from the edges into a big glowing dumbbell.
PASSES.AutoLoot = function(ctx, _tint)
	local root, A = ctx.root, ctx.aspect
	local cx, cy = 0.5, 0.52
	local GLOW = 0.4
	local glow = sprite(root, "SoftDot", C.Violet, { Size = box(ctx, 2.1, 1.35), Position = at(cx, cy), ZIndex = 1 })
	local core = sprite(root, "SoftDot", WHITE, { Size = sq(ctx, 0.4), Position = at(cx, cy), ZIndex = 2 })
	local rings = {}
	for i = 1, 2 do
		rings[i] = sprite(root, "Ring", Kit.lighten(C.Violet, 0.4), { Size = sq(ctx, 0.5), Position = at(cx, cy), ZIndex = 2 })
	end
	-- 1.55 x 0.68 h; with breathing 1.04 and a 0.9 pop it peaks at 1.79 x 0.78 h.
	local dumbbell = Sprites.image("hud/Dumbbell")
	local holder = node("Frame", root, {
		Name = "Dumbbell",
		Size = if dumbbell then box(ctx, 1.55, 0.68) else sq(ctx, 0.74),
		Position = at(cx, cy),
		ZIndex = 3,
	})
	local holderScale = Kit.new("UIScale", { Parent = holder })
	local hero = node("Frame", holder, { Name = "Hero", Size = FULL, Position = at(0.5, 0.5), ZIndex = 3 })
	if dumbbell then
		shade(node("ImageLabel", hero, {
			Name = "Image",
			Image = dumbbell,
			ScaleType = Enum.ScaleType.Fit,
			Size = FULL,
			Position = at(0.5, 0.5),
			ZIndex = 4,
		}))
	else
		shade(icon(hero, { "Orb" }, C.Orb, { ZIndex = 4 }))
	end
	-- A sparkle over each bell, alternating per catch.
	local sparkles = {}
	for k, dx in { -0.3, 0.3 } do
		sparkles[k] = sprite(root, "Sparkle", if k == 1 then WHITE else WC.Butter, {
			Size = ZERO,
			Position = at(cx + dx, cy - 0.24),
			ZIndex = 6,
			Visible = false,
		})
	end
	local orbs = {}
	for i = 1, 5 do
		orbs[i] = orb(root, OrbLook.tierColor(i, Theme.OrbColors), { Size = sq(ctx, 0.26), ZIndex = 5, Visible = false })
	end
	local orbPool = pool(ctx, orbs)

	local turn = 0
	local function catch()
		Kit.pop(hero, 0.6)
		flash(ctx, glow, 0.05, GLOW, 0.5)
		core.Size = sq(ctx, 0.4)
		setAlpha(core, 0.15)
		tw(ctx, core, 0.35, { Size = sq(ctx, 0.85) }, QUAD, OUT)
		fade(ctx, core, 0.35, 1, QUAD, IN)
		turn = turn % #sparkles + 1
		twinkle(ctx, sparkles[turn], sq(ctx, 0.34), 0)
	end
	local function launch()
		local o = take(orbPool)
		if not o then
			return
		end
		local theta0 = math.random() * math.pi * 2
		local spin = (if math.random() < 0.5 then -1 else 1) * math.pi * (1.6 + math.random() * 0.6)
		local rx, ry = 0.62 * A, 0.78
		fly(ctx, o, 1.1 + math.random() * 0.25, function(a)
			local r = 1 - a * a
			local theta = theta0 + spin * a
			o.Position = at((cx * A + rx * r * math.cos(theta)) / A, cy + ry * r * math.sin(theta))
			o.Size = sq(ctx, 0.26 * (0.45 + 0.55 * r))
		end, function()
			free(orbPool, o)
			catch()
		end)
	end
	local ringTurn = 0
	local function ringPulse()
		ringTurn = ringTurn % 2 + 1
		local ring = rings[ringTurn]
		ring.Size = sq(ctx, 1.9)
		setAlpha(ring, 1)
		tw(ctx, ring, 1.3, { Size = sq(ctx, 0.45) }, QUAD, IN)
		fade(ctx, ring, 1.3, 0.35, QUAD, IN)
		later(ctx, 1.3, function()
			setAlpha(ring, 1)
		end)
	end

	onPlay(ctx, function()
		tw(ctx, holderScale, 1.0, { Scale = 1.04 }, SINE, INOUT, -1, true)
		loop(ctx, function(nap)
			launch()
			nap(0.34)
		end)
		loop(ctx, function(nap)
			ringPulse()
			nap(0.7)
		end)
	end)
	onRest(ctx, function()
		holderScale.Scale = 1
		glow.Size = box(ctx, 2.1, 1.35)
		setAlpha(glow, GLOW)
		setAlpha(core, 1)
		for _, ring in rings do
			ring.Size = sq(ctx, 0.5)
			setAlpha(ring, 1)
		end
		for _, s in sparkles do
			s.Visible = false
		end
		if PREVIEW then
			-- Still frame: three orbs on their way in.
			local spots = { { 0.14, 0.3 }, { 0.86, 0.7 }, { 0.26, 0.8 } }
			for i, spot in spots do
				orbs[i].Visible = true
				orbs[i].Position = at(spot[1], spot[2])
			end
		end
	end)
	onCelebrate(ctx, function()
		for i = 1, 5 do
			later(ctx, (i - 1) * 0.06, launch)
		end
		Kit.pop(hero, 0.9)
		flash(ctx, glow, 0, GLOW, 0.8)
		burst(ctx, cx, cy, 6, 14)
	end)
end

-- Auto Merge: two matching Chads hop, slide together and fuse into one bigger Chad of the
-- next tier (a star pop, a ring and an "AUTO-MERGED!" sticker), then a new pair pops in.
PASSES.AutoMerge = function(ctx, _tint)
	local root, A = ctx.root, ctx.aspect
	local cx, cy = 0.5, 0.6
	local lxh, rxh = 0.46, A - 0.46 -- pair centres (x in h)
	local PAIR, BIG = 0.46, 0.62
	local GLOW = 0.5
	local tier = math.clamp(3, 1, math.max(#Theme.OrbColors - 1, 1))
	local glow = sprite(root, "SoftDot", WC.Sunny, { Size = box(ctx, 1.6, 1.1), Position = at(cx, cy), ZIndex = 1 })
	local ring = sprite(root, "Ring", Kit.lighten(WC.Sunny, 0.3), { Size = sq(ctx, 0.5), Position = at(cx, cy), ZIndex = 2 })
	-- The merge mark between the pair; it shrinks away while they slide in.
	local mark = icon(root, { "Merge" }, C.Cash, { Size = sq(ctx, 0.3), Position = at(cx, cy), ZIndex = 3 })
	shade(mark)

	-- A tier-coloured candy disc with a Chad on it and a tier tag (pops ~1.2: a 0.62 h
	-- unit at y 0.6 peaks 0.23 .. 0.97).
	local function unit(name: string, t: number, size: number, x: number): GuiObject
		local holder = node("Frame", root, { Name = name, Size = sq(ctx, size), Position = at(x, cy), ZIndex = 4 })
		orb(holder, OrbLook.tierColor(t, Theme.OrbColors), { Size = FULL, Position = at(0.5, 0.5), ZIndex = 4 })
		shade(icon(holder, { "Chad" }, C.Text, { Size = UDim2.fromScale(0.74, 0.74), Position = at(0.5, 0.47), ZIndex = 5 }))
		local tag = node("Frame", holder, { Size = UDim2.fromScale(0.4, 0.4), Position = at(0.84, 0.84), ZIndex = 6 })
		paint(tag, WC.Sunny, -1, WC.Ink, 2)
		sticker(tag, tostring(t), WHITE, { Size = UDim2.fromScale(0.68, 0.68), Position = at(0.5, 0.5), ZIndex = 7 }, 2)
		return holder
	end
	local left = unit("Left", tier, PAIR, lxh / A)
	local right = unit("Right", tier, PAIR, rxh / A)
	local fused = unit("Fused", tier + 1, BIG, cx)
	-- 1.3 x 0.2 h across the top (0.03 .. 0.23 at a 1.1 pop).
	local label = sticker(root, "AUTO-MERGED!", WC.Sunny, {
		Name = "Merged",
		Size = box(ctx, 1.3, 0.2),
		Position = at(cx, 0.13),
		Rotation = -4,
		ZIndex = 8,
	}, 3)
	local spots = { { 0.2, 0.25 }, { 0.8, 0.3 }, { 0.68, 0.86 } }
	local sparkles = {}
	for i, spot in spots do
		sparkles[i] = sprite(root, "Sparkle", WC.Butter, { Size = ZERO, Position = at(spot[1], spot[2]), ZIndex = 7, Visible = false })
	end

	local function ringPulse(strength: number)
		ring.Size = sq(ctx, 0.4)
		setAlpha(ring, 0.05)
		tw(ctx, ring, 0.9, { Size = sq(ctx, 1.25 * strength) }, QUAD, OUT)
		fade(ctx, ring, 0.9, 1, QUAD, OUT)
	end
	local turn = 0
	local function fuse()
		left.Visible = false
		right.Visible = false
		fused.Visible = true
		fused.Size = sq(ctx, 0.3)
		tw(ctx, fused, 0.32, { Size = sq(ctx, BIG) }, BACK, OUT)
		flash(ctx, glow, 0.05, GLOW, 0.6)
		ringPulse(1)
		burst(ctx, cx, cy, 4, 0, 0.45)
		label.Visible = true
		label.Size = ZERO
		tw(ctx, label, 0.28, { Size = box(ctx, 1.3, 0.2) }, BACK, OUT)
		turn = turn % #sparkles + 1
		twinkle(ctx, sparkles[turn], sq(ctx, 0.26), 0.15)
	end

	onPlay(ctx, function()
		tw(ctx, glow, 1.1, { Size = box(ctx, 1.8, 1.25) }, SINE, INOUT, -1, true)
		loop(ctx, function(nap)
			-- Hop, then slide together.
			Kit.pop(left, 0.5)
			Kit.pop(right, 0.5)
			if not nap(0.45) then
				return
			end
			tw(ctx, left, 0.42, { Position = at((cx * A - 0.08) / A, cy) }, QUAD, IN)
			tw(ctx, right, 0.42, { Position = at((cx * A + 0.08) / A, cy) }, QUAD, IN)
			tw(ctx, mark, 0.25, { Size = ZERO }, QUAD, IN)
			if not nap(0.42) then
				return
			end
			fuse()
			if not nap(1.3) then
				return
			end
			-- Out with the big one, in with a fresh pair.
			tw(ctx, fused, 0.2, { Size = ZERO }, QUAD, IN)
			tw(ctx, label, 0.2, { Size = ZERO }, QUAD, IN)
			if not nap(0.22) then
				return
			end
			fused.Visible = false
			label.Visible = false
			for k, u in { left, right } do
				u.Position = at((if k == 1 then lxh else rxh) / A, cy)
				u.Size = ZERO
				u.Visible = true
				tw(ctx, u, 0.3, { Size = sq(ctx, PAIR) }, BACK, OUT)
			end
			tw(ctx, mark, 0.3, { Size = sq(ctx, 0.3) }, BACK, OUT)
			nap(0.7)
		end, 0.3)
	end)
	onRest(ctx, function()
		glow.Size = box(ctx, 1.6, 1.1)
		setAlpha(glow, GLOW)
		ring.Size = sq(ctx, 0.5)
		setAlpha(ring, 1)
		left.Position = at(lxh / A, cy)
		right.Position = at(rxh / A, cy)
		for _, u in { left, right } do
			u.Size = sq(ctx, PAIR)
			u.Visible = true
		end
		fused.Size = sq(ctx, BIG)
		fused.Visible = false
		mark.Size = sq(ctx, 0.3)
		label.Size = box(ctx, 1.3, 0.2)
		label.Visible = PREVIEW
		for _, s in sparkles do
			s.Visible = PREVIEW
			s.Size = if PREVIEW then sq(ctx, 0.22) else ZERO
		end
	end)
	onCelebrate(ctx, function()
		ringPulse(1.3)
		later(ctx, 0.12, function()
			ringPulse(1.3)
		end)
		for _, u in { left, right, fused } do
			Kit.pop(u, 1)
		end
		flash(ctx, glow, 0, GLOW, 0.8)
		burst(ctx, cx, cy, 7, 14)
	end)
end

-- Auto Cash: an orb drops into a converter box, a coin arcs out into a wallet that bulges,
-- and a little pill counts the cash up (+$5 .. +$95, then round again).
PASSES.AutoCash = function(ctx, _tint)
	local root, A = ctx.root, ctx.aspect
	local bxh, by = 0.4, 0.6 -- converter centre (x in h)
	local wxh, wy = 1.42, 0.4 -- wallet centre
	local bx, wx = bxh / A, wxh / A
	local GLOW = 0.55
	local glow = sprite(root, "SoftDot", WC.Sunny, { Size = box(ctx, 1.4, 1.05), Position = at(wx, wy), ZIndex = 1 })
	local shadow = node("Frame", root, {
		Name = "Shadow",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.6,
		Size = box(ctx, 0.66, 0.08),
		Position = at(bx, 0.9),
		ZIndex = 2,
	})
	Kit.round(shadow)

	-- Converter 0.6 x 0.62 h (0.29 .. 0.91 tall; pops 0.5).
	local converter = node("Frame", root, { Name = "Converter", Size = box(ctx, 0.6, 0.62), Position = at(bx, by), ZIndex = 3 })
	paint(converter, WC.Teal, 10, WC.Ink, 3)
	local slot = node("Frame", converter, { Size = UDim2.fromScale(0.62, 0.13), Position = at(0.5, 0.16), ZIndex = 4 })
	paint(slot, WC.TealDeep, -1)
	sticker(converter, "$", WC.Sunny, { Size = UDim2.fromScale(0.62, 0.58), Position = at(0.5, 0.6), ZIndex = 4 }, 3)

	-- Wallet 0.8 x 0.54 h (pops 0.6: right edge 1.85 h, top 0.11).
	local wallet = node("Frame", root, { Name = "Wallet", Size = box(ctx, 0.8, 0.54), Position = at(wx, wy), ZIndex = 3 })
	paint(wallet, WC.Mint, 10, WC.Ink, 3)
	local flap = node("Frame", wallet, {
		Size = UDim2.fromScale(1, 0.48),
		Position = at(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 4,
	})
	paint(flap, C.CashDeep, 10)
	local clasp = node("Frame", flap, { Size = UDim2.fromScale(0.17, 0.5), Position = at(0.84, 0.78), ZIndex = 5 })
	paint(clasp, WC.Sunny, -1, WC.Ink, 1.5)

	-- The counter pill: bottom-right, 42 % of the stage wide, well inside the edges.
	local pill = node("Frame", root, {
		Name = "Counter",
		AnchorPoint = Vector2.new(1, 1),
		Position = at(0.955, 0.92),
		Size = UDim2.fromScale(0.42, 0.26),
		ZIndex = 6,
	})
	paint(pill, WC.Ink, -1, WC.Sunny, 2)
	local counter = node("TextLabel", pill, {
		Name = "Amount",
		Text = "+$0",
		Font = F.Display,
		TextScaled = true,
		TextColor3 = WC.Sunny,
		Size = UDim2.fromScale(0.84, 0.76),
		Position = at(0.5, 0.52),
		ZIndex = 7,
	})
	Kit.new("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 6, Parent = counter })
	local earned = 0
	local function show()
		counter.Text = "+$" .. tostring(earned)
	end

	local sparkle = sprite(root, "Sparkle", WC.Butter, { Size = ZERO, Position = at(1.62 / A, 0.22), ZIndex = 7, Visible = false })
	local coins = {}
	for i = 1, 4 do
		coins[i] = coin(root, { Size = sq(ctx, 0.26), ZIndex = 5, Visible = false })
	end
	local coinPool = pool(ctx, coins)
	local drops = {}
	for i = 1, 2 do
		drops[i] = orb(root, OrbLook.tierColor(i, Theme.OrbColors), { Size = sq(ctx, 0.2), ZIndex = 2, Visible = false })
	end
	local dropPool = pool(ctx, drops)

	-- The coin leaves the slot (0.32) and lands in the wallet; its arc tops out at 0.2.
	local x0, y0 = bxh, 0.32
	local x1, y1 = wxh - 0.1, 0.36
	local function launchCoin(amount: number)
		local c = take(coinPool)
		if not c then
			return
		end
		Kit.pop(converter, 0.5)
		fly(ctx, c, 0.62, function(a)
			local s = 0.26 * math.min(1, 0.4 + a * 3)
			c.Position = at((x0 + (x1 - x0) * a) / A, y0 + (y1 - y0) * a - 0.14 * 4 * a * (1 - a))
			c.Size = box(ctx, s * math.max(math.abs(math.cos(a * math.pi * 3)), 0.15), s)
		end, function()
			free(coinPool, c)
			Kit.pop(wallet, 0.6)
			flash(ctx, glow, 0.1, GLOW, 0.45)
			earned += amount
			if earned > 95 then
				earned = amount
			end
			show()
			Kit.pop(pill, 0.5)
			twinkle(ctx, sparkle, sq(ctx, 0.28), 0)
		end)
	end
	local function dropOrb()
		local o = take(dropPool)
		if not o then
			return
		end
		fly(ctx, o, 0.26, function(a)
			o.Position = at(bx, -0.12 + 0.54 * a * a)
			o.Size = sq(ctx, 0.2 * (1 - 0.4 * a))
		end, function()
			free(dropPool, o)
		end)
	end

	onPlay(ctx, function()
		loop(ctx, function(nap)
			dropOrb()
			if not nap(0.24) then
				return
			end
			launchCoin(5)
			nap(0.36)
		end)
	end)
	onRest(ctx, function()
		setAlpha(glow, GLOW)
		sparkle.Visible = false
		if PREVIEW then
			earned = 45
			local still = coins[1]
			still.Visible = true
			still.Position = at((x0 + x1) * 0.5 / A, 0.22)
		end
		show()
	end)
	onCelebrate(ctx, function()
		for i = 1, 4 do
			later(ctx, (i - 1) * 0.08, function()
				launchCoin(10)
			end)
		end
		burst(ctx, wx, wy, 5, 12)
	end)
end

-- Double Aura: a Chad with violet aura rings pulsing out alternately, and a bouncy 2X badge.
PASSES.DoubleAura = function(ctx, _tint)
	local root = ctx.root
	local cx, cy = 0.5, 0.52
	local glow = sprite(root, "SoftDot", C.Violet, { Size = box(ctx, 2.0, 1.3), Position = at(cx, cy), ZIndex = 1 })
	local rings = {}
	for i = 1, 2 do
		rings[i] = sprite(root, "Ring", Kit.lighten(C.Violet, 0.15), { Size = sq(ctx, 0.45), Position = at(cx, cy), ZIndex = 2 })
	end
	local tier = math.min(8, #Theme.Tiers)
	local ok = pcall(function()
		local viewport = Kit.unitViewport(root, tier, { Size = sq(ctx, 1.0), Position = at(cx, 0.5), AnchorPoint = CENTER })
		viewport.ZIndex = 3
	end)
	if not ok then
		shade(icon(root, { "Chad" }, C.Text, { Size = sq(ctx, 0.84), Position = at(cx, cy), ZIndex = 3 }))
	end
	-- Badge 0.7 x 0.4 h at (1.44 h, 0.33), tilted ±8°; a 1.2 pop still clears the edges.
	local badge = node("Frame", root, { Name = "Badge", Size = box(ctx, 0.7, 0.4), Position = at(0.75, 0.33), Rotation = -8, ZIndex = 5 })
	paint(badge, C.Gold, -1, WC.Ink, 3)
	sticker(badge, "2X", WHITE, { Size = UDim2.fromScale(0.78, 0.8), Position = at(0.5, 0.52), ZIndex = 6 }, 3)
	local spots = { { 0.24, 0.28 }, { 0.72, 0.78 }, { 0.27, 0.76 } }
	local sparkles = {}
	for i, spot in spots do
		sparkles[i] = sprite(root, "Sparkle", WC.Butter, { Size = ZERO, Position = at(spot[1], spot[2]), ZIndex = 4, Visible = false })
	end

	local ringTurn = 0
	local function ringPulse(strength: number)
		ringTurn = ringTurn % 2 + 1
		local ring = rings[ringTurn]
		ring.Size = sq(ctx, 0.4)
		setAlpha(ring, 0.05)
		tw(ctx, ring, 1.3, { Size = sq(ctx, 1.3 * strength) }, QUAD, OUT)
		fade(ctx, ring, 1.3, 1, QUAD, OUT)
	end
	local function wiggle(strength: number)
		Kit.pop(badge, strength)
		tw(ctx, badge, 0.08, { Rotation = 8 }, QUAD, OUT)
		later(ctx, 0.08, function()
			tw(ctx, badge, 0.55, { Rotation = -8 }, ELASTIC, OUT)
		end)
	end

	onPlay(ctx, function()
		tw(ctx, glow, 1.0, { Size = box(ctx, 2.3, 1.5) }, SINE, INOUT, -1, true)
		loop(ctx, function(nap)
			ringPulse(1)
			nap(0.65)
		end)
		loop(ctx, function(nap)
			wiggle(1)
			nap(1.4)
		end, 0.3)
		local turn = 0
		loop(ctx, function(nap)
			turn = turn % #sparkles + 1
			twinkle(ctx, sparkles[turn], sq(ctx, 0.28), 0.1)
			nap(0.42)
		end, 0.2)
	end)
	onRest(ctx, function()
		glow.Size = box(ctx, 2.0, 1.3)
		for _, ring in rings do
			ring.Size = sq(ctx, 0.45)
			setAlpha(ring, 1)
		end
		badge.Rotation = -8
		for _, s in sparkles do
			s.Visible = PREVIEW
			s.Size = if PREVIEW then sq(ctx, 0.22) else ZERO
		end
		if PREVIEW then
			rings[1].Size = sq(ctx, 1.0)
			setAlpha(rings[1], 0.45)
		end
	end)
	onCelebrate(ctx, function()
		ringPulse(1.3)
		later(ctx, 0.12, function()
			ringPulse(1.3)
		end)
		wiggle(1.2)
		flash(ctx, glow, 0, 0.5, 0.8)
		burst(ctx, cx, cy, 6, 14)
	end)
end

-- 2X Cash: a coin flips and splits into two coins that clink apart, then a 2X stamp pops in.
PASSES.DoubleMoney = function(ctx, _tint)
	local root, A = ctx.root, ctx.aspect
	local cy = 0.5
	-- In h: the merged coin at 0.63, the pair at 0.42 / 0.84 (0.66 h each, pops 0.5),
	-- the stamp at 1.4 (0.74 x 0.6 h, -10°; Back overshoot x pop stays ≤ 1.11).
	local cx, leftX, rightX = 0.63 / A, 0.42 / A, 0.84 / A
	local stampX = 1.4 / A
	local BIG, SMALL = 0.8, 0.66
	local GLOW = 0.4
	local glow = sprite(root, "SoftDot", WC.Sunny, { Size = box(ctx, 2.1, 1.35), Position = at(0.5, cy), ZIndex = 1 })
	local big = coin(root, { Size = sq(ctx, BIG), Position = at(cx, cy), ZIndex = 3 }, true)
	local left = coin(root, { Size = sq(ctx, SMALL), Position = at(leftX, cy), ZIndex = 3 }, true)
	local right = coin(root, { Size = sq(ctx, SMALL), Position = at(rightX, cy), ZIndex = 4 }, true)
	local starId = Sprites.image("StarPop")
	local star = sprite(root, "StarPop", if starId then WHITE else WC.Sunny, {
		Size = ZERO,
		Position = at(stampX, cy),
		ZIndex = 5,
		Visible = false,
	})
	local stampSize = box(ctx, 0.74, 0.6)
	local stamp = sticker(root, "2X", WC.Sunny, { Size = stampSize, Position = at(stampX, cy), Rotation = -10, ZIndex = 6 }, 3.5)
	local sparkles = {
		sprite(root, "Sparkle", WHITE, { Size = ZERO, Position = at(cx, 0.2), ZIndex = 6, Visible = false }),
		sprite(root, "Sparkle", WC.Butter, { Size = ZERO, Position = at(cx + 0.05, 0.82), ZIndex = 6, Visible = false }),
	}

	local function slam(strength: number)
		stamp.Visible = true
		stamp.Size = ZERO
		stamp.Rotation = -40
		tw(ctx, stamp, 0.28, { Size = stampSize, Rotation = -10 }, BACK, OUT)
		later(ctx, 0.12, function()
			Kit.pop(left, 0.5)
			Kit.pop(right, 0.5)
			flash(ctx, glow, 0.05, GLOW, 0.5)
			star.Visible = true
			star.Size = sq(ctx, 0.3)
			setAlpha(star, 0)
			tw(ctx, star, 0.4, { Size = sq(ctx, 0.86) }, QUAD, OUT)
			fade(ctx, star, 0.4, 1, QUAD, IN)
		end)
		later(ctx, 0.28, function()
			Kit.pop(stamp, strength)
		end)
	end

	onPlay(ctx, function()
		loop(ctx, function(nap)
			if not nap(1.0) then
				return
			end
			-- Merge back into one coin.
			tw(ctx, stamp, 0.16, { Size = ZERO, Rotation = 10 }, BACK, IN)
			tw(ctx, left, 0.2, { Position = at(cx, cy) }, QUAD, IN)
			tw(ctx, right, 0.2, { Position = at(cx, cy) }, QUAD, IN)
			if not nap(0.2) then
				return
			end
			left.Visible = false
			right.Visible = false
			stamp.Visible = false
			star.Visible = false
			big.Visible = true
			big.Size = sq(ctx, BIG)
			Kit.pop(big, 0.7)
			if not nap(0.3) then
				return
			end
			-- Flip, flip...
			for _ = 1, 2 do
				tw(ctx, big, 0.09, { Size = box(ctx, 0.04, BIG) }, QUAD, IN)
				if not nap(0.09) then
					return
				end
				tw(ctx, big, 0.09, { Size = sq(ctx, BIG) }, QUAD, OUT)
				if not nap(0.1) then
					return
				end
			end
			-- ...split! The two coins clink apart.
			big.Visible = false
			left.Position = at(cx, cy)
			right.Position = at(cx, cy)
			left.Visible = true
			right.Visible = true
			tw(ctx, left, 0.28, { Position = at(leftX, cy) }, BACK, OUT)
			tw(ctx, right, 0.28, { Position = at(rightX, cy) }, BACK, OUT)
			if not nap(0.18) then
				return
			end
			twinkle(ctx, sparkles[1], sq(ctx, 0.26), 0.05)
			twinkle(ctx, sparkles[2], sq(ctx, 0.2), 0.05)
			if not nap(0.1) then
				return
			end
			slam(0.7)
			nap(0.5)
		end)
	end)
	onRest(ctx, function()
		-- Resting pose is the payoff: two coins and the 2X stamp.
		big.Visible = false
		big.Size = sq(ctx, BIG)
		left.Visible = true
		right.Visible = true
		left.Position = at(leftX, cy)
		right.Position = at(rightX, cy)
		stamp.Visible = true
		stamp.Size = stampSize
		stamp.Rotation = -10
		star.Visible = false
		setAlpha(glow, GLOW)
		for _, s in sparkles do
			s.Visible = false
		end
	end)
	onCelebrate(ctx, function()
		slam(0.9)
		burst(ctx, stampX, cy, 6, 14)
	end)
end

-- VIP Smasher: a pink-and-gold hammer smashes a crate (puff, star, debris); the next crate
-- is already dropping in while the puff fades, so the stage is never empty.
PASSES.PremiumUnlocker = function(ctx, _tint)
	local root, A = ctx.root, ctx.aspect
	-- Crate frame 0.86 h on the floor at x 0.62 h (the atlas art shows ~0.65 h of it).
	local crateXh, crateBottom, CRATE = 0.62, 0.98, 0.86
	local crateX = crateXh / A
	local crateMid = crateBottom - CRATE * 0.5
	local CRATES = { "CrateRare", "CrateEpic", "CrateLegendary" }
	local GLOW = 0.5
	local glow = sprite(root, "SoftDot", WC.Sunny, { Size = sq(ctx, 1.25), Position = at(crateX, crateMid), ZIndex = 1 })
	local shadow = node("Frame", root, {
		Name = "Shadow",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.6,
		Size = box(ctx, 0.66, 0.08),
		Position = at(crateX, 0.9),
		ZIndex = 2,
	})
	Kit.round(shadow)
	local crate = icon(root, { "CrateRare", "Gift2", "Star" }, WC.Sunny, {
		Size = sq(ctx, CRATE),
		Position = at(crateX, crateBottom),
		AnchorPoint = BOTTOM,
		ZIndex = 3,
	})
	shade(crate)
	local puff = sprite(root, "Puff", WHITE, { Size = ZERO, Position = at(crateX, crateMid), ZIndex = 5, Visible = false })
	local starId = Sprites.image("StarPop")
	local star = sprite(root, "StarPop", if starId then WHITE else WC.Sunny, {
		Size = ZERO,
		Position = at(crateX, crateMid),
		ZIndex = 4,
		Visible = false,
	})
	local bits = {}
	for i, color in { WC.Sunny, WC.Mint, HOT_PINK, WC.Blue, WC.Butter } do
		bits[i] = sprite(root, "Confetti", color, { Size = sq(ctx, 0.18), ZIndex = 6, Visible = false })
	end
	local bitPool = pool(ctx, bits)

	-- The hammer swings round its handle end P = (1.45 h, 0.88), the arm's centre; the
	-- head (0.56 x 0.26 h) sits 0.66 h up the handle. Rest -6°, wind-up +7°, strike -58°
	-- keep the head ≥ 0.05 h inside the stage (strike lands on the crate's right half).
	local REST, WINDUP, STRIKE = -6, 7, -58
	local ARM = 1.32
	local arm = node("Frame", root, { Name = "Hammer", Size = sq(ctx, ARM), Position = at(1.45 / A, 0.88), Rotation = REST, ZIndex = 7 })
	local handle = node("Frame", arm, { Size = UDim2.fromScale(0.07, 0.52), Position = at(0.5, 0.545), AnchorPoint = BOTTOM, ZIndex = 7 })
	paint(handle, WC.Sunny, 5, WC.Ink, 2.5)
	local head = node("Frame", arm, { Size = UDim2.fromScale(0.56 / ARM, 0.26 / ARM), Position = at(0.5, 0), ZIndex = 8 })
	paint(head, HOT_PINK, 9, WC.Ink, 3)
	for _, x in { 0.07, 0.93 } do
		local cap = node("Frame", head, { Size = UDim2.fromScale(0.12, 1.1), Position = at(x, 0.5), ZIndex = 9 })
		paint(cap, WC.Sunny, 5, WC.Ink, 2)
	end
	sticker(head, "VIP", WC.Sunny, { Size = UDim2.fromScale(0.66, 0.74), Position = at(0.5, 0.53), ZIndex = 10 })

	local crateTurn = 1
	local function smashFx(power: number)
		crate.Visible = false
		flash(ctx, glow, 0, GLOW, 0.6)
		puff.Visible = true
		puff.Size = sq(ctx, 0.3)
		setAlpha(puff, 0)
		tw(ctx, puff, 0.45, { Size = sq(ctx, 0.8 * power) }, QUAD, OUT)
		fade(ctx, puff, 0.45, 1, QUAD, IN)
		star.Visible = true
		star.Size = sq(ctx, 0.2)
		setAlpha(star, 0)
		tw(ctx, star, 0.38, { Size = sq(ctx, 0.78 * power) }, QUAD, OUT)
		fade(ctx, star, 0.38, 1, QUAD, IN)
		for k = 1, #bits do
			local bit = take(bitPool)
			if bit then
				local dx = (k - 3) * 0.17 + (math.random() - 0.5) * 0.1
				local rise = 0.28 + math.random() * 0.1
				local spin0 = math.random(0, 360)
				setAlpha(bit, 0)
				fly(ctx, bit, 0.65, function(a)
					bit.Position = at((crateXh + dx * a) / A, crateMid - rise * 4 * a * (1 - a) + 0.3 * a * a)
					bit.Rotation = spin0 + 320 * a
					if a > 0.7 then
						setAlpha(bit, (a - 0.7) / 0.3)
					end
				end, function()
					free(bitPool, bit)
				end)
			end
		end
	end
	local function dropCrate()
		crateTurn = crateTurn % #CRATES + 1
		retexture(crate, CRATES[crateTurn])
		crate.Size = sq(ctx, CRATE)
		crate.Position = at(crateX, crateBottom - 1)
		crate.Visible = true
		tw(ctx, crate, 0.45, { Position = at(crateX, crateBottom) }, BOUNCE, OUT)
		shadow.Size = box(ctx, 0.3, 0.05)
		tw(ctx, shadow, 0.45, { Size = box(ctx, 0.66, 0.08) }, BOUNCE, OUT)
	end

	onPlay(ctx, function()
		loop(ctx, function(nap)
			if not nap(0.3) then
				return
			end
			tw(ctx, arm, 0.22, { Rotation = WINDUP }, SINE, OUT)
			if not nap(0.24) then
				return
			end
			tw(ctx, arm, 0.1, { Rotation = STRIKE }, QUAD, IN)
			if not nap(0.1) then
				return
			end
			tw(ctx, crate, 0.06, { Size = box(ctx, CRATE * 1.25, CRATE * 0.7) }, QUAD, OUT)
			if not nap(0.06) then
				return
			end
			smashFx(1)
			tw(ctx, arm, 0.45, { Rotation = REST }, BACK, OUT)
			-- The next crate falls in while the puff is still fading.
			if not nap(0.12) then
				return
			end
			dropCrate()
			if not nap(0.4) then
				return
			end
			puff.Visible = false
			star.Visible = false
			nap(0.45)
		end)
	end)
	onRest(ctx, function()
		arm.Rotation = REST
		crate.Visible = true
		crate.Size = sq(ctx, CRATE)
		crate.Position = at(crateX, crateBottom)
		shadow.Size = box(ctx, 0.66, 0.08)
		setAlpha(glow, GLOW)
		puff.Visible = false
		star.Visible = false
	end)
	onCelebrate(ctx, function()
		flash(ctx, glow, 0, GLOW, 0.8)
		burst(ctx, crateX, 0.5, 6, 14)
		Kit.pop(head, 0.5)
	end)
end

-- Crate Master: a golden key slides into a legendary crate and turns, the crate jumps open
-- with a star flash, sun rays and sparkles, then the key slides back out.
PASSES.CrateKey = function(ctx, _tint)
	local root, A = ctx.root, ctx.aspect
	-- Crate frame 0.96 h (art ~0.73 h) at x 0.9 h; keyhole at y 0.58.
	local cxh, crateBottom, CRATE = 0.9, 0.99, 0.96
	local cx = cxh / A
	local holeY = 0.58
	local KEY = 1.0
	local keyIn, keyOut = at(cx, holeY), at((cxh + 0.25) / A, holeY)
	local GLOW = 0.45
	local rays = node("Frame", root, { Name = "Rays", Size = sq(ctx, 2.2), Position = at(cx, 0.5), ZIndex = 1 })
	local bars = {}
	for k = 0, 2 do
		local bar = node("Frame", rays, {
			BackgroundColor3 = WC.Butter,
			BackgroundTransparency = 0.6,
			Size = UDim2.fromScale(0.15, 1),
			Position = at(0.5, 0.5),
			Rotation = k * 60,
			ZIndex = 1,
		})
		Kit.round(bar)
		Kit.new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.3, 0.1),
				NumberSequenceKeypoint.new(0.7, 0.1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = bar,
		})
		table.insert(bars, bar)
	end
	local glow = sprite(root, "SoftDot", WC.Sunny, { Size = box(ctx, 1.8, 1.3), Position = at(cx, 0.5), ZIndex = 2 })
	local starId = Sprites.image("StarPop")
	local star = sprite(root, "StarPop", if starId then WHITE else WC.Sunny, {
		Size = ZERO,
		Position = at(cx, 0.5),
		ZIndex = 2,
		Visible = false,
	})
	local crate = icon(root, { "CrateLegendary", "Gift2", "Star" }, WC.Sunny, {
		Size = sq(ctx, CRATE),
		Position = at(cx, crateBottom),
		AnchorPoint = BOTTOM,
		ZIndex = 3,
	})
	shade(crate)

	-- The key's tip sits in the keyhole (the holder's centre), shaft and bow to the right;
	-- turned -90° the bow points up (top 0.07).
	local key = node("Frame", root, { Name = "Key", Size = sq(ctx, KEY), Position = keyOut, ZIndex = 5 })
	local shaft =
		node("Frame", key, { Size = UDim2.fromScale(0.38, 0.1), Position = at(0.5, 0.5), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 5 })
	paint(shaft, C.Gold, 3, WC.Ink, 2.5)
	local tooth =
		node("Frame", key, { Size = UDim2.fromScale(0.07, 0.12), Position = at(0.57, 0.52), AnchorPoint = Vector2.new(0, 0), ZIndex = 5 })
	paint(tooth, C.Gold, 2, WC.Ink, 2.5)
	local bow = node("Frame", key, { Size = UDim2.fromScale(0.26, 0.26), Position = at(0.88, 0.5), ZIndex = 6 })
	paint(bow, C.Gold, -1, WC.Ink, 3)
	local hole = node("Frame", bow, { Size = UDim2.fromScale(0.36, 0.36), Position = at(0.5, 0.5), ZIndex = 7 })
	paint(hole, C.GoldDeep, -1)

	local sparkles = {
		sprite(root, "Sparkle", WHITE, { Size = sq(ctx, 0.3), ZIndex = 6, Visible = false }),
		sprite(root, "Sparkle", WC.Butter, { Size = sq(ctx, 0.3), ZIndex = 6, Visible = false }),
	}
	local sparklePool = pool(ctx, sparkles)

	local function open(power: number)
		tw(ctx, crate, 0.08, { Size = box(ctx, CRATE * 1.1, CRATE * 0.92) }, QUAD, OUT)
		later(ctx, 0.08, function()
			tw(ctx, crate, 0.3, { Size = sq(ctx, CRATE) }, BACK, OUT)
		end)
		star.Visible = true
		star.Size = sq(ctx, 0.2)
		setAlpha(star, 0)
		tw(ctx, star, 0.45, { Size = sq(ctx, 0.85) }, QUAD, OUT)
		fade(ctx, star, 0.45, 1, QUAD, IN)
		tw(ctx, glow, 0.25, { Size = box(ctx, 2.3 * power, 1.6) }, QUAD, OUT)
		fade(ctx, glow, 0.25, 0.05)
		for _, bar in bars do
			tw(ctx, bar, 0.25, { BackgroundTransparency = 0.1 }, QUAD, OUT)
		end
		for i = 1, #sparkles do
			local s = take(sparklePool)
			if s then
				local side = if i == 1 then -1 else 1
				fly(ctx, s, 0.75, function(a)
					s.Position = at((cxh + side * 0.65 * power * a) / A, 0.35 - 0.2 * 4 * a * (1 - a) + 0.3 * a)
					s.Size = sq(ctx, 0.3 * math.sin(math.pi * math.min(a * 1.2, 1)) + 0.01)
					s.Rotation = 180 * a
				end, function()
					free(sparklePool, s)
				end)
			end
		end
	end
	local function close()
		star.Visible = false
		for _, bar in bars do
			tw(ctx, bar, 0.6, { BackgroundTransparency = 0.6 }, QUAD, OUT)
		end
		tw(ctx, glow, 0.6, { Size = box(ctx, 1.8, 1.3) }, QUAD, OUT)
		fade(ctx, glow, 0.6, GLOW)
		Kit.pop(crate, 0.4)
	end

	onPlay(ctx, function()
		tw(ctx, rays, 8, { Rotation = 360 }, LINEAR, INOUT, -1)
		loop(ctx, function(nap)
			if not nap(0.4) then
				return
			end
			tw(ctx, key, 0.2, { Position = keyIn }, QUAD, OUT)
			if not nap(0.22) then
				return
			end
			tw(ctx, key, 0.25, { Rotation = -90 }, BACK, OUT)
			if not nap(0.27) then
				return
			end
			for _, r in { -6, 6, -4, 0 } do
				tw(ctx, crate, 0.05, { Rotation = r }, QUAD, OUT)
				if not nap(0.05) then
					return
				end
			end
			open(1)
			if not nap(1.0) then
				return
			end
			close()
			tw(ctx, key, 0.2, { Rotation = 0 }, QUAD, OUT)
			if not nap(0.22) then
				return
			end
			tw(ctx, key, 0.25, { Position = keyOut }, QUAD, OUT)
			nap(0.3)
		end)
	end)
	onRest(ctx, function()
		rays.Rotation = 0
		for _, bar in bars do
			bar.BackgroundTransparency = if PREVIEW then 0.35 else 0.6
		end
		glow.Size = box(ctx, 1.8, 1.3)
		setAlpha(glow, GLOW)
		star.Visible = false
		crate.Rotation = 0
		crate.Size = sq(ctx, CRATE)
		key.Rotation = 0
		key.Position = keyOut
		if PREVIEW then
			sparkles[1].Visible = true
			sparkles[1].Position = at((cxh - 0.5) / A, 0.24)
			sparkles[2].Visible = true
			sparkles[2].Position = at((cxh + 0.6) / A, 0.26)
		end
	end)
	onCelebrate(ctx, function()
		open(1.25)
		later(ctx, 1.0, close)
		burst(ctx, cx, 0.45, 6, 14)
	end)
end

-- Starter Pack / All Cosmetics / anything else: a big gift or star that breathes and hops,
-- with sparkles twinkling round it and a sheen sweeping across.
local function giftScene(ctx: Ctx, tint: Color3, names: { string })
	local root = ctx.root
	local cx, cy = 0.5, 0.5
	local GLOW = 0.35
	local glow = sprite(root, "SoftDot", Kit.lighten(tint, 0.3), { Size = box(ctx, 2.0, 1.3), Position = at(cx, cy), ZIndex = 1 })
	-- 0.92 h frame (art ~0.7 h); breathing 1.03 and a 1.2 pop keep the art inside.
	local holder = node("Frame", root, { Name = "Hero", Size = sq(ctx, 0.92), Position = at(cx, cy), ZIndex = 3 })
	local holderScale = Kit.new("UIScale", { Parent = holder })
	local hero = icon(holder, names, WC.Sunny, { ZIndex = 3 })
	shade(hero)
	local spots = { { 0.2, 0.28 }, { 0.8, 0.3 }, { 0.76, 0.74 }, { 0.27, 0.76 } }
	local sparkles = {}
	for i, spot in spots do
		sparkles[i] = sprite(root, "Sparkle", if i % 2 == 0 then WC.Butter else WHITE, {
			Size = ZERO,
			Position = at(spot[1], spot[2]),
			ZIndex = 4,
			Visible = false,
		})
	end
	local sheen = node("Frame", root, {
		Name = "Sheen",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(0.12, 1.8),
		Position = at(-0.3, 0.5),
		Rotation = 20,
		ZIndex = 5,
	})
	Kit.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = sheen,
	})

	onPlay(ctx, function()
		tw(ctx, holderScale, 1.1, { Scale = 1.03 }, SINE, INOUT, -1, true)
		tw(ctx, holder, 1.4, { Position = at(cx, cy - 0.02) }, SINE, INOUT, -1, true)
		tw(ctx, glow, 1.1, { Size = box(ctx, 2.3, 1.5) }, SINE, INOUT, -1, true)
		local turn = 0
		loop(ctx, function(nap)
			turn = turn % #sparkles + 1
			twinkle(ctx, sparkles[turn], sq(ctx, 0.3), 0.1)
			nap(0.35)
		end)
		loop(ctx, function(nap)
			Kit.pop(hero, 0.5)
			flash(ctx, glow, 0.1, GLOW, 0.5)
			nap(2.2)
		end, 0.6)
		loop(ctx, function(nap)
			sheen.Position = at(-0.3, 0.5)
			tw(ctx, sheen, 1.0, { Position = at(1.3, 0.5) }, SINE, INOUT)
			nap(3.2)
		end, 0.8)
	end)
	onRest(ctx, function()
		holderScale.Scale = 1
		holder.Position = at(cx, cy)
		glow.Size = box(ctx, 2.0, 1.3)
		setAlpha(glow, GLOW)
		sheen.Position = at(-0.3, 0.5)
		for _, s in sparkles do
			s.Visible = PREVIEW
			s.Size = if PREVIEW then sq(ctx, 0.22) else ZERO
		end
	end)
	onCelebrate(ctx, function()
		Kit.pop(hero, 1.2)
		flash(ctx, glow, 0, GLOW, 0.8)
		burst(ctx, cx, cy, 6, 14)
	end)
end

PASSES.StarterPack = function(ctx, tint)
	giftScene(ctx, tint, { "Gift2", "CosStarter", "Star" })
end
PASSES.AllCosmetics = function(ctx, tint)
	giftScene(ctx, tint, { "CosAll", "Crown", "Star" })
end

--[[
	Animated art for one pass banner. `stage` is a transparent Frame the caller sizes
	(about 230x120 design px, at least ~150x80 for the art to read) and clips; `name` the
	pass key; `tint` the banner colour.
]]
function ShopScenes.pass(stage: Frame, name: string, tint: Color3): Scene
	local ctx = newCtx(stage, PASS_ASPECT)
	ctx.root.Name = "Scene" .. tostring(name)
	local build = PASSES[name]
	if build then
		build(ctx, tint or WC.Sunny)
	else
		giftScene(ctx, tint or WC.Sunny, { "Star" })
	end
	return finish(ctx)
end

-- Pack scenes ---------------------------------------------------------------------------

local CASH_ICONS = { "CashPack1", "CashPack3", "CashPack5", "CashPack6" }

--[[
	Animated art for one pack card: kind "Money" | "Aura", index 1..4 (the size
	ladder: bigger index = bigger pile, more particles, stronger glow). `stage` about
	110x110 or larger (1:1). The pile frame is 0.98 of the stage (art ~0.75); coins rain
	in from the top edge and land on it, orbs float up out of it.
]]
function ShopScenes.pack(stage: Frame, kind: string, index: number): Scene
	local i = math.clamp(math.floor(tonumber(index) or 1), 1, 4)
	local ctx = newCtx(stage, PACK_ASPECT)
	ctx.root.Name = "Scene" .. tostring(kind) .. tostring(i)
	local root = ctx.root
	local cx, cy = 0.5, 0.52

	local glowColor = if kind == "Aura" then C.Violet else WC.Sunny
	local glowAlpha = 0.66 - 0.09 * i
	local glowSize = 0.9 + 0.1 * i
	local glow = sprite(root, "SoftDot", glowColor, { Size = sq(ctx, glowSize), Position = at(cx, cy), ZIndex = 1 })
	local shadow = node("Frame", root, {
		Name = "Shadow",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.68,
		Size = box(ctx, 0.56, 0.08),
		Position = at(cx, 0.9),
		ZIndex = 2,
	})
	Kit.round(shadow)
	local holder = node("Frame", root, { Name = "Pile", Size = sq(ctx, 0.98), Position = at(cx, cy), ZIndex = 3 })
	local holderScale = Kit.new("UIScale", { Parent = holder })

	local hero: GuiObject
	if kind == "Aura" then
		local art = "AuraPack" .. i
		if Kit.hasImageIcon(art) then
			hero = icon(holder, { art }, nil, { ZIndex = 3 })
			shade(hero)
		else
			-- A little heap of candy orbs, one more per size step.
			hero = node("Frame", holder, { Size = FULL, Position = at(0.5, 0.5), ZIndex = 3 })
			local heap = { { 0.5, 0.62, 0.5 }, { 0.3, 0.7, 0.36 }, { 0.72, 0.7, 0.38 }, { 0.5, 0.34, 0.34 } }
			for k = 1, math.min(i + 1, #heap) do
				local h = heap[k]
				orb(hero, OrbLook.tierColor(k, Theme.OrbColors), {
					Size = UDim2.fromScale(h[3], h[3]),
					Position = at(h[1], h[2]),
					ZIndex = 3 + k,
				})
			end
		end
	else
		hero = icon(holder, { CASH_ICONS[i], "Coin" }, C.Gold, { ZIndex = 3 })
		shade(hero)
	end

	-- Particles: coins raining onto the pile (Money), orbs floating up out of it (Aura);
	-- sparkles glint where a coin lands / an orb pops.
	local flyers: { GuiObject } = {}
	if kind == "Money" then
		for k = 1, i + 1 do
			flyers[k] = coin(root, { Size = sq(ctx, 0.22), ZIndex = 5, Visible = false })
		end
	elseif kind == "Aura" then
		for k = 1, i + 1 do
			flyers[k] = orb(root, OrbLook.tierColor(k, Theme.OrbColors), { Size = sq(ctx, 0.17), ZIndex = 5, Visible = false })
		end
	end
	local flyerPool = pool(ctx, flyers)
	local sparkles: { GuiObject } = {}
	for k = 1, 2 do
		sparkles[k] = sprite(root, "Sparkle", if k % 2 == 0 then WC.Butter else WHITE, { Size = ZERO, ZIndex = 6, Visible = false })
	end

	local sparkleTurn = 0
	local function glint(x: number, y: number, size: number)
		sparkleTurn = sparkleTurn % #sparkles + 1
		local s = sparkles[sparkleTurn]
		s.Position = at(x, y)
		twinkle(ctx, s, sq(ctx, size), 0.05)
	end

	local function launch()
		local p = take(flyerPool)
		if not p then
			return
		end
		if kind == "Money" then
			-- Falls in from the top edge, spinning, lands on the pile, hops, sinks in.
			local x0 = 0.3 + math.random() * 0.4
			local drift = (math.random() - 0.5) * 0.12
			local land = 0.3 + math.random() * 0.14
			fly(ctx, p, 0.85 + math.random() * 0.15, function(a)
				local y
				if a < 0.6 then
					local f = a / 0.6
					y = -0.12 + (land + 0.12) * f * f
				else
					y = land - 0.08 * math.sin(math.pi * math.min((a - 0.6) / 0.4 * 1.4, 1))
				end
				local s = if a > 0.82 then 1 - (a - 0.82) / 0.18 else 1
				p.Position = at(x0 + drift * a, y)
				p.Size = box(ctx, 0.22 * s * math.max(math.abs(math.cos(a * math.pi * 3)), 0.15), 0.22 * s)
			end, function()
				free(flyerPool, p)
				glint(x0 + drift, land - 0.02, 0.2 + 0.02 * i)
			end)
		else
			-- Floats up out of the pile with a sway, eases to a stop near the top, pops.
			local x0 = 0.3 + math.random() * 0.4
			local sway = 0.05 + math.random() * 0.04
			local phase = math.random() * math.pi * 2
			local top = 0.14 + math.random() * 0.08
			local xEnd = x0 + sway * math.sin(phase + math.pi * 2.5)
			fly(ctx, p, 1.3 + math.random() * 0.3, function(a)
				local s = if a > 0.85 then 1 - (a - 0.85) / 0.15 else math.min(a / 0.15, 1)
				p.Position = at(x0 + sway * math.sin(phase + a * math.pi * 2.5), 0.5 + (top - 0.5) * (1 - (1 - a) ^ 2))
				p.Size = sq(ctx, 0.17 * s + 0.005)
			end, function()
				free(flyerPool, p)
				glint(xEnd, top, 0.2 + 0.02 * i)
			end)
		end
	end
	onPlay(ctx, function()
		tw(ctx, holderScale, 1.2, { Scale = 1.035 }, SINE, INOUT, -1, true)
		tw(ctx, glow, 1.0, { Size = sq(ctx, glowSize * 1.12) }, SINE, INOUT, -1, true)
		if #flyers > 0 then
			loop(ctx, function(nap)
				launch()
				nap(if kind == "Money" then 0.75 - 0.12 * i else 0.85 - 0.13 * i)
			end, math.random() * 0.4)
		end
	end)
	onRest(ctx, function()
		holderScale.Scale = 1
		glow.Size = sq(ctx, glowSize)
		setAlpha(glow, glowAlpha)
		for _, s in sparkles do
			s.Visible = false
		end
		if PREVIEW then
			-- Still frame: a couple of particles and a sparkle in the air.
			if flyers[1] then
				flyers[1].Visible = true
				flyers[1].Position = at(0.24, 0.22)
			end
			if flyers[2] then
				flyers[2].Visible = true
				flyers[2].Position = at(0.78, 0.28)
			end
			sparkles[1].Visible = true
			sparkles[1].Size = sq(ctx, 0.18)
			sparkles[1].Position = at(0.78, 0.7)
		end
	end)
	onCelebrate(ctx, function()
		Kit.pop(hero, 0.9)
		flash(ctx, glow, 0, glowAlpha, 0.8)
		for k = 1, #flyers do
			later(ctx, (k - 1) * 0.05, launch)
		end
		burst(ctx, cx, cy, 5, 10, 0.45)
	end)

	return finish(ctx)
end

return ShopScenes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--[[
	Tutorial (client): the onboarding quest pill, the guide target and the
	completion banner. Progress itself is server-side (see
	ServerScriptService.Server.Tutorial); this only reads the State snapshot
	(tutorialStep, tutorialDone) and the "Tutorial" Notify payloads.

	The quest pill is one slim line (step chip "2/5", the short instruction,
	a quiet "x" to skip) docked top-centre under the multiplier gauge, or
	bottom-centre above the dumbbell meter on compact screens, so it never covers the
	play area. Theme.Tutorial.Steps[i].ShortHint, when present, shows as a
	small second line for the first few seconds of a step. Docked at the top
	it sets the ScreenGui attribute "TopCardHeight" so toasts sit below it.

	A new step slides/fades in with one soft pulse; a finished step ticks a
	check mark on the chip, slides out, then the next one slides in. The pill
	(and the 3D guide, see Guide) stays hidden while the intro cutscene plays
	(Players.LocalPlayer attribute "IntroPlaying").

	The completion reward is a toast-sized banner shown through the popup
	queue once the wallet has finished counting up the first collect.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Net = require(ReplicatedStorage.Shared.Net)
local TutorialSteps = require(ReplicatedStorage.Shared.TutorialSteps)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)

local Theme = Kit.Theme
local C = Kit.C
local F = Kit.F
local T = Kit.TEXT
local Words = Theme.Tutorial

local Tutorial = {}

export type Deps = {
	popups: any,
	sounds: any,
	guide: any?,
	-- Glows a HUD menu button (e.g. the Index after the first merge).
	highlight: ((string, boolean) -> ())?,
	-- True once the wallet count-up from the latest cash is over.
	walletIdle: (() -> boolean)?,
}

-- Pill geometry (design pixels). The HUD's deposit strip spans y 54..84 at the top
-- centre; the compact dumbbell's top edge sits about 94 px above the bottom.
local PILL_HEIGHT = 44
local PILL_MIN_WIDTH = 220
local PILL_MAX_WIDTH = 360
local TOP_Y = 92
local BOTTOM_GAP = 102
-- The pill lives in a CanvasGroup (for the fade) padded so its shadow is not clipped.
local PAD_X = 6
local PAD_TOP = 4
local PAD_BOTTOM = 14
local SLIDE = 12
local CHIP_WIDTH = 38
local TEXT_X = 54
local CLOSE_WIDTH = 38
local TEXT_SIZE = 16
local HINT_SIZE = 14
local HINT_SECONDS = 4
local TICK_HOLD = 0.45

local screen: ScreenGui
local deps: Deps
local group: CanvasGroup
local pulseScale: UIScale
local chip: Frame
local chipLabel: TextLabel
local chipCheck: Frame
local checkScale: UIScale
local mainLabel: TextLabel
local hintLabel: TextLabel

-- Step the pill currently displays (0 = none), and whether it is on screen.
local shownStep = 0
local shownHint: string? = nil
local onScreen = false
-- True while a finished step ticks and slides out (its text must not change).
local leaving = false
-- Bumped by every show/hide/transition so stale delayed steps bail out.
local token = 0
local hintSerial = 0
local lastData: { [string]: any }? = nil

local function compact(): boolean
	return screen:GetAttribute("Compact") == true
end

local function introPlaying(): boolean
	local player = Players.LocalPlayer
	return player ~= nil and player:GetAttribute("IntroPlaying") == true
end

-- A game-mode run timer (Hud, ScreenGui attribute "RunActive") takes the pill's slot.
local function slotTaken(): boolean
	return introPlaying() or screen:GetAttribute("RunActive") == true
end

local function restPosition(): UDim2
	if compact() then
		return UDim2.new(0.5, 0, 1, -BOTTOM_GAP + PAD_BOTTOM)
	end
	return UDim2.new(0.5, 0, 0, TOP_Y - PAD_TOP)
end

-- Where the pill slides from/to: above its spot at the top, below it at the bottom.
local function awayPosition(): UDim2
	return restPosition() + UDim2.fromOffset(0, if compact() then SLIDE else -SLIDE)
end

local function publishHeight()
	local height = if onScreen and not compact() then PILL_HEIGHT + 8 else 0
	screen:SetAttribute("TopCardHeight", height)
end

local function textWidth(text: string, size: number, font: Enum.Font): number
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
	end)
	if ok and typeof(bounds) == "Vector2" then
		return bounds.X
	end
	return #text * size * 0.55
end

local function stepWords(step: number, data: { [string]: any }): (string, string?)
	local words = Words.Steps[step]
	local target = TutorialSteps.target(step, data.units)
	local isMerge = TutorialSteps.STEPS[step].id == "merge"
	local needsPair = isMerge and target ~= "Merge"
	-- The merge step's hint only applies while the player still lacks a pair.
	local hint: string? = if isMerge and not needsPair then nil else words.ShortHint
	return words.Short or words.Title, hint
end

-- Shows the small second line for a few seconds, then eases the main line back to centre.
local function showHint(hint: string?)
	shownHint = hint
	hintSerial += 1
	local mine = hintSerial
	if not hint then
		Kit.tween(hintLabel, 0.25, { TextTransparency = 1 })
		Kit.tween(mainLabel, 0.25, { Position = UDim2.new(0, TEXT_X, 0.5, 0) })
		return
	end
	hintLabel.Text = hint
	hintLabel.TextTransparency = 1
	mainLabel.Position = UDim2.new(0, TEXT_X, 0.5, -8)
	Kit.tween(hintLabel, 0.3, { TextTransparency = 0.15 })
	task.delay(HINT_SECONDS, function()
		if hintSerial == mine then
			Kit.tween(hintLabel, 0.35, { TextTransparency = 1 })
			Kit.tween(mainLabel, 0.35, { Position = UDim2.new(0, TEXT_X, 0.5, 0) })
		end
	end)
end

-- Fills the pill for `step` (while it is off screen or about to slide in).
local function setContent(step: number, data: { [string]: any })
	local text, hint = stepWords(step, data)
	shownStep = step
	chipLabel.Text = string.format("%d/%d", step, TutorialSteps.COUNT)
	chipLabel.TextTransparency = 0
	chip.BackgroundColor3 = C.Gold
	checkScale.Scale = 0
	mainLabel.Text = text
	local width = math.max(textWidth(text, TEXT_SIZE, F.Bold), if hint then textWidth(hint, HINT_SIZE, F.Body) else 0)
	local pillWidth = math.clamp(math.ceil(width) + TEXT_X + CLOSE_WIDTH + 8, PILL_MIN_WIDTH, PILL_MAX_WIDTH)
	group.Size = UDim2.fromOffset(pillWidth + PAD_X * 2, PILL_HEIGHT + PAD_TOP + PAD_BOTTOM)
	hintLabel.TextTransparency = 1
	mainLabel.Position = UDim2.new(0, TEXT_X, 0.5, 0)
	showHint(hint)
end

local function slideIn()
	token += 1
	local mine = token
	onScreen = true
	leaving = false
	publishHeight()
	group.Visible = true
	group.AnchorPoint = Vector2.new(0.5, if compact() then 1 else 0)
	group.GroupTransparency = 1
	group.Position = awayPosition()
	pulseScale.Scale = 1
	Kit.tween(group, 0.3, { GroupTransparency = 0, Position = restPosition() }, Enum.EasingStyle.Quad)
	-- One soft pulse once it has landed.
	task.delay(0.3, function()
		if token ~= mine then
			return
		end
		Kit.tween(pulseScale, 0.14, { Scale = 1.04 }, Enum.EasingStyle.Quad)
		task.delay(0.14, function()
			Kit.tween(pulseScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		end)
	end)
end

local function slideOut(after: (() -> ())?)
	token += 1
	local mine = token
	onScreen = false
	leaving = false
	publishHeight()
	Kit.tween(group, 0.22, { GroupTransparency = 1, Position = awayPosition() }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.24, function()
		if token ~= mine then
			return
		end
		group.Visible = false
		if after then
			after()
		end
	end)
end

-- Turns the step chip into a green check mark.
local function tick()
	Kit.tween(chip, 0.2, { BackgroundColor3 = C.Cash })
	Kit.tween(chipLabel, 0.12, { TextTransparency = 1 })
	Kit.tween(checkScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Ticks the current step, then slides the pill out (and runs `after`).
local function completeAndLeave(after: (() -> ())?)
	token += 1
	local mine = token
	leaving = true
	tick()
	task.delay(TICK_HOLD, function()
		if token == mine then
			slideOut(after)
		end
	end)
end

local function render(data: { [string]: any })
	lastData = data
	local step = TutorialSteps.clamp(data.tutorialStep)
	local active = data.tutorialDone ~= true and step <= TutorialSteps.COUNT
	if not active then
		if deps.guide then
			deps.guide.setTutorialTarget(nil)
		end
		if onScreen and not leaving then
			-- Finished (not skipped): tick the last step on the way out.
			if data.tutorialDone == true and step > TutorialSteps.COUNT then
				completeAndLeave()
			else
				slideOut()
			end
		end
		shownStep = 0
		return
	end

	if deps.guide then
		deps.guide.setTutorialTarget(TutorialSteps.target(step, data.units))
	end

	if slotTaken() then
		if onScreen then
			slideOut()
		end
		-- Re-shown fresh (with its hint) when the intro or the run ends.
		shownStep = 0
		return
	end

	if step ~= shownStep then
		if onScreen and shownStep > 0 and step > shownStep then
			completeAndLeave(function()
				local latest = lastData
				if latest and not slotTaken() then
					setContent(TutorialSteps.clamp(latest.tutorialStep), latest)
					slideIn()
				end
			end)
			shownStep = step
		else
			setContent(step, data)
			slideIn()
		end
	elseif onScreen and not leaving then
		-- Same step: the merge step's text can change once the player owns a pair.
		local text, hint = stepWords(step, data)
		if mainLabel.Text ~= text then
			mainLabel.Text = text
		end
		if hint ~= shownHint then
			showHint(hint)
		end
	end
end

-- "Training complete": a toast-sized banner where the pill sat, queued with
-- the other popups. Not modal: tap or wait to dismiss.
local function showCelebrate(cash: number, done: () -> ())
	local existing = screen:FindFirstChild("TutorialDone")
	if existing then
		existing:Destroy()
	end
	local atBottom = compact()
	local rest = if atBottom then UDim2.new(0.5, 0, 1, -BOTTOM_GAP + PAD_BOTTOM) else UDim2.new(0.5, 0, 0, TOP_Y - PAD_TOP)
	local away = rest + UDim2.fromOffset(0, if atBottom then SLIDE else -SLIDE)
	local holder = Kit.new("Frame", {
		Name = "TutorialDone",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(392, 60 + PAD_TOP + PAD_BOTTOM),
		Position = away,
		AnchorPoint = Vector2.new(0.5, if atBottom then 1 else 0),
		ZIndex = 20,
		Parent = screen,
	})
	local fade = Kit.new("CanvasGroup", {
		Name = "Fade",
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 21,
		Parent = holder,
	})
	local card = Kit.panel(fade, {
		Name = "Card",
		Size = UDim2.new(1, -PAD_X * 2, 0, 60),
		Position = UDim2.fromOffset(PAD_X, PAD_TOP),
		StrokeColor = C.Gold,
		Radius = 30,
		ZIndex = 21,
	})
	local medal = Kit.new("Frame", {
		Name = "Medal",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(0, 8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 22,
		Parent = card,
	})
	Kit.round(medal)
	Kit.gradient(medal, Kit.lighten(C.Gold, 0.35), C.Gold)
	Kit.icon(medal, "Ranking", 24, C.GoldInk, { Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 23 })
	local medalScale = Kit.new("UIScale", { Scale = 0.4, Parent = medal })

	Kit.title(card, {
		Name = "Title",
		Text = Words.DoneTitle,
		TextSize = T.H3,
		TextWrapped = false,
		Size = UDim2.new(1, -64, 0, 22),
		Position = UDim2.fromOffset(56, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Primary,
		StrokeThickness = 1.5,
		ZIndex = 22,
	})
	local rewards = Kit.new("Frame", {
		Name = "Rewards",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -64, 0, 22),
		Position = UDim2.fromOffset(56, 31),
		ZIndex = 22,
		Parent = card,
	})
	Kit.list(rewards, 6, true)
	local pills = {
		{ text = "+" .. State.money(cash), color = C.Cash },
	}
	for i, info in pills do
		Kit.pill(rewards, {
			Text = info.text,
			Color = info.color,
			TextSize = T.Small,
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = i,
			ZIndex = 22,
		})
		task.delay(0.25 + i * 0.14, function()
			deps.sounds.play("Tick", 0.03, 1 + i * 0.12)
		end)
	end

	Kit.tween(fade, 0.3, { GroupTransparency = 0 }, Enum.EasingStyle.Quad)
	Kit.tween(holder, 0.3, { Position = rest }, Enum.EasingStyle.Quad)
	Kit.tween(medalScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	Kit.confetti(holder, {
		Origin = UDim2.new(0, PAD_X + 28, 0, PAD_TOP + 28),
		Count = 12,
		Power = 0.45,
		ZIndex = 24,
	})
	deps.sounds.play("Celebrate")

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		Kit.tween(fade, 0.22, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Kit.tween(holder, 0.22, { Position = away }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.25, function()
			holder:Destroy()
			done()
		end)
	end
	local catcher = Kit.new("TextButton", {
		Name = "Dismiss",
		BackgroundTransparency = 1,
		Selectable = false,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 25,
		Parent = holder,
	})
	catcher.Activated:Connect(close)
	task.delay(4.5, close)
end

-- Waits for the first-collect cash to finish rolling into the wallet (the
-- "done" notify can arrive before or after the Cash effect), then queues the banner.
function Tutorial.celebrate(cash: number)
	task.spawn(function()
		task.wait(0.5)
		local waited = 0.5
		local idle = deps.walletIdle
		while idle and not idle() and waited < 5 do
			task.wait(0.1)
			waited += 0.1
		end
		deps.popups.enqueue("Tutorial", deps.popups.PRIORITY.Tutorial, function(done)
			showCelebrate(cash, done)
		end)
	end)
end

function Tutorial.onNotify(payload: { [string]: any })
	if payload.event == "step" then
		deps.sounds.play("Step")
	elseif payload.event == "done" then
		if onScreen and not leaving then
			completeAndLeave()
			shownStep = 0
		end
		Tutorial.celebrate(payload.cash or 0)
		-- The merge just discovered a new tier: point at the Index.
		if deps.highlight then
			deps.highlight("Index", true)
		end
	elseif payload.event == "skipped" then
		if onScreen then
			slideOut()
			shownStep = 0
		end
	end
end

function Tutorial.build(screenGui: ScreenGui, dependencies: Deps)
	screen = screenGui
	deps = dependencies
	local action = Net.event("Action")

	group = Kit.new("CanvasGroup", {
		Name = "TutorialPill",
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(PILL_MIN_WIDTH + PAD_X * 2, PILL_HEIGHT + PAD_TOP + PAD_BOTTOM),
		Position = restPosition(),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		ZIndex = 6,
		Parent = screen,
	})
	pulseScale = Kit.new("UIScale", { Parent = group })
	local pill = Kit.panel(group, {
		Name = "Pill",
		Size = UDim2.new(1, -PAD_X * 2, 0, PILL_HEIGHT),
		Position = UDim2.fromOffset(PAD_X, PAD_TOP),
		Transparency = 0.08,
		Radius = PILL_HEIGHT // 2,
		ZIndex = 6,
	})

	chip = Kit.new("Frame", {
		Name = "Chip",
		BackgroundColor3 = C.Gold,
		Size = UDim2.fromOffset(CHIP_WIDTH, 24),
		Position = UDim2.new(0, 7, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 7,
		Parent = pill,
	})
	Kit.round(chip)
	chipLabel = Kit.number(chip, {
		Name = "Step",
		Text = "",
		TextSize = T.Small,
		TextColor3 = C.GoldInk,
		StrokeThickness = 0,
		ZIndex = 8,
	})
	chipCheck = Kit.icon(chip, "Check", 16, C.Text, {
		Name = "Check",
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 8,
	})
	checkScale = Kit.new("UIScale", { Scale = 0, Parent = chipCheck })

	mainLabel = Kit.text(pill, {
		Name = "Text",
		Text = "",
		Font = F.Bold,
		TextSize = TEXT_SIZE,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -(TEXT_X + CLOSE_WIDTH), 0, 20),
		Position = UDim2.new(0, TEXT_X, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
	})
	hintLabel = Kit.text(pill, {
		Name = "Hint",
		Text = "",
		TextSize = HINT_SIZE,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
		Size = UDim2.new(1, -(TEXT_X + CLOSE_WIDTH), 0, 17),
		Position = UDim2.new(0, TEXT_X, 0.5, 10),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.TextDim,
		ZIndex = 7,
	})

	-- Quiet skip: a small "x" (44 px hit area, centred where the 36 px one was) that asks
	-- before skipping.
	local skip = Kit.new("TextButton", {
		Name = "Skip",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, 2, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		ZIndex = 8,
		Parent = pill,
	})
	local cross = Kit.icon(skip, "Close", 12, C.TextMute, {
		Name = "Cross",
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 9,
	})
	Kit.bouncy(skip, 1.12)
	Kit.selectable(skip)
	local function lit(on: boolean)
		for _, part in cross:GetChildren() do
			if part:IsA("Frame") then
				Kit.tween(part, 0.12, { BackgroundColor3 = if on then C.TextDim else C.TextMute })
			end
		end
	end
	skip.MouseEnter:Connect(function()
		lit(true)
	end)
	skip.MouseLeave:Connect(function()
		lit(false)
	end)
	skip.SelectionGained:Connect(function()
		lit(true)
	end)
	skip.SelectionLost:Connect(function()
		lit(false)
	end)
	skip.Activated:Connect(function()
		Kit.sound("Click")
		deps.popups.confirm(Words.SkipConfirm, function()
			action:FireServer({ action = "SkipTutorial" })
		end, { title = "SKIP " .. Words.Title .. "?", icon = "⏭", yes = Words.Skip, no = "Keep going" })
	end)

	screen:GetAttributeChangedSignal("Compact"):Connect(function()
		group.AnchorPoint = Vector2.new(0.5, if compact() then 1 else 0)
		if onScreen then
			Kit.tween(group, 0.25, { Position = restPosition() }, Enum.EasingStyle.Quad)
		end
		publishHeight()
	end)
	publishHeight()

	-- The intro cutscene hides the pill; it slides back in when the intro ends.
	local player = Players.LocalPlayer
	if player then
		player:GetAttributeChangedSignal("IntroPlaying"):Connect(function()
			if State.data then
				render(State.data)
			end
		end)
	end

	screen:GetAttributeChangedSignal("RunActive"):Connect(function()
		if State.data then
			render(State.data)
		end
	end)

	State.changed.Event:Connect(render)
	if State.data then
		render(State.data)
	end
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[--[[
	Windows: Shop, Index, Ranking and Settings.

	Only one is open at a time. A dimmed backdrop sits behind the open window;
	clicking it, the X button, Escape or the gamepad B button closes it.

	Look: lighter-blue raised tiles on the window's deep-blue well, one accent
	colour per window. Every shop price sits on the same mint button (one
	height, one text size) with an idle sheen.
	Motion: cards ripple in when a window or tab opens, shop tabs cross-fade
	and slide from the side of the tab, numbers count, bars and switches ease.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)
local Net = require(ReplicatedStorage.Shared.Net)

local Kit = require(script.Parent.Kit)
local MapPicker = require(script.Parent.MapPicker)
local ShopScenes = require(script.Parent.ShopScenes)
local Sprites = require(script.Parent.Parent.Fx.Sprites)
local State = require(script.Parent.Parent.State)

local Theme = Kit.Theme
local C = Kit.C
local T = Kit.TEXT
local F = Kit.F
local W = Theme.Words
local I = Theme.Icons

-- The Lune preview exporter has no real tweens or frame time: finish
-- transitions immediately there.
local PREVIEW = typeof(TweenInfo.new(0)) ~= "TweenInfo"

local Windows = {}

local windows: { [string]: Kit.Window } = {}
-- Runs just before a window opens (while it is still hidden), so content can
-- be refreshed and its cards set up to ripple in with the window.
local beforeOpen: { [string]: () -> () } = {}
local backdrop: TextButton
Windows.changed = Instance.new("BindableEvent")

local function anyOpen(): boolean
	for _, window in windows do
		if window.isOpen() then
			return true
		end
	end
	return false
end
Windows.isAnyOpen = anyOpen

-- Gamepad: a window can name the control its selection should land on when it opens
-- (Shop: the card it was opened at); otherwise its FocusFirst control or first button.
local focusPick: { [string]: () -> GuiObject? } = {}

-- Re-runs gamepad focus one frame after a window's content is (re)built, so the
-- selection lands on its first card or button rather than a stale one.
local function focusWindow(name: string)
	local window = windows[name]
	if not window or PREVIEW then
		return
	end
	task.defer(function()
		if not window.isOpen() then
			return
		end
		local pick = focusPick[name]
		local preferred = if pick then pick() else nil
		if preferred then
			Kit.focus(window.content, preferred)
		else
			window.focus()
		end
	end)
end

-- opts.focus (Shop only): a pass or cosmetic name, or a section ("Passes", "Cosmetics", "Cash",
-- "Aura"), to open scrolled to.
function Windows.open(name: string, opts: { focus: string? }?)
	if opts and opts.focus and name == "Shop" then
		Windows.shopFocus = opts.focus
	end
	local target = windows[name]
	if target and not target.isOpen() and beforeOpen[name] then
		beforeOpen[name]()
	end
	for key, window in windows do
		window.setOpen(key == name and not window.isOpen())
	end
	if target and target.isOpen() then
		focusWindow(name)
	end
	Kit.fadeBackdrop(backdrop, anyOpen())
	Windows.changed:Fire()
	if name == "Shop" and target and target.isOpen() then
		-- Shop funnel step 1 (Server.Analytics).
		Net.event("Action"):FireServer({ action = "ShopOpened" })
	end
end

function Windows.closeAll()
	for _, window in windows do
		window.setOpen(false)
	end
	if backdrop then
		Kit.fadeBackdrop(backdrop, false)
	end
	Windows.changed:Fire()
end

local function register(name: string, window: Kit.Window)
	windows[name] = window
	window.onClose.Event:Connect(function()
		Kit.fadeBackdrop(backdrop, anyOpen())
		Windows.changed:Fire()
	end)
end

-- Removes content children, keeping panel chrome (Highlight, Lip, Shadow).
local function clearChildren(parent: Instance, className: string?)
	for _, child in parent:GetChildren() do
		if child:IsA(className or "GuiObject") and not child:GetAttribute("KitChrome") then
			child:Destroy()
		end
	end
end

--[[
	Cards ease in one after another, 25 ms apart (scale only: the window's own
	fade covers transparency, so a card never keeps a half-faded look when the
	window closes mid-animation).
]]
local function ripple(cards: { GuiObject })
	for i, gui in cards do
		Kit.appear(gui, { from = 0.9, time = 0.26, delay = math.min(i - 1, 12) * 0.025, fade = false })
	end
end

-- Repaints a Kit.panel body (gradient, outline and lip) in `color`.
local function paintPanel(frame: Frame, color: Color3, strokeColor: Color3?)
	local lipColor = Kit.lip(color)
	local gradient = frame:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(Kit.lighten(color, 0.1), color:Lerp(lipColor, 0.12))
	end
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = strokeColor or lipColor
	end
	local lip = frame:FindFirstChild("Lip")
	if lip and lip:IsA("Frame") then
		lip.BackgroundColor3 = lipColor
	end
end

-- Shop ------------------------------------------------------------------------------

--[[
	One long page under a pill switcher, top to bottom: the Starter Pack hero
	card (until owned), a full-width animated banner per game pass, the
	cosmetics (All Cosmetics bundle + a card grid), then cash and aura pack
	cards. Every banner and pack card has a ShopScenes stage that plays
	only while the shop is open, so a closed shop costs nothing per frame.
]]

-- Each pass banner is fully tinted with its own candy colour (mint is kept for the price buttons).
local PASS_TINTS: { [string]: Color3 } = {
	AutoLoot = Theme.World.Sunny,
	AutoMerge = Theme.World.Orange,
	AutoCash = Theme.World.Coral,
	DoubleAura = Theme.World.Grape,
	DoubleMoney = Theme.World.Blue,
	PremiumUnlocker = Theme.World.Pink,
	CrateKey = Theme.World.Orange,
}

-- Ribbon candy colours, one per kind of tag (OWNED keeps the mint "good" green).
local RIBBON_SUNNY = Theme.World.Sunny -- popular, savings
local RIBBON_PINK = Color3.fromRGB(255, 84, 168) -- best seller, starter deal, exclusive
local RIBBON_CORAL = Theme.World.Coral -- best value

-- Corner tags on pass banners, hidden once the pass is owned (each contrasts with its banner).
local PASS_TAGS: { [string]: { text: string, color: Color3 } } = {
	AutoLoot = { text = "BEST SELLER", color = RIBBON_PINK },
	DoubleMoney = { text = "POPULAR", color = RIBBON_SUNNY },
}

-- Small text (12 px and under) on blue: near-white, never blue-grey.
local SMALL_TEXT = C.Text:Lerp(C.TextDim, 0.5)

-- Robux prices use Kit's shared glyph (see Kit.ROBUX).
local ROBUX = Kit.ROBUX
local function price(amount: number): string
	return ROBUX .. " " .. tostring(amount)
end

--[[
	Corner tag ("POPULAR", "BEST VALUE", "OWNED"): a solid candy pill with white
	text in a dark outline, overlapping the card's top-right corner by ~6 px,
	over a soft drop shadow. The returned label is the shadow (it sizes to the
	text); the coloured face is its child, so Visible and pop/breathe scale
	move both together.
]]
local RIBBON_PAD = 12
-- Width of a ribbon's text (TextService when available, else an estimate). The ribbon
-- is sized explicitly: AutomaticSize would include its face child, which pokes out past
-- the ribbon for the shadow effect, and grow without bound.
local function ribbonTextWidth(text: string): number
	local width = 0
	pcall(function()
		local TextService = game:GetService("TextService")
		width = TextService:GetTextSize(text, 16, F.UI, Vector2.new(1000, 26)).X
	end)
	if width <= 0 then
		width = (utf8.len(text) or #text) * 9
	end
	return math.ceil(width)
end

local function ribbon(parent: Instance, text: string, color: Color3): TextLabel
	local shadow = Kit.text(parent, {
		Name = "Ribbon",
		Text = text,
		Font = F.UI,
		TextSize = 16,
		TextTransparency = 1,
		TextWrapped = false,
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.45,
		Size = UDim2.fromOffset(ribbonTextWidth(text) + RIBBON_PAD * 2, 26),
		Position = UDim2.new(1, 8, 0, -5),
		AnchorPoint = Vector2.new(1, 0),
		StrokeThickness = 0,
		ZIndex = 7,
	})
	Kit.padding(shadow, 0, RIBBON_PAD)
	Kit.round(shadow)
	local face = Kit.text(shadow, {
		Name = "Face",
		Text = text,
		Font = F.UI,
		TextSize = 16,
		TextWrapped = false,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		Size = UDim2.new(1, RIBBON_PAD * 2, 1, 0),
		Position = UDim2.fromOffset(-RIBBON_PAD - 2, -3),
		StrokeThickness = 0,
		ZIndex = 7,
	})
	Kit.round(face)
	Kit.gradient(face, Color3.new(1, 1, 1), Color3.new(0.86, 0.86, 0.9))
	Kit.new("UIStroke", {
		Thickness = 2,
		Color = Kit.darken(Kit.lip(color), 0.35),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = face,
	})
	-- The outline ring sits on a transparent child so the face can outline its glyphs too.
	local edge = Kit.new("Frame", {
		Name = "Edge",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 7,
		Parent = face,
	})
	Kit.round(edge)
	Kit.new("UIStroke", {
		Thickness = 2,
		Color = Kit.lip(color),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = edge,
	})
	return shadow
end

-- Product art: the atlas icon `art` drawn large, or the `fallback` shape icon tinted `color`.
local function productArt(parent: Instance, art: string, fallback: string, color: Color3, size: number): GuiObject
	local props = {
		Name = "Art",
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 4,
	}
	if Kit.hasImageIcon(art) then
		return Kit.icon(parent, art, size, nil, props)
	end
	return Kit.icon(parent, fallback, math.floor(size * 0.7), color, props)
end

-- Section ids in page order, the switcher's pill text and each section's header (icon,
-- title, caption and the colour of its glowing underline).
local SECTIONS = {
	{ key = "Passes", pill = "Passes", title = "GAME PASSES", caption = "Permanent upgrades", icon = "Star", color = C.Gold },
	{
		key = "Cosmetics",
		pill = "Cosmetics",
		title = "COSMETICS",
		caption = "Look cool. Move faster.",
		icon = "Crown",
		color = C.Accent,
	},
	{
		key = "Cash",
		pill = "Cash",
		title = "CASH",
		caption = "Grows as your " .. W.Unit .. "s get stronger",
		icon = "Coin",
		color = C.Cash,
	},
	{
		key = "Aura",
		pill = W.Orb,
		title = string.upper(W.Orb),
		caption = "Lands straight in your tank",
		icon = "Orb",
		color = C.Violet,
	},
}

local function iconColor(icon: string): Color3
	return Kit.ICON_COLORS[icon] or C.Gold
end

-- "15 min", "1 h", "24 h": how much income or aura a pack is worth.
local function durationText(seconds: number): string
	if seconds < 3600 then
		return string.format("%d min", math.floor(seconds / 60 + 0.5))
	end
	local hours = seconds / 3600
	return if hours == math.floor(hours) then string.format("%d h", hours) else string.format("%.1f h", hours)
end

--[[
	Shop sizes (design pixels at the 860x600 window). At the default window the
	Starter card, the GAME PASSES header and the first pass banner fit the
	visible page; on the 620x460 minimum everything keeps one row per banner.
]]
local BANNER_H = 130 -- pass banner height
local STAGE_W = 230 -- a banner's animated stage, at the default window...
local STAGE_MIN_W = 140 -- ...and the narrowest it shrinks to
local COS_H = 204 -- cosmetic card height
local PACK_H = 238 -- cash / aura card height (stage, amount, one-line caption, price)
local PACK_STAGE = 125 -- pack card stage (square)
local PACK_ICON = 26 -- currency icon left of a pack's amount
local STARTER_H = 120 -- Starter pack card at the top of the page
local BUNDLE_H = 120 -- All Cosmetics card heading the cosmetics section
local GAP = 16
local HEAD_H = 54 -- section header height (icon row + glowing underline)
local SWITCH_H = 44 -- section switcher bar (36 px pills inside)
local PAGE_TOP = SWITCH_H + 8 -- the scrolling page starts below the switcher
local PRICE_H = 42 -- every price button
local PRICE_TEXT = 20
local FADE_H = 30 -- soft fade along the bottom edge of the page
local MIN_TEXT = 14 -- no shop text renders smaller (TextScaled labels included)

-- TextScaled labels in the shop never shrink below MIN_TEXT.
local function minText(label: TextLabel): TextLabel
	local constraint = label:FindFirstChildOfClass("UITextSizeConstraint")
	if constraint then
		constraint.MinTextSize = math.min(MIN_TEXT, constraint.MaxTextSize)
	end
	return label
end

-- Small text on a candy tint: white glyphs in a 1.5 px outline of the tint's deep tone.
local function outline(label: TextLabel, tint: Color3): UIStroke
	return Kit.new("UIStroke", {
		Thickness = 1.5,
		Color = Kit.darken(Kit.lip(tint), 0.3),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = label,
	})
end

--[[
	Banner look shared by the pass banners, the Starter and All Cosmetics cards
	and the pack cards: a diagonal two-tone candy gradient, a thick darker
	outline, and a clipped holder for the idle sheen. The holder is inset by
	half the corner radius so the sheen never pokes past the rounded corners.
]]
local function bannerPaint(body: Frame, tint: Color3, radius: number, strokeColor: Color3?): Frame
	local gradient = body:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Kit.lighten(tint, 0.24)),
			ColorSequenceKeypoint.new(0.5, tint),
			ColorSequenceKeypoint.new(1, Kit.darken(tint, 0.16)),
		})
		gradient.Rotation = 24
	end
	local stroke = body:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 3
		stroke.Color = strokeColor or Kit.darken(tint, 0.38)
	end
	return Kit.new("Frame", {
		Name = "SheenClip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.new(1, -radius, 1, -8),
		Position = UDim2.fromOffset(radius // 2, 4),
		ZIndex = 3,
		Parent = body,
	})
end

-- Cosmetics: card tints (the world's candy paint) and the grid order, with the
-- Starter-only items last so the purchasable ones fill the first rows.
local COS = Theme.Cosmetics
local COS_TINTS: { [string]: Color3 } = {
	SpeedBoost = Theme.World.Blue,
	DoubleJump = Theme.World.Grape,
	TrailRainbow = Theme.World.Pink,
	TrailStar = Theme.World.Sunny,
	TrailRookie = Theme.World.Mint,
	AuraGlow = Theme.World.Orange,
	Crown = Theme.World.Coral,
}
local COS_ORDER: { string } = {}
for _, name in COS.Order do
	if not COS.Items[name].Starter then
		table.insert(COS_ORDER, name)
	end
end
for _, name in COS.Order do
	if COS.Items[name].Starter then
		table.insert(COS_ORDER, name)
	end
end

-- The All Cosmetics pass's saving against buying every cosmetic pass on its own, in percent.
local function bundleSaving(): number
	local total = 0
	for _, name in COS_ORDER do
		local item = COS.Items[name]
		local pass = item.Pass and Theme.Monetization.Passes[item.Pass]
		if pass and not item.Starter then
			total += pass.Price
		end
	end
	local bundle = Theme.Monetization.Passes[COS.Bundle].Price
	return if total > bundle then math.floor((1 - bundle / total) * 100) else 0
end

--[[
	The Starter pack's cash for this player right now, from the same Economy
	functions (and the same progression) the server grants with.
]]
function Windows.starterAmounts(data: { [string]: any }): number
	local starter = COS.Starter
	local progression = Economy.progression(data.highestTier or 1, data.processLevel or 0)
	return Economy.moneyPackAmount(data.income or 0, starter.CashSeconds, starter.CashMin, progression)
end

-- The cosmetics part of a snapshot, empty when the server sent none.
local NO_COSMETICS = { owned = {}, trail = "", toggles = {}, bundleOwned = false, starterOwned = false }
local function cosmeticsOf(data: { [string]: any }): { [string]: any }
	local cosmetics = data.cosmetics
	return if type(cosmetics) == "table" then cosmetics else NO_COSMETICS
end
Windows.cosmeticsOf = cosmeticsOf

-- Pending focus for the next shop open: a section ("Cosmetics", "Cash", "Aura" ...), a
-- pass ("DoubleMoney", "StarterPack", "AllCosmetics") or a cosmetic, set by Windows.open.
Windows.shopFocus = nil :: string?
-- Opens the MOG TEST picker (VS RIVALS / 1v1 DUEL); Main points it at MogHud.choose
-- (Windows cannot require MogHud: MogHud -> Popups -> Windows).
Windows.onMogPlay = nil :: (() -> ())?

-- Faint sparkles drifting behind the page: scale position on the page and size in pixels.
local DRIFT_SPOTS = {
	{ 0.06, 0.2, 8 },
	{ 0.3, 0.55, 6 },
	{ 0.52, 0.12, 10 },
	{ 0.74, 0.7, 7 },
	{ 0.93, 0.32, 9 },
	{ 0.18, 0.86, 7 },
	{ 0.62, 0.42, 6 },
	{ 0.86, 0.9, 8 },
}

-- Candy colours the header band drifts through.
local CANDY = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Theme.World.Pink),
	ColorSequenceKeypoint.new(0.25, Theme.World.Sunny),
	ColorSequenceKeypoint.new(0.5, Theme.World.Mint),
	ColorSequenceKeypoint.new(0.75, C.Rizz),
	ColorSequenceKeypoint.new(1, Theme.World.Grape),
})

type Scene = ShopScenes.Scene

local function buildShop(screen: ScreenGui)
	local window = Kit.window(screen, "Shop", "Shop", I.Shop, C.Window.Shop, Vector2.new(860, 600), Vector2.new(620, 460))
	register("Shop", window)
	local action = Net.event("Action")
	local content = window.content
	local frame = window.frame

	-- Every open/close starts a new session; idle loops and delayed steps stop when it changes.
	local session = 0
	local idleStops: { () -> () } = {}
	-- Repeating idle tweens (header drift, sparkles, glows): played on open; on close they
	-- stop and snap back to their resting values, so every open starts from the same look.
	local idleTweens: { { tween: Tween, gui: Instance, rest: { [string]: any } } } = {}
	local function idleTween(gui: Instance, time: number, props: { [string]: any }, delay: number?)
		if PREVIEW then
			return
		end
		local info = TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, delay or 0)
		local rest = {}
		for key in props do
			rest[key] = (gui :: any)[key]
		end
		table.insert(idleTweens, { tween = TweenService:Create(gui, info, props), gui = gui, rest = rest })
	end

	-- Header: the big cart icon pops out over the top-left corner; tank and cash chips at the right.
	local chip = window.header:FindFirstChild("Chip")
	if chip and chip:IsA("GuiObject") then
		chip.Visible = false
	end
	local headerTitle = window.header:FindFirstChild("Title")
	if headerTitle and headerTitle:IsA("TextLabel") then
		headerTitle.Position = UDim2.fromOffset(84, 1)
		headerTitle.Size = UDim2.new(0, 120, 1, 0)
		headerTitle.TextSize = 33
	end
	local cart = Kit.new("Frame", {
		Name = "Cart",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(88, 88),
		Position = UDim2.fromOffset(-20, -28),
		ZIndex = 8,
		Parent = frame,
	})
	local cartScale = Kit.new("UIScale", { Parent = cart })
	productArt(cart, "Shop", "Shop", C.Gold, 88)

	-- Header polish: candy colours drift slowly across the band, the accent strip under it
	-- runs as a rainbow, and a sheen sweeps the band now and then (all only while open).
	-- The tint keeps the band's rounded top corners and its square bottom: a rounded frame
	-- taller than the band, cut off at the band's bottom edge by a clipping holder.
	local driftClip = Kit.new("Frame", {
		Name = "CandyClip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = window.header,
	})
	local drift = Kit.new("Frame", {
		Name = "CandyDrift",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, Kit.RADIUS.XL + 8),
		ZIndex = 2,
		Parent = driftClip,
	})
	Kit.corner(drift, Kit.RADIUS.XL)
	local driftGradient = Kit.new("UIGradient", { Color = CANDY, Offset = Vector2.new(-0.3, 0), Parent = drift })
	idleTween(driftGradient, 7, { Offset = Vector2.new(0.3, 0) })
	local shade = window.header:FindFirstChild("Shade")
	if shade and shade:IsA("Frame") then
		shade.BackgroundColor3 = Color3.new(1, 1, 1)
		shade.Size = UDim2.new(1, 0, 0, 5)
		local shadeGradient = Kit.new("UIGradient", { Color = CANDY, Offset = Vector2.new(-0.25, 0), Parent = shade })
		idleTween(shadeGradient, 4, { Offset = Vector2.new(0.25, 0) })
	end
	local headerSheen = Kit.new("Frame", {
		Name = "SheenClip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.new(1, -Kit.RADIUS.XL, 1, -6),
		Position = UDim2.fromOffset(Kit.RADIUS.XL // 2, 3),
		ZIndex = 2,
		Parent = window.header,
	})

	local function walletChip(name: string, icon: string, color: Color3, width: number, right: number): TextLabel
		local holder = Kit.new("Frame", {
			Name = name,
			BackgroundColor3 = C.Well,
			BackgroundTransparency = 0.15,
			Size = UDim2.fromOffset(width, 38),
			Position = UDim2.new(1, -right, 0.5, -1),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 3,
			Parent = window.header,
		})
		Kit.round(holder)
		Kit.new("UIStroke", { Thickness = 1.5, Color = color, Transparency = 0.5, Parent = holder })
		Kit.icon(holder, icon, 28, color, {
			Name = "Icon",
			Position = UDim2.new(0, 6, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = 4,
		})
		return minText(Kit.number(holder, {
			Name = "Amount",
			Text = "0",
			TextSize = 20,
			MaxTextSize = 20,
			TextScaled = true,
			Size = UDim2.new(1, -46, 0, 26),
			Position = UDim2.new(0, 37, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color,
			ZIndex = 4,
		}))
	end
	local cashChip = walletChip("CashChip", "Coin", C.MoneyText, 146, 60)
	-- The tank (aura carried, like the HUD's dumbbell plaque): bought aura flies here.
	local auraChip = walletChip("AuraChip", "Orb", C.Orb, 120, 212)

	--[[
		Section switcher: one pill (icon + label) per section in a well, with a
		sunny indicator gliding under the section in view (Kit.tabs' selected
		style: ink text on the light pill). The indicator follows the page as it
		scrolls; tapping a pill scrolls that section's header to the top. On a
		narrow window the pills drop their icons so the labels keep their size.
	]]
	local count = #SECTIONS
	local switcher = Kit.well(content, {
		Name = "Switcher",
		Size = UDim2.fromOffset(150 * count, SWITCH_H),
		Position = UDim2.new(0.5, 0, 0, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Radius = SWITCH_H // 2,
		ZIndex = 2,
	})
	local function slot(i: number): (UDim2, UDim2)
		return UDim2.new((i - 1) / count, 4, 0, 4), UDim2.new(1 / count, -8, 1, -8)
	end
	local slotPos, slotSize = slot(1)
	local highlight = Kit.new("Frame", {
		Name = "Highlight",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = slotSize,
		Position = slotPos,
		ZIndex = 2,
		Parent = switcher,
	})
	Kit.round(highlight)
	Kit.gradient(highlight, Kit.lighten(C.Gold, 0.24), C.Gold)
	Kit.new("UIStroke", { Thickness = 1.5, Color = Kit.lip(C.Gold), Parent = highlight })
	local SELECTED_TEXT = Kit.inkOn(C.Gold)

	-- Faint sparkles drift behind the page (under the scroll, so cards always cover them).
	local sparkles = Kit.new("Frame", {
		Name = "Sparkles",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 1, -PAGE_TOP),
		Position = UDim2.fromOffset(0, PAGE_TOP),
		ZIndex = 1,
		Parent = content,
	})
	for i, spot in DRIFT_SPOTS do
		local sparkle = Kit.new("Frame", {
			Name = "Sparkle" .. i,
			BackgroundColor3 = if i % 3 == 0 then C.GoldLight else Color3.new(1, 1, 1),
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(spot[3], spot[3]),
			Position = UDim2.fromScale(spot[1], spot[2]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = 45,
			ZIndex = 1,
			Parent = sparkles,
		})
		Kit.corner(sparkle, 2)
		idleTween(sparkle, 3 + (i % 3) * 0.8, {
			Position = UDim2.new(spot[1], 0, spot[2], -28),
			Rotation = 135,
			BackgroundTransparency = 0.5,
		}, (i % 4) * 0.5)
	end

	local scroll = Kit.scrolling(content, {
		Name = "Scroll",
		Size = UDim2.new(1, 0, 1, -PAGE_TOP),
		Position = UDim2.fromOffset(0, PAGE_TOP),
	})
	scroll.ZIndex = 2
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.None
	-- Gamepad selection moves between the cards; the engine scrolls the page to them.
	scroll.Selectable = false

	-- Soft fade along the bottom edge of the page (stacked strips of the well colour, so it
	-- also renders without gradient transparency); it fades out at the end of the page.
	local fade = Kit.new("Frame", {
		Name = "Fade",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, FADE_H),
		Position = UDim2.new(0, 0, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 9,
		Parent = content,
	})
	local FADE_STEPS = 6
	local fadeStrips: { [Frame]: number } = {}
	for i = 1, FADE_STEPS do
		local strip = Kit.new("Frame", {
			Name = "Strip" .. i,
			BackgroundColor3 = C.Well,
			BackgroundTransparency = 1 - (i / FADE_STEPS) ^ 1.6 * 0.9,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1 / FADE_STEPS, 0),
			Position = UDim2.fromScale(0, (i - 1) / FADE_STEPS),
			ZIndex = 9,
			Parent = fade,
		})
		fadeStrips[strip] = strip.BackgroundTransparency
	end
	local fadeShown = true
	local function showFade(on: boolean)
		if on == fadeShown then
			return
		end
		fadeShown = on
		for strip, transparency in fadeStrips do
			if PREVIEW then
				strip.BackgroundTransparency = if on then transparency else 1
			else
				Kit.tween(strip, 0.2, { BackgroundTransparency = if on then transparency else 1 })
			end
		end
	end

	local pills: { TextButton } = {}
	local pillLabels: { TextLabel } = {}
	local pillIcons: { GuiObject } = {}
	local heads: { Frame } = {}
	local sectionY: { number } = {}
	local current = 1
	local canvasH = 0
	local previewShift = 0
	local layout: (Vector2) -> ()
	-- Visible page height: the window minus its chrome (header 72, bottom 12, padding 20) and the switcher.
	local function pageH(): number
		return window.size().Y - 104 - PAGE_TOP
	end
	-- Farthest the page scrolls: canvas height minus the visible height.
	local function maxScroll(): number
		return math.max(0, canvasH - pageH())
	end
	-- While a pill's scroll runs, the indicator stays on the tapped section.
	local pinUntil = 0
	local syncSection: () -> ()
	-- Scrolls the page so canvas height `y` is at the top (clamped to the page).
	local function scrollTo(y: number, instant: boolean?)
		local target = Vector2.new(0, math.max(0, math.min(y, maxScroll())))
		if PREVIEW then
			-- The preview exporter has no canvas scrolling: shift the page instead.
			previewShift = target.Y
			layout(window.size())
			syncSection()
		elseif instant then
			scroll.CanvasPosition = target
		else
			pinUntil = os.clock() + 0.45
			Kit.tween(scroll, 0.4, { CanvasPosition = target }, Enum.EasingStyle.Quint)
			task.delay(0.5, function()
				if window.isOpen() and os.clock() >= pinUntil then
					syncSection()
				end
			end)
		end
	end

	local function setCurrent(index: number, animate: boolean)
		if index == current and animate then
			return
		end
		current = index
		local pos = slot(index)
		if animate and not PREVIEW then
			Kit.tween(highlight, 0.24, { Position = pos }, Enum.EasingStyle.Back)
			if heads[index] then
				Kit.pop(heads[index], 0.5)
			end
		else
			highlight.Position = pos
		end
		for i, label in pillLabels do
			local color = if i == index then SELECTED_TEXT else C.Text
			if animate and not PREVIEW then
				Kit.tween(label, 0.18, { TextColor3 = color })
			else
				label.TextColor3 = color
			end
		end
	end
	local function scrollToSection(index: number, instant: boolean?)
		setCurrent(index, not instant)
		scrollTo(sectionY[index] or 0, instant)
	end
	for i, section in SECTIONS do
		local pos, size = slot(i)
		local pill = Kit.new("TextButton", {
			Name = section.key,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Text = "",
			Size = size,
			Position = pos,
			ZIndex = 3,
			Parent = switcher,
		})
		Kit.list(pill, 6, true, Enum.HorizontalAlignment.Center)
		pillIcons[i] = Kit.icon(pill, section.icon, 26, iconColor(section.icon), {
			Name = "Icon",
			LayoutOrder = 1,
			ZIndex = 4,
		})
		pillLabels[i] = Kit.text(pill, {
			Name = "Label",
			Text = string.upper(section.pill),
			Font = F.UI,
			TextSize = 18,
			TextWrapped = false,
			TextColor3 = if i == 1 then SELECTED_TEXT else C.Text,
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			StrokeThickness = 0,
			ZIndex = 4,
		})
		Kit.bouncy(pill, 1)
		Kit.selectable(pill)
		if i == 1 then
			pill:SetAttribute("FocusFirst", true)
		end
		local function pick()
			Kit.sound("Click")
			scrollToSection(i)
		end
		pill.Activated:Connect(pick)
		-- On touch the pill (36 px) takes taps over its whole slot of the 44 px bar.
		local hit = Kit.new("TextButton", {
			Name = "Hit" .. section.key,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Selectable = false,
			Size = UDim2.new(1 / #SECTIONS, 0, 1, 0),
			Position = UDim2.fromScale((i - 1) / #SECTIONS, 0),
			Visible = Kit.touch,
			ZIndex = 5,
			Parent = switcher,
		})
		hit.Activated:Connect(pick)
		Kit.onInput(function()
			hit.Visible = Kit.touch
		end)
		pills[i] = pill
	end

	-- Section header: a big icon, chunky outlined title and caption in one row over a
	-- glowing underline in the section's colour (the glow breathes while open).
	local function sectionHead(index: number): Frame
		local section = SECTIONS[index]
		local head = Kit.new("Frame", { Name = "Head" .. section.key, BackgroundTransparency = 1, Parent = scroll })
		local row = Kit.new("Frame", {
			Name = "Row",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 44),
			Parent = head,
		})
		Kit.list(row, 10, true).VerticalAlignment = Enum.VerticalAlignment.Center
		Kit.icon(row, section.icon, 40, iconColor(section.icon), { Name = "Icon", LayoutOrder = 1 })
		Kit.title(row, {
			Name = "Title",
			Text = section.title,
			TextSize = 30,
			TextWrapped = false,
			Size = UDim2.new(0, 0, 0, 36),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			StrokeThickness = 3,
		})
		Kit.text(row, {
			Name = "Caption",
			Text = section.caption,
			Font = F.Bold,
			TextSize = 15,
			TextWrapped = false,
			Size = UDim2.new(0, 0, 0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 3,
			TextColor3 = SMALL_TEXT,
		})
		-- Underline: a soft wide glow with a bright core, both fading out to the right.
		local fadeRight = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.6, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
		local glow = Kit.new("Frame", {
			Name = "Glow",
			BackgroundColor3 = section.color,
			BackgroundTransparency = 0.78,
			BorderSizePixel = 0,
			Size = UDim2.new(0.62, 0, 0, 10),
			Position = UDim2.new(0, 0, 0, 43),
			Parent = head,
		})
		Kit.corner(glow, 5)
		Kit.new("UIGradient", { Transparency = fadeRight, Parent = glow })
		local line = Kit.new("Frame", {
			Name = "Underline",
			BackgroundColor3 = Kit.lighten(section.color, 0.2),
			BorderSizePixel = 0,
			Size = UDim2.new(0.6, 0, 0, 4),
			Position = UDim2.new(0, 0, 0, 46),
			Parent = head,
		})
		Kit.corner(line, 2)
		Kit.new("UIGradient", { Transparency = fadeRight, Parent = line })
		idleTween(glow, 1.4, { BackgroundTransparency = 0.5 }, index * 0.2)
		heads[index] = head
		return head
	end

	-- A grid cell holds a "Body" panel, so hover can lift the body while the grid owns the cell.
	-- `art` is static product art that bobs and tilts; animated stages leave it nil.
	type Entry = {
		cell: Frame,
		body: Frame,
		art: GuiObject?,
		artHolder: GuiObject,
		button: TextButton,
		sheen: Frame?,
		clip: Frame?,
	}
	local cascade: { GuiObject } = {}
	local entries: { Entry } = {}
	local shopFocusButton: GuiObject? = nil
	local scenes: { Scene } = {}
	local refresh: () -> ()

	-- Little stars burst from a point (frame-local pixels) on tap.
	local function stars(at: Vector2)
		if PREVIEW then
			return
		end
		for i = 1, 5 do
			local angle = math.rad(i * 72 + math.random(-15, 15))
			local star = Kit.icon(frame, "Star", 14, C.Gold, {
				Name = "TapStar",
				Position = UDim2.fromOffset(at.X, at.Y),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 40,
			})
			local reach = math.random(26, 40)
			Kit.tween(star, 0.35, {
				Position = UDim2.fromOffset(at.X + math.cos(angle) * reach, at.Y + math.sin(angle) * reach),
				Size = UDim2.fromOffset(0, 0),
				Rotation = math.random(-90, 90),
			}, Enum.EasingStyle.Quad)
			task.delay(0.36, function()
				star:Destroy()
			end)
		end
	end

	-- Absolute screen point -> pixels inside the window frame (the window may be scaled by Kit.fit).
	local function local_(point: Vector2): Vector2
		local s = frame.AbsoluteSize.X / math.max(1, window.size().X)
		return (point - frame.AbsolutePosition) / math.max(s, 0.01)
	end
	local function centreOf(gui: GuiObject): Vector2
		return local_(gui.AbsolutePosition + gui.AbsoluteSize / 2)
	end

	local function makeEntry(
		parent: Instance,
		name: string,
		order: number,
		color: Color3,
		artName: string,
		fallback: string,
		artSize: number,
		artPos: UDim2
	)
		local cell = Kit.new("Frame", { Name = name, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
		local body = Kit.panel(cell, {
			Name = "Body",
			Color = color,
			Size = UDim2.fromScale(1, 1),
			Radius = Kit.RADIUS.M + 4,
			StrokeColor = Kit.lighten(color, 0.45),
			StrokeThickness = 2,
		})
		local artHolder = Kit.new("Frame", {
			Name = "ArtHolder",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(artSize, artSize),
			Position = artPos,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 4,
			Parent = body,
		})
		local art = productArt(artHolder, artName, fallback, color, artSize)
		table.insert(cascade, cell)
		return cell, body, artHolder, art
	end

	-- Price button with an idle sheen bar parked off its left edge; squashes on press, stars on tap.
	local function priceButton(body: Frame, props: { [string]: any }, onClick: () -> ()): (TextButton, Frame?)
		props.Name = "Buy"
		props.Font = F.Number
		props.TextColor = C.Ink
		props.Color = C.Cash
		props.TextSize = PRICE_TEXT
		local button = Kit.button(body, props, onClick)
		button.ZIndex = 5
		local face = Kit.buttonFace(button)
		local sheen: Frame? = nil
		if face then
			face.ClipsDescendants = true
			local bar = Kit.new("Frame", {
				Name = "Sheen",
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.55,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 26, 1.6, 0),
				Position = UDim2.new(0, -40, -0.3, 0),
				Rotation = 18,
				ZIndex = 8,
				Parent = face,
			})
			Kit.new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.2),
					NumberSequenceKeypoint.new(1, 1),
				}),
				Parent = bar,
			})
			sheen = bar
		end
		button.MouseButton1Down:Connect(function()
			stars(centreOf(button))
		end)
		return button, sheen
	end

	-- Hover / touch: the body lifts 3 px, static art tilts and the art or stage pops.
	local function hoverable(entry: Entry)
		if PREVIEW then
			return
		end
		local function lift(on: boolean)
			Kit.tween(entry.body, 0.16, { Position = UDim2.fromOffset(0, if on then -3 else 0) }, Enum.EasingStyle.Quad)
			local art = entry.art
			if art then
				Kit.tween(art, 0.22, { Rotation = if on then -8 else 0 }, Enum.EasingStyle.Back)
			end
			if on then
				Kit.pop(entry.artHolder, if art then 0.6 else 0.25)
			end
		end
		entry.body.MouseEnter:Connect(function()
			lift(true)
		end)
		entry.body.MouseLeave:Connect(function()
			lift(false)
		end)
		-- Gamepad: the selected card lifts like a hovered one.
		entry.button.SelectionGained:Connect(function()
			lift(true)
		end)
		entry.button.SelectionLost:Connect(function()
			lift(false)
		end)
		entry.button.MouseButton1Down:Connect(function()
			if Kit.touch then
				lift(true)
				task.delay(0.25, function()
					lift(false)
				end)
			end
		end)
	end

	-- Purchases: the last product prompted, so landed cash or aura flies from its card.
	local lastPrompt: { kind: string, entry: Entry, index: number, at: number }? = nil

	-- Candy card for cosmetics: art, outlined title, a darker inset with the description
	-- (14-15 px, up to two lines) and the price button along the bottom.
	type PassCard = Entry & { tag: TextLabel?, owned: TextLabel, desc: TextLabel, wasOwned: boolean? }
	local function tileCard(
		grid: Frame,
		name: string,
		order: number,
		tint: Color3,
		art: { string },
		title: string,
		descText: string,
		buttonText: string,
		onClick: () -> ()
	): PassCard
		local cell, body, artHolder, artGui = makeEntry(grid, name, order, tint, art[1], art[2], 74, UDim2.new(0.5, 0, 0, 43))
		local lipColor = Kit.lip(tint)
		local titleLabel = minText(Kit.title(body, {
			Name = "Title",
			Text = string.upper(title),
			TextSize = 24,
			MaxTextSize = 24,
			TextScaled = true,
			TextWrapped = false,
			Size = UDim2.new(1, -20, 0, 26),
			Position = UDim2.fromOffset(10, 81),
			TextColor3 = Color3.new(1, 1, 1),
			StrokeThickness = 0,
			ZIndex = 4,
		}))
		Kit.new("UIStroke", { Thickness = 2.5, Color = lipColor, Parent = titleLabel })
		local inset = Kit.new("Frame", {
			Name = "Inset",
			BackgroundColor3 = Kit.darken(tint, 0.28),
			BackgroundTransparency = 0.1,
			Size = UDim2.new(1, -20, 0, 40),
			Position = UDim2.fromOffset(10, 110),
			ZIndex = 3,
			Parent = body,
		})
		Kit.corner(inset, 10)
		local desc = minText(Kit.text(inset, {
			Name = "Desc",
			Text = descText,
			Font = F.Bold,
			TextSize = 15,
			MaxTextSize = 15,
			TextScaled = true,
			Size = UDim2.new(1, -12, 1, -4),
			Position = UDim2.fromOffset(6, 2),
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
		}))
		local button, sheen = priceButton(body, {
			Text = buttonText,
			Size = UDim2.new(1, -20, 0, PRICE_H),
			Position = UDim2.new(0, 10, 1, -10),
			AnchorPoint = Vector2.new(0, 1),
		}, onClick)
		local owned = ribbon(body, "OWNED", C.Good)
		owned.Visible = false
		local entry: PassCard = {
			cell = cell,
			body = body,
			art = artGui,
			artHolder = artHolder,
			button = button,
			sheen = sheen,
			owned = owned,
			desc = desc,
		}
		hoverable(entry)
		table.insert(entries, entry)
		return entry
	end

	-- Wide cards: art on the left (WIDE_LEFT px), text in the middle, the price button on the right.
	local WIDE_LEFT = 136
	local WIDE_PRICE_W = 150
	local WIDE_TEXT_W = -(WIDE_LEFT + WIDE_PRICE_W + 34) -- text column width (scale 1 plus this)
	local WIDE_R = Kit.RADIUS.M + 4

	-- Wide card text: an outlined title and, when given, a one-line caption under it.
	local function wideText(body: Frame, tint: Color3, title: string, caption: string?): TextLabel
		local titleLabel = minText(Kit.title(body, {
			Name = "Title",
			Text = title,
			TextSize = 28,
			MaxTextSize = 28,
			TextScaled = true,
			TextWrapped = false,
			Size = UDim2.new(1, WIDE_TEXT_W, 0, 32),
			Position = UDim2.fromOffset(WIDE_LEFT, 10),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.new(1, 1, 1),
			StrokeThickness = 0,
			ZIndex = 4,
		}))
		Kit.new("UIStroke", { Thickness = 3, Color = Kit.lip(tint), Parent = titleLabel })
		if caption then
			local captionLabel = Kit.text(body, {
				Name = "Caption",
				Text = caption,
				Font = F.Bold,
				TextSize = 15,
				TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Size = UDim2.new(1, WIDE_TEXT_W, 0, 18),
				Position = UDim2.fromOffset(WIDE_LEFT + 2, 42),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Color3.new(1, 1, 1),
				ZIndex = 4,
			})
			outline(captionLabel, tint)
		end
		return titleLabel
	end

	-- The price button on the right of a wide card, vertically centred (same style as every card).
	local function widePrice(body: Frame, text: string, onClick: () -> ()): (TextButton, Frame?)
		return priceButton(body, {
			Text = text,
			Size = UDim2.fromOffset(WIDE_PRICE_W, PRICE_H),
			Position = UDim2.new(1, -18, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
		}, onClick)
	end

	-- Starter pack: a wide mint hero card at the very top while the player does not own it --
	local starterPass = Theme.Monetization.Passes[COS.Starter.Pass]
	local starterTint = Theme.World.Mint
	local starterCell, starterBody, starterArtHolder, starterArt =
		makeEntry(scroll, "Starter", 0, starterTint, COS.Starter.Icon, "Star", 104, UDim2.new(0, 68, 0.5, 0))
	local starterClip = bannerPaint(starterBody, starterTint, WIDE_R)
	wideText(starterBody, starterTint, "STARTER PACK")
	-- What is inside: two chips, this player's own cash amount and the exclusive trail.
	local chips = Kit.new("Frame", {
		Name = "Contents",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, WIDE_TEXT_W, 0, 56),
		Position = UDim2.fromOffset(WIDE_LEFT, 50),
		ZIndex = 4,
		Parent = starterBody,
	})
	Kit.list(chips, 8, true)
	local function contentChip(order: number, icon: string, fallback: string, color: Color3, caption: string): TextLabel
		local chip = Kit.new("Frame", {
			Name = "Chip" .. order,
			BackgroundColor3 = Kit.darken(starterTint, 0.3),
			BackgroundTransparency = 0.05,
			Size = UDim2.new(1 / 2, -4, 1, 0),
			LayoutOrder = order,
			ZIndex = 3,
			Parent = chips,
		})
		Kit.corner(chip, 12)
		Kit.icon(chip, Kit.pickIcon(icon, fallback), 34, color, {
			Name = "Icon",
			Position = UDim2.new(0, 6, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = 4,
		})
		local amount = minText(Kit.number(chip, {
			Name = "Amount",
			Text = "",
			TextSize = 20,
			MaxTextSize = 20,
			TextScaled = true,
			Size = UDim2.new(1, -50, 0, 24),
			Position = UDim2.fromOffset(44, 6),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
		}))
		Kit.text(chip, {
			Name = "Caption",
			Text = caption,
			Font = F.Bold,
			TextSize = 14,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -50, 0, 18),
			Position = UDim2.fromOffset(44, 31),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = C.Text,
			ZIndex = 4,
		})
		return amount
	end
	local starterCash = contentChip(1, "Coin", "Coin", C.Gold, "cash")
	local rookie = COS.Items[COS.Starter.Item]
	local rookieLabel = contentChip(2, rookie.Icon, "Star", rookie.Color, "exclusive")
	rookieLabel.Text = rookie.Title
	local starterButton, starterSheen = widePrice(starterBody, price(starterPass.Price), function()
		action:FireServer({ action = "PromptPass", name = COS.Starter.Pass })
	end)
	local starterTag = ribbon(starterBody, "STARTER DEAL", RIBBON_PINK)
	local starterEntry: Entry = {
		cell = starterCell,
		body = starterBody,
		art = starterArt,
		artHolder = starterArtHolder,
		button = starterButton,
		sheen = starterSheen,
		clip = starterClip,
	}
	hoverable(starterEntry)
	table.insert(entries, starterEntry)
	-- Shown until the pass is owned (a fresh purchase celebrates first, then folds away).
	local starterShown = true
	local starterWasOwned: boolean? = nil
	local starterShownCash: number? = nil

	--[[
		Section 1: game passes, one full-width banner each. Left: the pass's
		animated stage (ShopScenes.pass); middle: chunky outlined title, a
		description and a PERMANENT pill; right: the price button. On a narrow
		window the stage gives up width first so the text column keeps its size.
	]]
	sectionHead(1)
	local passList = Kit.new("Frame", { Name = "Passes", BackgroundTransparency = 1, Parent = scroll })
	Kit.list(passList, GAP)
	type Banner = Entry & {
		tag: TextLabel?,
		owned: TextLabel,
		desc: TextLabel,
		info: Frame,
		stage: Frame,
		scene: Scene,
		wasOwned: boolean?,
	}
	local BANNER_R = Kit.RADIUS.L + 2
	local banners: { [string]: Banner } = {}
	local bannerList: { Banner } = {}
	for order, name in Theme.Monetization.PassOrder do
		local pass = Theme.Monetization.Passes[name]
		local tint = PASS_TINTS[name] or pass.Color
		local cell = Kit.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, BANNER_H),
			Parent = passList,
		})
		local body = Kit.panel(cell, { Name = "Body", Color = tint, Size = UDim2.fromScale(1, 1), Radius = BANNER_R })
		local clip = bannerPaint(body, tint, BANNER_R)
		-- The stage: a lit window in the banner's own tint (a diagonal light-to-deep
		-- gradient, a lighter rim and a glassy sheen along its top) the pass's little
		-- scene plays in. It clips the scene, so nothing it draws reaches the text.
		local stage = Kit.new("Frame", {
			Name = "Stage",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			ClipsDescendants = true,
			Size = UDim2.fromOffset(STAGE_W, BANNER_H - 18),
			Position = UDim2.fromOffset(9, 9),
			ZIndex = 4,
			Parent = body,
		})
		Kit.corner(stage, BANNER_R - 6)
		Kit.new("UIGradient", {
			Color = ColorSequence.new(Kit.lighten(tint, 0.15), Kit.darken(tint, 0.1)),
			Rotation = 35,
			Parent = stage,
		})
		Kit.new("UIStroke", {
			Thickness = 2,
			Color = Kit.lighten(tint, 0.5),
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = stage,
		})
		-- Extra room on the right: counters a scene draws at its right edge stay whole
		-- inside the stage instead of being cut off right next to the title.
		Kit.new("UIPadding", {
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 22),
			Parent = stage,
		})
		-- Created before the scene, so the scene draws over it (offsets undo the padding).
		local stageSheen = Kit.new("Frame", {
			Name = "Sheen",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 12, 0, 22),
			Position = UDim2.fromOffset(2, 4),
			ZIndex = 1,
			Parent = stage,
		})
		Kit.corner(stageSheen, 11)
		Kit.new("UIGradient", {
			Transparency = NumberSequence.new(0.35, 1),
			Rotation = 90,
			Parent = stageSheen,
		})
		local scene: Scene = ShopScenes.pass(stage, name, tint)
		-- The text column sits above the stage (and anything its scene draws).
		local info = Kit.new("Frame", {
			Name = "Info",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 6,
			Parent = body,
		})
		local title = minText(Kit.title(info, {
			Name = "Title",
			Text = string.upper(pass.Title),
			TextSize = 30,
			MaxTextSize = 30,
			TextScaled = true,
			TextWrapped = false,
			Size = UDim2.new(1, 0, 0, 34),
			Position = UDim2.fromOffset(0, 12),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.new(1, 1, 1),
			StrokeThickness = 0,
			ZIndex = 6,
		}))
		Kit.new("UIStroke", {
			Thickness = 3,
			Color = Kit.lip(tint),
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = title,
		})
		local desc = Kit.text(info, {
			Name = "Desc",
			Text = pass.Desc,
			Font = F.Bold,
			TextSize = 16,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.fromOffset(1, 49),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 6,
		})
		outline(desc, tint)
		-- PERMANENT: white on the tint's deep navy-leaning tone, so it reads on every banner.
		Kit.pill(info, {
			Name = "Perk",
			Text = "PERMANENT",
			Color = Kit.darken(Kit.lip(tint), 0.25),
			Solid = true,
			TextColor = Color3.new(1, 1, 1),
			TextSize = 15,
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			Position = UDim2.new(0, 0, 1, -12),
			AnchorPoint = Vector2.new(0, 1),
			ZIndex = 6,
		})
		local button, sheen = priceButton(body, {
			Text = price(pass.Price),
			Size = UDim2.fromOffset(150, PRICE_H),
			Position = UDim2.new(1, -16, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
		}, function()
			action:FireServer({ action = "PromptPass", name = name })
		end)
		local tagInfo = PASS_TAGS[name]
		local owned = ribbon(body, "OWNED", C.Good)
		owned.Visible = false
		local banner: Banner = {
			cell = cell,
			body = body,
			art = nil,
			artHolder = stage,
			button = button,
			sheen = sheen,
			clip = clip,
			tag = if tagInfo then ribbon(body, tagInfo.text, tagInfo.color) else nil,
			owned = owned,
			desc = desc,
			info = info,
			stage = stage,
			scene = scene,
		}
		hoverable(banner)
		table.insert(entries, banner)
		table.insert(cascade, cell)
		table.insert(scenes, scene)
		banners[name] = banner
		table.insert(bannerList, banner)
	end
	-- Fits a banner to the window: stage width, the text column between it and the price.
	local function placeBanner(banner: Banner, stageW: number, priceW: number)
		banner.stage.Size = UDim2.fromOffset(stageW, BANNER_H - 18)
		-- A wide gap: the scene's counters stop at the stage edge, the title starts well clear of it.
		local left = 9 + stageW + 28
		banner.info.Position = UDim2.fromOffset(left, 0)
		banner.info.Size = UDim2.new(1, -(left + priceW + 16 + 14), 1, 0)
		banner.button.Size = UDim2.fromOffset(priceW, PRICE_H)
	end

	-- Section 2: cosmetics -------------------------------------------------------------
	sectionHead(2)
	-- Taps wait for the server; until its next snapshot (or 1.5 s) the card shows the choice.
	local pendingCos: { [string]: { value: any, at: number } } = {}
	local function shownChoice(key: string, serverValue: any): any
		local pending = pendingCos[key]
		if pending and os.clock() - pending.at < 1.5 and pending.value ~= serverValue then
			return pending.value
		end
		pendingCos[key] = nil
		return serverValue
	end

	-- All Cosmetics: a wide coral banner with every cosmetic it unlocks in a row.
	local bundlePass = Theme.Monetization.Passes[COS.Bundle]
	local bundleTint = Theme.World.Coral
	local bundleCell, bundleBody, bundleArtHolder, bundleArt =
		makeEntry(scroll, "Bundle", 0, bundleTint, COS.BundleIcon, "Crown", 100, UDim2.new(0, 68, 0.5, 0))
	local bundleClip = bannerPaint(bundleBody, bundleTint, WIDE_R)
	wideText(bundleBody, bundleTint, string.upper(bundlePass.Title), "Everything below, forever")
	local included = 0
	for _, name in COS_ORDER do
		if not COS.Items[name].Starter then
			included += 1
		end
	end
	local includes = Kit.new("Frame", {
		Name = "Includes",
		BackgroundColor3 = Kit.darken(bundleTint, 0.28),
		BackgroundTransparency = 0.1,
		Size = UDim2.fromOffset(included * 40 - 6 + 16, 44),
		Position = UDim2.fromOffset(WIDE_LEFT, 64),
		ZIndex = 4,
		Parent = bundleBody,
	})
	Kit.corner(includes, 12)
	Kit.padding(includes, 5, 8)
	Kit.list(includes, 6, true).VerticalAlignment = Enum.VerticalAlignment.Center
	for i, name in COS_ORDER do
		local item = COS.Items[name]
		if not item.Starter then
			Kit.icon(includes, Kit.pickIcon(item.Icon, "Star"), 34, item.Color, { Name = name, LayoutOrder = i, ZIndex = 4 })
		end
	end
	local bundleButton, bundleSheen = widePrice(bundleBody, price(bundlePass.Price), function()
		action:FireServer({ action = "PromptPass", name = COS.Bundle })
	end)
	local saving = bundleSaving()
	local bundleSave = ribbon(bundleBody, string.format("SAVE %d%%", saving), RIBBON_SUNNY)
	bundleSave.Visible = saving > 0
	local bundleOwnedTag = ribbon(bundleBody, "OWNED", C.Good)
	bundleOwnedTag.Visible = false
	local bundleEntry: Entry = {
		cell = bundleCell,
		body = bundleBody,
		art = bundleArt,
		artHolder = bundleArtHolder,
		button = bundleButton,
		sheen = bundleSheen,
		clip = bundleClip,
	}
	hoverable(bundleEntry)
	table.insert(entries, bundleEntry)
	local bundleWasOwned: boolean? = nil

	-- One card per cosmetic. Owned trails show EQUIP / EQUIPPED, owned perks and wearables an
	-- on/off switch; a Starter-only item stays locked until the Starter pack is owned.
	local cosGrid = Kit.new("Frame", { Name = "Cosmetics", BackgroundTransparency = 1, Parent = scroll })
	local cosLayout = Kit.new("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -11, 0, COS_H),
		CellPadding = UDim2.fromOffset(GAP, GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = cosGrid,
	})
	type CosCard = PassCard & {
		lock: GuiObject?,
		control: Frame?,
		setSwitch: ((boolean, boolean?) -> ())?,
		switchShown: boolean?,
	}
	local cosCards: { [string]: CosCard } = {}
	local function cosTap(name: string)
		local data = State.data
		if not data then
			return
		end
		local cos = cosmeticsOf(data)
		local item = COS.Items[name]
		if cos.owned[name] then
			if item.Kind == "trail" then
				local current = shownChoice("trail", cos.trail or "")
				local value = if current == name then "" else name
				pendingCos.trail = { value = value, at = os.clock() }
				action:FireServer({ action = "EquipTrail", name = value })
				refresh()
			end
		elseif item.Starter then
			-- Only the Starter pack gives it: bring that card into view.
			scrollTo(0)
			Kit.pop(starterCell, 1)
		elseif item.Pass then
			action:FireServer({ action = "PromptPass", name = item.Pass })
		end
	end
	for order, name in COS_ORDER do
		local item = COS.Items[name]
		local pass = item.Pass and Theme.Monetization.Passes[item.Pass]
		local tint = COS_TINTS[name] or item.Color
		local card = tileCard(
			cosGrid,
			name,
			order,
			tint,
			{ item.Icon, "Star" },
			item.Title,
			if item.Starter then "Starter Pack exclusive" else item.Desc,
			if pass then price(pass.Price) else "STARTER PACK",
			function()
				cosTap(name)
			end
		) :: CosCard
		if item.Starter then
			card.tag = ribbon(card.body, "EXCLUSIVE", RIBBON_PINK)
			card.lock = Kit.icon(card.body, "Lock", 30, C.Text, {
				Name = "Lock",
				Position = UDim2.fromOffset(14, 12),
				ZIndex = 5,
			})
		end
		if item.Kind ~= "trail" then
			-- Owned perk / wearable: "ACTIVE" with an on/off switch where the price was.
			local control = Kit.new("Frame", {
				Name = "Control",
				BackgroundColor3 = Kit.darken(tint, 0.28),
				BackgroundTransparency = 0.1,
				Size = UDim2.new(1, -20, 0, 42),
				Position = UDim2.new(0, 10, 1, -10),
				AnchorPoint = Vector2.new(0, 1),
				Visible = false,
				ZIndex = 4,
				Parent = card.body,
			})
			Kit.corner(control, 12)
			Kit.text(control, {
				Name = "Label",
				Text = "ACTIVE",
				Font = F.UI,
				TextSize = 17,
				TextWrapped = false,
				Size = UDim2.new(1, -90, 1, 0),
				Position = UDim2.fromOffset(14, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Color3.new(1, 1, 1),
				ZIndex = 5,
			})
			local toggle, set = Kit.switch(control, {
				Name = "Toggle",
				Position = UDim2.new(1, -8, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
			}, function()
				local data = State.data
				if not data then
					return
				end
				local cos = cosmeticsOf(data)
				if not cos.owned[name] then
					return
				end
				local value = not shownChoice(name, cos.toggles[name] ~= false)
				pendingCos[name] = { value = value, at = os.clock() }
				action:FireServer({ action = "ToggleCosmetic", name = name, value = value })
				refresh()
			end)
			-- The switch's ON / OFF word at the shop's 14 px floor.
			local state = toggle:FindFirstChild("State")
			if state and state:IsA("TextLabel") then
				state.TextSize = MIN_TEXT
				state.TextWrapped = false
			end
			card.control = control
			card.setSwitch = set
		end
		cosCards[name] = card
	end

	--[[
		Sections 3-4: cash and aura pack cards. Each card: the pack's
		animated stage (ShopScenes.pack) on a soft halo, the amount this player
		gets (it rolls when it changes), a short caption and the price button.
		The cards sit on a deep version of the section colour so the mint price
		buttons stay the brightest thing on them.
	]]
	type Pack = Entry & { amount: TextLabel, sub: TextLabel, scene: Scene }
	type PackGrid = {
		grid: Frame,
		layout: UIGridLayout,
		count: number,
		wide: number,
		narrow: number,
		columns: number,
		cardW: number,
	}
	local packGrids: { PackGrid } = {}
	-- `wide` / `narrow`: columns on a wide / narrow window (the cell size follows them; a row
	-- with fewer cards than columns is centred).
	local function packGrid(name: string, packCount: number, wide: number, narrow: number): PackGrid
		local grid = Kit.new("Frame", { Name = name, BackgroundTransparency = 1, Parent = scroll })
		local gridLayout = Kit.new("UIGridLayout", {
			CellSize = UDim2.new(1 / wide, 0, 0, PACK_H),
			CellPadding = UDim2.fromOffset(GAP, GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Parent = grid,
		})
		local packs: PackGrid =
			{ grid = grid, layout = gridLayout, count = packCount, wide = wide, narrow = narrow, columns = wide, cardW = 180 }
		table.insert(packGrids, packs)
		return packs
	end
	--[[
		Amounts are the hero of a pack card: the currency icon and a big bold number
		in the pack colour with a dark outline. The number's size follows its length
		and the card width (28 px, never under 24 px for the short number format).
	]]
	local amountGrid: { [TextLabel]: PackGrid } = {}
	local function fitAmount(label: TextLabel, text: string)
		local packs = amountGrid[label]
		local room = (if packs then packs.cardW else 180) - 20 - PACK_ICON - 4
		label.TextSize = math.clamp(math.floor(room / (0.68 * math.max(#text, 1))), 16, 28)
	end
	local function setAmount(label: TextLabel, text: string)
		fitAmount(label, text)
		label.Text = text
	end
	local function packCard(
		packs: PackGrid,
		kind: string,
		index: number,
		packPrice: number,
		accent: Color3,
		amountColor: Color3,
		icon: string
	): Pack
		local grid = packs.grid
		local cell = Kit.new("Frame", { Name = kind .. index, BackgroundTransparency = 1, LayoutOrder = index, Parent = grid })
		local radius = Kit.RADIUS.L
		local deep = Kit.darken(accent, 0.45)
		local body = Kit.panel(cell, { Name = "Body", Color = deep, Size = UDim2.fromScale(1, 1), Radius = radius })
		local clip = bannerPaint(body, deep, radius, Kit.lighten(accent, 0.15))
		-- Moulded-plastic highlight along the top of the card.
		local shine = Kit.new("Frame", {
			Name = "Shine",
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -12, 0, 30),
			Position = UDim2.fromOffset(6, 4),
			ZIndex = 2,
			Parent = body,
		})
		Kit.corner(shine, radius - 4)
		Kit.new("UIGradient", { Transparency = NumberSequence.new(0.3, 1), Rotation = 90, Parent = shine })
		-- A soft glow in the pack colour behind the stage, bigger and brighter up the ladder.
		local glowSize = math.floor(PACK_STAGE * (0.85 + 0.1 * index))
		local glowId = Sprites.image("SoftDot")
		local glowProps = {
			Name = "Halo",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(glowSize, glowSize),
			Position = UDim2.new(0.5, 0, 0, 8 + PACK_STAGE // 2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 3,
			Parent = body,
		}
		if glowId then
			local glow = Kit.new("ImageLabel", glowProps)
			glow.Image = glowId
			glow.ImageColor3 = Kit.lighten(accent, 0.2)
			glow.ImageTransparency = math.max(0.1, 0.5 - 0.1 * index)
			glow.ScaleType = Enum.ScaleType.Fit
		else
			local glow = Kit.new("Frame", glowProps)
			glow.BackgroundColor3 = accent
			glow.BackgroundTransparency = math.max(0.45, 0.8 - 0.08 * index)
			Kit.round(glow)
		end
		local stage = Kit.new("Frame", {
			Name = "Stage",
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Size = UDim2.fromOffset(PACK_STAGE, PACK_STAGE),
			Position = UDim2.new(0.5, 0, 0, 8),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 4,
			Parent = body,
		})
		local scene: Scene = ShopScenes.pack(stage, kind, index)
		local amountRow = Kit.new("Frame", {
			Name = "AmountRow",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -12, 0, 32),
			Position = UDim2.fromOffset(6, PACK_STAGE + 8),
			ZIndex = 4,
			Parent = body,
		})
		Kit.list(amountRow, 4, true, Enum.HorizontalAlignment.Center).VerticalAlignment = Enum.VerticalAlignment.Center
		Kit.icon(amountRow, icon, PACK_ICON, iconColor(icon), { Name = "Icon", LayoutOrder = 1, ZIndex = 4 })
		local amount = Kit.number(amountRow, {
			Name = "Amount",
			Text = "",
			TextSize = 28,
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			TextColor3 = amountColor,
			LayoutOrder = 2,
			StrokeThickness = 0,
			ZIndex = 4,
		})
		Kit.new("UIStroke", {
			Thickness = 1.6,
			Color = C.Ink,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = amount,
		})
		amountGrid[amount] = packs
		local sub = Kit.text(body, {
			Name = "Sub",
			Text = "",
			Font = F.Bold,
			TextSize = 15,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -12, 0, 20),
			Position = UDim2.fromOffset(6, PACK_STAGE + 41),
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
		})
		outline(sub, deep)
		local pack: Pack
		local button, sheen = priceButton(body, {
			Text = price(packPrice),
			Size = UDim2.new(1, -16, 0, PRICE_H),
			Position = UDim2.new(0, 8, 1, -8),
			AnchorPoint = Vector2.new(0, 1),
		}, function()
			lastPrompt = { kind = kind, entry = pack, index = index, at = os.clock() }
			action:FireServer({ action = "PromptProduct", kind = kind, index = index })
		end)
		pack = {
			cell = cell,
			body = body,
			art = nil,
			artHolder = stage,
			button = button,
			sheen = sheen,
			clip = clip,
			amount = amount,
			sub = sub,
			scene = scene,
		}
		hoverable(pack)
		table.insert(entries, pack)
		table.insert(cascade, cell)
		table.insert(scenes, scene)
		return pack
	end
	-- Cash and aura: the second pack is the popular one, the biggest the best value.
	local function packTags(pack: Pack, index: number, total: number)
		if index == total then
			ribbon(pack.body, "BEST VALUE", RIBBON_CORAL)
		elseif index == 2 and total >= 3 then
			ribbon(pack.body, "POPULAR", RIBBON_SUNNY)
		end
	end

	sectionHead(3)
	local moneyPacks = Theme.Monetization.MoneyPacks
	local cashPacks = packGrid("Cash", #moneyPacks, math.min(#moneyPacks, 4), 2)
	local cashGrid = cashPacks.grid
	local moneyLabels: { TextLabel } = {}
	local moneyShown: { [number]: number } = {}
	for index, pack in moneyPacks do
		local card = packCard(cashPacks, "Money", index, pack.Price, C.Cash, C.MoneyText, "Coin")
		moneyLabels[index] = card.amount
		card.sub.Text = string.format("%s of income", durationText(pack.Seconds))
		packTags(card, index, #moneyPacks)
	end

	sectionHead(4)
	local auraPacks = Theme.Monetization.AuraPacks
	local auraPackGrid = packGrid("Aura", #auraPacks, math.min(#auraPacks, 4), 2)
	local auraGrid = auraPackGrid.grid
	local auraLabels: { TextLabel } = {}
	local auraShown: { [number]: number } = {}
	for index, pack in auraPacks do
		local card = packCard(auraPackGrid, "Aura", index, pack.Price, C.Violet, Kit.lighten(C.Orb, 0.55), "Orb")
		auraLabels[index] = card.amount
		card.sub.Text = string.format("%s of %s", durationText(pack.Seconds), string.lower(W.Orb))
		packTags(card, index, #auraPacks)
	end

	-- Layout: explicit positions so the switcher knows where each section starts,
	-- and the grids reflow (cosmetics 3 -> 2 columns, cash and aura 4 -> 2) when the window narrows.
	local columnsNow = 3
	local gridTop: { [Frame]: number } = {}
	local headY: { number } = {} -- canvas height of each section header
	local passesY = 0
	-- Marks the end of the page, so the bottom can be found from on-screen positions.
	local pageEnd = Kit.new("Frame", {
		Name = "PageEnd",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(1, 0),
		Parent = scroll,
	})
	local function gridH(cards: number, columns: number, cellH: number): number
		local rows = math.ceil(cards / columns)
		return rows * cellH + (rows - 1) * GAP
	end
	local function cellSize(columns: number, cellH: number): UDim2
		return UDim2.new(1 / columns, -math.ceil(GAP * (columns - 1) / columns), 0, cellH)
	end
	function layout(size: Vector2)
		local wide = size.X >= 760
		local columns = if wide then 3 else 2
		columnsNow = columns
		cosLayout.CellSize = cellSize(columns, COS_H)
		for _, packs in packGrids do
			packs.columns = if wide then packs.wide else packs.narrow
			packs.layout.CellSize = cellSize(packs.columns, PACK_H)
			packs.cardW = (size.X - 62 - 18 - GAP * (packs.columns - 1)) / packs.columns
		end
		for label in amountGrid do
			if label.Text ~= "" then
				fitAmount(label, label.Text)
			end
		end
		-- Banners: the page width (window minus the well's inset, padding and scrollbar
		-- gutter) sets the stage width; the text column keeps at least ~240 px.
		local pageW = size.X - 62
		local stageW = math.clamp(pageW - 568, STAGE_MIN_W, STAGE_W)
		local priceW = if wide then 150 else 132
		for _, banner in bannerList do
			placeBanner(banner, stageW, priceW)
		end
		starterCell.Visible = starterShown
		local blocks: { { gui: GuiObject, h: number, gapAfter: number, section: number? } } = {
			{ gui = starterCell, h = if starterShown then STARTER_H else 0, gapAfter = if starterShown then 18 else 0 },
			{ gui = heads[1], h = HEAD_H, gapAfter = 14, section = 1 },
			{ gui = passList, h = gridH(#bannerList, 1, BANNER_H), gapAfter = 26 },
			{ gui = heads[2], h = HEAD_H, gapAfter = 14, section = 2 },
			{ gui = bundleCell, h = BUNDLE_H, gapAfter = GAP + 6 },
			{ gui = cosGrid, h = gridH(#COS_ORDER, columns, COS_H), gapAfter = 26 },
		}
		local packSections = { { 3, cashGrid }, { 4, auraGrid } }
		for i, entry in packSections do
			local packs = packGrids[i]
			table.insert(blocks, { gui = heads[entry[1]], h = HEAD_H, gapAfter = 14, section = entry[1] })
			table.insert(blocks, {
				gui = entry[2],
				h = gridH(packs.count, packs.columns, PACK_H),
				gapAfter = 26,
			})
		end
		-- The Starter card's ribbon overlaps its top edge: start a little lower for it.
		local y = if starterShown then 12 else 4
		for _, block in blocks do
			block.gui.Position = UDim2.fromOffset(4, y - previewShift)
			block.gui.Size = UDim2.new(1, -18, 0, block.h)
			if block.section then
				headY[block.section] = y
				sectionY[block.section] = y - 4
			end
			if block.gui:IsA("Frame") then
				gridTop[block.gui] = y
			end
			y += block.h + block.gapAfter
		end
		-- The Passes pill opens the page at the very top, Starter card included.
		passesY = sectionY[1]
		sectionY[1] = 0
		-- The last section is short: room below it lets its header scroll all the way to the top.
		canvasH = math.max(y, sectionY[count] + pageH())
		pageEnd.Position = UDim2.fromOffset(0, canvasH - previewShift)
		scroll.CanvasSize = UDim2.fromOffset(0, canvasH)
		-- The switcher keeps its pills roomy but never wider than the page; narrow pills
		-- drop their icons so the labels stay at full size.
		local switchW = math.min(150 * count, size.X - 44)
		switcher.Size = UDim2.fromOffset(switchW, SWITCH_H)
		for _, icon in pillIcons do
			icon.Visible = switchW / count >= 140
		end
	end
	layout(window.size())
	window.onResize.Event:Connect(layout)

	-- Canvas height that brings item `order` of `grid` into view (its section header for the first row).
	local function cardY(grid: Frame, order: number, headY: number, cellH: number, columns: number): number
		local row = (order - 1) // columns
		if row == 0 then
			return headY
		end
		return (gridTop[grid] or 0) + row * (cellH + GAP) - 12
	end

	--[[
		Section in view: the last section whose header sits in the top part of the
		visible page (at or above 40% of its height), measured from where the
		headers really are on screen (so window and screen scaling cannot skew
		it). Moving to another section needs its header 18 px past that line, so
		the indicator does not flicker at a boundary. At the very bottom of the
		page the last section wins. Also fades the bottom-edge hint out there.
	]]
	local HYSTERESIS = 18
	local function sectionInView(): number
		local page = pageH()
		local offsets: { number } = {}
		local endOffset: number
		local scale = if PREVIEW then 0 else scroll.AbsoluteSize.Y / math.max(1, page)
		if scale > 0.05 then
			local top = scroll.AbsolutePosition.Y
			for i, head in heads do
				offsets[i] = (head.AbsolutePosition.Y - top) / scale
			end
			endOffset = (pageEnd.AbsolutePosition.Y - top) / scale
		else
			local top = if PREVIEW then previewShift else scroll.CanvasPosition.Y
			for i in heads do
				offsets[i] = (headY[i] or 0) - top
			end
			endOffset = canvasH - top
		end
		local atBottom = endOffset <= page + 2
		showFade(not atBottom)
		if atBottom then
			return count
		end
		local line = page * 0.4
		local function lastAbove(y: number): number
			local index = 1
			for i, offset in offsets do
				if offset <= y then
					index = i
				end
			end
			return index
		end
		local ahead = lastAbove(line - HYSTERESIS)
		local back = lastAbove(line + HYSTERESIS)
		if ahead > current then
			return ahead
		elseif back < current then
			return back
		end
		return current
	end
	function syncSection()
		setCurrent(sectionInView(), window.isOpen())
	end
	-- Scrolling re-checks on the next frame, once the engine has placed the page.
	local syncQueued = false
	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if PREVIEW or syncQueued or not window.isOpen() or os.clock() < pinUntil then
			return
		end
		syncQueued = true
		RunService.Heartbeat:Once(function()
			syncQueued = false
			if window.isOpen() and os.clock() >= pinUntil then
				syncSection()
			end
		end)
	end)

	-- Wallet chips ---------------------------------------------------------------------
	local chipMoney: number? = nil
	local chipAura: number? = nil

	-- Coins or orbs fly from a row to the header chip.
	local function flyTo(from: GuiObject, chipLabel: TextLabel, icon: string, color: Color3)
		if PREVIEW then
			return
		end
		local mine = session
		local start = centreOf(from)
		local finish = centreOf(chipLabel.Parent :: GuiObject)
		for i = 1, 7 do
			local piece = Kit.icon(frame, icon, 26, color, {
				Name = "Fly",
				Position = UDim2.fromOffset(start.X + math.random(-24, 24), start.Y + math.random(-14, 14)),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 40,
			})
			task.delay(i * 0.05, function()
				if session ~= mine then
					piece:Destroy()
					return
				end
				Kit.tween(
					piece,
					0.5,
					{ Position = UDim2.fromOffset(finish.X, finish.Y), Size = UDim2.fromOffset(16, 16) },
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				)
				task.delay(0.5, function()
					piece:Destroy()
					if i == 1 and session == mine then
						Kit.pop(chipLabel.Parent :: GuiObject, 1)
					end
				end)
			end)
		end
	end

	-- A card just became owned while the shop is open: it pops and its OWNED ribbon lands.
	local function celebrate(card: PassCard, delay: number, burst: boolean)
		local function go()
			if not window.isOpen() then
				card.owned.Visible = true
				return
			end
			Kit.pop(card.cell, 1.6)
			Kit.appear(card.owned, { from = 0.4, time = 0.3 })
			if burst then
				local spot = centreOf(card.cell)
				Kit.confetti(frame, { Origin = UDim2.fromOffset(spot.X, spot.Y), Count = 24, ZIndex = 45 })
				Kit.sound("Reward")
			end
		end
		if delay > 0 and not PREVIEW then
			task.delay(delay, go)
		else
			go()
		end
	end

	-- Starter card, All Cosmetics card and cosmetic cards from the snapshot.
	local function refreshCosmetics(data: { [string]: any }, open: boolean)
		local cos = cosmeticsOf(data)

		-- Starter pack: this player's amounts roll; a purchase celebrates, then the card folds away.
		local starterOwned = cos.starterOwned == true
		local starterJust = starterOwned and starterWasOwned == false and open
		local cash = Windows.starterAmounts(data)
		if starterShownCash and starterShownCash ~= cash and open then
			Kit.countTo(starterCash, starterShownCash, cash, State.money)
		elseif starterShownCash ~= cash then
			starterCash.Text = State.money(cash)
		end
		starterShownCash = cash
		Kit.setEnabled(starterButton, not starterOwned)
		Kit.setButton(starterButton, if starterOwned then "✓ OWNED" else price(starterPass.Price))
		starterTag.Visible = not starterOwned
		if starterOwned and starterShown then
			local mine = session
			local function fold()
				starterShown = false
				layout(window.size())
			end
			if starterJust and not PREVIEW then
				local spot = centreOf(starterCell)
				Kit.pop(starterCell, 1.6)
				Kit.confetti(frame, { Origin = UDim2.fromOffset(spot.X, spot.Y), Count = 30, ZIndex = 45 })
				Kit.sound("Reward")
				task.delay(1.6, function()
					if session ~= mine then
						fold()
						return
					end
					Kit.disappear(starterCell, { to = 0.9, time = 0.25, onDone = fold })
				end)
			else
				fold()
			end
		elseif not starterOwned and not starterShown then
			starterShown = true
			layout(window.size())
		end
		starterWasOwned = starterOwned

		-- All Cosmetics: owning it flips every card at once in one cascade.
		local bundleOwned = cos.bundleOwned == true
		local bundleJust = bundleOwned and bundleWasOwned == false and open
		Kit.setEnabled(bundleButton, not bundleOwned)
		Kit.setButton(bundleButton, if bundleOwned then "✓ OWNED" else price(bundlePass.Price))
		bundleSave.Visible = not bundleOwned and saving > 0
		if bundleJust then
			local spot = centreOf(bundleCell)
			Kit.pop(bundleCell, 1.6)
			Kit.confetti(frame, { Origin = UDim2.fromOffset(spot.X, spot.Y), Count = 36, ZIndex = 45 })
			Kit.appear(bundleOwnedTag, { from = 0.4, time = 0.3 })
			Kit.sound("Reward")
		else
			bundleOwnedTag.Visible = bundleOwned
		end
		bundleWasOwned = bundleOwned

		local trail = shownChoice("trail", cos.trail or "")
		local wave = 0
		for _, name in COS_ORDER do
			local card = cosCards[name]
			local item = COS.Items[name]
			local owned = cos.owned[name] == true
			if card.lock then
				card.lock.Visible = not owned
			end
			if card.tag then
				card.tag.Visible = not owned
			end
			card.desc.Text = if item.Starter and not owned then "Starter Pack exclusive" else item.Desc
			local control = card.control
			if owned and item.Kind == "trail" then
				local on = trail == name
				Kit.setEnabled(card.button, true)
				Kit.setButton(card.button, if on then "✓ EQUIPPED" else "EQUIP", if on then C.Gold else C.Cash)
			elseif owned and control and card.setSwitch then
				local on = shownChoice(name, cos.toggles[name] ~= false) == true
				if card.switchShown ~= on then
					card.switchShown = on
					card.setSwitch(on)
				end
			elseif item.Pass then
				local pass = Theme.Monetization.Passes[item.Pass]
				Kit.setEnabled(card.button, true)
				Kit.setButton(card.button, price(pass.Price), C.Cash)
			else
				Kit.setEnabled(card.button, true)
				Kit.setButton(card.button, "STARTER PACK", C.SurfaceHi)
			end
			card.button.Visible = not (owned and control ~= nil)
			if control then
				control.Visible = owned
			end
			if owned and card.wasOwned == false and open then
				-- With the bundle, every card flips in one wave; a single purchase bursts on its own
				-- (the Starter pack's trail lets the Starter card do the bursting).
				wave += 1
				celebrate(card, if bundleJust then wave * 0.07 else 0, not bundleJust and not (item.Starter and starterJust))
			else
				card.owned.Visible = owned
			end
			card.wasOwned = owned
		end
	end

	function refresh()
		local data = State.data
		if not data then
			return
		end
		local open = window.isOpen()
		-- Header chips roll; a landed purchase flies in from the card that was bought.
		local money, carried = data.money, data.carried or 0
		if chipMoney and money ~= chipMoney and open then
			Kit.countTo(cashChip, chipMoney, money, State.money)
			if money > chipMoney and lastPrompt and lastPrompt.kind == "Money" and os.clock() - lastPrompt.at < 120 then
				flyTo(lastPrompt.entry.button, cashChip, "Coin", C.Gold)
				lastPrompt = nil
			end
		elseif money ~= chipMoney then
			cashChip.Text = State.money(money)
		end
		-- The tank also fills from collecting, so only a jump of about a pack's size counts as the purchase.
		if chipAura and carried ~= chipAura and open then
			Kit.countTo(auraChip, chipAura, carried, State.num)
			local prompt = lastPrompt
			if
				prompt
				and prompt.kind == "Aura"
				and os.clock() - prompt.at < 120
				and carried - chipAura >= (auraShown[prompt.index] or 0) * 0.5
			then
				flyTo(prompt.entry.button, auraChip, "Orb", C.Orb)
				lastPrompt = nil
			end
		elseif carried ~= chipAura then
			auraChip.Text = State.num(carried)
		end
		chipMoney, chipAura = money, carried

		-- Each player sees their own pack sizes (the server grants with the same functions).
		local progression = Economy.progression(data.highestTier or 1, data.processLevel or 0)
		for index, pack in moneyPacks do
			local amount = Economy.moneyPackAmount(data.income, pack.Seconds, pack.Min, progression)
			local shown = moneyShown[index]
			moneyShown[index] = amount
			if shown and shown ~= amount and open then
				fitAmount(moneyLabels[index], State.num(amount))
				Kit.countTo(moneyLabels[index], shown, amount, State.num)
			elseif shown ~= amount then
				setAmount(moneyLabels[index], State.num(amount))
			end
		end
		for index, pack in auraPacks do
			local amount = Economy.auraPackAmount(data.production or 0, pack.Seconds, pack.Min, progression)
			local shown = auraShown[index]
			auraShown[index] = amount
			if shown and shown ~= amount and open then
				fitAmount(auraLabels[index], State.num(amount))
				Kit.countTo(auraLabels[index], shown, amount, State.num)
			elseif shown ~= amount then
				setAmount(auraLabels[index], State.num(amount))
			end
		end
		for name, banner in banners do
			local pass = Theme.Monetization.Passes[name]
			local owned = data.passes[name] == true
			-- Crate Master opens paid random items: not sold where those are restricted.
			local blocked = name == "CrateKey" and not owned and data.crateRobux ~= true
			if banner.tag then
				banner.tag.Visible = not owned
			end
			Kit.setEnabled(banner.button, not owned and not blocked)
			Kit.setButton(banner.button, if owned then "✓ OWNED" elseif blocked then "UNAVAILABLE" else price(pass.Price))
			banner.desc.Text = if blocked then "Not available here" else pass.Desc
			if owned and banner.wasOwned == false and open then
				-- Just bought: the banner celebrates, its scene throws a party and the OWNED ribbon lands.
				Kit.pop(banner.cell, 1.2)
				banner.scene.celebrate()
				local spot = centreOf(banner.cell)
				Kit.confetti(frame, { Origin = UDim2.fromOffset(spot.X, spot.Y), Count = 24, ZIndex = 45 })
				Kit.appear(banner.owned, { from = 0.4, time = 0.3 })
				Kit.sound("Reward")
			else
				banner.owned.Visible = owned
			end
			banner.wasOwned = owned
		end
		refreshCosmetics(data, open)
	end
	State.changed.Event:Connect(refresh)

	-- Idle motion while open: every scene plays, static art bobs out of phase, ribbons
	-- breathe, banners catch a slow sheen, the header drifts through candy colours,
	-- sparkles float behind the page, and one price button at a time gets a sheen.
	local function startIdle()
		if PREVIEW then
			return
		end
		local mine = session
		for _, scene in scenes do
			scene.play()
			table.insert(idleStops, scene.stop)
		end
		for _, idle in idleTweens do
			idle.tween:Play()
			table.insert(idleStops, function()
				idle.tween:Cancel()
				for key, value in idle.rest do
					(idle.gui :: any)[key] = value
				end
			end)
		end
		table.insert(idleStops, Kit.shimmer(headerSheen, 6, 2))
		for i, entry in entries do
			local art = entry.art
			if art then
				local base = art.Position
				local tween = TweenService:Create(
					art,
					TweenInfo.new(1.6 + (i % 3) * 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (i % 5) * 0.3),
					{ Position = base + UDim2.fromOffset(0, -4) }
				)
				tween:Play()
				table.insert(idleStops, function()
					tween:Cancel()
					Kit.tween(art, 0.15, { Position = base })
				end)
			end
			if entry.clip and entry.cell.Visible then
				table.insert(idleStops, Kit.shimmer(entry.clip, 5 + (i % 4) * 0.8, 3))
			end
		end
		local tagged: { { tag: TextLabel? } } = {}
		for _, banner in bannerList do
			table.insert(tagged, banner)
		end
		for _, card in cosCards do
			table.insert(tagged, card)
		end
		for _, card in tagged do
			local tag = card.tag
			if tag and tag.Visible then
				table.insert(idleStops, Kit.breathe(tag, 0.05))
			end
		end
		task.spawn(function()
			local turn = 0
			task.wait(1.2)
			while session == mine do
				for _ = 1, #entries do
					turn = turn % #entries + 1
					local entry = entries[turn]
					local state = entry.button.Active and entry.button.Visible and entry.cell.Visible and entry.sheen
					if state then
						local sheen = entry.sheen :: Frame
						sheen.Position = UDim2.new(0, -40, -0.3, 0)
						Kit.tween(sheen, 0.7, { Position = UDim2.new(1, 20, -0.3, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
						break
					end
				end
				task.wait(2.2)
			end
		end)
	end
	-- Closing (or reopening) stops every idle loop: scenes, tweens, sheens and timers.
	local function stopIdle()
		session += 1
		for _, stop in idleStops do
			stop()
		end
		table.clear(idleStops)
	end
	window.onClose.Event:Connect(stopIdle)

	focusPick.Shop = function()
		return shopFocusButton
	end
	beforeOpen.Shop = function()
		stopIdle()
		local mine = session
		refresh()
		local focus = Windows.shopFocus or screen:GetAttribute("ShopFocus")
		Windows.shopFocus = nil
		screen:SetAttribute("ShopFocus", nil)
		-- Where the page opens: the focused banner, card or section, otherwise the top.
		local index = 1
		local y = 0
		local focusCell: GuiObject? = nil
		if type(focus) == "string" then
			for i, section in SECTIONS do
				if section.key == focus then
					index = i
					y = sectionY[i] or 0
				end
			end
			local passOrder = table.find(Theme.Monetization.PassOrder, focus)
			local cosOrder = table.find(COS_ORDER, focus)
			if passOrder and banners[focus] then
				y = cardY(passList, passOrder, passesY, BANNER_H, 1)
				focusCell = banners[focus].cell
			elseif focus == COS.Starter.Pass and starterShown then
				focusCell = starterCell
			elseif focus == COS.Bundle then
				index, y = 2, sectionY[2]
				focusCell = bundleCell
			elseif cosOrder then
				-- The first cosmetics row sits under the All Cosmetics card.
				index, y = 2, cardY(cosGrid, cosOrder, sectionY[2], COS_H, columnsNow)
				focusCell = cosCards[focus].cell
			end
		end
		scrollTo(y, true)
		setCurrent(index, false)
		showFade(math.min(y, maxScroll()) < maxScroll() - 2)
		-- Gamepad: opened at a card, the selection starts on its buy button.
		shopFocusButton = nil
		if focusCell then
			for _, entry in entries do
				if entry.cell == focusCell then
					shopFocusButton = entry.button
				end
			end
		end

		-- Opening choreography: section headers slide in, cards and banners ripple in (scale +
		-- fade, 28 ms apart), the cart lands a beat later with an overshoot and wiggle.
		for i, head in heads do
			if not PREVIEW then
				local target = head.Position
				head.Position = target + UDim2.fromOffset(-24, 0)
				Kit.tween(head, 0.32, { Position = target }, Enum.EasingStyle.Back)
				Kit.appear(head, { from = 1, time = 0.2, delay = (i - 1) * 0.05 })
			end
		end
		local shown: { GuiObject } = {}
		for _, cell in cascade do
			if cell.Visible then
				table.insert(shown, cell)
			end
		end
		Kit.stagger(shown, 0.028)
		if not PREVIEW then
			cartScale.Scale = 0
			cart.Rotation = -18
			task.delay(0.14, function()
				if session ~= mine then
					cartScale.Scale = 1
					cart.Rotation = 0
					return
				end
				Kit.tween(cartScale, 0.34, { Scale = 1 }, Enum.EasingStyle.Back)
				Kit.tween(cart, 0.16, { Rotation = 10 }, Enum.EasingStyle.Quad)
				task.delay(0.16, function()
					Kit.tween(cart, 0.3, { Rotation = 0 }, Enum.EasingStyle.Back)
				end)
			end)
			task.delay(0.5, function()
				if session ~= mine then
					return
				end
				startIdle()
				if focusCell then
					Kit.pop(focusCell, 1)
				end
			end)
		end
	end

	-- Kept for callers that pick a section by name ("Passes", "Cosmetics", "Cash", "Aura").
	Windows.selectShopTab = function(key: string)
		for i, section in SECTIONS do
			if section.key == key then
				scrollToSection(i, true)
				setCurrent(i, false)
			end
		end
	end
end

-- Index -----------------------------------------------------------------------------

-- Where the sparkle stars burst around a freshly discovered card (card scale).
local SPARKLE_SPOTS = {
	{ 0.12, 0.18, 18 },
	{ 0.86, 0.14, 22 },
	{ 0.5, 0.06, 14 },
	{ 0.1, 0.72, 14 },
	{ 0.9, 0.66, 18 },
}

-- A soft "new!" moment: the card pops and a few stars twinkle around it.
local function sparkle(frame: Frame)
	if PREVIEW then
		return
	end
	Kit.pop(frame, 0.6)
	for i, spot in SPARKLE_SPOTS do
		local star = Kit.icon(frame, "Star", spot[3], C.GoldLight, {
			Name = "Sparkle",
			Position = UDim2.fromScale(spot[1], spot[2]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 6,
		})
		Kit.appear(star, { from = 0.2, time = 0.3, delay = (i - 1) * 0.06 })
		Kit.tween(star, 0.9, { Position = UDim2.new(spot[1], 0, spot[2], -10) })
		task.delay(0.55 + (i - 1) * 0.06, function()
			Kit.disappear(star, { to = 0.5, time = 0.25, destroy = true })
		end)
	end
end

-- Index card height (design px): number row, character, two-line name, rarity tag.
local CARD_H = 212

local function buildIndex(screen: ScreenGui)
	local window = Kit.window(screen, "Index", "Index", I.Index, C.Window.Index, Vector2.new(880, 560), Vector2.new(560, 440))
	register("Index", window)

	-- Discovered count: a compact bar in the header row, left of the close button.
	local _, setProgress, progressLabel = Kit.progress(window.header, {
		Name = "Found",
		Color = C.Window.Index,
		Size = UDim2.fromOffset(210, 28),
		Position = UDim2.new(1, -62, 0.5, -1),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = T.Small,
		MinFill = 0.08,
	})
	local function foundText(n: number): string
		return string.format("%d / %d FOUND", n, Economy.MAX_TIER)
	end

	-- Rarity legend: one slim row of tags above the grid.
	local legend = Kit.new("Frame", {
		Name = "Legend",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -14, 0, 26),
		Parent = window.content,
	})
	Kit.list(legend, 6, true, Enum.HorizontalAlignment.Left)
	for order, band in Economy.TIER_BANDS do
		Kit.pill(legend, {
			Text = string.upper(band.name),
			Color = C.Rarity[band.name],
			Solid = true,
			TextSize = T.Small,
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = order,
		})
	end

	local scroll = Kit.scrolling(window.content, { Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30) })
	-- The Index has no buttons: on gamepad the grid itself is selected so the stick scrolls it.
	Kit.selectable(scroll)
	focusPick.Index = function()
		return scroll
	end
	Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 14),
		PaddingBottom = UDim.new(0, 12),
		Parent = scroll,
	})
	local grid = Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.2, -12, 0, CARD_H),
		CellPadding = UDim2.fromOffset(14, 16),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	-- 5 columns at full width, 4 or 3 as the window narrows on small screens.
	local function layoutGrid(size: Vector2)
		local columns = if size.X >= 820 then 5 elseif size.X >= 680 then 4 else 3
		grid.CellSize = UDim2.new(1 / columns, -12, 0, CARD_H)
	end
	layoutGrid(window.size())
	window.onResize.Event:Connect(layoutGrid)

	local cards: { { frame: Frame, shown: string } } = {}
	local cardFrames: { GuiObject } = {}
	for tier = 1, Economy.MAX_TIER do
		local frame = Kit.panel(scroll, { Name = "Tier" .. tier, Elevated = true, LayoutOrder = tier, Radius = Kit.RADIUS.M + 2 })
		cards[tier] = { frame = frame, shown = "" }
		cardFrames[tier] = frame
	end

	-- Tiers discovered this session that the player hasn't looked at yet, and
	-- the ones whose "new" sparkle already played.
	local seen: { [number]: boolean } = {}
	local sparkled: { [number]: boolean } = {}
	local sessionStart: number? = nil

	local function fillCard(tier: number, discoveredAt: number, isNew: boolean)
		local entry = cards[tier]
		local key = (if discoveredAt > 0 then "known" else "unknown") .. (if isNew then "+new" else "")
		if entry.shown == key then
			return
		end
		local wasKnown = string.sub(entry.shown, 1, 5) == "known"
		entry.shown = key
		local frame = entry.frame
		clearChildren(frame)
		local band = Economy.tierBand(tier)
		local rarity = C.Rarity[band]
		local known = discoveredAt > 0
		-- Found: a raised tile with a rarity outline. Unknown: a quieter flat tile.
		if known then
			paintPanel(frame, C.SurfaceHi, rarity:Lerp(C.Edge, 0.3))
		else
			paintPanel(frame, C.Surface)
		end

		Kit.number(frame, {
			Name = "Tier",
			Text = "#" .. tier,
			TextSize = T.Small,
			Size = UDim2.new(0, 34, 0, 24),
			Position = UDim2.fromOffset(12, 8),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if known then C.TextDim else C.TextMute,
		})
		-- Name under the character: 14 px, up to two lines (never scaled down).
		Kit.text(frame, {
			Name = "Name",
			Text = if known then string.upper(Theme.Tiers[tier].Name) else "???",
			Font = F.UI,
			TextSize = T.Small,
			TextWrapped = true,
			Size = UDim2.new(1, -16, 0, 36),
			Position = UDim2.new(0, 8, 1, -70),
			TextColor3 = if known then C.Text else C.TextMute,
			ZIndex = 3,
		})
		if known then
			-- Soft rarity-tinted spot behind the character.
			local spot = Kit.new("Frame", {
				Name = "Spot",
				BackgroundColor3 = C.Well:Lerp(rarity, 0.22),
				Size = UDim2.new(1, -40, 1, -40),
				Position = UDim2.new(0.5, 0, 0, 86),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Parent = frame,
			})
			Kit.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = spot })
			Kit.round(spot)
		end
		-- Unknown tiers: a smaller soft-blue silhouette (Kit.unitViewport tints it).
		local viewport = if known
			then Kit.unitViewport(frame, tier, { Size = UDim2.new(1, -16, 1, -112), Position = UDim2.fromOffset(8, 32) })
			else Kit.unitViewport(frame, tier, {
				Size = UDim2.new(1, -60, 1, -130),
				Position = UDim2.new(0.5, 0, 0, 40),
				AnchorPoint = Vector2.new(0.5, 0),
			}, true)
		viewport.ZIndex = 2
		if known then
			Kit.pill(frame, {
				Name = "Footer",
				Text = string.upper(band),
				Color = rarity,
				TextSize = T.Small,
				Size = UDim2.fromOffset(0, 24),
				AutomaticSize = Enum.AutomaticSize.X,
				Position = UDim2.new(0.5, 0, 1, -8),
				AnchorPoint = Vector2.new(0.5, 1),
				ZIndex = 3,
			})
		else
			Kit.text(frame, {
				Name = "Footer",
				Text = string.upper(band),
				Font = F.UI,
				TextSize = T.Small,
				TextWrapped = false,
				Size = UDim2.new(1, -16, 0, 24),
				Position = UDim2.new(0, 8, 1, -32),
				TextColor3 = SMALL_TEXT,
			})
		end
		if isNew then
			-- Fully inside the card's top-right corner.
			Kit.pill(frame, {
				Name = "New",
				Text = "NEW",
				Color = C.Danger,
				Solid = true,
				TextColor = C.Text,
				TextSize = T.Small,
				Size = UDim2.fromOffset(48, 22),
				Position = UDim2.new(1, -8, 0, 8),
				AnchorPoint = Vector2.new(1, 0),
				ZIndex = 5,
			})
		end
		if window.isOpen() and known and not wasKnown then
			-- Discovered while the Index is open: ease the character in and celebrate.
			viewport.ImageTransparency = 1
			Kit.tween(viewport, 0.3, { ImageTransparency = 0 })
			if not sparkled[tier] then
				sparkled[tier] = true
				sparkle(frame)
			end
		end
	end

	local found = 0
	local prebuilt = false
	local function refresh(force: boolean?)
		local data = State.data
		if not data or not (force or window.isOpen()) then
			return
		end
		if not sessionStart then
			sessionStart = State.now() - 2
		end
		local count = 0
		for tier = 1, Economy.MAX_TIER do
			local at = data.discovered[tier] or 0
			if at > 0 then
				count += 1
			end
			local isNew = at > 0 and at >= (sessionStart :: number) and not seen[tier]
			fillCard(tier, at, isNew)
		end
		if count ~= found and window.isOpen() then
			Kit.countTo(progressLabel, found, count, foundText)
		elseif count ~= found or progressLabel.Text == "" then
			progressLabel.Text = foundText(count)
		end
		found = count
		setProgress(count / Economy.MAX_TIER)
	end
	State.changed.Event:Connect(function()
		refresh()
	end)

	beforeOpen.Index = function()
		refresh(true)
		ripple(cardFrames)
		-- The bar refills from empty each time the Index opens.
		setProgress(0, true)
		setProgress(found / Economy.MAX_TIER)
		-- First look at tiers discovered since the last visit: sparkle once,
		-- right after the card has rippled in.
		local data = State.data
		if not data or not sessionStart then
			return
		end
		for tier = 1, Economy.MAX_TIER do
			local at = data.discovered[tier] or 0
			if at > 0 and at >= (sessionStart :: number) and not seen[tier] and not sparkled[tier] then
				sparkled[tier] = true
				local frame = cards[tier].frame
				if not PREVIEW then
					task.delay(math.min(tier - 1, 12) * 0.025 + 0.3, function()
						if window.isOpen() then
							sparkle(frame)
						end
					end)
				end
			end
		end
	end
	window.onClose.Event:Connect(function()
		local data = State.data
		if data then
			for tier = 1, Economy.MAX_TIER do
				if (data.discovered[tier] or 0) > 0 then
					seen[tier] = true
				end
			end
		end
	end)
	State.changed.Event:Connect(function()
		if not sessionStart then
			sessionStart = State.now() - 2
		end
		-- Build every card in the background (a couple per frame) after the
		-- first snapshot, so opening the Index never pops viewports in.
		if not prebuilt then
			prebuilt = true
			task.spawn(function()
				local data = State.data
				for tier = 1, Economy.MAX_TIER do
					if data then
						local at = data.discovered[tier] or 0
						fillCard(tier, at, at > 0 and at >= (sessionStart :: number) and not seen[tier])
					end
					if tier % 2 == 0 then
						task.wait()
					end
					data = State.data
				end
				refresh()
			end)
		end
	end)
end

-- Ranking -----------------------------------------------------------------------------

-- Gold, silver and bronze medal chips for the top three.
local MEDAL_COLORS = { C.Gold, C.Chrome, C.Amber }

type RowLabels = { rank: TextLabel, chip: Frame, value: TextLabel, extra: TextLabel? }

-- Boards: total units (the original board) and the sky obby's highest stage (with clears).
type Board = "units" | "stage"

-- The local player's highest obby stage and total clears, from the snapshot (falling back to
-- the replicated ParkourBestStage attribute).
local function myStage(): (number, number)
	local data = State.data
	local info = data and data.modes and data.modes.parkour
	local stage = tonumber(Players.LocalPlayer:GetAttribute("ParkourBestStage")) or 0
	local clears = 0
	if type(info) == "table" then
		stage = math.max(stage, tonumber(info.stage) or tonumber(info.bestStage) or 0)
		if type(info.clears) == "number" then
			clears = info.clears
		elseif type(info.levels) == "table" then
			for _, lv in info.levels do
				if type(lv) == "table" then
					clears += tonumber(lv.clears) or 0
				end
			end
		end
	end
	return stage, clears
end

local function buildRanking(screen: ScreenGui)
	local window = Kit.window(screen, "Ranking", "Ranking", I.Ranking, C.Window.Ranking, Vector2.new(780, 560), Vector2.new(600, 440))
	register("Ranking", window)
	local query = Net.func("Query")
	local action = Net.event("Action")
	local board: Board = "units"

	-- Toolbar: the board tabs on the left, number format and refresh on the right.
	local formatButton = Kit.button(window.content, {
		Name = "Format",
		Text = "Full numbers",
		Color = C.SurfaceHi,
		Size = UDim2.fromOffset(150, 42),
		Position = UDim2.new(1, -140, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = 14,
	})
	local refreshButton = Kit.button(window.content, {
		Name = "Refresh",
		Text = "Refresh",
		Color = C.Window.Ranking,
		Size = UDim2.fromOffset(130, 42),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = 14,
	})
	local subtitle = Kit.text(window.content, {
		Name = "Subtitle",
		Text = "Top players by total " .. W.Units,
		TextSize = T.Small,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -14, 0, 22),
		Position = UDim2.fromOffset(4, 48),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.TextDim,
	})

	local header = Kit.new("Frame", {
		Name = "Columns",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -14, 0, 24),
		Position = UDim2.fromOffset(0, 72),
		Parent = window.content,
	})
	local headers: { [Board]: { TextLabel } } = { units = {}, stage = {} }
	local function headerText(boards: { Board }, text: string, x: number, w: number, align: Enum.TextXAlignment)
		local label = Kit.text(header, {
			Text = text,
			Font = F.UI,
			TextSize = T.Tiny,
			TextWrapped = false,
			Size = UDim2.new(w, 0, 1, 0),
			Position = UDim2.fromScale(x, 0),
			TextXAlignment = align,
			TextColor3 = SMALL_TEXT,
		})
		for _, key in boards do
			table.insert(headers[key], label)
		end
	end
	headerText({ "units", "stage" }, "RANK", 0.02, 0.14, Enum.TextXAlignment.Left)
	headerText({ "units", "stage" }, "PLAYER", 0.17, 0.4, Enum.TextXAlignment.Left)
	headerText({ "units" }, string.upper(W.Units), 0.62, 0.36, Enum.TextXAlignment.Right)
	headerText({ "stage" }, "STAGE", 0.64, 0.16, Enum.TextXAlignment.Right)
	headerText({ "stage" }, "CLEARS", 0.82, 0.16, Enum.TextXAlignment.Right)

	local list = Kit.scrolling(window.content, { Size = UDim2.new(1, 0, 1, -174), Position = UDim2.fromOffset(0, 100) })
	-- Rows are not buttons: the list itself is selectable so a gamepad can scroll it.
	Kit.selectable(list)
	Kit.new("UIPadding", {
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 2),
		PaddingBottom = UDim.new(0, 10),
		Parent = list,
	})
	Kit.list(list, 8)

	-- The player's own row, pinned under the list with a sunny outline (one face per board).
	local mine = Kit.panel(window.content, {
		Name = "Mine",
		Elevated = true,
		StrokeColor = C.Gold,
		StrokeThickness = 2.5,
		Size = UDim2.new(1, -14, 0, 54),
		Position = UDim2.new(0, 0, 1, -62),
		Radius = Kit.RADIUS.M,
	})
	local function mineFace(name: string): Frame
		return Kit.new("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = mine })
	end
	local mineUnits = mineFace("Units")
	local mineStage = mineFace("Stage")

	-- One row: rank chip, name, the board value and (stage board) the clears column.
	local function row(
		parent: Instance,
		rank: number?,
		rankText: string,
		name: string,
		value: string,
		isMe: boolean,
		extra: string?
	): RowLabels
		local color = rank and MEDAL_COLORS[rank]
		local rankChip = Kit.new("Frame", {
			Name = "Rank",
			BackgroundColor3 = color or C.Well,
			Size = UDim2.fromOffset(if color then 34 else 46, if color then 34 else 30),
			Position = UDim2.new(0.02, if color then 6 else 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = parent,
		})
		if color then
			-- Solid medal coin, lighter on top, with a darker rim.
			Kit.round(rankChip)
			Kit.gradient(rankChip, Color3.new(1, 1, 1), Color3.new(0.86, 0.86, 0.9))
			Kit.new("UIStroke", { Thickness = 2, Color = Kit.lip(color), Parent = rankChip })
		else
			Kit.corner(rankChip, 10)
			Kit.new("UIStroke", { Thickness = 1, Color = C.Edge, Transparency = 0.3, Parent = rankChip })
		end
		local rankLabel = Kit.number(rankChip, {
			Text = if color then tostring(rank) else rankText,
			TextSize = if color then T.Body else T.Small,
			Size = UDim2.fromScale(1, 1),
			TextColor3 = if color then C.GoldInk else C.TextDim,
			StrokeThickness = 0,
		})
		Kit.text(parent, {
			Name = "Name",
			Text = name,
			Font = F.UI,
			TextSize = T.Body,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(0.38, 0, 1, 0),
			Position = UDim2.fromScale(0.17, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = C.Text,
		})
		if isMe then
			Kit.pill(parent, {
				Text = "YOU",
				Color = C.Gold,
				Solid = true,
				TextSize = 12,
				Size = UDim2.fromOffset(42, 22),
				Position = UDim2.new(0.62, 0, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
			})
		end
		local valueLabel = Kit.number(parent, {
			Name = "Value",
			Text = value,
			TextSize = T.Body,
			Size = UDim2.new(if extra then 0.16 else 0.34, 0, 1, 0),
			Position = UDim2.new(if extra then 0.8 else 0.98, 0, 0, 0),
			AnchorPoint = Vector2.new(1, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = if color then C.GoldLight else C.Text,
		})
		local extraLabel: TextLabel? = nil
		if extra then
			extraLabel = Kit.number(parent, {
				Name = "Clears",
				Text = extra,
				TextSize = T.Body,
				Size = UDim2.new(0.16, 0, 1, 0),
				Position = UDim2.new(0.98, 0, 0, 0),
				AnchorPoint = Vector2.new(1, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = C.TextDim,
			})
		end
		return { rank = rankLabel, chip = rankChip, value = valueLabel, extra = extraLabel }
	end

	local entries: { any } = {}
	local stageEntries: { any } = {}
	local loaded = false
	local updatedAt = 0
	local listFull: boolean? = nil
	local mineLabels: RowLabels = row(mineUnits, nil, "--", Players.LocalPlayer.Name, "0", false)
	local mineStageLabels: RowLabels = row(mineStage, nil, "--", Players.LocalPlayer.Name, "0", false, "0")
	local mineValue: number? = nil

	local function fullNumbers(): boolean
		local data = State.data
		return data ~= nil and data.settings.fullNumbers == true
	end
	local function fmt(n: number): string
		return if fullNumbers() then Format.commas(n) else Format.short(n)
	end
	local function isMine(entry: any): boolean
		local me = Players.LocalPlayer
		if entry.userId ~= nil then
			return tonumber(entry.userId) == me.UserId
		end
		return entry.name == me.Name or entry.name == me.DisplayName
	end

	-- Rebuilds the leaderboard rows; `animate` ripples them in.
	local function renderList(animate: boolean)
		clearChildren(list)
		listFull = fullNumbers()
		local rows: { GuiObject } = {}
		local shown = if board == "stage" then stageEntries else entries
		for i, entry in shown do
			if type(entry) ~= "table" then
				continue
			end
			local isMe = isMine(entry)
			local rank = tonumber(entry.rank) or i
			local frame = Kit.panel(list, {
				Name = "Row" .. i,
				Elevated = true,
				StrokeColor = if isMe then C.Gold else nil,
				StrokeThickness = if isMe then 2.5 else nil,
				Size = UDim2.new(1, 0, 0, 46),
				LayoutOrder = i,
				Radius = Kit.RADIUS.M,
			})
			local name = tostring(entry.name or "?")
			if board == "stage" then
				local stage = tonumber(entry.stage) or tonumber(entry.value) or 0
				row(frame, rank, "#" .. rank, name, tostring(stage), isMe, Format.commas(tonumber(entry.clears) or 0))
			else
				row(frame, rank, "#" .. rank, name, fmt(tonumber(entry.value) or 0), isMe)
			end
			table.insert(rows, frame)
		end
		if #rows == 0 then
			local empty = Kit.text(list, {
				Text = if loaded then "No rankings yet - be the first!" else "Loading...",
				TextSize = T.Body,
				Size = UDim2.new(1, 0, 0, 60),
				TextColor3 = C.TextDim,
			})
			table.insert(rows, empty)
		end
		if animate then
			Kit.stagger(rows)
		end
	end

	-- Pinned row, format button, column headers and subtitle.
	local function renderInfo()
		local data = State.data
		local myRank: number? = nil
		local myStageRank: number? = nil
		for i, entry in entries do
			if type(entry) == "table" and isMine(entry) then
				myRank = tonumber(entry.rank) or i
			end
		end
		for i, entry in stageEntries do
			if type(entry) == "table" and isMine(entry) then
				myStageRank = tonumber(entry.rank) or i
			end
		end
		mineUnits.Visible = board == "units"
		mineStage.Visible = board == "stage"
		for _, labels in headers do
			for _, label in labels do
				label.Visible = false
			end
		end
		for _, label in headers[board] do
			label.Visible = true
		end
		mineLabels.rank.Text = if myRank then "#" .. myRank else "--"
		local total = data and data.totalObtained or 0
		if mineValue and mineValue ~= total and window.isOpen() then
			Kit.countTo(mineLabels.value, mineValue, total, fmt)
		else
			mineLabels.value.Text = fmt(total)
		end
		mineValue = total
		local stage, clears = myStage()
		mineStageLabels.rank.Text = if myStageRank then "#" .. myStageRank else "--"
		mineStageLabels.value.Text = tostring(stage)
		local clearsLabel = mineStageLabels.extra
		if clearsLabel then
			clearsLabel.Text = Format.commas(clears)
		end
		Kit.setButton(formatButton, if fullNumbers() then "Short numbers" else "Full numbers")
		formatButton.Visible = board == "units"
		local updated = ""
		if loaded and updatedAt > 0 then
			local ago = math.max(0, State.now() - updatedAt)
			updated = if ago < 60
				then "  •  updated just now"
				elseif ago < 3600 then string.format("  •  updated %dm ago", ago // 60)
				else string.format("  •  updated %dh ago", ago // 3600)
		end
		subtitle.Text = (if board == "stage" then "Highest sky obby stage reached" else "Top players by total " .. W.Units) .. updated
	end

	-- Board tabs (built after the rows' helpers: Kit.tabs selects the first one at once).
	local tabsReady = false
	Kit.tabs(window.content, {
		Name = "Boards",
		Items = { { key = "units", text = W.Units }, { key = "stage", text = "Stage" } },
		Color = C.Window.Ranking,
		Size = UDim2.fromOffset(230, 42),
		TextSize = 14,
	}, function(key: string)
		board = if key == "stage" then "stage" else "units"
		if tabsReady and window.isOpen() then
			renderList(true)
			renderInfo()
		end
	end)
	tabsReady = true

	formatButton.Activated:Connect(function()
		local data = State.data
		if data then
			action:FireServer({ action = "SetSetting", key = "fullNumbers", value = not data.settings.fullNumbers })
		end
	end)

	local fetching = false
	local lastFetch = -math.huge
	local function fetch()
		if fetching or os.clock() - lastFetch < 3 then
			return
		end
		fetching = true
		lastFetch = os.clock()
		Kit.setEnabled(refreshButton, false)
		task.spawn(function()
			local ok, result = pcall(query.InvokeServer, query, "Ranking")
			fetching = false
			Kit.setEnabled(refreshButton, true)
			if ok and type(result) == "table" then
				entries = if type(result.entries) == "table" then result.entries else {}
				stageEntries = if type(result.stage) == "table" then result.stage else {}
				updatedAt = result.updatedAt or State.now()
				loaded = true
				if window.isOpen() then
					renderList(true)
					renderInfo()
				end
			end
		end)
	end
	refreshButton.Activated:Connect(fetch)

	window.onOpen.Event:Connect(function()
		-- Rows are rebuilt (and ripple in) on every open; they are created after
		-- the window's own fade starts, so they fade themselves.
		renderList(true)
		renderInfo()
		fetch()
	end)
	State.changed.Event:Connect(function()
		if not window.isOpen() then
			return
		end
		if listFull ~= fullNumbers() then
			renderList(false)
		end
		renderInfo()
	end)
end

-- Settings ------------------------------------------------------------------------------

local function buildSettings(screen: ScreenGui)
	-- Sized to its four rows: 4 x 70 + 3 x 10 gaps + 20 padding + 84 of header and margins.
	local window = Kit.window(screen, "Settings", "Settings", I.Settings, C.Window.Settings, Vector2.new(560, 414))
	register("Settings", window)
	local action = Net.event("Action")

	Kit.list(window.content, 10)

	local rows: { GuiObject } = {}
	local toggles: { { key: string, set: (boolean, boolean?) -> (), sub: TextLabel, medal: Frame } } = {}
	local function toggle(order: number, icon: string, text: string, desc: string, key: string)
		local row = Kit.panel(window.content, {
			Name = key,
			Elevated = true,
			Size = UDim2.new(1, 0, 0, 70),
			LayoutOrder = order,
			Radius = Kit.RADIUS.M + 2,
		})
		table.insert(rows, row)
		-- Icon tile: deep blue, warms to the window's teal while the setting is on.
		local medal = Kit.new("Frame", {
			Name = "Medal",
			BackgroundColor3 = C.Well,
			Size = UDim2.fromOffset(46, 46),
			Position = UDim2.new(0, 12, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = row,
		})
		Kit.corner(medal, 14)
		Kit.new("UIStroke", { Thickness = 1.5, Color = C.Edge, Transparency = 0.2, Parent = medal })
		Kit.icon(medal, icon, 26, Kit.ICON_COLORS[icon] or C.Text, {
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 2,
		})
		Kit.text(row, {
			Text = string.upper(text),
			Font = F.UI,
			TextSize = T.Body,
			TextWrapped = false,
			Size = UDim2.new(1, -170, 0, 22),
			Position = UDim2.fromOffset(72, 12),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		local sub = Kit.text(row, {
			Text = desc,
			TextSize = T.Small,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -176, 0, 20),
			Position = UDim2.fromOffset(72, 37),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = C.TextDim,
		})
		local _, set = Kit.switch(row, {
			Name = "Switch",
			Large = true,
			Position = UDim2.new(1, -16, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
		}, function()
			local data = State.data
			if not data then
				return
			end
			local current = if key == "autoMerge" then data.autoMerge else data.settings[key]
			action:FireServer({ action = "SetSetting", key = key, value = not current })
		end)
		table.insert(toggles, { key = key, set = set, sub = sub, medal = medal })
	end
	toggle(1, "Music", "Music", "Background music", "music")
	toggle(2, "Sound", "Sound Effects", "Clicks, pickups and rewards", "sfx")
	toggle(3, "Hash", "Full Numbers", "Show 1,234,567 instead of 1.23M", "fullNumbers")
	toggle(4, "Merge", "Auto Merge", "Merge pairs automatically", "autoMerge")

	local ON_TILE = C.Well:Lerp(C.Window.Settings, 0.4)
	local function refresh()
		local data = State.data
		if not data then
			return
		end
		for _, t in toggles do
			local on: boolean
			if t.key == "autoMerge" then
				on = data.autoMergeOwned == true and data.autoMerge == true
				if data.autoMergeOwned then
					t.set(data.autoMerge)
					t.sub.Text = "Merge pairs automatically"
				else
					t.set(false, true)
					t.sub.Text = "Game pass: "
						.. Kit.hint("tap", "click", "press")
						.. " to get it ("
						.. price(Theme.Monetization.Passes.AutoMerge.Price)
						.. ")"
				end
			else
				on = data.settings[t.key] == true
				t.set(on)
			end
			Kit.tween(t.medal, 0.2, { BackgroundColor3 = if on then ON_TILE else C.Well })
		end
	end
	State.changed.Event:Connect(refresh)
	window.onOpen.Event:Connect(refresh)

	beforeOpen.Settings = function()
		refresh()
		ripple(rows)
	end
end

-- Game Modes --------------------------------------------------------------------------------
--[[
	The plaza game modes, one full row each in the same arrangement (quiet medal, title,
	blurb, stats, reward line and a gold PLAY that fires ModeStart and closes the window;
	PLAY is the one loud element per row), then one slim "More modes coming soon" row.

	Parkour shows the preselected map (the player's unlocked level, re-synced whenever the
	window opens): its name, difficulty (10 pips), best and clears and what finishing it
	pays, beside PLAY (starts that map) and CHOOSE MAP (opens the Maps window,
	MapPicker.luau, where every map is picked from a card grid with a 3D preview).

	MOG TEST: best score, rivals mogged and passes, reward line, PLAY (disabled
	"PLAYING" while a test runs) opens the VS RIVALS / 1v1 DUEL picker (Windows.onMogPlay). Reads State.data.modes.parkour and .mog.
]]
local function runTime(seconds: number): string
	local tenths = math.floor(math.max(seconds, 0) * 10 + 0.5)
	return string.format("%d:%02d.%d", tenths // 600, (tenths // 10) % 60, tenths % 10)
end

local function plural(n: number, word: string, many: string?): string
	return string.format("%d %s", n, if n == 1 then word else many or word .. "s")
end

-- "Finish: +$X" or the cooldown countdown; `bonus` adds a "(xB)" tag.
local function setRewardLine(label: TextLabel, cash: number, full: boolean, cooldownEnds: number, bonus: number?)
	local left = cooldownEnds - os.time()
	if not full and left > 0 then
		label.TextColor3 = C.TextDim
		label.Text = "Reward again in " .. Format.time(left)
		return
	end
	label.TextColor3 = C.MoneyText
	local text = "Finish: +" .. Format.money(cash)
	if bonus and bonus > 1.001 then
		text ..= string.format("  (×%s)", (string.format("%.1f", bonus):gsub("%.0$", "")))
	end
	label.Text = text
end

local PIP_COUNT = 10

-- Difficulty row: a fire icon, 10 pips (gold warming to red) and "n/10". props: Name, Size,
-- Position, Pip (pip size, default 10). Returns the setter.
local function difficultyPips(parent: Instance, props: { [string]: any }): (number) -> ()
	local pipSize = props.Pip or 10
	local row = Kit.new("Frame", {
		Name = props.Name or "Difficulty",
		BackgroundTransparency = 1,
		Size = props.Size,
		Position = props.Position,
		ZIndex = 2,
		Parent = parent,
	})
	Kit.list(row, 3, true).VerticalAlignment = Enum.VerticalAlignment.Center
	Kit.icon(row, "Fire", pipSize + 6, C.Gold, { LayoutOrder = 0, ZIndex = 2 })
	local pips: { Frame } = {}
	for i = 1, PIP_COUNT do
		local pip = Kit.new("Frame", {
			Name = "Pip" .. i,
			BackgroundColor3 = C.Well,
			Size = UDim2.fromOffset(pipSize, pipSize),
			LayoutOrder = i,
			ZIndex = 2,
			Parent = row,
		})
		Kit.corner(pip, 3)
		pips[i] = pip
	end
	local of = Kit.text(row, {
		Name = "Of10",
		Text = "",
		Font = F.UI,
		TextSize = T.Tiny,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromOffset(44, pipSize + 6),
		LayoutOrder = PIP_COUNT + 1,
		TextColor3 = C.TextDim,
		StrokeThickness = 0,
		ZIndex = 2,
	})
	return function(value: number)
		local difficulty = math.clamp(math.floor(value), 1, PIP_COUNT)
		for i, pip in pips do
			local on = i <= difficulty
			pip.BackgroundColor3 = if on then C.Gold:Lerp(C.Bad, (i - 1) / (PIP_COUNT - 1)) else C.Well
			pip.BackgroundTransparency = if on then 0 else 0.3
		end
		of.Text = string.format("%d/%d", difficulty, PIP_COUNT)
	end
end

-- What finishing parkour `level` pays, from the snapshot `info` (modes.parkour).
-- rewardPreview is priced for info.level; its cash is rescaled to `level`'s bonus.
local function parkourReward(label: TextLabel, info: { [string]: any }, level: number)
	local list = if type(info.levels) == "table" then info.levels else {}
	local lv = list[level]
	local preview = info.rewardPreview
	if type(preview) ~= "table" or type(lv) ~= "table" then
		label.Text = ""
		return
	end
	local current = list[tonumber(info.level) or 1]
	local currentBonus = if type(current) == "table" then tonumber(current.bonus) or 1 else 1
	local bonus = tonumber(lv.bonus) or 1
	local cash = math.floor((tonumber(preview.packCash) or 0) / math.max(currentBonus, 0.01) * bonus + 0.5)
	-- A level's first clear always pays in full.
	local first = (tonumber(lv.clears) or 0) == 0
	local cooldownEnds = tonumber(info.cooldownEnds) or 0
	local full = first or cooldownEnds <= os.time()
	setRewardLine(label, cash, full, cooldownEnds, bonus)
end

type ModeRow = { panel: Frame, stats: TextLabel, reward: TextLabel, play: TextButton }

-- One mode row: medal, title, blurb, stats line, reward line and the PLAY button.
local function modeRow(parent: Instance, props: { [string]: any }, accent: Color3, onPlay: () -> ()): ModeRow
	local panel = Kit.panel(parent, {
		Name = props.Name,
		Elevated = true,
		Size = UDim2.new(1, 0, 0, props.Height),
		LayoutOrder = props.LayoutOrder,
		Radius = Kit.RADIUS.M + 2,
	})
	-- Quiet medal (an accent rim only), so the PLAY button is the one loud thing here.
	local medal = Kit.new("Frame", {
		Name = "Medal",
		BackgroundColor3 = C.Well,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.fromOffset(12, 14),
		Parent = panel,
	})
	Kit.corner(medal, 14)
	Kit.new("UIStroke", { Thickness = 2, Color = accent, Transparency = 0.2, Parent = medal })
	Kit.text(medal, { Text = props.Medal, TextSize = 26, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	Kit.title(panel, {
		Text = props.Title,
		TextSize = T.H3,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -80, 0, 24),
		Position = UDim2.fromOffset(70, 14),
		TextColor3 = C.Text,
	})
	Kit.text(panel, {
		Text = props.Blurb,
		TextSize = T.Small,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -80, 0, 20),
		Position = UDim2.fromOffset(70, 38),
		TextColor3 = C.TextDim,
		StrokeThickness = 0,
	})
	local stats = Kit.text(panel, {
		Name = "Stats",
		Text = "",
		Font = F.UI,
		TextSize = T.Small,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = false,
		Size = UDim2.new(1, -80, 0, 20),
		Position = UDim2.fromOffset(70, 60),
		TextColor3 = C.Text,
		StrokeThickness = 0,
	})
	local reward = Kit.text(panel, {
		Name = "Reward",
		Text = "",
		Font = F.UI,
		TextSize = T.Small,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = false,
		Size = UDim2.new(1, -164, 0, 20),
		Position = UDim2.new(0, 12, 1, -40),
		AnchorPoint = Vector2.new(0, 0.5),
		TextColor3 = C.MoneyText,
		StrokeThickness = 0,
	})
	local play = Kit.button(panel, {
		Name = "Play",
		Text = "PLAY",
		Font = Theme.Fonts.Display,
		Color = C.Gold,
		Breathe = true,
		Size = UDim2.fromOffset(130, 50),
		Position = UDim2.new(1, -12, 1, -12),
		AnchorPoint = Vector2.new(1, 1),
	}, onPlay)
	return { panel = panel, stats = stats, reward = reward, play = play }
end

local maps: MapPicker.Picker? = nil

-- Opens the Maps window (MapPicker) with `level` selected (nil: the player's unlocked map).
-- Already open: just moves the selection.
function Windows.openMaps(level: number?)
	local picker = maps
	if not picker then
		return
	end
	if picker.window.isOpen() then
		if level then
			picker.select(level)
		end
		return
	end
	picker.preselect(level)
	Windows.open("Maps")
end

local function buildModes(screen: ScreenGui)
	local accent = Theme.World.Mint
	-- 168 (Parkour) + 10 + 150 (Mog) + 10 + 44 (coming soon) + 20 padding + 84 of header and
	-- margins. Kit.fit scales the whole window down on short (phone landscape) screens.
	local window = Kit.window(screen, "Modes", "Game Modes", "🏁", accent, Vector2.new(540, 486), Vector2.new(420, 470))
	register("Modes", window)
	local action = Net.event("Action")
	Kit.list(window.content, 10)

	local rows: { GuiObject } = {}
	local selected = 1

	-- Parkour ---------------------------------------------------------------------------
	local parkour = modeRow(
		window.content,
		{
			Name = "PARKOUR",
			Height = 168,
			LayoutOrder = 1,
			Medal = "🏃",
			Title = "PARKOUR",
			Blurb = "Ten sea maps: jump, bounce and slide!",
		},
		accent,
		function()
			action:FireServer({ action = "ModeStart", mode = "parkour", level = selected })
			Windows.closeAll()
		end
	)
	table.insert(rows, parkour.panel)
	-- CHOOSE MAP sits above PLAY and opens the Maps window on the preselected map.
	Kit.button(parkour.panel, {
		Name = "ChooseMap",
		Text = "CHOOSE MAP",
		Font = Theme.Fonts.Display,
		TextSize = T.Small,
		Color = C.SurfaceHi,
		Size = UDim2.fromOffset(130, 38),
		Position = UDim2.new(1, -12, 1, -70),
		AnchorPoint = Vector2.new(1, 1),
	}, function()
		Windows.openMaps(selected)
	end)
	-- The preselected map's details sit in the left column above the reward line.
	local levelName = Kit.title(parkour.panel, {
		Name = "LevelName",
		Text = "",
		TextSize = T.Body,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -164, 0, 22),
		Position = UDim2.fromOffset(12, 66),
		TextColor3 = C.Text,
	})
	local setPips = difficultyPips(parkour.panel, {
		Name = "Difficulty",
		Size = UDim2.new(1, -164, 0, 16),
		Position = UDim2.fromOffset(12, 90),
	})
	parkour.stats.Position = UDim2.fromOffset(12, 110)
	parkour.stats.Size = UDim2.new(1, -164, 0, 20)
	parkour.reward.Position = UDim2.new(0, 12, 1, -24)

	-- MOG TEST --------------------------------------------------------------------------
	-- Gamepad starts on the loud PLAY of the first mode.
	parkour.play:SetAttribute("FocusFirst", true)
	local mog = modeRow(
		window.content,
		{
			Name = "MOGTEST",
			Height = 150,
			LayoutOrder = 2,
			Medal = "💪",
			Title = "MOG TEST",
			Blurb = "Out-mog 3 rivals, or duel a real player 1v1!",
		},
		accent,
		function()
			local pick = Windows.onMogPlay
			if pick then
				pick()
			else
				action:FireServer({ action = "ModeStart", mode = "mog", vs = "rivals" })
			end
			Windows.closeAll()
		end
	)
	table.insert(rows, mog.panel)

	-- Every other mode: one slim, quiet row.
	local soon = Kit.panel(window.content, {
		Name = "ComingSoon",
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = 3,
		Radius = Kit.RADIUS.M,
		Transparency = 0.35,
	})
	table.insert(rows, soon)
	Kit.icon(soon, "Lock", 18, C.TextMute, {
		Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 2,
	})
	Kit.text(soon, {
		Text = "More modes coming soon",
		Font = F.UI,
		TextSize = T.Small,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -60, 1, 0),
		Position = UDim2.fromOffset(44, 0),
		TextColor3 = C.TextMute,
		StrokeThickness = 0,
		ZIndex = 2,
	})

	local function refreshParkour()
		local data = State.data
		local info = data and data.modes and data.modes.parkour
		local list = if type(info) == "table" and type(info.levels) == "table" then info.levels else {}
		local count = math.max(#list, 1)
		local unlocked = math.clamp(if type(info) == "table" then tonumber(info.unlocked) or 1 else 1, 1, count)
		selected = math.clamp(selected, 1, unlocked)
		local lv = list[selected]
		if type(info) ~= "table" or type(lv) ~= "table" then
			levelName.Text = "Level 1"
			setPips(1)
			parkour.stats.Text = "Best --  ·  0 clears"
			parkour.reward.Text = ""
			return
		end
		local icon = if type(lv.icon) == "string" and lv.icon ~= "" then lv.icon .. " " else ""
		levelName.Text = string.format("Level %d  ·  %s%s", selected, icon, tostring(lv.name or ""))
		setPips(tonumber(lv.difficulty) or selected)
		local best = tonumber(lv.best) or 0
		local clears = tonumber(lv.clears) or 0
		parkour.stats.Text = string.format("Best %s  ·  %s", if best > 0 then runTime(best) else "--", plural(clears, "clear"))
		parkourReward(parkour.reward, info, selected)
		local runningHere = info.running and tonumber(info.level) == selected
		Kit.setButton(parkour.play, if runningHere then "RESTART" else "PLAY")
	end

	local function refreshMog()
		local data = State.data
		local info = data and data.modes and data.modes.mog
		if type(info) ~= "table" then
			mog.stats.Text = "Best score --  ·  0 rivals  ·  0 passes"
			mog.reward.Text = ""
			return
		end
		local best = tonumber(info.best) or 0
		mog.stats.Text = string.format(
			"Best score %s  ·  %s  ·  %s",
			if best > 0 then tostring(best) else "--",
			plural(tonumber(info.rivals) or 0, "rival"),
			plural(tonumber(info.clears) or 0, "pass", "passes")
		)
		local preview = info.rewardPreview
		if type(preview) ~= "table" then
			mog.reward.Text = ""
		else
			setRewardLine(
				mog.reward,
				tonumber(preview.packCash) or tonumber(preview.cash) or 0,
				preview.full ~= false,
				tonumber(info.cooldownEnds) or 0
			)
		end
		Kit.setButton(mog.play, if info.running then "PLAYING" else "PLAY")
		Kit.setEnabled(mog.play, not info.running)
	end

	local function refresh()
		refreshParkour()
		refreshMog()
	end
	-- Re-centre the selection on the level to play (the lowest unlocked, uncleared one).
	local function resync()
		local info = State.data and State.data.modes and State.data.modes.parkour
		selected = if type(info) == "table" then tonumber(info.unlocked) or 1 else 1
		refresh()
	end
	State.changed.Event:Connect(refresh)
	window.onOpen.Event:Connect(function()
		resync()
		-- The cooldown lines count down while the window is open.
		task.spawn(function()
			while window.isOpen() do
				task.wait(1)
				refresh()
			end
		end)
	end)

	beforeOpen.Modes = function()
		resync()
		ripple(rows)
	end
	resync()
end

function Windows.build(screen: ScreenGui)
	backdrop = Kit.backdrop(screen, 9, function()
		Windows.closeAll()
	end)
	buildShop(screen)
	buildIndex(screen)
	buildRanking(screen)
	buildSettings(screen)
	buildModes(screen)
	local picker = MapPicker.build(screen, {
		register = register,
		closeAll = Windows.closeAll,
		parkourReward = parkourReward,
		pips = difficultyPips,
		runTime = runTime,
		plural = plural,
		ripple = ripple,
	})
	maps = picker
	beforeOpen.Maps = picker.beforeOpen

	-- B / Escape closes the open window. gameProcessedEvent is not checked: ButtonB
	-- comes in processed while a button is selected, and that is when it matters.
	-- A modal on top (Popups sets ModalOpen) handles the press itself.
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if screen:GetAttribute("ModalOpen") == true then
				return
			end
			if anyOpen() then
				Kit.sound("Close")
				Windows.closeAll()
			end
		end
	end)
end

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
