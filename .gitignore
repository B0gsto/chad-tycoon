roblox.yml
roblox.toml
sourcemap.json
*.rbxl.lock
*.rbxlx.lock
.cache/
preview/node_modules/
preview/out/
# Device shots (shoot.mjs chad-<WxH>-<device>): review material; the kept ones are copied to preview/screenshots/mobile.
preview/screenshots/chad-*/
preview/render/node_modules/
.claude/worktrees/
__pycache__/
.DS_Store
node_modules/
# Release binary from scripts/build-release.sh (CI uploads it as an artifact). build/ChadAuraTycoon.rbxlx stays tracked.
build/*.rbxl
build/.*.tmp.*
# Blender renders are regenerable from art/blender; keep the JSON sidecars (atlas/UI rects) and the hero faces
# (tests/run.luau checks art/out/faces/*.png exist).
art/out/**
!art/out/**/
!art/out/**/*.json
!art/out/faces/**
# Parkour picker thumbnails are Studio captures (no script makes them again): keep them.
!art/out/maps/**
# Marketing renders, thumbnails and trailers (made in a separate session) stay out of git.
marketing/
# Test-experience publish log (tools/deploy.py publish --target test): CI and agents publish there constantly.
deploy/test-history.json
